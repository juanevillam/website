{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--host"],
      "port": 4321,
      "autoPort": true
    },
    {
      "name": "web-prod",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "npm run build && npm run preview -- --host --port 4322"
      ],
      "port": 4322
    }
  ]
}
