---
import Base from './Base.astro';
import SiteFooter from '../components/SiteFooter.astro';
import T from '../components/T.astro';
import { locales, type Locale } from '../i18n/ui';
import { legalDate } from '../lib/legal';

/**
 * A document page — the legal and support pages the stores require.
 * Free-scrolling (the one-pager's snap is turned off here), one measure
 * wide, and in all three languages like the rest of the site: the header's
 * switcher re-renders the page in place. English is the binding text —
 * store review reads it — and the translations say so under the date.
 */
type Props = {
  title: Record<Locale, string>;
  /** The app the document belongs to, shown as the eyebrow. */
  app: string;
};

const { title, app } = Astro.props;

const NOTE: Partial<Record<Locale, string>> = {
  es: 'Traducción de cortesía. Si hay alguna diferencia, prevalece la versión en inglés.',
  zh: '本译文仅供参考。如有出入，以英文版本为准。',
};
---

<Base title={`${title.en} — ${app}`}>
  <article class="prose">
    <p class="label">{app}</p>
    <h1 class="title">
      {locales.map(l => <span class="t" lang={l}>{title[l]}</span>)}
    </h1>
    <p class="label updated">
      <T k="legal.updated" />
      {locales.map(l => <span class="t" lang={l}> {legalDate(l)}</span>)}
    </p>
    {
      locales.map(
        l =>
          NOTE[l] && (
            <p class="t note" lang={l}>
              {NOTE[l]}
            </p>
          )
      )
    }
    <slot />
  </article>
  <SiteFooter />
</Base>

<style is:global>
  /* A document scrolls like a document — no panel snapping here. */
  html {
    scroll-snap-type: none;
  }
</style>

<style>
  .prose {
    max-width: var(--measure);
    margin: 0 auto;
    padding: clamp(8rem, 16vh, 11rem) clamp(1.25rem, 4vw, 2.5rem) 6rem;
  }

  .title {
    margin-top: 0.5rem;
  }

  .updated {
    margin-top: 1rem;
  }

  html[data-lang='es'] .note[lang='es'],
  html[data-lang='zh'] .note[lang='zh'] {
    display: block;
  }

  .prose .note {
    margin-top: 1rem;
    font-size: 0.875rem;
    color: var(--ink-3);
  }

  /* Section heads take the landing's weight — 800, a heading's tracking,
     as the More Work names have it. */
  .prose :global(h2) {
    margin-top: 2.5rem;
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: var(--track-heading);
  }

  .prose :global(p),
  .prose :global(li) {
    margin-top: 1rem;
    color: var(--ink-2);
  }

  .prose :global(ul) {
    margin-top: 0.5rem;
    padding-left: 1.25rem;
  }

  .prose :global(li) {
    margin-top: 0.5rem;
  }
</style>
