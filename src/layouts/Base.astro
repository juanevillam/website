---
import { ui } from '../i18n/ui';
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/global.css';

type Props = {
  /** Page title; the wordmark is the default (the one-pager). */
  title?: string;
  /** Keep the page out of search results (the 404). */
  noindex?: boolean;
  /** A shareable address's own preview (lib/links): what a social
   *  network's card says, and the picture it shows. */
  description?: string;
  image?: string;
  /** The page's own path, when it is not `/`. */
  path?: string;
};

const {
  title = ui.en['meta.title'],
  noindex = false,
  description = ui.en['meta.description'],
  image,
  path = '/',
} = Astro.props;
const url = new URL(path, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={url} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />

    <script is:inline>
      // Language, pre-paint — an in-place preference, no locale URLs. The
      // site itself is dark-only. Runs before first render so there is
      // never a flash of the wrong language. A shared link may name one
      // (`?lang=es`, lib/links) for this visit only — it is not saved, so
      // the person's own choice still wins next time; with neither, the
      // browser's own language when the site speaks it, else English.
      (() => {
        const langs = ['en', 'es', 'zh'];
        let saved = null;
        try {
          saved = localStorage.getItem('lang');
        } catch {}
        const asked = new URLSearchParams(location.search).get('lang');
        const browser = (navigator.languages || [navigator.language])
          .map(l => String(l).slice(0, 2).toLowerCase())
          .find(l => langs.includes(l));
        const lang = [asked, saved, browser, 'en'].find(l => langs.includes(l));
        document.documentElement.lang = lang;
        document.documentElement.dataset.lang = lang;
        // Desktop Safari, by name: it re-blurs a backdrop-filtered layer
        // every frame something moves under or with it, and the page's
        // floating controls do both while it scrolls (global.css).
        const ua = navigator.userAgent;
        if (/Safari\//.test(ua) && !/Chrome|Chromium|CriOS|Edg|Mobile/.test(ua))
          document.documentElement.classList.add('is-desk-safari');
      })();
    </script>
  </head>
  <body>
    <!-- The light the current screen lends the page (lib/scene). -->
    <div class="scene" aria-hidden="true"></div>
    <SiteHeader />
    <main>
      <slot />
    </main>

    <script>
      // THE SCENE: whichever screen holds the middle of the viewport lends
      // the page its colours (lib/scene). A story's opener and its slides
      // share one box, so only a dealt deck lights it; a phone's
      // stacked panels are told apart by the scroll step they own; in any
      // deck only the card in front counts.
      const scene = document.querySelector<HTMLElement>('.scene');
      const lit = [...document.querySelectorAll<HTMLElement>('[data-scene]')];
      const holds = (el: HTMLElement, y: number) => {
        const r = el.getBoundingClientRect();
        return r.height > 0 && r.top <= y && r.bottom > y;
      };
      const showing = (el: HTMLElement, y: number) => {
        if (el.classList.contains('deck-card') && !el.classList.contains('is-current'))
          return false;
        const story = el.closest<HTMLElement>('[data-story]');
        const float = story?.querySelector('.float');
        // A story's slides light the page once the deck is dealt — the
        // opener lends no light of its own.
        if (float && !el.closest('.m-story'))
          return float.classList.contains('is-dealt') && holds(story!, y);
        const panel = el.closest<HTMLElement>('.m-panel');
        if (panel) {
          const step = panel
            .closest('.m-story')
            ?.querySelectorAll<HTMLElement>('.m-step')[Number(panel.dataset.mStep)];
          return holds(step && step.getClientRects().length ? step : panel, y);
        }
        return holds(el.closest('section') ?? el, y);
      };
      // A frame of cycling photos (Events) is lit by the photo each column
      // is SHOWING — the most opaque one mid-crossfade — so the light turns
      // with the pictures, the way it turns with the deck.
      const photosOf = (card: HTMLElement) => {
        const cells = [...card.querySelectorAll<HTMLElement>('.photo-cell')];
        if (!cells.length) return card.dataset.scene;
        const shown = cells.map(cell => {
          let best: HTMLElement | undefined;
          let most = -1;
          for (const img of cell.querySelectorAll<HTMLElement>('[data-scene-photo]')) {
            const o = Number(getComputedStyle(img).opacity);
            if (o > most) [best, most] = [img, o];
          }
          return (best?.dataset.scenePhoto ?? '|0').split('|');
        });
        const lists = shown.map(([h]) => h.split(' ').filter(Boolean));
        const hues: string[] = [];
        for (let i = 0; i < 3; i++)
          for (const list of lists)
            if (list[i] && !hues.includes(list[i]) && hues.length < 3) hues.push(list[i]);
        const k = Math.max(...shown.map(([, k]) => Number(k)));
        return `${hues.join(' ')}|${k}`;
      };
      // A peeking picture (`data-scene-at`) moves the light to the middle of
      // what of it is on screen; anything else leaves it in its place.
      const standLight = (now?: HTMLElement) => {
        const at = now?.querySelector<HTMLElement>('[data-scene-at]');
        const r = at?.getBoundingClientRect();
        if (!r || !r.width) {
          scene!.style.removeProperty('--scene-sx');
          scene!.style.removeProperty('--scene-sy');
          return;
        }
        const left = Math.max(r.left, 0);
        const right = Math.min(r.right, innerWidth);
        // Where across the shown part the light stands: its middle unless
        // the block says otherwise (`data-scene-at="0.2"`, the foot).
        const across = Number(at!.dataset.sceneAt) || 0.5;
        const top = Math.max(r.top, 0);
        const bottom = Math.min(r.bottom, innerHeight);
        // How far the layer slides to put its light (at 70% / 48%) there.
        const sx = left + (right - left) * across - innerWidth * 0.7;
        const sy = (top + bottom) / 2 - innerHeight * 0.48;
        scene!.style.setProperty('--scene-sx', `${sx.toFixed(1)}px`);
        scene!.style.setProperty('--scene-sy', `${sy.toFixed(1)}px`);
      };
      let last: string | undefined;
      const light = () => {
        if (!scene) return;
        const y = innerHeight / 2;
        const now = lit.find(el => el.getClientRects().length && showing(el, y));
        standLight(now);
        const value = now && photosOf(now);
        // The light's SHAPE is part of what changed: a grey screen and the
        // foot's name lend the same neutral light, and comparing the hues
        // alone left the screen's wide shape standing over the name.
        const kind =
          now &&
          (now.dataset.sceneKind ??
            (now.closest('[data-story], [data-phone-scene]') ? 'phone' : 'screen'));
        if (`${value}#${kind}` === last) return;
        last = `${value}#${kind}`;
        // "#a #b|0.8": the hues, then how strongly they light the page. The
        // hues of a screen with none stay as they were, so the light FADES
        // to the ground instead of turning grey on its way out.
        const [hues = '', k = '0'] = value?.split('|') ?? [];
        const [a, b = a, c = b] = hues.split(' ').filter(Boolean);
        if (a) {
          scene.style.setProperty('--scene-a', a);
          scene.style.setProperty('--scene-b', b);
          scene.style.setProperty('--scene-c', c);
        }
        scene.style.setProperty('--scene-k', k);
        // A phone draws the light as the picture's own glow (global.css
        // `--media-glow`), so the hues go where every picture inherits them.
        if (a) document.documentElement.style.setProperty('--glow', a);
        document.documentElement.style.setProperty('--glow-k', k);
        // A story's phone and a panel's screen hide the light differently
        // (global.css): the light keeps the shape of the last picture
        // while it fades out of every lit block.
        if (kind) scene.dataset.kind = kind;
      };
      if (scene && lit.length) {
        // Cheap enough to ask often: a deck can turn by itself (the voice
        // moving on), so a scroll listener alone would miss it.
        let queued = false;
        const ask = () => {
          if (queued) return;
          queued = true;
          requestAnimationFrame(() => {
            queued = false;
            light();
          });
        };
        addEventListener('scroll', ask, { passive: true });
        addEventListener('resize', ask, { passive: true });
        // A deck turning or an app switching moves the light at once, not
        // on the next tick — so it leaves with the phone, both ways.
        const turned = new MutationObserver(ask);
        for (const el of lit) turned.observe(el, { attributes: true, attributeFilter: ['class'] });
        for (const el of document.querySelectorAll('[data-apps-deck]'))
          turned.observe(el, { attributes: true, attributeFilter: ['hidden'] });
        setInterval(light, 200);
        light();
      }

      // TEN LINES (global.css `[data-cap]`): each box is as tall as ten
      // of its words' lines, measured from the first paragraph showing —
      // asked again whenever it is drawn at a new size (a deck shown, a
      // breakpoint, late fonts).
      //
      // A PHONE SETS ITS OWN (Juan, 2026-10-13), as `data-cap-phone`: a
      // number of lines, or `fill` — every whole line that fits between
      // the box's top and whatever stands under it, clear of the docked
      // controls (an app's welcome, which shows no picture on a phone).
      const LINES = 10;
      const phoneQuery = matchMedia('(max-width: 48rem)');
      // The docked row's height (the narrator, the tallest thing in it),
      // its 1rem off the screen's foot, and a step of air above it.
      const probe = document.createElement('div');
      probe.style.cssText = 'position:absolute;visibility:hidden;height:var(--narrator-h)';
      const dockReserve = () => {
        document.body.append(probe);
        const h = probe.offsetHeight;
        probe.remove();
        return h + 16 + 24;
      };
      const capTo = (box: HTMLElement) => {
        const ref =
          box.tagName === 'P'
            ? box
            : [...box.querySelectorAll<HTMLElement>(':scope > p')].find(c => c.getClientRects().length);
        if (!ref) return;
        const lh = parseFloat(getComputedStyle(ref).lineHeight);
        if (!lh) return;
        // A title riding at the top of the box (a phone's app slide) is
        // on top of the lines, not one of them.
        const lead = ref === box ? 0 : ref.offsetTop - parseFloat(getComputedStyle(box).paddingTop);
        const want = phoneQuery.matches ? box.dataset.capPhone : undefined;
        const cs = getComputedStyle(box);
        const padTop = parseFloat(cs.paddingTop);
        const fade = padTop;
        let lines = want && want !== 'fill' ? Number(want) : LINES;
        if (want === 'fill') {
          const section = box.closest('section');
          const r = box.getBoundingClientRect();
          // Whatever follows the box in its column (a store row).
          const after = [...(box.parentElement?.children ?? [])]
            .filter(el => el !== box && el.getClientRects().length)
            .filter(el => box.compareDocumentPosition(el) & Node.DOCUMENT_POSITION_FOLLOWING)
            .map(el => el.getBoundingClientRect().bottom);
          const below = after.length ? Math.max(...after) - r.bottom : 0;
          const top = r.top - (section?.getBoundingClientRect().top ?? 0);
          const room = innerHeight - dockReserve() - top - padTop - fade - below;
          lines = Math.max(3, Math.floor(room / lh));
        }
        box.style.maxHeight = `${lead + lh * lines}px`;
        // Words hidden past the box: only then does it keep a fade's depth
        // under them — a box that shows everything ends at its last line.
        const words = box.scrollHeight - padTop - parseFloat(cs.paddingBottom);
        box.classList.toggle('is-overflow', words > lead + lh * lines + 1);
        more(box);
      };
      // Which edges have words behind them, for their fades.
      const more = (box: HTMLElement) => {
        box.classList.toggle('is-scrolled', box.scrollTop > 2);
        box.classList.toggle('is-more', box.scrollTop + box.clientHeight < box.scrollHeight - 2);
      };
      const caps = [...document.querySelectorAll<HTMLElement>('[data-cap]')];
      const recap = new ResizeObserver(entries => {
        for (const e of entries) capTo(e.target as HTMLElement);
      });
      caps.forEach(box => {
        recap.observe(box);
        box.addEventListener('scroll', () => more(box), { passive: true });
      });
      document.fonts?.ready.then(() => caps.forEach(capTo));
      // An app's deck shown by its tab: its boxes measured at once, without
      // waiting on a frame.
      new MutationObserver(records => {
        for (const r of records)
          (r.target as HTMLElement).querySelectorAll<HTMLElement>('[data-cap]').forEach(capTo);
      }).observe(document.body, { attributes: true, attributeFilter: ['hidden'], subtree: true });
      // The paragraph being told scrolls into its box. Measured against the
      // BOX, not with `offsetTop`: that is relative to the nearest
      // positioned ancestor, which is not the box, so starting the voice
      // scrolled the box past the very paragraph it was about to read.
      document.addEventListener('narr:para', e => {
        const p = (e as CustomEvent<HTMLElement>).detail;
        const box = p?.closest<HTMLElement>('[data-cap]');
        if (!box || box === p) return;
        // Scrolled by hand a moment ago (director.ts `hold`): left where
        // the visitor put it.
        if (Number(box.dataset.heldUntil) > Date.now()) return;
        const top =
          box.scrollTop +
          p.getBoundingClientRect().top -
          box.getBoundingClientRect().top -
          parseFloat(getComputedStyle(box).paddingTop);
        box.scrollTo({ top: Math.max(0, top), behavior: 'smooth' });
      });

      // Scroll entrances: reveal once, then let the element live untouched.
      const io = new IntersectionObserver(
        entries => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-in');
              io.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.2 }
      );
      document.querySelectorAll('[data-reveal]').forEach(el => io.observe(el));

      // Media videos: play only while on screen (autoplay policies vary,
      // and an off-screen loop is wasted work). Reduced motion holds the
      // poster frame instead.
      const videos =
        document.querySelectorAll<HTMLVideoElement>('video[autoplay]');
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        videos.forEach(v => {
          v.removeAttribute('autoplay');
          v.pause();
        });
      } else if (videos.length > 0) {
        const vio = new IntersectionObserver(
          entries => {
            for (const entry of entries) {
              const video = entry.target as HTMLVideoElement;
              if (entry.isIntersecting) video.play().catch(() => {});
              else video.pause();
            }
          },
          { threshold: 0.25 }
        );
        videos.forEach(v => vio.observe(v));
      }
    </script>
  </body>
</html>
