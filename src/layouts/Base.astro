---
import { ui, type UIKey } from '../i18n/ui';
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/global.css';

type Props = {
  /** Page path ('' for home, 'salvalo/', 'work/'). */
  path?: string;
  titleKey?: UIKey;
};

const { path = '', titleKey = 'meta.title' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{ui.en[titleKey]}</title>
    <meta name="description" content={ui.en['meta.description']} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Brand faces for the mini landings: Sálvalo speaks Poppins, Crol
         speaks Mulish. Free faces, served by Google Fonts. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Mulish:wght@600;800&family=Poppins:wght@400;600;700&display=swap"
    />
    <link rel="canonical" href={new URL(`/${path}`, Astro.site)} />
    <meta property="og:title" content={ui.en[titleKey]} />
    <meta property="og:description" content={ui.en['meta.description']} />
    <meta property="og:type" content="website" />

    <script is:inline>
      // Theme and language, pre-paint — both are in-place preferences, no
      // locale URLs. Runs before first render so there is never a flash of
      // the wrong theme or the wrong language.
      (() => {
        const media = window.matchMedia('(prefers-color-scheme: dark)');
        const apply = () => {
          const pref = localStorage.getItem('theme') || 'system';
          const effective =
            pref === 'system' ? (media.matches ? 'dark' : 'light') : pref;
          document.documentElement.dataset.theme = effective;
        };
        apply();
        media.addEventListener('change', apply);
        window.addEventListener('storage', apply);
        // User-initiated switches play the inversion sweep (the light theme
        // IS the dark palette inverted — the transition says so): a View
        // Transitions wipe where supported, instant swap elsewhere.
        window.__applyTheme = () => {
          const reduced = window.matchMedia(
            '(prefers-reduced-motion: reduce)'
          ).matches;
          if (document.startViewTransition && !reduced) {
            // data-theme-wipe scopes the inversion sweep to THIS transition;
            // without it a page navigation would play the wipe too.
            document.documentElement.setAttribute('data-theme-wipe', '');
            document
              .startViewTransition(apply)
              .finished.finally(() =>
                document.documentElement.removeAttribute('data-theme-wipe')
              );
          } else apply();
        };

        const lang = localStorage.getItem('lang') || 'en';
        document.documentElement.lang = lang;
        document.documentElement.dataset.lang = lang;
      })();
    </script>
  </head>
  <body>
    <SiteHeader path={path} />
    <main>
      <slot />
    </main>

    <script>
      // Scroll entrances: reveal once, then let the element live untouched.
      const io = new IntersectionObserver(
        entries => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-in');
              io.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.2 }
      );
      document.querySelectorAll('[data-reveal]').forEach(el => io.observe(el));

      // Landing videos: play only while on screen (autoplay policies vary,
      // and an off-screen loop is wasted work). Reduced motion holds the
      // poster frame instead.
      const videos =
        document.querySelectorAll<HTMLVideoElement>('video[autoplay]');
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        videos.forEach(v => {
          v.removeAttribute('autoplay');
          v.pause();
        });
      } else if (videos.length > 0) {
        const vio = new IntersectionObserver(
          entries => {
            for (const entry of entries) {
              const video = entry.target as HTMLVideoElement;
              if (entry.isIntersecting) video.play().catch(() => {});
              else video.pause();
            }
          },
          { threshold: 0.25 }
        );
        videos.forEach(v => vio.observe(v));
      }
    </script>
  </body>
</html>
