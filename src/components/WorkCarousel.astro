---
import PanelDeck from './PanelDeck.astro';
import ArcadeCabinet from './ArcadeCabinet.astro';
import { PROJECTS } from '../lib/work';

/**
 * More Work — the projects that are not the apps (lib/work holds the
 * list); the game's card carries its cabinet in a slot.
 */
type Props = {
  /** The card a shared address opens over the page (pages/work). */
  focus?: string;
};
const { focus } = Astro.props;
---

<PanelDeck id="more-work" title="work.title" items={PROJECTS} focus={focus}>
  <ArcadeCabinet slot="arcade" />
</PanelDeck>
