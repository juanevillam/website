---
import T from './T.astro';
import type { UIKey } from '../i18n/ui';
import { clipFor, subsFor } from '../lib/narration';

/**
 * More Work — the projects that are not the three stars, after the game
 * and before the foot. SECONDARY on purpose: one panel, smaller type than
 * the stories, no scroll choreography.
 *
 * Every card is the game's own composition — words in the text column, a
 * SCREEN in the rest, the game's width (`--screen-cols`, `--screen-w`) —
 * and every screen is a capture of the project's landing page. The game is
 * 4:3 because the cabinet is; a landing's first screen is 16:9, and at 4:3
 * the capture ran past the hero into the next section's white band, so
 * the cards keep the game's WIDTH and take the web's own proportion.
 *
 * The carousel is ENDLESS and runs the full width of the page: cards
 * slide over the page edge rather than into a cut at the content's edge,
 * and on a wide screen the neighbours wait dimmed at both sides. Past the
 * last card the first one is simply next again.
 *
 * NARRATION: one clip per project, on its body paragraph, and ONE narrator
 * that does not travel with the deck — the cards slide UNDER it. It parks
 * one step under the current card's links, the way a story's narrator
 * parks under its caption, so it rises and falls with how much the card
 * says. Turning the deck while the voice runs plays the new card's clip;
 * a clip ending turns the deck to the next card.
 *
 * The deck turns by its controls only (arrows, dots, keys). Drag and the
 * trackpad's sideways swipe were tried and removed: they fought the
 * page's own scrolling.
 */
type Project = {
  id: string;
  name: string;
  /** A job title stays as written in every locale; a role is a key. */
  role: string | UIKey;
  from: string;
  /** null = still going ("Present"). */
  to: string | null;
  /** The paragraph — or one built around a link, as Crol's is (the
   *  employer named in the sentence takes you to it). */
  body: UIKey | { before: UIKey; link: UIKey; after: UIKey; href: string };
  /** The paragraph's narration clip, by convention (lib/narration). */
  clip: string;
  /** A 16:9 capture of the project's landing page — its hero only. */
  image: string;
  links: { label: string; href: string }[];
};

// Order is weight: the job, the startup, then client work, oldest last.
const PROJECTS: Project[] = [
  {
    id: 'crol',
    name: 'Crol ERP Móvil',
    role: 'Lead Frontend Developer',
    from: '2022',
    to: null,
    body: {
      before: 'work.crol.before',
      link: 'work.crol.link',
      after: 'work.crol.after',
      href: 'https://www.crol.mx',
    },
    clip: 'work.crol.body',
    image: '/media/work/crol.jpg',
    links: [
      {
        label: 'App Store',
        href: 'https://apps.apple.com/mx/app/crol-erp-m%C3%B3vil/id6743251171',
      },
      {
        label: 'Google Play',
        href: 'https://play.google.com/store/apps/details?id=com.crolapp',
      },
    ],
  },
  {
    id: 'salvalo',
    name: 'Salvalo',
    role: 'work.cofounder',
    from: '2024',
    to: null,
    body: 'work.salvalo.body',
    clip: 'work.salvalo.body',
    image: '/media/work/salvalo.jpg',
    links: [
      { label: 'salvalo.app', href: 'https://salvalo.app' },
      {
        label: 'App Store',
        href: 'https://apps.apple.com/es/app/salvalo/id6759407790',
      },
      {
        label: 'Google Play',
        href: 'https://play.google.com/store/apps/details?id=com.grostify.salvalo',
      },
    ],
  },
  {
    id: 'maktub',
    name: 'Maktub Art Fund',
    role: 'work.freelance',
    from: '2026',
    to: '2026',
    body: 'work.maktub.body',
    clip: 'work.maktub.body',
    image: '/media/work/maktub.jpg',
    links: [{ label: 'maktubartfund.com', href: 'https://maktubartfund.com' }],
  },
  {
    id: 'andreina',
    name: 'Andreina Aular',
    role: 'work.freelance',
    from: '2021',
    to: '2021',
    body: 'work.andreina.body',
    clip: 'work.andreina.body',
    image: '/media/work/andreina.jpg',
    links: [{ label: 'andreinaaular.com', href: 'https://andreinaaular.com' }],
  },
];

const isKey = (role: string): role is UIKey => role.startsWith('work.');

// Each card's clip, by its body paragraph's key.
const narr = PROJECTS.map(p => ({ clip: clipFor(p.clip), subs: subsFor(p.clip) }));
const voiced = narr.some(n => n.clip);
---

<section
  class="work"
  id="more-work"
  data-narr-panel={voiced ? '' : null}
>
  <!-- An eyebrow, not a headline: the stars above open on big titles and
       air; this panel is secondary, and a headline plus an intro line
       stacked over the card is what made it read cramped. -->
  <h2 class="inner label eyebrow">
    <T k="work.title" />
  </h2>

  <div
    class="carousel"
    id="work-carousel"
    tabindex="0"
    aria-roledescription="carousel"
    aria-label={'Projects'}
    data-reveal
  >
    <!-- Every card in ONE grid cell: the stage is as tall as the tallest
         card, and the script only ever moves them sideways. -->
    <div class="stage">
      {
        PROJECTS.map((p, i) => (
          <article
            class="card"
            aria-roledescription="slide"
            aria-label={`${i + 1} / ${PROJECTS.length}`}
          >
            <div class="words">
              <h3 class="name">{p.name}</h3>
              <p class="label meta">
                {isKey(p.role) ? <T k={p.role} /> : p.role}
                {' · '}
                {p.from}
                {p.to === null ? (
                  <>
                    {' – '}
                    <T k="work.present" />
                  </>
                ) : (
                  p.to !== p.from && ` – ${p.to}`
                )}
              </p>
              <p
                class="body"
                data-narr-para
                data-clip-en={narr[i].clip?.en}
                data-clip-es={narr[i].clip?.es}
                data-subs-en={narr[i].subs.en}
                data-subs-es={narr[i].subs.es}
              >
                {typeof p.body === 'string' ? (
                  <T k={p.body} />
                ) : (
                  <>
                    {/* No whitespace between the three parts: Astro keeps
                        it, and it lands before the comma. */}
                    <T k={p.body.before} /><a
                      href={p.body.href}
                      target="_blank"
                      rel="noopener noreferrer"><T k={p.body.link} /></a
                    ><T k={p.body.after} />
                  </>
                )}
              </p>
              {/* The phone's version: one short line (Crol keeps its link). */}
              <p class="body phone-copy">
                {typeof p.body === 'string' ? (
                  <T k={`work.${p.id}.m` as UIKey} />
                ) : (
                  <>
                    <T k={p.body.before} /><a
                      href={p.body.href}
                      target="_blank"
                      rel="noopener noreferrer"><T k={p.body.link} /></a
                    ><T k="work.crol.m.after" />
                  </>
                )}
              </p>
              <ul class="links">
                {p.links.map(link => (
                  <li>
                    <a href={link.href} target="_blank" rel="noopener noreferrer">
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
              {/* The narrator's place, kept EMPTY: it reserves the pill's
                  box under the links, and the still anchor below moves to
                  whichever card's slot is in front. */}
              {voiced && <div class="narr-slot" aria-hidden="true" />}
            </div>
            <div class="screen">
              <img
                src={p.image}
                alt={p.name}
                width="1440"
                height="810"
                loading="lazy"
                decoding="async"
                draggable="false"
              />
            </div>
          </article>
        ))
      }
    </div>

    {/* The one narrator's anchor, OUTSIDE the deck: it does not slide
        with the cards. The script stands it on the current card's slot. */}
    {
      voiced && (
        <div class="inner narr-static">
          <div class="narr-anchor" data-narr-anchor aria-hidden="true" />
        </div>
      )
    }

    <div class="inner controls">
      <button class="arrow" id="work-prev" type="button">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path
            d="M14.5 6 8.5 12l6 6"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        <span class="sr"><T k="work.prev" /></span>
      </button>
      <div class="dots">
        {
          PROJECTS.map((p, i) => (
            <button class="dot" type="button" data-to={i} aria-label={p.name} />
          ))
        }
      </div>
      <button class="arrow" id="work-next" type="button">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path
            d="M9.5 6l6 6-6 6"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        <span class="sr"><T k="work.next" /></span>
      </button>
    </div>
  </div>
</section>

<style>
  /* One full panel, snapped like the rest. The section carries no side
     padding: the carousel runs edge to edge, and `.inner` blocks take the
     page's gutter themselves. */
  .work {
    --gutter: clamp(1.25rem, 4vw, 2.5rem);
    /* A card is exactly the content column — the same box the game's
       grid uses — so its screen lands where the game's screen did. */
    --card-w: min(var(--content-max), calc(100vw - var(--gutter) * 2));
    --card-gap: var(--space-4);
    min-height: 100svh;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    display: flex;
    flex-direction: column;
    /* Top-aligned on the stories' own inset, not centred: centring is
       what stood it 108px lower than every story above it. */
    padding: var(--stage-top) 0 var(--stage-bottom);
    /* The page's edge is the only edge a card slides past. */
    overflow-x: clip;
  }

  .inner {
    width: var(--card-w);
    margin: 0 auto;
  }

  /* The eyebrow stands where a story's small lockup stands, in the same
     2rem box, so the card's name lands on a slide title's line. */
  .eyebrow {
    display: flex;
    align-items: center;
    height: 2rem;
  }

  /* One step under the links — the 1.5rem every narrated block gives
     its narrator. */
  .narr-slot {
    flex: none;
    height: var(--narrator-h);
    margin-top: 1.5rem;
  }

  /* Laid over the stage, in the words' column; the anchor inside rides
     down to the current card's slot and eases there when the card
     changes, so the narrator rises and falls instead of jumping. */
  .carousel {
    position: relative;
  }

  .narr-static {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    pointer-events: none;
  }

  .narr-static .narr-anchor {
    margin-top: 0;
    transform: translateY(var(--slot-y, 0px));
    transition: transform calc(var(--beat) * 0.75) var(--ease);
  }

  @media (prefers-reduced-motion: reduce) {
    .narr-static .narr-anchor {
      transition: none;
    }
  }

  /* ---------- the carousel ---------- */

  /* The carousel takes the rest of the panel, so its controls can stand
     at the panel's foot. */
  .carousel {
    flex: 1;
    display: flex;
    flex-direction: column;
    margin-top: 1.5rem;
    outline: none;
  }

  .stage {
    display: grid;
    justify-items: center;
  }

  /* The game's grid, card by card. Positions are the script's: each card
     sits at its offset from the current one, a card's width plus a gap
     apart. Neighbours step back so the current card is the one read. */
  .card {
    grid-area: 1 / 1;
    width: var(--card-w);
    display: grid;
    grid-template-columns: var(--screen-cols);
    gap: var(--space-4);
    align-items: start;
    transform: translateX(calc(var(--at, 0) * (var(--card-w) + var(--card-gap))));
    /* A neighbour is a hint that there is more, not something to read:
       nearly gone, and without its colour. */
    opacity: 0.12;
    filter: grayscale(1);
    transition:
      transform calc(var(--beat) * 0.75) var(--ease),
      opacity calc(var(--beat) * 0.75) var(--ease),
      filter calc(var(--beat) * 0.75) var(--ease);
    user-select: none;
  }

  .card.is-current {
    opacity: 1;
    filter: none;
  }

  .card:not(.is-current) a {
    pointer-events: none;
  }

  .card.is-jump {
    transition: none;
  }

  /* The stories' caption rhythm: name, then its line of facts tight
     under it, then the body one 1.25rem step down, the links one more,
     and the narrator the 1.5rem every narrated block gives it. */
  .words {
    display: flex;
    flex-direction: column;
  }

  .meta {
    margin-top: 0.5rem;
  }

  .words .body,
  .links {
    margin-top: 1.25rem;
  }

  /* A step below the stars' titles — this panel is secondary. */
  .name {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    font-weight: 800;
    letter-spacing: var(--track-heading);
    line-height: 1.05;
  }

  .meta {
    text-transform: none;
    letter-spacing: 0;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    padding: 0;
    list-style: none;
    font-size: 0.875rem;
  }

  .links a {
    color: var(--ink);
  }

  /* The game's screen — same width, same frame — in the web's 16:9. */
  .screen {
    width: var(--screen-w);
    justify-self: center;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 1px solid var(--hairline);
    border-radius: 1rem;
    background: var(--surface);
    box-shadow:
      0 2rem 4rem rgba(0, 0, 0, 0.55),
      0 0.5rem 1.25rem rgba(0, 0, 0, 0.4);
  }

  .screen img {
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: top;
  }

  /* ---------- controls ---------- */

  /* At the panel's FOOT and centred — the way the Sound Shaper opener
     centres its narrator under everything — not tucked under the words,
     where it crowded the narrator on every card with a full paragraph. */
  .controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: auto;
    padding-top: var(--gap-block);
  }

  /* The header's pill recipe, as a circle. */
  .arrow {
    display: inline-grid;
    place-items: center;
    width: var(--float-h);
    height: var(--float-h);
    border: 1px solid var(--hairline);
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface) 82%, transparent);
    color: var(--ink);
    cursor: pointer;
    transition: border-color var(--dur-micro) var(--ease);
  }

  .arrow:hover {
    border-color: var(--ink-3);
  }

  .dots {
    display: flex;
    gap: 0.25rem;
  }

  /* A 7px dot in a 20px target. */
  .dot {
    width: 1.25rem;
    height: 1.25rem;
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
  }

  .dot::after {
    content: '';
    display: block;
    width: 0.4375rem;
    height: 0.4375rem;
    margin: auto;
    border-radius: 999px;
    background: var(--ink-3);
    opacity: 0.5;
    transition:
      opacity var(--dur-micro) var(--ease),
      background var(--dur-micro) var(--ease);
  }

  .dot.is-current::after {
    background: var(--ink);
    opacity: 1;
  }

  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .card {
      transition: none;
    }
  }

  /* ---------- phones ---------- */

  @media (max-width: 48rem) {
    .work {
      --card-gap: 1.5rem;
    }


    /* Screen on top, words under it. */
    .card {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .screen {
      order: -1;
      width: 100%;
    }

    .words .body {
      font-size: 0.9375rem;
      line-height: 1.55;
    }

    .name {
      font-size: 1.5rem;
    }

  }

  /* ---------- phone ----------
     The short line instead of the paragraph (which stays, hidden, for the
     narration); the narrator sits in its corner there, so no card keeps
     a slot for it and no anchor rides over the deck. */
  .phone-copy {
    display: none;
  }

  @media (max-width: 48rem) {
    .phone-copy {
      display: block;
    }

    /* The deck's controls share the bottom row with the phone's corner
       narrator: arrows to the left, narrator to the right. */
    .controls {
      justify-content: flex-start;
    }

    .words .body[data-narr-para],
    .narr-slot,
    .narr-static {
      display: none;
    }
  }
</style>

<script>
  const carousel = document.getElementById('work-carousel') as HTMLElement;
  const stage = carousel.querySelector('.stage') as HTMLElement;
  const cards = [...stage.querySelectorAll<HTMLElement>('.card')];
  const dots = [...carousel.querySelectorAll<HTMLButtonElement>('.dot')];
  const n = cards.length;
  const section = carousel.closest<HTMLElement>('section');
  const paras = cards.map(c => c.querySelector<HTMLElement>('[data-narr-para]'));
  const stillAnchor = carousel.querySelector<HTMLElement>('.narr-static .narr-anchor');

  // Stand the still anchor on the current card's slot. Only the slot's
  // HEIGHT is read: the card's sideways slide never moves it.
  const standAnchor = () => {
    const slot = cards[current].querySelector<HTMLElement>('.narr-slot');
    if (!stillAnchor || !slot) return;
    const y = slot.getBoundingClientRect().top - carousel.getBoundingClientRect().top;
    stillAnchor.style.setProperty('--slot-y', `${y.toFixed(1)}px`);
  };

  let current = 0;
  /** Each card's last offset from the current one, to spot a wrap. */
  const was = cards.map((_, i) => i);

  // Offset of card i from the current one, wrapped so the deck has no
  // ends: half the cards wait on each side.
  const offset = (i: number) => {
    let d = (((i - current) % n) + n) % n;
    if (d >= n / 2) d -= n;
    return d;
  };

  const place = () => {
    cards.forEach((card, i) => {
      const d = offset(i);
      // A card that wraps from one end to the other would fly across the
      // page: it re-enters from just past its new side instead, unseen.
      if (Math.abs(d - was[i]) > 1) {
        card.classList.add('is-jump');
        card.style.setProperty('--at', String(d + Math.sign(d || 1)));
        void card.offsetWidth;
        card.classList.remove('is-jump');
      }
      card.style.setProperty('--at', String(d));
      card.classList.toggle('is-current', d === 0);
      card.setAttribute('aria-hidden', d === 0 ? 'false' : 'true');
      was[i] = d;
    });
    dots.forEach((dot, i) => dot.classList.toggle('is-current', i === current));
    // The narrator starts this panel on the card in front (its
    // `data-narr-start`), and a running voice switches to it.
    standAnchor();
    if (section) {
      section.dataset.narrStart = String(current);
      const para = paras[current];
      if (para)
        document.dispatchEvent(new CustomEvent('narr:select', { detail: para }));
    }
  };

  const go = (i: number) => {
    current = ((i % n) + n) % n;
    place();
  };

  document.getElementById('work-prev')?.addEventListener('click', () => go(current - 1));
  document.getElementById('work-next')?.addEventListener('click', () => go(current + 1));
  dots.forEach((dot, i) => dot.addEventListener('click', () => go(i)));

  // The voice moved on by itself (a clip ended): the deck follows it.
  document.addEventListener('narr:para', e => {
    const i = paras.indexOf((e as CustomEvent<HTMLElement>).detail);
    if (i >= 0 && i !== current) go(i);
  });

  carousel.addEventListener('keydown', e => {
    if (e.key === 'ArrowLeft') go(current - 1);
    else if (e.key === 'ArrowRight') go(current + 1);
    else return;
    e.preventDefault();
  });

  window.addEventListener('resize', standAnchor, { passive: true });
  // Text can reflow once fonts settle; re-stand the anchor on it.
  window.addEventListener('load', standAnchor);
  place();
</script>
