---
// The app glyphs of the brand family — crown (Topper), equalizer (Sound
// Shaper) and bento (Expo Starter). Same locked construction as the jv
// monogram: 48-unit grid, stroke 3.25, round caps/joins, no fill, flat.
type Props = {
  app: 'topper' | 'shaper' | 'starter';
  size?: number;
  class?: string;
};

const { app, size = 28, class: className } = Astro.props;
const viewBox = app === 'topper' ? '0 -1.25 48 48' : '0 0 48 48';
---

<svg
  width={size}
  height={size}
  viewBox={viewBox}
  fill="none"
  stroke="currentColor"
  stroke-width="3.25"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class={className}
>
  {
    app === 'topper' ? (
      <>
        <path d="M10 28V15.5l8.5 7L24 11l5.5 11.5 8.5-7V28z" />
        <path d="M10 34.5h28" />
      </>
    ) : app === 'shaper' ? (
      /* Matches apps/sound-shaper BrandMark.tsx — five bars on the midline. */
      <path d="M10 16.5v15M17 11.5v25M24 16v16M31 8v32M38 14v20" />
    ) : (
      <>
        <rect x="9" y="9" width="13.5" height="13.5" rx="3" />
        <circle cx="33" cy="15.75" r="6.75" />
        <rect x="9" y="29" width="30.75" height="10" rx="5" />
      </>
    )
  }
</svg>
