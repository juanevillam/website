---
import type { UIKey } from '../i18n/ui';
import StoreBadges from './StoreBadges.astro';
import AppTile from './AppTile.astro';
import type { ReleasedApp } from '../lib/releases';
import T from './T.astro';
import { clipFor, subsFor } from '../lib/narration';

/**
 * One app = one continuous scene, no snapping anywhere.
 *
 * The opener is full-bleed: lockup, the pitch, a hairline, the action
 * row. As you scroll on, the scene DOCKS — it morphs into a floating
 * window (rounded, hairlined, elevated a step off the ground) and the
 * screenshots run inside it as a FILMSTRIP, translated continuously by
 * the scroll itself. Scrub the page and the strip scrubs with it; there
 * are no steps to land on, only positions.
 *
 * Captions crossfade with a short vertical drift as their shot centers.
 * The icon + name are ONE lockup that FLIPs from the opener header into
 * the window's caption corner and parks there.
 *
 * Narration: Juan's voice, one clip per paragraph (see lib/narration).
 * A single shared Audio element tells the story as a pitch — paragraph
 * to paragraph, slide to slide, the page following the voice.
 */
export type StorySlide = {
  /** One screenshot — or two that SHARE one phone: a slide that tells two
   *  neighbouring screens shows them in turn on the same phone, so it
   *  looks like every other slide (same pixel size for both). */
  src: string | [string, string];
  width: number;
  height: number;
  /** Slide titles are ALWAYS English, in every locale — brand nouns. */
  title?: string;
  /** The caption, split in readable paragraphs — each one is also the
   *  transcript of its own narration clip. */
  paras?: UIKey[];
};

type Props = {
  id: string;
  name: string;
  /** The opener reads as a startup pitch — the problem, then the
   *  answer — one paragraph (and one narration clip) each. */
  pitch: UIKey[];
  /** After the last slide the story walks back to its opener and
   *  hands the scroll over — an endless deck. */
  loop?: boolean;
  slides: StorySlide[];
  /** Show the App Store / Google Play slots (apps, not web products). */
  stores?: boolean;
  /** Where the deck waits at the opener, on desktop: off the RIGHT edge
   *  ('side', the default) or below the BOTTOM edge ('rise') — so two
   *  stories in a row don't enter the same way twice. The words stay on
   *  the left either way: mirroring them was tried and read backwards. */
  enter?: 'side' | 'rise';
  /** Legal and support pages, linked from the opener — the stores
   *  require them reachable from outside the app. Grouped: each group
   *  renders as a small accordion. */
  linkGroups?: {
    key: UIKey;
    links: { key: UIKey; href: string }[];
  }[];
};

const {
  id,
  name,
  pitch,
  loop = false,
  slides,
  stores = false,
  enter = 'side',
  linkGroups = [],
} = Astro.props;

// The scroll rail: one viewport for the opener, one per screenshot —
// and one more where the story walks its opening moves backwards and
// hands the scroll back to the opener.
const stepCount = slides.length + (loop ? 2 : 1);

// Every narratable block, resolved against the clips on disk: the
// opener's pitch is block 0, each slide's caption the block of its step.
const narrate = (keys: UIKey[]) =>
  keys.map(k => ({ k, clip: clipFor(k), subs: subsFor(k) }));
const pitchParas = narrate(pitch);
const slideParas = slides.map(slide => narrate(slide.paras ?? []));
const voiced = (paras: { clip: unknown }[]) => paras.some(p => p.clip);

// PHONE copy: the short version of each block, found by convention — a
// pitch paragraph `k` has `k.m`; a slide's paragraphs `….sN.pM` share
// `….sN.m`. The narration stays on the full paragraphs (hidden there).
const mobileKey = (k: string) =>
  (/\.p\d+$/.test(k) ? k.replace(/\.p\d+$/, '.m') : `${k}.m`) as UIKey;
const pitchMobile = pitch.map(mobileKey);
const slideMobile = slides.map(sl => (sl.paras?.[0] ? mobileKey(sl.paras[0]) : null));
---

<section
  class="story"
  id={id}
  data-story={id}
  data-loop={loop ? '' : null}
  data-enter={enter}
  style={`--steps: ${stepCount}`}
>
  <!-- Invisible scroll rail — gives the story its length and carries
       each step's narration clip. No snapping: positions, not pages. -->
  <div class="steps" aria-hidden="true">
    <div class="step" data-index="0" />
    {slides.map((_, i) => <div class="step" data-index={i + 1} />)}
    {loop && <div class="step" data-index={slides.length + 1} />}
  </div>

  <div class="stage">
    <!-- The opener, full-bleed on the ground. -->
    <div class="intro-scene">
      <div class="intro-body">
      <div class="inner">
        <div class="lockup-anchor-big" aria-hidden="true"></div>

        <div class="intro-grid" data-reveal>
          <div
            class="pitch"
            data-narr-block={voiced(pitchParas) ? '0' : null}
          >
            {pitchParas.map(({ k, clip, subs }) => (
              <p
                class="body"
                data-narr-para
                data-clip-en={clip?.en}
                data-clip-es={clip?.es}
                data-subs-en={subs.en}
                data-subs-es={subs.es}
              >
                <T k={k} />
              </p>
            ))}
          </div>

          <!-- Reserves the action row's box; the row itself floats in
               the stage so it can travel to the slides. -->
          <div class="actions-anchor-big" aria-hidden="true"></div>

          {/* A RISING deck comes up under the page's middle, right where a
              centred narrator would stand — so there it parks under the
              store row instead, on the words' own left edge. */}
          {
            voiced(pitchParas) && enter === 'rise' && (
              <div
                class="narr-anchor narr-under-actions"
                data-narr-anchor="0"
                aria-hidden="true"
              />
            )
          }
        </div>
      </div>
      </div>

      {/* The opener's narrator stands on its own, centred on the page
          like the hero's, one step under the store row — not in the
          pitch, where it got lost among the words. */}
      {
        voiced(pitchParas) && enter !== 'rise' && (
          <div class="inner intro-narr">
            <div
              class="narr-anchor"
              data-narr-anchor="0"
              data-narr-align="center"
              aria-hidden="true"
            />
          </div>
        )
      }

      {
        linkGroups.length > 0 && (
          <footer class="inner intro-foot">
            <nav class="intro-links">
              {linkGroups.map(group => (
                <div class="link-group">
                  <span class="label">
                    <T k={group.key} />
                  </span>
                  <div class="group-links">
                    {group.links.map(link => (
                      <a href={link.href}>
                        <T k={link.key} />
                      </a>
                    ))}
                  </div>
                </div>
              ))}
            </nav>
          </footer>
        )
      }
    </div>

    <!-- The slides' scene, on the ground with the opener. -->
    <div class="float">
      <div class="float-grid">
        <div class="col-text">
        <div class="caption">
          <div class="lockup-anchor-small" aria-hidden="true"></div>
          {
            slides.map((slide, i) => (
              <div
                class="cap"
                data-narr-block={voiced(slideParas[i]) ? String(i + 1) : null}
              >
                {slide.title && <h3 class="slide-title">{slide.title}</h3>}
                {slideParas[i].map(({ k, clip, subs }) => (
                  <p
                    class="body"
                    data-narr-para
                    data-clip-en={clip?.en}
                    data-clip-es={clip?.es}
                    data-subs-en={subs.en}
                    data-subs-es={subs.es}
                  >
                    <T k={k} />
                  </p>
                ))}
                {voiced(slideParas[i]) && (
                  <div
                    class="narr-anchor"
                    data-narr-anchor
                    aria-hidden="true"
                  />
                )}
              </div>
            ))
          }
        </div>

          <!-- Where the action row comes to rest on the slides. -->
          <div class="actions-anchor-small" aria-hidden="true"></div>
        </div>

        <!-- Every shot in one stack; the scroll cross-fades them. The
             glow is a rim on the shot itself, nothing more. -->
        <div class="shots">
          {
              slides.map(slide => (
                <div
                  class:list={['slot', { 'is-pair': Array.isArray(slide.src) }]}
                >
                  {/* One phone. A pair stacks its second screen over the
                      first and cross-fades between them (see .layer-b). */}
                  <div class="shot-wrap">
                    {[slide.src].flat().map((src, layer) => {
                      const imgs = (
                        <>
                          <img
                            class="halo"
                            src={src}
                            alt=""
                            aria-hidden="true"
                            loading="lazy"
                            decoding="async"
                          />
                          <img
                            class="shot"
                            src={src}
                            alt={`${name} screenshot`}
                            width={slide.width}
                            height={slide.height}
                            loading="lazy"
                            decoding="async"
                          />
                        </>
                      );
                      return layer === 0 ? imgs : <div class="layer-b">{imgs}</div>;
                    })}
                  </div>
                </div>
              ))
            }
        </div>
      </div>
    </div>

    <!-- The shared lockup: icon + name in a row, once per story. Big on
         the opener, it shrinks into the window's caption corner as the
         scene docks — the render loop FLIPs it between the two anchors. -->
    <div class="lockup">
      <slot name="logo" />
      <span class="lockup-name">{name}</span>
    </div>

    <!-- The action row, drawn ONCE per story like the lockup: it sits
         under the opener's pitch and travels to the foot of the slides'
         text column, rather than fading out with the opener. -->
    <div class="actions">
      {stores && <StoreBadges app={id as ReleasedApp} />}
    </div>
  </div>

  <!-- THE PHONE'S STORY. Below 48rem the pinned stage above is not drawn
       at all: a phone gets plain full-screen panels on native scroll-snap
       — the opener, then one per slide, the screenshot large and the
       words short. Nothing here moves with the scroll by script, which is
       what made the stage drag on iOS. Each panel is a narrated block of
       its own (data-narr-panel); its full paragraphs ride along hidden,
       carrying the clips. -->
  <div class="m-story">
    <section
      class="m-panel m-opener"
      data-narr-panel={voiced(pitchParas) ? '' : null}
    >
      <div class="m-lockup">
        {/* Drawn at its phone size, not shrunk by CSS: the tile carries a
            negative margin solved for its own size, and scaling the SVG
            box cut the squircle off. Story ids are the tiles' app ids. */}
        <AppTile app={id as 'shaper' | 'topper'} size={52} />
        <span class="m-lockup-name">{name}</span>
      </div>
      {pitchMobile.map(k => (
        <p class="body m-copy">
          <T k={k} />
        </p>
      ))}
      {stores && <StoreBadges app={id as ReleasedApp} />}
      {pitchParas.map(({ clip, subs }) => (
        <span
          hidden
          data-narr-para
          data-clip-en={clip?.en}
          data-clip-es={clip?.es}
          data-subs-en={subs.en}
          data-subs-es={subs.es}
        />
      ))}
    </section>

    {/* All the slides in ONE panel, swiped sideways — a panel per slide
        made the page a long vertical climb. Native horizontal scroll-snap,
        so the swipe is Safari's own. */}
    <section
      class="m-panel m-deck"
      data-narr-panel={slideParas.some(voiced) ? '' : null}
      data-narr-start="0"
    >
      <div class="m-track">
        {slides.map((slide, i) => (
          <article class="m-card" aria-label={`${i + 1} / ${slides.length}`}>
            <div class:list={['m-shot', { 'is-pair': Array.isArray(slide.src) }]}>
              <div class="shot-wrap">
                {[slide.src].flat().map((src, layer) => {
                  const img = (
                    <img
                      class="shot"
                      src={src}
                      alt={`${name} screenshot`}
                      width={slide.width}
                      height={slide.height}
                      loading="lazy"
                      decoding="async"
                    />
                  );
                  return layer === 0 ? img : <div class="layer-b">{img}</div>;
                })}
              </div>
            </div>
            <div class="m-words">
              <div class="m-lockup m-lockup-small">
                <AppTile app={id as 'shaper' | 'topper'} size={24} />
                <span class="m-lockup-name">{name}</span>
              </div>
              {slide.title && <h3 class="slide-title">{slide.title}</h3>}
              {slideMobile[i] && (
                <p class="body m-copy">
                  <T k={slideMobile[i]!} />
                </p>
              )}
            </div>
            {/* This card's narration: its full paragraphs, hidden. `sub`
                is the paragraph's place in the card (a two-screen card
                shows the screen its paragraph is about). */}
            {slideParas[i].map(({ clip, subs }, sub) => (
              <span
                hidden
                data-narr-para
                data-card={i}
                data-sub={sub}
                data-clip-en={clip?.en}
                data-clip-es={clip?.es}
                data-subs-en={subs.en}
                data-subs-es={subs.es}
              />
            ))}
          </article>
        ))}
      </div>
      <div class="m-dots" aria-hidden="true">
        {slides.map(() => <span class="m-dot" />)}
      </div>
    </section>
  </div>
</section>

<style>
  .inner {
    width: 100%;
    max-width: var(--content-max);
    margin: 0 auto;
  }

  /* ---------- the scene ---------- */

  /* ONE spacing scale for the whole story — the opener and the slides
     read from the same four numbers, so nothing can drift apart. */
  .story {
    position: relative;
    height: calc(var(--steps) * 100svh);

    /* --stage-top, --stage-bottom and --gap-block are the PAGE's (see
       global.css): every full panel — the game, More Work — stands on
       the same three numbers, so nothing below the stories drifts. */
    /* The text column, and the opener's pitch at 1.5x of it. */
    --text-col: calc(100% * 6 / 13 * 0.81);
    --text-wide: calc(100% * 6 / 13 * 0.81 * 1.5);
  }

  @media (max-width: 48rem) {
    .story {
      --text-col: 100%;
      --text-wide: 100%;
    }
  }

  .steps {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /* Every step is a resting place, but only the OPENER insists on it:
     a gentle scroll still lands slide by slide, while a hard flick may
     pass several slides at once — a returning visitor's fingers shouldn't
     have to pay for every screen. A flick never skips a whole app, since
     each story's opener (and every panel) stops it. */
  .step {
    height: 100svh;
    scroll-snap-align: start;
    scroll-snap-stop: normal;
  }

  .step:first-child {
    scroll-snap-stop: always;
  }

  .stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
  }

  /* ---------- the opener ---------- */

  /* Content centered in the panel, the page foot pinned under it. */
  .intro-scene {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    /* The one stage inset — the slides' scene takes the same, so both
       start on the same line. */
    padding: var(--stage-top) clamp(1.25rem, 4vw, 2.5rem) var(--stage-bottom);
    will-change: opacity;
  }

  /* Content reads from the top, not centred in the panel: that is what
     puts it level with the slides and keeps the lockup's trip short.
     It does NOT grow — the foot follows the content by one step
     instead of being flung to the bottom of the panel. */
  .intro-body {
    display: flex;
    align-items: flex-start;
    min-height: 0;
  }

  .intro-grid {
    margin-top: var(--gap-block);
  }

  /* The pitch: problem over solution, reading left — twice the width
     of the window's caption column, no wider. */
  .pitch {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    max-width: var(--text-wide);
  }

  /* Long rows on purpose — the measure cap is for columns. */
  .pitch .body {
    max-width: none;
  }

  /* The pitch's own gap already spaces the narrator's anchor. */
  .pitch :global(.narr-anchor) {
    margin-top: 0;
  }

  /* While Juan is speaking a block, the page follows his voice: the
     paragraph being spoken holds full ink and the others step back —
     and any of them can be tapped to jump the voice there. */
  [data-narr-block] .body {
    transition: color calc(var(--beat) / 2) var(--ease);
  }

  [data-narr-block].is-narrating .body {
    color: var(--ink-3);
    cursor: pointer;
  }

  [data-narr-block].is-narrating .body.is-spoken {
    color: var(--ink);
  }

  /* The action row is drawn once in the stage and FLIPped between two
     anchors, exactly like the lockup — these reserve its box at each
     end so nothing reflows when it travels. */
  .actions {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 3;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    transform-origin: top left;
    will-change: transform;
  }

  .actions :global(.stores) {
    margin-top: 0;
  }

  /* Both ends of the row's trip reserve the same box and stand one
     step below the text they follow — which is what makes the gap
     identical on the opener and on every slide. */
  .actions-anchor-big,
  .actions-anchor-small {
    height: 3rem;
    margin-top: var(--gap-block);
  }

  /* The page foot: the legal and help pages, under one hairline at the
     bottom of the panel — where a foot belongs. */
  /* The rule sits on the links themselves, so it spans the content
     above it rather than the whole panel. */
  .intro-foot {
    margin-top: var(--gap-block);
  }

  /* A rising story's opener parks the narrator one block step under the
     store row, the step every block takes. */
  .narr-under-actions {
    margin-top: var(--gap-block);
  }

  /* The narrator's place on the opener: centred, two steps of air
     above it so it reads as its own moment, not the row's tail. */
  .intro-narr {
    display: flex;
    justify-content: center;
    margin-top: calc(var(--gap-block) * 2);
  }

  .intro-narr .narr-anchor {
    margin-top: 0;
  }

  .intro-links {
    display: flex;
    gap: clamp(2rem, 6vw, 4rem);
    padding-top: var(--gap-block);
    border-top: 1px solid var(--hairline);
    max-width: var(--text-wide);
  }

  .link-group .label {
    display: block;
  }

  .group-links {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 0.875rem;
  }

  .group-links a {
    font-size: 0.875rem;
    color: var(--ink-2);
    text-decoration-color: transparent;
    transition:
      color var(--dur-micro) var(--ease),
      text-decoration-color var(--dur-micro) var(--ease);
  }

  .group-links a:hover {
    color: var(--ink);
    text-decoration-color: var(--ink-3);
  }

  /* ---------- the floating window ---------- */

  /* Driven by --f (0 = full-bleed and invisible chrome, 1 = docked):
     the window pulls in from the stage edges, grows its corner and its
     hairline, and lifts one surface step off the ground. */
  /* The slides' scene: the same full-bleed stage the opener stands on —
     no detached container, the screenshots live on the ground. */
  /* Exactly the opener's box: the PADDING lives here and the grid
     centres inside it, the way `.inner` centres inside `.intro-scene`.
     When the grid carried both its own padding AND the max-width, it
     sat 40px further in than the opener at any width past the cap. */
  .float {
    position: absolute;
    inset: 0;
    z-index: 2;
    padding: var(--stage-top) clamp(1.25rem, 4vw, 2.5rem) var(--stage-bottom);
    /* The scene is ALWAYS there on desktop — the deck peeks in at the
       opener's right edge (--peek) and only the text column waits for
       --float-in. Phones keep the whole scene gated instead: a peeking
       phone over a single-column opener is collision, not cinema. */
    /* It covers the whole stage, including the opener beneath it — so
       the layer is DEAF and only the captions take events back. Without
       this it silently eats every hover and click on the opener. */
    pointer-events: none;
  }

  .float-grid {
    height: 100%;
    max-width: var(--content-max);
    margin: 0 auto;
    display: grid;
    grid-template-columns: var(--text-col) 1fr;
    gap: var(--space-4);
  }

  /* The text column: words at the top, the action row one step below
     them — the same step the opener uses. */
  .col-text {
    display: flex;
    flex-direction: column;
    min-height: 0;
    opacity: var(--float-in, 0);
    will-change: opacity;
  }

  /* The words start at the phone's own top edge, which is also where
     the opener's lockup sits — so the shared lockup barely travels
     between the two (it was a 171px trip when this was centred). */
  /* Every cap sits in the SAME grid cell, so the box is exactly as tall
     as the tallest one at any width — no guessed min-height to keep in
     sync, and the action row below never moves between slides.
     `align-self` must not be set here: in a flex column it is the cross
     axis, and `start` collapsed the column to its text's width. */
  .caption {
    position: relative;
    z-index: 1;
    display: grid;
  }

  /* The swap is a plain cross-fade, the way the system changes a label:
     the new words come up through the old ones in one short beat. Going
     out and then in (tried) blinked the column to black between them,
     and that blink was the part that still read as an animation. */
  .cap {
    grid-area: 1 / 1;
    /* Clear the small lockup parked above the captions. */
    padding-top: 3.5rem;
    opacity: 0;
    pointer-events: none;
    /* 50ms: the fastest a change still has a soft edge — below it the
       eye can no longer tell it from a cut. */
    transition: opacity calc(var(--beat) / 12) linear;
  }

  .cap.is-current {
    opacity: 1;
    pointer-events: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .cap,
    .cap.is-current {
      transition: none;
    }
  }

  /* The slide title IS the opener's name size — one ladder, and one
     1.25rem step everywhere: lockup → title → description. */
  .slide-title {
    font-size: clamp(2rem, 4vw, 3.25rem);
    font-weight: 800;
    letter-spacing: var(--track-display);
    line-height: 0.95;
  }

  .cap .body {
    margin-top: 1.25rem;
  }

  .cap .body + .body {
    margin-top: 0.875rem;
  }

  /* ---------- the filmstrip ---------- */

  /* The strip lives in its OWN clipped pane, so a travelling shot can
     never cross into the caption column and read through the words. */
  /* The pane still clips a travelling shot out of the words' column,
     but it fades at its edges instead of slicing — a hard cut was the
     one thing that gave the seam away mid-move. */
  /* The words take the comfortable inset under the header; the phone
     does not need it, so the pane reclaims that space and the shot
     runs as tall as the panel allows. */
  /* Every shot stacks in one cell and the scroll cross-fades them.
     Nothing travels, so nothing can be caught half-clipped — which is
     what the sliding strip kept doing, and what the edge masks and
     occluders existed to hide. */
  .shots {
    position: relative;
    height: auto;
    /* The pane runs from the header's bottom edge to the panel's, so
       the phone's air is EQUAL top and bottom — the slot's padding is
       the whole gap on both sides. Reclaiming half the top inset but
       all of the bottom one is what left it hanging low. */
    margin: calc(var(--header-h) - var(--stage-top)) 0
      calc(var(--stage-bottom) * -1);
    min-height: 0;
    display: grid;
    /* The PEEK: at the opener the whole deck stands off to the right,
       cropped by the stage's edge — the story is already on stage
       before it starts. Scrolling in walks it to its own column. */
    transform: translateX(calc(var(--peek, 0) * 58%));
    will-change: transform;
  }


  .slot {
    position: relative;
    z-index: 1;
    grid-area: 1 / 1;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    /* This padding IS the phone's gap, above and below alike. */
    padding: 1.5rem 0;
    opacity: 0;
    will-change: opacity, transform;
  }

  .slot:first-child {
    opacity: 1;
  }

  .shot-wrap {
    position: relative;
    height: 100%;
  }

  /* A slide with two screens keeps ONE phone, like every other slide:
     the second screen lies over the first and the phone turns between
     them on a SLOW clock — 24 beats round (~14s): each screen holds ~6s
     and the cross-fade takes ~1.2s. Ten beats (3s a screen) was tried
     and read as flicker. Two phones side by side were tried first and read as a
     different kind of slide in the middle of the deck. While Juan's voice
     tells the slide, the screen follows the paragraph instead
     (data-screen, set by the narrator). */
  .layer-b {
    position: absolute;
    inset: 0;
    animation: pair-swap calc(var(--beat) * 24) ease-in-out infinite;
  }

  .layer-b .shot {
    height: 100%;
  }

  @keyframes pair-swap {
    0%,
    42% {
      opacity: 0;
    }
    50%,
    92% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  .slot.is-pair[data-screen] .layer-b {
    animation: none;
    opacity: 0;
    /* The same ~1.2s turn as the clock's. */
    transition: opacity calc(var(--beat) * 2) ease-in-out;
  }

  .slot.is-pair[data-screen='1'] .layer-b {
    opacity: 1;
  }

  /* The gradient the image casts. Blurring a sharp-edged bitmap leaves
     a visible rectangle and banding, which is what read as cheap — so
     the halo is masked to an ellipse that fades to nothing well before
     its own edge, blurred far heavier, and kept dim. What's left is
     light in the shot's own colors, with no shape of its own. */
  .halo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    transform: scale(1.12);
    filter: blur(40px) saturate(1.6) brightness(1.1);
    opacity: 0.8;
    mask-image: radial-gradient(
      ellipse 60% 55% at 50% 50%,
      #000 0%,
      rgba(0, 0, 0, 0.6) 45%,
      transparent 75%
    );
  }

  /* A card away from the front: grey, and no halo at all — the halo is
     the most expensive thing on the page to paint, and at 0.4 opacity
     or less nobody sees it. */
  .slot.is-away .shot {
    filter: grayscale(1);
  }

  .slot.is-away .halo {
    display: none;
  }

  /* A phone's GPU pays for a 40px blur on every composited frame; the
     glow is decoration, so phones go without it. */
  @media (hover: none) and (pointer: coarse) {
    .halo {
      display: none;
    }
  }

  .shot {
    position: relative;
    height: 100%;
    width: auto;
    /* A real contact shadow does the depth the blur used to fake. */
    box-shadow:
      0 2rem 4rem rgba(0, 0, 0, 0.55),
      0 0.5rem 1.25rem rgba(0, 0, 0, 0.4);
    /* The global `img { max-width: 100% }` squishes an auto-width image
       inside a shrink-to-fit wrapper — the phone keeps its native
       1179:2556 ratio, whatever the column does. */
    max-width: none;

    /* The corner is the PHONE'S, not the App Store's — 55pt on a 393pt
       screen (14% / 6.46%), bottom corners cropped a beat tighter so a
       full-height sheet's dead corners never show. The hairline is
       Apple's dark-appearance treatment. No bezel, no fill. */
    border-radius: 14% 14% 15.9% 15.9% / 6.46% 6.46% 7.35% 7.35%;
    border: 1px solid var(--hairline);
  }

  /* ---------- the shared lockup ---------- */

  .lockup {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    height: 4.75rem;
    white-space: nowrap;
    transform-origin: top left;
    pointer-events: none;
    will-change: transform;
  }

  .lockup-name {
    font-size: clamp(2.5rem, 5.5vw, 4.25rem);
    font-weight: 800;
    letter-spacing: var(--track-display);
    line-height: 0.95;
  }

  /* The anchors: same box the lockup occupies at each end of the ride. */
  .lockup-anchor-big {
    height: 4.75rem;
  }

  /* Shares the caps' cell rather than taking a row of its own — as a
     second row it pushed the lockup below the body copy. */
  .lockup-anchor-small {
    grid-area: 1 / 1;
    align-self: start;
    justify-self: start;
    height: 2rem;
  }

  /* ---------- big screens ----------
     Past the container cap everything would just sit in the middle
     with growing margins, so the cap itself opens up and the phone
     grows with it. */
  @media (min-width: 100rem) {
    .story {
      --content-max: 82rem;
    }

    .float-grid,
    .intro-scene .inner,
    .intro-foot {
      max-width: var(--content-max);
    }
  }

  /* ---------- rising ----------
     The other way in: the deck waits below the stage's bottom edge, its
     top showing under the opener, and the first step lifts it into its
     column. Same columns, same gaps as a side entrance — only the
     direction of travel changes. Desktop only: phones have no peek. */
  @media (min-width: 48.01rem) {
    [data-enter='rise'] .shots {
      transform: translateY(calc(var(--peek, 0) * 62%));
    }
  }

  /* ---------- phones ----------
     One column, the phone on top and the words under it. The column
     tokens already went full-width; what changes here is the ORDER,
     the type, and how much copy is asked to carry the slide. */
  @media (max-width: 48rem) {
    .float-grid {
      grid-template-columns: 1fr;
      grid-template-rows: minmax(0, 1fr) auto;
      gap: 1rem;
    }

    .col-text {
      /* display: contents throws the box away, and its opacity with
         it — the whole scene gates on --float-in here instead. */
      display: contents;
    }

    .float {
      opacity: var(--float-in, 0);
      will-change: opacity;
    }

    .shots {
      order: -1;
      margin: 0;
      /* No peek on a single column — the deck would stand on the
         opener's own words. */
      transform: none;
    }

    .caption {
      order: 0;
    }

    /* The store row only shows on the opener — on a phone's slides its
       reserved box (48px plus a block step) was taken straight out of the
       phone's height. The anchor stays as the row's exit point, but takes
       no room. */
    .actions-anchor-small {
      order: 1;
      height: 0;
      margin-top: 0;
    }

    /* A phone reads the headline and one line under it. The second
       paragraph is the desk-sized detail — it would be a wall here.
       While the voice runs, the line shown is the line being SPOKEN. */
    .cap .body + .body {
      display: none;
    }

    .cap.is-narrating .body:not(.is-spoken) {
      display: none;
    }

    .cap.is-narrating .body.is-spoken {
      display: block;
    }

    .slide-title {
      font-size: clamp(1.75rem, 7vw, 2.25rem);
    }

    /* The small lockup is 2rem tall here too: 3.5rem puts the slide
       title one 1.5rem step under it, as on desktop (2.75rem left 12px). */
    .cap {
      padding-top: 3.5rem;
    }

    .lockup {
      gap: 0.75rem;
      height: 3.25rem;
    }

    .lockup-anchor-big {
      height: 3.25rem;
    }

    .lockup-name {
      font-size: clamp(1.75rem, 8vw, 2.25rem);
    }

    .pitch {
      gap: 1.25rem;
    }

    .intro-links {
      gap: 2rem;
    }

  }

  /* Short screens: the narrator's air halves, so three paragraphs, the
     store row and the pill still stand inside the panel. */
  @media (max-height: 46rem) {
    .intro-narr {
      margin-top: var(--gap-block);
    }
  }

  /* Short phones: the pitch reads its first paragraph — and while the
     voice runs, the one being spoken, as the slides do. */
  @media (max-width: 48rem) and (max-height: 46rem) {
    .pitch .body + .body {
      display: none;
    }

    .pitch.is-narrating .body:not(.is-spoken) {
      display: none;
    }

    .pitch.is-narrating .body.is-spoken {
      display: block;
    }
  }

  /* ---------- the phone's story ----------
     Above 48rem it is not drawn; below, it IS the story and the pinned
     stage is not. Every panel is one snapped screen sized for the space
     a phone browser really leaves (svh: Safari's bars showing), with room
     at the foot for the fixed narrator. */
  .m-story {
    display: none;
  }

  @media (max-width: 48rem) {
    .story {
      height: auto;
    }

    .story > .steps,
    .story > .stage {
      display: none;
    }

    .m-story {
      display: block;
    }

    .m-panel {
      position: relative;
      height: 100svh;
      scroll-snap-align: start;
      scroll-snap-stop: always;
      display: flex;
      flex-direction: column;
      padding: calc(var(--header-h) + 1rem) clamp(1.25rem, 4vw, 2.5rem)
        calc(var(--narrator-h) + 2rem);
    }

    .m-opener {
      justify-content: center;
      gap: 1.25rem;
    }

    .m-lockup {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .m-lockup-name {
      font-size: clamp(1.75rem, 8vw, 2.25rem);
      font-weight: 800;
      letter-spacing: var(--track-display);
      line-height: 0.95;
    }

    .m-lockup-small {
      gap: 0.5rem;
    }

    .m-lockup-small .m-lockup-name {
      font-size: 1rem;
      letter-spacing: var(--track-heading);
    }

    .m-copy {
      font-size: 1rem;
      line-height: 1.5;
    }

    /* The screenshot takes every pixel the words leave. */
    .m-shot {
      flex: 1;
      min-height: 0;
      display: flex;
      justify-content: center;
    }

    .m-shot .shot-wrap {
      position: relative;
      height: 100%;
    }

    .m-shot .shot {
      height: 100%;
      width: auto;
    }

    /* Room for three lines of copy whatever a card says, so the phone
       above is the same size on every card of the deck (measured: the
       words run 119-167px across en/es/zh at 390px wide). */
    .m-words {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      padding-top: 1.25rem;
      min-height: 10.5rem;
    }

    .m-words .slide-title {
      font-size: clamp(1.75rem, 7vw, 2.25rem);
    }

    /* The deck: one panel, the cards side by side in a native
       horizontal scroller that snaps card by card. It runs edge to edge
       of the panel's gutter; the dots stand at the foot, left of the
       corner narrator. */
    .m-deck {
      padding-left: 0;
      padding-right: 0;
    }

    .m-track {
      flex: 1;
      min-height: 0;
      display: flex;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    .m-track::-webkit-scrollbar {
      display: none;
    }

    /* min-width: 0 — without it a flex item never shrinks below its
       content, and the card grew to its paragraph's unwrapped width. */
    .m-card {
      flex: 0 0 100%;
      min-width: 0;
      scroll-snap-align: start;
      scroll-snap-stop: always;
      display: flex;
      flex-direction: column;
      min-height: 0;
      padding: 0 clamp(1.25rem, 4vw, 2.5rem);
    }

    .m-dots {
      position: absolute;
      left: clamp(1.25rem, 4vw, 2.5rem);
      bottom: calc(1rem + env(safe-area-inset-bottom) + var(--narrator-h) / 2);
      transform: translateY(50%);
      display: flex;
      gap: 0.5rem;
    }

    .m-dot {
      width: 0.4375rem;
      height: 0.4375rem;
      border-radius: 999px;
      background: var(--ink-3);
      opacity: 0.5;
      transition: opacity var(--dur-micro) var(--ease);
    }

    .m-dot.is-current {
      background: var(--ink);
      opacity: 1;
    }
  }

  .m-shot.is-pair[data-screen] .layer-b {
    animation: none;
    opacity: 0;
    transition: opacity calc(var(--beat) * 2) ease-in-out;
  }

  .m-shot.is-pair[data-screen='1'] .layer-b {
    opacity: 1;
  }
</style>

<script>
  // ---------- the continuous controller ----------
  // Everything is a pure function of the scroll position p (how many
  // viewports deep the story is): the opener fades, the floating window
  // docks (--f), the filmstrip translates 1:1 with p, the captions
  // crossfade around their shot, the lockup FLIPs between its anchors.
  // No steps, no snapping, no state machines — scrub and it scrubs.

  const reduceMotion = window.matchMedia(
    '(prefers-reduced-motion: reduce)'
  ).matches;

  const clamp = (v: number, min: number, max: number) =>
    Math.min(max, Math.max(min, v));

  // STEPPED on a touch screen. iOS scrolls on its own compositor and hands
  // the page its scroll position a frame or more late, so anything this
  // script moves pixel-by-pixel with the scroll trails behind the finger
  // and reads as heavy — however cheap the frame is (measured: ~52fps in a
  // throttled phone emulation, yet it still drags on a real iPhone 15).
  // So on touch the controller works in WHOLE STEPS: every scroll-coupled
  // value is rounded to the step the page is on, and the change between
  // two states is a CSS transition the GPU runs by itself (html.is-stepped
  // in global.css). A mouse or trackpad keeps the continuous scrub.
  const stepped = window.matchMedia(
    '(hover: none) and (pointer: coarse)'
  ).matches;
  const step = (v: number) => (stepped ? Math.round(v) : v);

  // PHONE: the stories are drawn as plain snapped panels (.m-story) and
  // the pinned stage is not drawn at all, so the controller drives no
  // stage and the narrator sits still in its corner (NarrationPlayer).
  // The layout is chosen once per load; crossing the line reloads.
  const phoneQuery = window.matchMedia('(max-width: 48rem)');
  const phone = phoneQuery.matches;
  phoneQuery.addEventListener('change', () => location.reload());

  const smooth = (v: number) => v * v * (3 - 2 * v);

  // ---------- narration ----------
  // Juan's voice tells the page as a pitch. One clip per paragraph and
  // ONE session across the whole page — the hero's intro, then each
  // story's opener and slides: paragraph to paragraph inside a block,
  // then the page itself turns and the voice follows it. The last slide
  // hands the scroll back to the opener, so the pitch closes on the store
  // row. Scroll by hand and the voice follows you; tap a paragraph that
  // is being told and it jumps there.

  const voice = new Audio();
  voice.preload = 'auto';
  // Dev only: lets a check drive the narrator SILENTLY — the analyser
  // still hears the voice (bars, subtitles, field all run), the speakers
  // do not. Never shipped.
  let devSilent = false;
  if (import.meta.env.DEV)
    Object.assign(window, {
      __narrVoice: voice,
      __narrSilence: () => {
        devSilent = true;
        if (output) output.gain.value = 0;
      },
    });

  /** A narrated block: the hero's wordmark, a story's opener pitch, one
   *  slide's caption, or a PANEL — a plain full-height section after the
   *  stories (the game), marked `data-narr-panel`. */
  type Narr = {
    el: HTMLElement;
    paras: HTMLElement[];
    anchor: HTMLElement | null;
    /** The story it belongs to, and its step there; null = the hero or a
     *  panel. */
    story: Story | null;
    step: number;
    panel: boolean;
  };

  type Story = {
    root: HTMLElement;
    /** Return step — the story loops back to its opener. */
    loop: boolean;
    steps: HTMLElement[];
    stage: HTMLElement | null;
    intro: HTMLElement | null;
    float: HTMLElement | null;
    slots: HTMLElement[];
    shotsBox: HTMLElement | null;
    caps: HTMLElement[];
    lockup: HTMLElement | null;
    anchorBig: HTMLElement | null;
    anchorSmall: HTMLElement | null;
    actions: HTMLElement | null;
    actionsBig: HTMLElement | null;
    actionsSmall: HTMLElement | null;
    /** Narrated blocks by step: the opener's pitch is 0. */
    blocks: (Narr | undefined)[];
    current: number;
  };

  const narrator = document.querySelector<HTMLElement>('[data-narrator]');

  /** Where the voice is — kept while paused, so play resumes in place. */
  let session: { block: Narr; para: number } | null = null;
  /** The person's intent: running, or paused by them. Not the element's
   *  own paused flag, which flips on its own at the end of every clip. */
  let running = false;
  /** The block the page is showing right now (set by the render loop). */
  let showing: Narr | undefined;

  const narrs: Narr[] = [];

  // Which recording a paragraph plays: the page's language when Juan
  // recorded it, the other one when he did not. Chinese has no recording;
  // it hears English under its own transcript.
  const voiceLang = (p: HTMLElement) => {
    const es = document.documentElement.dataset.lang === 'es';
    if (es) return p.dataset.clipEs ? 'es' : 'en';
    return p.dataset.clipEn ? 'en' : 'es';
  };

  const clipOf = (p: HTMLElement) =>
    voiceLang(p) === 'es' ? p.dataset.clipEs : p.dataset.clipEn;

  /** The subtitles for the recording that plays — always its language. */
  type Subs = { phrases: string[]; times?: number[] };
  const subsCache = new WeakMap<HTMLElement, Map<string, Subs | null>>();
  const subsOf = (p: HTMLElement): Subs | null => {
    const lang = voiceLang(p);
    let byLang = subsCache.get(p);
    if (!byLang) subsCache.set(p, (byLang = new Map()));
    if (!byLang.has(lang)) {
      const raw = lang === 'es' ? p.dataset.subsEs : p.dataset.subsEn;
      byLang.set(lang, raw ? (JSON.parse(raw) as Subs) : null);
    }
    return byLang.get(lang) ?? null;
  };

  const firstVoiced = (block: Narr | undefined, from = 0) => {
    if (!block) return -1;
    for (let i = from; i < block.paras.length; i++)
      if (clipOf(block.paras[i])) return i;
    return -1;
  };

  // Where a block's telling starts: its first recorded paragraph — unless
  // the block names its own start (`data-narr-start`), as a carousel does
  // for the card in front.
  const startOf = (block: Narr) => {
    const named = Number(block.el.dataset.narrStart);
    if (Number.isInteger(named) && block.paras[named] && clipOf(block.paras[named]))
      return named;
    return firstVoiced(block);
  };

  const paint = () => {
    for (const n of narrs) {
      const on = session?.block === n;
      // A two-screen slide shows the screen its spoken paragraph is about.
      const slot =
        n.story && n.step > 0
          ? n.story.slots[n.step - 1]
          : n.panel
            ? n.el.querySelector<HTMLElement>('.is-pair')
            : null;
      if (slot?.classList.contains('is-pair')) {
        // In a phone deck the spoken paragraph must belong to the pair's
        // own card; its `sub` says which of the two screens it is about.
        const spoken = on && session ? session.block.paras[session.para] : null;
        const card = slot.closest('.m-card');
        if (spoken && (!card || spoken.closest('.m-card') === card))
          slot.dataset.screen = spoken.dataset.sub ?? String(Math.min(session!.para, 1));
        else delete slot.dataset.screen;
      }
      n.el.classList.toggle('is-narrating', on);
      n.paras.forEach((p, i) =>
        p.classList.toggle('is-spoken', on && session?.para === i)
      );
    }
    narrator?.classList.toggle('is-playing', running);
  };

  // ----- listening: the voice, band by band -----
  // A live analyser on the voice, read once a frame into log-spaced
  // bands — the body of it first, the air last — plus where its energy
  // sits. Nothing is drawn here: the field along the foot of the screen
  // is what shows it (the pill is only play and pause).

  let ctx: AudioContext | null = null;
  let analyser: AnalyserNode | null = null;
  let output: GainNode | null = null;
  let freq: Uint8Array<ArrayBuffer> | null = null;

  // The analyser needs an AudioContext, which a browser only lets a
  // gesture create — so it is built on the first play. Routing the voice
  // through it is also what makes it audible from then on.
  const ensureGraph = () => {
    if (ctx) return;
    try {
      ctx = new AudioContext();
      const source = ctx.createMediaElementSource(voice);
      analyser = ctx.createAnalyser();
      analyser.fftSize = 2048;
      analyser.minDecibels = -85;
      analyser.maxDecibels = -25;
      analyser.smoothingTimeConstant = 0.72;
      output = ctx.createGain();
      output.gain.value = devSilent ? 0 : 1;
      source.connect(analyser).connect(output).connect(ctx.destination);
      freq = new Uint8Array(analyser.frequencyBinCount);
    } catch {
      ctx = null;
      analyser = null;
    }
  };

  // How finely the voice is split — the horizon's resolution.
  const BANDS = 16;
  // The voice's range, first band to last.
  const LOW_HZ = 90;
  const HIGH_HZ = 5000;

  let peak = 0.35;

  /** One level per band, centre first; zeros when nothing is speaking. */
  const voiceBands = (half: number) => {
    const out = new Array(half).fill(0);
    if (!analyser || !freq || !ctx) return out;
    analyser.getByteFrequencyData(freq);
    const binHz = ctx.sampleRate / analyser.fftSize;
    for (let k = 0; k < half; k++) {
      const lo = LOW_HZ * (HIGH_HZ / LOW_HZ) ** (k / half);
      const hi = LOW_HZ * (HIGH_HZ / LOW_HZ) ** ((k + 1) / half);
      const a = Math.max(1, Math.floor(lo / binHz));
      const b = Math.max(a + 1, Math.ceil(hi / binHz));
      let sum = 0;
      for (let i = a; i < b; i++) sum += freq[i];
      out[k] = sum / (b - a) / 255;
    }
    // Where the voice's energy sits, 0 (low) – 1 (high): the spectral
    // centroid across the same range, for the field's wavelength.
    let wsum = 0;
    let msum = 0;
    const lowBin = Math.floor(LOW_HZ / binHz);
    const highBin = Math.ceil(HIGH_HZ / binHz);
    for (let i = lowBin; i < highBin; i++) {
      wsum += i * freq[i];
      msum += freq[i];
    }
    if (msum > 0)
      brightness = Math.log((wsum / msum) / lowBin) / Math.log(highBin / lowBin);
    // A slow automatic gain so a quiet take still moves the field —
    // floored, so the room's hiss never passes for a voice.
    peak = Math.max(peak * 0.998, ...out, 0.35);
    return out.map(v => Math.min(1, v / peak) ** 1.6);
  };

  const listen = () => {
    const talking = running && !voice.paused;
    const bands = talking ? voiceBands(BANDS) : null;
    loudness = bands ? bands.reduce((a, b) => a + b, 0) / bands.length : 0;
    spectrum = bands ?? [];
  };

  // ----- the field: the page listens -----
  // Three hairline sound waves along the FOOT of the screen — a horizon
  // under the page, and the one place the voice is drawn (the pill is
  // only play and pause). Each stretch of each line answers its own band
  // of the voice (the body of it at the centre, the air towards the
  // sides, mirrored), and each strand reads the bands a little
  // differently, so they move apart rather than in lockstep. Silence
  // lays them flat; they travel only while there is voice to carry them.

  const field = document.querySelector<HTMLCanvasElement>('.nar-field');
  /** Mean band level this frame, 0–1 (set by listen). */
  let loudness = 0;
  /** The bars' bands this frame, centre first (set by listen). */
  let spectrum: number[] = [];
  /** Where the voice's energy sits, 0 low – 1 high (set by listen). */
  let brightness = 0.3;
  let heard: number[] = [];
  let tone = 0.3;
  let presence = 0;
  let travel = 0;
  let lastFrame = 0;
  let fieldDirty = false;
  // Where the horizon sits: low on the screen, clear of the content.
  const HORIZON = 0.86;
  // Three strands: wavelength, speed, how far along the spectrum each
  // one reads (so each leans on different bands), weight and ink.
  const STRANDS = [
    { k: 1, speed: 1, shift: 0, gain: 1, alpha: 1 },
    { k: 1.6, speed: -0.75, shift: 0.22, gain: 0.7, alpha: 0.6 },
    { k: 0.65, speed: 0.5, shift: -0.18, gain: 0.85, alpha: 0.45 },
  ];
  // The field's ink: the page's own --ink, only ever at a whisper.
  const INK = (() => {
    const hex = getComputedStyle(document.documentElement)
      .getPropertyValue('--ink')
      .trim()
      .replace('#', '');
    const n = parseInt(hex.length === 3 ? hex.replace(/./g, '$&$&') : hex, 16);
    return Number.isFinite(n)
      ? `${(n >> 16) & 255}, ${(n >> 8) & 255}, ${n & 255}`
      : '245, 245, 245';
  })();

  /** The heard level at a point along the spectrum, 0 centre – 1 edge. */
  const levelAt = (u: number) => {
    const n = heard.length;
    if (!n) return 0;
    const f = Math.min(n - 1, Math.max(0, u * (n - 1)));
    const i = Math.floor(f);
    const t = f - i;
    return (heard[i] ?? 0) * (1 - t) + (heard[i + 1] ?? heard[i] ?? 0) * t;
  };

  const drawField = (now: number) => {
    if (!field || !narrator || narrator.hidden || reduceMotion) return;
    const dt = lastFrame ? Math.min(now - lastFrame, 64) : 16;
    lastFrame = now;
    const talking = running && !voice.paused;

    // Quick enough to follow the voice, eased enough not to twitch.
    if (heard.length !== spectrum.length && spectrum.length)
      heard = new Array(spectrum.length).fill(0);
    for (let i = 0; i < heard.length; i++) {
      const target = talking ? spectrum[i] ?? 0 : 0;
      const d = target - heard[i];
      heard[i] += d * (d > 0 ? 0.3 : 0.12);
    }
    tone += (brightness - tone) * 0.08;
    presence += ((session && running ? 1 : 0) - presence) * 0.04;
    // They travel only on voice — a pause holds them where they are.
    travel += dt * 0.0024 * (0.1 + loudness);

    const g = field.getContext('2d');
    if (!g) return;
    if (presence < 0.004) {
      if (fieldDirty) {
        g.clearRect(0, 0, field.width, field.height);
        fieldDirty = false;
      }
      return;
    }
    fieldDirty = true;

    const w = window.innerWidth;
    const h = window.innerHeight;
    const ratio = Math.min(window.devicePixelRatio || 1, 2);
    if (field.width !== Math.round(w * ratio)) {
      field.width = Math.round(w * ratio);
      field.height = Math.round(h * ratio);
    }
    g.setTransform(ratio, 0, 0, ratio, 0, 0);
    g.clearRect(0, 0, w, h);

    const base = h * HORIZON;
    // Low voice → long, lazy waves; bright voice → tighter ones.
    const wavelength = 480 - 330 * Math.min(1, Math.max(0, tone));
    const reach = Math.min(h * 0.16, 140);

    g.lineWidth = 1;
    for (const strand of STRANDS) {
      g.strokeStyle = `rgba(${INK}, ${(presence * strand.alpha * (0.07 + 0.16 * loudness)).toFixed(4)})`;
      g.beginPath();
      for (let x = 0; x <= w; x += 5) {
        const u = x / w;
        // Mirrored from the centre: body in the middle,
        // air towards both sides — read at this strand's own shift.
        const along = Math.min(1, Math.max(0, Math.abs(u - 0.5) * 2 + strand.shift));
        const level = levelAt(along);
        // Flat at the screen's very edges, so the lines fade out rather
        // than being cut off.
        const edge = Math.sin(Math.PI * u);
        const y =
          base +
          Math.sin(
            ((x - w / 2) / wavelength) * Math.PI * 2 * strand.k +
              travel * strand.speed * Math.PI * 2
          ) *
            reach *
            level *
            strand.gain *
            edge;
        if (x) g.lineTo(x, y);
        else g.moveTo(x, y);
      }
      g.stroke();
    }
  };

  // ----- subtitles: the pill opens and says what Juan is saying -----
  const subEl = narrator?.querySelector<HTMLElement>('[data-nar-sub]');
  let subShown = '';

  /** The phrase being said now, or '' when there is none to show. */
  const currentPhrase = () => {
    if (!session || !running) return '';
    const subs = subsOf(session.block.paras[session.para]);
    if (!subs?.phrases.length) return '';
    const t = voice.currentTime || 0;
    let starts = subs.times;
    if (!starts) {
      // A plain transcript carries no timings: each phrase gets the share
      // of the clip its length earns, plus a beat for the breath between.
      const d = voice.duration;
      if (!Number.isFinite(d) || d <= 0) return '';
      const weights = subs.phrases.map(ph => ph.length + 12);
      const total = weights.reduce((a, b) => a + b, 0);
      let acc = 0;
      starts = weights.map(wt => {
        const at = (acc / total) * d;
        acc += wt;
        return at;
      });
    }
    let i = 0;
    while (i + 1 < starts.length && starts[i + 1] <= t) i++;
    return subs.phrases[i];
  };

  const updateSub = () => {
    if (!narrator || !subEl) return;
    const phrase = currentPhrase();
    narrator.classList.toggle('is-captioned', !!phrase);
    if (!phrase || phrase === subShown) return;
    subShown = phrase;
    // A fresh line per phrase, so each one fades in on its own.
    const line = document.createElement('span');
    line.className = 'nar-sub-line';
    line.textContent = phrase;
    subEl.replaceChildren(line);
  };

  // ----- placement: the narrator glides between its anchors -----
  /** The anchors in play and how much of the page each one owns. */
  let parks: { anchor: HTMLElement; w: number }[] = [];

  // Every frame, not only on scroll: the pill's own width animates when
  // it opens, and a centred anchor has to keep it centred all the way.
  const placeNarrator = () => {
    if (!narrator || narrator.hidden) return;
    // A phone's narrator never travels: it stays in its corner, shown
    // only while the screen holds a block it can tell.
    if (phone) {
      const has = !!showing && firstVoiced(showing) >= 0;
      narrator.style.opacity = has ? '' : '0';
      narrator.style.pointerEvents = has ? '' : 'none';
      return;
    }
    const width = narrator.offsetWidth;
    let sum = 0;
    let x = 0;
    let y = 0;
    for (const { anchor, w } of parks) {
      const r = anchor.getBoundingClientRect();
      const left =
        anchor.dataset.narrAlign === 'center'
          ? r.left + r.width / 2 - width / 2
          : r.left;
      sum += w;
      x += left * w;
      y += r.top * w;
    }
    if (sum > 0.0001)
      narrator.style.transform =
        `translate(${(x / sum).toFixed(1)}px, ${(y / sum).toFixed(1)}px)`;
    // Past the last narrated block (the page's foot) nothing owns the
    // narrator: it fades with the block that lets it go, instead of being
    // left standing wherever that block last put it.
    const own = Math.min(1, sum);
    narrator.style.opacity = own < 0.999 ? own.toFixed(3) : '';
    narrator.style.pointerEvents = own < 0.05 ? 'none' : '';
  };

  const animateNarrator = (now: number) => {
    updateSub();
    placeNarrator();
    listen();
    drawField(now);
    requestAnimationFrame(animateNarrator);
  };

  // ----- the session -----
  const stop = () => {
    voice.pause();
    session = null;
    running = false;
    paint();
  };

  const start = (block: Narr, para: number) => {
    const p = block.paras[para];
    const src = p && clipOf(p);
    if (!src) {
      stop();
      return;
    }
    ensureGraph();
    ctx?.resume();
    session = { block, para };
    running = true;
    voice.src = src;
    voice.play().catch(() => stop());
    paint();
    // Whatever shows this paragraph can follow the voice to it (the More
    // Work deck turns to the card being told).
    document.dispatchEvent(new CustomEvent('narr:para', { detail: p }));
  };

  const pause = () => {
    running = false;
    voice.pause();
    paint();
  };

  const resume = () => {
    running = true;
    ctx?.resume();
    voice.play().catch(() => stop());
    paint();
  };

  const scrollToStep = (story: Story, index: number) => {
    const top =
      story.root.getBoundingClientRect().top +
      window.scrollY +
      index * window.innerHeight;
    window.scrollTo({
      top,
      behavior: reduceMotion ? 'auto' : 'smooth',
    });
  };

  // A paragraph ends: the next one in the block, or the page turns and
  // the render loop picks the voice up wherever it lands (`follow`).
  voice.addEventListener('ended', () => {
    if (!session || !running) return;
    const { block, para } = session;
    const next = firstVoiced(block, para + 1);
    if (next >= 0) {
      start(block, next);
      return;
    }
    const story = block.story;
    if (block.panel) {
      // A panel hands over to the next panel, if there is one.
      const next = panels[panels.indexOf(block) + 1];
      if (next) scrollToPanel(next);
      else stop();
    } else if (!story) {
      // The hero hands over to the first story's opener.
      if (stories[0]) scrollToStep(stories[0], 0);
      else if (panels[0]) scrollToPanel(panels[0]);
      else stop();
    } else if (block.step + 1 < story.steps.length) {
      scrollToStep(story, block.step + 1);
    } else {
      // A story's last slide hands over to the next story's opener, and
      // the last story to the first panel — the pitch runs to the foot.
      const next = stories[stories.indexOf(story) + 1];
      if (next) scrollToStep(next, 0);
      else if (panels[0]) scrollToPanel(panels[0]);
      else stop();
    }
  });

  const scrollToPanel = (panel: Narr) =>
    window.scrollTo({
      top:
        (panel.el.closest<HTMLElement>('section') ?? panel.el)
          .getBoundingClientRect().top + window.scrollY,
      behavior: reduceMotion ? 'auto' : 'smooth',
    });

  // The page moved under a running voice — by hand or by the voice's own
  // page turn. The voice goes where the page went; a step with nothing
  // recorded (the loop's return) ends the pitch.
  const follow = (block: Narr | undefined) => {
    const para = block ? startOf(block) : -1;
    if (block && para >= 0) start(block, para);
    else stop();
  };

  // A block turned to another paragraph by hand (the More Work deck): a
  // running voice switches to it; a paused one will start there.
  document.addEventListener('narr:select', e => {
    const p = (e as CustomEvent<HTMLElement>).detail;
    if (!session) return;
    const i = session.block.paras.indexOf(p);
    if (i < 0 || i === session.para) return;
    if (running) start(session.block, i);
    else {
      session = { block: session.block, para: i };
      const src = clipOf(p);
      if (src) voice.src = src;
      paint();
    }
  });

  // The game has its own music: starting it quiets the voice, which
  // resumes from the same sentence on the next press.
  document.addEventListener('arcade:start', () => {
    if (running) pause();
  });

  // A language switch mid-sentence restarts that sentence in the new
  // voice; paused, the next play simply uses it.
  new MutationObserver(() => {
    if (!session) return;
    const { block, para } = session;
    if (running) start(block, para);
    else {
      const src = clipOf(block.paras[para]);
      if (src) voice.src = src;
    }
  }).observe(document.documentElement, { attributeFilter: ['data-lang'] });

  // One control. Pressed on the block being told, it pauses or resumes;
  // anywhere else, it starts telling what the page is showing.
  narrator?.addEventListener('click', () => {
    if (session && session.block === showing) {
      if (running) pause();
      else resume();
      return;
    }
    const block = showing ?? narrs[0];
    if (block) start(block, Math.max(startOf(block), 0));
  });

  const collect = (
    el: HTMLElement,
    story: Story | null,
    step: number,
    panel = false
  ) => {
    const n: Narr = {
      el,
      paras: [...el.querySelectorAll<HTMLElement>('[data-narr-para]')],
      // A block's anchor is inside it — unless the story placed it
      // elsewhere by name, as the opener does (in its foot).
      anchor:
        story?.root.querySelector<HTMLElement>(
          `[data-narr-anchor="${step}"]`
        ) ?? el.querySelector<HTMLElement>('[data-narr-anchor]'),
      story,
      step,
      panel,
    };
    // While a block is being told, its paragraphs are tappable too.
    n.paras.forEach((p, i) =>
      p.addEventListener('click', () => {
        if (session?.block === n && clipOf(p)) start(n, i);
      })
    );
    narrs.push(n);
    return n;
  };

  const heroEl = document.querySelector<HTMLElement>(
    '[data-narr-block="hero"]'
  );
  const heroNarr = heroEl ? collect(heroEl, null, -1) : undefined;

  const stories: Story[] = (
    phone ? [] : [...document.querySelectorAll<HTMLElement>('[data-story]')]
  ).map(root => {
    const story: Story = {
      root,
      loop: 'loop' in root.dataset,
      steps: [...root.querySelectorAll<HTMLElement>('.step')],
      stage: root.querySelector<HTMLElement>('.stage'),
      intro: root.querySelector<HTMLElement>('.intro-scene'),
      float: root.querySelector<HTMLElement>('.float'),
      slots: [...root.querySelectorAll<HTMLElement>('.slot')],
      shotsBox: root.querySelector<HTMLElement>('.shots'),
      caps: [...root.querySelectorAll<HTMLElement>('.cap')],
      lockup: root.querySelector<HTMLElement>('.lockup'),
      anchorBig: root.querySelector<HTMLElement>('.lockup-anchor-big'),
      anchorSmall: root.querySelector<HTMLElement>('.lockup-anchor-small'),
      actions: root.querySelector<HTMLElement>('.actions'),
      actionsBig: root.querySelector<HTMLElement>('.actions-anchor-big'),
      actionsSmall: root.querySelector<HTMLElement>('.actions-anchor-small'),
      blocks: [],
      current: -1,
    };
    for (const el of root.querySelectorAll<HTMLElement>('[data-narr-block]')) {
      const step = Number(el.dataset.narrBlock);
      story.blocks[step] = collect(el, story, step);
    }
    return story;
  });

  // Only the panels this layout draws: the phone's story panels are not
  // drawn on desktop, and must not join its hand-over chain.
  const panels = [
    ...document.querySelectorAll<HTMLElement>('[data-narr-panel]'),
  ]
    .filter(el => el.getClientRects().length > 0)
    .map(el => collect(el, null, -1, true));

  // Nothing recorded anywhere → no narrator at all.
  if (narrator && narrs.length) {
    narrator.hidden = false;
    requestAnimationFrame(animateNarrator);
  }

  // The hero rides out as the first story rides in.
  const heroInner = document.querySelector<HTMLElement>('[data-hero-inner]');

  const render = (force = false) => {
    const vh = window.innerHeight;
    const hp = step(clamp(window.scrollY / vh, 0, 1));

    // Where the narrator stands: a weighted blend of every anchor, each
    // weighted by how much of the page its block owns right now — so it
    // glides between blocks as the page scrolls, never jumps.
    parks = [];
    if (heroNarr?.anchor) parks.push({ anchor: heroNarr.anchor, w: 1 - hp });
    showing = heroNarr && window.scrollY < vh * 0.5 ? heroNarr : undefined;

    if (heroInner) {
      heroInner.style.opacity = String(clamp(1 - hp * 1.1, 0, 1));
      heroInner.style.transform = reduceMotion
        ? ''
        : `scale(${1 - hp * 0.08}) translateY(${(-hp * 0.06 * vh).toFixed(1)}px)`;
    }

    // A panel owns the narrator in proportion to how much of it is on
    // screen — the same glide a story hands over with — and owns the
    // voice once it holds the middle of the screen.
    for (const n of panels) {
      const section = n.el.closest<HTMLElement>('section') ?? n.el;
      const rect = section.getBoundingClientRect();
      if (rect.bottom < 0 || rect.top > vh) continue;
      // In by how far it has come up, out by how far it has gone — the
      // story rule, so two panels in a row cross-fade it at their seam.
      const own =
        step(clamp(1 - rect.top / vh, 0, 1)) * step(clamp(rect.bottom / vh, 0, 1));
      if (n.anchor && own > 0) parks.push({ anchor: n.anchor, w: own * hp });
      if (!showing && rect.top < vh * 0.5 && rect.bottom > vh * 0.5)
        showing = n;
    }

    for (const s of stories) {
      const rect = s.root.getBoundingClientRect();
      // The forced pass places every layer once at load, so nothing is
      // ever seen unstyled when a story first scrolls in.
      if (!force && (rect.bottom < 0 || rect.top > vh)) continue;

      const p = step(clamp(-rect.top / vh, 0, s.steps.length - 1));
      const active = Math.round(p);

      // Each step owns the narrator in a tent around its position; the
      // loop's return step belongs to the opener it lands on. A story
      // lets go as it scrolls off, so whatever comes up under it — the
      // next story, the game — takes the narrator over smoothly. Without
      // this, a story whose bottom sat exactly on the screen's top edge
      // still owned half the narrator and parked it mid-title.
      const out = step(clamp(rect.bottom / vh, 0, 1));
      // ...and a story coming up takes it by how far it has come in, so
      // two stories meeting cross-fade it — out + in = 1 at the seam —
      // the same glide the hero hands over with. (For the first story
      // this IS the hero's hp.)
      const enter = step(clamp(1 - rect.top / vh, 0, 1));
      for (let k = 0; k < s.steps.length; k++) {
        const own = Math.max(0, 1 - Math.abs(p - k));
        const block =
          s.loop && k === s.steps.length - 1 ? s.blocks[0] : s.blocks[k];
        if (own > 0 && block?.anchor)
          parks.push({ anchor: block.anchor, w: own * enter * out });
      }
      if (!showing) showing = s.blocks[active];

      // THE RETURN. One step past the last slide runs the opening
      // moves backwards — the float dissolves, the lockup and the
      // store row glide home to their opener anchors, the pitch fades
      // back in. Its end state IS the opener's, so when it lands the
      // controller silently rewinds the scroll and the story loops.
      const loopW = !s.loop
        ? 0
        : reduceMotion
          ? p > s.steps.length - 1.5
            ? 1
            : 0
          : smooth(clamp(p - (s.steps.length - 2), 0, 1));

      // The opener fades as the slides arrive — and back in on the way
      // home.
      if (s.intro) {
        const back = clamp((loopW - 0.55) * 2.2, 0, 1);
        s.intro.style.opacity = String(
          Math.max(clamp(1 - clamp(p, 0, 1) * 2.2, 0, 1), back)
        );
        s.intro.style.pointerEvents =
          p < 0.5 || loopW > 0.8 ? 'auto' : 'none';
      }

      // The slides' scene arrives once the opener is mostly gone.
      if (s.float) {
        s.float.style.setProperty(
          '--float-in',
          reduceMotion
            ? p >= 0.5 && loopW < 0.5
              ? '1'
              : '0'
            : String(clamp((p - 0.35) * 2.4, 0, 1) * (1 - loopW))
        );
        // The deck's PEEK: parked off the right edge at the opener,
        // walked into its column across the first step — and walked
        // back out on the return, so the loop's landing state matches
        // the opener it hands the scroll to.
        const peek = reduceMotion
          ? p < 0.5 || loopW >= 0.5
            ? 1
            : 0
          : Math.max(1 - smooth(clamp(p, 0, 1)), loopW);
        s.float.style.setProperty('--peek', peek.toFixed(4));
      }

      // THE DECK. The shots are a visible stack of cards: the ones
      // still to come peek out behind the front one — edges showing,
      // barely turned — and each step pulls the next card forward. A
      // passed card lifts toward the viewer and fades, the way a card
      // comes off the top of a deck.
      {
        const n = s.slots.length;
        // The deck is CIRCULAR: past the last card the first one is
        // simply next again. The return deals ONE more card instead of
        // riffling backwards over the front one, so the opener's card
        // arrives the same way every other card did — and the state it
        // lands on is the opener's exactly.
        const pos = clamp(p - 1, 0, s.steps.length - 2);
        const paneW = s.shotsBox?.clientWidth ?? 0;

        for (let i = 0; i < n; i++) {
          const lin = reduceMotion ? i - Math.round(pos) : i - pos;
          // Depth wrapped into [-0.5, n - 0.5): the card just dealt
          // lifts off in front of the stack; everything else waits
          // behind the front card, the dealt card rejoining at the
          // BACK once its lift has fully faded.
          const d = (((lin % n) + n + 0.5) % n) - 0.5;

          let op: number, x: number, rot: number, sc: number;
          if (d < 0) {
            // Lifted off the top: scales up toward the viewer and
            // fades, gone within half a step. No sideways travel, so
            // it can never cross into the words' column.
            const g = smooth(clamp(-d / 0.55, 0, 1));
            op = 1 - g;
            x = 0;
            rot = -2 * g;
            sc = 1 + 0.06 * g;
          } else {
            // Waiting in the stack: three edges visible behind the
            // front card, each a small step over and a hair turned.
            // Opacity reads the RAW depth, so a card sliding round to
            // the back of the stack arrives from nothing instead of
            // popping in at the last edge's strength.
            // Muted hard: the card being read is the only one at full
            // strength — the next one is a hint (0.4), the ones behind it
            // barely there (0.2, 0.08), and none of them in colour.
            const dd = Math.min(d, 3);
            op = d <= 1 ? 1 - d * 0.6 : 0.4 * Math.pow(0.5, d - 1);
            x = dd * paneW * 0.045;
            rot = dd * 2.5;
            sc = 1 - dd * 0.06;
          }

          s.slots[i].style.opacity = String(op);
          // A STATE, not a per-frame value: a filter that changes every
          // scroll frame re-rasterizes the card's 40px-blurred halo every
          // frame — fine on a Mac, a slideshow on an iPhone. The card goes
          // grey (and drops its halo) once it is more than half a step
          // away, and comes back the same way.
          s.slots[i].classList.toggle('is-away', Math.abs(d) > 0.5);
          s.slots[i].style.transform =
            `translateX(${x.toFixed(1)}px) ` +
            `rotate(${rot.toFixed(2)}deg) ` +
            `scale(${sc.toFixed(4)})`;
          // Front card on top, the stack receding behind it.
          s.slots[i].style.zIndex = String(100 - Math.round(d * 10));
        }
      }

      // Captions change as an EVENT, not with the scroll. Every earlier
      // version tied the words' opacity to the scroll position — a dip,
      // a drift, a settle — so each pixel of a slow or hesitant scroll
      // made them flicker, and read as noise beside the deck (which IS
      // scroll-coupled, rightly: it is things moving). The words just
      // hold, whole, until the next slide becomes the active one; then
      // one short cross-fade (CSS, `is-current`) and they hold again.
      for (let i = 0; i < s.caps.length; i++)
        s.caps[i].classList.toggle('is-current', active === i + 1);

      // The lockup FLIPs from the opener header to the window's caption
      // corner and parks there — one element, never redrawn.
      if (s.lockup && s.stage && s.anchorBig && s.anchorSmall) {
        const stageRect = s.stage.getBoundingClientRect();
        const big = s.anchorBig.getBoundingClientRect();
        const small = s.anchorSmall.getBoundingClientRect();
        const q = reduceMotion
          ? p >= 0.5 && loopW < 0.5
            ? 1
            : 0
          : smooth(clamp(p, 0, 1)) * (1 - loopW);
        const scale = 1 + (small.height / big.height - 1) * q;
        const x = big.left - stageRect.left + (small.left - big.left) * q;
        const y = big.top - stageRect.top + (small.top - big.top) * q;
        s.lockup.style.transform =
          `translate(${x.toFixed(1)}px, ${y.toFixed(1)}px) ` +
          `scale(${scale.toFixed(4)})`;
      }

      // The action row makes the same trip, from under the opener's
      // pitch to the foot of the slides' text column. It never scales:
      // both store programs set a minimum badge height, so the badges
      // keep the size they were measured at.
      if (s.actions && s.stage && s.actionsBig && s.actionsSmall) {
        const stageRect = s.stage.getBoundingClientRect();
        const big = s.actionsBig.getBoundingClientRect();
        const small = s.actionsSmall.getBoundingClientRect();
        const q = reduceMotion
          ? p >= 0.5 && loopW < 0.5
            ? 1
            : 0
          : smooth(clamp(p, 0, 1)) * (1 - loopW);
        const x = big.left - stageRect.left + (small.left - big.left) * q;
        const y = big.top - stageRect.top + (small.top - big.top) * q;
        s.actions.style.transform =
          `translate(${x.toFixed(1)}px, ${y.toFixed(1)}px)`;
        // The row belongs to the OPENER: it leaves with it and rides
        // the return home with it.
        const rowVis = reduceMotion
          ? p < 0.5 || loopW > 0.5
            ? 1
            : 0
          : Math.max(clamp(1 - clamp(p, 0, 1) * 2.2, 0, 1), loopW);
        s.actions.style.opacity = String(rowVis);
        s.actions.style.pointerEvents = rowVis > 0.5 ? 'auto' : 'none';
      }

      s.current = active;

      // Land the loop. The return step ends as a pixel-perfect copy of
      // the opener, so rewinding the scroll there is invisible — the
      // next flick down simply tells the story again.
      if (s.loop && p > s.steps.length - 1.002) {
        window.scrollTo({
          top: rect.top + window.scrollY,
          behavior: 'auto',
        });
      }
    }

    if (session && running && showing !== session.block) follow(showing);

    placeNarrator();
  };

  // A boolean "already scheduled" guard DEADLOCKS: if the frame it is
  // waiting on never runs — a hidden tab, a backgrounded window — the
  // flag stays set and the scene never renders again, even once the
  // page is visible. Replacing the pending frame instead can't get
  // stuck, and the visibility handler catches up whatever was missed.
  let frame = 0;
  const onScroll = () => {
    cancelAnimationFrame(frame);
    frame = requestAnimationFrame(() => render());
  };

  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) render(true);
  });

  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll, { passive: true });

  // The FLIP anchors sit inside `[data-reveal]` blocks, which enter 20px
  // low — measure during that and the row parks 20px off its anchor for
  // good, since nothing re-measures until the next scroll. Re-render
  // when a reveal settles.
  document.addEventListener(
    'transitionend',
    event => {
      const target = event.target as HTMLElement;
      if (target?.hasAttribute?.('data-reveal')) render(true);
    },
    { passive: true }
  );

  render(true);
  // Transitions switch on only AFTER the first placement, so nothing
  // animates in from nowhere on load.
  // ---------- the phone's decks ----------
  // Which card is in front: by the track's own scroll. The narrator starts
  // the panel there (data-narr-start = that card's first paragraph), a
  // running voice switches to it, and a clip that ends turns the deck.
  for (const deck of document.querySelectorAll<HTMLElement>('.m-deck')) {
    const track = deck.querySelector<HTMLElement>('.m-track');
    const cards = [...deck.querySelectorAll<HTMLElement>('.m-card')];
    const dots = [...deck.querySelectorAll<HTMLElement>('.m-dot')];
    const paras = [...deck.querySelectorAll<HTMLElement>('[data-narr-para]')];
    if (!track || !cards.length) continue;
    let front = -1;
    const settle = () => {
      const i = Math.round(track.scrollLeft / Math.max(track.clientWidth, 1));
      if (i === front) return;
      front = i;
      dots.forEach((d, k) => d.classList.toggle('is-current', k === i));
      const first = paras.find(p => p.dataset.card === String(i));
      if (first) {
        deck.dataset.narrStart = String(paras.indexOf(first));
        document.dispatchEvent(new CustomEvent('narr:select', { detail: first }));
      }
    };
    track.addEventListener('scroll', () => requestAnimationFrame(settle), {
      passive: true,
    });
    document.addEventListener('narr:para', e => {
      const p = (e as CustomEvent<HTMLElement>).detail;
      if (!deck.contains(p)) return;
      const i = Number(p.dataset.card);
      if (i !== front)
        track.scrollTo({
          left: i * track.clientWidth,
          behavior: reduceMotion ? 'auto' : 'smooth',
        });
    });
    settle();
  }

  if (stepped)
    requestAnimationFrame(() =>
      requestAnimationFrame(() =>
        document.documentElement.classList.add('is-stepped')
      )
    );
</script>
