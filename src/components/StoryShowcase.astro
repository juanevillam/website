---
import type { UIKey } from '../i18n/ui';
import ListenPill from './ListenPill.astro';
import StoreBadges from './StoreBadges.astro';
import T from './T.astro';

/**
 * One app = one continuous scene, no snapping anywhere.
 *
 * The opener is full-bleed: lockup, the pitch, a hairline, the action
 * row. As you scroll on, the scene DOCKS — it morphs into a floating
 * window (rounded, hairlined, elevated a step off the ground) and the
 * screenshots run inside it as a FILMSTRIP, translated continuously by
 * the scroll itself. Scrub the page and the strip scrubs with it; there
 * are no steps to land on, only positions.
 *
 * Captions crossfade with a short vertical drift as their shot centers.
 * The icon + name are ONE lockup that FLIPs from the opener header into
 * the window's caption corner and parks there.
 *
 * Narration: a single shared Audio element reads the slide nearest to
 * center and advances the scroll itself when a clip ends.
 */
export type StorySlide = {
  src: string;
  width: number;
  height: number;
  /** Slide titles are ALWAYS English, in every locale — brand nouns. */
  title?: string;
  /** The caption, split in readable paragraphs. */
  paras?: UIKey[];
  /** Narration clip for this slide — absent until it's recorded. */
  audio?: string;
};

type Props = {
  id: string;
  name: string;
  /** The opener reads as a startup pitch: problem and solution. */
  pitch: { problem: UIKey; solution: UIKey };
  /** The app's intro narration — why it exists, in Juan's voice. */
  introAudio?: string;
  slides: StorySlide[];
  /** Show the App Store / Google Play slots (apps, not web products). */
  stores?: boolean;
  /** Legal and support pages, linked from the opener — the stores
   *  require them reachable from outside the app. Grouped: each group
   *  renders as a small accordion. */
  linkGroups?: {
    key: UIKey;
    links: { key: UIKey; href: string }[];
  }[];
};

const {
  id,
  name,
  pitch,
  introAudio,
  slides,
  stores = false,
  linkGroups = [],
} = Astro.props;

// The scroll rail: one viewport for the opener, one per screenshot.
const stepCount = slides.length + 1;
---

<section
  class="story"
  id={id}
  data-story={id}
  style={`--steps: ${stepCount}`}
>
  <!-- Invisible scroll rail — gives the story its length and carries
       each step's narration clip. No snapping: positions, not pages. -->
  <div class="steps" aria-hidden="true">
    <div class="step" data-index="0" data-audio={introAudio} />
    {
      slides.map((slide, i) => (
        <div class="step" data-index={i + 1} data-audio={slide.audio} />
      ))
    }
  </div>

  <div class="stage">
    <!-- The opener, full-bleed on the ground. -->
    <div class="intro-scene">
      <div class="intro-body">
      <div class="inner">
        <div class="lockup-anchor-big" aria-hidden="true"></div>

        <div class="intro-grid" data-reveal>
          <div class="pitch">
            <div class="pitch-block">
              <span class="label"><T k="pitch.problem" /></span>
              <p class="body"><T k={pitch.problem} /></p>
            </div>
            <div class="pitch-block">
              <span class="label"><T k="pitch.solution" /></span>
              <p class="body"><T k={pitch.solution} /></p>
            </div>
          </div>

          <div class="intro-actions">
            {stores && <StoreBadges />}

            <ListenPill audio={introAudio} story={id} />
          </div>
        </div>
      </div>
      </div>

      {
        linkGroups.length > 0 && (
          <footer class="inner intro-foot">
            <nav class="intro-links">
              {linkGroups.map(group => (
                <div class="link-group">
                  <span class="label">
                    <T k={group.key} />
                  </span>
                  <div class="group-links">
                    {group.links.map(link => (
                      <a href={link.href}>
                        <T k={link.key} />
                      </a>
                    ))}
                  </div>
                </div>
              ))}
            </nav>
          </footer>
        )
      }
    </div>

    <!-- The slides' scene, on the ground with the opener. -->
    <div class="float">
      <div class="float-grid">
        <div class="caption">
          <div class="lockup-anchor-small" aria-hidden="true"></div>
          {
            slides.map(slide => (
              <div class="cap">
                {slide.title && <h3 class="slide-title">{slide.title}</h3>}
                {slide.paras?.map(k => (
                  <p class="body">
                    <T k={k} />
                  </p>
                ))}
              </div>
            ))
          }
        </div>

        <!-- The filmstrip: every shot in one row, translated by scroll. -->
        <div class="shots">
          <div class="strip">
            {
              slides.map(slide => (
                <div class="slot">
                  <div class="shot-wrap">
                    <img
                      class="halo"
                      src={slide.src}
                      alt=""
                      aria-hidden="true"
                      loading="lazy"
                      decoding="async"
                    />
                    <img
                      class="shot"
                      src={slide.src}
                      alt={`${name} screenshot`}
                      width={slide.width}
                      height={slide.height}
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>

    <!-- The shared lockup: icon + name in a row, once per story. Big on
         the opener, it shrinks into the window's caption corner as the
         scene docks — the render loop FLIPs it between the two anchors. -->
    <div class="lockup">
      <slot name="logo" />
      <span class="lockup-name">{name}</span>
    </div>
  </div>
</section>

<style>
  .inner {
    width: 100%;
    max-width: var(--content-max);
    margin: 0 auto;
  }

  /* ---------- the scene ---------- */

  .story {
    position: relative;
    height: calc(var(--steps) * 100svh);
  }

  .steps {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .step {
    height: 100svh;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  .stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
  }

  /* ---------- the opener ---------- */

  /* Content centered in the panel, the page foot pinned under it. */
  .intro-scene {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    padding: 5rem clamp(1.25rem, 4vw, 2.5rem) 2rem;
    will-change: opacity;
  }

  .intro-body {
    flex: 1;
    display: flex;
    align-items: center;
    min-height: 0;
  }

  .intro-grid {
    margin-top: 2rem;
  }

  /* The pitch: problem over solution, reading left — twice the width
     of the window's caption column, no wider. */
  .pitch {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    max-width: calc(100% * 6 / 13 * 0.81 * 1.5);
  }

  .pitch-block .body {
    margin-top: 0.5rem;
  }

  /* Long rows on purpose — the measure cap is for columns. */
  .pitch .body {
    max-width: none;
  }

  /* The download call sits right under the words it belongs to. */
  .intro-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: 2.25rem;
  }

  .intro-actions :global(.stores) {
    margin-top: 0;
  }

  .intro-actions :global(.listen) {
    margin-top: 0;
  }

  /* The page foot: the legal and help pages, under one hairline at the
     bottom of the panel — where a foot belongs. */
  /* The rule sits on the links themselves, so it spans the content
     above it rather than the whole panel. */
  .intro-links {
    display: flex;
    gap: 4rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--hairline);
    max-width: calc(100% * 6 / 13 * 0.81 * 1.5);
  }

  .link-group .label {
    display: block;
  }

  .group-links {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 0.875rem;
  }

  .group-links a {
    font-size: 0.875rem;
    color: var(--ink-2);
    text-decoration-color: transparent;
    transition:
      color var(--dur-micro) var(--ease),
      text-decoration-color var(--dur-micro) var(--ease);
  }

  .group-links a:hover {
    color: var(--ink);
    text-decoration-color: var(--ink-3);
  }

  /* ---------- the floating window ---------- */

  /* Driven by --f (0 = full-bleed and invisible chrome, 1 = docked):
     the window pulls in from the stage edges, grows its corner and its
     hairline, and lifts one surface step off the ground. */
  /* The slides' scene: the same full-bleed stage the opener stands on —
     no detached container, the screenshots live on the ground. */
  .float {
    position: absolute;
    inset: 0;
    z-index: 2;
    opacity: var(--float-in, 0);
    /* It covers the whole stage, including the opener beneath it — so
       the layer is DEAF and only the captions take events back. Without
       this it silently eats every hover and click on the opener. */
    pointer-events: none;
    will-change: opacity;
  }

  .float-grid {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: calc(100% * 6 / 13 * 0.81) 1fr;
    gap: var(--space-4);
    padding: 5rem clamp(1.25rem, 4vw, 2.5rem) 2.5rem;
    max-width: var(--content-max);
    margin: 0 auto;
  }

  /* The words start at the phone's own top edge, which is also where
     the opener's lockup sits — so the shared lockup barely travels
     between the two (it was a 171px trip when this was centred). */
  .caption {
    position: relative;
    z-index: 1;
    align-self: start;
    min-height: 16rem;
  }

  .cap {
    position: absolute;
    inset: 0 0 auto;
    /* Clear the small lockup parked above the captions. */
    padding-top: 3.5rem;
    opacity: 0;
    pointer-events: none;
    will-change: opacity;
  }

  /* The slide title IS the opener's name size — one ladder, and one
     1.25rem step everywhere: lockup → title → description. */
  .slide-title {
    font-size: clamp(2rem, 4vw, 3.25rem);
    font-weight: 800;
    letter-spacing: var(--track-display);
    line-height: 0.95;
  }

  .cap .body {
    margin-top: 1.25rem;
  }

  .cap .body + .body {
    margin-top: 0.875rem;
  }

  /* ---------- the filmstrip ---------- */

  /* The strip lives in its OWN clipped pane, so a travelling shot can
     never cross into the caption column and read through the words. */
  /* The pane still clips a travelling shot out of the words' column,
     but it fades at its edges instead of slicing — a hard cut was the
     one thing that gave the seam away mid-move. */
  .shots {
    position: relative;
    height: 100%;
    min-height: 0;
    overflow: hidden;
    mask-image: linear-gradient(
      to right,
      transparent,
      #000 9%,
      #000 91%,
      transparent
    );
  }

  .strip {
    position: absolute;
    inset: 0;
    display: flex;
    will-change: transform;
  }

  .slot {
    flex: 0 0 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    /* Air for the glow and the contact shadow, so the pane never
       crops either. */
    padding: 3rem 0;
  }

  .shot-wrap {
    position: relative;
    height: 100%;
  }

  /* The gradient the image casts. Blurring a sharp-edged bitmap leaves
     a visible rectangle and banding, which is what read as cheap — so
     the halo is masked to an ellipse that fades to nothing well before
     its own edge, blurred far heavier, and kept dim. What's left is
     light in the shot's own colors, with no shape of its own. */
  .halo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    transform: scale(1.22);
    filter: blur(64px) saturate(1.7) brightness(1.15);
    opacity: 0.7;
    mask-image: radial-gradient(
      ellipse 60% 55% at 50% 50%,
      #000 0%,
      rgba(0, 0, 0, 0.6) 45%,
      transparent 75%
    );
  }

  .shot {
    position: relative;
    height: 100%;
    width: auto;
    /* A real contact shadow does the depth the blur used to fake. */
    box-shadow:
      0 2rem 4rem rgba(0, 0, 0, 0.55),
      0 0.5rem 1.25rem rgba(0, 0, 0, 0.4);
    /* The global `img { max-width: 100% }` squishes an auto-width image
       inside a shrink-to-fit wrapper — the phone keeps its native
       1179:2556 ratio, whatever the column does. */
    max-width: none;

    /* The corner is the PHONE'S, not the App Store's — 55pt on a 393pt
       screen (14% / 6.46%), bottom corners cropped a beat tighter so a
       full-height sheet's dead corners never show. The hairline is
       Apple's dark-appearance treatment. No bezel, no fill. */
    border-radius: 14% 14% 15.9% 15.9% / 6.46% 6.46% 7.35% 7.35%;
    border: 1px solid var(--hairline);
  }

  /* ---------- the shared lockup ---------- */

  .lockup {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    height: 4.75rem;
    white-space: nowrap;
    transform-origin: top left;
    pointer-events: none;
    will-change: transform;
  }

  .lockup-name {
    font-size: clamp(2.5rem, 5.5vw, 4.25rem);
    font-weight: 800;
    letter-spacing: var(--track-display);
    line-height: 0.95;
  }

  /* The anchors: same box the lockup occupies at each end of the ride. */
  .lockup-anchor-big {
    height: 4.75rem;
  }

  .lockup-anchor-small {
    height: 2rem;
  }

  @media (max-width: 48rem) {
    .float-grid {
      grid-template-columns: 1fr;
      grid-template-rows: minmax(0, 1fr) auto;
      gap: 1.25rem;
      padding: 1.5rem 1.25rem;
    }

    .shots {
      order: -1;
    }

    .caption {
      min-height: 13rem;
    }

    .slide-title {
      font-size: clamp(1.75rem, 7vw, 2.25rem);
    }

    .lockup {
      gap: 1rem;
    }

    .lockup-name {
      font-size: 2rem;
    }
  }
</style>

<script>
  // ---------- the continuous controller ----------
  // Everything is a pure function of the scroll position p (how many
  // viewports deep the story is): the opener fades, the floating window
  // docks (--f), the filmstrip translates 1:1 with p, the captions
  // crossfade around their shot, the lockup FLIPs between its anchors.
  // No steps, no snapping, no state machines — scrub and it scrubs.

  const reduceMotion = window.matchMedia(
    '(prefers-reduced-motion: reduce)'
  ).matches;

  const clamp = (v: number, min: number, max: number) =>
    Math.min(max, Math.max(min, v));

  const smooth = (v: number) => v * v * (3 - 2 * v);

  const voice = new Audio();
  voice.preload = 'auto';

  type Story = {
    root: HTMLElement;
    steps: HTMLElement[];
    stage: HTMLElement | null;
    intro: HTMLElement | null;
    float: HTMLElement | null;
    strip: HTMLElement | null;
    shotsBox: HTMLElement | null;
    caps: HTMLElement[];
    lockup: HTMLElement | null;
    anchorBig: HTMLElement | null;
    anchorSmall: HTMLElement | null;
    pill: HTMLElement | null;
    current: number;
  };

  let armed: Story | null = null;

  const setPill = (story: Story, playing: boolean) => {
    story.pill?.classList.toggle('is-playing', playing);
  };

  const disarm = () => {
    if (!armed) return;
    voice.pause();
    voice.onended = null;
    setPill(armed, false);
    armed = null;
  };

  const scrollToStep = (story: Story, index: number) => {
    const top =
      story.root.getBoundingClientRect().top +
      window.scrollY +
      index * window.innerHeight;
    window.scrollTo({
      top,
      behavior: reduceMotion ? 'auto' : 'smooth',
    });
  };

  const playStep = (story: Story, index: number) => {
    const src = story.steps[index]?.dataset.audio;
    // Narration ends where the recorded clips do — never a lying pill.
    if (!src) {
      disarm();
      return;
    }
    voice.src = src;
    voice.onended = () => {
      if (armed !== story) return;
      if (index + 1 < story.steps.length) scrollToStep(story, index + 1);
      else disarm();
    };
    voice.play().catch(() => disarm());
  };

  const stories: Story[] = [
    ...document.querySelectorAll<HTMLElement>('[data-story]'),
  ].map(root => {
    const story: Story = {
      root,
      steps: [...root.querySelectorAll<HTMLElement>('.step')],
      stage: root.querySelector<HTMLElement>('.stage'),
      intro: root.querySelector<HTMLElement>('.intro-scene'),
      float: root.querySelector<HTMLElement>('.float'),
      strip: root.querySelector<HTMLElement>('.strip'),
      shotsBox: root.querySelector<HTMLElement>('.shots'),
      caps: [...root.querySelectorAll<HTMLElement>('.cap')],
      lockup: root.querySelector<HTMLElement>('.lockup'),
      anchorBig: root.querySelector<HTMLElement>('.lockup-anchor-big'),
      anchorSmall: root.querySelector<HTMLElement>('.lockup-anchor-small'),
      pill: document.querySelector<HTMLElement>(
        `[data-narrate-story="${root.dataset.story}"]`
      ),
      current: -1,
    };

    // The pill lives on the opener, so arming starts the story where
    // the person is standing: the opener's own clip, then onward.
    story.pill?.addEventListener('click', () => {
      if (armed === story) {
        disarm();
        return;
      }
      disarm();
      armed = story;
      setPill(story, true);
      playStep(story, Math.max(story.current, 0));
    });

    return story;
  });

  // The hero rides out as the first story rides in.
  const heroInner = document.querySelector<HTMLElement>('[data-hero-inner]');

  const render = (force = false) => {
    const vh = window.innerHeight;

    if (heroInner) {
      const hp = clamp(window.scrollY / vh, 0, 1);
      heroInner.style.opacity = String(clamp(1 - hp * 1.1, 0, 1));
      heroInner.style.transform = reduceMotion
        ? ''
        : `scale(${1 - hp * 0.08}) translateY(${(-hp * 0.06 * vh).toFixed(1)}px)`;
    }

    for (const s of stories) {
      const rect = s.root.getBoundingClientRect();
      // The forced pass places every layer once at load, so nothing is
      // ever seen unstyled when a story first scrolls in.
      if (!force && (rect.bottom < 0 || rect.top > vh)) continue;

      const p = clamp(-rect.top / vh, 0, s.steps.length - 1);
      const active = Math.round(p);

      // The opener fades as the slides arrive.
      if (s.intro) {
        s.intro.style.opacity = String(clamp(1 - clamp(p, 0, 1) * 2.2, 0, 1));
        s.intro.style.pointerEvents = p < 0.5 ? 'auto' : 'none';
      }

      // The slides' scene arrives once the opener is mostly gone.
      if (s.float) {
        s.float.style.setProperty(
          '--float-in',
          reduceMotion
            ? p >= 0.5
              ? '1'
              : '0'
            : String(clamp((p - 0.35) * 2.4, 0, 1))
        );
      }

      // The filmstrip: 1:1 with the scroll past the opener.
      if (s.strip && s.shotsBox) {
        const w = s.shotsBox.clientWidth;
        const pos = clamp(p - 1, 0, s.steps.length - 2);
        s.strip.style.transform = `translateX(${(-pos * w).toFixed(1)}px)`;
      }

      // Captions: crossfade with a short eased drift as their shot
      // centers in the window.
      for (let i = 0; i < s.caps.length; i++) {
        const t = p - (i + 1);
        const at = Math.abs(t);
        if (reduceMotion) {
          s.caps[i].style.opacity = active === i + 1 ? '1' : '0';
          continue;
        }
        // A pure crossfade, and a quick one — the words arrive in
        // place, they don't ride and they don't linger.
        s.caps[i].style.opacity = String(clamp(1 - at * 4.5, 0, 1));
        s.caps[i].style.pointerEvents = at < 0.5 ? 'auto' : 'none';
      }

      // The lockup FLIPs from the opener header to the window's caption
      // corner and parks there — one element, never redrawn.
      if (s.lockup && s.stage && s.anchorBig && s.anchorSmall) {
        const stageRect = s.stage.getBoundingClientRect();
        const big = s.anchorBig.getBoundingClientRect();
        const small = s.anchorSmall.getBoundingClientRect();
        const q = reduceMotion ? (p >= 0.5 ? 1 : 0) : smooth(clamp(p, 0, 1));
        const scale = 1 + (small.height / big.height - 1) * q;
        const x = big.left - stageRect.left + (small.left - big.left) * q;
        const y = big.top - stageRect.top + (small.top - big.top) * q;
        s.lockup.style.transform =
          `translate(${x.toFixed(1)}px, ${y.toFixed(1)}px) ` +
          `scale(${scale.toFixed(4)})`;
      }

      if (active !== s.current) {
        s.current = active;
        if (armed === s) playStep(s, active);
      }
    }
  };

  let ticking = false;
  const onScroll = () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      ticking = false;
      render();
    });
  };

  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll, { passive: true });
  render(true);
</script>
