---
import type { UIKey } from '../i18n/ui';
import StoreBadges from './StoreBadges.astro';
import AppTile from './AppTile.astro';
import type { ReleasedApp } from '../lib/releases';
import T from './T.astro';
import DeckControls from './DeckControls.astro';
import { clipFor, subsFor } from '../lib/narration';
import { sceneAttr, sceneOf } from '../lib/scene';

/**
 * One app = two stops: the opener, then its slides.
 *
 * The opener is full-bleed: lockup, the pitch, the action row, with the
 * first phone already waiting at the edge. One scroll walks that phone in
 * and the words of the first slide up, and the icon + name — ONE lockup —
 * FLIP from the opener's header to the slides' corner and park there.
 *
 * The slides are a DECK that turns SIDEWAYS (lib/deck.ts — More Work's
 * slider), not more scroll: three more screens of vertical scrolling read
 * as not getting anywhere (Juan, 2026-10-02). The page keeps one rhythm —
 * section, section — and a story is one of them.
 *
 * Narration: Juan's voice, one clip per paragraph (see lib/narration).
 * A single shared Audio element tells the story as a pitch — paragraph
 * to paragraph, slide to slide, the page following the voice.
 */
export type StorySlide = {
  src: string;
  width: number;
  height: number;
  /** Slide titles are ALWAYS English, in every locale — brand nouns. */
  title?: string;
  /** The caption, split in readable paragraphs — each one is also the
   *  transcript of its own narration clip. */
  paras?: UIKey[];
};

type Props = {
  id: string;
  name: string;
  /** The opener reads as a startup pitch — the problem, then the
   *  answer — one paragraph (and one narration clip) each. */
  pitch: UIKey[];
  slides: StorySlide[];
  /** Show the App Store / Google Play slots (apps, not web products). */
  stores?: boolean;
  /** Where the deck waits at the opener, on desktop: off the RIGHT edge
   *  ('side', the default) or below the BOTTOM edge ('rise') — so two
   *  stories in a row don't enter the same way twice. The words stay on
   *  the left either way: mirroring them was tried and read backwards. */
  enter?: 'side' | 'rise';
  /** Legal and support pages, linked from the opener — the stores
   *  require them reachable from outside the app. Grouped: each group
   *  renders as a small accordion. */
  linkGroups?: {
    key: UIKey;
    links: { key: UIKey; href: string }[];
  }[];
};

const {
  id,
  name,
  pitch,
  slides,
  stores = false,
  enter = 'side',
  linkGroups = [],
} = Astro.props;

// Every narratable block, resolved against the clips on disk: the
// opener's pitch is block 0, the whole deck block 1 — one paragraph after
// another, card by card, the deck turning with the voice.
const narrate = (keys: UIKey[]) =>
  keys.map(k => ({ k, clip: clipFor(k), subs: subsFor(k) }));
const pitchParas = narrate(pitch);
const slideParas = slides.map(slide => narrate(slide.paras ?? []));
const voiced = (paras: { clip: unknown }[]) => paras.some(p => p.clip);

// PHONE copy: the short version of each block, found by convention — a
// pitch paragraph `k` has `k.m`; a slide's paragraphs `….sN.pM` share
// `….sN.m`. The narration stays on the full paragraphs (hidden there).
const mobileKey = (k: string) =>
  (/\.p\d+$/.test(k) ? k.replace(/\.p\d+$/, '.m') : `${k}.m`) as UIKey;
const pitchMobile = pitch.map(mobileKey);
const slideMobile = slides.map(sl => (sl.paras?.[0] ? mobileKey(sl.paras[0]) : null));

// The light each slide lends the page (lib/scene). The opener lends none:
// the room lights when the first slide lands, the way it does coming out
// of the hero.
const scenes = await Promise.all(slides.map(sl => sceneOf(sl.src).then(sceneAttr)));
---

<section class="story" id={id} data-story={id} data-enter={enter}>
  <!-- Invisible scroll rail — two viewports, the opener's and the
       deck's, and the story's length. -->
  <div class="steps" aria-hidden="true">
    <div class="step" />
    <div class="step" />
  </div>

  <div class="stage">
    <!-- The opener, full-bleed on the ground. -->
    <div class="intro-scene">
      <div class="intro-body">
      <div class="inner">
        <div class="lockup-anchor-big" aria-hidden="true"></div>

        <div class="intro-grid" data-reveal>
          <div
            class="pitch"
            data-narr-block={voiced(pitchParas) ? '0' : null}
          >
            {pitchParas.map(({ k, clip, subs }) => (
              <p
                class="body"
                data-narr-para
                data-clip-en={clip?.en}
                data-clip-es={clip?.es}
                data-subs-en={subs.en}
                data-subs-es={subs.es}
              >
                <T k={k} />
              </p>
            ))}
          </div>

          <!-- Reserves the action row's box; the row itself floats in
               the stage so it can travel to the slides. -->
          <div class="actions-anchor-big" aria-hidden="true"></div>

          {/* A RISING deck comes up under the page's middle, right where a
              centred narrator would stand — so there it parks under the
              store row instead, on the words' own left edge. */}
          {
            voiced(pitchParas) && enter === 'rise' && (
              <div
                class="narr-anchor narr-under-actions"
                data-narr-anchor="0"
                aria-hidden="true"
              />
            )
          }
        </div>
      </div>
      </div>

      {/* The opener's narrator stands on its own, centred on the page
          like the hero's, one step under the store row — not in the
          pitch, where it got lost among the words. */}
      {
        voiced(pitchParas) && enter !== 'rise' && (
          <div class="inner intro-narr">
            <div
              class="narr-anchor"
              data-narr-anchor="0"
              data-narr-align="center"
              aria-hidden="true"
            />
          </div>
        )
      }

      {
        linkGroups.length > 0 && (
          <footer class="inner intro-foot">
            <nav class="intro-links">
              {linkGroups.map(group => (
                <div class="link-group">
                  <span class="label">
                    <T k={group.key} />
                  </span>
                  <div class="group-links">
                    {group.links.map(link => (
                      <a href={link.href}>
                        <T k={link.key} />
                      </a>
                    ))}
                  </div>
                </div>
              ))}
            </nav>
          </footer>
        )
      }
    </div>

    <!-- The slides' scene, on the ground with the opener: the lockup's
         small anchor, then the deck — every card is the words and the
         phone, sliding together. -->
    <div class="float">
      <div class="deck-head">
        <div class="lockup-anchor-small" aria-hidden="true"></div>
      </div>
      <div
        class="deck"
        tabindex="0"
        aria-roledescription="carousel"
        aria-label={name}
        data-narr-block={slideParas.some(voiced) ? '1' : null}
      >
        <div class="deck-stage">
          {
            slides.map((slide, i) => (
              <article
                class="card deck-card"
                aria-roledescription="slide"
                aria-label={`${i + 1} / ${slides.length}`}
                data-scene={scenes[i]}
              >
                <div class="cap">
                  {slide.title && (
                    <h3 class="slide-title" data-deck-part="text" style="--i: 1">
                      {slide.title}
                    </h3>
                  )}
                  {slideParas[i].map(({ k, clip, subs }, n) => (
                    <p
                      class="body"
                      data-deck-part="text"
                      style={`--i: ${n + 2}`}
                      data-narr-para
                      data-card={i}
                      data-clip-en={clip?.en}
                      data-clip-es={clip?.es}
                      data-subs-en={subs.en}
                      data-subs-es={subs.es}
                    >
                      <T k={k} />
                    </p>
                  ))}
                  {/* The narrator's place, kept EMPTY, as More Work's: the
                      still anchor below moves to the card in front. */}
                  {voiced(slideParas[i]) && (
                    <div class="narr-slot" aria-hidden="true" />
                  )}
                </div>
                {/* No glow of its own: the page's scene light (lib/scene)
                    is the shot's light, the same as every other panel's. */}
                <div class="slot" style={`--ratio: ${slide.height / slide.width}`}>
                  <div class="shot-wrap" data-deck-part="picture">
                    <img
                      class="shot"
                      src={slide.src}
                      alt={`${name} screenshot`}
                      width={slide.width}
                      height={slide.height}
                      loading="lazy"
                      decoding="async"
                      draggable="false"
                    />
                  </div>
                </div>
              </article>
            ))
          }
        </div>

        {/* The one narrator's anchor, OUTSIDE the deck: it does not slide
            with the cards. The script stands it on the current card's
            slot. */}
        {
          slideParas.some(voiced) && (
            <div class="narr-static">
              <div class="narr-anchor" data-narr-anchor="1" aria-hidden="true" />
            </div>
          )
        }

        <!-- Where the action row comes to rest on the slides. -->
        <div class="actions-anchor-small" aria-hidden="true"></div>

        {/* The controls stand on the cards' left edge, in the words'
            column, at the panel's FOOT — the line More Work's stand on, so
            every deck on the page turns from the same height. Centred
            there, as More Work has them, they sat on the phone; under the
            longest caption they floated mid-panel. */}
        <div class="deck-foot">
          <DeckControls names={slides.map((sl, i) => sl.title ?? String(i + 1))} />
        </div>
      </div>
    </div>

    <!-- The shared lockup: icon + name in a row, once per story. Big on
         the opener, it shrinks into the window's caption corner as the
         scene docks — the render loop FLIPs it between the two anchors. -->
    <div class="lockup">
      <slot name="logo" />
      <span class="lockup-name">{name}</span>
    </div>

    <!-- The action row, drawn ONCE per story like the lockup: it sits
         under the opener's pitch and travels to the foot of the slides'
         text column, rather than fading out with the opener. -->
    <div class="actions">
      {stores && <StoreBadges app={id as ReleasedApp} />}
    </div>
  </div>

  <!-- THE PHONE'S STORY. Below 48rem the pinned stage above is not drawn
       at all. A phone gets the same two stops as the desktop — the welcome,
       then the deck — on native scroll-snap, and the walk between them is
       a SCROLL-DRIVEN CSS animation (`animation-timeline`): the browser
       runs it on the compositor, so it tracks the finger without the drag
       the scripted stage had on iOS. A browser without scroll timelines
       gets the two as plain snapped panels. The deck turns sideways through
       the same deck as the desktop's (lib/deck.ts). The full paragraphs
       ride along hidden, carrying the clips. -->
  <div class="m-story">
    <div class="m-steps" aria-hidden="true">
      <div class="m-step"></div>
      <div class="m-step"></div>
    </div>
    <div class="m-sticky">
      <section
        class="m-panel m-welcome"
        data-m-step="0"
        data-narr-panel={voiced(pitchParas) ? '' : null}
      >
        <div class="m-lockup">
          {/* Drawn at its phone size, not shrunk by CSS: the tile carries a
              negative margin solved for its own size, and scaling the SVG
              box cut the squircle off. Story ids are the tiles' app ids. */}
          <AppTile app={id as 'shaper' | 'topper'} size={52} />
          <span class="m-lockup-name">{name}</span>
        </div>
        {pitchMobile.map(k => (
          <p class="body m-copy">
            <T k={k} />
          </p>
        ))}
        {stores && <StoreBadges app={id as ReleasedApp} />}
        {pitchParas.map(({ clip, subs }) => (
          <span
            hidden
            data-narr-para
            data-clip-en={clip?.en}
            data-clip-es={clip?.es}
            data-subs-en={subs.en}
            data-subs-es={subs.es}
          />
        ))}
      </section>

      <section
        class="m-panel m-deck"
        data-m-step="1"
        data-narr-panel={slideParas.some(voiced) ? '' : null}
        data-narr-start="0"
      >
        {/* No lockup here: the welcome just said whose app this is, and on
            a phone the height is the screenshot's. */}
        <div class="m-stage" aria-roledescription="carousel" aria-label={name}>
          {slides.map((slide, i) => (
            <article
              class="m-card deck-card"
              aria-roledescription="slide"
              aria-label={slide.title}
              data-scene={scenes[i]}
            >
              <div class="m-shot" data-deck-part="picture">
                <img
                  class="shot"
                  src={slide.src}
                  alt={`${name} screenshot`}
                  width={slide.width}
                  height={slide.height}
                  decoding="async"
                  draggable="false"
                />
              </div>
              <div class="m-words">
                {slide.title && (
                  <h3 class="slide-title" data-deck-part="text" style="--i: 1">
                    {slide.title}
                  </h3>
                )}
                {slideMobile[i] && (
                  <p class="body m-copy" data-deck-part="text" style="--i: 2">
                    <T k={slideMobile[i]!} />
                  </p>
                )}
              </div>
              {slideParas[i].map(({ clip, subs }) => (
                <span
                  hidden
                  data-narr-para
                  data-card={i}
                  data-clip-en={clip?.en}
                  data-clip-es={clip?.es}
                  data-subs-en={subs.en}
                  data-subs-es={subs.es}
                />
              ))}
            </article>
          ))}
        </div>

      </section>
    </div>

    {/* The deck's controls, docked beside the corner narrator while the
        deck holds the screen (data-dock, global.css). They live OUTSIDE
        the stuck screen: a fixed control inside a sticky, animated layer
        was drawn in place but missed its taps in Chrome on iPhone. A
        sideways swipe turns the deck too. */}
    <div class="m-controls" data-dock data-m-step="1">
      <DeckControls names={slides.map((sl, i) => sl.title ?? String(i + 1))} />
    </div>
  </div>
</section>

<style>
  .inner {
    width: 100%;
    max-width: var(--content-max);
    margin: 0 auto;
  }

  /* ---------- the scene ---------- */

  /* ONE spacing scale for the whole story — the opener and the slides
     read from the same four numbers, so nothing can drift apart. */
  .story {
    position: relative;
    height: 200svh;

    /* --stage-top, --stage-bottom and --gap-block are the PAGE's (see
       global.css): every full panel — the game, More Work — stands on
       the same three numbers, so nothing below the stories drifts. */
    /* The text column, and the opener's pitch at 1.5x of it. */
    --text-col: calc(100% * 6 / 13 * 0.81);
    --text-wide: calc(100% * 6 / 13 * 0.81 * 1.5);
  }

  .steps {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /* Both stops insist: the opener, and the deck — a page of panels. */
  .step {
    height: 100svh;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  .stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
  }

  /* ---------- the opener ---------- */

  /* Content centered in the panel, the page foot pinned under it. */
  .intro-scene {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    /* The one stage inset — the slides' scene takes the same, so both
       start on the same line. */
    padding: var(--stage-top) clamp(1.25rem, 4vw, 2.5rem) var(--stage-bottom);
    will-change: opacity;
  }

  /* Content reads from the top, not centred in the panel: that is what
     puts it level with the slides and keeps the lockup's trip short.
     It does NOT grow — the foot follows the content by one step
     instead of being flung to the bottom of the panel. */
  .intro-body {
    display: flex;
    align-items: flex-start;
    min-height: 0;
  }

  .intro-grid {
    margin-top: var(--gap-block);
  }

  /* The pitch: problem over solution, reading left — twice the width
     of the window's caption column, no wider. */
  .pitch {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    max-width: var(--text-wide);
  }

  /* Long rows on purpose — the measure cap is for columns. */
  .pitch .body {
    max-width: none;
  }

  /* The pitch's own gap already spaces the narrator's anchor. */
  .pitch :global(.narr-anchor) {
    margin-top: 0;
  }

  /* While Juan is speaking a block, the page follows his voice: the
     paragraph being spoken holds full ink and the others step back —
     and any of them can be tapped to jump the voice there. */
  /* (A deck's paragraphs take this beat in the deck's own transition
     list — a second `transition` here would replace their entrance.) */
  [data-narr-block] .body:not([data-deck-part]) {
    transition: color calc(var(--beat) / 2) var(--ease);
  }

  [data-narr-block].is-narrating .body {
    color: var(--ink-3);
    cursor: pointer;
  }

  [data-narr-block].is-narrating .body.is-spoken {
    color: var(--ink);
  }

  /* The action row is drawn once in the stage and FLIPped between two
     anchors, exactly like the lockup — these reserve its box at each
     end so nothing reflows when it travels. */
  .actions {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 3;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    transform-origin: top left;
    will-change: transform;
  }

  .actions :global(.stores) {
    margin-top: 0;
  }

  /* The row's box under the pitch, one step below it. */
  .actions-anchor-big {
    height: 3rem;
    margin-top: var(--gap-block);
  }

  /* Where it is headed as it fades: the deck's foot, on the cards' left
     edge. It is gone long before it gets there. */
  .actions-anchor-small {
    position: absolute;
    left: calc(50% - var(--card-w) / 2);
    bottom: 0;
    height: 3rem;
  }

  /* The page foot: the legal and help pages, under one hairline at the
     bottom of the panel — where a foot belongs. */
  /* The rule sits on the links themselves, so it spans the content
     above it rather than the whole panel. */
  .intro-foot {
    margin-top: var(--gap-block);
  }

  /* A rising story's opener parks the narrator one block step under the
     store row, the step every block takes. */
  .narr-under-actions {
    margin-top: var(--gap-block);
  }

  /* The narrator's place on the opener: centred, two steps of air
     above it so it reads as its own moment, not the row's tail. */
  .intro-narr {
    display: flex;
    justify-content: center;
    margin-top: calc(var(--gap-block) * 2);
  }

  .intro-narr .narr-anchor {
    margin-top: 0;
  }

  .intro-links {
    display: flex;
    gap: clamp(2rem, 6vw, 4rem);
    padding-top: var(--gap-block);
    border-top: 1px solid var(--hairline);
    max-width: var(--text-wide);
  }

  .link-group .label {
    display: block;
  }

  .group-links {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 0.875rem;
  }

  .group-links a {
    font-size: 0.875rem;
    color: var(--ink-2);
    text-decoration-color: transparent;
    transition:
      color var(--dur-micro) var(--ease),
      text-decoration-color var(--dur-micro) var(--ease);
  }

  .group-links a:hover {
    color: var(--ink);
    text-decoration-color: var(--ink-3);
  }

  /* ---------- the slides: a deck ---------- */

  /* The opener's box exactly — its insets, and the cards one content
     column wide in the middle of it. It covers the whole stage, the
     opener beneath it included, so the layer is DEAF and only the deck
     takes events back. Without that it silently eats every hover and click on the
     opener. */
  .float {
    --gutter: clamp(1.25rem, 4vw, 2.5rem);
    --card-w: min(var(--content-max), calc(100vw - var(--gutter) * 2));
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    padding: var(--stage-top) 0 var(--stage-bottom);
    pointer-events: none;
  }

  /* Where the lockup parks: a 2rem row on the cards' left edge — the
     place More Work's eyebrow stands — so the cards slide under it. */
  .deck-head {
    flex: none;
    width: var(--card-w);
    margin: 0 auto;
  }

  .lockup-anchor-small {
    height: 2rem;
  }

  /* The title stands one 1.5rem step under the lockup, as it always did. */
  .deck {
    position: relative;
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    margin-top: 1.5rem;
    outline: none;
  }

  .deck-stage {
    touch-action: pan-y;
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-rows: minmax(0, 1fr);
    justify-items: center;
  }

  /* A card: the words in the text column, the phone in the rest. */
  .card {
    display: grid;
    grid-template-columns: var(--text-col) 1fr;
    gap: var(--space-4);
    min-height: 0;
  }

  /* The words wait for the opener to go; the phone is there from the
     start (the peek). */
  .cap {
    display: flex;
    flex-direction: column;
    opacity: var(--float-in, 0);
    will-change: opacity;
  }

  /* The slide title IS the opener's name size — one ladder, and one
     1.25rem step everywhere: lockup → title → description. */
  .slide-title {
    font-size: clamp(2rem, 4vw, 3.25rem);
    font-weight: 800;
    letter-spacing: var(--track-display);
    line-height: 0.95;
  }

  .cap .body {
    margin-top: 1.25rem;
  }

  .cap .body + .body {
    margin-top: 0.875rem;
  }

  /* The narrator's place under the words — kept empty, see .narr-static. */
  .narr-slot {
    flex: none;
    height: var(--narrator-h);
    margin-top: 1.5rem;
  }

  /* Laid over the deck, on the cards' left edge; the anchor inside rides
     down to the current card's slot and eases there when the deck turns,
     so the narrator rises and falls with the words instead of travelling
     sideways with the cards. */
  .narr-static {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    width: var(--card-w);
    margin: 0 auto;
    pointer-events: none;
  }

  .narr-static .narr-anchor {
    margin-top: 0;
    transform: translateY(var(--slot-y, 0px));
    transition: transform calc(var(--beat) * 0.75) var(--ease);
  }

  @media (prefers-reduced-motion: reduce) {
    .narr-static .narr-anchor {
      transition: none;
    }
  }

  /* The phone takes the comfortable insets back — it runs from the
     header's bottom edge to the panel's, the slot's padding the gap on
     both sides. The PEEK: at the opener it stands off to the right,
     cropped by the stage's edge, and the first scroll walks it in. */
  .slot {
    position: relative;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: calc(var(--header-h) - var(--stage-top) - 3.5rem) 0
      calc(var(--stage-bottom) * -1);
    padding: 1.5rem 0;
    transform: translateX(calc(var(--peek, 0) * 58%));
    will-change: transform;
    container-type: size;
  }

  /* As tall as the column allows — unless the column is the narrower
     limit, as on a tablet held upright, where a height-only phone ran off
     the page's edge. */
  .shot-wrap {
    position: relative;
    height: min(100cqh, 100cqw * var(--ratio));
  }

  /* Laid over the deck on the cards' left edge, at its foot — which is
     the panel's, less the stage inset every panel keeps. */
  .deck-foot {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    width: var(--card-w);
    margin: 0 auto;
    opacity: var(--float-in, 0);
    pointer-events: none;
  }

  .float:not(.is-dealt) .deck-foot :global(.deck-controls) {
    pointer-events: none;
  }

  .shot {
    position: relative;
    height: 100%;
    width: auto;
    /* A real contact shadow does the depth the blur used to fake. */
    box-shadow:
      0 2rem 4rem rgba(0, 0, 0, 0.55),
      0 0.5rem 1.25rem rgba(0, 0, 0, 0.4);
    /* The global `img { max-width: 100% }` squishes an auto-width image
       inside a shrink-to-fit wrapper — the phone keeps its native
       1179:2556 ratio, whatever the column does. */
    max-width: none;

    /* The corner is the PHONE'S, not the App Store's — the page's one
       media radius (--media-radius, global.css), which is set from this
       very phone. The bottom corners crop a beat tighter (15.9 / 14) so a
       full-height sheet's dead corners never show. The hairline is
       Apple's dark-appearance treatment. No bezel, no fill. */
    border-radius: var(--media-radius) var(--media-radius)
      calc(var(--media-radius) * 1.136) calc(var(--media-radius) * 1.136);
    border: 1px solid var(--hairline);
  }

  /* ---------- the shared lockup ---------- */

  .lockup {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    height: 4.75rem;
    white-space: nowrap;
    transform-origin: top left;
    pointer-events: none;
    will-change: transform;
  }

  .lockup-name {
    font-size: clamp(2.5rem, 5.5vw, 4.25rem);
    font-weight: 800;
    letter-spacing: var(--track-display);
    line-height: 0.95;
  }

  /* The anchors: same box the lockup occupies at each end of the ride. */
  .lockup-anchor-big {
    height: 4.75rem;
  }

  /* ---------- big screens ----------
     Past the container cap everything would just sit in the middle
     with growing margins, so the cap itself opens up and the phone
     grows with it. */
  @media (min-width: 100rem) {
    .story {
      --content-max: 82rem;
    }

    .intro-scene .inner,
    .intro-foot {
      max-width: var(--content-max);
    }
  }

  /* ---------- rising ----------
     The other way in: the deck waits below the stage's bottom edge, its
     top showing under the opener, and the first step lifts it into its
     column. Same columns, same gaps as a side entrance — only the
     direction of travel changes. Desktop only: phones have no peek. */
  @media (min-width: 48.01rem) {
    [data-enter='rise'] .slot {
      transform: translateY(calc(var(--peek, 0) * 62%));
    }
  }

  /* Short screens: the narrator's air halves, so three paragraphs, the
     store row and the pill still stand inside the panel. */
  @media (max-height: 46rem) {
    .intro-narr {
      margin-top: var(--gap-block);
    }
  }

  /* ---------- the phone's story ----------
     Above 48rem it is not drawn; below, it IS the story and the pinned
     stage is not. Each stop is one screen sized for the space a phone
     browser really leaves (svh: Safari's bars showing), with room at the
     foot for the docked controls and the narrator. */
  .m-story {
    display: none;
  }

  @media (max-width: 48rem) {
    .story {
      height: auto;
    }

    .story > .steps,
    .story > .stage {
      display: none;
    }

    .m-story {
      display: block;
    }

    .m-panel {
      position: relative;
      height: 100svh;
      display: flex;
      flex-direction: column;
      padding: calc(var(--header-h) + 1rem) 0 calc(var(--narrator-h) + 2rem);
    }

    .m-lockup {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .m-lockup-name {
      font-size: clamp(1.75rem, 8vw, 2.25rem);
      font-weight: 800;
      letter-spacing: var(--track-display);
      line-height: 0.95;
    }

    /* The welcome, as it was: the lockup, the pitch and the store row as
       one group in the middle of the screen. */
    .m-welcome {
      justify-content: center;
      gap: 1.25rem;
      padding-left: clamp(1.25rem, 4vw, 2.5rem);
      padding-right: clamp(1.25rem, 4vw, 2.5rem);
    }

    .m-copy {
      font-size: 1rem;
      line-height: 1.5;
    }

    /* Every card in one cell, one on stage at a time; a sideways swipe
       turns it, so the browser keeps only the vertical pan. */
    .m-stage {
      --card-w: 100%;
      flex: 1;
      min-height: 0;
      display: grid;
      grid-template-rows: minmax(0, 1fr);
      touch-action: pan-y;
    }

    /* The deck takes the screen from the top: the header's two pills sit
       in the corners, clear of a phone standing in the middle. */
    .m-deck {
      padding-top: calc(var(--float-gap) + env(safe-area-inset-top));
    }

    .m-card {
      min-width: 0;
      min-height: 0;
      display: flex;
      flex-direction: column;
      padding: 0 clamp(1.25rem, 4vw, 2.5rem);
    }

    /* The screenshot takes every pixel the words leave. It is placed
       ABSOLUTELY in its box: a percentage height three containers deep
       (grid → flex → image) resolved to nothing in WebKit, and the phones
       vanished on every iPhone browser. */
    .m-shot {
      position: relative;
      flex: 1;
      min-height: 0;
    }

    /* As tall as the box allows, up to a bit more than the screen's width:
       sized by the WIDTH, two browsers that leave different heights
       (Safari's bars against Chrome's) still show the same phone. It
       stands on the box's FLOOR, right over its title — centred, the
       leftover air split above and below it and read as a gap — and on
       the words' LEFT edge, as every other block on the page is: centred
       over left-set words it read as a second alignment. */
    .m-shot .shot {
      position: absolute;
      bottom: 0;
      left: 0;
      height: min(100%, 112vw);
      width: auto;
      max-width: none;
    }

    /* Room for three lines of copy whatever a card says, so the phone
       above is the same size on every card of the deck. */
    .m-words {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      padding-top: 0.875rem;
      min-height: 7.5rem;
    }

    .m-words .slide-title {
      font-size: clamp(1.75rem, 7vw, 2.25rem);
    }
  }

  /* THE WALK, on a scroll timeline: the story is two screens tall, the
     two stops are its snap points, and one screen stays stuck in place
     while the welcome steps back and the deck comes up through it. */
  @supports (animation-timeline: view()) {
    @media (max-width: 48rem) {
      .m-story {
        position: relative;
        height: 200svh;
        view-timeline: --m-story block;
      }

      .m-steps {
        position: absolute;
        inset: 0;
        pointer-events: none;
      }

      .m-step {
        height: 100svh;
        scroll-snap-align: start;
        scroll-snap-stop: always;
      }

      .m-sticky {
        position: sticky;
        top: 0;
        height: 100svh;
      }

      .m-sticky > .m-panel {
        position: absolute;
        inset: 0;
      }

      /* The welcome steps back and goes — its group lifts a little and
         shrinks, the way the desktop's lockup leaves for its corner. */
      .m-welcome {
        animation: m-leave linear both;
        animation-timeline: --m-story;
        animation-range: contain 0% contain 45%;
      }

      /* The deck arrives once the welcome is mostly gone — the desktop's
         own timing, opener out by 45%, words in from about 35% — and its
         phone rises into place under it. Opacity and visibility only on the panel
         itself: a transform there would capture the docked controls'
         fixed position. */
      .m-deck {
        animation: m-arrive linear both;
        animation-timeline: --m-story;
        animation-range: contain 38% contain 80%;
      }

      .m-deck .m-stage {
        animation: m-rise linear both;
        animation-timeline: --m-story;
        animation-range: contain 20% contain 100%;
      }
    }
  }

  @supports not (animation-timeline: view()) {
    @media (max-width: 48rem) {
      .m-steps {
        display: none;
      }

      .m-panel {
        scroll-snap-align: start;
        scroll-snap-stop: always;
      }
    }
  }

  @keyframes m-leave {
    to {
      opacity: 0;
      transform: translateY(-1.5rem) scale(0.97);
      visibility: hidden;
    }
  }

  @keyframes m-arrive {
    from {
      opacity: 0;
      visibility: hidden;
    }
    to {
      opacity: 1;
      visibility: visible;
    }
  }

  @keyframes m-rise {
    from {
      transform: translateY(15%);
    }
  }

  @keyframes m-fade-out {
    to {
      opacity: 0;
      visibility: hidden;
    }
  }

  /* Reduced motion keeps the cross-fade and drops the travel. */
  @media (prefers-reduced-motion: reduce) {
    .m-welcome {
      animation-name: m-fade-out;
    }

    .m-deck .m-stage {
      animation: none;
    }
  }
</style>

<script>
  import { createDeck, watchSlots, type Deck } from '../lib/deck';

  // ---------- the controller ----------
  // The walk from the opener to the deck is a pure function of the scroll
  // position p (0 = the opener, 1 = the deck): the opener fades, the phone
  // walks in from its peek, the words come up, the lockup FLIPs between
  // its anchors. The deck itself turns sideways, by its own controls.

  const reduceMotion = window.matchMedia(
    '(prefers-reduced-motion: reduce)'
  ).matches;

  const clamp = (v: number, min: number, max: number) =>
    Math.min(max, Math.max(min, v));

  // STEPPED on a touch screen. iOS scrolls on its own compositor and hands
  // the page its scroll position a frame or more late, so anything this
  // script moves pixel-by-pixel with the scroll trails behind the finger
  // and reads as heavy — however cheap the frame is (measured: ~52fps in a
  // throttled phone emulation, yet it still drags on a real iPhone 15).
  // So on touch the controller works in WHOLE STEPS: every scroll-coupled
  // value is rounded to the step the page is on, and the change between
  // two states is a CSS transition the GPU runs by itself (html.is-stepped
  // in global.css). A mouse or trackpad keeps the continuous scrub.
  const stepped = window.matchMedia(
    '(hover: none) and (pointer: coarse)'
  ).matches;
  const step = (v: number) => (stepped ? Math.round(v) : v);

  // PHONE: the stories are drawn as plain snapped panels (.m-story) and
  // the pinned stage is not drawn at all, so the controller drives no
  // stage and the narrator sits still in its corner (NarrationPlayer).
  // The layout is chosen once per load; crossing the line reloads.
  const phoneQuery = window.matchMedia('(max-width: 48rem)');
  const phone = phoneQuery.matches;
  // ...but never while the phone's game cabinet is open: turning the phone
  // sideways to play crosses this line, and the reload would close the
  // game. The cabinet reloads on its way out instead (`arcade:close`).
  let relayout = false;
  phoneQuery.addEventListener('change', () => {
    if (document.documentElement.dataset.arcade === 'open') relayout = true;
    else location.reload();
  });
  document.addEventListener('arcade:close', () => {
    if (relayout && phoneQuery.matches !== phone) location.reload();
    relayout = false;
  });

  const smooth = (v: number) => v * v * (3 - 2 * v);

  // ---------- narration ----------
  // Juan's voice tells the page as a pitch. One clip per paragraph and
  // ONE session across the whole page — the hero's intro, then each
  // story's opener and slides: paragraph to paragraph inside a block,
  // then the page itself turns and the voice follows it. The last slide
  // hands the scroll back to the opener, so the pitch closes on the store
  // row. Scroll by hand and the voice follows you; tap a paragraph that
  // is being told and it jumps there.

  const voice = new Audio();
  voice.preload = 'auto';
  // What the OS shows for the voice (Dynamic Island, Lock Screen). With no
  // metadata Safari falls back to the favicon, whose rounded tile has
  // transparent corners that the Lock Screen paints white. The artwork is
  // the same mark, square and opaque, because the OS rounds it itself.
  if ('mediaSession' in navigator)
    navigator.mediaSession.metadata = new MediaMetadata({
      title: document.title,
      artwork: [
        {
          src: '/media/brand/now-playing.jpg',
          sizes: '512x512',
          type: 'image/jpeg',
        },
      ],
    });
  // Dev only: lets a check drive the narrator SILENTLY — the analyser
  // still hears the voice (bars, subtitles, field all run), the speakers
  // do not. Never shipped.
  let devSilent = false;
  if (import.meta.env.DEV)
    Object.assign(window, {
      __narrVoice: voice,
      __narrSilence: () => {
        devSilent = true;
        if (output) output.gain.value = 0;
      },
    });

  /** A narrated block: the hero's wordmark, a story's opener pitch, one
   *  slide's caption, or a PANEL — a plain full-height section after the
   *  stories (the game), marked `data-narr-panel`. */
  type Narr = {
    el: HTMLElement;
    paras: HTMLElement[];
    anchor: HTMLElement | null;
    /** The story it belongs to, and its step there; null = the hero or a
     *  panel. */
    story: Story | null;
    step: number;
    panel: boolean;
  };

  type Story = {
    root: HTMLElement;
    steps: HTMLElement[];
    stage: HTMLElement | null;
    intro: HTMLElement | null;
    float: HTMLElement | null;
    deck: Deck | null;
    lockup: HTMLElement | null;
    anchorBig: HTMLElement | null;
    anchorSmall: HTMLElement | null;
    actions: HTMLElement | null;
    actionsBig: HTMLElement | null;
    actionsSmall: HTMLElement | null;
    /** Narrated blocks by step: the opener's pitch is 0, the deck 1. */
    blocks: (Narr | undefined)[];
  };

  const narrator = document.querySelector<HTMLElement>('[data-narrator]');

  /** Where the voice is — kept while paused, so play resumes in place. */
  let session: { block: Narr; para: number } | null = null;
  /** The person's intent: running, or paused by them. Not the element's
   *  own paused flag, which flips on its own at the end of every clip. */
  let running = false;
  /** The block the page is showing right now (set by the render loop). */
  let showing: Narr | undefined;

  const narrs: Narr[] = [];

  // Which recording a paragraph plays: the page's language when Juan
  // recorded it, the other one when he did not. Chinese has no recording;
  // it hears English under its own transcript.
  const voiceLang = (p: HTMLElement) => {
    const es = document.documentElement.dataset.lang === 'es';
    if (es) return p.dataset.clipEs ? 'es' : 'en';
    return p.dataset.clipEn ? 'en' : 'es';
  };

  const clipOf = (p: HTMLElement) =>
    voiceLang(p) === 'es' ? p.dataset.clipEs : p.dataset.clipEn;

  /** The subtitles for the recording that plays — always its language. */
  type Subs = { phrases: string[]; times?: number[] };
  const subsCache = new WeakMap<HTMLElement, Map<string, Subs | null>>();
  const subsOf = (p: HTMLElement): Subs | null => {
    const lang = voiceLang(p);
    let byLang = subsCache.get(p);
    if (!byLang) subsCache.set(p, (byLang = new Map()));
    if (!byLang.has(lang)) {
      const raw = lang === 'es' ? p.dataset.subsEs : p.dataset.subsEn;
      byLang.set(lang, raw ? (JSON.parse(raw) as Subs) : null);
    }
    return byLang.get(lang) ?? null;
  };

  const firstVoiced = (block: Narr | undefined, from = 0) => {
    if (!block) return -1;
    for (let i = from; i < block.paras.length; i++)
      if (clipOf(block.paras[i])) return i;
    return -1;
  };

  // Where a block's telling starts: its first recorded paragraph — unless
  // the block names its own start (`data-narr-start`), as a carousel does
  // for the card in front.
  const startOf = (block: Narr) => {
    const named = Number(block.el.dataset.narrStart);
    if (Number.isInteger(named) && block.paras[named] && clipOf(block.paras[named]))
      return named;
    return firstVoiced(block);
  };

  const paint = () => {
    for (const n of narrs) {
      const on = session?.block === n;
      n.el.classList.toggle('is-narrating', on);
      n.paras.forEach((p, i) =>
        p.classList.toggle('is-spoken', on && session?.para === i)
      );
    }
    narrator?.classList.toggle('is-playing', running);
  };

  // ----- listening: the voice, band by band -----
  // A live analyser on the voice, read once a frame into log-spaced
  // bands — the body of it first, the air last — plus where its energy
  // sits. Nothing is drawn here: the field along the foot of the screen
  // is what shows it (the pill is only play and pause).

  let ctx: AudioContext | null = null;
  let analyser: AnalyserNode | null = null;
  let output: GainNode | null = null;
  let freq: Uint8Array<ArrayBuffer> | null = null;

  // The analyser needs an AudioContext, which a browser only lets a
  // gesture create — so it is built on the first play. Routing the voice
  // through it is also what makes it audible from then on.
  const ensureGraph = () => {
    if (ctx) return;
    try {
      ctx = new AudioContext();
      const source = ctx.createMediaElementSource(voice);
      analyser = ctx.createAnalyser();
      analyser.fftSize = 2048;
      analyser.minDecibels = -85;
      analyser.maxDecibels = -25;
      analyser.smoothingTimeConstant = 0.72;
      output = ctx.createGain();
      output.gain.value = devSilent ? 0 : 1;
      source.connect(analyser).connect(output).connect(ctx.destination);
      freq = new Uint8Array(analyser.frequencyBinCount);
    } catch {
      ctx = null;
      analyser = null;
    }
  };

  // How finely the voice is split — the horizon's resolution.
  const BANDS = 16;
  // The voice's range, first band to last.
  const LOW_HZ = 90;
  const HIGH_HZ = 5000;

  let peak = 0.35;

  /** One level per band, centre first; zeros when nothing is speaking. */
  const voiceBands = (half: number) => {
    const out = new Array(half).fill(0);
    if (!analyser || !freq || !ctx) return out;
    analyser.getByteFrequencyData(freq);
    const binHz = ctx.sampleRate / analyser.fftSize;
    for (let k = 0; k < half; k++) {
      const lo = LOW_HZ * (HIGH_HZ / LOW_HZ) ** (k / half);
      const hi = LOW_HZ * (HIGH_HZ / LOW_HZ) ** ((k + 1) / half);
      const a = Math.max(1, Math.floor(lo / binHz));
      const b = Math.max(a + 1, Math.ceil(hi / binHz));
      let sum = 0;
      for (let i = a; i < b; i++) sum += freq[i];
      out[k] = sum / (b - a) / 255;
    }
    // Where the voice's energy sits, 0 (low) – 1 (high): the spectral
    // centroid across the same range, for the field's wavelength.
    let wsum = 0;
    let msum = 0;
    const lowBin = Math.floor(LOW_HZ / binHz);
    const highBin = Math.ceil(HIGH_HZ / binHz);
    for (let i = lowBin; i < highBin; i++) {
      wsum += i * freq[i];
      msum += freq[i];
    }
    if (msum > 0)
      brightness = Math.log((wsum / msum) / lowBin) / Math.log(highBin / lowBin);
    // A slow automatic gain so a quiet take still moves the field —
    // floored, so the room's hiss never passes for a voice.
    peak = Math.max(peak * 0.998, ...out, 0.35);
    return out.map(v => Math.min(1, v / peak) ** 1.6);
  };

  const listen = () => {
    const talking = running && !voice.paused;
    const bands = talking ? voiceBands(BANDS) : null;
    loudness = bands ? bands.reduce((a, b) => a + b, 0) / bands.length : 0;
    spectrum = bands ?? [];
  };

  // ----- the field: the page listens -----
  // Three hairline sound waves along the FOOT of the screen — a horizon
  // under the page, and the one place the voice is drawn (the pill is
  // only play and pause). Each stretch of each line answers its own band
  // of the voice (the body of it at the centre, the air towards the
  // sides, mirrored), and each strand reads the bands a little
  // differently, so they move apart rather than in lockstep. Silence
  // lays them flat; they travel only while there is voice to carry them.

  const field = document.querySelector<HTMLCanvasElement>('.nar-field');
  /** Mean band level this frame, 0–1 (set by listen). */
  let loudness = 0;
  /** The bars' bands this frame, centre first (set by listen). */
  let spectrum: number[] = [];
  /** Where the voice's energy sits, 0 low – 1 high (set by listen). */
  let brightness = 0.3;
  let heard: number[] = [];
  let tone = 0.3;
  let presence = 0;
  let travel = 0;
  let lastFrame = 0;
  let fieldDirty = false;
  // Where the horizon sits: low on the screen, clear of the content.
  const HORIZON = 0.86;
  // Three strands: wavelength, speed, how far along the spectrum each
  // one reads (so each leans on different bands), weight and ink.
  const STRANDS = [
    { k: 1, speed: 1, shift: 0, gain: 1, alpha: 1 },
    { k: 1.6, speed: -0.75, shift: 0.22, gain: 0.7, alpha: 0.6 },
    { k: 0.65, speed: 0.5, shift: -0.18, gain: 0.85, alpha: 0.45 },
  ];
  // The field's ink: the page's own --ink, only ever at a whisper.
  const INK = (() => {
    const hex = getComputedStyle(document.documentElement)
      .getPropertyValue('--ink')
      .trim()
      .replace('#', '');
    const n = parseInt(hex.length === 3 ? hex.replace(/./g, '$&$&') : hex, 16);
    return Number.isFinite(n)
      ? `${(n >> 16) & 255}, ${(n >> 8) & 255}, ${n & 255}`
      : '245, 245, 245';
  })();

  /** The heard level at a point along the spectrum, 0 centre – 1 edge. */
  const levelAt = (u: number) => {
    const n = heard.length;
    if (!n) return 0;
    const f = Math.min(n - 1, Math.max(0, u * (n - 1)));
    const i = Math.floor(f);
    const t = f - i;
    return (heard[i] ?? 0) * (1 - t) + (heard[i + 1] ?? heard[i] ?? 0) * t;
  };

  const drawField = (now: number) => {
    if (!field || !narrator || narrator.hidden || reduceMotion) return;
    const dt = lastFrame ? Math.min(now - lastFrame, 64) : 16;
    lastFrame = now;
    const talking = running && !voice.paused;

    // Quick enough to follow the voice, eased enough not to twitch.
    if (heard.length !== spectrum.length && spectrum.length)
      heard = new Array(spectrum.length).fill(0);
    for (let i = 0; i < heard.length; i++) {
      const target = talking ? spectrum[i] ?? 0 : 0;
      const d = target - heard[i];
      heard[i] += d * (d > 0 ? 0.3 : 0.12);
    }
    tone += (brightness - tone) * 0.08;
    presence += ((session && running ? 1 : 0) - presence) * 0.04;
    // They travel only on voice — a pause holds them where they are.
    travel += dt * 0.0024 * (0.1 + loudness);

    const g = field.getContext('2d');
    if (!g) return;
    if (presence < 0.004) {
      if (fieldDirty) {
        g.clearRect(0, 0, field.width, field.height);
        fieldDirty = false;
      }
      return;
    }
    fieldDirty = true;

    const w = window.innerWidth;
    const h = window.innerHeight;
    const ratio = Math.min(window.devicePixelRatio || 1, 2);
    // Height too: a phone browser's bars collapse on scroll and the
    // viewport grows taller with the width unchanged — a canvas that kept
    // its old height was stretched, and the horizon drew far down the page.
    if (field.width !== Math.round(w * ratio) || field.height !== Math.round(h * ratio)) {
      field.width = Math.round(w * ratio);
      field.height = Math.round(h * ratio);
    }
    g.setTransform(ratio, 0, 0, ratio, 0, 0);
    g.clearRect(0, 0, w, h);

    const base = h * HORIZON;
    // Low voice → long, lazy waves; bright voice → tighter ones.
    const wavelength = 480 - 330 * Math.min(1, Math.max(0, tone));
    const reach = Math.min(h * 0.16, 140);

    g.lineWidth = 1;
    for (const strand of STRANDS) {
      g.strokeStyle = `rgba(${INK}, ${(presence * strand.alpha * (0.07 + 0.16 * loudness)).toFixed(4)})`;
      g.beginPath();
      for (let x = 0; x <= w; x += 5) {
        const u = x / w;
        // Mirrored from the centre: body in the middle,
        // air towards both sides — read at this strand's own shift.
        const along = Math.min(1, Math.max(0, Math.abs(u - 0.5) * 2 + strand.shift));
        const level = levelAt(along);
        // Flat at the screen's very edges, so the lines fade out rather
        // than being cut off.
        const edge = Math.sin(Math.PI * u);
        const y =
          base +
          Math.sin(
            ((x - w / 2) / wavelength) * Math.PI * 2 * strand.k +
              travel * strand.speed * Math.PI * 2
          ) *
            reach *
            level *
            strand.gain *
            edge;
        if (x) g.lineTo(x, y);
        else g.moveTo(x, y);
      }
      g.stroke();
    }
  };

  // ----- subtitles: the pill opens and says what Juan is saying -----
  const subEl = narrator?.querySelector<HTMLElement>('[data-nar-sub]');
  let subShown = '';

  /** The phrase being said now, or '' when there is none to show. */
  const currentPhrase = () => {
    if (!session || !running) return '';
    const subs = subsOf(session.block.paras[session.para]);
    if (!subs?.phrases.length) return '';
    const t = voice.currentTime || 0;
    let starts = subs.times;
    if (!starts) {
      // A plain transcript carries no timings: each phrase gets the share
      // of the clip its length earns, plus a beat for the breath between.
      const d = voice.duration;
      if (!Number.isFinite(d) || d <= 0) return '';
      const weights = subs.phrases.map(ph => ph.length + 12);
      const total = weights.reduce((a, b) => a + b, 0);
      let acc = 0;
      starts = weights.map(wt => {
        const at = (acc / total) * d;
        acc += wt;
        return at;
      });
    }
    let i = 0;
    while (i + 1 < starts.length && starts[i + 1] <= t) i++;
    return subs.phrases[i];
  };

  const updateSub = () => {
    if (!narrator || !subEl) return;
    const phrase = currentPhrase();
    narrator.classList.toggle('is-captioned', !!phrase);
    if (!phrase || phrase === subShown) return;
    subShown = phrase;
    // A fresh line per phrase, so each one fades in on its own.
    const line = document.createElement('span');
    line.className = 'nar-sub-line';
    line.textContent = phrase;
    subEl.replaceChildren(line);
  };

  // ----- placement: the narrator glides between its anchors -----
  /** The anchors in play and how much of the page each one owns. */
  let parks: { anchor: HTMLElement; w: number }[] = [];

  // Every frame, not only on scroll: the pill's own width animates when
  // it opens, and a centred anchor has to keep it centred all the way.
  const placeNarrator = () => {
    if (!narrator || narrator.hidden) return;
    // A phone's narrator never travels: it stays in its corner, shown
    // only while the screen holds a block it can tell.
    if (phone) {
      const has = !!showing && firstVoiced(showing) >= 0;
      narrator.style.opacity = has ? '' : '0';
      narrator.style.pointerEvents = has ? '' : 'none';
      return;
    }
    const width = narrator.offsetWidth;
    let sum = 0;
    let x = 0;
    let y = 0;
    for (const { anchor, w } of parks) {
      const r = anchor.getBoundingClientRect();
      const left =
        anchor.dataset.narrAlign === 'center'
          ? r.left + r.width / 2 - width / 2
          : r.left;
      sum += w;
      x += left * w;
      y += r.top * w;
    }
    if (sum > 0.0001)
      narrator.style.transform =
        `translate(${(x / sum).toFixed(1)}px, ${(y / sum).toFixed(1)}px)`;
    // Past the last narrated block (the page's foot) nothing owns the
    // narrator: it fades with the block that lets it go, instead of being
    // left standing wherever that block last put it.
    const own = Math.min(1, sum);
    narrator.style.opacity = own < 0.999 ? own.toFixed(3) : '';
    narrator.style.pointerEvents = own < 0.05 ? 'none' : '';
  };

  const animateNarrator = (now: number) => {
    updateSub();
    placeNarrator();
    listen();
    drawField(now);
    requestAnimationFrame(animateNarrator);
  };

  // ----- the session -----
  const stop = () => {
    voice.pause();
    session = null;
    running = false;
    paint();
  };

  const start = (block: Narr, para: number) => {
    const p = block.paras[para];
    const src = p && clipOf(p);
    if (!src) {
      stop();
      return;
    }
    ensureGraph();
    ctx?.resume();
    session = { block, para };
    running = true;
    voice.src = src;
    voice.play().catch(() => stop());
    paint();
    // Whatever shows this paragraph can follow the voice to it (a deck
    // turns to the card being told).
    document.dispatchEvent(new CustomEvent('narr:para', { detail: p }));
  };

  const pause = () => {
    running = false;
    voice.pause();
    paint();
  };

  const resume = () => {
    running = true;
    ctx?.resume();
    voice.play().catch(() => stop());
    paint();
  };

  // The voice is heard THROUGH the AudioContext, and iOS suspends that the
  // moment the page goes to the background while the <audio> element keeps
  // running — so the Dynamic Island showed a clip advancing in silence. The
  // narration follows the page's scroll anyway, so it pauses with the page.
  document.addEventListener('visibilitychange', () => {
    if (document.hidden && running) pause();
  });

  // The system's own controls (Lock Screen, Dynamic Island) go through the
  // session, never straight to the element, so the pill and the graph stay
  // in step with them.
  if ('mediaSession' in navigator) {
    navigator.mediaSession.setActionHandler('play', () => {
      if (session) resume();
    });
    navigator.mediaSession.setActionHandler('pause', () => pause());
  }

  const scrollToStep = (story: Story, index: number) => {
    const top =
      story.root.getBoundingClientRect().top +
      window.scrollY +
      index * window.innerHeight;
    window.scrollTo({
      top,
      behavior: reduceMotion ? 'auto' : 'smooth',
    });
  };

  // A paragraph ends: the next one in the block, or the page turns and
  // the render loop picks the voice up wherever it lands (`follow`).
  voice.addEventListener('ended', () => {
    if (!session || !running) return;
    const { block, para } = session;
    const next = firstVoiced(block, para + 1);
    if (next >= 0) {
      start(block, next);
      return;
    }
    const story = block.story;
    if (block.panel) {
      // A panel hands over to the next panel, if there is one.
      const next = panels[panels.indexOf(block) + 1];
      if (next) scrollToPanel(next);
      else stop();
    } else if (!story) {
      // The hero hands over to the first story's opener.
      if (stories[0]) scrollToStep(stories[0], 0);
      else if (panels[0]) scrollToPanel(panels[0]);
      else stop();
    } else if (block.step + 1 < story.steps.length) {
      scrollToStep(story, block.step + 1);
    } else {
      // A story's last slide hands over to the next story's opener, and
      // the last story to the first panel — the pitch runs to the foot.
      const next = stories[stories.indexOf(story) + 1];
      if (next) scrollToStep(next, 0);
      else if (panels[0]) scrollToPanel(panels[0]);
      else stop();
    }
  });

  // The box a panel owns on the page. Usually its section; a phone
  // story's two stops share one stuck screen, so each owns its STEP — the
  // screen of scroll its walk takes — while the scroll timeline runs.
  const boxOf = (el: HTMLElement): HTMLElement => {
    const holder = el.closest<HTMLElement>('[data-m-step]');
    if (holder) {
      const step = holder
        .closest('.m-story')
        ?.querySelectorAll<HTMLElement>('.m-step')[Number(holder.dataset.mStep)];
      if (step && step.getClientRects().length) return step;
      // No scroll timeline: the stops are plain panels, each its own box.
      return (
        holder
          .closest('.m-story')
          ?.querySelector<HTMLElement>(`.m-panel[data-m-step="${holder.dataset.mStep}"]`) ??
        holder
      );
    }
    return el.closest<HTMLElement>('section') ?? el;
  };

  const scrollToPanel = (panel: Narr) =>
    window.scrollTo({
      top: boxOf(panel.el).getBoundingClientRect().top + window.scrollY,
      behavior: reduceMotion ? 'auto' : 'smooth',
    });

  // The page moved under a running voice — by hand or by the voice's own
  // page turn. The voice goes where the page went; a block with nothing
  // recorded ends the pitch.
  const follow = (block: Narr | undefined) => {
    const para = block ? startOf(block) : -1;
    if (block && para >= 0) start(block, para);
    else stop();
  };

  // A block turned to another paragraph by hand (a deck): a running voice
  // switches to it; a paused one will start there.
  document.addEventListener('narr:select', e => {
    const p = (e as CustomEvent<HTMLElement>).detail;
    if (!session) return;
    const i = session.block.paras.indexOf(p);
    if (i < 0 || i === session.para) return;
    if (running) start(session.block, i);
    else {
      session = { block: session.block, para: i };
      const src = clipOf(p);
      if (src) voice.src = src;
      paint();
    }
  });

  // The game has its own music: starting it quiets the voice, which
  // resumes from the same sentence on the next press.
  document.addEventListener('arcade:start', () => {
    if (running) pause();
  });

  // A language switch mid-sentence restarts that sentence in the new
  // voice; paused, the next play simply uses it.
  new MutationObserver(() => {
    if (!session) return;
    const { block, para } = session;
    if (running) start(block, para);
    else {
      const src = clipOf(block.paras[para]);
      if (src) voice.src = src;
    }
  }).observe(document.documentElement, { attributeFilter: ['data-lang'] });

  // One control. Pressed on the block being told, it pauses or resumes;
  // anywhere else, it starts telling what the page is showing.
  narrator?.addEventListener('click', () => {
    if (session && session.block === showing) {
      if (running) pause();
      else resume();
      return;
    }
    const block = showing ?? narrs[0];
    if (block) start(block, Math.max(startOf(block), 0));
  });

  const collect = (
    el: HTMLElement,
    story: Story | null,
    step: number,
    panel = false
  ) => {
    const n: Narr = {
      el,
      paras: [...el.querySelectorAll<HTMLElement>('[data-narr-para]')],
      // A block's anchor is inside it — unless the story placed it
      // elsewhere by name, as the opener does (in its foot).
      anchor:
        story?.root.querySelector<HTMLElement>(
          `[data-narr-anchor="${step}"]`
        ) ?? el.querySelector<HTMLElement>('[data-narr-anchor]'),
      story,
      step,
      panel,
    };
    // While a block is being told, its paragraphs are tappable too.
    n.paras.forEach((p, i) =>
      p.addEventListener('click', () => {
        if (session?.block === n && clipOf(p)) start(n, i);
      })
    );
    narrs.push(n);
    return n;
  };

  const heroEl = document.querySelector<HTMLElement>(
    '[data-narr-block="hero"]'
  );
  const heroNarr = heroEl ? collect(heroEl, null, -1) : undefined;

  const stories: Story[] = (
    phone ? [] : [...document.querySelectorAll<HTMLElement>('[data-story]')]
  ).map(root => {
    const story: Story = {
      root,
      steps: [...root.querySelectorAll<HTMLElement>('.step')],
      stage: root.querySelector<HTMLElement>('.stage'),
      intro: root.querySelector<HTMLElement>('.intro-scene'),
      float: root.querySelector<HTMLElement>('.float'),
      deck: null,
      lockup: root.querySelector<HTMLElement>('.lockup'),
      anchorBig: root.querySelector<HTMLElement>('.lockup-anchor-big'),
      anchorSmall: root.querySelector<HTMLElement>('.lockup-anchor-small'),
      actions: root.querySelector<HTMLElement>('.actions'),
      actionsBig: root.querySelector<HTMLElement>('.actions-anchor-big'),
      actionsSmall: root.querySelector<HTMLElement>('.actions-anchor-small'),
      blocks: [],
    };
    for (const el of root.querySelectorAll<HTMLElement>('[data-narr-block]')) {
      const step = Number(el.dataset.narrBlock);
      story.blocks[step] = collect(el, story, step);
    }

    // THE DECK. Its block is every card's paragraphs in order; it starts
    // on the card in front, a running voice switches to it, and a clip
    // that moves to another card's paragraph turns the deck there.
    const deckEl = root.querySelector<HTMLElement>('.deck');
    if (deckEl) {
      const cards = [...deckEl.querySelectorAll<HTMLElement>('.card')];
      const paras = [...deckEl.querySelectorAll<HTMLElement>('[data-narr-para]')];
      const still = deckEl.querySelector<HTMLElement>('.narr-static .narr-anchor');
      // Stand the still anchor on the current card's slot. Only the slot's
      // HEIGHT is read: the card's sideways slide never moves it.
      const standAnchor = () => {
        const slot = cards[story.deck?.current ?? 0].querySelector('.narr-slot');
        if (!still || !slot) return;
        const y = slot.getBoundingClientRect().top - deckEl.getBoundingClientRect().top;
        still.style.setProperty('--slot-y', `${y.toFixed(1)}px`);
      };
      story.deck = createDeck({
        cards,
        controls: deckEl.querySelector('[data-deck-controls]'),
        keys: deckEl,
        // A tablet's finger turns it too.
        swipe: deckEl.querySelector<HTMLElement>('.deck-stage'),
        onChange: current => {
          // A frame later: the first call comes while the deck is still
          // being made.
          requestAnimationFrame(standAnchor);
          const first = paras.find(p => p.dataset.card === String(current));
          if (!first) return;
          deckEl.dataset.narrStart = String(paras.indexOf(first));
          document.dispatchEvent(new CustomEvent('narr:select', { detail: first }));
        },
      });
      document.addEventListener('narr:para', e => {
        const p = (e as CustomEvent<HTMLElement>).detail;
        if (!deckEl.contains(p)) return;
        const i = Number(p.dataset.card);
        if (story.deck && i !== story.deck.current) story.deck.go(i);
      });
      window.addEventListener('resize', standAnchor, { passive: true });
      // Late fonts, a language switch: whatever reflows the words.
      watchSlots(cards, standAnchor);
    }
    return story;
  });

  // Only the panels this layout draws: the phone's story panels are not
  // drawn on desktop, and must not join its hand-over chain.
  const panels = [
    ...document.querySelectorAll<HTMLElement>('[data-narr-panel]'),
  ]
    .filter(el => el.getClientRects().length > 0)
    .map(el => collect(el, null, -1, true));

  // Nothing recorded anywhere → no narrator at all.
  if (narrator && narrs.length) {
    narrator.hidden = false;
    requestAnimationFrame(animateNarrator);
  }

  const docks = phone ? [...document.querySelectorAll<HTMLElement>('[data-dock]')] : [];

  // The hero rides out as the first story rides in.
  const heroInner = document.querySelector<HTMLElement>('[data-hero-inner]');

  const render = (force = false) => {
    const vh = window.innerHeight;
    const hp = step(clamp(window.scrollY / vh, 0, 1));

    // Where the narrator stands: a weighted blend of every anchor, each
    // weighted by how much of the page its block owns right now — so it
    // glides between blocks as the page scrolls, never jumps.
    parks = [];
    if (heroNarr?.anchor) parks.push({ anchor: heroNarr.anchor, w: 1 - hp });
    showing = heroNarr && window.scrollY < vh * 0.5 ? heroNarr : undefined;

    if (heroInner) {
      heroInner.style.opacity = String(clamp(1 - hp * 1.1, 0, 1));
      heroInner.style.transform = reduceMotion
        ? ''
        : `scale(${1 - hp * 0.08}) translateY(${(-hp * 0.06 * vh).toFixed(1)}px)`;
    }

    // A panel owns the narrator in proportion to how much of it is on
    // screen — the same glide a story hands over with — and owns the
    // voice once it holds the middle of the screen.
    for (const n of panels) {
      const rect = boxOf(n.el).getBoundingClientRect();
      if (rect.bottom < 0 || rect.top > vh) continue;
      // In by how far it has come up, out by how far it has gone — the
      // story rule, so two panels in a row cross-fade it at their seam.
      const own =
        step(clamp(1 - rect.top / vh, 0, 1)) * step(clamp(rect.bottom / vh, 0, 1));
      if (n.anchor && own > 0) parks.push({ anchor: n.anchor, w: own * hp });
      if (!showing && rect.top < vh * 0.5 && rect.bottom > vh * 0.5)
        showing = n;
    }

    for (const s of stories) {
      const rect = s.root.getBoundingClientRect();
      // The forced pass places every layer once at load, so nothing is
      // ever seen unstyled when a story first scrolls in.
      if (!force && (rect.bottom < 0 || rect.top > vh)) continue;

      const p = step(clamp(-rect.top / vh, 0, 1));
      const active = Math.round(p);

      // Each stop owns the narrator in a tent around its position. A story
      // lets go as it scrolls off, so whatever comes up under it — the
      // next story, the game — takes the narrator over smoothly; and a
      // story coming up takes it by how far it has come in, so two meeting
      // cross-fade it (out + in = 1 at the seam), the same glide the hero
      // hands over with.
      const out = step(clamp(rect.bottom / vh, 0, 1));
      const enter = step(clamp(1 - rect.top / vh, 0, 1));
      for (let k = 0; k < 2; k++) {
        const own = Math.max(0, 1 - Math.abs(p - k));
        const block = s.blocks[k];
        if (own > 0 && block?.anchor)
          parks.push({ anchor: block.anchor, w: own * enter * out });
      }
      if (!showing) showing = s.blocks[active];

      // The opener fades as the deck arrives.
      if (s.intro) {
        s.intro.style.opacity = String(clamp(1 - p * 2.2, 0, 1));
        s.intro.style.pointerEvents = p < 0.5 ? 'auto' : 'none';
      }

      // The words arrive once the opener is mostly gone; the phone walks
      // in from its peek across the whole step; the neighbours are dealt
      // once the deck is the page.
      if (s.float) {
        s.float.style.setProperty(
          '--float-in',
          reduceMotion ? (p >= 0.5 ? '1' : '0') : String(clamp((p - 0.35) * 2.4, 0, 1))
        );
        const peek = reduceMotion ? (p < 0.5 ? 1 : 0) : 1 - smooth(p);
        s.float.style.setProperty('--peek', peek.toFixed(4));
        s.float.classList.toggle('is-dealt', p > 0.6);
      }

      // The lockup FLIPs from the opener header to the deck's corner and
      // parks there — one element, never redrawn.
      const q = reduceMotion ? (p >= 0.5 ? 1 : 0) : smooth(p);
      if (s.lockup && s.stage && s.anchorBig && s.anchorSmall) {
        const stageRect = s.stage.getBoundingClientRect();
        const big = s.anchorBig.getBoundingClientRect();
        const small = s.anchorSmall.getBoundingClientRect();
        const scale = 1 + (small.height / big.height - 1) * q;
        const x = big.left - stageRect.left + (small.left - big.left) * q;
        const y = big.top - stageRect.top + (small.top - big.top) * q;
        s.lockup.style.transform =
          `translate(${x.toFixed(1)}px, ${y.toFixed(1)}px) ` +
          `scale(${scale.toFixed(4)})`;
      }

      // The action row makes the same trip, toward the deck's foot. It
      // never scales: both store programs set a minimum badge height, so
      // the badges keep the size they were measured at. It belongs to the
      // OPENER and leaves with it.
      if (s.actions && s.stage && s.actionsBig && s.actionsSmall) {
        const stageRect = s.stage.getBoundingClientRect();
        const big = s.actionsBig.getBoundingClientRect();
        const small = s.actionsSmall.getBoundingClientRect();
        const x = big.left - stageRect.left + (small.left - big.left) * q;
        const y = big.top - stageRect.top + (small.top - big.top) * q;
        s.actions.style.transform =
          `translate(${x.toFixed(1)}px, ${y.toFixed(1)}px)`;
        const rowVis = reduceMotion ? (p < 0.5 ? 1 : 0) : clamp(1 - p * 2.2, 0, 1);
        s.actions.style.opacity = String(rowVis);
        s.actions.style.pointerEvents = rowVis > 0.5 ? 'auto' : 'none';
      }
    }

    // A phone deck's controls dock beside the corner narrator, and fade
    // WITH the scroll — in as their deck comes onto the screen, out as it
    // leaves. A class flipped at mid-screen cut them in and out.
    for (const dock of docks) {
      const r = boxOf(dock).getBoundingClientRect();
      const shown = (Math.min(r.bottom, vh) - Math.max(r.top, 0)) / vh;
      const o = clamp((shown - 0.45) / 0.4, 0, 1);
      dock.style.opacity = o.toFixed(3);
      dock.style.visibility = o < 0.02 ? 'hidden' : 'visible';
      dock.style.pointerEvents = o < 0.6 ? 'none' : '';
    }

    if (session && running && showing !== session.block) follow(showing);

    placeNarrator();
  };

  // A boolean "already scheduled" guard DEADLOCKS: if the frame it is
  // waiting on never runs — a hidden tab, a backgrounded window — the
  // flag stays set and the scene never renders again, even once the
  // page is visible. Replacing the pending frame instead can't get
  // stuck, and the visibility handler catches up whatever was missed.
  let frame = 0;
  const onScroll = () => {
    cancelAnimationFrame(frame);
    frame = requestAnimationFrame(() => render());
  };

  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) render(true);
  });

  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll, { passive: true });

  // The FLIP anchors sit inside `[data-reveal]` blocks, which enter 20px
  // low — measure during that and the row parks 20px off its anchor for
  // good, since nothing re-measures until the next scroll. Re-render
  // when a reveal settles.
  document.addEventListener(
    'transitionend',
    event => {
      const target = event.target as HTMLElement;
      if (target?.hasAttribute?.('data-reveal')) render(true);
    },
    { passive: true }
  );

  render(true);
  // Transitions switch on only AFTER the first placement, so nothing
  // animates in from nowhere on load.
  // ---------- the phone's decks ----------
  // The same deck as the desktop's, welcome first. The narrator starts the
  // panel on the card in front (data-narr-start = that card's first
  // paragraph), a running voice switches to it, and a clip that moves on
  // to another card's paragraph turns the deck there.
  if (phone)
    for (const panel of document.querySelectorAll<HTMLElement>('.m-deck')) {
      const stage = panel.querySelector<HTMLElement>('.m-stage');
      const paras = [...panel.querySelectorAll<HTMLElement>('[data-narr-para]')];
      const deck = createDeck({
        cards: [...panel.querySelectorAll<HTMLElement>('.m-card')],
        controls:
          panel.closest('.m-story')?.querySelector<HTMLElement>('[data-deck-controls]') ?? null,
        keys: null,
        swipe: stage,
        onChange: current => {
          const first = paras.find(p => p.dataset.card === String(current));
          if (!first) return;
          panel.dataset.narrStart = String(paras.indexOf(first));
          document.dispatchEvent(new CustomEvent('narr:select', { detail: first }));
        },
      });
      document.addEventListener('narr:para', e => {
        const p = (e as CustomEvent<HTMLElement>).detail;
        if (!panel.contains(p)) return;
        const i = Number(p.dataset.card);
        if (i !== deck.current) deck.go(i);
      });
    }

  if (stepped)
    requestAnimationFrame(() =>
      requestAnimationFrame(() =>
        document.documentElement.classList.add('is-stepped')
      )
    );
</script>
