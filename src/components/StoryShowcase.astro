---
import type { UIKey } from '../i18n/ui';
import ListenPill from './ListenPill.astro';
import StoreBadges from './StoreBadges.astro';
import T from './T.astro';

/**
 * One app, told as CINEMA. Two acts:
 *
 * An opener panel — the app's first shot blown into a full-bleed glow,
 * the tile, the name at display size, three lines, the listen pill.
 *
 * Then the stage: a sticky full-viewport scene per screenshot, every
 * layer COUPLED to the scroll rather than triggered by it — position is
 * a function of scroll, the grammar of Rockstar's GTA VI site. The
 * backdrop (the slide itself, blurred) zooms THROUGH as you pass, the
 * shot rides faster than the backdrop (parallax = depth), the title
 * arrives at a third speed. Invisible 100svh steps carry the snapping,
 * so a flick still lands exactly one slide.
 *
 * Captions double as narration transcripts; each slide can carry a
 * voice clip and the deck advances itself when one ends.
 */
export type StorySlide = {
  src: string;
  width: number;
  height: number;
  titleKey?: UIKey;
  bodyKey?: UIKey;
  /** Narration clip for this slide — absent until it's recorded. */
  audio?: string;
};

type Props = {
  id: string;
  name: string;
  introKey: UIKey;
  /** The app's intro narration — why it exists, in Juan's voice. */
  introAudio?: string;
  slides: StorySlide[];
  /** Show the App Store / Google Play slots (apps, not web products). */
  stores?: boolean;
};

const { id, name, introKey, introAudio, slides, stores = false } = Astro.props;
---

<section class="panel intro" id={id}>
  <img
    class="intro-backdrop"
    src={slides[0].src}
    alt=""
    aria-hidden="true"
    loading="lazy"
    decoding="async"
  />
  <div class="inner intro-content">
    <div class="tile" data-reveal><slot name="logo" /></div>
    <h2 class="app-title" data-reveal>{name}</h2>
    <p class="body intro-copy" data-reveal><T k={introKey} /></p>

    {stores && <StoreBadges />}

    <ListenPill audio={introAudio} story={id} />
  </div>
</section>

<section class="story" data-story={id} style={`--slides: ${slides.length}`}>
  <!-- The scroll rail: one invisible step per slide. Each carries the snap
       point and, once recorded, that slide's narration clip. -->
  <div class="steps" aria-hidden="true">
    {
      slides.map((slide, i) => (
        <div class="step" data-index={i} data-audio={slide.audio} />
      ))
    }
  </div>

  <div class="stage">
    <!-- The backdrop is the slide itself, blown up and blurred — the image
         generates its own gradient, no color math anywhere. -->
    <div class="backdrops" aria-hidden="true">
      {
        slides.map(slide => (
          <img
            class="backdrop"
            src={slide.src}
            alt=""
            loading="lazy"
            decoding="async"
          />
        ))
      }
    </div>

    <div class="inner stage-grid">
      <div class="caption">
        {
          slides.map(slide => (
            <div class="cap">
              <span class="label">{name}</span>
              {slide.titleKey && (
                <h3 class="slide-title">
                  <T k={slide.titleKey} />
                </h3>
              )}
              {slide.bodyKey && (
                <p class="body">
                  <T k={slide.bodyKey} />
                </p>
              )}
            </div>
          ))
        }
      </div>

      <div class="shots">
        {
          slides.map(slide => (
            <img
              class="shot"
              src={slide.src}
              alt={`${name} screenshot`}
              width={slide.width}
              height={slide.height}
              loading="lazy"
              decoding="async"
            />
          ))
        }
      </div>
    </div>

    <div class="dots">
      {
        slides.map((_, i) => (
          <button
            class="dot"
            data-index={i}
            aria-label={`${name} ${i + 1} / ${slides.length}`}
          />
        ))
      }
    </div>
  </div>
</section>

<style>
  .inner {
    width: 100%;
    max-width: var(--content-max);
    margin: 0 auto;
  }

  /* ---------- the opener ---------- */

  .intro {
    position: relative;
    overflow: hidden;
    justify-content: center;
  }

  .intro-backdrop {
    position: absolute;
    inset: -10%;
    width: 120%;
    height: 120%;
    object-fit: cover;
    filter: blur(110px) saturate(1.3) brightness(0.3);
  }

  .intro-content {
    position: relative;
  }

  /* The name at the size Rockstar titles a scene — the opener's whole job. */
  .app-title {
    margin-top: 1.25rem;
    font-size: clamp(3rem, 8vw, 6rem);
    font-weight: 800;
    letter-spacing: var(--track-display);
    line-height: 0.95;
  }

  .intro-copy {
    margin-top: 1.5rem;
  }

  /* ---------- the stage ---------- */

  .story {
    position: relative;
    height: calc(var(--slides) * 100svh);
  }

  .steps {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .step {
    height: 100svh;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  .stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 5.5rem clamp(1.25rem, 4vw, 2.5rem) 3.5rem;
  }

  /* Fade the glow out at both edges so the stage melts into the ground
     instead of cutting against the neighboring panels. */
  .backdrops {
    position: absolute;
    inset: 0;
    mask-image: linear-gradient(
      to bottom,
      transparent,
      black 16%,
      black 84%,
      transparent
    );
  }

  /* Every moving layer starts invisible and the render loop drives it —
     except the first slide, which shows without JS at all. */
  .backdrop {
    position: absolute;
    inset: -8%;
    width: 116%;
    height: 116%;
    object-fit: cover;
    filter: blur(72px) saturate(1.35) brightness(0.45);
    opacity: 0;
    transform: scale(1.1);
    will-change: opacity, transform;
  }

  .backdrop:first-child {
    opacity: 1;
  }

  /* Caption on the 4 side of the Monolith seam, the shot on the 9. */
  .stage-grid {
    position: relative;
    display: grid;
    grid-template-columns: var(--seam) 1fr;
    /* One explicit row: it IS the stage's free height, so the shots can
       take height: 100% of something real (an auto row makes that
       percentage unresolvable and the shot overflows under the header). */
    grid-template-rows: minmax(0, 1fr);
    gap: var(--space-4);
    min-height: 0;
    flex: 1;
  }

  .caption {
    position: relative;
    align-self: center;
    min-height: 16rem;
  }

  .cap {
    position: absolute;
    inset: 0 0 auto;
    opacity: 0;
    pointer-events: none;
    will-change: opacity, transform;
  }

  .cap:first-child {
    opacity: 1;
  }

  .slide-title {
    margin-top: 0.875rem;
    font-size: clamp(2.25rem, 4.5vw, 4rem);
    font-weight: 800;
    letter-spacing: var(--track-display);
    line-height: 0.95;
  }

  .cap .body {
    margin-top: 1.25rem;
  }

  .shots {
    position: relative;
    height: 100%;
    min-height: 0;
  }

  .shot {
    position: absolute;
    top: 0;
    left: 50%;
    height: 100%;
    width: auto;
    opacity: 0;
    transform: translate(-50%, 0);
    will-change: opacity, transform;

    /* The corner is the PHONE'S, not the App Store's — 55pt on a 393pt
       screen, i.e. 14% of the width / 6.46% of the height, measured so a
       full-height sheet's own display-concentric corners don't leave black
       notches (the full derivation lived in Showcase.astro's history). The
       hairline is Apple's dark-appearance treatment. No bezel, no fill. */
    border-radius: 14% / 6.46%;
    border: 1px solid var(--hairline);
  }

  .shot:first-child {
    opacity: 1;
  }

  .dots {
    position: relative;
    display: flex;
    justify-content: center;
    gap: 0.875rem;
    padding-top: 1.5rem;
  }

  .dot {
    width: 0.4375rem;
    height: 0.4375rem;
    padding: 0;
    border: none;
    border-radius: 999px;
    background: var(--ink-3);
    opacity: 0.45;
    cursor: pointer;
    transition:
      opacity var(--dur-micro) var(--ease),
      background var(--dur-micro) var(--ease);
  }

  .dot[data-active] {
    background: var(--ink);
    opacity: 1;
  }

  @media (max-width: 48rem) {
    .stage {
      padding-top: 4.5rem;
      padding-bottom: 2rem;
    }

    /* One column: the shot leads, the caption reads under it. */
    .stage-grid {
      grid-template-columns: 1fr;
      grid-template-rows: minmax(0, 1fr) auto;
      gap: 1.25rem;
    }

    .shots {
      order: -1;
    }

    .caption {
      min-height: 12rem;
    }

    .slide-title {
      font-size: clamp(1.875rem, 8vw, 2.5rem);
    }
  }
</style>

<script>
  // ---------- the cinema controller ----------
  // One module for every story on the page. Two jobs:
  //
  // RENDER — every moving layer is a pure function of scroll, recomputed
  // in one rAF pass: for slide i, t = p - i where p is how many viewports
  // deep the story is. Backdrop zooms through (slow), shot rides the
  // scroll (fast), title arrives at a third speed. No triggers, no state
  // machines — scrub the page and the scene scrubs with it.
  //
  // NARRATION — a single shared Audio element (unlocked by the pill's
  // tap, then free to swap sources) reads the active slide and advances
  // the deck when a clip ends. Manual scroll simply re-targets it.

  const reduceMotion = window.matchMedia(
    '(prefers-reduced-motion: reduce)'
  ).matches;

  const clamp = (v: number, min: number, max: number) =>
    Math.min(max, Math.max(min, v));

  const voice = new Audio();
  voice.preload = 'auto';

  type Story = {
    root: HTMLElement;
    steps: HTMLElement[];
    backdrops: HTMLElement[];
    shots: HTMLElement[];
    caps: HTMLElement[];
    dots: HTMLElement[];
    pill: HTMLElement | null;
    current: number;
  };

  let armed: Story | null = null;

  const setPill = (story: Story, playing: boolean) => {
    story.pill?.classList.toggle('is-playing', playing);
  };

  const disarm = () => {
    if (!armed) return;
    voice.pause();
    voice.onended = null;
    setPill(armed, false);
    armed = null;
  };

  const play = (src: string, onEnd: () => void) => {
    voice.src = src;
    voice.onended = onEnd;
    voice.play().catch(() => disarm());
  };

  const scrollToStep = (story: Story, index: number) => {
    story.steps[index]?.scrollIntoView({
      block: 'start',
      behavior: reduceMotion ? 'auto' : 'smooth',
    });
  };

  const playStep = (story: Story, index: number) => {
    const src = story.steps[index]?.dataset.audio;
    // Narration ends where the recorded clips do — never a lying pill.
    if (!src) {
      disarm();
      return;
    }
    play(src, () => {
      if (armed !== story) return;
      if (index + 1 < story.steps.length) scrollToStep(story, index + 1);
      else disarm();
    });
  };

  const stories: Story[] = [
    ...document.querySelectorAll<HTMLElement>('[data-story]'),
  ].map(root => {
    const story: Story = {
      root,
      steps: [...root.querySelectorAll<HTMLElement>('.step')],
      backdrops: [...root.querySelectorAll<HTMLElement>('.backdrop')],
      shots: [...root.querySelectorAll<HTMLElement>('.shot')],
      caps: [...root.querySelectorAll<HTMLElement>('.cap')],
      dots: [...root.querySelectorAll<HTMLElement>('.dot')],
      pill: document.querySelector<HTMLElement>(
        `[data-narrate-story="${root.dataset.story}"]`
      ),
      current: -1,
    };

    story.dots.forEach((dot, i) =>
      dot.addEventListener('click', () => scrollToStep(story, i))
    );

    // The pill: arm narration for this story. Its own clip is the app's
    // intro; when that ends, the deck starts itself.
    story.pill?.addEventListener('click', () => {
      if (armed === story) {
        disarm();
        return;
      }
      disarm();
      armed = story;
      setPill(story, true);
      const intro = story.pill?.dataset.audio;
      if (intro) {
        play(intro, () => {
          if (armed === story) scrollToStep(story, 0);
        });
      } else {
        scrollToStep(story, 0);
      }
    });

    return story;
  });

  // The hero rides out as the first story rides in.
  const heroInner = document.querySelector<HTMLElement>('[data-hero-inner]');

  const render = () => {
    const vh = window.innerHeight;

    if (heroInner) {
      const hp = clamp(window.scrollY / vh, 0, 1);
      heroInner.style.opacity = String(clamp(1 - hp * 1.1, 0, 1));
      heroInner.style.transform = reduceMotion
        ? ''
        : `scale(${1 - hp * 0.08}) translateY(${(-hp * 0.06 * vh).toFixed(1)}px)`;
    }

    for (const s of stories) {
      const rect = s.root.getBoundingClientRect();
      if (rect.bottom < 0 || rect.top > vh) continue;

      const p = clamp(-rect.top / vh, 0, s.steps.length - 1);
      const active = Math.round(p);

      for (let i = 0; i < s.steps.length; i++) {
        const t = p - i;
        const at = Math.abs(t);

        if (reduceMotion) {
          const on = i === active ? '1' : '0';
          s.backdrops[i].style.opacity = on;
          s.shots[i].style.opacity = on;
          s.caps[i].style.opacity = on;
          continue;
        }

        // Three speeds, one scroll: the depth IS the difference.
        s.backdrops[i].style.opacity = String(clamp(1 - at, 0, 1));
        s.backdrops[i].style.transform =
          `scale(${(1.1 + clamp(t, -1, 1) * 0.1).toFixed(3)})`;

        s.shots[i].style.opacity = String(clamp(1 - at * 1.4, 0, 1));
        s.shots[i].style.transform =
          `translate(-50%, ${(-t * 0.16 * vh).toFixed(1)}px) ` +
          `scale(${(1 - Math.min(at * 0.08, 0.08)).toFixed(3)})`;

        s.caps[i].style.opacity = String(clamp(1 - at * 1.8, 0, 1));
        s.caps[i].style.transform =
          `translateY(${(-t * 0.07 * vh).toFixed(1)}px)`;
        s.caps[i].style.pointerEvents = at < 0.5 ? 'auto' : 'none';
      }

      if (active !== s.current) {
        s.current = active;
        s.dots.forEach((dot, i) =>
          dot.toggleAttribute('data-active', i === active)
        );
        if (armed === s) playStep(s, active);
      }
    }
  };

  let ticking = false;
  const onScroll = () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      ticking = false;
      render();
    });
  };

  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll, { passive: true });
  render();
</script>
