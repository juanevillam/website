---
import type { UIKey } from '../i18n/ui';
import ListenPill from './ListenPill.astro';
import StoreBadges from './StoreBadges.astro';
import T from './T.astro';

/**
 * One app = ONE horizontal deck. The first slide is the opener — tile,
 * the name at display size, three lines, the listen pill — and the
 * screenshots follow, all in the same lateral slider.
 *
 * The page scrolls down; the SCENE travels sideways. Every layer is
 * COUPLED to the scroll rather than triggered by it — position is a
 * function of scroll, the grammar of Rockstar's GTA VI site. The
 * backdrop (the slide itself, blurred) zooms through as you pass, the
 * shot rides the scroll faster than the backdrop (parallax = depth),
 * the title arrives at a third speed. Invisible 100svh steps carry the
 * snapping, so a flick still lands exactly one slide.
 *
 * Captions double as narration transcripts; each slide can carry a
 * voice clip and the deck advances itself when one ends.
 */
export type StorySlide = {
  src: string;
  width: number;
  height: number;
  /** Slide titles are ALWAYS English, in every locale — brand nouns. */
  title?: string;
  /** The wedge: three lines, longest and largest first, per locale. */
  lines?: [UIKey, UIKey, UIKey];
  /** Narration clip for this slide — absent until it's recorded. */
  audio?: string;
};

type Props = {
  id: string;
  name: string;
  introKey: UIKey;
  /** The app's intro narration — why it exists, in Juan's voice. */
  introAudio?: string;
  slides: StorySlide[];
  /** Show the App Store / Google Play slots (apps, not web products). */
  stores?: boolean;
};

const { id, name, introKey, introAudio, slides, stores = false } = Astro.props;

// The deck: step 0 is the opener, then one step per screenshot.
const stepCount = slides.length + 1;
---

<section
  class="story"
  id={id}
  data-story={id}
  style={`--steps: ${stepCount}`}
>
  <!-- The scroll rail: one invisible step per slide. Each carries the snap
       point and, once recorded, that slide's narration clip. -->
  <div class="steps" aria-hidden="true">
    <div class="step" data-index="0" data-audio={introAudio} />
    {
      slides.map((slide, i) => (
        <div class="step" data-index={i + 1} data-audio={slide.audio} />
      ))
    }
  </div>

  <div class="stage">
    <!-- Slide 0: the opener. The icon + name live in the shared lockup
         below; the anchor just reserves their place in this layout. -->
    <div class="intro-scene">
      <div class="inner">
        <div class="lockup-anchor-big" aria-hidden="true"></div>
        <p class="body intro-copy" data-reveal><T k={introKey} /></p>

        {stores && <StoreBadges />}

        <ListenPill audio={introAudio} story={id} />
      </div>
    </div>

    <div class="inner stage-grid">
      <div class="caption">
        <div class="lockup-anchor-small" aria-hidden="true"></div>
        {
          slides.map(slide => (
            <div class="cap">
              {slide.title && <h3 class="slide-title">{slide.title}</h3>}
              {slide.lines && (
                <div class="wedge">
                  {slide.lines.map(k => (
                    <p class="wedge-line">
                      <T k={k} />
                    </p>
                  ))}
                </div>
              )}
            </div>
          ))
        }
      </div>

      <div class="shots">
        {
          slides.map(slide => (
            <div class="shot-wrap">
              <img
                class="halo"
                src={slide.src}
                alt=""
                aria-hidden="true"
                loading="lazy"
                decoding="async"
              />
              <img
                class="shot"
                src={slide.src}
                alt={`${name} screenshot`}
                width={slide.width}
                height={slide.height}
                loading="lazy"
                decoding="async"
              />
            </div>
          ))
        }
      </div>
    </div>

    <!-- The shared lockup: icon + name in a row, once per story. Big on
         the opener, it shrinks into the caption corner as slide 1 rides
         in and stays there for every screenshot — the render loop
         interpolates between the two anchors' rects. -->
    <div class="lockup">
      <slot name="logo" />
      <span class="lockup-name">{name}</span>
    </div>

    <div class="dots">
      {
        Array.from({ length: stepCount }).map((_, i) => (
          <button
            class="dot"
            data-index={i}
            aria-label={`${name} ${i + 1} / ${stepCount}`}
          />
        ))
      }
    </div>
  </div>
</section>

<style>
  .inner {
    width: 100%;
    max-width: var(--content-max);
    margin: 0 auto;
  }

  /* ---------- the deck ---------- */

  .story {
    position: relative;
    height: calc(var(--steps) * 100svh);
  }

  .steps {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .step {
    height: 100svh;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  .stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: center;
    /* Trimmed to what the header and the dots actually need — every
       spare point goes to the screenshot. */
    padding: 5rem clamp(1.25rem, 4vw, 2.5rem) 1.5rem;
  }

  /* ---------- slide 0: the opener ---------- */

  .intro-scene {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    padding: 5rem clamp(1.25rem, 4vw, 2.5rem) 1.5rem;
    will-change: opacity;
  }

  /* Same lift as the captions: content reads above center. */
  .intro-scene .inner {
    margin-bottom: 4rem;
  }

  /* ---------- the shared lockup ---------- */

  /* Icon + name in one row, drawn ONCE per story. The two anchors below
     reserve its place in each layout; the render loop translates and
     scales the lockup between their rects (origin top left), so the
     opener's big lockup IS the small one over the captions — a shared
     element, not two copies. */
  .lockup {
    position: absolute;
    top: 0;
    left: 0;
    /* Above the opener, BELOW the shots: a passing screenshot covers the
       lockup and the words, never the other way around. */
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    height: 4.75rem;
    white-space: nowrap;
    transform-origin: top left;
    pointer-events: none;
    will-change: transform;
  }

  .lockup-name {
    font-size: clamp(2.5rem, 5.5vw, 4.25rem);
    font-weight: 800;
    letter-spacing: var(--track-display);
    line-height: 0.95;
  }

  /* The anchors: same box the lockup occupies at each end of the ride. */
  .lockup-anchor-big {
    height: 4.75rem;
  }

  .lockup-anchor-small {
    height: 2.25rem;
  }

  .intro-copy {
    margin-top: 1.25rem;
  }

  /* The two control rows read as one group: air above, tight between. */
  .intro-scene :global(.stores) {
    margin-top: 2rem;
  }

  .intro-scene :global(.listen) {
    margin-top: 1rem;
  }

  /* ---------- the screenshot slides ---------- */

  /* Caption on the 4 side of the Monolith seam, the shot on the 9. */
  .stage-grid {
    position: relative;
    /* The slider is the TOP layer: a shot crossing the stage wipes over
       the caption and the lockup — the text changes underneath it. */
    z-index: 3;
    display: grid;
    /* One rung wider than the seam (5/13) — the words need the room. */
    grid-template-columns: calc(100% * 5 / 13) 1fr;
    /* One explicit row: it IS the stage's free height, so the shots can
       take height: 100% of something real (an auto row makes that
       percentage unresolvable and the shot overflows under the header). */
    grid-template-rows: minmax(0, 1fr);
    gap: var(--space-4);
    min-height: 0;
    flex: 1;
  }

  .caption {
    position: relative;
    align-self: center;
    min-height: 16rem;
    /* Lift the words above the geometric center — the phone holds the
       middle, the text reads a beat higher. */
    margin-bottom: 6rem;
  }

  .cap {
    position: absolute;
    inset: 0 0 auto;
    /* Clear the small lockup parked above the captions. */
    padding-top: 3.5rem;
    opacity: 0;
    pointer-events: none;
    will-change: opacity;
  }

  .slide-title {
    margin-top: 0.875rem;
    font-size: clamp(2.25rem, 4.5vw, 4rem);
    font-weight: 800;
    letter-spacing: var(--track-display);
    line-height: 0.95;
  }

  /* The wedge: three lines stepping down in size and ink —
     ========  /  =======  /  ====== */
  .wedge {
    margin-top: 1.25rem;
  }

  .wedge-line {
    line-height: 1.5;
  }

  .wedge-line:nth-child(1) {
    font-size: 1.25rem;
    color: var(--ink);
  }

  .wedge-line:nth-child(2) {
    margin-top: 0.375rem;
    font-size: 1.125rem;
    color: var(--ink-2);
  }

  .wedge-line:nth-child(3) {
    margin-top: 0.375rem;
    font-size: 1rem;
    color: var(--ink-3);
  }

  .shots {
    position: relative;
    height: 100%;
    min-height: 0;
  }

  /* The render loop moves the WRAP; the shot and its halo ride inside. */
  .shot-wrap {
    position: absolute;
    top: 0;
    left: 50%;
    height: 100%;
    opacity: 0;
    transform: translate(-50%, 0);
    will-change: opacity, transform;
  }

  /* The gradient the image generates, cast from its own border — the
     same picture behind itself, slightly larger and blurred, so the
     halo hugs the phone's silhouette and the ground stays ground. */
  .halo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transform: scale(1.06);
    filter: blur(44px) saturate(1.5);
    opacity: 0.85;
    border-radius: 14% / 6.46%;
  }

  .shot {
    position: relative;
    height: 100%;
    width: auto;

    /* The corner is the PHONE'S, not the App Store's — 55pt on a 393pt
       screen, i.e. 14% of the width / 6.46% of the height, measured so a
       full-height sheet's own display-concentric corners don't leave black
       notches (the full derivation lived in Showcase.astro's history).
       The BOTTOM corners crop a beat tighter (+~2px at render size) —
       the 14% clip still let a sliver of the sheet shots' dead corners
       through. The hairline is Apple's dark-appearance treatment. No
       bezel, no fill. */
    border-radius: 14% 14% 14.8% 14.8% / 6.46% 6.46% 6.85% 6.85%;
    border: 1px solid var(--hairline);
  }

  .dots {
    position: relative;
    z-index: 4;
    display: flex;
    justify-content: center;
    gap: 0.875rem;
    /* Real air between the scene and the indicators. */
    padding-top: 3rem;
  }

  .dot {
    width: 0.4375rem;
    height: 0.4375rem;
    padding: 0;
    border: none;
    border-radius: 999px;
    background: var(--ink-3);
    opacity: 0.45;
    cursor: pointer;
    transition:
      opacity var(--dur-micro) var(--ease),
      background var(--dur-micro) var(--ease);
  }

  .dot[data-active] {
    background: var(--ink);
    opacity: 1;
  }

  @media (max-width: 48rem) {
    .stage,
    .intro-scene {
      padding-top: 4.5rem;
      padding-bottom: 2rem;
    }

    /* One column: the shot leads, the caption reads under it. */
    .stage-grid {
      grid-template-columns: 1fr;
      grid-template-rows: minmax(0, 1fr) auto;
      gap: 1.25rem;
    }

    .shots {
      order: -1;
    }

    .caption {
      min-height: 12rem;
      /* Below the shot on mobile — no lift to apply. */
      margin-bottom: 0;
    }

    .slide-title {
      font-size: clamp(1.875rem, 8vw, 2.5rem);
    }

    /* A narrow screen can't seat a 4rem name beside the tile. */
    .lockup {
      gap: 1rem;
    }

    .lockup-name {
      font-size: 2rem;
    }

  }
</style>

<script>
  // ---------- the cinema controller ----------
  // One module for every story on the page. Two jobs:
  //
  // RENDER — every moving layer is a pure function of scroll, recomputed
  // in one rAF pass: for step i, t = p - i where p is how many viewports
  // deep the story is. Step 0 is the opener; screenshots are steps 1..n.
  // The page scrolls down, the scene travels SIDEWAYS: a slide enters
  // from the right and leaves to the left, shot faster than its caption —
  // the depth IS the difference. No triggers, no state machines.
  //
  // NARRATION — a single shared Audio element (unlocked by the pill's
  // tap, then free to swap sources) reads the active slide and advances
  // the deck when a clip ends. Manual scroll simply re-targets it.

  const reduceMotion = window.matchMedia(
    '(prefers-reduced-motion: reduce)'
  ).matches;

  const clamp = (v: number, min: number, max: number) =>
    Math.min(max, Math.max(min, v));

  // Entry vectors, cycling per slide: right, below, above, left.
  const DIRS: [number, number][] = [
    [1, 0],
    [0, 1],
    [0, -1],
    [-1, 0],
  ];

  const voice = new Audio();
  voice.preload = 'auto';

  type Story = {
    root: HTMLElement;
    steps: HTMLElement[];
    stage: HTMLElement | null;
    intro: HTMLElement | null;
    lockup: HTMLElement | null;
    anchorBig: HTMLElement | null;
    anchorSmall: HTMLElement | null;
    shots: HTMLElement[];
    caps: HTMLElement[];
    dots: HTMLElement[];
    pill: HTMLElement | null;
    current: number;
  };

  let armed: Story | null = null;

  const setPill = (story: Story, playing: boolean) => {
    story.pill?.classList.toggle('is-playing', playing);
  };

  const disarm = () => {
    if (!armed) return;
    voice.pause();
    voice.onended = null;
    setPill(armed, false);
    armed = null;
  };

  const scrollToStep = (story: Story, index: number) => {
    story.steps[index]?.scrollIntoView({
      block: 'start',
      behavior: reduceMotion ? 'auto' : 'smooth',
    });
  };

  const playStep = (story: Story, index: number) => {
    const src = story.steps[index]?.dataset.audio;
    // Narration ends where the recorded clips do — never a lying pill.
    if (!src) {
      disarm();
      return;
    }
    voice.src = src;
    voice.onended = () => {
      if (armed !== story) return;
      if (index + 1 < story.steps.length) scrollToStep(story, index + 1);
      else disarm();
    };
    voice.play().catch(() => disarm());
  };

  const stories: Story[] = [
    ...document.querySelectorAll<HTMLElement>('[data-story]'),
  ].map(root => {
    const story: Story = {
      root,
      steps: [...root.querySelectorAll<HTMLElement>('.step')],
      stage: root.querySelector<HTMLElement>('.stage'),
      intro: root.querySelector<HTMLElement>('.intro-scene'),
      lockup: root.querySelector<HTMLElement>('.lockup'),
      anchorBig: root.querySelector<HTMLElement>('.lockup-anchor-big'),
      anchorSmall: root.querySelector<HTMLElement>('.lockup-anchor-small'),
      shots: [...root.querySelectorAll<HTMLElement>('.shot-wrap')],
      caps: [...root.querySelectorAll<HTMLElement>('.cap')],
      dots: [...root.querySelectorAll<HTMLElement>('.dot')],
      pill: document.querySelector<HTMLElement>(
        `[data-narrate-story="${root.dataset.story}"]`
      ),
      current: -1,
    };

    story.dots.forEach((dot, i) =>
      dot.addEventListener('click', () => scrollToStep(story, i))
    );

    // The pill lives on slide 0, so arming starts the deck right where
    // the person is standing: the opener's own clip, then onward.
    story.pill?.addEventListener('click', () => {
      if (armed === story) {
        disarm();
        return;
      }
      disarm();
      armed = story;
      setPill(story, true);
      playStep(story, Math.max(story.current, 0));
    });

    return story;
  });

  // The hero rides out as the first story rides in.
  const heroInner = document.querySelector<HTMLElement>('[data-hero-inner]');

  const render = (force = false) => {
    const vh = window.innerHeight;
    const vw = window.innerWidth;

    if (heroInner) {
      const hp = clamp(window.scrollY / vh, 0, 1);
      heroInner.style.opacity = String(clamp(1 - hp * 1.1, 0, 1));
      heroInner.style.transform = reduceMotion
        ? ''
        : `scale(${1 - hp * 0.08}) translateY(${(-hp * 0.06 * vh).toFixed(1)}px)`;
    }

    for (const s of stories) {
      const rect = s.root.getBoundingClientRect();
      // The forced pass places every layer once at load, so nothing is
      // ever seen untransformed when a story first scrolls in.
      if (!force && (rect.bottom < 0 || rect.top > vh)) continue;

      const p = clamp(-rect.top / vh, 0, s.steps.length - 1);
      const active = Math.round(p);

      // The lockup rides from the opener's anchor to the caption's on
      // the first step and parks there — icon and name never redraw,
      // they just travel (FLIP between the two anchors' rects).
      if (s.lockup && s.stage && s.anchorBig && s.anchorSmall) {
        const stageRect = s.stage.getBoundingClientRect();
        const big = s.anchorBig.getBoundingClientRect();
        const small = s.anchorSmall.getBoundingClientRect();
        let q = clamp(p, 0, 1);
        if (reduceMotion) q = q < 0.5 ? 0 : 1;
        else q = q * q * (3 - 2 * q); // smoothstep — eased, not floaty
        const scale = 1 + (small.height / big.height - 1) * q;
        const x = big.left - stageRect.left + (small.left - big.left) * q;
        const y = big.top - stageRect.top + (small.top - big.top) * q;
        s.lockup.style.transform =
          `translate(${x.toFixed(1)}px, ${y.toFixed(1)}px) ` +
          `scale(${scale.toFixed(4)})`;
      }

      for (let i = 0; i < s.steps.length; i++) {
        const t = p - i;
        const at = Math.abs(t);
        // The opener is layer 0; screenshot slides sit one step later.
        const shot = s.shots[i - 1];
        const cap = s.caps[i - 1];

        if (reduceMotion) {
          const on = i === active ? '1' : '0';
          if (i === 0 && s.intro) s.intro.style.opacity = on;
          if (shot) shot.style.opacity = on;
          if (cap) cap.style.opacity = on;
          continue;
        }

        // The shots are a REAL slider — full travel, no fade — but each
        // slide owns a DIRECTION: in from the right, from below, from
        // above, from the left, cycling. It enters along its vector and
        // exits out the opposite edge. The words barely move: a quick
        // crossfade in place, so the impression is that only the
        // screenshots change.
        if (i === 0 && s.intro) {
          s.intro.style.opacity = String(clamp(1 - at * 3.2, 0, 1));
          s.intro.style.pointerEvents = at < 0.5 ? 'auto' : 'none';
        }

        if (shot) {
          const [dx, dy] = DIRS[(i - 1) % DIRS.length];
          shot.style.opacity = at < 1.05 ? '1' : '0';
          shot.style.transform =
            `translate(calc(-50% + ${(-t * 0.8 * vw * dx).toFixed(1)}px), ` +
            `${(-t * 1.15 * vh * dy).toFixed(1)}px)`;
        }

        if (cap) {
          cap.style.opacity = String(clamp(1 - at * 4.5, 0, 1));
          cap.style.pointerEvents = at < 0.5 ? 'auto' : 'none';
        }
      }

      if (active !== s.current) {
        s.current = active;
        s.dots.forEach((dot, i) =>
          dot.toggleAttribute('data-active', i === active)
        );
        if (armed === s) playStep(s, active);
      }
    }
  };

  let ticking = false;
  const onScroll = () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      ticking = false;
      render();
    });
  };

  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll, { passive: true });
  render(true);
</script>
