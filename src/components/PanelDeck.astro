---
import T from './T.astro';
import TL from './TL.astro';
import DeckControls from './DeckControls.astro';
import CopyLink from './CopyLink.astro';
import { ui, type UIKey } from '../i18n/ui';
import { clipFor, voiceAttrs } from '../lib/narration';
import { isSideways, sceneAttr, sceneOf } from '../lib/scene';
import { eventPath, likePath, workPath } from '../lib/links';

/**
 * A PANEL DECK — one full panel holding a sideways deck of cards, each the
 * game's own composition: words in the text column, a SCREEN in the rest,
 * the game's width (`--screen-cols`, `--screen-w`). More Work is one
 * (WorkCarousel), Events another (EventsDeck); a panel of the page that
 * is a list of things is this, so they cannot drift apart.
 *
 * EVERY SCREEN IS 3:2 — one size for every card on the page (Juan,
 * 2026-10-02: two sizes read as two systems, and the larger one won). A
 * landing is a plain 1440 x 960 browser screenshot, untouched: whatever
 * the page shows at that height, a section cut off at the foot included.
 * Event photos — a phone's, upright — stand two to a frame, 3:4 each.
 * An event's VIDEO (a phone's too, silent) is one turn of the RIGHT
 * frame, its last, and holds it until it ends (Juan, 2026-10-11: shown
 * all the time, it read as the card's only picture); beside one photo it
 * IS the right frame, looping. Every picture keeps its own aspect ratio —
 * whole, over a blur of itself, never cropped to the frame (Juan,
 * 2026-10-11, and again 2026-10-27: filling the frame lost the blur); a
 * click opens it in the viewer (PhotoViewer), in one fixed frame too.
 *
 * The deck is the page's one deck (lib/deck.ts): ENDLESS, one card on
 * stage, and a turn that brings the screen in first and the words after
 * it. It turns by its arrows, dots, keys, and a finger's swipe.
 *
 * NARRATION: one clip per card, on its body paragraph, and ONE narrator
 * that does not travel with the deck — the cards slide UNDER it. It parks
 * one step under the current card's links, the way a story's narrator
 * parks under its caption, so it rises and falls with how much the card
 * says. Turning the deck while the voice runs plays the new card's clip;
 * a clip ending turns the deck to the next card.
 */

export type { DeckItem, Media, Rich, Segment } from '../lib/deck-items';
import type { DeckItem, Media } from '../lib/deck-items';

type Props = {
  id: string;
  /** The panel's eyebrow. */
  title: UIKey;
  items: DeckItem[];
  /** The card a shared address opens (lib/links): the panel then stands
   *  over the page as a modal, on that card alone. */
  focus?: string;
  /** Whose addresses the cards' Copy Link gives (lib/links). */
  share: 'work' | 'events' | 'likes';
  /** The card the deck starts on, in the page (not as a modal): a page
   *  that is the deck, opened at one card (pages/things-i-like). */
  start?: string;
};

const { id, title, items, focus, share, start } = Astro.props;
const pathOf = (p: DeckItem) =>
  share === 'events' ? eventPath(p) : share === 'likes' ? likePath(p) : workPath(p);
const focusCard = focus ? items.findIndex(p => p.id === focus) : -1;
const startCard = Math.max(0, start ? items.findIndex(p => p.id === start) : focusCard);
// A card's name for attributes, where a translation cannot follow the
// page's language: the English one.
const plainName = (p: DeckItem) => (typeof p.name === 'string' ? p.name : ui.en[p.name.k]);

const isVideo = (m: Media) => m.endsWith('.mp4');
// A video lights the page, stands before it plays, and blurs behind
// itself by its poster.
const still = (m: Media) => m.replace(/\.mp4$/, '.jpg');

// Which pictures are SIDEWAYS: read off each file at build time (a
// video by its poster), so a frame can alternate upright and sideways.
const wide = new Set<Media>();
for (const p of items)
  if (Array.isArray(p.image))
    for (const m of p.image) if (await isSideways(still(m))) wide.add(m);

// The frames of a card whose screen is photos: three pictures or fewer
// take ONE frame, one at a time (two frames of one picture each read as
// static, Juan, 2026-10-11); more take two. A card lists its videos and
// its photos each by what matters most — the ones Juan is in longest
// first (Juan, 2026-10-27). Every frame ALTERNATES photo and video (video
// after video read as a reel), the two frames crossed — the left opens on
// a photo, the right on a video — so one stands still while the other
// moves; when one kind runs out, the other fills the rest.
//
// SHAPES ALTERNATE TOO (Juan, 2026-10-27): upright after sideways down a
// frame, and the two frames unlike each other at the same turn — a
// sideways photo beside a sideways video read as repetitive. With two
// shapes there are few enough ways to lay a card out (2^n, 4,096 for a
// twelve) to try them all: the layout with the fewest repeats wins, and
// among those the one that moves pictures least from their importance.
// Each kind then fills its slots of each shape in its own order.
const columns = (p: DeckItem): Media[][] => {
  const all = p.image as Media[];
  const photos = all.filter(m => !isVideo(m));
  const videos = all.filter(isVideo);
  // A card that says where its frames split keeps its own order: the
  // first `split` pictures run the left frame, the rest the right.
  if (p.split && all.length > 3 && !p.wide)
    return [all.slice(0, p.split), all.slice(p.split)];
  const count = all.length <= 3 || p.wide ? 1 : 2;

  // The slots, turn by turn: which frame, which turn, which kind.
  type Slot = { f: number; k: number; photo: boolean };
  const slots: Slot[] = [];
  let left = { photo: photos.length, video: videos.length };
  for (let k = 0; left.photo + left.video > 0; k++)
    for (let f = 0; f < count && left.photo + left.video > 0; f++) {
      const want = (k % 2 === 0) === (f === 0);
      const photo = want ? left.photo > 0 : left.video === 0;
      slots.push({ f, k, photo });
      if (photo) left.photo--;
      else left.video--;
    }

  const sideways = (ms: Media[]) => ms.filter(m => wide.has(m)).length;
  const need = { photo: sideways(photos), video: sideways(videos) };
  const n = slots.length;
  let best: { mask: number; repeats: number; moved: number } | undefined;
  // Too many to try (a long list on one frame): keep the given order.
  if (n <= 14)
    for (let mask = 0; mask < 1 << n; mask++) {
      // As many sideways slots of each kind as there are sideways pictures.
      let ph = 0;
      let vi = 0;
      for (let i = 0; i < n; i++)
        if (mask & (1 << i)) slots[i].photo ? ph++ : vi++;
      if (ph !== need.photo || vi !== need.video) continue;
      const shapeOf = (i: number) => (mask >> i) & 1;
      let repeats = 0;
      for (let i = 0; i < n; i++)
        for (let j = i + 1; j < n; j++) {
          const a = slots[i];
          const b = slots[j];
          // The same frame, one turn apart; or the two frames at one turn.
          const near = (a.f === b.f && b.k === a.k + 1) || (a.k === b.k && a.f !== b.f);
          if (near && shapeOf(i) === shapeOf(j)) repeats++;
        }
      // How far each picture lands from its place in its kind's order.
      let moved = 0;
      const seen = { photo: [0, 0], video: [0, 0] };
      const order = { photo: [] as number[], video: [] as number[] };
      for (let i = 0; i < n; i++) order[slots[i].photo ? 'photo' : 'video'].push(i);
      for (const kind of ['photo', 'video'] as const) {
        const list = kind === 'photo' ? photos : videos;
        const byShape = [list.filter(m => !wide.has(m)), list.filter(m => wide.has(m))];
        order[kind].forEach((slot, place) => {
          const shape = shapeOf(slot);
          const m = byShape[shape][seen[kind][shape]++];
          moved += Math.abs(place - list.indexOf(m));
        });
      }
      if (!best || repeats < best.repeats || (repeats === best.repeats && moved < best.moved))
        best = { mask, repeats, moved };
    }

  const frames: Media[][] = Array.from({ length: count }, () => []);
  const queues = {
    photo: [photos.filter(m => !wide.has(m)), photos.filter(m => wide.has(m))],
    video: [videos.filter(m => !wide.has(m)), videos.filter(m => wide.has(m))],
  };
  slots.forEach((slot, i) => {
    const kind = slot.photo ? 'photo' : 'video';
    const list = kind === 'photo' ? photos : videos;
    const m = best
      ? queues[kind][(best.mask >> i) & 1].shift()!
      : list.find(x => !frames.flat().includes(x))!;
    frames[slot.f].push(m);
  });
  return frames;
};

// Screens of their own (the game's), rendered from the named slots.
const slotted: Record<string, string> = {};
for (const p of items)
  if (typeof p.image === 'object' && !Array.isArray(p.image))
    slotted[p.image.slot] = await Astro.slots.render(p.image.slot);
const voiced = items.some(p => clipFor(p.clip));

// The light each card lends the page (lib/scene).
const scenes = await Promise.all(
  items.map(p => {
    const src =
      typeof p.image === 'string'
        ? still(p.image)
        : Array.isArray(p.image)
          ? p.image.map(still)
          : p.scene;
    return src ? sceneOf(src).then(sceneAttr) : undefined;
  })
);
// THE VIEWER (PhotoViewer): a click on a frame opens its card's pictures
// whole, at full size — every one, in the card's own order, a thumbnail
// (`-thumb.webp`) by its full picture, with its caption.
const viewerOf = (p: DeckItem) =>
  JSON.stringify(
    (p.image as Media[]).map((m, i) => ({
      src: m.replace(/-thumb\.webp$/, '.webp'),
      name: p.captions?.[i] ?? plainName(p),
      video: isVideo(m) || undefined,
    }))
  );

// ...and each event photo its own: two cycle in a frame, so the light
// follows the ones showing instead of the card's average.
const photoScenes: Record<string, string> = {};
for (const p of items)
  if (Array.isArray(p.image) && p.image.length > 1)
    for (const m of p.image) photoScenes[m] = sceneAttr(await sceneOf(still(m)));
---

<section
  class="panel-deck"
  id={id}
  data-narr-panel={voiced ? '' : null}
  data-focused={focusCard >= 0 ? '' : null}
  data-focus-lone={focusCard >= 0 ? '' : null}
  data-focus-card={focusCard >= 0 ? focusCard : null}
  data-start-card={startCard > 0 ? startCard : null}
>
  <!-- An eyebrow, not a headline: the stars above open on big titles and
       air; a panel like this is secondary, and a headline plus an intro
       line stacked over the card is what made it read cramped. -->
  <h2 class="inner label eyebrow">
    <T k={title} />
  </h2>

  <div
    class="carousel"
    data-panel-deck
    tabindex="0"
    aria-roledescription="carousel"
    aria-label={id}
  >
    <!-- Every card in ONE grid cell: the stage is as tall as the tallest
         card. The entrance (data-reveal) is the STAGE's, not the
         carousel's: a reveal moves its element by transform, and a
         transformed ancestor captures a fixed child — the docked controls
         stood off their place and jumped on a phone's first pass, until
         the reveal ended. -->
    <div class="stage" data-reveal>
      {
        items.map((p, i) => (
          <article
            class="card deck-card"
            aria-roledescription="slide"
            aria-label={`${i + 1} / ${items.length}`}
            data-card={p.id}
            data-scene={scenes[i]}
          >
            <div class="words">
              <h3 class="name" data-deck-part="text" style="--i: 1">
                {typeof p.name === 'string' ? p.name : <T k={p.name.k} />}<CopyLink path={pathOf(p)} />
              </h3>
              <p class="label meta" data-deck-part="text" style="--i: 2">
                {p.meta.map((group, g) => (
                  <>
                    {g > 0 && ' · '}
                    {group.map((part, n) => (
                      <>
                        {n > 0 && ' – '}
                        {typeof part === 'string' ? part : <T k={part.k} />}
                      </>
                    ))}
                  </>
                ))}
              </p>
              <p
                class="body"
                data-deck-part="text"
                style="--i: 3"
                data-cap
                data-cap-phone="6"
                data-narr-para
                {...voiceAttrs(p.clip)}
              >
                {typeof p.body === 'string' ? (
                  <T k={p.body} />
                ) : 'k' in p.body ? (
                  <TL k={p.body.k} links={p.body.links} />
                ) : (
                  <>
                    {/* No whitespace between the three parts: Astro keeps
                        it, and it lands before the comma. */}
                    <T k={p.body.before} /><a
                      href={p.body.href}
                      target="_blank"
                      rel="noopener noreferrer"><T k={p.body.link} /></a
                    ><T k={p.body.after} />
                  </>
                )}
              </p>
              {p.links.length > 0 && (
                <ul class="links" data-deck-part="text" style="--i: 4">
                  {p.links.map(link => (
                    <li>
                      <a href={link.href} target="_blank" rel="noopener noreferrer">
                        {typeof link.label === 'string' ? link.label : <T k={link.label.k} />}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
              {/* The narrator's place, kept EMPTY: it reserves the pill's
                  box under the links, and the still anchor below moves to
                  whichever card's slot is in front. */}
              {voiced && <div class="narr-slot" aria-hidden="true" />}
            </div>
            {typeof p.image === 'object' && !Array.isArray(p.image) ? (
              <div class="screen is-own" data-deck-part="picture">
                {/* A phone's name and facts, ON the picture (the CSS). */}
                <div class="screen-caption" aria-hidden="true">
                  <span class="cap-name">
                    {typeof p.name === 'string' ? p.name : <T k={p.name.k} />}<CopyLink path={pathOf(p)} decorative />
                  </span>
                  <span class="label cap-meta">
                    {/* Thin spaces round the separators: on the picture the
                        facts read as one short tag, not spread across it. */}
                    {p.meta.map((group, g) => (
                      <>
                        {g > 0 && '\u2009·\u2009'}
                        {group.map((part, n) => (
                          <>
                            {n > 0 && '\u2009–\u2009'}
                            {typeof part === 'string' ? part : <T k={part.k} />}
                          </>
                        ))}
                      </>
                    ))}
                  </span>
                </div>
                <Fragment set:html={slotted[p.image.slot]} />
              </div>
            ) : typeof p.image === 'string' ? (
              <div class="screen" data-deck-part="picture">
                {/* A phone's name and facts, ON the picture (the CSS). */}
                <div class="screen-caption" aria-hidden="true">
                  <span class="cap-name">
                    {typeof p.name === 'string' ? p.name : <T k={p.name.k} />}<CopyLink path={pathOf(p)} decorative />
                  </span>
                  <span class="label cap-meta">
                    {/* Thin spaces round the separators: on the picture the
                        facts read as one short tag, not spread across it. */}
                    {p.meta.map((group, g) => (
                      <>
                        {g > 0 && '\u2009·\u2009'}
                        {group.map((part, n) => (
                          <>
                            {n > 0 && '\u2009–\u2009'}
                            {typeof part === 'string' ? part : <T k={part.k} />}
                          </>
                        ))}
                      </>
                    ))}
                  </span>
                </div>
                {p.visit ? (
                  // Out of the tab order and hidden from readers: the
                  // words already carry this link, once.
                  <a
                    class="visit"
                    href={p.visit}
                    target="_blank"
                    rel="noopener noreferrer"
                    tabindex="-1"
                    aria-hidden="true"
                  >
                    {isVideo(p.image) ? (
                      // The site being scrolled, silent: it plays from its
                      // start while its card is in front (the script below).
                      <video
                        class="capture"
                        src={p.image}
                        poster={still(p.image)}
                        width="1440"
                        height="960"
                        muted
                        loop
                        playsinline
                        preload="none"
                        disablepictureinpicture
                      />
                    ) : (
                      <img
                        src={p.image}
                        alt=""
                        width="1440"
                        height="960"
                        loading="lazy"
                        decoding="async"
                        draggable="false"
                      />
                    )}
                  </a>
                ) : (
                  <img
                    src={p.image}
                    alt={plainName(p)}
                    width="1440"
                    height="960"
                    loading="lazy"
                    decoding="async"
                    draggable="false"
                  />
                )}
              </div>
            ) : (
              <div
                class:list={['screen is-photos', p.wide && 'is-wide']}
                data-deck-part="picture"
                data-frames={columns(p).length}
                data-viewer-items={viewerOf(p)}
                data-shuffle={p.shuffle ? '' : null}
              >
                {/* A phone's name and facts, ON the picture (the CSS). */}
                <div class="screen-caption" aria-hidden="true">
                  <span class="cap-name">
                    {typeof p.name === 'string' ? p.name : <T k={p.name.k} />}<CopyLink path={pathOf(p)} decorative />
                  </span>
                  <span class="label cap-meta">
                    {/* Thin spaces round the separators: on the picture the
                        facts read as one short tag, not spread across it. */}
                    {p.meta.map((group, g) => (
                      <>
                        {g > 0 && '\u2009·\u2009'}
                        {group.map((part, n) => (
                          <>
                            {n > 0 && '\u2009–\u2009'}
                            {typeof part === 'string' ? part : <T k={part.k} />}
                          </>
                        ))}
                      </>
                    ))}
                  </span>
                </div>
                {/* Event pictures: one or two frames, each cycling through
                    its share (the script below) — three across read as a
                    contact sheet. Each picture stands whole over a still
                    blur of itself, so a sideways photo or a video keeps
                    its shape and every event card is the same size. */}
                {columns(p).map((layers, c) => (
                  // A click on a frame opens its picture whole (PhotoViewer);
                  // a frame with more than one picture turns by its own
                  // arrows too, so a person goes through them at their own
                  // pace (Juan, 2026-10-13; the viewer, 2026-10-27).
                  <div class:list={['photo-cell', layers.length > 1 && 'is-turnable']} data-col={c}>
                    {layers.map((m, k) => {
                      const at = (p.image as Media[]).indexOf(m);
                      // Past the first two of a frame, a picture waits for
                      // its turn to come near (the script): a set of 31
                      // would otherwise fetch all 31.
                      const src = k < 2 ? still(m) : undefined;
                      const later = k < 2 ? undefined : still(m);
                      return (
                        <div
                          class:list={['layer', k === 0 && 'is-on']}
                          data-scene-photo={photoScenes[m]}
                          data-at={at}
                          data-wide={wide.has(m) ? '' : null}
                        >
                          <img class="fill" src={src} data-src={later} alt="" aria-hidden="true" loading="lazy" decoding="async" />
                          {isVideo(m) ? (
                            // Silent by construction: the file carries no
                            // audio track. It plays only while its card is
                            // in front and on screen (the script below).
                            <video
                              class="whole"
                              src={m}
                              poster={still(m)}
                              aria-label={plainName(p)}
                              muted
                              loop={layers.length === 1}
                              playsinline
                              preload="none"
                              disablepictureinpicture
                            />
                          ) : (
                            <img
                              class="whole"
                              src={src}
                              data-src={later}
                              alt={k === 0 ? plainName(p) : ''}
                              loading="lazy"
                              decoding="async"
                              draggable="false"
                            />
                          )}
                          {p.captions?.[at] && <span class="photo-cap">{p.captions[at]}</span>}
                        </div>
                      );
                    })}
                    <button type="button" class="photo-open" data-photo-open>
                      <span class="sr"><T k="photo.open" /></span>
                    </button>
                    {layers.length > 1 && (
                      <>
                        <button type="button" class="photo-step prev" data-photo-step="-1">
                          <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true">
                            <path d="M10 3 L5 8 L10 13" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                          </svg>
                          <span class="sr"><T k="deck.prev" /></span>
                        </button>
                        <button type="button" class="photo-step next" data-photo-step="1">
                          <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true">
                            <path d="M6 3 L11 8 L6 13" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                          </svg>
                          <span class="sr"><T k="deck.next" /></span>
                        </button>
                      </>
                    )}
                  </div>
                ))}
              </div>
            )}
          </article>
        ))
      }
    </div>

    {/* The one narrator's anchor, OUTSIDE the deck: it does not slide
        with the cards. The script stands it on the current card's slot. */}
    {
      voiced && (
        <div class="inner narr-static">
          <div class="narr-anchor" data-narr-anchor aria-hidden="true" />
        </div>
      )
    }

    {/* One card turns nowhere: no controls until there are two. */}
    {
      items.length > 1 && (
        <div class="inner controls" data-dock>
          <DeckControls names={items.map(plainName)} />
        </div>
      )
    }
  </div>
</section>

<style>
  /* One full panel, snapped like the rest. The section carries no side
     padding: the carousel runs edge to edge, and `.inner` blocks take the
     page's gutter themselves. */
  .panel-deck {
    --gutter: clamp(1.25rem, 4vw, 2.5rem);
    /* A card is exactly the content column — the same box the game's
       grid uses — so its screen lands where the game's screen did. */
    --card-w: min(var(--content-max), calc(100vw - var(--gutter) * 2));
    min-height: 100svh;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    display: flex;
    flex-direction: column;
    /* Top-aligned on the stories' own inset, not centred: centring is
       what stood it 108px lower than every story above it. */
    padding: var(--stage-top) 0 var(--stage-bottom);
    /* The page's edge is the only edge a card slides past. */
    overflow-x: clip;
  }

  .inner {
    width: var(--card-w);
    margin: 0 auto;
  }

  /* The eyebrow stands where a story's small lockup stands, in the same
     2rem box, so the card's name lands on a slide title's line. */
  .eyebrow {
    display: flex;
    align-items: center;
    height: 2rem;
  }

  /* One step under the links — the 1.5rem every narrated block gives
     its narrator. */
  .narr-slot {
    flex: none;
    height: var(--narrator-h);
    margin-top: 1.5rem;
  }

  /* Laid over the stage, in the words' column; the anchor inside rides
     down to the current card's slot and eases there when the card
     changes, so the narrator rises and falls instead of jumping. */
  .carousel {
    position: relative;
  }

  .narr-static {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    pointer-events: none;
  }

  .narr-static .narr-anchor {
    margin-top: 0;
    transform: translateY(var(--slot-y, 0px));
    transition: transform var(--dur-turn) var(--ease);
  }

  @media (prefers-reduced-motion: reduce) {
    .narr-static .narr-anchor {
      transition: none;
    }
  }

  /* ---------- the carousel ---------- */

  /* The carousel takes the rest of the panel, so its controls can stand
     at the panel's foot. */
  .carousel {
    flex: 1;
    display: flex;
    flex-direction: column;
    margin-top: 1.5rem;
    outline: none;
  }

  /* A finger swipes it sideways; the browser keeps the vertical pan. */
  .stage {
    touch-action: pan-y;
    display: grid;
    justify-items: center;
  }

  /* The game's grid, card by card. Positions are the script's: each card
     sits at its offset from the current one, a card's width plus a gap
     apart. Neighbours step back so the current card is the one read. */
  .card {
    display: grid;
    grid-template-columns: var(--screen-cols);
    gap: var(--column-gap);
    align-items: start;
    /* The screen leans toward the pointer (lib/tilt). */
    perspective: 1600px;
  }


  /* The stories' caption rhythm: name, then its line of facts tight
     under it, then the body one 1.25rem step down, the links one more,
     and the narrator the 1.5rem every narrated block gives it. */
  .words {
    display: flex;
    flex-direction: column;
  }

  .meta {
    margin-top: 0.5rem;
  }

  .links {
    margin-top: 1.25rem;
  }

  /* The body is a ten-line box (global.css `[data-cap]`), which takes the
     step above it as a variable. */
  .words .body {
    --cap-gap: 1.25rem;
  }

  /* A step below the stars' titles — this panel is secondary. */
  /* The Copy Link glyph rides at the end of the name (CopyLink). */
  .name :global(.copy-link),
  .cap-name :global(.copy-link) {
    margin-left: 0.25rem;
  }

  /* The caption lets touches through to the picture; its glyph takes them. */
  .cap-name :global(.copy-link) {
    pointer-events: auto;
  }

  .name {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    font-weight: 800;
    letter-spacing: var(--track-heading);
    line-height: 1.05;
  }

  .meta,
  .cap-meta {
    text-transform: none;
    letter-spacing: 0;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    padding: 0;
    list-style: none;
    font-size: 0.875rem;
  }

  .links a {
    color: var(--ink);
  }

  /* The game's screen width, at the page's one 3:2. */
  .screen {
    width: var(--screen-w);
    justify-self: center;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border: 1px solid var(--hairline);
    /* Half the stories' phone corner — a flat picture's (global.css). */
    border-radius: var(--media-radius-flat);
    background: var(--surface);
    box-shadow:
      0 2rem 4rem rgba(0, 0, 0, 0.55),
      0 0.5rem 1.25rem rgba(0, 0, 0, 0.4);
  }

  .screen img,
  .screen .capture {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: top;
  }


  /* The pointer tilt — every screen, the game's cabinet included. */
  .screen {
    rotate: var(--tilt-rot, none);
  }

  /* A screen of its own (the game's cover): it places itself. */
  .screen.is-own {
    position: relative;
  }

  /* EVENT PHOTOS: the screen's own 3:2 frame — one, or two upright 3:4
     columns side by side. */
  .screen.is-photos {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3px;
    background: var(--ground);
  }

  .screen.is-photos[data-frames='1'] {
    grid-template-columns: 1fr;
  }

  /* A phone's event frame is one big picture rather than two small ones
     side by side (the script folds them): upright 4:5, so a 3:4 photo
     nearly fills it — square on a short phone, where 4:5 would run the
     words under the docked controls. (4:5 did that at 844pt while the
     words ran ten lines; at six they clear it.) */
  @media (max-width: 48rem) {
    .screen.is-photos {
      aspect-ratio: 4 / 5;
    }
  }

  @media (max-width: 48rem) and (max-height: 50rem) {
    .screen.is-photos {
      aspect-ratio: 1;
    }
  }

  .photo-cell {
    position: relative;
    overflow: hidden;
  }

  /* The whole frame opens its picture in the viewer: a bare button over
     the pictures. */
  .photo-open {
    position: absolute;
    inset: 0;
    z-index: 1;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }

  /* A frame's own arrows, at its sides over the picture: the deck's own
     arrows (DeckControls) — the header's pill recipe as a circle — a step
     smaller, and QUIET (Juan, 2026-10-27): faint while the eye is on the
     picture elsewhere, clearer with the pointer on the frame, full on the
     arrow itself. A click on the picture opens all of them anyway. */
  .photo-step {
    position: absolute;
    top: 50%;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface) 82%, transparent);
    color: var(--ink);
    cursor: pointer;
    opacity: 0.3;
    transform: translateY(-50%);
    transition:
      opacity var(--dur-micro) var(--ease),
      border-color var(--dur-micro) var(--ease);
  }

  .photo-cell:hover .photo-step {
    opacity: 0.7;
  }

  .photo-cell .photo-step:hover,
  .photo-step:focus-visible {
    opacity: 1;
    border-color: var(--ink-3);
  }

  .photo-step.prev {
    left: 0.75rem;
  }

  .photo-step.next {
    right: 0.75rem;
  }

  /* A picture's own caption (its name), at the top of the frame — the
     header's pill recipe, in the label's type; a phone's card caption
     takes the foot. */
  .photo-cap {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    max-width: calc(100% - 1.5rem);
    overflow: hidden;
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface) 82%, transparent);
    backdrop-filter: blur(12px);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  /* Sideways pictures keep the page's 3:2 everywhere, phones included:
     a tall frame would only add blur above and below them. */
  .screen.is-photos.is-wide {
    aspect-ratio: 3 / 2;
  }

  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .visit {
    display: block;
    cursor: pointer;
  }

  /* Each picture is a layer: whole, centred, over a still blur of
     itself. The layer showing is `.is-on`; the hand-over is a cross-fade
     at the ladder's `settle` (2026-10-13 — two beats read as slow). */
  .layer {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity var(--dur-settle) linear;
  }

  .layer.is-on {
    opacity: 1;
  }

  /* A shuffled frame stays blank until its pictures are dealt (the
     script), so the first one never flashes before the new order. */
  .screen[data-shuffle]:not([data-shuffled]) .layer {
    opacity: 0;
  }

  .layer .fill,
  .layer .whole {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
  }

  .layer .fill {
    object-fit: cover;
    transform: scale(1.2);
    filter: blur(28px) brightness(0.55);
  }

  /* Whole and centred both ways: `.screen img` stands a site's capture
     at its top, and that stood a short photo or a tall painting against
     the frame's upper edge (Juan, 2026-10-27). */
  .layer .whole {
    object-fit: contain;
    object-position: center;
  }

  .layer .fill {
    object-position: center;
  }

  /* ---------- controls ---------- */

  /* At the panel's FOOT and centred — the way the Sound Shaper opener
     centres its narrator under everything — not tucked under the words,
     where it crowded the narrator on every card with a full paragraph. */
  .controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: auto;
    padding-top: var(--gap-block);
  }

  /* A phone's caption on the picture (below); a desk keeps its words
     beside it. */
  .screen-caption {
    display: none;
  }

  /* ---------- phones ---------- */

  @media (max-width: 48rem) {
    /* Screen on top, words under it, one centred column (Juan,
       2026-10-05). Every card shares ONE grid cell, so the cell is the
       tallest card's height; without `align-content: start` that spare
       height went into the rows and stood each card's words a different
       distance under its screen (16, 28 and 53px measured in More Work). */
    /* A hair between the picture and the words: the words' box brings
       its own fade's depth of air (global.css `[data-cap]`), so words
       scrolled up never fade onto the picture. */
    .card {
      grid-template-columns: 1fr;
      align-content: start;
      gap: 0.25rem;
    }

    /* Over the screen, which now stands ABOVE the words but still comes
       after them in the source — so it painted later, and its contact
       shadow (2rem down, 4rem blur) lay over the name and the first line,
       dimming a #f5f5f5 title to ~#d9d9d9 (measured). */
    .words {
      position: relative;
      z-index: 1;
    }

    .screen {
      order: -1;
      width: 100%;
      box-shadow:
        var(--media-glow),
        0 2rem 4rem rgba(0, 0, 0, 0.55),
        0 0.5rem 1.25rem rgba(0, 0, 0, 0.4);
      /* The deck's cross-fade restated (global.css `.deck-card`): this
         list REPLACES it, and without its opacity a phone's picture
         popped in while the words faded (2026-10-13). */
      transition:
        opacity var(--dur-quick) linear,
        box-shadow var(--dur-ambient) var(--ease);
    }

    .words .body {
      font-size: 1rem;
      line-height: 1.55;
    }

    /* A phone's caption steps: the name and its facts tight (0.5rem),
       then each group one 1rem step — the 1.25rem a wide card uses read
       as a gap under the facts' small mono line. */
    .links {
      margin-top: 1rem;
    }

    .name {
      font-size: 1.5rem;
    }

    /* THE NAME AND ITS FACTS GO ON THE PICTURE (Juan, 2026-10-13): a
       caption along its foot over a dark fade, so the words under it
       start straight at the paragraph and a phone's height goes to the
       picture. The words' own name and facts stay for readers, unseen. */
    .screen {
      position: relative;
    }

    .screen-caption {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 2;
      display: flex;
      flex-direction: column;
      gap: 0.125rem;
      padding: 2.75rem 0.875rem 0.75rem;
      /* Dark enough to read on any picture — a bright site or a white
         wall — on an EASED ramp (a scrim curve, slow at both ends): a
         straight or short ramp shows where it starts as a hard line, which
         reads cheap (Juan, 2026-10-13). */
      background: linear-gradient(
        to bottom,
        rgb(0 0 0 / 0.0) 0%,
        rgb(0 0 0 / 0.012) 8.1%,
        rgb(0 0 0 / 0.044) 15.5%,
        rgb(0 0 0 / 0.094) 22.5%,
        rgb(0 0 0 / 0.158) 29%,
        rgb(0 0 0 / 0.233) 35.3%,
        rgb(0 0 0 / 0.317) 41.2%,
        rgb(0 0 0 / 0.405) 47.1%,
        rgb(0 0 0 / 0.495) 52.9%,
        rgb(0 0 0 / 0.583) 58.8%,
        rgb(0 0 0 / 0.667) 64.7%,
        rgb(0 0 0 / 0.742) 71%,
        rgb(0 0 0 / 0.806) 77.5%,
        rgb(0 0 0 / 0.856) 84.5%,
        rgb(0 0 0 / 0.888) 91.9%,
        rgb(0 0 0 / 0.9) 100%
      );
      pointer-events: none;
    }

    .cap-name {
      font-size: 1.125rem;
      font-weight: 800;
      letter-spacing: var(--track-heading);
      line-height: 1.1;
      color: #fff;
    }

    .cap-meta {
      font-size: 0.6875rem;
      color: rgb(255 255 255 / 0.72);
    }

    .words .name,
    .words .meta {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    /* The paragraph is the words' first line now: the card's own gap
       under the picture is its step. */
    .words .body {
      --cap-gap: 0px;
    }

    /* The eyebrow sits close over the picture it names. */
    .carousel {
      margin-top: 0.75rem;
    }
  }

  /* ---------- phone ----------
     The whole narrated paragraph, as on a desk — a phone is narrated too
     (Juan, 2026-10-13; it showed a shorter line of its own until then).
     The narrator sits in its corner there, so no card keeps a slot for it
     and no anchor rides over the deck. */
  @media (max-width: 48rem) {
    /* The deck's controls share the bottom row with the phone's corner
       narrator: arrows to the left, narrator to the right. */
    /* Docked beside the narrator (data-dock, global.css): as wide as
       the controls, so the box never lies over the narrator's own tap. */
    .controls {
      width: auto;
      margin-top: 0;
      padding-top: 0;
    }

    .narr-slot,
    .narr-static {
      display: none;
    }
  }
</style>

<script>
  import { createDeck, watchSlots } from '../lib/deck';
  import { followPointer } from '../lib/tilt';
  import { dur } from '../lib/motion';

  // Every panel deck on the page (More Work, Events) — one script for all.
  for (const carousel of document.querySelectorAll<HTMLElement>('[data-panel-deck]')) {
    // The deck's own cards only: a card's screen may hold a `.card` of its
    // own (the Songs player's Shape form), which is not one to turn to.
    const cards = [...carousel.querySelectorAll<HTMLElement>('.deck-card')];

    // ONE FRAME ON A PHONE (Juan, 2026-10-13): two upright columns across
    // a phone's width stood each photo about 195 x 260 — too small for
    // pictures taken on a camera. A phone folds them into one tall frame
    // (the CSS), alternating photo and video the way a desk's frames do,
    // each kind in the order the card lists it.
    if (matchMedia('(max-width: 48rem)').matches)
      for (const screen of carousel.querySelectorAll<HTMLElement>('.screen.is-photos')) {
        const [left, right] = [...screen.querySelectorAll<HTMLElement>('.photo-cell')];
        if (!left || !right) continue;
        const byAt = (a: HTMLElement, b: HTMLElement) =>
          Number(a.dataset.at ?? 0) - Number(b.dataset.at ?? 0);
        const layers = [...screen.querySelectorAll<HTMLElement>('.layer')];
        const photoLayers = layers.filter(l => !l.querySelector('video')).sort(byAt);
        const videoLayers = layers.filter(l => l.querySelector('video')).sort(byAt);
        // As a desk's frames deal them (`columns` above): photo and video
        // by turns, upright and sideways by turns where it can.
        const all: HTMLElement[] = [];
        const take = (queue: HTMLElement[]) => {
          const last = all.at(-1);
          const i = last
            ? queue.findIndex(l => l.hasAttribute('data-wide') !== last.hasAttribute('data-wide'))
            : 0;
          return queue.splice(i < 0 ? 0 : i, 1)[0];
        };
        for (let k = 0; photoLayers.length || videoLayers.length; k++) {
          const mine = k % 2 === 0 ? photoLayers : videoLayers;
          all.push(take(mine.length ? mine : k % 2 === 0 ? videoLayers : photoLayers));
        }
        all.forEach((layer, i) => layer.classList.toggle('is-on', i === 0));
        // The layers go under the frame's own buttons, which stay on top.
        left.prepend(...all);
        if (!left.querySelector('[data-photo-step]'))
          left.append(...right.querySelectorAll('[data-photo-step]'));
        // The first two of the folded frame are loaded at once.
        for (const layer of all.slice(0, 2))
          for (const img of layer.querySelectorAll<HTMLImageElement>('img[data-src]')) {
            img.src = img.dataset.src!;
            img.removeAttribute('data-src');
          }
        right.remove();
        screen.dataset.frames = '1';
      }
    // A NEW ORDER EVERY VISIT for a set that is loved whole (`shuffle`):
    // the frame's pictures, and the viewer's with them, are dealt again
    // before the first one shows (the CSS holds the frame blank till then).
    for (const screen of carousel.querySelectorAll<HTMLElement>('.screen[data-shuffle]')) {
      const cell = screen.querySelector<HTMLElement>('.photo-cell');
      if (!cell) continue;
      const layers = [...cell.querySelectorAll<HTMLElement>('.layer')];
      for (let i = layers.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [layers[i], layers[j]] = [layers[j], layers[i]];
      }
      const items = JSON.parse(screen.dataset.viewerItems!);
      screen.dataset.viewerItems = JSON.stringify(layers.map(l => items[Number(l.dataset.at)]));
      layers.forEach((l, i) => {
        l.dataset.at = String(i);
        l.classList.toggle('is-on', i === 0);
      });
      cell.prepend(...layers);
      for (const layer of layers.slice(0, 2))
        for (const img of layer.querySelectorAll<HTMLImageElement>('img[data-src]')) {
          img.src = img.dataset.src!;
          img.removeAttribute('data-src');
        }
      screen.toggleAttribute('data-shuffled', true);
    }

    const section = carousel.closest<HTMLElement>('section');
    const paras = cards.map(c => c.querySelector<HTMLElement>('[data-narr-para]'));
    const stillAnchor = carousel.querySelector<HTMLElement>('.narr-static .narr-anchor');

    // Stand the still anchor on the current card's slot. Only the slot's
    // HEIGHT is read: the card's sideways slide never moves it.
    const standAnchor = () => {
      const slot = cards[deck.current].querySelector<HTMLElement>('.narr-slot');
      if (!stillAnchor || !slot) return;
      const y = slot.getBoundingClientRect().top - carousel.getBoundingClientRect().top;
      stillAnchor.style.setProperty('--slot-y', `${y.toFixed(1)}px`);
    };

    // A shared address opens the panel on its card, ALONE: while it is
    // the modal the deck does not turn (lib/links).
    const focusCard = Number(section?.dataset.focusCard ?? section?.dataset.startCard ?? 0);
    const deck = createDeck({
      cards,
      start: focusCard,
      locked: () => !!section?.hasAttribute('data-focus-lone') && section.hasAttribute('data-focused'),
      controls: carousel.querySelector('[data-deck-controls]'),
      keys: carousel,
      swipe: carousel.querySelector<HTMLElement>('.stage'),
      onChange: current => {
        // A frame later: the first call comes while `deck` is still being
        // made.
        requestAnimationFrame(standAnchor);
        // The narrator starts this panel on the card in front (its
        // `data-narr-start`), and a running voice switches to it.
        if (section) {
          section.dataset.narrStart = String(current);
          const para = paras[current];
          if (para)
            document.dispatchEvent(new CustomEvent('narr:select', { detail: para }));
        }
      },
    });

    // An easter egg's link (lib/eggs) asks for one card of this deck.
    document.addEventListener('deck:show', e => {
      const { deck: which, card } = (e as CustomEvent<{ deck: string; card: string }>).detail;
      const i = cards.findIndex(c => c.dataset.card === card);
      if (which === section?.id && i >= 0 && i !== deck.current) deck.go(i);
    });

    // The voice moved on by itself (a clip ended): the deck follows it.
    document.addEventListener('narr:para', e => {
      const i = paras.indexOf((e as CustomEvent<HTMLElement>).detail);
      if (i >= 0 && i !== deck.current) deck.go(i);
    });

    window.addEventListener('resize', standAnchor, { passive: true });
    // Late fonts, a language switch: whatever reflows the words.
    watchSlots(cards, standAnchor);

    // EVENT PICTURES cycle only while their card is in front and the panel
    // HOLDS the screen — its middle line inside it, not a sliver showing at
    // an edge, or the videos ran while the page was still on More Work and
    // were half over on arrival. Every arrival, at the panel or at the
    // card, starts each frame over: its first picture, a video from 0:00
    // (Juan, 2026-10-13). A photo holds ten beats (6s); a video stands on
    // its first frame for two (1.2s), then plays until it ends; and the
    // right frame turns a beat after the left. A video alone in its frame
    // loops. With reduced motion the first picture stands still — a video
    // as its poster.
    const BEAT = dur('settle');
    const still = matchMedia('(prefers-reduced-motion: reduce)');
    let seen = false;
    const frames = cards.map(card =>
      [...card.querySelectorAll<HTMLElement>('.photo-cell')].map(cell => ({
        cell,
        col: Number(cell.dataset.col),
        layers: [...cell.querySelectorAll<HTMLElement>('.layer')],
        i: 0,
        timer: 0,
        running: false,
      }))
    );
    type Frame = (typeof frames)[number][number];
    const videoOf = (f: Frame) => f.layers[f.i].querySelector('video');
    const hold = (f: Frame, wait: number) => {
      clearTimeout(f.timer);
      const v = videoOf(f);
      if (v) {
        v.preload = 'auto';
        // Refused — usually a pause landing before the load (AbortError),
        // or a browser holding autoplay back: try again once the video can
        // play, as long as the frame should still be playing it.
        v.play().catch(() => {
          v.addEventListener(
            'canplay',
            () => {
              if (f.running && videoOf(f) === v) v.play().catch(() => {});
            },
            { once: true }
          );
        });
        if (f.layers.length > 1) v.onended = () => turn(f);
      } else if (f.layers.length > 1) f.timer = window.setTimeout(() => turn(f), wait);
    };
    // A picture past a frame's first two has no src until its turn comes
    // near: the one showing and the one after it are always loaded.
    const wake = (layer?: HTMLElement) => {
      for (const img of layer?.querySelectorAll<HTMLImageElement>('img[data-src]') ?? []) {
        img.src = img.dataset.src!;
        img.removeAttribute('data-src');
      }
    };
    // The next picture fades in once it can be seen — the one in front
    // stays until then (at most 1.2 s) — so a picture still loading never
    // fades in empty and then pops in (Juan, 2026-10-29).
    const step = (f: Frame, by: number) => {
      const n = f.layers.length;
      f.i = (f.i + by + n) % n;
      const next = f.layers[f.i];
      wake(next);
      wake(f.layers[(f.i + 1) % n]);
      let done = false;
      const on = () => {
        if (done || f.layers[f.i] !== next) return;
        done = true;
        for (const layer of f.layers) layer.classList.toggle('is-on', layer === next);
      };
      const waiting = [...next.querySelectorAll('img')].filter(
        img => img.src && !(img.complete && img.naturalWidth),
      );
      if (!waiting.length) return on();
      let left = waiting.length;
      for (const img of waiting)
        img.addEventListener('load', () => --left || on(), { once: true });
      setTimeout(on, 1200);
    };
    const turn = (f: Frame, by = 1) => {
      step(f, by);
      const v = videoOf(f);
      if (v) v.currentTime = 0;
      hold(f, BEAT * 10);
    };
    // A frame's arrows turn it now, whatever it was holding — a photo's
    // beat or a video mid-play — and the next turn counts from here.
    for (const f of frames.flat())
      for (const button of f.cell.querySelectorAll<HTMLElement>('[data-photo-step]'))
        button.addEventListener('click', () => {
          const by = Number(button.dataset.photoStep);
          const v = videoOf(f);
          if (v) {
            v.onended = null;
            v.pause();
          }
          if (f.running) turn(f, by);
          else {
            clearTimeout(f.timer);
            step(f, by);
          }
        });
    // A click on the picture itself opens it whole, with the rest of its
    // card's pictures (PhotoViewer).
    for (const f of frames.flat())
      f.cell.querySelector('[data-photo-open]')?.addEventListener('click', () => {
        const screen = f.cell.closest<HTMLElement>('[data-viewer-items]');
        if (!screen) return;
        document.dispatchEvent(
          new CustomEvent('viewer:open', {
            detail: {
              items: JSON.parse(screen.dataset.viewerItems!),
              at: Number(f.layers[f.i].dataset.at ?? 0),
            },
          })
        );
      });
    const sync = () =>
      frames.forEach((card, i) =>
        card.forEach(f => {
          const on = seen && !document.hidden && i === deck.current && !still.matches;
          if (on === f.running) return;
          f.running = on;
          if (on) {
            // From the top: the first picture, a video at its start.
            f.layers[f.i].classList.remove('is-on');
            f.i = 0;
            f.layers[0].classList.add('is-on');
            const v = videoOf(f);
            if (v) {
              // A VIDEO WAITS ITS TURN (Juan, 2026-10-13): it stands on its
              // first frame while the card fades in and a beat more, then
              // plays — started the instant the panel arrived, it read as
              // already under way, as if it had begun without you.
              v.preload = 'auto';
              v.currentTime = 0;
              clearTimeout(f.timer);
              f.timer = window.setTimeout(() => {
                if (f.running) hold(f, BEAT * 10);
              }, BEAT * 2);
            } else hold(f, BEAT * (10 + f.col));
          } else {
            clearTimeout(f.timer);
            videoOf(f)?.pause();
          }
        })
      );
    // A SITE BEING SCROLLED (a capture recorded as video) plays by the
    // same rule as an event's video: only while its card is in front and
    // the panel holds the screen, from its start, after the same two-beat
    // wait; it loops. With reduced motion it stands as its first frame.
    const captures = cards.map(card => card.querySelector<HTMLVideoElement>('video.capture'));
    const captureTimers: number[] = [];
    const syncCaptures = () =>
      captures.forEach((v, i) => {
        if (!v) return;
        const on = seen && !document.hidden && i === deck.current && !still.matches;
        if (on === !!v.dataset.on) return;
        clearTimeout(captureTimers[i]);
        if (on) {
          v.dataset.on = '1';
          v.preload = 'auto';
          v.currentTime = 0;
          captureTimers[i] = window.setTimeout(() => {
            if (v.dataset.on) v.play().catch(() => {});
          }, BEAT * 2);
        } else {
          delete v.dataset.on;
          v.pause();
        }
      });
    if (section && (frames.some(c => c.length) || captures.some(Boolean))) {
      const both = () => {
        sync();
        syncCaptures();
      };
      new IntersectionObserver(
        ([e]) => {
          seen = e.isIntersecting;
          both();
        },
        // A band round the viewport's middle: the panel holds the screen.
        { rootMargin: '-45% 0px -45% 0px' }
      ).observe(section);
      cards.forEach(c =>
        new MutationObserver(both).observe(c, { attributes: true, attributeFilter: ['aria-hidden'] })
      );
      still.addEventListener('change', both);
      document.addEventListener('visibilitychange', both);
    }

    // WARM IT AHEAD (Juan, 2026-10-13): the panel's pictures are lazy, so
    // the first arrival showed an empty frame while they loaded. Once the
    // page has settled, every picture is fetched in the background — a
    // video's poster among them, which is what stands in its frame first.
    // The VIDEOS are not (2026-10-17): warming every card's first video
    // fetched 12.5 MB before anyone scrolled. A video loads when its card
    // plays it, inside the two beats it stands still anyway.
    if (section) {
      const warmPictures = () => {
        for (const img of section.querySelectorAll<HTMLImageElement>('img[loading="lazy"]'))
          img.loading = 'eager';
      };
      const whenIdle = () =>
        'requestIdleCallback' in window
          ? requestIdleCallback(warmPictures, { timeout: 3000 })
          : setTimeout(warmPictures, 1500);
      if (document.readyState === 'complete') whenIdle();
      else addEventListener('load', whenIdle);
      new IntersectionObserver(
        ([e], io) => {
          if (!e.isIntersecting) return;
          io.disconnect();
          warmPictures();
        },
        { rootMargin: '200% 0px' }
      ).observe(section);
    }

    // The card's screen leans toward the pointer anywhere over the panel.
    if (section)
      followPointer(section, () =>
        cards[deck.current]?.querySelector<HTMLElement>('.screen')
      );
  }
</script>
