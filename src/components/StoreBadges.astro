---
import { locales } from '../i18n/ui';
import T from './T.astro';
import { RELEASES, type ReleasedApp } from '../lib/releases';

/**
 * One app's two badges: the App Store and the web app (no Google Play
 * since 2026-11-04 — the portfolio is iOS and the web only).
 *
 * LIVE (a URL in lib/releases.ts): Apple's OFFICIAL artwork (the web's own lockup, linked),
 * used unmodified from their own asset packs, localized per language the
 * way every other string on the site is — all three ship, CSS shows the
 * one html[data-lang] names.
 *
 * NOT YET (null): a "Coming soon" tag in the LANDING's own language — not
 * a copy of the stores' badges, which their guidelines reserve for real
 * listings. A hairline frame with the site's corner and no fill (so it
 * can't be mistaken for the round, filled narrator), a small status line
 * OVER the store's name — the stores' own badge hierarchy ("Download on
 * the" / "App Store", "GET IT ON" / "Google Play"), where it had been a
 * mono caps label under the name that read too loud and too close (Juan,
 * 2026-10-13) — and a one-ink mark spanning both lines. It keeps the official
 * badge's 48px height, so flipping to live never moves the row. It is not
 * a link and doesn't pretend to be one.
 *
 * Both programs require the badges to run at the SAME HEIGHT beside each
 * other and to keep clear space around them — Apple asks for 1/10 of the
 * badge's height, Google for 1/4, so the gap here is the larger of the
 * two. Official artwork is never recoloured, stretched or redrawn: each
 * SVG carries its own aspect (Apple 119.66x40, Google 238.96x70.87), so
 * only the height is set and the width follows.
 */
type Props = { app: ReleasedApp };

const { app } = Astro.props;

const STORES = [
  { key: 'app-store', name: 'App Store' },
  { key: 'web', name: 'Web' },
] as const;
---

<div class="stores" data-reveal>
  {
    STORES.map(store => {
      const href = RELEASES[app][store.key];
      return href && store.key === 'web' ? (
        <a class="soon web-link" href={href} target="_blank" rel="noopener">
          <svg class="mark globe" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="9.25" />
            <path d="M2.75 12h18.5M12 2.75c2.6 2.6 3.9 5.68 3.9 9.25S14.6 18.65 12 21.25M12 2.75C9.4 5.35 8.1 8.43 8.1 12s1.3 6.65 3.9 9.25" />
          </svg>
          <span class="soon-words">
            <span class="soon-status"><T k="store.web" /></span>
            <span class="soon-name">{store.name}</span>
          </span>
        </a>
      ) : href ? (
        <a class="badge-link" href={href} aria-label={store.name}>
          {locales.map(l => (
            <img
              class="t badge"
              lang={l}
              src={`/media/badges/${store.key}-${l}.svg`}
              alt={store.name}
              height="48"
            />
          ))}
        </a>
      ) : (
        <span class:list={['soon', store.key]}>
          {store.key === 'app-store' ? (
            <svg class="mark" viewBox="9.97 8.72 17.72 21.78" aria-hidden="true">
              <path d="M24.76888,20.30068a4.94881,4.94881,0,0,1,2.35656-4.15206,5.06566,5.06566,0,0,0-3.99116-2.15768c-1.67924-.17626-3.30719,1.00483-4.1629,1.00483-.87227,0-2.18977-.98733-3.6085-.95814a5.31529,5.31529,0,0,0-4.47292,2.72787c-1.934,3.34842-.49141,8.26947,1.3612,10.97608.9269,1.32535,2.01018,2.8058,3.42763,2.7533,1.38706-.05753,1.9051-.88448,3.5794-.88448,1.65876,0,2.14479.88448,3.591.8511,1.48838-.02416,2.42613-1.33124,3.32051-2.66914a10.962,10.962,0,0,0,1.51842-3.09251A4.78205,4.78205,0,0,1,24.76888,20.30068Z" />
              <path d="M22.03725,12.21089a4.87248,4.87248,0,0,0,1.11452-3.49062,4.95746,4.95746,0,0,0-3.20758,1.65961,4.63634,4.63634,0,0,0-1.14371,3.36139A4.09905,4.09905,0,0,0,22.03725,12.21089Z" />
            </svg>
          ) : (
            <svg class="mark globe" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="9.25" />
              <path d="M2.75 12h18.5M12 2.75c2.6 2.6 3.9 5.68 3.9 9.25S14.6 18.65 12 21.25M12 2.75C9.4 5.35 8.1 8.43 8.1 12s1.3 6.65 3.9 9.25" />
            </svg>
          )}
          <span class="soon-words">
            <span class="soon-status"><T k="store.soon" /></span>
            <span class="soon-name">{store.name}</span>
          </span>
        </span>
      );
    })
  }
</div>

<style>
  /* Apple asks for clear space of 1/10 the badge height, Google for
     1/4 — 12px at a 48px badge, so the gap takes the larger rule. */
  .stores {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.875rem;
    margin-top: 1.5rem;
  }

  .badge-link {
    display: inline-flex;
    text-decoration: none;
    border-radius: 0.5rem;
    transition: opacity var(--hover);
  }

  .badge-link:hover {
    opacity: 0.8;
  }

  /* Both badges run at one height; each keeps its own aspect. Which
     language shows is the site's ONE localization mechanism (`.t` in
     global.css), not a second one invented here. */
  .badge {
    height: 3rem;
    width: auto;
    max-width: none;
  }

  /* ---------- coming soon ----------
     The site's vocabulary, not the stores': the hairline every surface
     here wears, a 0.75rem corner (square enough to read as a tag, not as
     one of the page's pills), no fill, and the mono label the section
     eyebrows use for the status. */
  .soon {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    height: 3rem;
    padding: 0 1.125rem 0 1rem;
    border: 1px solid var(--hairline);
    border-radius: 0.75rem;
    color: var(--ink);
    cursor: default;
    user-select: none;
  }

  /* Each mark's viewBox is its paths' MEASURED bounding box (getBBox),
     not an estimate — a guessed one cut the apple's left side off. */
  .mark {
    flex: none;
    height: 1.375rem;
    width: auto;
    fill: currentColor;
  }

  /* The web's mark is a stroked globe, the same ink at the same height. */
  .globe {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
  }

  /* THE WEB APP, LIVE: the same lockup as the tag, as a link — no store
     owns an official badge for it, so it keeps the site's own. */
  .web-link {
    text-decoration: none;
    cursor: pointer;
    transition: border-color var(--hover);
  }

  .web-link:hover {
    border-color: var(--ink-3);
  }

  /* The badges' proportions: the status line a bit over half the name's
     size, in the same face, set tight above it. */
  .soon-words {
    display: flex;
    flex-direction: column;
    gap: 0.1875rem;
    line-height: 1;
    white-space: nowrap;
  }

  .soon-name {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .soon-status {
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--ink-2);
  }
</style>
