---
import { locales } from '../i18n/ui';
import T from './T.astro';

/**
 * The two store badges — Apple's and Google's OFFICIAL artwork, used
 * unmodified from their own asset packs (white "Download on the App
 * Store" lockup for this dark ground; the colour "Get it on Google
 * Play" badge), localized per language the way every other string on
 * the site is: all three ship, CSS shows the one html[data-lang] names.
 *
 * Both programs require the badges to run at the SAME HEIGHT beside
 * each other and to keep clear space around them — Apple asks for 1/10
 * of the badge's height, Google for 1/4, so the gap here is the larger
 * of the two. The artwork is never recoloured, stretched or redrawn:
 * each SVG carries its own aspect (Apple 119.66x40, Google 238.96x70.87),
 * so only the height is set and the width follows.
 *
 * SENTINEL: the hrefs point at google.com because NEITHER APP IS
 * PUBLISHED YET — the same sentinel AUTHOR_URL carries in
 * packages/mobile-ui/src/author.ts. Grep google.com before release;
 * each becomes its real store listing. Note that both programs expect
 * a badge to link to a LIVE listing, so these are for judging the
 * layout, not for shipping.
 */
const APP_STORE_URL = 'https://www.google.com';
const PLAY_STORE_URL = 'https://www.google.com';

const STORES = [
  { key: 'app-store', name: 'App Store', href: APP_STORE_URL, height: 48 },
  { key: 'google-play', name: 'Google Play', href: PLAY_STORE_URL, height: 48 },
];
---

<div class="store-block" data-reveal>
  <span class="label"><T k="stores.soon" /></span>

  <div class="stores">
  {
    STORES.map(store => (
      <a class="badge-link" href={store.href} aria-label={store.name}>
        {locales.map(l => (
          <img
            class="t badge"
            lang={l}
            src={`/media/badges/${store.key}-${l}.svg`}
            alt={store.name}
            height={store.height}
          />
        ))}
      </a>
    ))
  }
  </div>
</div>

<style>
  /* NEITHER APP IS PUBLISHED, so the badges carry a heading that says
     so — the same mono label every other group on the page uses. It
     goes the day the listings go live; the badges stay. */
  .store-block {
    margin-top: 1.5rem;
  }

  /* Apple asks for clear space of 1/10 the badge height, Google for
     1/4 — 12px at a 48px badge, so the gap takes the larger rule, and
     the heading clears them by the same amount. */
  .stores {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.875rem;
    margin-top: 0.875rem;
  }

  .badge-link {
    display: inline-flex;
    text-decoration: none;
    border-radius: 0.5rem;
    transition: opacity var(--dur-micro) var(--ease);
  }

  .badge-link:hover {
    opacity: 0.8;
  }

  /* Both badges run at one height; each keeps its own aspect. Which
     language shows is the site's ONE localization mechanism (`.t` in
     global.css), not a second one invented here. */
  .badge {
    height: 3rem;
    width: auto;
    max-width: none;
  }
</style>
