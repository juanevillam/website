---
import { locales } from '../i18n/ui';

/**
 * The two store badges — Apple's and Google's OFFICIAL artwork, used
 * unmodified from their own asset packs (the black "Download on the
 * App Store" lockup; the colour "Get it on Google Play" badge),
 * localized per language the way every other string on the site is:
 * all three ship, CSS shows the one html[data-lang] names.
 *
 * Both programs require the badges to run at the SAME HEIGHT beside
 * each other and to keep clear space around them — Apple asks for 1/10
 * of the badge's height, Google for 1/4, so the gap here is the larger
 * of the two. The artwork is never recoloured, stretched or redrawn:
 * each SVG carries its own aspect (Apple 119.66x40, Google 238.96x70.87),
 * so only the height is set and the width follows.
 *
 * THEY ARE NOT LINKS, ON PURPOSE. Neither app is published, so there is
 * no listing to point at — a badge that navigates nowhere is worse than
 * one that plainly cannot be pressed. They render dimmed and inert
 * (no href, no hover, out of the tab order, aria-disabled) until the
 * listings exist. To turn them on: give each entry its store URL below
 * and the markup becomes a link again.
 */
const STORES = [
  { key: 'app-store', name: 'App Store', href: null as string | null },
  { key: 'google-play', name: 'Google Play', href: null as string | null },
];

const BADGE_HEIGHT = 48;
---

<div class="stores" data-reveal>
  {
    STORES.map(store =>
      store.href ? (
        <a class="badge-link" href={store.href} aria-label={store.name}>
          {locales.map(l => (
            <img
              class="t badge"
              lang={l}
              src={`/media/badges/${store.key}-${l}.svg`}
              alt={store.name}
              height={BADGE_HEIGHT}
            />
          ))}
        </a>
      ) : (
        <span class="badge-link is-inert" aria-disabled="true">
          {locales.map(l => (
            <img
              class="t badge"
              lang={l}
              src={`/media/badges/${store.key}-${l}.svg`}
              alt={store.name}
              height={BADGE_HEIGHT}
            />
          ))}
        </span>
      )
    )
  }
</div>

<style>
  /* Apple asks for clear space of 1/10 the badge height, Google for
     1/4 — 12px at a 48px badge, so the gap takes the larger rule. */
  .stores {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.875rem;
    margin-top: 1.5rem;
  }

  .badge-link {
    display: inline-flex;
    text-decoration: none;
    border-radius: 0.5rem;
    transition: opacity var(--dur-micro) var(--ease);
  }

  .badge-link:hover {
    opacity: 0.8;
  }

  /* Dimmed and unpressable while the app has no listing — grey reads
     as unavailable, which is exactly what is being said. */
  .is-inert {
    opacity: 0.45;
    cursor: default;
  }

  .is-inert:hover {
    opacity: 0.45;
  }

  /* Both badges run at one height; each keeps its own aspect. Which
     language shows is the site's ONE localization mechanism (`.t` in
     global.css), not a second one invented here. */
  .badge {
    height: 3rem;
    width: auto;
    max-width: none;
  }
</style>
