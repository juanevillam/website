---
import T from './T.astro';
import { SONGS } from '../lib/narration';

/**
 * A SONG'S DEMO, over the whole page (Juan, 2026-10-17): the screen
 * recording of Sound Shaper playing it while Juan shapes it, its sound
 * captured from the app, not through a microphone. The page frosts behind
 * it as it does behind a shared address's modal, the phone stands in the
 * middle, and the waves along the foot of the screen draw its sound. It
 * has no controls on purpose: it plays from the start to the end, and
 * closing it is the only thing to do. director.ts opens it — from the
 * song's line under its paragraph, from the app's welcome, and when the
 * voice finishes the paragraph that introduces it.
 */
---

{
  Object.entries(SONGS).map(([key, song]) => (
    <div
      class="song-demo"
      data-song-demo={key}
      role="dialog"
      aria-modal="true"
      aria-label={`${song.title} · ${song.by}`}
      hidden
    >
      <div class="demo-frost" />
      <div class="demo-stage" data-song-demo-stage>
      <video
        class="demo-screen"
        src={song.video}
        poster={song.poster}
        width={song.width}
        height={song.height}
        style={`--demo-ratio: ${song.height / song.width}`}
        playsinline
        preload="none"
        disablepictureinpicture
        tabindex="-1"
      />
      </div>
      <button class="demo-close" type="button" data-song-demo-close>
        <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true">
          <path
            d="M3.5 3.5 L12.5 12.5 M12.5 3.5 L3.5 12.5"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
          />
        </svg>
        <span class="sr-only"><T k="focus.close" /></span>
      </button>
    </div>
  ))
}

<style>
  /* Three layers, so the waves along the foot (NarrationPlayer's field)
     run between the frost and the phone, never across its screen: the
     frost under them, the phone over them. The frost is the shared
     address's modal's (global.css `[data-focused]::before`). */
  .song-demo[hidden] {
    display: none;
  }

  .demo-frost,
  .demo-stage {
    position: fixed;
    inset: 0;
    opacity: 0;
  }

  .demo-stage {
    transition: opacity var(--dur-turn) var(--ease);
  }

  .demo-frost {
    z-index: 50;
    background: color-mix(in srgb, var(--ground) 84%, transparent);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    transition:
      opacity var(--dur-turn) var(--ease),
      background-color var(--dur-turn) var(--ease);
  }

  /* THE FROST GOES SOLID ONCE IT HAS COME IN (Juan, 2026-10-18): over a
     whole recording, Chrome now and then dropped the blurred layer for a
     frame and the page flashed through, off and on. So the frost frosts
     the page only on the way in and out; once the phone has landed it
     eases to the plain ground, and then (director.ts, `is-demo-still`)
     the page under it stops being drawn and the blur comes off — there
     is nothing left behind to flash through, nor anything to blur. */
  .is-still .demo-frost {
    background-color: var(--ground);
  }

  :global(html.is-demo-still) .demo-frost {
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  :global(html.is-demo-still .scene),
  :global(html.is-demo-still .site-header),
  :global(html.is-demo-still main > :not(.song-demo, .nar-field)) {
    visibility: hidden;
  }

  .demo-stage {
    z-index: 52;
    display: grid;
    place-items: center;
  }

  .is-open .demo-frost,
  .is-open .demo-stage {
    opacity: 1;
  }

  /* The phone: EXACTLY the stories' picture of one (AppsShowcase
     `.shot`, Juan, 2026-10-17) — the same height, the same corners — so
     the recording reads as the screenshot coming to life, not a smaller
     copy of it. Keep the two in step. */
  .demo-screen {
    --demo-h: calc(100svh - (var(--stage-top) - 1.5rem) - var(--stage-bottom) - 5rem);
    /* The iPhone screen's corner, 14% of the phone's own width, at
       whatever size the phone is drawn (AppsShowcase `.shot`). */
    --demo-r: calc(var(--demo-h) / var(--demo-ratio) * 0.14);
    height: var(--demo-h);
    width: auto;
    border: 1px solid var(--hairline);
    border-radius: var(--demo-r) var(--demo-r) calc(var(--demo-r) * 1.136)
      calc(var(--demo-r) * 1.136);
    background: var(--surface);
    box-shadow:
      0 2rem 4rem rgba(0, 0, 0, 0.55),
      0 0.5rem 1.25rem rgba(0, 0, 0, 0.4);
    pointer-events: none;
    scale: 0.96;
    transition: scale var(--dur-turn) var(--ease);
  }

  .is-open .demo-screen {
    scale: 1;
  }

  /* ON A PHONE THE DEMO TAKES THE WHOLE SCREEN (Juan, 2026-10-28): there
     are no words beside it to leave room for, so the phone grows until it
     meets either the screen's sides or the room under the close. */
  @media (max-width: 48rem) {
    .demo-stage {
      padding: calc(var(--float-gap) * 2 + var(--float-h)) 1rem 1rem;
    }

    .demo-screen {
      --demo-h: min(
        calc((100vw - 2rem) * var(--demo-ratio)),
        calc(100svh - var(--float-gap) * 2 - var(--float-h) - 1rem)
      );
    }
  }

  /* The modal's close (Landing `.focus-close`): round, on the header's
     line, centred. */
  .demo-close {
    position: fixed;
    z-index: 53;
    top: var(--float-gap);
    left: 50%;
    display: grid;
    place-items: center;
    width: var(--float-h);
    height: var(--float-h);
    padding: 0;
    color: var(--ink-2);
    border: 1px solid var(--hairline);
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface) 82%, transparent);
    backdrop-filter: blur(12px);
    transform: translateX(-50%);
    cursor: pointer;
    transition:
      color var(--dur-micro) var(--ease),
      border-color var(--dur-micro) var(--ease);
  }

  .demo-close:hover {
    color: var(--ink);
    border-color: var(--ink-3);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* While it plays, the page holds still under it, the narrator steps
     aside (the demo is not its to pause), and the waves come up over the
     frost to draw the demo's sound. */
  :global(html.is-demo) {
    overflow: hidden;
  }

  :global(html.is-demo .narrator) {
    opacity: 0 !important;
    pointer-events: none !important;
  }

  :global(html.is-demo .nar-field) {
    z-index: 51;
  }

  @media (prefers-reduced-motion: reduce) {
    .demo-frost,
    .demo-stage,
    .demo-screen {
      transition: none;
    }
  }
</style>
