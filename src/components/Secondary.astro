---
import T from './T.astro';

// The secondary work — Expo UI Starter and Maktub — shares one closing
// panel, half the weight of the lead sections.
---

<section class="panel" id="more">
  <div class="inner">
    <article class="item" data-reveal>
      <h3 class="heading name">Expo UI Starter</h3>
      <p class="body lede"><T k="projects.starter.desc" /></p>
    </article>

    <article class="item" data-reveal>
      <h3 class="heading name">Maktub</h3>
      <p class="body lede"><T k="projects.maktub.desc" /></p>
      <a class="label visit" href="https://maktubartfund.com">
        <T k="experience.visit" />
        {' maktubartfund.com ↗'}
      </a>
    </article>
  </div>
</section>

<style>
  .inner {
    width: 100%;
    max-width: var(--content-max);
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .name {
    font-size: clamp(1.5rem, 3vw, 2rem);
  }

  .lede {
    margin-top: 1rem;
    font-size: 1rem;
  }

  .visit {
    display: inline-block;
    margin-top: 1.5rem;
    padding: 0.625rem 1.375rem;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    text-decoration: none;
    color: var(--ink-2);
    transition:
      color var(--dur-micro) var(--ease),
      border-color var(--dur-micro) var(--ease);
  }

  .visit:hover {
    color: var(--ink);
    border-color: var(--ink-3);
  }

  @media (max-width: 820px) {
    .inner {
      grid-template-columns: 1fr;
    }
  }
</style>
