---
import { clipFor, subsFor } from '../lib/narration';
import T from './T.astro';

/**
 * The wordmark, and one short line under it saying what Juan's intro
 * covers — a play button with nothing to read beside it asked the
 * visitor to press play blind. That line is the intro clip's transcript
 * (`hero.m4a`, see lib/narration): the page's first narrated block, with
 * the narrator parked under it so the pitch can start from the very top.
 */
const clip = clipFor('hero');
const subs = subsFor('hero');
---

<section class="hero" id="top">
  <!-- The wrapper is what the cinema controller rides out on scroll — the
       revealed children carry transitions of their own, so the scroll-
       coupled transform lives one level up where nothing animates it. -->
  <div
    class="hero-inner"
    data-hero-inner
    data-narr-block={clip ? 'hero' : null}
  >
    <h1 class="display" data-reveal>juanevillam</h1>
    <p
      class="body hero-intro"
      data-reveal
      data-narr-para
      data-clip-en={clip?.en}
      data-clip-es={clip?.es}
      data-subs-en={subs.en}
      data-subs-es={subs.es}
    >
      <T k="hero.intro" />
    </p>
    {
      clip && (
        <div
          class="narr-anchor"
          data-narr-anchor
          data-narr-align="center"
          aria-hidden="true"
        />
      )
    }
  </div>
</section>

<style>
  .hero {
    min-height: 100svh;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 0 clamp(1.25rem, 4vw, 2.5rem);
  }

  /* Centred under the wordmark, a short measure so it reads as one
     thought in two lines rather than a paragraph. */
  .hero-intro {
    max-width: 34rem;
    margin-top: 1.5rem;
    text-wrap: balance;
    transition: color calc(var(--beat) / 2) var(--ease);
  }

  /* While Juan is telling it, the line takes full ink. */
  .hero-inner.is-narrating .hero-intro.is-spoken {
    color: var(--ink);
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    will-change: opacity, transform;
  }

</style>
