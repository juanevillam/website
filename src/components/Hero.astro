---
import T from './T.astro';
import { clipFor, subsFor } from '../lib/narration';
import { NAME_SCENE } from '../lib/scene';

/**
 * The hero is the wordmark alone — a line of text under it was tried
 * and read as odd. When Juan's intro is recorded (`hero.m4a`, see
 * lib/narration) the wordmark carries the clip: the page's first
 * narrated block, with the narrator parked under it so the pitch can
 * start from the very top.
 */
const clip = clipFor('hero');
const subs = subsFor('hero');
---

<section class="hero" id="top" data-scene={NAME_SCENE}>
  <!-- The wrapper is what the cinema controller rides out on scroll — the
       revealed children carry transitions of their own, so the scroll-
       coupled transform lives one level up where nothing animates it. -->
  <div
    class="hero-inner"
    data-hero-inner
    data-narr-block={clip ? 'hero' : null}
  >
    <!-- The greeting is the name's EYEBROW — "HI" / "HOLA" / "你好" — in
         the voice every panel's title takes ("MORE WORK", "EVENTS") and
         at the same step over what it heads, so the language shows at a
         glance (Juan, 2026-10-13). A centred word in the name's own face
         read as foreign to the page; in a panel's corner it read as lost,
         far from the name it greets. -->
    <p class="label hello" data-reveal><T k="hero.hi" /></p>
    <h1
      class="display"
      data-reveal
      data-scene-at
      data-narr-para
      data-clip-en={clip?.en}
      data-clip-es={clip?.es}
      data-subs-en={subs.en}
      data-subs-es={subs.es}
    >
      juanevillam
    </h1>
    {
      clip && (
        <div
          class="narr-anchor"
          data-narr-anchor
          data-narr-align="center"
          aria-hidden="true"
        />
      )
    }
  </div>
</section>

<style>
  .hero {
    min-height: 100svh;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 0 clamp(1.25rem, 4vw, 2.5rem);
  }

  /* A phone stands the name a little over the screen's middle, not on it
     — the same lift every panel's top took (2026-10-13). */
  @media (max-width: 48rem) {
    .hero {
      padding-bottom: 8svh;
    }
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    will-change: opacity, transform;
  }

  /* Close over the name it greets — a panel's 1.5rem step stood it too
     far off a name this size (2026-10-13). */
  .hello {
    margin-bottom: 0.5rem;
  }

  @media (max-width: 48rem) {
    .hello {
      margin-bottom: 0.25rem;
    }
  }

  /* A new language's word arrives rather than simply being there: its
     span is shown fresh on a switch, which replays this. */
  .hello :global(.t) {
    animation: hello-in var(--dur-turn) var(--ease) both;
  }

  @keyframes hello-in {
    from {
      opacity: 0;
      filter: blur(0.25rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hello :global(.t) {
      animation: none;
    }
  }

</style>
