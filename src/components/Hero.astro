---
import T from './T.astro';
import { clipFor, voiceAttrs } from '../lib/narration';
import { NAME_SCENE } from '../lib/scene';
import ShipEgg from './ShipEgg.astro';

/**
 * The hero opens on the wordmark and Juan's intro paragraph (`hero.caption`),
 * capped like every other section on the page (5 lines on desktop, 3 on
 * mobile, with the next line fading in the bottom padding), followed by the
 * narrator anchor.
 */
const clip = clipFor('hero');
---

<section class="hero" id="top" data-scene={NAME_SCENE} data-scene-kind="name">
  <!-- Space Explorer's dogfight, now and then, BEHIND the name: first in
       the section, so the name paints over it. -->
  <ShipEgg place="hero" />
  <!-- The wrapper is what the cinema controller rides out on scroll — the
       revealed children carry transitions of their own, so the scroll-
       coupled transform lives one level up where nothing animates it. -->
  <div
    class="hero-inner"
    data-hero-inner
    data-narr-block={clip ? 'hero' : null}
  >
    <h1
      class="display"
      data-reveal
      data-scene-at
    >
      juanevillam
    </h1>
    <p
      class="body hero-body"
      data-reveal
      data-cap="2"
      data-cap-phone="2"
      data-narr-para
      {...voiceAttrs('hero', 'hero.caption')}
    >
      <T k="hero.caption" />
    </p>
    {
      clip && (
        <div class="narr-hold">
          <div
            class="narr-anchor"
            data-narr-anchor
            data-narr-align="center"
            aria-hidden="true"
          />
        </div>
      )
    }
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 12svh clamp(1.25rem, 4vw, 2.5rem) 0;
  }

  .narr-hold {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    will-change: opacity, transform;
  }

  .hero-body {
    --cap-gap: 1.25rem;
    max-width: 38rem;
    text-align: center;
  }

  @media (max-width: 48rem) {
    .hero {
      padding-top: 8svh;
    }

    .hero-body {
      --cap-gap: 1rem;
      font-size: 1rem;
      line-height: 1.55;
    }
  }
</style>
