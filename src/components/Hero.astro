---
import ListenPill from './ListenPill.astro';

/**
 * The hero stays the wordmark — that decision holds. What it gains is the
 * door to the narrated format: one line saying the site speaks, and the
 * listen pill for Juan's own intro clip (hidden until it's recorded).
 */
type Props = {
  /** Juan's personal intro narration — /media/narration/intro.m4a. */
  narration?: string;
};

const { narration } = Astro.props;
---

<section class="hero" id="top">
  <!-- The wrapper is what the cinema controller rides out on scroll — the
       revealed children carry transitions of their own, so the scroll-
       coupled transform lives one level up where nothing animates it. -->
  <div class="hero-inner" data-hero-inner>
    <h1 class="display" data-reveal>juanevillam</h1>
    <ListenPill audio={narration} />
  </div>
</section>

<style>
  .hero {
    min-height: 100svh;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 0 clamp(1.25rem, 4vw, 2.5rem);
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    will-change: opacity, transform;
  }

</style>
