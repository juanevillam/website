---
import { clipFor } from '../lib/narration';

/**
 * The hero stays the wordmark — that decision holds. When Juan's personal
 * intro is recorded (`hero.m4a`, see lib/narration), the wordmark becomes
 * the page's first narrated block: the narrator parks under it and the
 * pitch can start from the very top.
 */
const clip = clipFor('hero');
---

<section class="hero" id="top">
  <!-- The wrapper is what the cinema controller rides out on scroll — the
       revealed children carry transitions of their own, so the scroll-
       coupled transform lives one level up where nothing animates it. -->
  <div
    class="hero-inner"
    data-hero-inner
    data-narr-block={clip ? 'hero' : null}
  >
    <h1
      class="display"
      data-reveal
      data-narr-para
      data-clip-en={clip?.en}
      data-clip-es={clip?.es}
    >
      juanevillam
    </h1>
    {clip && <div class="narr-anchor" data-narr-anchor aria-hidden="true" />}
  </div>
</section>

<style>
  .hero {
    min-height: 100svh;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 0 clamp(1.25rem, 4vw, 2.5rem);
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    will-change: opacity, transform;
  }

</style>
