---
import AppTile from './AppTile.astro';
import DeckControls from './DeckControls.astro';
import StoreBadges from './StoreBadges.astro';
import T from './T.astro';
import type { UIKey } from '../i18n/ui';
import type { AppStory } from '../lib/apps';
import { clipFor, subsFor } from '../lib/narration';
import { sceneAttr, sceneOf } from '../lib/scene';

/**
 * THE APPS — every app the landing tells, in ONE panel (2026-10-11). Two
 * stories took four screens of scroll and a third would have taken six
 * before the page reached anything else; the section is now one screen
 * however many apps it holds, and each app still tells its whole story: a
 * WELCOME card (the pitch — the problem, then the answer — and the store
 * row) and its four cards.
 *
 * TABS, chosen over two other layouts built beside it the same day: one
 * deck that chained every app's cards with chapters above it, and tiles
 * that opened full screen. A deck inside a deck was never one of them —
 * two sideways swipes nested on a phone fight for the same gesture.
 *
 * THE SWITCHER FLOATS AT THE HEADER'S HEIGHT, centred between its pills
 * and built by their recipe (Juan, 2026-10-11): standing in the panel, it
 * took a row from the phone. It shows while the panel holds the screen and
 * goes with it. The picked app's pill is a grey lozenge that SLIDES to the
 * tab you pick, and the app's deck slides in from that side.
 *
 * Every card is the page's deck card (lib/deck.ts, `.deck-card` in
 * global.css), so a turn is the one More Work and Events turn with.
 *
 * NARRATION: the section is one narrated PANEL — every paragraph of every
 * app, in order — under ONE still narrator that the cards slide under (the
 * More Work arrangement). A clip ending moves the voice on, and whatever
 * shows the next paragraph follows it: the deck turns, and past an app's
 * last card the tab switches. The director (scripts/director.ts) runs the
 * session; this file only maps paragraphs to cards.
 */
type Props = {
  apps: AppStory[];
  /**
   * How a welcome shows its app's four screens. `fan` is the landing's; the
   * other two stand on their own routes (/magazine, /coverflow) for Juan to
   * compare (2026-10-11):
   *  - `magazine` — an endless diagonal run of tilted phones, top-right to
   *    bottom-left, two in view at a time, like a magazine spread.
   *  - `coverflow` — the four on a slow 3D carousel: one in front, its
   *    neighbours turned away beside it, stepping on by itself.
   */
  welcome?: 'fan' | 'magazine' | 'coverflow';
};

const { apps, welcome = 'fan' } = Astro.props;

const narrate = (k: UIKey) => ({ k, clip: clipFor(k), subs: subsFor(k) });

// PHONE copy by convention: `x.problem` → `x.problem.m`, `x.sN.pM` → `x.sN.m`.
const mobileKey = (k: string) =>
  (/\.p\d+$/.test(k) ? k.replace(/\.p\d+$/, '.m') : `${k}.m`) as UIKey;

type Card =
  | {
      kind: 'welcome';
      paras: UIKey[];
      /** Every card's phone, fanned out — the app at a glance. */
      shots: { src: string; width: number; height: number; title: string }[];
      scene: string;
    }
  | {
      kind: 'slide';
      paras: UIKey[];
      title: string;
      src: string;
      width: number;
      height: number;
      scene: string;
    };

// Each app's cards, in telling order: its welcome, then its slides.
const decks: Card[][] = [];
for (const app of apps) {
  // The welcome fans out every card's phone, and lights the page with
  // all of them together.
  const cards: Card[] = [
    {
      kind: 'welcome',
      paras: app.pitch,
      shots: app.slides.map(({ src, width, height, title }) => ({
        src,
        width,
        height,
        title,
      })),
      scene: sceneAttr(await sceneOf(app.slides.map(slide => slide.src))),
    },
  ];
  for (const slide of app.slides)
    cards.push({
      kind: 'slide',
      paras: slide.paras,
      title: slide.title,
      src: slide.src,
      width: slide.width,
      height: slide.height,
      scene: sceneAttr(await sceneOf(slide.src)),
    });
  decks.push(cards);
}
const voiced = decks.flat().some(c => c.paras.some(k => clipFor(k)));
---

<section
  class="apps"
  id="apps"
  data-apps
  data-welcome={welcome}
  data-narr-panel={voiced ? '' : null}
  data-phone-scene
>
  <!-- The switcher, floating at the header's height (see the docblock). -->
  <div class="switcher" role="tablist" aria-label="Apps" data-switcher>
    <span class="lozenge" aria-hidden="true"></span>
    {
      apps.map((app, a) => (
        <button
          class="tab"
          type="button"
          role="tab"
          data-tab={a}
          aria-selected={a === 0 ? 'true' : 'false'}
        >
          <AppTile app={app.id} size={22} />
          <span class="tab-name">{app.name}</span>
        </button>
      ))
    }
  </div>

  <div class="decks" data-decks>
    {
      decks.map((cards, a) => {
        const app = apps[a];
        return (
          <div
            class="carousel"
            data-apps-deck={a}
            hidden={a !== 0}
            tabindex="0"
            role="tabpanel"
            aria-roledescription="carousel"
            aria-label={app.name}
          >
            <div class="stage">
              {cards.map((card, c) => (
                <article
                  class:list={['card', 'deck-card', `is-${card.kind}`]}
                  aria-roledescription="slide"
                  aria-label={`${c + 1} / ${cards.length}`}
                  data-scene={card.scene}
                >
                  <div class="words">
                    {card.kind === 'welcome' ? (
                      <div class="lockup big" data-deck-part="text" style="--i: 1">
                        <AppTile app={app.id} size={52} />
                        <h3 class="lockup-name">{app.name}</h3>
                      </div>
                    ) : (
                      <>
                        <div class="lockup small" data-deck-part="text" style="--i: 0">
                          <AppTile app={app.id} size={26} />
                          <span class="lockup-name">{app.name}</span>
                        </div>
                        <h3 class="slide-title" data-deck-part="text" style="--i: 1">
                          {card.title}
                        </h3>
                      </>
                    )}
                    {card.paras.map(narrate).map(({ k, clip, subs }, i) => (
                      <p
                        class="body full"
                        data-deck-part="text"
                        style={`--i: ${i + 2}`}
                        data-narr-para
                        data-card={c}
                        data-app={a}
                        data-clip-en={clip?.en}
                        data-clip-es={clip?.es}
                        data-subs-en={subs.en}
                        data-subs-es={subs.es}
                      >
                        <T k={k} />
                      </p>
                    ))}
                    {/* The phone's short version — the welcome's two
                        paragraphs each have one, a slide's share one. */}
                    {(card.kind === 'welcome' ? card.paras : card.paras.slice(0, 1)).map(
                      (k, i) => (
                        <p class="body short" data-deck-part="text" style={`--i: ${i + 2}`}>
                          <T k={mobileKey(k)} />
                        </p>
                      )
                    )}
                    {card.kind === 'welcome' && (
                      <div class="store-row" data-deck-part="text" style="--i: 4">
                        <StoreBadges app={app.id} />
                      </div>
                    )}
                    {voiced && <div class="narr-slot" aria-hidden="true" />}
                  </div>

                  {card.kind === 'welcome' ? (
                    /* THE FAN — every card's phone, tilted left to right,
                       a little apart: the app at a glance, so someone who
                       skims past one story can judge the next by its UI
                       (Juan, 2026-10-11). It opens out as the card lands. */
                    welcome === 'magazine' ? (
                      <div class="slot" data-deck-part="picture">
                        <div class="mag">
                          {/* Twice over, so the run loops without a seam. */}
                          <div class="mag-track">
                            {[...card.shots, ...card.shots].map((shot, i) => (
                              <img
                                class="shot mag-shot"
                                src={shot.src}
                                alt={i < card.shots.length ? `${app.name} — ${shot.title}` : ''}
                                aria-hidden={i < card.shots.length ? undefined : 'true'}
                                width={shot.width}
                                height={shot.height}
                                loading="lazy"
                                decoding="async"
                                draggable="false"
                              />
                            ))}
                          </div>
                        </div>
                      </div>
                    ) : welcome === 'coverflow' ? (
                      <div class="slot" data-deck-part="picture">
                        <div class="flow" data-flow style={`--n: ${card.shots.length}`}>
                          {card.shots.map((shot, i) => (
                            <img
                              class:list={['shot', 'flow-shot', i === 0 && 'is-lead']}
                              data-flow-i={i}
                              src={shot.src}
                              alt={`${app.name} — ${shot.title}`}
                              width={shot.width}
                              height={shot.height}
                              loading="lazy"
                              decoding="async"
                              draggable="false"
                            />
                          ))}
                        </div>
                      </div>
                    ) : (
                    <div class="slot" data-deck-part="picture">
                      <div class="fan" style={`--n: ${card.shots.length}`}>
                        {card.shots.map((shot, i) => (
                          <img
                            class:list={['shot', 'fan-shot', i === 0 && 'is-lead']}
                            style={`--k: ${(card.shots.length - 1) / 2 - i}; --z: ${card.shots.length - i}`}
                            src={shot.src}
                            alt={`${app.name} — ${shot.title}`}
                            width={shot.width}
                            height={shot.height}
                            loading="lazy"
                            decoding="async"
                            draggable="false"
                          />
                        ))}
                      </div>
                    </div>
                    )
                  ) : (
                    <div class="slot" data-deck-part="picture">
                      <img
                        class="shot"
                        src={card.src}
                        alt={`${app.name} — ${card.title}`}
                        width={card.width}
                        height={card.height}
                        loading="lazy"
                        decoding="async"
                        draggable="false"
                      />
                    </div>
                  )}
                </article>
              ))}
            </div>

            <div class="inner controls" data-dock>
              <DeckControls
                names={cards.map(c => (c.kind === 'slide' ? c.title : app.name))}
              />
            </div>
          </div>
        );
      })
    }

    {/* The ONE narrator's anchor, outside every deck: the cards slide
        under it, and the script stands it on the front card's slot. */}
    {
      voiced && (
        <div class="inner narr-static">
          <div class="narr-anchor" data-narr-anchor aria-hidden="true" />
        </div>
      )
    }
  </div>
</section>

<style>
  .apps {
    --gutter: clamp(1.25rem, 4vw, 2.5rem);
    --card-w: min(var(--content-max), calc(100vw - var(--gutter) * 2));
    /* THE PHONE STANDS A STEP ABOVE THE WORDS' LINE, down to the controls'
       row (Juan, 2026-10-11): inside the words' insets it read as a small
       rectangle, and pulled up to the header's foot as too big. The slot
       is pulled up that step to make the room; the width follows the
       screenshot's own ratio. */
    --shot-top: calc(var(--stage-top) - 1.5rem);
    --shot-h: calc(100svh - var(--shot-top) - var(--stage-bottom) - 5rem);
    min-height: 100svh;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    display: flex;
    flex-direction: column;
    padding: var(--stage-top) 0 var(--stage-bottom);
    overflow-x: clip;
  }

  .inner {
    width: var(--card-w);
    margin: 0 auto;
  }

  /* ---------- the switcher ----------
     The header's pill recipe — its height, hairline, ground and blur — at
     the header's height, centred between its two pills. Shown only while
     the panel holds the screen (the script toggles .is-shown). */
  .switcher {
    --pad: 0.1875rem;
    position: fixed;
    top: var(--float-gap);
    left: 50%;
    z-index: 11;
    display: flex;
    height: var(--float-h);
    padding: var(--pad);
    border: 1px solid var(--hairline);
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface) 82%, transparent);
    backdrop-filter: blur(12px);
    transform: translate(-50%, -0.75rem);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity calc(var(--beat) / 2) var(--ease),
      transform calc(var(--beat) / 2) var(--ease),
      border-color var(--dur-micro) var(--ease),
      visibility 0s linear calc(var(--beat) / 2);
  }

  .switcher.is-shown {
    transform: translate(-50%, 0);
    opacity: 1;
    visibility: visible;
    transition:
      opacity calc(var(--beat) / 2) var(--ease),
      transform calc(var(--beat) / 2) var(--ease),
      border-color var(--dur-micro) var(--ease),
      visibility 0s;
  }

  .switcher:hover {
    border-color: var(--ink-3);
  }

  /* The picked tab's ground: a grey lozenge that slides and stretches to
     whichever tab is picked — the script sets its box. */
  .lozenge {
    position: absolute;
    top: var(--pad);
    bottom: var(--pad);
    left: 0;
    width: var(--w, 0px);
    border-radius: 999px;
    background: color-mix(in srgb, var(--ink) 13%, transparent);
    transform: translateX(var(--x, 0px));
    transition:
      transform calc(var(--beat) * 0.75) var(--ease),
      width calc(var(--beat) * 0.75) var(--ease);
  }

  .lozenge.is-still {
    transition: none;
  }

  .tab {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.625rem;
    height: 100%;
    padding: 0 1.25rem 0 0.75rem;
    border: none;
    border-radius: 999px;
    background: none;
    color: var(--ink-3);
    font: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    white-space: nowrap;
    cursor: pointer;
    transition: color var(--dur-micro) var(--ease);
  }

  .tab :global(svg) {
    opacity: 0.55;
    transition: opacity var(--dur-micro) var(--ease);
  }

  .tab:hover {
    color: var(--ink-2);
  }

  .tab[aria-selected='true'] {
    color: var(--ink);
  }

  .tab[aria-selected='true'] :global(svg) {
    opacity: 1;
  }

  /* ---------- the decks ---------- */

  /* Every app's deck in one cell, so the leaving one and the arriving one
     cross in place instead of stacking. */
  .decks {
    position: relative;
    flex: 1;
    display: grid;
  }

  .carousel {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    outline: none;
    transition:
      opacity calc(var(--beat) / 2) var(--ease),
      transform calc(var(--beat) / 2) var(--ease);
  }

  .carousel[hidden] {
    display: none;
  }

  /* Changing app: the deck leaving drifts out the way the switch went and
     fades; the one arriving stands on the far side, then comes in. */
  .carousel.is-leaving {
    opacity: 0;
    transform: translateX(calc(var(--dir, 1) * -2rem));
    pointer-events: none;
  }

  .carousel.is-arriving {
    opacity: 0;
    transform: translateX(calc(var(--dir, 1) * 2rem));
    transition: none;
  }

  .stage {
    touch-action: pan-y;
    display: grid;
    justify-items: center;
  }

  /* Words in the stories' text column, the picture in the rest. */
  .card {
    display: grid;
    grid-template-columns: calc(100% * 6 / 13 * 0.81) 1fr;
    gap: var(--column-gap);
    align-items: start;
  }

  /* The welcome's pitch reads in a wider column (1.2x), so two paragraphs
     and the store row stand inside the panel — and no wider, so the fan
     beside it has room to open (1.5x crowded the four phones together). */
  .is-welcome {
    grid-template-columns: calc(100% * 6 / 13 * 0.81 * 1.2) 1fr;
  }

  /* An icon keeps its drawn size; a flex row would squeeze the SVG. */
  .apps :global(svg) {
    flex: none;
  }

  .words {
    display: flex;
    flex-direction: column;
  }

  .lockup {
    display: flex;
    align-items: center;
  }

  /* THE TYPE IS MORE WORK'S LADDER, a step up at most (Juan, 2026-10-11):
     the stories' display sizes made the page change voice at the seam
     between the apps and the panels under them. */
  .lockup.big {
    gap: 1rem;
  }

  .lockup.big .lockup-name {
    font-size: clamp(1.75rem, 3.2vw, 2.5rem);
    font-weight: 800;
    letter-spacing: var(--track-display);
    line-height: 0.95;
    white-space: nowrap;
  }

  .lockup.small {
    gap: 0.625rem;
    height: 2rem;
    margin-bottom: 1.25rem;
  }

  .lockup.small .lockup-name {
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: var(--track-heading);
  }

  .slide-title {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    font-weight: 800;
    letter-spacing: var(--track-heading);
    line-height: 1.05;
  }

  .words .body {
    margin-top: 1.25rem;
  }

  .words .body + .body {
    margin-top: 0.875rem;
  }

  .is-welcome .body {
    max-width: none;
  }

  .short {
    display: none;
  }

  .store-row :global(.stores) {
    margin-top: 1.75rem;
  }

  .narr-slot {
    flex: none;
    height: var(--narrator-h);
    margin-top: 1.5rem;
  }

  /* The phone: the panel's height, its own corner — the stories' recipe. */
  .slot {
    display: flex;
    justify-content: center;
    margin-top: calc(var(--shot-top) - var(--stage-top));
  }

  .shot {
    height: var(--shot-h);
    width: auto;
    max-width: none;
    border-radius: var(--media-radius) var(--media-radius)
      calc(var(--media-radius) * 1.136) calc(var(--media-radius) * 1.136);
    border: 1px solid var(--hairline);
    box-shadow:
      0 2rem 4rem rgba(0, 0, 0, 0.55),
      0 0.5rem 1.25rem rgba(0, 0, 0, 0.4);
  }

  /* ---------- the fan ----------
     Four phones AT THE SLIDES' OWN SIZE (Juan, 2026-10-11: a smaller fan
     read as a different picture from the cards after it), pivoting on one
     point at their foot, each turned a few degrees by its place from the
     middle (--k: -1.5 … 1.5) and slid a little that way — a fan, mostly
     overlapping, every screen's top still in view. The FIRST card's phone
     (Home, Library) stands on the RIGHT, on top, and the rest tuck under
     it to the LEFT in order (Juan, 2026-10-11): what shows of each is then
     its leading edge — the screen's own content — not the status bar's
     icons down its trailing side. Tight on purpose: a compact fan of many
     leaves, not four phones spread across the page. It holds still under
     the pointer (a tilted fan read as broken), closes while the card is
     away, and opens as the card lands. */
  .fan {
    --fan-h: var(--shot-h);
    --fan-w: calc(var(--fan-h) * 1179 / 2556);
    /* How far apart neighbours stand at the foot, in phone widths, and how
       far each turns. */
    --spread: 0.08;
    --tilt: 2.5deg;
    position: relative;
    width: 100%;
    height: var(--shot-h);
  }

  .fan-shot {
    position: absolute;
    left: 50%;
    top: calc((var(--shot-h) - var(--fan-h)) / 2);
    height: var(--fan-h);
    margin-left: calc(var(--fan-w) / -2);
    z-index: var(--z);
    transform-origin: 50% 100%;
    transform: rotate(0deg);
    /* Quick — a detail as the card lands, not a show (Juan, 2026-10-11:
       at a beat and a half it read as slow). */
    transition: transform calc(var(--beat) * 0.6) var(--ease);
    transition-delay: calc(var(--beat) / 12);
  }

  .deck-card.is-current .fan-shot {
    transform: translateX(calc(var(--k) * var(--fan-w) * var(--spread)))
      rotate(calc(var(--k) * var(--tilt)));
  }

  /* Arriving — a turn or a tab — the fan stands closed for a frame, so it
     opens every time the card lands, not only the first. */
  .deck-card.is-arriving .fan-shot {
    transform: rotate(0deg);
    transition: none;
  }

  /* THE HAND-OFF (see the script): while the welcome's lead phone and the
     first card's phone trade places, the one arriving stands in its final
     place at once, hidden — a flying copy draws the trip — and the one
     leaving is gone at once, since it is the one that flies. */
  .deck-card.is-handoff [data-deck-part='picture'],
  .deck-card.is-handoff .fan-shot.is-lead {
    transition: none;
  }

  .deck-card.is-handoff [data-deck-part='picture'] {
    opacity: 1;
    transform: none;
  }

  .is-flying {
    visibility: hidden;
  }

  /* ---------- the magazine ----------
     An endless run of the app's phones down a diagonal — top-right to
     bottom-left — each turned with the line, about two in view at a time,
     the column fading out at both ends. The track is the shots twice over
     and slides by exactly one set per loop, so it never shows a seam. */
  .mag {
    --mag-h: calc(var(--shot-h) * 0.62);
    --mag-gap: 1.75rem;
    position: relative;
    width: 100%;
    height: var(--shot-h);
    overflow: hidden;
    mask-image: linear-gradient(
      to bottom,
      transparent,
      #000 18%,
      #000 82%,
      transparent
    );
  }

  .mag-track {
    position: absolute;
    left: 50%;
    top: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--mag-gap);
    transform: translate(-50%, -50%) rotate(22deg);
  }

  .mag-shot {
    height: var(--mag-h);
    border-radius: calc(var(--media-radius) * 0.62);
    animation: mag-run calc(var(--beat) * 28) linear infinite;
  }

  /* Down the column by one set: four phones and their gaps. */
  @keyframes mag-run {
    from {
      translate: 0 calc((var(--mag-h) + var(--mag-gap)) * -4);
    }
    to {
      translate: 0 0;
    }
  }

  /* ---------- the coverflow ----------
     The four phones on a ring: one in front at the slides' size, the one
     before and after it turned away to either side, the fourth behind. It
     steps on by itself (the script moves `.is-front`). */
  .flow {
    --flow-h: calc(var(--shot-h) * 0.86);
    --flow-w: calc(var(--flow-h) * 1179 / 2556);
    position: relative;
    width: 100%;
    height: var(--shot-h);
    perspective: 1800px;
  }

  .flow-shot {
    position: absolute;
    left: 50%;
    top: calc((var(--shot-h) - var(--flow-h)) / 2);
    height: var(--flow-h);
    margin-left: calc(var(--flow-w) / -2);
    border-radius: calc(var(--media-radius) * 0.86);
    transition:
      transform calc(var(--beat) * 1.25) var(--ease),
      opacity calc(var(--beat) * 1.25) var(--ease),
      filter calc(var(--beat) * 1.25) var(--ease);
    /* Behind, until the script places it. */
    transform: translateZ(-30rem);
    opacity: 0;
  }

  .flow-shot.is-front {
    z-index: 3;
    transform: none;
    opacity: 1;
  }

  .flow-shot.is-next,
  .flow-shot.is-prev {
    z-index: 2;
    opacity: 0.85;
    filter: brightness(0.55);
  }

  .flow-shot.is-next {
    transform: translateX(calc(var(--flow-w) * 0.62)) translateZ(-12rem)
      rotateY(-38deg);
  }

  .flow-shot.is-prev {
    transform: translateX(calc(var(--flow-w) * -0.62)) translateZ(-12rem)
      rotateY(38deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .mag-shot {
      animation: none;
    }

    .flow-shot {
      transition: none;
    }
  }

  /* A slide's phone leans toward the pointer (lib/tilt). */
  .is-slide .slot {
    perspective: 1600px;
  }

  .is-slide .shot {
    rotate: var(--tilt-rot, none);
  }

  /* ---------- the narrator's still anchor ---------- */

  .narr-static {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    pointer-events: none;
  }

  .narr-static .narr-anchor {
    margin-top: 0;
    transform: translateY(var(--slot-y, 0px));
    transition: transform calc(var(--beat) * 0.75) var(--ease);
  }

  /* Centred at the panel's foot, the way More Work's stand. */
  .controls {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: auto;
    padding-top: 1.5rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .narr-static .narr-anchor,
    .lozenge,
    .carousel,
    .fan-shot {
      transition: none;
    }


    .carousel.is-leaving,
    .carousel.is-arriving {
      transform: none;
    }
  }

  /* ---------- phones ---------- */

  @media (max-width: 48rem) {
    .apps {
      --shot-h: min(112vw, calc(100svh - var(--stage-top) - 16rem));
    }

    /* A step of air under the switcher, which stands on the panel's top
       line on a phone. */
    .decks {
      margin-top: 1rem;
    }

    /* Icons only: three apps fit between the header's two pills. */
    .tab {
      padding: 0 0.75rem;
    }

    .tab-name {
      display: none;
    }

    /* One centred column: the picture on top, the words under it. */
    .card,
    .is-welcome {
      grid-template-columns: 1fr;
      align-content: start;
      gap: var(--media-gap-m);
    }

    .words {
      position: relative;
      z-index: 1;
      align-items: center;
      text-align: center;
    }

    .slot {
      order: -1;
      margin-top: 0;
    }

    /* A phone's fan stands over the words, smaller: the screen is the
       width the four have to share. */
    .is-welcome .fan {
      --fan-h: min(58vw, 27svh);
      --spread: 0.18;
      --tilt: 4deg;
      height: calc(var(--fan-h) * 1.12);
    }

    /* The magazine and the coverflow take the fan's box on a phone. */
    .is-welcome .mag,
    .is-welcome .flow {
      height: calc(min(58vw, 27svh) * 1.12);
    }

    .is-welcome .mag {
      --mag-h: min(40vw, 19svh);
      --mag-gap: 0.875rem;
    }

    .is-welcome .flow {
      --flow-h: min(58vw, 27svh);
    }

    .is-welcome .flow-shot {
      top: 0;
      border-radius: calc(var(--media-radius) * 0.52);
    }

    /* The phone's corner at this phone's size (a slide's is 112vw). */
    .is-welcome .fan-shot {
      top: 0;
      border-radius: calc(var(--media-radius) * 0.52);
    }

    .shot {
      box-shadow:
        var(--media-glow),
        0 2rem 4rem rgba(0, 0, 0, 0.55),
        0 0.5rem 1.25rem rgba(0, 0, 0, 0.4);
    }

    .lockup.small {
      display: none;
    }

    .lockup.big {
      gap: 0.75rem;
      padding-top: 0.5rem;
    }

    .lockup.big .lockup-name {
      font-size: clamp(1.75rem, 8vw, 2.25rem);
    }

    .slide-title {
      font-size: 1.5rem;
    }

    .words .body {
      margin-top: 0.75rem;
      font-size: 1rem;
      line-height: 1.5;
    }

    .full,
    .narr-slot,
    .narr-static {
      display: none;
    }

    .short {
      display: block;
    }

    .store-row :global(.stores) {
      justify-content: center;
      margin-top: 1.25rem;
    }

    .controls {
      width: auto;
      margin-top: 0;
      padding-top: 0;
    }
  }

  /* SHORT PHONES (an SE, a phone with Safari's bars showing): the welcome's
     fan, lockup, pitch and store row are one column over the controls,
     and at 667pt tall the store row ran under the arrows. Everything
     steps down a notch so the column clears them. */
  @media (max-width: 48rem) and (max-height: 46rem) {
    .is-welcome .fan {
      --fan-h: min(50vw, 21svh);
      height: calc(var(--fan-h) * 1.05);
    }

    .card,
    .is-welcome {
      gap: 1rem;
    }

    .lockup.big {
      padding-top: 0;
    }

    .lockup.big .lockup-name {
      font-size: 1.625rem;
    }

    .words .body {
      margin-top: 0.5rem;
      font-size: 0.9375rem;
      line-height: 1.45;
    }

    .store-row :global(.stores) {
      margin-top: 0.875rem;
    }
  }

  /* SHORT DESKS (a 720pt laptop window): the welcome's two paragraphs, the
     store row and the narrator under them reached past the deck's arrows.
     The pitch steps down a size and its gaps tighten. */
  @media (min-width: 48.01rem) and (max-height: 50rem) {
    .is-welcome .body {
      font-size: 0.9375rem;
      line-height: 1.55;
    }

    .is-welcome .words .body {
      margin-top: 0.875rem;
    }

    .is-welcome .words .body + .body {
      margin-top: 0.625rem;
    }

    .is-welcome .store-row :global(.stores) {
      margin-top: 1.25rem;
    }

    .is-welcome .narr-slot {
      margin-top: 1rem;
    }
  }
</style>

<script>
  import { createDeck, watchSlots, type Deck } from '../lib/deck';
  import { followPointer } from '../lib/tilt';

  const root = document.querySelector<HTMLElement>('[data-apps]');
  if (root) {
    const decksEl = root.querySelector<HTMLElement>('[data-decks]')!;
    const switcher = root.querySelector<HTMLElement>('[data-switcher]')!;
    const lozenge = switcher.querySelector<HTMLElement>('.lozenge')!;
    const tabs = [...switcher.querySelectorAll<HTMLElement>('[data-tab]')];
    const paras = [...root.querySelectorAll<HTMLElement>('[data-narr-para]')];
    const still = decksEl.querySelector<HTMLElement>('.narr-static .narr-anchor');

    type Held = { el: HTMLElement; cards: HTMLElement[]; deck: Deck };
    const held: Held[] = [];
    let active = 0;
    // How long a leaving deck stays drawn: its fade, and a margin.
    const LEAVE_MS = 320;

    // Stand the still anchor on the front card's slot.
    const standAnchor = () => {
      const h = held[active];
      const slot = h?.cards[h.deck.current]?.querySelector<HTMLElement>('.narr-slot');
      if (!still || !slot) return;
      const y = slot.getBoundingClientRect().top - decksEl.getBoundingClientRect().top;
      still.style.setProperty('--slot-y', `${y.toFixed(1)}px`);
    };

    // The narrator starts this panel on the card in front, and a running
    // voice switches to it.
    const select = (card: HTMLElement | undefined) => {
      if (!card) return;
      requestAnimationFrame(standAnchor);
      const first = card.querySelector<HTMLElement>('[data-narr-para]');
      if (!first) return;
      root.dataset.narrStart = String(paras.indexOf(first));
      document.dispatchEvent(new CustomEvent('narr:select', { detail: first }));
    };

    /**
     * THE HAND-OFF — the welcome's lead phone (Home, Library) IS the first
     * card's phone, so it travels between them instead of one leaving and
     * the other arriving (Juan, 2026-10-11): the narrator's glide between
     * its anchors, made for a picture. A copy flies from where the phone
     * stands to where it will stand — turning out of the fan's lean,
     * scaling to its size there — while both real ones are hidden; the one
     * arriving is revealed in its place when the copy lands.
     */
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    // A welcome hands off its lead phone (the fan's, or the coverflow's
    // when Home is in front); the magazine's run is moving and has none.
    const phoneOf = (card: HTMLElement) =>
      card.classList.contains('is-welcome')
        ? card.querySelector<HTMLElement>(
            '.fan-shot.is-lead, .flow-shot.is-lead.is-front'
          )
        : card.querySelector<HTMLElement>('.slot .shot');
    const pose = (img: HTMLElement) => {
      const r = img.getBoundingClientRect();
      const m = new DOMMatrix(getComputedStyle(img).transform);
      return {
        x: r.left + r.width / 2,
        y: r.top + r.height / 2,
        w: img.offsetWidth,
        h: img.offsetHeight,
        turn: (Math.atan2(m.b, m.a) * 180) / Math.PI,
      };
    };
    const handOff = (from: HTMLElement, to: HTMLElement) => {
      if (reduced) return;
      const a = phoneOf(from);
      const b = phoneOf(to);
      if (!a || !b || !a.offsetHeight) return;
      const start = pose(a);
      to.classList.add('is-handoff');
      const end = pose(b);
      a.classList.add('is-flying');
      b.classList.add('is-flying');

      const look = getComputedStyle(a);
      const ghost = a.cloneNode() as HTMLImageElement;
      ghost.removeAttribute('class');
      ghost.removeAttribute('style');
      Object.assign(ghost.style, {
        position: 'fixed',
        left: `${start.x - start.w / 2}px`,
        top: `${start.y - start.h / 2}px`,
        width: `${start.w}px`,
        height: `${start.h}px`,
        margin: '0',
        maxWidth: 'none',
        zIndex: '20',
        pointerEvents: 'none',
        borderRadius: look.borderRadius,
        border: look.border,
        boxShadow: look.boxShadow,
      });
      document.body.append(ghost);
      const scale = end.h / start.h;
      const flight = ghost.animate(
        [
          { transform: `rotate(${start.turn}deg)` },
          {
            transform:
              `translate(${end.x - start.x}px, ${end.y - start.y}px) ` +
              `scale(${scale}) rotate(${end.turn}deg)`,
          },
        ],
        { duration: 650, easing: 'cubic-bezier(0.16, 1, 0.3, 1)' }
      );
      const land = () => {
        ghost.remove();
        a.classList.remove('is-flying');
        b.classList.remove('is-flying');
        to.classList.remove('is-handoff');
      };
      flight.onfinish = land;
      flight.oncancel = land;
    };

    for (const el of root.querySelectorAll<HTMLElement>('[data-apps-deck]')) {
      const cards = [...el.querySelectorAll<HTMLElement>('.deck-card')];
      const h = { el, cards } as Held;
      let previous = 0;
      h.deck = createDeck({
        cards,
        controls: el.querySelector('[data-deck-controls]'),
        keys: el,
        swipe: el.querySelector<HTMLElement>('.stage'),
        onChange: current => {
          // Welcome ⇄ first card: the lead phone flies between them.
          if (h.deck && previous + current === 1 && previous !== current)
            handOff(cards[previous], cards[current]);
          previous = current;
          // The first call comes while the deck is still being made.
          requestAnimationFrame(() => {
            if (held.indexOf(h) === active) select(cards[current]);
          });
        },
      });
      held.push(h);
    }

    // The lozenge stands under the picked tab — measured, since every
    // app's name is its own width.
    const placeLozenge = (animate = true) => {
      const tab = tabs[active];
      if (!tab) return;
      lozenge.classList.toggle('is-still', !animate);
      lozenge.style.setProperty('--x', `${tab.offsetLeft}px`);
      lozenge.style.setProperty('--w', `${tab.offsetWidth}px`);
    };

    // CHANGING APP IS ONE MOVE (Juan, 2026-10-11). The old deck drifts out
    // the way the switch went while the new one drifts in from the other
    // side, together, on one curve — and the new deck is ALREADY standing on
    // its welcome (or, when the voice carried the page here, on the card
    // being told), fan open. Replaying the card's entrance and the fan on
    // top of the deck's own move read as a gallop, two beats where there
    // should be one, and flicking between tabs replayed it every time.
    const show = (a: number, card?: number) => {
      if (a === active) return;
      const dir = a > active ? 1 : -1;
      const from = held[active];
      const to = held[a];
      active = a;

      tabs.forEach((t, i) => t.setAttribute('aria-selected', String(i === a)));
      placeLozenge();

      // Turned while still hidden, so the turn draws nothing.
      const target = card ?? 0;
      if (to.deck.current !== target) to.deck.go(target);

      from.el.style.setProperty('--dir', String(dir));
      from.el.classList.add('is-leaving');
      setTimeout(() => {
        from.el.classList.remove('is-leaving');
        if (held[active] !== from) from.el.hidden = true;
      }, LEAVE_MS);

      to.el.style.setProperty('--dir', String(dir));
      to.el.classList.remove('is-leaving');
      to.el.hidden = false;
      to.el.classList.add('is-arriving');
      void to.el.offsetWidth;
      to.el.classList.remove('is-arriving');
      select(to.cards[target]);
    };

    tabs.forEach((t, a) => t.addEventListener('click', () => show(a)));

    // The switcher shows while the panel holds the screen — the middle of
    // the viewport inside it — and goes with it.
    const watch = () => {
      const r = root.getBoundingClientRect();
      const mid = innerHeight / 2;
      switcher.classList.toggle('is-shown', r.top < mid && r.bottom > mid);
    };
    addEventListener('scroll', watch, { passive: true });
    addEventListener('resize', () => {
      watch();
      placeLozenge(false);
      standAnchor();
    });
    watch();
    // Fonts settle the tabs' widths after the first paint.
    placeLozenge(false);
    document.fonts?.ready.then(() => placeLozenge(false));

    // The voice moved on by itself: whatever shows its paragraph follows —
    // the deck turns, and past an app's last card the tab switches.
    document.addEventListener('narr:para', e => {
      const p = (e as CustomEvent<HTMLElement>).detail;
      if (!root.contains(p)) return;
      const a = Number(p.dataset.app);
      const c = Number(p.dataset.card);
      if (a !== active) {
        show(a, c);
        return;
      }
      const h = held[a];
      if (c !== h.deck.current) h.deck.go(c);
    });

    // A slide's phone leans toward the pointer; the welcome's fan holds
    // still.
    followPointer(root, () => {
      const h = held[active];
      const card = h.cards[h.deck.current];
      return card?.classList.contains('is-slide')
        ? card.querySelector<HTMLElement>('.shot')
        : null;
    });

    // THE COVERFLOW steps on by itself while its card is in front and the
    // page is looking at the panel; the first phone leads, so a turn to
    // the first card can still hand Home off when it is in front.
    for (const flow of root.querySelectorAll<HTMLElement>('[data-flow]')) {
      const leaves = [...flow.querySelectorAll<HTMLElement>('.flow-shot')];
      const n = leaves.length;
      let front = 0;
      const place = () =>
        leaves.forEach((l, i) => {
          const d = (i - front + n) % n;
          l.classList.toggle('is-front', d === 0);
          l.classList.toggle('is-next', d === 1);
          l.classList.toggle('is-prev', d === n - 1);
        });
      place();
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches)
        setInterval(() => {
          const card = flow.closest<HTMLElement>('.deck-card');
          if (!card?.classList.contains('is-current') || document.hidden) return;
          if (!flow.closest<HTMLElement>('[data-apps-deck]')?.offsetParent) return;
          front = (front + 1) % n;
          place();
        }, 2600);
    }

    // WARM THE HIDDEN APPS. A deck that is not in front is `hidden`, so its
    // lazy screenshots are neither fetched nor decoded until its tab is
    // picked — and then all of them land at once, mid-transition, and the
    // first switch to each app stuttered while every later one was smooth
    // (Juan, 2026-10-11). Once the page has loaded and the browser is idle,
    // each hidden picture is fetched and decoded, one at a time, so the
    // first switch draws from memory like the rest.
    const idle = (fn: () => void) =>
      'requestIdleCallback' in window
        ? requestIdleCallback(fn, { timeout: 2000 })
        : setTimeout(fn, 200);
    const warm = () => {
      // The deck in front first (its later cards are lazy too), then the
      // others in tab order.
      const queue = [held[active], ...held.filter((_, i) => i !== active)].flatMap(h => [
        ...h.el.querySelectorAll<HTMLImageElement>('img'),
      ]);
      const next = () => {
        const img = queue.shift();
        if (!img) return;
        img.loading = 'eager';
        img
          .decode()
          .catch(() => {})
          .finally(() => idle(next));
      };
      idle(next);
    };
    // Not on a connection the person asked to spare: ~5 MB of screenshots
    // is theirs to spend by picking a tab.
    const spare = (
      navigator as Navigator & { connection?: { saveData?: boolean } }
    ).connection?.saveData;
    if (!spare) {
      if (document.readyState === 'complete') warm();
      else addEventListener('load', warm, { once: true });
    }

    select(held[0].cards[0]);
    // Placed now as well as on the next frame, and again once fonts and
    // images have settled the words' height.
    standAnchor();
    document.fonts?.ready.then(standAnchor);
    addEventListener('load', standAnchor);
    watchSlots(
      held.flatMap(h => h.cards),
      standAnchor
    );
  }
</script>
