---
import AppTile from './AppTile.astro';
import DeckControls from './DeckControls.astro';
import StoreBadges from './StoreBadges.astro';
import T from './T.astro';
import TL from './TL.astro';
import type { UIKey } from '../i18n/ui';
import type { AppStory } from '../lib/apps';
import { clipFor, SONGS, voiceAttrs } from '../lib/narration';
import { FOCUS_PAGES } from '../lib/links';
import CopyLink from './CopyLink.astro';
import { sceneAttr, sceneOf } from '../lib/scene';

/**
 * AN APP SHOWCASE — one full-viewport snapped panel telling one app's whole
 * story: a WELCOME card (the pitch — the problem, then the answer — and the
 * store row) followed by its four feature cards.
 *
 * Supports two media formats (`app.format`):
 * - `'phone'`   (Sound Shaper): upright iPhone screenshots (`830 × 1800`)
 *   with iPhone squircle corners.
 * - `'desktop'` (Book Highlighter): `3:2` desktop screenshots (`1440 × 960`)
 *   in the page's standard `--screen-w` frame (`--media-radius-flat`),
 *   matching More Work and Events on both desktop and phone.
 */
type Props = {
  id?: string;
  app: AppStory;
  /** An app's own address opens it (lib/links): the panel then stands
   *  over the page as a modal. */
  focused?: boolean;
};

const { id, app, focused = false } = Astro.props;
const isDesktop = app.format === 'desktop';

type Card =
  | {
      kind: 'welcome';
      paras: UIKey[];
      shots: { src: string; width: number; height: number; title: string }[];
      scene: string;
    }
  | {
      kind: 'slide';
      paras: UIKey[];
      title: string;
      src: string;
      width: number;
      height: number;
      scene: string;
    };

const songOf = (cards: Card[]) =>
  cards.flatMap(card => card.paras).find(k => SONGS[k]);

const cards: Card[] = [
  {
    kind: 'welcome',
    paras: app.pitch,
    shots: app.slides.map(({ src, width, height, title }) => ({
      src,
      width,
      height,
      title,
    })),
    scene: sceneAttr(await sceneOf(app.slides.map(slide => slide.src))),
  },
  ...(await Promise.all(
    app.slides.map(async slide => ({
      kind: 'slide' as const,
      paras: slide.paras,
      title: slide.title,
      src: slide.src,
      width: slide.width,
      height: slide.height,
      scene: sceneAttr(await sceneOf(slide.src)),
    })),
  )),
];

const voiced = cards.some(c => c.paras.some(k => clipFor(k)));
const focusPath =
  FOCUS_PAGES.find(f => f.focus.section === 'apps' && f.focus.app === app.id)
    ?.path ?? `/${app.slug}`;
---

<section
  class:list={['apps', `is-${app.format}`]}
  id={id ?? app.slug}
  data-apps
  data-format={app.format}
  data-narr-panel={voiced ? '' : null}
  data-phone-scene={isDesktop ? null : ''}
  data-focused={focused ? '' : null}
>
  <h2 class="visually-hidden">{app.name}</h2>

  <div class="decks" data-decks>
    <div
      class="carousel"
      data-apps-deck="0"
      data-viewer-items={JSON.stringify(
        app.slides.map(s => ({
          src: s.src,
          name: `${app.name} — ${s.title}`,
        })),
      )}
      tabindex="0"
      role="region"
      aria-roledescription="carousel"
      aria-label={app.name}
    >
      <div class="stage">
        {
          cards.map((card, c) => (
            <article
              class:list={['card', 'deck-card', `is-${card.kind}`]}
              aria-roledescription="slide"
              aria-label={`${c + 1} / ${cards.length}`}
              data-scene={card.scene}
            >
              <div class="words">
                {card.kind === 'welcome' ? (
                  <div class="lockup big" data-deck-part="text" style="--i: 1">
                    <AppTile app={app.id} size={52} />
                    <h3 class="lockup-name">
                      {app.name}
                      <CopyLink path={focusPath} />
                    </h3>
                  </div>
                ) : (
                  <>
                    <div
                      class="lockup small"
                      data-deck-part="text"
                      style="--i: 0"
                    >
                      <AppTile app={app.id} size={26} />
                      <span class="lockup-name">{app.name}</span>
                    </div>
                    <h3
                      class="slide-title"
                      data-deck-part="text"
                      style="--i: 1"
                    >
                      {card.title}
                    </h3>
                  </>
                )}
                <div
                  class="desc"
                  data-cap
                  data-cap-phone={card.kind === 'welcome' ? 'fill' : '3'}
                >
                  {card.paras.map((k, i) => (
                    <>
                      <p
                        class="body"
                        data-deck-part="text"
                        style={`--i: ${i + 2}`}
                        data-narr-para
                        data-card={c}
                        data-app="0"
                        {...voiceAttrs(k)}
                      >
                        {app.github ? (
                          <TL k={k} links={{ github: app.github }} />
                        ) : (
                          <T k={k} />
                        )}
                      </p>
                      {SONGS[k] && (
                        <button
                          type="button"
                          class="song-cue"
                          data-deck-part="text"
                          style={`--i: ${i + 2}`}
                          data-song-cue
                          data-song-key={k}
                        >
                          <svg
                            class="song-note"
                            viewBox="0 0 16 16"
                            width="14"
                            height="14"
                            aria-hidden="true"
                          >
                            <path
                              d="M6 12.5V3.5l7-1.5v9"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="1.5"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                            />
                            <circle
                              cx="4.25"
                              cy="12.5"
                              r="1.75"
                              fill="currentColor"
                            />
                            <circle
                              cx="11.25"
                              cy="11"
                              r="1.75"
                              fill="currentColor"
                            />
                          </svg>
                          <span class="song-title">{SONGS[k].title}</span>
                          <span class="song-by">{SONGS[k].by}</span>
                          <span class="visually-hidden">
                            <T k="song.listen" />
                          </span>
                        </button>
                      )}
                    </>
                  ))}
                </div>
                {card.kind === 'welcome' && songOf(cards) && (
                  <button
                    type="button"
                    class="song-cue song-teaser"
                    data-deck-part="text"
                    style="--i: 4"
                    data-song-link={songOf(cards)}
                  >
                    <svg
                      class="song-note"
                      viewBox="0 0 16 16"
                      width="14"
                      height="14"
                      aria-hidden="true"
                    >
                      <path
                        d="M6 12.5V3.5l7-1.5v9"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                      <circle cx="4.25" cy="12.5" r="1.75" fill="currentColor" />
                      <circle cx="11.25" cy="11" r="1.75" fill="currentColor" />
                    </svg>
                    <T k="song.teaser" />
                  </button>
                )}
                {card.kind === 'welcome' && (
                  <div class="store-row" data-deck-part="text" style="--i: 4">
                    <StoreBadges app={app.id} />
                  </div>
                )}
                {voiced && <div class="narr-slot" aria-hidden="true" />}
              </div>

              {card.kind === 'welcome' &&
                (isDesktop ? (
                  <div
                    class="slot is-screen-slot"
                    data-deck-part="picture"
                    data-peek="side-screen"
                  >
                    <div
                      class="screen shot is-desktop"
                      data-scene-at
                      data-shot-at="0"
                    >
                      <img
                        class="fill"
                        src={card.shots[0].src}
                        alt=""
                        aria-hidden="true"
                        loading="lazy"
                        decoding="async"
                        draggable="false"
                      />
                      <img
                        class="whole"
                        src={card.shots[0].src}
                        alt={`${app.name} — ${card.shots[0].title}`}
                        width={card.shots[0].width}
                        height={card.shots[0].height}
                        loading="lazy"
                        decoding="async"
                        draggable="false"
                      />
                    </div>
                  </div>
                ) : (
                  <div
                    class="slot"
                    data-deck-part="picture"
                    data-peek="side"
                  >
                    <img
                      class="shot"
                      data-scene-at
                      data-shot-at="0"
                      src={card.shots[0].src}
                      alt={`${app.name} — ${card.shots[0].title}`}
                      width={card.shots[0].width}
                      height={card.shots[0].height}
                      loading="lazy"
                      decoding="async"
                      draggable="false"
                    />
                  </div>
                ))}
              {card.kind === 'slide' &&
                (isDesktop ? (
                  <div class="slot is-screen-slot" data-deck-part="picture">
                    <div
                      class="screen shot is-desktop"
                      data-shot-at={c - 1}
                    >
                      <div class="screen-caption" aria-hidden="true">
                        <span class="cap-name">
                          {card.title}
                          <CopyLink path={focusPath} decorative />
                        </span>
                        <span class="label cap-meta">{app.name}</span>
                      </div>
                      <img
                        class="fill"
                        src={c === 1 ? card.src : undefined}
                        data-src={c === 1 ? undefined : card.src}
                        alt=""
                        aria-hidden="true"
                        loading="lazy"
                        decoding="async"
                        draggable="false"
                      />
                      <img
                        class="whole"
                        src={c === 1 ? card.src : undefined}
                        data-src={c === 1 ? undefined : card.src}
                        alt={`${app.name} — ${card.title}`}
                        width={card.width}
                        height={card.height}
                        loading="lazy"
                        decoding="async"
                        draggable="false"
                      />
                    </div>
                  </div>
                ) : (
                  <div class="slot" data-deck-part="picture">
                    <img
                      class="shot"
                      data-shot-at={c - 1}
                      src={c === 1 ? card.src : undefined}
                      data-src={c === 1 ? undefined : card.src}
                      alt={`${app.name} — ${card.title}`}
                      width={card.width}
                      height={card.height}
                      loading="lazy"
                      decoding="async"
                      draggable="false"
                    />
                  </div>
                ))}
            </article>
          ))
        }
      </div>

      <div class="inner controls" data-dock>
        <DeckControls
          names={cards.map(c => (c.kind === 'slide' ? c.title : app.name))}
        />
      </div>
    </div>

    {
      voiced && (
        <div class="inner narr-static">
          <div class="narr-anchor" data-narr-anchor aria-hidden="true" />
        </div>
      )
    }
  </div>
</section>

<style>
  .apps {
    --gutter: clamp(1.25rem, 4vw, 2.5rem);
    --card-w: min(var(--content-max), calc(100vw - var(--gutter) * 2));
    --shot-top: calc(var(--stage-top) - 1.5rem);
    --shot-h: calc(100svh - var(--shot-top) - var(--stage-bottom) - 5rem);
    min-height: 100svh;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    display: flex;
    flex-direction: column;
    padding: var(--stage-top) 0 var(--stage-bottom);
    position: relative;
    overflow: clip;
  }

  .inner {
    width: var(--card-w);
    margin: 0 auto;
  }

  .decks {
    position: relative;
    flex: 1;
    display: grid;
  }

  .carousel {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    outline: none;
    transition: opacity var(--dur-quick) var(--ease);
  }

  .stage {
    touch-action: pan-y;
    display: grid;
    justify-items: center;
    transition: transform var(--dur-quick) var(--ease);
  }

  /* Words in the stories' text column, the picture in the rest. */
  .card {
    display: grid;
    grid-template-columns: var(--screen-cols);
    gap: var(--column-gap);
    align-items: start;
  }

  /* ---------- the peek ---------- */
  .is-welcome .slot {
    container-type: inline-size;
  }

  .is-welcome .shot {
    transform: var(--peek);
  }

  [data-peek='side'] {
    --peek: translateX(58cqw);
  }

  [data-peek='side-screen'] {
    --peek: translateX(38cqw);
  }

  .deck-card.is-handoff [data-deck-part='picture'],
  .deck-card.is-handoff .shot {
    transition: none;
  }

  .deck-card.is-handoff [data-deck-part='picture'] {
    opacity: 1;
    transform: none;
  }

  .is-flying {
    visibility: hidden;
  }

  .apps :global(svg) {
    flex: none;
  }

  .words {
    display: flex;
    flex-direction: column;
  }

  .lockup {
    display: flex;
    align-items: center;
  }

  .lockup.big {
    gap: 1rem;
  }

  .lockup.big .lockup-name {
    font-size: clamp(1.75rem, 3.2vw, 2.5rem);
    font-weight: 800;
    letter-spacing: var(--track-display);
    line-height: 0.95;
    white-space: nowrap;
  }

  .carousel.is-slide-turn .lockup.small {
    opacity: 1;
    transition: none;
  }

  .lockup.small {
    gap: 0.625rem;
    height: 2rem;
    margin-bottom: 1.25rem;
  }

  .lockup.small .lockup-name {
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: var(--track-heading);
  }

  .slide-title {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    font-weight: 800;
    letter-spacing: var(--track-heading);
    line-height: 1.05;
  }

  .desc {
    --cap-gap: 1.25rem;
  }

  .words .body + .body {
    margin-top: 0.875rem;
  }

  .is-welcome .body {
    max-width: none;
  }

  /* Song cue pill (DÁKITI in Sound Shaper) */
  .song-cue {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    align-self: flex-start;
    height: var(--float-h);
    margin-top: 1rem;
    padding: 0 1rem 0 0.875rem;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface) 82%, transparent);
    color: var(--ink);
    font: inherit;
    font-size: 0.875rem;
    cursor: pointer;
    transition:
      border-color var(--hover),
      background-color var(--hover);
  }

  .song-cue:hover {
    border-color: var(--ink-3);
  }

  .song-title {
    font-weight: 600;
  }

  .song-by {
    color: var(--ink-2);
  }

  .store-row :global(.stores) {
    margin-top: 1.25rem;
  }

  .lockup-name :global(.copy-link) {
    margin-left: 0.25rem;
  }

  .narr-slot {
    flex: none;
    height: var(--narrator-h);
    margin-top: 3rem;
  }

  /* ---------- Phone screenshots (Sound Shaper) ---------- */
  .slot {
    display: flex;
    justify-content: center;
    margin-top: calc(var(--shot-top) - var(--stage-top));
  }

  .shot:not(.is-desktop) {
    --shot-r: calc(var(--shot-h) * 0.06458);
    height: var(--shot-h);
    width: auto;
    max-width: none;
    border-radius: var(--shot-r) var(--shot-r) calc(var(--shot-r) * 1.136)
      calc(var(--shot-r) * 1.136);
    border: 1px solid var(--hairline);
    box-shadow:
      0 2rem 4rem rgba(0, 0, 0, 0.55),
      0 0.5rem 1.25rem rgba(0, 0, 0, 0.4);
    cursor: zoom-in;
  }

  /* ---------- Desktop 3:2 screens (Book Highlighter — PanelDeck standard) ---------- */
  .slot.is-screen-slot {
    margin-top: 0;
  }

  .screen.shot.is-desktop {
    position: relative;
    width: var(--screen-w);
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border: 1px solid var(--hairline);
    border-radius: var(--media-radius-flat);
    background: var(--ground);
    box-shadow:
      0 2rem 4rem rgba(0, 0, 0, 0.55),
      0 0.5rem 1.25rem rgba(0, 0, 0, 0.4);
    cursor: zoom-in;
  }

  .screen.shot.is-desktop .fill,
  .screen.shot.is-desktop .whole {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    display: block;
  }

  .screen.shot.is-desktop .fill {
    object-fit: cover;
    object-position: center;
    transform: scale(1.2);
    filter: blur(28px) saturate(1.22) brightness(0.55);
  }

  .screen.shot.is-desktop .whole {
    object-fit: contain;
    object-position: center;
  }

  .screen-caption {
    display: none;
  }

  /* A slide's phone or 3:2 screen leans toward the pointer (lib/tilt). */
  .is-slide .slot {
    perspective: 1600px;
  }

  .is-slide .shot {
    rotate: var(--tilt-rot, none);
  }

  /* ---------- the narrator's still anchor ---------- */
  .narr-static {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    pointer-events: none;
    translate: 0 0;
    transition: translate var(--dur-turn) var(--ease);
  }

  .narr-static .narr-anchor {
    margin-top: 0;
    transform: translate(var(--slot-x, 0px), var(--slot-y, 0px));
    transition: transform var(--dur-turn) var(--ease);
  }

  .controls {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: auto;
    padding-top: 1.5rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .narr-static .narr-anchor,
    .carousel,
    .stage {
      transition: none;
    }
  }

  @media (min-width: 48.01rem) {
    .apps {
      height: 100svh;
    }

    .controls {
      position: relative;
      z-index: 1;
    }

    .decks {
      min-height: 0;
      grid-template-rows: minmax(0, 1fr);
    }

    .carousel,
    .stage {
      min-height: 0;
    }
  }

  /* ---------- phones ---------- */
  @media (max-width: 48rem) {
    .apps {
      --shot-h: min(104vw, calc(100svh - var(--stage-top) - 22.5rem));
    }

    .decks {
      margin-top: 0.5rem;
    }

    .card,
    .is-welcome {
      grid-template-columns: 1fr;
      align-content: start;
      gap: 0.25rem;
    }

    .desc .slide-title + .body {
      margin-top: 0.75rem;
    }

    .words {
      position: relative;
      z-index: 1;
    }

    .slot {
      order: -1;
      margin-top: 0;
    }

    .is-welcome .slot {
      display: none;
    }

    .shot:not(.is-desktop) {
      box-shadow:
        var(--media-glow),
        0 2rem 4rem rgba(0, 0, 0, 0.55),
        0 0.5rem 1.25rem rgba(0, 0, 0, 0.4);
    }

    /* Desktop 3:2 screens on a phone adopt the exact PanelDeck 4:5 upright
       frame with the desktop capture centered whole over its blurred fill
       and the slide's title + app name overlaid on the bottom fade. */
    .screen.shot.is-desktop {
      width: 100%;
      aspect-ratio: var(--screen-ratio-m);
      max-height: var(--screen-max-m);
      box-shadow:
        var(--media-glow),
        0 2rem 4rem rgba(0, 0, 0, 0.55),
        0 0.5rem 1.25rem rgba(0, 0, 0, 0.4);
    }

    .screen-caption {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 2;
      display: flex;
      flex-direction: column;
      gap: 0.125rem;
      padding: 2.75rem 0.875rem 0.75rem;
      background: linear-gradient(
        to bottom,
        rgb(0 0 0 / 0) 0%,
        rgb(0 0 0 / 0.012) 8.1%,
        rgb(0 0 0 / 0.044) 15.5%,
        rgb(0 0 0 / 0.094) 22.5%,
        rgb(0 0 0 / 0.158) 29%,
        rgb(0 0 0 / 0.233) 35.3%,
        rgb(0 0 0 / 0.317) 41.2%,
        rgb(0 0 0 / 0.405) 47.1%,
        rgb(0 0 0 / 0.495) 52.9%,
        rgb(0 0 0 / 0.583) 58.8%,
        rgb(0 0 0 / 0.667) 64.7%,
        rgb(0 0 0 / 0.742) 71%,
        rgb(0 0 0 / 0.806) 77.5%,
        rgb(0 0 0 / 0.856) 84.5%,
        rgb(0 0 0 / 0.888) 91.9%,
        rgb(0 0 0 / 0.9) 100%
      );
      pointer-events: none;
    }

    .cap-name {
      font-size: 1.125rem;
      font-weight: 800;
      letter-spacing: var(--track-heading);
      line-height: 1.1;
      color: #fff;
    }

    .cap-name :global(.copy-link) {
      margin-left: 0.25rem;
      pointer-events: auto;
    }

    .cap-meta {
      font-size: 0.6875rem;
      color: rgb(255 255 255 / 0.72);
      text-transform: none;
      letter-spacing: 0;
    }

    .apps.is-desktop .is-slide .slide-title {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    .apps.is-desktop .is-slide .desc {
      --cap-gap: 0px;
    }

    .lockup.small {
      display: none;
    }

    .lockup.big {
      gap: 0.75rem;
      padding-top: 0.5rem;
    }

    .lockup.big .lockup-name {
      font-size: clamp(1.75rem, 8vw, 2.25rem);
    }

    .slide-title {
      font-size: 1.5rem;
    }

    .desc {
      --cap-gap: 1.25rem;
    }

    .words .body {
      font-size: 1rem;
      line-height: 1.5;
    }

    .narr-slot,
    .narr-static {
      display: none;
    }

    .store-row :global(.stores) {
      margin-top: 1.25rem;
    }

    .controls {
      width: auto;
      margin-top: 0;
      padding-top: 0;
    }
  }

  @media (max-width: 48rem) and (max-height: 46rem) {
    .card,
    .is-welcome {
      gap: 1rem;
    }

    .lockup.big {
      padding-top: 0;
    }

    .lockup.big .lockup-name {
      font-size: 1.625rem;
    }

    .desc {
      --cap-gap: 1rem;
    }

    .words .body {
      font-size: 0.9375rem;
      line-height: 1.45;
    }

    .store-row :global(.stores) {
      margin-top: 0.875rem;
    }
  }

  @media (min-width: 48.01rem) and (max-height: 50rem) {
    .words .body {
      font-size: 0.9375rem;
      line-height: 1.55;
    }

    .desc {
      --cap-gap: 0.875rem;
    }

    .words .body + .body {
      margin-top: 0.625rem;
    }

    .store-row :global(.stores) {
      margin-top: 1rem;
    }
  }
</style>

<script>
  import { createDeck, watchSlots, type Deck } from '../lib/deck';
  import { followPointer } from '../lib/tilt';
  import { dur, EASE } from '../lib/motion';

  for (const root of document.querySelectorAll<HTMLElement>('[data-apps]')) {
    const isDesktop = root.dataset.format === 'desktop';
    const decksEl = root.querySelector<HTMLElement>('[data-decks]')!;
    const paras = [...root.querySelectorAll<HTMLElement>('[data-narr-para]')];
    const still = decksEl.querySelector<HTMLElement>(
      '.narr-static .narr-anchor',
    );

    type Held = { el: HTMLElement; cards: HTMLElement[]; deck: Deck };
    const held: Held[] = [];
    const active = 0;

    const pageLeft = (el: HTMLElement) => {
      let x = 0;
      for (
        let n: HTMLElement | null = el;
        n;
        n = n.offsetParent as HTMLElement | null
      )
        x += n.offsetLeft;
      return x;
    };
    const standAnchor = () => {
      const h = held[active];
      const card = h?.cards[h.deck.current];
      const slot = card?.querySelector<HTMLElement>('.narr-slot');
      if (!still || !slot) return;
      const y =
        slot.getBoundingClientRect().top - decksEl.getBoundingClientRect().top;
      still.style.setProperty('--slot-y', `${y.toFixed(1)}px`);
      const x = pageLeft(slot) - pageLeft(still.parentElement ?? decksEl);
      still.style.setProperty('--slot-x', `${x.toFixed(1)}px`);
    };

    const select = (card: HTMLElement | undefined) => {
      if (!card) return;
      requestAnimationFrame(standAnchor);
      const first = card.querySelector<HTMLElement>('[data-narr-para]');
      if (!first) return;
      root.dataset.narrStart = String(paras.indexOf(first));
      document.dispatchEvent(new CustomEvent('narr:select', { detail: first }));
    };

    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const phoneOf = (card: HTMLElement) =>
      card.querySelector<HTMLElement>('.slot .shot');
    const pose = (img: HTMLElement) => {
      const r = img.getBoundingClientRect();
      const m = new DOMMatrix(getComputedStyle(img).transform);
      return {
        x: r.left + r.width / 2,
        y: r.top + r.height / 2,
        w: img.offsetWidth,
        h: img.offsetHeight,
        turn: (Math.atan2(m.b, m.a) * 180) / Math.PI,
      };
    };
    const unscaled = (css: string, scale: number) =>
      css.replace(
        /(-?[\d.]+)px/g,
        (_, n) => `${(Number(n) / scale).toFixed(2)}px`,
      );
    let flying = false;
    const wakeImg = (img?: HTMLImageElement | null) => {
      if (img?.dataset.src) {
        img.src = img.dataset.src;
        img.removeAttribute('data-src');
      }
    };
    const wakeCard = (card?: HTMLElement) => {
      if (!card) return;
      for (const img of card.querySelectorAll<HTMLImageElement>('img'))
        wakeImg(img);
    };
    const handOff = (from: HTMLElement, to: HTMLElement) => {
      wakeCard(from);
      wakeCard(to);
      if (reduced) return;
      const a = phoneOf(from);
      const b = phoneOf(to);
      if (!a || !b || !a.offsetHeight || !b.offsetHeight) return;
      const start = pose(a);
      to.classList.add('is-handoff');
      const end = pose(b);
      a.classList.add('is-flying');
      b.classList.add('is-flying');

      flying = true;
      const look = getComputedStyle(a);
      const ghost = a.cloneNode(true) as HTMLElement;
      ghost.removeAttribute('class');
      ghost.removeAttribute('style');
      if (isDesktop) ghost.classList.add('screen', 'shot', 'is-desktop');
      const box = root.getBoundingClientRect();
      Object.assign(ghost.style, {
        position: 'absolute',
        willChange: 'transform',
        left: `${start.x - start.w / 2 - box.left}px`,
        top: `${start.y - start.h / 2 - box.top}px`,
        width: `${start.w}px`,
        height: `${start.h}px`,
        margin: '0',
        maxWidth: 'none',
        zIndex: '20',
        pointerEvents: 'none',
        borderRadius: look.borderRadius,
        border: look.border,
        boxShadow: look.boxShadow,
        overflow: 'hidden',
      });
      root.append(ghost);
      const scale = end.h / start.h;
      const scaleX = end.w / start.w;
      const goal = getComputedStyle(b);
      const flight = ghost.animate(
        [
          { transform: `rotate(${start.turn}deg)` },
          {
            transform:
              `translate(${end.x - start.x}px, ${end.y - start.y}px) ` +
              `scale(${scaleX}, ${scale}) rotate(${end.turn}deg)`,
          },
        ],
        { duration: dur('turn'), easing: EASE, fill: 'forwards' },
      );
      let landed = false;
      const land = () => {
        if (landed) return;
        landed = true;
        flying = false;
        a.classList.remove('is-flying');
        b.classList.remove('is-flying');
        to.classList.remove('is-handoff');
        flight.cancel();
        ghost.style.transform =
          `translate(${end.x - start.x}px, ${end.y - start.y}px) ` +
          `scale(${scaleX}, ${scale}) rotate(${end.turn}deg)`;
        ghost.style.borderRadius = unscaled(goal.borderRadius, scale);
        ghost.style.boxShadow = 'none';
        ghost
          .animate(
            { opacity: [1, 0] },
            { duration: dur('micro'), easing: 'linear' },
          )
          .finished.finally(() => ghost.remove());
      };
      flight.onfinish = land;
      flight.oncancel = land;
    };

    if (!isDesktop && matchMedia('(max-width: 48rem)').matches)
      for (const card of root.querySelectorAll<HTMLElement>('.is-slide')) {
        const title = card.querySelector<HTMLElement>('.slide-title');
        const desc = card.querySelector<HTMLElement>('.desc');
        if (title && desc) desc.prepend(title);
      }

    for (const el of root.querySelectorAll<HTMLElement>('[data-apps-deck]')) {
      const cards = [...el.querySelectorAll<HTMLElement>('.deck-card')];
      const h = { el, cards } as Held;
      let previous = 0;
      let slideTurn = 0;
      h.deck = createDeck({
        cards,
        controls: el.querySelector('[data-deck-controls]'),
        keys: el,
        swipe: el.querySelector<HTMLElement>('.stage'),
        onChange: current => {
          if (h.deck) {
            wakeCard(cards[current]);
            wakeCard(cards[(current + 1) % cards.length]);
            wakeCard(cards[(current - 1 + cards.length) % cards.length]);
          }
          if (
            h.deck &&
            previous !== current &&
            (previous === 0 || current === 0)
          )
            handOff(cards[previous], cards[current]);
          if (h.deck && previous !== current && previous > 0 && current > 0) {
            el.classList.add('is-slide-turn');
            clearTimeout(slideTurn);
            slideTurn = window.setTimeout(
              () => el.classList.remove('is-slide-turn'),
              dur('quick') + 100,
            );
          }
          previous = current;
          requestAnimationFrame(() => {
            if (held.indexOf(h) === active) select(cards[current]);
          });
        },
      });
      for (const shot of el.querySelectorAll<HTMLElement>(
        '.shot[data-shot-at]',
      )) {
        let down: { x: number; y: number } | null = null;
        shot.addEventListener('pointerdown', e => {
          down = { x: e.clientX, y: e.clientY };
        });
        shot.addEventListener('click', e => {
          if ((e.target as HTMLElement).closest('.copy-link')) return;
          if (down && Math.hypot(e.clientX - down.x, e.clientY - down.y) > 12)
            return;
          const items = el.dataset.viewerItems;
          if (!items) return;
          document.dispatchEvent(
            new CustomEvent('viewer:open', {
              detail: {
                items: JSON.parse(items),
                at: Number(shot.dataset.shotAt ?? 0),
                phone: !isDesktop,
              },
            }),
          );
        });
      }
      held.push(h);
    }

    addEventListener('resize', () => {
      standAnchor();
    });

    document.addEventListener('narr:para', e => {
      const p = (e as CustomEvent<HTMLElement>).detail;
      if (!root.contains(p)) return;
      const c = Number(p.dataset.card);
      const h = held[active];
      if (h && c !== h.deck.current) h.deck.go(c);
    });

    followPointer(root, () => {
      if (flying) return null;
      const h = held[active];
      return h.cards[h.deck.current]?.querySelector<HTMLElement>(
        '.is-slide .shot',
      );
    });

    const idle = (fn: () => void) =>
      'requestIdleCallback' in window
        ? requestIdleCallback(fn, { timeout: 2000 })
        : setTimeout(fn, 200);
    const warm = () => {
      const queue = held.flatMap(h => [
        ...h.el.querySelectorAll<HTMLImageElement>('img'),
      ]);
      const next = () => {
        const img = queue.shift();
        if (!img) return;
        wakeImg(img);
        img.loading = 'eager';
        img
          .decode()
          .catch(() => {})
          .finally(() => idle(next));
      };
      idle(next);
    };
    const spare = (
      navigator as Navigator & { connection?: { saveData?: boolean } }
    ).connection?.saveData;
    if (!spare) {
      new IntersectionObserver(
        ([e], io) => {
          if (!e.isIntersecting) return;
          io.disconnect();
          wakeCard(held[active]?.cards[1]);
          warm();
        },
        { threshold: 0.25 },
      ).observe(root);
    }

    select(held[0].cards[0]);
    standAnchor();
    document.fonts?.ready.then(standAnchor);
    addEventListener('load', standAnchor);
    watchSlots(
      held.flatMap(h => h.cards),
      standAnchor,
    );
  }
</script>
