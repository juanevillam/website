---
import AppTile from './AppTile.astro';
import DeckControls from './DeckControls.astro';
import StoreBadges from './StoreBadges.astro';
import T from './T.astro';
import type { UIKey } from '../i18n/ui';
import type { AppStory } from '../lib/apps';
import { clipFor, subsFor } from '../lib/narration';
import { sceneAttr, sceneOf } from '../lib/scene';

/**
 * THE APPS — every app the landing tells, in ONE panel (2026-10-11). Two
 * stories took four screens of scroll and a third took six, before the
 * page reached anything else; the section is now one screen however many
 * apps it holds, and each app still tells its whole story: a WELCOME card
 * (the pitch — the problem, then the answer — and the store row) and its
 * four cards.
 *
 * THREE LAYOUTS of the same cards, so Juan can choose by looking:
 *
 *  - `chain` (the landing) — ONE deck: Sound Shaper's five cards, then
 *    Topper's, then Booker's. Past an app's last card the next app's
 *    welcome comes in. Chapters at the top — one per app — say which app
 *    is in front, fill as its cards go by, and jump to its welcome.
 *  - `tabs` — a segmented control picks the app; the deck below holds only
 *    that app's five cards.
 *  - `cards` — the apps side by side as tiles; one opens full screen over
 *    the page with its deck.
 *
 * A deck inside a deck was the first idea and is not one of them: two
 * sideways swipes nested on a phone fight for the same gesture.
 *
 * Every card is the page's deck card (lib/deck.ts, `.deck-card` in
 * global.css), so the turn is the one More Work and Events turn with.
 *
 * NARRATION: the section is one narrated PANEL — every paragraph of every
 * app, in order — under ONE still narrator that the cards slide under (the
 * More Work arrangement). A clip ending moves the voice to the next
 * paragraph, and whatever shows that paragraph follows it: the deck turns,
 * the tab switches, the tile opens. The director (scripts/director.ts)
 * runs the session; this file only maps paragraphs to cards.
 */
type Props = {
  apps: AppStory[];
  layout: 'chain' | 'tabs' | 'cards';
};

const { apps, layout } = Astro.props;

const narrate = (k: UIKey) => ({ k, clip: clipFor(k), subs: subsFor(k) });

// PHONE copy by convention: `x.problem` → `x.problem.m`, `x.sN.pM` → `x.sN.m`.
const mobileKey = (k: string) =>
  (/\.p\d+$/.test(k) ? k.replace(/\.p\d+$/, '.m') : `${k}.m`) as UIKey;

type Card =
  | { kind: 'welcome'; app: number; paras: UIKey[] }
  | {
      kind: 'slide';
      app: number;
      paras: UIKey[];
      title: string;
      src: string;
      width: number;
      height: number;
      scene: string;
    };

// The cards of every app, in telling order, numbered across the whole
// section — `data-card` is that number, whichever deck holds the card.
const cards: Card[] = [];
for (const [a, app] of apps.entries()) {
  cards.push({ kind: 'welcome', app: a, paras: app.pitch });
  for (const slide of app.slides)
    cards.push({
      kind: 'slide',
      app: a,
      paras: slide.paras,
      title: slide.title,
      src: slide.src,
      width: slide.width,
      height: slide.height,
      scene: sceneAttr(await sceneOf(slide.src)),
    });
}
const numbered = cards.map((card, n) => ({ ...card, n }));
const voiced = cards.some(c => c.paras.some(k => clipFor(k)));

// The chain is ONE deck of every card; the other two hold a deck per app.
const decks =
  layout === 'chain'
    ? [{ app: -1, cards: numbered }]
    : apps.map((_, a) => ({ app: a, cards: numbered.filter(c => c.app === a) }));
---

<section
  class="apps"
  id="apps"
  data-apps={layout}
  data-narr-panel={voiced ? '' : null}
  data-phone-scene
>
  <div class="inner head">
    {
      layout === 'chain' && (
        <nav class="chapters" aria-label="Apps">
          {apps.map((app, a) => (
            <button class="chapter" type="button" data-chapter={a}>
              <AppTile app={app.id} size={28} />
              <span class="chapter-name">{app.name}</span>
              <span class="chapter-bar" aria-hidden="true">
                <i />
              </span>
            </button>
          ))}
        </nav>
      )
    }
    {
      layout !== 'chain' && (
        <h2 class="label eyebrow">
          <T k="apps.title" />
        </h2>
      )
    }
    {
      layout === 'tabs' && (
        <div class="seg" role="tablist">
          {apps.map((app, a) => (
            <button class="seg-tab" type="button" role="tab" data-tab={a}>
              <AppTile app={app.id} size={22} />
              <span class="seg-name">{app.name}</span>
            </button>
          ))}
        </div>
      )
    }
  </div>

  {
    layout === 'cards' && (
      <div class="inner overview" data-reveal>
        {apps.map((app, a) => (
          <button class="tile" type="button" data-open={a}>
            <span class="tile-head">
              <AppTile app={app.id} size={48} />
              <span class="tile-name">{app.name}</span>
              <span class="tile-plus" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="16" height="16">
                  <path
                    d="M12 5v14M5 12h14"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                  />
                </svg>
              </span>
            </span>
            <span class="tile-line">
              <T k={mobileKey(app.pitch[0])} />
            </span>
            <span class="tile-peek">
              <img
                src={app.slides[0].src}
                alt=""
                width={app.slides[0].width}
                height={app.slides[0].height}
                loading="lazy"
                decoding="async"
                draggable="false"
              />
            </span>
          </button>
        ))}
        <div class="overview-narr">
          {voiced && <div class="narr-anchor" data-narr-anchor aria-hidden="true" />}
        </div>
      </div>
    )
  }

  <div class:list={['decks', layout === 'cards' && 'sheet']} data-decks>
    {
      layout === 'cards' && (
        <button class="sheet-close" type="button" data-close>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path
              d="M6 6l12 12M18 6 6 18"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            />
          </svg>
          <span class="sr">Close</span>
        </button>
      )
    }

    {
      decks.map(deck => (
        <div
          class="carousel"
          data-apps-deck={deck.app}
          tabindex="0"
          aria-roledescription="carousel"
          aria-label={deck.app < 0 ? 'Apps' : apps[deck.app].name}
        >
          <div class="stage" data-reveal>
            {deck.cards.map(card => {
              const app = apps[card.app];
              return (
                <article
                  class:list={['card', 'deck-card', `is-${card.kind}`]}
                  aria-roledescription="slide"
                  data-scene={card.kind === 'slide' ? card.scene : null}
                >
                  <div class="words">
                    {card.kind === 'welcome' ? (
                      <div class="lockup big" data-deck-part="text" style="--i: 1">
                        <AppTile app={app.id} size={76} />
                        <h3 class="lockup-name">{app.name}</h3>
                      </div>
                    ) : (
                      <>
                        <div class="lockup small" data-deck-part="text" style="--i: 0">
                          <AppTile app={app.id} size={30} />
                          <span class="lockup-name">{app.name}</span>
                        </div>
                        <h3 class="slide-title" data-deck-part="text" style="--i: 1">
                          {card.title}
                        </h3>
                      </>
                    )}
                    {card.paras.map(narrate).map(({ k, clip, subs }, i) => (
                      <p
                        class="body full"
                        data-deck-part="text"
                        style={`--i: ${i + 2}`}
                        data-narr-para
                        data-card={card.n}
                        data-app={card.app}
                        data-clip-en={clip?.en}
                        data-clip-es={clip?.es}
                        data-subs-en={subs.en}
                        data-subs-es={subs.es}
                      >
                        <T k={k} />
                      </p>
                    ))}
                    {/* The phone's short version — the welcome's two
                        paragraphs each have one, a slide's share one. */}
                    {(card.kind === 'welcome' ? card.paras : card.paras.slice(0, 1)).map(
                      (k, i) => (
                        <p class="body short" data-deck-part="text" style={`--i: ${i + 2}`}>
                          <T k={mobileKey(k)} />
                        </p>
                      )
                    )}
                    {card.kind === 'welcome' && (
                      <div class="store-row" data-deck-part="text" style="--i: 4">
                        <StoreBadges app={app.id} />
                      </div>
                    )}
                    {voiced && <div class="narr-slot" aria-hidden="true" />}
                  </div>

                  {card.kind === 'welcome' ? (
                    /* The welcome's picture is the APP ITSELF — its icon,
                       large, the cover of its chapter — so the first phone
                       is not shown twice in a row. */
                    <div class="emblem" data-deck-part="picture">
                      <AppTile app={app.id} size={220} />
                    </div>
                  ) : (
                    <div class="slot" data-deck-part="picture">
                      <img
                        class="shot"
                        src={card.src}
                        alt={`${app.name} — ${card.title}`}
                        width={card.width}
                        height={card.height}
                        loading="lazy"
                        decoding="async"
                        draggable="false"
                      />
                    </div>
                  )}
                </article>
              );
            })}
          </div>

          <div class="inner controls" data-dock>
            <DeckControls
              names={deck.cards.map(c =>
                c.kind === 'slide' ? `${apps[c.app].name} — ${c.title}` : apps[c.app].name
              )}
            />
          </div>
        </div>
      ))
    }

    {/* The ONE narrator's anchor, outside every deck: the cards slide
        under it, and the script stands it on the front card's slot. In the
        `cards` layout it moves between the overview and the open sheet. */}
    {
      voiced && layout !== 'cards' && (
        <div class="inner narr-static">
          <div class="narr-anchor" data-narr-anchor aria-hidden="true" />
        </div>
      )
    }
    {voiced && layout === 'cards' && <div class="inner narr-static" />}
  </div>
</section>

<style>
  .apps {
    --gutter: clamp(1.25rem, 4vw, 2.5rem);
    --card-w: min(var(--content-max), calc(100vw - var(--gutter) * 2));
    /* The phone's height: the panel, less its insets, the head row and
       the controls' row. */
    --shot-h: calc(100svh - var(--stage-top) - var(--stage-bottom) - 9rem);
    min-height: 100svh;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    display: flex;
    flex-direction: column;
    padding: var(--stage-top) 0 var(--stage-bottom);
    overflow-x: clip;
  }

  .inner {
    width: var(--card-w);
    margin: 0 auto;
  }

  /* ---------- the head row ---------- */

  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 2.5rem;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    height: 2rem;
  }

  /* Chapters: one per app, the one in front lit and filling as its cards
     go by — the deck's progress, told per app instead of as fifteen dots. */
  .chapters {
    display: flex;
    gap: 0.5rem;
  }

  .chapter {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.625rem;
    height: var(--float-h);
    padding: 0 1rem 0 0.375rem;
    border: 1px solid transparent;
    border-radius: 999px;
    background: none;
    color: var(--ink-3);
    font: inherit;
    cursor: pointer;
    transition:
      color var(--dur-micro) var(--ease),
      border-color var(--dur-micro) var(--ease),
      background var(--dur-micro) var(--ease);
  }

  .chapter :global(svg) {
    opacity: 0.45;
    transition: opacity var(--dur-micro) var(--ease);
  }

  .chapter:hover {
    color: var(--ink-2);
  }

  .chapter.is-current {
    color: var(--ink);
    border-color: var(--hairline);
    background: color-mix(in srgb, var(--surface) 82%, transparent);
  }

  .chapter.is-current :global(svg) {
    opacity: 1;
  }

  .chapter-name {
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: var(--track-heading);
    white-space: nowrap;
  }

  .chapter-bar {
    position: absolute;
    left: 1rem;
    right: 1rem;
    bottom: 0.3rem;
    height: 2px;
    border-radius: 2px;
    background: var(--hairline);
    overflow: hidden;
    opacity: 0;
    transition: opacity var(--dur-micro) var(--ease);
  }

  .chapter.is-current .chapter-bar {
    opacity: 1;
  }

  .chapter-bar i {
    display: block;
    height: 100%;
    width: calc(var(--fill, 0) * 100%);
    background: var(--ink);
    transition: width var(--beat) var(--ease);
  }

  /* Tabs: the header pills' recipe, the picked one filled in ink. */
  .seg {
    display: flex;
    padding: 0.25rem;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface) 82%, transparent);
  }

  .seg-tab {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    height: 2.25rem;
    padding: 0 1rem 0 0.375rem;
    border: none;
    border-radius: 999px;
    background: none;
    color: var(--ink-2);
    font: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    transition:
      background var(--dur-micro) var(--ease),
      color var(--dur-micro) var(--ease);
  }

  .seg-tab[aria-selected='true'] {
    background: var(--ink);
    color: var(--ground);
  }

  /* ---------- the decks ---------- */

  .decks {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    margin-top: 1.5rem;
  }

  .carousel {
    flex: 1;
    display: flex;
    flex-direction: column;
    outline: none;
  }

  .carousel[hidden] {
    display: none;
  }

  .stage {
    touch-action: pan-y;
    display: grid;
    justify-items: center;
  }

  /* Words in the stories' text column, the picture in the rest. */
  .card {
    display: grid;
    grid-template-columns: calc(100% * 6 / 13 * 0.81) 1fr;
    gap: var(--space-4);
    align-items: start;
  }

  /* The welcome's pitch reads in the opener's wider column (1.5x), so two
     paragraphs and the store row still stand inside the panel. */
  .is-welcome {
    grid-template-columns: calc(100% * 6 / 13 * 0.81 * 1.5) 1fr;
    align-items: center;
  }

  /* An icon keeps its drawn size; a flex row would squeeze the SVG. */
  .apps :global(svg) {
    flex: none;
  }

  .words {
    display: flex;
    flex-direction: column;
  }

  .lockup {
    display: flex;
    align-items: center;
  }

  .lockup.big {
    gap: 1.25rem;
    margin-bottom: 0.75rem;
  }

  .lockup.big .lockup-name {
    font-size: clamp(2.5rem, 5.5vw, 4.25rem);
    font-weight: 800;
    letter-spacing: var(--track-display);
    line-height: 0.95;
    white-space: nowrap;
  }

  .lockup.small {
    gap: 0.625rem;
    height: 2rem;
    margin-bottom: 1.25rem;
  }

  .lockup.small .lockup-name {
    font-size: 1.125rem;
    font-weight: 800;
    letter-spacing: var(--track-heading);
  }

  .slide-title {
    font-size: clamp(2rem, 4vw, 3.25rem);
    font-weight: 800;
    letter-spacing: var(--track-display);
    line-height: 0.95;
  }

  .words .body {
    margin-top: 1.25rem;
  }

  .words .body + .body {
    margin-top: 0.875rem;
  }

  /* The welcome's pitch reads in longer rows. */
  .is-welcome .body {
    max-width: none;
  }

  .short {
    display: none;
  }

  .store-row :global(.stores) {
    margin-top: 1.75rem;
  }

  .narr-slot {
    flex: none;
    height: var(--narrator-h);
    margin-top: 1.5rem;
  }

  /* The phone: the panel's height, its own corner — the stories' recipe. */
  .slot {
    display: flex;
    justify-content: center;
  }

  .shot {
    height: var(--shot-h);
    width: auto;
    max-width: none;
    border-radius: var(--media-radius) var(--media-radius)
      calc(var(--media-radius) * 1.136) calc(var(--media-radius) * 1.136);
    border: 1px solid var(--hairline);
    box-shadow:
      0 2rem 4rem rgba(0, 0, 0, 0.55),
      0 0.5rem 1.25rem rgba(0, 0, 0, 0.4);
  }

  /* The welcome's emblem: the icon, large, in the picture's place. */
  .emblem {
    display: grid;
    place-items: center;
    min-height: var(--shot-h);
  }

  /* ---------- the narrator's still anchor ---------- */

  .narr-static {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    pointer-events: none;
  }

  .narr-static .narr-anchor {
    margin-top: 0;
    transform: translateY(var(--slot-y, 0px));
    transition: transform calc(var(--beat) * 0.75) var(--ease);
  }

  .controls {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    margin-top: auto;
    padding-top: 1.5rem;
  }

  /* The chain's progress is the chapters; fifteen dots would only repeat
     it, smaller. */
  [data-apps='chain'] .controls :global(.dots) {
    display: none;
  }

  /* ---------- cards: the overview and its sheet ---------- */

  .overview {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    margin-top: 1.5rem;
    flex: 1;
  }

  .tile {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 0;
    height: calc(100svh - var(--stage-top) - var(--stage-bottom) - 8rem);
    padding: 1.5rem 1.5rem 0;
    overflow: hidden;
    border: 1px solid var(--hairline);
    border-radius: var(--media-radius-flat);
    background: var(--surface);
    color: var(--ink);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition:
      transform calc(var(--beat) / 2) var(--ease),
      border-color var(--dur-micro) var(--ease);
  }

  .tile:hover {
    transform: translateY(-4px);
    border-color: var(--ink-3);
  }

  .tile-head {
    display: flex;
    align-items: center;
    gap: 0.875rem;
  }

  .tile-name {
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: var(--track-heading);
  }

  .tile-plus {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    margin-left: auto;
    border-radius: 999px;
    background: var(--hairline);
    color: var(--ink-2);
  }

  .tile-line {
    margin-top: 1rem;
    color: var(--ink-body);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .tile-peek {
    flex: 1;
    min-height: 0;
    display: flex;
    justify-content: center;
    margin-top: 1.5rem;
    overflow: hidden;
  }

  .tile-peek img {
    width: 72%;
    height: auto;
    max-width: none;
    align-self: flex-start;
    border: 1px solid var(--hairline);
    border-radius: calc(var(--media-radius) * 0.8);
  }

  .overview-narr {
    grid-column: 1 / -1;
  }

  /* The sheet: the open app, over the whole page, on the ground. */
  .sheet {
    position: fixed;
    inset: 0;
    z-index: 30;
    margin: 0;
    padding: var(--stage-top) 0 var(--stage-bottom);
    background: color-mix(in srgb, var(--ground) 94%, transparent);
    backdrop-filter: blur(24px);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity calc(var(--beat) / 2) var(--ease),
      visibility 0s linear calc(var(--beat) / 2);
  }

  .sheet.is-open {
    opacity: 1;
    visibility: visible;
    transition:
      opacity calc(var(--beat) / 2) var(--ease),
      visibility 0s;
  }

  .sheet-close {
    position: absolute;
    top: calc(var(--float-gap) + 3.5rem);
    right: var(--gutter);
    z-index: 2;
    display: grid;
    place-items: center;
    width: var(--float-h);
    height: var(--float-h);
    border: 1px solid var(--hairline);
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface) 82%, transparent);
    color: var(--ink);
    cursor: pointer;
  }

  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .narr-static .narr-anchor,
    .chapter-bar i {
      transition: none;
    }
  }

  /* ---------- phones ---------- */

  @media (max-width: 48rem) {
    .apps {
      --shot-h: min(112vw, calc(100svh - var(--stage-top) - 19rem));
    }

    .head {
      justify-content: center;
      flex-wrap: wrap;
    }

    .chapter {
      padding: 0 0.375rem;
    }

    .chapter-name,
    .seg-name {
      display: none;
    }

    .chapter-bar {
      left: 0.5rem;
      right: 0.5rem;
      bottom: 0.15rem;
    }

    .seg-tab {
      padding: 0 0.625rem;
    }

    .decks {
      margin-top: 1rem;
    }

    /* One centred column: the picture on top, the words under it. */
    .card {
      grid-template-columns: 1fr;
      align-content: start;
      gap: var(--media-gap-m);
    }

    .words {
      position: relative;
      z-index: 1;
      align-items: center;
      text-align: center;
    }

    .slot,
    .emblem {
      order: -1;
    }

    .shot {
      box-shadow:
        var(--media-glow),
        0 2rem 4rem rgba(0, 0, 0, 0.55),
        0 0.5rem 1.25rem rgba(0, 0, 0, 0.4);
    }

    .emblem {
      min-height: 0;
      padding-top: 1rem;
    }

    .emblem :global(svg) {
      width: 9rem;
      height: 9rem;
    }

    .lockup.small {
      display: none;
    }

    .lockup.big .lockup-name {
      font-size: clamp(1.75rem, 8vw, 2.25rem);
    }

    .lockup.big :global(svg) {
      display: none;
    }

    .slide-title {
      font-size: clamp(1.75rem, 7vw, 2.25rem);
    }

    .words .body {
      margin-top: 0.75rem;
      font-size: 1rem;
      line-height: 1.5;
    }

    .full,
    .narr-slot,
    .narr-static {
      display: none;
    }

    .short {
      display: block;
    }

    .store-row :global(.stores) {
      justify-content: center;
      margin-top: 1.25rem;
    }

    .controls {
      width: auto;
      margin-top: 0;
      padding-top: 0;
    }

    .overview {
      grid-template-columns: 1fr;
      gap: 0.875rem;
    }

    .tile {
      height: auto;
      padding-bottom: 1.25rem;
    }

    .tile-peek {
      display: none;
    }

    /* The sheet covers the header, so its ✕ takes the header's corner. */
    .sheet-close {
      top: calc(var(--float-gap) + env(safe-area-inset-top));
    }
  }
</style>

<script>
  import { createDeck, watchSlots, type Deck } from '../lib/deck';

  for (const root of document.querySelectorAll<HTMLElement>('[data-apps]')) {
    const layout = root.dataset.apps as 'chain' | 'tabs' | 'cards';
    const decksEl = root.querySelector<HTMLElement>('[data-decks]')!;
    const carousels = [...root.querySelectorAll<HTMLElement>('[data-apps-deck]')];
    const paras = [...root.querySelectorAll<HTMLElement>('[data-narr-para]')];
    const chapters = [...root.querySelectorAll<HTMLElement>('[data-chapter]')];
    const tabs = [...root.querySelectorAll<HTMLElement>('[data-tab]')];
    const anchor = root.querySelector<HTMLElement>('[data-narr-anchor]');
    const still = decksEl.querySelector<HTMLElement>('.narr-static');

    // What every card is: its number across the section and its app.
    const meta = (card: HTMLElement) => {
      const p = card.querySelector<HTMLElement>('[data-narr-para]');
      return { n: Number(p?.dataset.card), app: Number(p?.dataset.app) };
    };

    type Held = { el: HTMLElement; cards: HTMLElement[]; deck: Deck };
    const held: Held[] = [];
    let active = 0;

    const front = () => {
      const h = held[layout === 'chain' ? 0 : active];
      return h?.cards[h.deck.current];
    };

    // Stand the still anchor on the front card's slot.
    const standAnchor = () => {
      const slot = front()?.querySelector<HTMLElement>('.narr-slot');
      if (!still?.firstElementChild || !slot) return;
      const y = slot.getBoundingClientRect().top - decksEl.getBoundingClientRect().top;
      (still.firstElementChild as HTMLElement).style.setProperty('--slot-y', `${y.toFixed(1)}px`);
    };

    // The chapters follow the card in front: which app, and how far in.
    const markChapters = (card: HTMLElement) => {
      const { n, app } = meta(card);
      const cards = held[0].cards;
      const first = cards.findIndex(c => meta(c).app === app);
      const count = cards.filter(c => meta(c).app === app).length;
      const at = cards.findIndex(c => meta(c).n === n);
      chapters.forEach((ch, a) => {
        ch.classList.toggle('is-current', a === app);
        ch.toggleAttribute('aria-current', a === app);
        ch.style.setProperty('--fill', a === app ? String((at - first + 1) / count) : '0');
      });
    };

    const select = (card: HTMLElement | undefined) => {
      if (!card) return;
      requestAnimationFrame(standAnchor);
      if (layout === 'chain') markChapters(card);
      // The narrator starts this panel on the card in front, and a running
      // voice switches to it.
      const first = card.querySelector<HTMLElement>('[data-narr-para]');
      if (!first) return;
      root.dataset.narrStart = String(paras.indexOf(first));
      document.dispatchEvent(new CustomEvent('narr:select', { detail: first }));
    };

    for (const el of carousels) {
      const cards = [...el.querySelectorAll<HTMLElement>('.deck-card')];
      const h = {} as Held;
      h.el = el;
      h.cards = cards;
      h.deck = createDeck({
        cards,
        controls: el.querySelector('[data-deck-controls]'),
        keys: el,
        swipe: el.querySelector<HTMLElement>('.stage'),
        onChange: current => {
          // The first call comes while the deck is still being made.
          requestAnimationFrame(() => {
            if (held.indexOf(h) === (layout === 'chain' ? 0 : active)) select(cards[current]);
          });
        },
      });
      held.push(h);
    }

    // Tabs and cards: one app's deck at a time, opened on its welcome.
    const sheet = layout === 'cards' ? decksEl : null;
    const overviewSpot = root.querySelector<HTMLElement>('.overview-narr');

    const show = (a: number, fromStart = true) => {
      active = a;
      held.forEach((h, i) => (h.el.hidden = i !== a));
      tabs.forEach((t, i) => t.setAttribute('aria-selected', String(i === a)));
      const h = held[a];
      if (fromStart && h.deck.current !== 0) h.deck.go(0, -1);
      else select(h.cards[h.deck.current]);
      h.el.focus({ preventScroll: true });
    };

    const open = (a: number, fromStart = true) => {
      if (!sheet) return;
      if (anchor && still) still.append(anchor);
      sheet.classList.add('is-open');
      document.documentElement.style.overflow = 'hidden';
      show(a, fromStart);
    };

    const close = () => {
      if (!sheet) return;
      sheet.classList.remove('is-open');
      document.documentElement.style.overflow = '';
      if (anchor && overviewSpot) overviewSpot.append(anchor);
    };

    if (layout === 'chain') {
      chapters.forEach((ch, a) =>
        ch.addEventListener('click', () => {
          const cards = held[0].cards;
          const i = cards.findIndex(c => meta(c).app === a);
          if (i >= 0 && i !== held[0].deck.current) held[0].deck.go(i);
        })
      );
      select(held[0].cards[0]);
    } else if (layout === 'tabs') {
      tabs.forEach((t, a) => t.addEventListener('click', () => show(a)));
      show(0);
    } else {
      held.forEach((h, i) => (h.el.hidden = i !== 0));
      root.querySelectorAll<HTMLElement>('[data-open]').forEach(b =>
        b.addEventListener('click', () => open(Number(b.dataset.open)))
      );
      root.querySelector('[data-close]')?.addEventListener('click', close);
      document.addEventListener('keydown', e => {
        if (e.key === 'Escape' && sheet?.classList.contains('is-open')) close();
      });
      root.dataset.narrStart = '0';
    }

    // The voice moved on by itself: whatever shows its paragraph follows —
    // the deck turns, the tab switches, the sheet opens.
    document.addEventListener('narr:para', e => {
      const p = (e as CustomEvent<HTMLElement>).detail;
      if (!root.contains(p)) return;
      const card = p.closest<HTMLElement>('.deck-card');
      const a = Number(p.dataset.app);
      if (!card) return;
      if (layout === 'tabs' && a !== active) show(a, false);
      if (layout === 'cards' && (!sheet?.classList.contains('is-open') || a !== active))
        open(a, false);
      const h = held[layout === 'chain' ? 0 : a];
      const i = h.cards.indexOf(card);
      if (i >= 0 && i !== h.deck.current) h.deck.go(i);
    });

    window.addEventListener('resize', standAnchor, { passive: true });
    watchSlots(held.flatMap(h => h.cards), standAnchor);
  }
</script>
