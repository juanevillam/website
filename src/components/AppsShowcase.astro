---
import AppTile from './AppTile.astro';
import DeckControls from './DeckControls.astro';
import StoreBadges from './StoreBadges.astro';
import T from './T.astro';
import type { UIKey } from '../i18n/ui';
import type { AppStory } from '../lib/apps';
import { clipFor, subsFor } from '../lib/narration';
import { sceneAttr, sceneOf } from '../lib/scene';

/**
 * THE APPS — every app the landing tells, in ONE panel (2026-10-11). Two
 * stories took four screens of scroll and a third would have taken six
 * before the page reached anything else; the section is now one screen
 * however many apps it holds, and each app still tells its whole story: a
 * WELCOME card (the pitch — the problem, then the answer — and the store
 * row) and its four cards.
 *
 * TABS, chosen over two other layouts built beside it the same day: one
 * deck that chained every app's cards with chapters above it, and tiles
 * that opened full screen. A deck inside a deck was never one of them —
 * two sideways swipes nested on a phone fight for the same gesture.
 *
 * THE SWITCHER FLOATS AT THE HEADER'S HEIGHT, centred between its pills
 * and built by their recipe (Juan, 2026-10-11): standing in the panel, it
 * took a row from the phone. It shows while the panel holds the screen and
 * goes with it. The picked app's pill is a grey lozenge that SLIDES to the
 * tab you pick, and the app's deck slides in from that side.
 *
 * Every card is the page's deck card (lib/deck.ts, `.deck-card` in
 * global.css), so a turn is the one More Work and Events turn with.
 *
 * NARRATION: the section is one narrated PANEL — every paragraph of every
 * app, in order — under ONE still narrator that the cards slide under (the
 * More Work arrangement). A clip ending moves the voice on, and whatever
 * shows the next paragraph follows it: the deck turns, and past an app's
 * last card the tab switches. The director (scripts/director.ts) runs the
 * session; this file only maps paragraphs to cards.
 */
type Props = {
  apps: AppStory[];
};

const { apps } = Astro.props;

const narrate = (k: UIKey) => ({ k, clip: clipFor(k), subs: subsFor(k) });

// PHONE copy by convention: `x.problem` → `x.problem.m`, `x.sN.pM` → `x.sN.m`.
const mobileKey = (k: string) =>
  (/\.p\d+$/.test(k) ? k.replace(/\.p\d+$/, '.m') : `${k}.m`) as UIKey;

/**
 * THE COLLAGE — each welcome's four screens, standing, in a STAIR
 * (Juan, 2026-10-11): their tops step along a diagonal, each screen whole
 * at its own ratio and a different size, the leading screen the largest —
 * Sound Shaper's player, Topper's home, Booker's reader. The frame's top
 * and sides are a margin the same as the gap between screens, never a
 * cut; every screen runs to the bottom edge, which is the only one that
 * may cut (it takes the home bar at most), and the frame's own ground
 * shows above the lower steps — the diagonal reads because of it.
 *
 * THE FRAME IS MORE WORK'S AND EVENTS' (Juan, 2026-10-11): the same 3:2
 * screen, at the same width, corner, edge and ground, so every picture
 * beside a block of words on the page is one standard size.
 *
 * A piece is a fraction of the frame's WIDTH (its height is 2/3 of it):
 * where its box starts and its height. A column's width is the least
 * that still reaches the bottom from where its step starts, and the slack
 * goes to the leading screen — solved from the gap (0.0125) and the
 * screens' ratio (1179 / 2556); change a step and re-solve the row. Every
 * app has its own stair: down, up, and a peak.
 */
type Piece = { shot: number; x: number; y: number; len: number; dir: 'v' | 'h' };
const COLLAGES: Piece[][] = [
  // Sound Shaper: a stair down to the right, from the PLAYER (the
  // largest) through the library and the shape sheet to the clip editor.
  [
    { shot: 1, x: 0.0125, y: 0.0125, len: 0.7694, dir: 'v' },
    { shot: 0, x: 0.3799, y: 0.13, len: 0.541, dir: 'v' },
    { shot: 2, x: 0.642, y: 0.25, len: 0.421, dir: 'v' },
    { shot: 3, x: 0.8487, y: 0.37, len: 0.301, dir: 'v' },
  ],
  // Topper: the stair the other way, climbing to HOME (the largest) on the
  // right through the profile, a top and explore.
  [
    { shot: 3, x: 0.0125, y: 0.34, len: 0.331, dir: 'v' },
    { shot: 2, x: 0.1777, y: 0.22, len: 0.451, dir: 'v' },
    { shot: 1, x: 0.3982, y: 0.11, len: 0.561, dir: 'v' },
    { shot: 0, x: 0.6695, y: 0.0125, len: 0.6894, dir: 'v' },
  ],
  // Booker: a peak — the READER (the largest) highest, the shelf a step
  // down to its left, the book's page and a chapter stepping down to its
  // right.
  [
    { shot: 0, x: 0.0125, y: 0.22, len: 0.451, dir: 'v' },
    { shot: 2, x: 0.233, y: 0.0125, len: 0.6894, dir: 'v' },
    { shot: 1, x: 0.5635, y: 0.13, len: 0.541, dir: 'v' },
    { shot: 3, x: 0.8256, y: 0.32, len: 0.351, dir: 'v' },
  ],
];

type Card =
  | {
      kind: 'welcome';
      paras: UIKey[];
      /** The app's four screens, for its collage. */
      shots: { src: string; width: number; height: number; title: string }[];
      scene: string;
    }
  | {
      kind: 'slide';
      paras: UIKey[];
      title: string;
      src: string;
      width: number;
      height: number;
      scene: string;
    };

// Each app's cards, in telling order: its welcome, then its slides.
const decks: Card[][] = [];
for (const app of apps) {
  // The welcome's collage holds every card's screen, and lights the page
  // with all of them together.
  const cards: Card[] = [
    {
      kind: 'welcome',
      paras: app.pitch,
      shots: app.slides.map(({ src, width, height, title }) => ({
        src,
        width,
        height,
        title,
      })),
      scene: sceneAttr(await sceneOf(app.slides.map(slide => slide.src))),
    },
  ];
  for (const slide of app.slides)
    cards.push({
      kind: 'slide',
      paras: slide.paras,
      title: slide.title,
      src: slide.src,
      width: slide.width,
      height: slide.height,
      scene: sceneAttr(await sceneOf(slide.src)),
    });
  decks.push(cards);
}
const voiced = decks.flat().some(c => c.paras.some(k => clipFor(k)));
---

<section
  class="apps"
  id="apps"
  data-apps
  data-narr-panel={voiced ? '' : null}
  data-phone-scene
>
  <!-- The switcher, floating at the header's height (see the docblock). -->
  <div class="switcher" role="tablist" aria-label="Apps" data-switcher>
    <span class="lozenge" aria-hidden="true"></span>
    {
      apps.map((app, a) => (
        <button
          class="tab"
          type="button"
          role="tab"
          data-tab={a}
          aria-selected={a === 0 ? 'true' : 'false'}
        >
          <AppTile app={app.id} size={22} />
          <span class="tab-name">{app.name}</span>
        </button>
      ))
    }
  </div>

  <div class="decks" data-decks>
    {
      decks.map((cards, a) => {
        const app = apps[a];
        return (
          <div
            class="carousel"
            data-apps-deck={a}
            hidden={a !== 0}
            tabindex="0"
            role="tabpanel"
            aria-roledescription="carousel"
            aria-label={app.name}
          >
            <div class="stage">
              {cards.map((card, c) => (
                <article
                  class:list={['card', 'deck-card', `is-${card.kind}`]}
                  aria-roledescription="slide"
                  aria-label={`${c + 1} / ${cards.length}`}
                  data-scene={card.scene}
                >
                  <div class="words">
                    {card.kind === 'welcome' ? (
                      <div class="lockup big" data-deck-part="text" style="--i: 1">
                        <AppTile app={app.id} size={52} />
                        <h3 class="lockup-name">{app.name}</h3>
                      </div>
                    ) : (
                      <>
                        <div class="lockup small" data-deck-part="text" style="--i: 0">
                          <AppTile app={app.id} size={26} />
                          <span class="lockup-name">{app.name}</span>
                        </div>
                        <h3 class="slide-title" data-deck-part="text" style="--i: 1">
                          {card.title}
                        </h3>
                      </>
                    )}
                    {card.paras.map(narrate).map(({ k, clip, subs }, i) => (
                      <p
                        class="body full"
                        data-deck-part="text"
                        style={`--i: ${i + 2}`}
                        data-narr-para
                        data-card={c}
                        data-app={a}
                        data-clip-en={clip?.en}
                        data-clip-es={clip?.es}
                        data-subs-en={subs.en}
                        data-subs-es={subs.es}
                      >
                        <T k={k} />
                      </p>
                    ))}
                    {/* The phone's short version — the welcome's two
                        paragraphs each have one, a slide's share one. */}
                    {(card.kind === 'welcome' ? card.paras : card.paras.slice(0, 1)).map(
                      (k, i) => (
                        <p class="body short" data-deck-part="text" style={`--i: ${i + 2}`}>
                          <T k={mobileKey(k)} />
                        </p>
                      )
                    )}
                    {card.kind === 'welcome' && (
                      <div class="store-row" data-deck-part="text" style="--i: 4">
                        <StoreBadges app={app.id} />
                      </div>
                    )}
                    {voiced && <div class="narr-slot" aria-hidden="true" />}
                  </div>

                  {card.kind === 'welcome' && (
                    <div class="slot" data-deck-part="picture">
                      <div class="collage">
                        {COLLAGES[a % COLLAGES.length].map(piece => {
                          const shot = card.shots[piece.shot];
                          return shot ? (
                            <div
                              class:list={['piece', `is-${piece.dir}`]}
                              style={`--x: ${piece.x}; --y: ${piece.y}; --len: ${piece.len}`}
                            >
                              <img
                                class="tile"
                                src={shot.src}
                                alt={`${app.name} — ${shot.title}`}
                                width={shot.width}
                                height={shot.height}
                                loading="lazy"
                                decoding="async"
                                draggable="false"
                              />
                            </div>
                          ) : null;
                        })}
                      </div>
                    </div>
                  )}
                  {card.kind === 'slide' && (
                    <div class="slot" data-deck-part="picture">
                      <img
                        class="shot"
                        src={card.src}
                        alt={`${app.name} — ${card.title}`}
                        width={card.width}
                        height={card.height}
                        loading="lazy"
                        decoding="async"
                        draggable="false"
                      />
                    </div>
                  )}
                </article>
              ))}
            </div>

            <div class="inner controls" data-dock>
              <DeckControls
                names={cards.map(c => (c.kind === 'slide' ? c.title : app.name))}
              />
            </div>
          </div>
        );
      })
    }

    {/* The ONE narrator's anchor, outside every deck: the cards slide
        under it, and the script stands it on the front card's slot. */}
    {
      voiced && (
        <div class="inner narr-static">
          <div class="narr-anchor" data-narr-anchor aria-hidden="true" />
        </div>
      )
    }
  </div>
</section>

<style>
  .apps {
    --gutter: clamp(1.25rem, 4vw, 2.5rem);
    --card-w: min(var(--content-max), calc(100vw - var(--gutter) * 2));
    /* THE PHONE STANDS A STEP ABOVE THE WORDS' LINE, down to the controls'
       row (Juan, 2026-10-11): inside the words' insets it read as a small
       rectangle, and pulled up to the header's foot as too big. The slot
       is pulled up that step to make the room; the width follows the
       screenshot's own ratio. */
    --shot-top: calc(var(--stage-top) - 1.5rem);
    --shot-h: calc(100svh - var(--shot-top) - var(--stage-bottom) - 5rem);
    min-height: 100svh;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    display: flex;
    flex-direction: column;
    padding: var(--stage-top) 0 var(--stage-bottom);
    overflow-x: clip;
  }

  .inner {
    width: var(--card-w);
    margin: 0 auto;
  }

  /* ---------- the switcher ----------
     The header's pill recipe — its height, hairline, ground and blur — at
     the header's height, centred between its two pills. Shown only while
     the panel holds the screen (the script toggles .is-shown). */
  .switcher {
    --pad: 0.1875rem;
    position: fixed;
    top: var(--float-gap);
    left: 50%;
    z-index: 11;
    display: flex;
    height: var(--float-h);
    padding: var(--pad);
    border: 1px solid var(--hairline);
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface) 82%, transparent);
    backdrop-filter: blur(12px);
    transform: translate(-50%, -0.75rem);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity calc(var(--beat) / 2) var(--ease),
      transform calc(var(--beat) / 2) var(--ease),
      border-color var(--dur-micro) var(--ease),
      visibility 0s linear calc(var(--beat) / 2);
  }

  .switcher.is-shown {
    transform: translate(-50%, 0);
    opacity: 1;
    visibility: visible;
    transition:
      opacity calc(var(--beat) / 2) var(--ease),
      transform calc(var(--beat) / 2) var(--ease),
      border-color var(--dur-micro) var(--ease),
      visibility 0s;
  }

  .switcher:hover {
    border-color: var(--ink-3);
  }

  /* The picked tab's ground: a grey lozenge that slides and stretches to
     whichever tab is picked — the script sets its box. */
  .lozenge {
    position: absolute;
    top: var(--pad);
    bottom: var(--pad);
    left: 0;
    width: var(--w, 0px);
    border-radius: 999px;
    background: color-mix(in srgb, var(--ink) 13%, transparent);
    transform: translateX(var(--x, 0px));
    transition:
      transform calc(var(--beat) * 0.75) var(--ease),
      width calc(var(--beat) * 0.75) var(--ease);
  }

  .lozenge.is-still {
    transition: none;
  }

  .tab {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.625rem;
    height: 100%;
    padding: 0 1.25rem 0 0.75rem;
    border: none;
    border-radius: 999px;
    background: none;
    color: var(--ink-3);
    font: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    white-space: nowrap;
    cursor: pointer;
    transition: color var(--dur-micro) var(--ease);
  }

  .tab :global(svg) {
    opacity: 0.55;
    transition: opacity var(--dur-micro) var(--ease);
  }

  .tab:hover {
    color: var(--ink-2);
  }

  .tab[aria-selected='true'] {
    color: var(--ink);
  }

  .tab[aria-selected='true'] :global(svg) {
    opacity: 1;
  }

  /* ---------- the decks ---------- */

  /* Every app's deck in one cell, so the leaving one and the arriving one
     cross in place instead of stacking. */
  .decks {
    position: relative;
    flex: 1;
    display: grid;
  }

  .carousel {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    outline: none;
    transition:
      opacity calc(var(--beat) / 2) var(--ease),
      transform calc(var(--beat) / 2) var(--ease);
  }

  .carousel[hidden] {
    display: none;
  }

  /* Changing app: the deck leaving drifts out the way the switch went and
     fades; the one arriving stands on the far side, then comes in. */
  .carousel.is-leaving {
    opacity: 0;
    transform: translateX(calc(var(--dir, 1) * -2rem));
    pointer-events: none;
  }

  .carousel.is-arriving {
    opacity: 0;
    transform: translateX(calc(var(--dir, 1) * 2rem));
    transition: none;
  }

  .stage {
    touch-action: pan-y;
    display: grid;
    justify-items: center;
  }

  /* Words in the stories' text column, the picture in the rest. */
  .card {
    display: grid;
    grid-template-columns: calc(100% * 6 / 13 * 0.81) 1fr;
    gap: var(--column-gap);
    align-items: start;
  }


  /* ---------- the collage ----------
     A square as tall as a slide's phone — no wider than its column — on a
     ground of its own, so what is in it reads as apart from the page
     behind (`COLLAGES`). Sizes come from the square's own width (a size
     container): a piece stands at `--x`, `--y` of the side, `--len` of it
     long, and its short side follows the phone's own ratio. A piece lying
     down carries its screen turned a quarter, top to the left. */
  .collage {
    --u: 1cqw;
    position: relative;
    /* More Work's screen, to the letter (PanelDeck `.screen`). */
    width: var(--screen-w);
    aspect-ratio: 3 / 2;
    overflow: hidden;
    container-type: size;
    border: 1px solid var(--hairline);
    border-radius: var(--media-radius-flat);
    background: var(--surface);
    box-shadow:
      0 2rem 4rem rgba(0, 0, 0, 0.55),
      0 0.5rem 1.25rem rgba(0, 0, 0, 0.4);
    /* It leans toward the pointer (lib/tilt). */
    rotate: var(--tilt-rot, none);
  }

  .piece {
    position: absolute;
    left: calc(var(--x) * 100 * var(--u));
    top: calc(var(--y) * 100 * var(--u));
  }

  .piece.is-v {
    width: calc(var(--len) * 100 * var(--u) * 1179 / 2556);
    height: calc(var(--len) * 100 * var(--u));
  }

  .piece.is-h {
    width: calc(var(--len) * 100 * var(--u));
    height: calc(var(--len) * 100 * var(--u) * 1179 / 2556);
  }

  .tile {
    display: block;
    max-width: none;
    border: 1px solid var(--hairline);
    /* The slides' phone corner as a share of the phone (its width / its
       height), the bottom a beat tighter — so a screen with a sheet up
       (Sound Shaper's shape) keeps the sheet's own rounding clear. */
    border-radius: 16.5% 16.5% 18.75% 18.75% / 7.6% 7.6% 8.65% 8.65%;
  }

  .is-v .tile {
    width: 100%;
    height: 100%;
  }

  /* On its side: the portrait screen, turned about the box's centre. */
  .is-h .tile {
    position: absolute;
    left: 50%;
    top: 50%;
    width: calc(var(--len) * 100 * var(--u) * 1179 / 2556);
    height: calc(var(--len) * 100 * var(--u));
    transform: translate(-50%, -50%) rotate(-90deg);
  }

  /* The frame stands where More Work's does: at the top of its column,
     on the words' line, in the column's middle. */
  .is-welcome .slot {
    /* More Work's eyebrow row (2rem) and the step under it (1.5rem): the
       frame's top lands on the line its screens' tops do. */
    margin-top: 3.5rem;
    align-items: flex-start;
    perspective: 1600px;
  }

  /* An icon keeps its drawn size; a flex row would squeeze the SVG. */
  .apps :global(svg) {
    flex: none;
  }

  .words {
    display: flex;
    flex-direction: column;
  }

  .lockup {
    display: flex;
    align-items: center;
  }

  /* THE TYPE IS MORE WORK'S LADDER, a step up at most (Juan, 2026-10-11):
     the stories' display sizes made the page change voice at the seam
     between the apps and the panels under them. */
  .lockup.big {
    gap: 1rem;
  }

  .lockup.big .lockup-name {
    font-size: clamp(1.75rem, 3.2vw, 2.5rem);
    font-weight: 800;
    letter-spacing: var(--track-display);
    line-height: 0.95;
    white-space: nowrap;
  }

  .lockup.small {
    gap: 0.625rem;
    height: 2rem;
    margin-bottom: 1.25rem;
  }

  .lockup.small .lockup-name {
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: var(--track-heading);
  }

  .slide-title {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    font-weight: 800;
    letter-spacing: var(--track-heading);
    line-height: 1.05;
  }

  .words .body {
    margin-top: 1.25rem;
  }

  .words .body + .body {
    margin-top: 0.875rem;
  }

  .is-welcome .body {
    max-width: none;
  }

  .short {
    display: none;
  }

  .store-row :global(.stores) {
    margin-top: 1.75rem;
  }

  .narr-slot {
    flex: none;
    height: var(--narrator-h);
    margin-top: 1.5rem;
  }

  /* The phone: the panel's height, its own corner — the stories' recipe. */
  .slot {
    display: flex;
    justify-content: center;
    margin-top: calc(var(--shot-top) - var(--stage-top));
  }

  .shot {
    height: var(--shot-h);
    width: auto;
    max-width: none;
    border-radius: var(--media-radius) var(--media-radius)
      calc(var(--media-radius) * 1.136) calc(var(--media-radius) * 1.136);
    border: 1px solid var(--hairline);
    box-shadow:
      0 2rem 4rem rgba(0, 0, 0, 0.55),
      0 0.5rem 1.25rem rgba(0, 0, 0, 0.4);
  }

  /* A slide's phone leans toward the pointer (lib/tilt). */
  .is-slide .slot {
    perspective: 1600px;
  }

  .is-slide .shot {
    rotate: var(--tilt-rot, none);
  }

  /* ---------- the narrator's still anchor ---------- */

  .narr-static {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    pointer-events: none;
  }

  .narr-static .narr-anchor {
    margin-top: 0;
    transform: translate(var(--slot-x, 0px), var(--slot-y, 0px));
    transition: transform calc(var(--beat) * 0.75) var(--ease);
  }

  /* Centred at the panel's foot, the way More Work's stand. */
  .controls {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: auto;
    padding-top: 1.5rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .narr-static .narr-anchor,
    .lozenge,
    .carousel {
      transition: none;
    }

    .carousel.is-leaving,
    .carousel.is-arriving {
      transform: none;
    }
  }

  /* ---------- phones ---------- */

  @media (max-width: 48rem) {
    .apps {
      --shot-h: min(112vw, calc(100svh - var(--stage-top) - 16rem));
    }

    /* A step of air under the switcher, which stands on the panel's top
       line on a phone. */
    .decks {
      margin-top: 1rem;
    }

    /* Icons only: three apps fit between the header's two pills. */
    .tab {
      padding: 0 0.75rem;
    }

    .tab-name {
      display: none;
    }

    /* One centred column: the picture on top, the words under it. */
    .card,
    .is-welcome {
      grid-template-columns: 1fr;
      align-content: start;
      gap: var(--media-gap-m);
    }

    .words {
      position: relative;
      z-index: 1;
      align-items: center;
      text-align: center;
    }

    .slot {
      order: -1;
      margin-top: 0;
    }

    /* A phone's frame stands over the words at the column's width, as
       More Work's does. */
    .is-welcome .slot {
      margin-top: 0;
    }

    .collage {
      width: 100%;
      box-shadow:
        var(--media-glow),
        0 2rem 4rem rgba(0, 0, 0, 0.55),
        0 0.5rem 1.25rem rgba(0, 0, 0, 0.4);
    }

    .shot {
      box-shadow:
        var(--media-glow),
        0 2rem 4rem rgba(0, 0, 0, 0.55),
        0 0.5rem 1.25rem rgba(0, 0, 0, 0.4);
    }

    .lockup.small {
      display: none;
    }

    .lockup.big {
      gap: 0.75rem;
      padding-top: 0.5rem;
    }

    .lockup.big .lockup-name {
      font-size: clamp(1.75rem, 8vw, 2.25rem);
    }

    .slide-title {
      font-size: 1.5rem;
    }

    .words .body {
      margin-top: 0.75rem;
      font-size: 1rem;
      line-height: 1.5;
    }

    .full,
    .narr-slot,
    .narr-static {
      display: none;
    }

    .short {
      display: block;
    }

    .store-row :global(.stores) {
      justify-content: center;
      margin-top: 1.25rem;
    }

    .controls {
      width: auto;
      margin-top: 0;
      padding-top: 0;
    }
  }

  /* SHORT PHONES (an SE, a phone with Safari's bars showing): the welcome's
     lockup, pitch and store row are one column over the controls, and at
     667pt tall the store row ran under the arrows. Everything steps down
     a notch so the column clears them. */
  @media (max-width: 48rem) and (max-height: 46rem) {

    .card,
    .is-welcome {
      gap: 1rem;
    }

    .lockup.big {
      padding-top: 0;
    }

    .lockup.big .lockup-name {
      font-size: 1.625rem;
    }

    .words .body {
      margin-top: 0.5rem;
      font-size: 0.9375rem;
      line-height: 1.45;
    }

    .store-row :global(.stores) {
      margin-top: 0.875rem;
    }
  }

  /* SHORT DESKS (a 720pt laptop window): the welcome's two paragraphs, the
     store row and the narrator under them reached past the deck's arrows.
     The pitch steps down a size and its gaps tighten. */
  @media (min-width: 48.01rem) and (max-height: 50rem) {
    .is-welcome .body {
      font-size: 0.9375rem;
      line-height: 1.55;
    }

    .is-welcome .words .body {
      margin-top: 0.875rem;
    }

    .is-welcome .words .body + .body {
      margin-top: 0.625rem;
    }

    .is-welcome .store-row :global(.stores) {
      margin-top: 1.25rem;
    }

    .is-welcome .narr-slot {
      margin-top: 1rem;
    }
  }
</style>

<script>
  import { createDeck, watchSlots, type Deck } from '../lib/deck';
  import { followPointer } from '../lib/tilt';

  const root = document.querySelector<HTMLElement>('[data-apps]');
  if (root) {
    const decksEl = root.querySelector<HTMLElement>('[data-decks]')!;
    const switcher = root.querySelector<HTMLElement>('[data-switcher]')!;
    const lozenge = switcher.querySelector<HTMLElement>('.lozenge')!;
    const tabs = [...switcher.querySelectorAll<HTMLElement>('[data-tab]')];
    const paras = [...root.querySelectorAll<HTMLElement>('[data-narr-para]')];
    const still = decksEl.querySelector<HTMLElement>('.narr-static .narr-anchor');

    type Held = { el: HTMLElement; cards: HTMLElement[]; deck: Deck };
    const held: Held[] = [];
    let active = 0;
    // How long a leaving deck stays drawn: its fade, and a margin.
    const LEAVE_MS = 320;

    // Stand the still anchor on the front card's slot.
    const standAnchor = () => {
      const h = held[active];
      const card = h?.cards[h.deck.current];
      const slot = card?.querySelector<HTMLElement>('.narr-slot');
      if (!still || !slot) return;
      const y = slot.getBoundingClientRect().top - decksEl.getBoundingClientRect().top;
      still.style.setProperty('--slot-y', `${y.toFixed(1)}px`);
      // Sideways too: on the words' left edge.
      const base = (still.parentElement ?? decksEl).getBoundingClientRect().left;
      const x = slot.getBoundingClientRect().left - base;
      still.style.setProperty('--slot-x', `${x.toFixed(1)}px`);
    };

    // The narrator starts this panel on the card in front, and a running
    // voice switches to it.
    const select = (card: HTMLElement | undefined) => {
      if (!card) return;
      requestAnimationFrame(standAnchor);
      const first = card.querySelector<HTMLElement>('[data-narr-para]');
      if (!first) return;
      root.dataset.narrStart = String(paras.indexOf(first));
      document.dispatchEvent(new CustomEvent('narr:select', { detail: first }));
    };

    for (const el of root.querySelectorAll<HTMLElement>('[data-apps-deck]')) {
      const cards = [...el.querySelectorAll<HTMLElement>('.deck-card')];
      const h = { el, cards } as Held;
      h.deck = createDeck({
        cards,
        controls: el.querySelector('[data-deck-controls]'),
        keys: el,
        swipe: el.querySelector<HTMLElement>('.stage'),
        onChange: current => {
          // The first call comes while the deck is still being made.
          requestAnimationFrame(() => {
            if (held.indexOf(h) === active) select(cards[current]);
          });
        },
      });
      held.push(h);
    }

    // The lozenge stands under the picked tab — measured, since every
    // app's name is its own width.
    const placeLozenge = (animate = true) => {
      const tab = tabs[active];
      if (!tab) return;
      lozenge.classList.toggle('is-still', !animate);
      lozenge.style.setProperty('--x', `${tab.offsetLeft}px`);
      lozenge.style.setProperty('--w', `${tab.offsetWidth}px`);
    };

    // CHANGING APP IS ONE MOVE (Juan, 2026-10-11). The old deck drifts out
    // the way the switch went while the new one drifts in from the other
    // side, together, on one curve — and the new deck is ALREADY standing on
    // its welcome (or, when the voice carried the page here, on the card
    // being told). Replaying the card's entrance on top of the deck's own
    // move read as a gallop, two beats where there
    // should be one, and flicking between tabs replayed it every time.
    const show = (a: number, card?: number) => {
      if (a === active) return;
      const dir = a > active ? 1 : -1;
      const from = held[active];
      const to = held[a];
      active = a;

      tabs.forEach((t, i) => t.setAttribute('aria-selected', String(i === a)));
      placeLozenge();

      // Turned while still hidden, so the turn draws nothing.
      const target = card ?? 0;
      if (to.deck.current !== target) to.deck.go(target);

      from.el.style.setProperty('--dir', String(dir));
      from.el.classList.add('is-leaving');
      setTimeout(() => {
        from.el.classList.remove('is-leaving');
        if (held[active] !== from) from.el.hidden = true;
      }, LEAVE_MS);

      to.el.style.setProperty('--dir', String(dir));
      to.el.classList.remove('is-leaving');
      to.el.hidden = false;
      to.el.classList.add('is-arriving');
      void to.el.offsetWidth;
      to.el.classList.remove('is-arriving');
      select(to.cards[target]);
    };

    tabs.forEach((t, a) => t.addEventListener('click', () => show(a)));

    // The switcher shows while the panel holds the screen — the middle of
    // the viewport inside it — and goes with it.
    const watch = () => {
      const r = root.getBoundingClientRect();
      const mid = innerHeight / 2;
      switcher.classList.toggle('is-shown', r.top < mid && r.bottom > mid);
    };
    addEventListener('scroll', watch, { passive: true });
    addEventListener('resize', () => {
      watch();
      placeLozenge(false);
      standAnchor();
    });
    watch();
    // Fonts settle the tabs' widths after the first paint.
    placeLozenge(false);
    document.fonts?.ready.then(() => placeLozenge(false));

    // The voice moved on by itself: whatever shows its paragraph follows —
    // the deck turns, and past an app's last card the tab switches.
    document.addEventListener('narr:para', e => {
      const p = (e as CustomEvent<HTMLElement>).detail;
      if (!root.contains(p)) return;
      const a = Number(p.dataset.app);
      const c = Number(p.dataset.card);
      if (a !== active) {
        show(a, c);
        return;
      }
      const h = held[a];
      if (c !== h.deck.current) h.deck.go(c);
    });

    // The picture in front leans toward the pointer: a slide's phone, or a
    // welcome's frame.
    followPointer(root, () => {
      const h = held[active];
      return h.cards[h.deck.current]?.querySelector<HTMLElement>('.collage, .slot .shot');
    });

    // WARM THE HIDDEN APPS. A deck that is not in front is `hidden`, so its
    // lazy screenshots are neither fetched nor decoded until its tab is
    // picked — and then all of them land at once, mid-transition, and the
    // first switch to each app stuttered while every later one was smooth
    // (Juan, 2026-10-11). Once the page has loaded and the browser is idle,
    // each hidden picture is fetched and decoded, one at a time, so the
    // first switch draws from memory like the rest.
    const idle = (fn: () => void) =>
      'requestIdleCallback' in window
        ? requestIdleCallback(fn, { timeout: 2000 })
        : setTimeout(fn, 200);
    const warm = () => {
      // The deck in front first (its later cards are lazy too), then the
      // others in tab order.
      const queue = [held[active], ...held.filter((_, i) => i !== active)].flatMap(h => [
        ...h.el.querySelectorAll<HTMLImageElement>('img'),
      ]);
      const next = () => {
        const img = queue.shift();
        if (!img) return;
        img.loading = 'eager';
        img
          .decode()
          .catch(() => {})
          .finally(() => idle(next));
      };
      idle(next);
    };
    // Not on a connection the person asked to spare: ~5 MB of screenshots
    // is theirs to spend by picking a tab.
    const spare = (
      navigator as Navigator & { connection?: { saveData?: boolean } }
    ).connection?.saveData;
    if (!spare) {
      if (document.readyState === 'complete') warm();
      else addEventListener('load', warm, { once: true });
    }

    select(held[0].cards[0]);
    // Placed now as well as on the next frame, and again once fonts and
    // images have settled the words' height.
    standAnchor();
    document.fonts?.ready.then(standAnchor);
    addEventListener('load', standAnchor);
    watchSlots(
      held.flatMap(h => h.cards),
      standAnchor
    );
  }
</script>
