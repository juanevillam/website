---
import AppTile from './AppTile.astro';
import DeckControls from './DeckControls.astro';
import StoreBadges from './StoreBadges.astro';
import T from './T.astro';
import type { UIKey } from '../i18n/ui';
import type { AppStory } from '../lib/apps';
import { clipFor, subsFor } from '../lib/narration';
import { sceneAttr, sceneOf } from '../lib/scene';

/**
 * THE APPS — every app the landing tells, in ONE panel (2026-10-11). Two
 * stories took four screens of scroll and a third would have taken six
 * before the page reached anything else; the section is now one screen
 * however many apps it holds, and each app still tells its whole story: a
 * WELCOME card (the pitch — the problem, then the answer — and the store
 * row) and its four cards.
 *
 * TABS, chosen over two other layouts built beside it the same day: one
 * deck that chained every app's cards with chapters above it, and tiles
 * that opened full screen. A deck inside a deck was never one of them —
 * two sideways swipes nested on a phone fight for the same gesture.
 *
 * THE SWITCHER FLOATS AT THE HEADER'S HEIGHT, centred between its pills
 * and built by their recipe (Juan, 2026-10-11): standing in the panel, it
 * took a row from the phone. It shows while the panel holds the screen and
 * goes with it. The picked app's pill is a grey lozenge that SLIDES to the
 * tab you pick, and the app's deck slides in from that side. With ONE app
 * there is nothing to pick, so there is no switcher (2026-10-16: Sound
 * Shaper alone, the others archived — see lib/apps.ts).
 *
 * Every card is the page's deck card (lib/deck.ts, `.deck-card` in
 * global.css), so a turn is the one More Work and Events turn with.
 *
 * NARRATION: the section is one narrated PANEL — every paragraph of every
 * app, in order — under ONE still narrator that the cards slide under (the
 * More Work arrangement). A clip ending moves the voice on, and whatever
 * shows the next paragraph follows it: the deck turns, and past an app's
 * last card the tab switches. The director (scripts/director.ts) runs the
 * session; this file only maps paragraphs to cards.
 */
type Props = {
  apps: AppStory[];
};

const { apps } = Astro.props;

const narrate = (k: UIKey) => ({ k, clip: clipFor(k), subs: subsFor(k) });

/**
 * THE PEEK — a welcome shows no picture of its own but the first card's
 * phone, standing off its place and cut by the panel's edge, and the turn
 * to the first card walks it in (Juan, 2026-10-13, bringing back what the
 * apps did when each told its story on its own scroll). Every collage
 * before it — a mosaic, a fan, a stair, a row — read either as a
 * container on a container or as too plain. Each app comes in its own
 * way: Sound Shaper from the right, Topper from below, Booker from
 * above. A phone's welcome is its words alone (see `.slot`).
 */
const PEEKS = ['side', 'rise', 'drop'] as const;

type Card =
  | {
      kind: 'welcome';
      paras: UIKey[];
      /** The app's screens: the first peeks, all of them light the page. */
      shots: { src: string; width: number; height: number; title: string }[];
      scene: string;
    }
  | {
      kind: 'slide';
      paras: UIKey[];
      title: string;
      src: string;
      width: number;
      height: number;
      scene: string;
    };

// Each app's cards, in telling order: its welcome, then its slides.
const decks: Card[][] = [];
for (const app of apps) {
  // The welcome lights the page with every card's screen together.
  const cards: Card[] = [
    {
      kind: 'welcome',
      paras: app.pitch,
      shots: app.slides.map(({ src, width, height, title }) => ({
        src,
        width,
        height,
        title,
      })),
      scene: sceneAttr(await sceneOf(app.slides.map(slide => slide.src))),
    },
  ];
  for (const slide of app.slides)
    cards.push({
      kind: 'slide',
      paras: slide.paras,
      title: slide.title,
      src: slide.src,
      width: slide.width,
      height: slide.height,
      scene: sceneAttr(await sceneOf(slide.src)),
    });
  decks.push(cards);
}
const voiced = decks.flat().some(c => c.paras.some(k => clipFor(k)));
---

<section
  class="apps"
  id="apps"
  data-apps
  data-narr-panel={voiced ? '' : null}
  data-phone-scene
>
  <!-- The switcher, floating at the header's height (see the docblock). -->
  {
    apps.length > 1 && (
      <div class="switcher" role="tablist" aria-label="Apps" data-switcher>
        <span class="lozenge" aria-hidden="true" />
        {apps.map((app, a) => (
          <button
            class="tab"
            type="button"
            role="tab"
            data-tab={a}
            aria-selected={a === 0 ? 'true' : 'false'}
          >
            <AppTile app={app.id} size={22} />
            <span class="tab-name">{app.name}</span>
          </button>
        ))}
      </div>
    )
  }

  <div class="decks" data-decks>
    {
      decks.map((cards, a) => {
        const app = apps[a];
        return (
          <div
            class="carousel"
            data-apps-deck={a}
            hidden={a !== 0}
            tabindex="0"
            role="tabpanel"
            aria-roledescription="carousel"
            aria-label={app.name}
          >
            <div class="stage">
              {cards.map((card, c) => (
                <article
                  class:list={['card', 'deck-card', `is-${card.kind}`]}
                  aria-roledescription="slide"
                  aria-label={`${c + 1} / ${cards.length}`}
                  data-scene={card.scene}
                >
                  <div class="words">
                    {card.kind === 'welcome' ? (
                      <div class="lockup big" data-deck-part="text" style="--i: 1">
                        <AppTile app={app.id} size={52} />
                        <h3 class="lockup-name">{app.name}</h3>
                      </div>
                    ) : (
                      <>
                        <div class="lockup small" data-deck-part="text" style="--i: 0">
                          <AppTile app={app.id} size={26} />
                          <span class="lockup-name">{app.name}</span>
                        </div>
                        <h3 class="slide-title" data-deck-part="text" style="--i: 1">
                          {card.title}
                        </h3>
                      </>
                    )}
                    <div class="desc" data-cap data-cap-phone={card.kind === 'welcome' ? 'fill' : '4'}>
                    {card.paras.map(narrate).map(({ k, clip, subs }, i) => (
                      <p
                        class="body"
                        data-deck-part="text"
                        style={`--i: ${i + 2}`}
                        data-narr-para
                        data-card={c}
                        data-app={a}
                        data-clip-en={clip?.en}
                        data-clip-es={clip?.es}
                        data-subs-en={subs.en}
                        data-subs-es={subs.es}
                      >
                        <T k={k} />
                      </p>
                    ))}
                    </div>
                    {card.kind === 'welcome' && (
                      <div class="store-row" data-deck-part="text" style="--i: 4">
                        <StoreBadges app={app.id} />
                      </div>
                    )}
                    {voiced && <div class="narr-slot" aria-hidden="true" />}
                  </div>

                  {card.kind === 'welcome' && (
                    <div class="slot" data-deck-part="picture" data-peek={PEEKS[a % PEEKS.length]}>
                      <img
                        class="shot"
                        data-scene-at
                        src={card.shots[0].src}
                        alt={`${app.name} — ${card.shots[0].title}`}
                        width={card.shots[0].width}
                        height={card.shots[0].height}
                        loading="lazy"
                        decoding="async"
                        draggable="false"
                      />
                    </div>
                  )}
                  {card.kind === 'slide' && (
                    <div class="slot" data-deck-part="picture">
                      <img
                        class="shot"
                        src={card.src}
                        alt={`${app.name} — ${card.title}`}
                        width={card.width}
                        height={card.height}
                        loading="lazy"
                        decoding="async"
                        draggable="false"
                      />
                    </div>
                  )}
                </article>
              ))}
            </div>

            <div class="inner controls" data-dock>
              <DeckControls
                names={cards.map(c => (c.kind === 'slide' ? c.title : app.name))}
              />
            </div>
          </div>
        );
      })
    }

    {/* The ONE narrator's anchor, outside every deck: the cards slide
        under it, and the script stands it on the front card's slot. */}
    {
      voiced && (
        <div class="inner narr-static">
          <div class="narr-anchor" data-narr-anchor aria-hidden="true" />
        </div>
      )
    }
  </div>
</section>

<style>
  .apps {
    --gutter: clamp(1.25rem, 4vw, 2.5rem);
    --card-w: min(var(--content-max), calc(100vw - var(--gutter) * 2));
    /* THE PHONE STANDS A STEP ABOVE THE WORDS' LINE, down to the controls'
       row (Juan, 2026-10-11): inside the words' insets it read as a small
       rectangle, and pulled up to the header's foot as too big. The slot
       is pulled up that step to make the room; the width follows the
       screenshot's own ratio. */
    --shot-top: calc(var(--stage-top) - 1.5rem);
    --shot-h: calc(100svh - var(--shot-top) - var(--stage-bottom) - 5rem);
    min-height: 100svh;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    display: flex;
    flex-direction: column;
    padding: var(--stage-top) 0 var(--stage-bottom);
    /* Both ways: a welcome's phone peeks past the panel's side or foot,
       and the hand-off's copy flies inside it (the script). */
    position: relative;
    overflow: clip;
  }

  .inner {
    width: var(--card-w);
    margin: 0 auto;
  }

  /* ---------- the switcher ----------
     The header's pill recipe — its height, hairline, ground and blur — at
     the header's height, centred between its two pills. Shown only while
     the panel holds the screen (the script toggles .is-shown). */
  .switcher {
    --pad: 0.1875rem;
    position: fixed;
    top: var(--float-gap);
    left: 50%;
    z-index: 11;
    display: flex;
    height: var(--float-h);
    padding: var(--pad);
    border: 1px solid var(--hairline);
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface) 82%, transparent);
    backdrop-filter: blur(12px);
    transform: translate(-50%, -0.75rem);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity var(--dur-quick) var(--ease),
      transform var(--dur-quick) var(--ease),
      border-color var(--dur-micro) var(--ease),
      visibility 0s linear var(--dur-quick);
  }

  .switcher.is-shown {
    transform: translate(-50%, 0);
    opacity: 1;
    visibility: visible;
    transition:
      opacity var(--dur-quick) var(--ease),
      transform var(--dur-quick) var(--ease),
      border-color var(--dur-micro) var(--ease),
      visibility 0s;
  }

  .switcher:hover {
    border-color: var(--ink-3);
  }

  /* The picked tab's ground: a grey lozenge that slides and stretches to
     whichever tab is picked — the script sets its box. */
  .lozenge {
    position: absolute;
    top: var(--pad);
    bottom: var(--pad);
    left: 0;
    width: var(--w, 0px);
    border-radius: 999px;
    /* Between two misses (Juan, 2026-10-13): at 13% the picked app's dark
       tile and its ground read as one, at 24% the lozenge shouted. */
    background: color-mix(in srgb, var(--ink) 18%, transparent);
    transform: translateX(var(--x, 0px));
    transition:
      transform var(--dur-turn) var(--ease),
      width var(--dur-turn) var(--ease);
  }

  .lozenge.is-still {
    transition: none;
  }

  .tab {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.625rem;
    height: 100%;
    padding: 0 1.25rem 0 0.75rem;
    border: none;
    border-radius: 999px;
    background: none;
    color: var(--ink-3);
    font: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    white-space: nowrap;
    cursor: pointer;
    transition: color var(--dur-micro) var(--ease);
  }

  /* The tile's SVG carries its shadow's margin (AppTile): at its own
     size, or the page's `max-width: 100%` squeezes it and the tile sits
     off-centre in its tab. */
  .tab :global(svg) {
    max-width: none;
    opacity: 0.55;
    transition: opacity var(--dur-micro) var(--ease);
  }

  .tab:hover {
    color: var(--ink-2);
  }

  .tab[aria-selected='true'] {
    color: var(--ink);
  }

  .tab[aria-selected='true'] :global(svg) {
    opacity: 1;
  }

  /* ---------- the decks ---------- */

  /* Every app's deck in one cell, so the leaving one and the arriving one
     cross in place instead of stacking. */
  .decks {
    position: relative;
    flex: 1;
    display: grid;
  }

  .carousel {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    outline: none;
    transition: opacity var(--dur-quick) var(--ease);
  }

  .carousel[hidden] {
    display: none;
  }

  /* Changing app: the deck leaving drifts out the way the switch went and
     fades; the one arriving stands on the far side, then comes in.
     The DRIFT is the stage's, never the carousel's: a transformed box
     becomes the frame its fixed children are placed in, so moving the
     carousel pulled a phone's docked controls off the screen's foot for
     the length of the switch — up, then back (Juan, 2026-10-13). The
     controls only cross-fade, standing still. */
  .carousel.is-leaving {
    opacity: 0;
    pointer-events: none;
  }

  .carousel.is-arriving {
    opacity: 0;
    transition: none;
  }

  .stage {
    touch-action: pan-y;
    display: grid;
    justify-items: center;
    transition: transform var(--dur-quick) var(--ease);
  }

  .carousel.is-leaving .stage {
    transform: translateX(calc(var(--dir, 1) * -2rem));
  }

  .carousel.is-arriving .stage {
    transform: translateX(calc(var(--dir, 1) * 2rem));
    transition: none;
  }

  /* Words in the stories' text column, the picture in the rest. */
  .card {
    display: grid;
    grid-template-columns: calc(100% * 6 / 13 * 0.81) 1fr;
    gap: var(--column-gap);
    align-items: start;
  }


  /* ---------- the peek ----------
     The welcome's phone stands where the first card's does, moved off it
     by a share of the column — the panel's edge cuts it — and the hand-off
     walks it home (`PEEKS`). */
  .is-welcome .slot {
    container-type: inline-size;
  }

  .is-welcome .shot {
    transform: var(--peek);
  }

  [data-peek='side'] {
    --peek: translateX(58cqw);
  }

  /* Up, and off to the right of the deck's arrows, which stand centred
     under it — straight up it rose right beside them. */
  [data-peek='rise'] {
    --peek: translate(22cqw, 62%);
  }

  /* Topper's rise turned over: the same step right, from the top. */
  [data-peek='drop'] {
    --peek: translate(22cqw, -62%);
  }

  /* THE HAND-OFF (see the script): the first card's screen in the
     peeking phone IS the first card's phone, so it walks there on the turn.
     While it does, the one arriving stands in its final place at once,
     hidden — a flying copy draws the trip — and the one leaving is gone
     at once, since it is the one that flies. */
  .deck-card.is-handoff [data-deck-part='picture'],
  .deck-card.is-handoff .shot {
    transition: none;
  }

  .deck-card.is-handoff [data-deck-part='picture'] {
    opacity: 1;
    transform: none;
  }

  .is-flying {
    visibility: hidden;
  }

  /* An icon keeps its drawn size; a flex row would squeeze the SVG. */
  .apps :global(svg) {
    flex: none;
  }

  .words {
    display: flex;
    flex-direction: column;
  }

  .lockup {
    display: flex;
    align-items: center;
  }

  /* THE TYPE IS MORE WORK'S LADDER, a step up at most (Juan, 2026-10-11):
     the stories' display sizes made the page change voice at the seam
     between the apps and the panels under them. */
  .lockup.big {
    gap: 1rem;
  }

  .lockup.big .lockup-name {
    font-size: clamp(1.75rem, 3.2vw, 2.5rem);
    font-weight: 800;
    letter-spacing: var(--track-display);
    line-height: 0.95;
    white-space: nowrap;
  }

  /* The same app on both cards of a slide-to-slide turn (the script): its
     lockup stands still rather than fading out and in again (Juan,
     2026-10-13). */
  .carousel.is-slide-turn .lockup.small {
    opacity: 1;
    transition: none;
  }

  .lockup.small {
    gap: 0.625rem;
    height: 2rem;
    margin-bottom: 1.25rem;
  }

  .lockup.small .lockup-name {
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: var(--track-heading);
  }

  .slide-title {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    font-weight: 800;
    letter-spacing: var(--track-heading);
    line-height: 1.05;
  }

  /* A card's words stand in a box of ten lines at most (`data-cap`,
     global.css), which scrolls past that — so no card's words are taller
     than another's (Juan, 2026-10-13). The step above the words is the
     box's; inside it, only the steps between paragraphs. */
  .desc {
    --cap-gap: 1.25rem;
  }

  .words .body + .body {
    margin-top: 0.875rem;
  }

  .is-welcome .body {
    max-width: none;
  }

  /* Under the words' fade (global.css `[data-cap]`), a step of air. */
  .store-row :global(.stores) {
    margin-top: 1.25rem;
  }

  .narr-slot {
    flex: none;
    height: var(--narrator-h);
    margin-top: 1.5rem;
  }

  /* The phone: the panel's height, its own corner — the stories' recipe. */
  .slot {
    display: flex;
    justify-content: center;
    margin-top: calc(var(--shot-top) - var(--stage-top));
  }

  .shot {
    height: var(--shot-h);
    width: auto;
    max-width: none;
    border-radius: var(--media-radius) var(--media-radius)
      calc(var(--media-radius) * 1.136) calc(var(--media-radius) * 1.136);
    border: 1px solid var(--hairline);
    box-shadow:
      0 2rem 4rem rgba(0, 0, 0, 0.55),
      0 0.5rem 1.25rem rgba(0, 0, 0, 0.4);
  }

  /* A slide's phone leans toward the pointer (lib/tilt). */
  .is-slide .slot {
    perspective: 1600px;
  }

  .is-slide .shot {
    rotate: var(--tilt-rot, none);
  }

  /* ---------- the narrator's still anchor ---------- */

  .narr-static {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    pointer-events: none;
  }

  .narr-static .narr-anchor {
    margin-top: 0;
    transform: translate(var(--slot-x, 0px), var(--slot-y, 0px));
    transition: transform var(--dur-turn) var(--ease);
  }

  /* Centred at the panel's foot, the way More Work's stand — over a
     welcome's phone rising under them. On a desk the panel is exactly the
     screen tall, so they stand on ONE line for every app and card however
     long its words (Juan, 2026-10-13: Booker's longer pitch pushed them
     down) — see `.decks`. */
  .controls {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: auto;
    padding-top: 1.5rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .narr-static .narr-anchor,
    .lozenge,
    .carousel,
    .stage {
      transition: none;
    }

    .carousel.is-leaving .stage,
    .carousel.is-arriving .stage {
      transform: none;
    }
  }

  /* THE ARROWS DON'T MOVE (desk): the panel is the screen's height and the
     decks fill what is left, so each carousel — stretched to that cell —
     puts its controls on the same line, and a longer card's words can
     never push them down. */
  @media (min-width: 48.01rem) {
    .apps {
      height: 100svh;
    }

    /* Over a welcome's phone rising under them. Desk only: on a phone the
       controls DOCK (global.css `[data-dock]`, fixed), and a position here
       would pin them back into the panel. */
    .controls {
      position: relative;
      z-index: 1;
    }

    .decks {
      min-height: 0;
      grid-template-rows: minmax(0, 1fr);
    }

    .carousel,
    .stage {
      min-height: 0;
    }
  }

  /* ---------- phones ---------- */

  @media (max-width: 48rem) {
    .apps {
      --shot-h: min(112vw, calc(100svh - var(--stage-top) - 16rem));
    }

    /* A step of air under the switcher, which stands on the panel's top
       line on a phone. */
    .decks {
      margin-top: 1rem;
    }

    /* Icons only: three apps fit between the header's two pills. */
    .tab {
      padding: 0 0.75rem;
    }

    /* Icons only, so each can be a little bigger — a step, not a third
       (1.3 read as too big, Juan, 2026-10-13); its shadow margin with it. */
    .tab :global(svg) {
      zoom: 1.12;
    }

    .tab-name {
      display: none;
    }

    /* One column: the picture on top, the words under it — a hair apart,
       since the words' box brings its own fade's depth of air
       (global.css `[data-cap]`). */
    .card,
    .is-welcome {
      grid-template-columns: 1fr;
      align-content: start;
      gap: 0.25rem;
    }

    /* A slide's title rides in its words' box on a phone (the script):
       read first, scrolled away with them, and never pressed on by them. */
    .desc .slide-title + .body {
      margin-top: 0.75rem;
    }

    /* Words from the left edge, as on a desk (Juan, 2026-10-13: centring
       them read odd once the controls and the narrator sit at the edges). */
    .words {
      position: relative;
      z-index: 1;
    }

    .slot {
      order: -1;
      margin-top: 0;
    }

    /* No peek on a phone: its welcome is the words and the store row
       alone. A phone peeking under them was tried (2026-10-13) and put
       too much on one screen. */
    .is-welcome .slot {
      display: none;
    }

    .shot {
      box-shadow:
        var(--media-glow),
        0 2rem 4rem rgba(0, 0, 0, 0.55),
        0 0.5rem 1.25rem rgba(0, 0, 0, 0.4);
    }

    .lockup.small {
      display: none;
    }

    .lockup.big {
      gap: 0.75rem;
      padding-top: 0.5rem;
    }

    .lockup.big .lockup-name {
      font-size: clamp(1.75rem, 8vw, 2.25rem);
    }

    .slide-title {
      font-size: 1.5rem;
    }

    /* The box's fade needs the same air under the title a desk gives it
       — at 0.75rem the words faded out against the name (Juan,
       2026-10-13). */
    .desc {
      --cap-gap: 1.25rem;
    }

    .words .body {
      font-size: 1rem;
      line-height: 1.5;
    }

    .narr-slot,
    .narr-static {
      display: none;
    }

    .store-row :global(.stores) {
      margin-top: 1.25rem;
    }

    .controls {
      width: auto;
      margin-top: 0;
      padding-top: 0;
    }
  }

  /* SHORT PHONES (an SE, a phone with Safari's bars showing): the welcome's
     lockup, pitch and store row are one column over the controls, and at
     667pt tall the store row ran under the arrows. Everything steps down
     a notch so the column clears them. */
  @media (max-width: 48rem) and (max-height: 46rem) {

    .card,
    .is-welcome {
      gap: 1rem;
    }

    .lockup.big {
      padding-top: 0;
    }

    .lockup.big .lockup-name {
      font-size: 1.625rem;
    }

    .desc {
      --cap-gap: 1rem;
    }

    .words .body {
      font-size: 0.9375rem;
      line-height: 1.45;
    }

    .store-row :global(.stores) {
      margin-top: 0.875rem;
    }
  }

  /* SHORT DESKS (a 720pt laptop window): the welcome's two paragraphs, the
     store row and the narrator under them reached past the deck's arrows.
     The pitch steps down a size and its gaps tighten. */
  @media (min-width: 48.01rem) and (max-height: 50rem) {
    .is-welcome .body {
      font-size: 0.9375rem;
      line-height: 1.55;
    }

    .is-welcome .desc {
      --cap-gap: 0.875rem;
    }

    .is-welcome .words .body + .body {
      margin-top: 0.625rem;
    }

    .is-welcome .store-row :global(.stores) {
      margin-top: 1.25rem;
    }

    .is-welcome .narr-slot {
      margin-top: 1rem;
    }
  }
</style>

<script>
  import { createDeck, watchSlots, type Deck } from '../lib/deck';
  import { followPointer } from '../lib/tilt';
  import { dur, EASE } from '../lib/motion';

  const root = document.querySelector<HTMLElement>('[data-apps]');
  if (root) {
    const decksEl = root.querySelector<HTMLElement>('[data-decks]')!;
    // Absent with one app (see the docblock).
    const switcher = root.querySelector<HTMLElement>('[data-switcher]');
    const lozenge = switcher?.querySelector<HTMLElement>('.lozenge');
    const tabs = [...(switcher?.querySelectorAll<HTMLElement>('[data-tab]') ?? [])];
    const paras = [...root.querySelectorAll<HTMLElement>('[data-narr-para]')];
    const still = decksEl.querySelector<HTMLElement>('.narr-static .narr-anchor');

    type Held = { el: HTMLElement; cards: HTMLElement[]; deck: Deck };
    const held: Held[] = [];
    let active = 0;
    // How long a leaving deck stays drawn: its fade (`quick`), and a margin.
    const leaveMs = () => dur('quick') + 20;

    // Stand the still anchor on the front card's slot.
    // Where an element starts across the page, ignoring transforms.
    const pageLeft = (el: HTMLElement) => {
      let x = 0;
      for (let n: HTMLElement | null = el; n; n = n.offsetParent as HTMLElement | null)
        x += n.offsetLeft;
      return x;
    };
    const standAnchor = () => {
      const h = held[active];
      const card = h?.cards[h.deck.current];
      const slot = card?.querySelector<HTMLElement>('.narr-slot');
      if (!still || !slot) return;
      const y = slot.getBoundingClientRect().top - decksEl.getBoundingClientRect().top;
      still.style.setProperty('--slot-y', `${y.toFixed(1)}px`);
      // Sideways too: on the words' left edge — read from the LAYOUT, not
      // the screen: mid-turn the deck and its words slide sideways by a
      // transform, and reading that slide moved the narrator right and back
      // for nothing on every app switch (Juan, 2026-10-11).
      const x = pageLeft(slot) - pageLeft(still.parentElement ?? decksEl);
      still.style.setProperty('--slot-x', `${x.toFixed(1)}px`);
    };

    // The narrator starts this panel on the card in front, and a running
    // voice switches to it.
    const select = (card: HTMLElement | undefined) => {
      if (!card) return;
      requestAnimationFrame(standAnchor);
      const first = card.querySelector<HTMLElement>('[data-narr-para]');
      if (!first) return;
      root.dataset.narrStart = String(paras.indexOf(first));
      document.dispatchEvent(new CustomEvent('narr:select', { detail: first }));
    };

    /**
     * THE HAND-OFF — the welcome's lead phone (Home, Library) IS the first
     * card's phone, so it travels between them instead of one leaving and
     * the other arriving (Juan, 2026-10-11): the narrator's glide between
     * its anchors, made for a picture. A copy flies from where the phone
     * stands to where it will stand — walking in from the welcome's peek
     * — while both real ones are hidden; the one arriving is revealed in
     * its place when the copy lands.
     *
     * The copy flies INSIDE the panel, so the panel's edge cuts it exactly
     * where it cuts the peeking phone: it is uncovered as it walks in, and
     * covered again as it walks back out.
     */
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const phoneOf = (card: HTMLElement) => card.querySelector<HTMLElement>('.slot .shot');
    const pose = (img: HTMLElement) => {
      const r = img.getBoundingClientRect();
      const m = new DOMMatrix(getComputedStyle(img).transform);
      return {
        x: r.left + r.width / 2,
        y: r.top + r.height / 2,
        w: img.offsetWidth,
        h: img.offsetHeight,
        turn: (Math.atan2(m.b, m.a) * 180) / Math.PI,
      };
    };
    // A length written in the landing phone's pixels, in the copy's own —
    // which the flight scales by `scale`.
    const unscaled = (css: string, scale: number) =>
      css.replace(/(-?[\d.]+)px/g, (_, n) => `${(Number(n) / scale).toFixed(2)}px`);
    // While a copy flies, nothing leans toward the pointer: the phone it
    // lands on stands level, so the copy (always level) meets it exactly,
    // and leans in from there once it is revealed.
    let flying = false;
    const handOff = (from: HTMLElement, to: HTMLElement) => {
      if (reduced) return;
      const a = phoneOf(from);
      const b = phoneOf(to);
      // Both ends must be drawn: a phone's welcome shows no picture, so a
      // turn to or from it is a plain turn — flying to a hidden phone sent
      // the copy shrinking into the screen's top-left corner.
      if (!a || !b || !a.offsetHeight || !b.offsetHeight) return;
      const start = pose(a);
      to.classList.add('is-handoff');
      const end = pose(b);
      a.classList.add('is-flying');
      b.classList.add('is-flying');

      flying = true;
      const look = getComputedStyle(a);
      const ghost = a.cloneNode() as HTMLImageElement;
      ghost.removeAttribute('class');
      ghost.removeAttribute('style');
      const box = root.getBoundingClientRect();
      Object.assign(ghost.style, {
        position: 'absolute',
        willChange: 'transform',
        left: `${start.x - start.w / 2 - box.left}px`,
        top: `${start.y - start.h / 2 - box.top}px`,
        width: `${start.w}px`,
        height: `${start.h}px`,
        margin: '0',
        maxWidth: 'none',
        zIndex: '20',
        pointerEvents: 'none',
        borderRadius: look.borderRadius,
        border: look.border,
        boxShadow: look.boxShadow,
      });
      root.append(ghost);
      // Width and height each on its own: a welcome's phone and a slide's
      // phone differ in ratio by a pixel, and a uniform scale left the
      // copy that pixel off the phone it lands on.
      const scale = end.h / start.h;
      const scaleX = end.w / start.w;
      // TRANSFORM ONLY, which the compositor runs without repainting. It
      // used to animate its corner and its (wide, soft) shadow from where
      // it left to where it lands, which repainted the copy every frame —
      // and Safari dropped frames on it, with the narrator and the light
      // moving at the same time (2026-10-13). A welcome's phone and a
      // slide's are the same `.shot`, so the look never needed to change.
      const goal = getComputedStyle(b);
      const flight = ghost.animate(
        [
          { transform: `rotate(${start.turn}deg)` },
          {
            transform:
              `translate(${end.x - start.x}px, ${end.y - start.y}px) ` +
              `scale(${scaleX}, ${scale}) rotate(${end.turn}deg)`,
          },
        ],
        // It holds its landing pose while it fades off (`land`).
        // A picture moving: the ladder's `turn`, the light's pace too.
        { duration: dur('turn'), easing: EASE, fill: 'forwards' }
      );
      // Landed: the real phone is revealed UNDER the copy, which then
      // fades off it — so whatever sub-pixel the two still differ by
      // dissolves instead of jumping. The copy drops its shadow first: the
      // real phone casts the same one, and two stacked for the fade read
      // as the shadow flashing darker and back (Juan, 2026-10-13).
      let landed = false;
      const land = () => {
        if (landed) return;
        landed = true;
        flying = false;
        a.classList.remove('is-flying');
        b.classList.remove('is-flying');
        to.classList.remove('is-handoff');
        // Held where it landed, by hand, so the shadow can come off.
        flight.cancel();
        ghost.style.transform =
          `translate(${end.x - start.x}px, ${end.y - start.y}px) ` +
          `scale(${scaleX}, ${scale}) rotate(${end.turn}deg)`;
        ghost.style.borderRadius = unscaled(goal.borderRadius, scale);
        ghost.style.boxShadow = 'none';
        // The last card's phone lands on the welcome's, a DIFFERENT
        // screen: that hand-over is a cross-fade, so it takes `quick`.
        const same = a.getAttribute('src') === b.getAttribute('src');
        ghost
          .animate(
            { opacity: [1, 0] },
            { duration: dur(same ? 'micro' : 'quick'), easing: 'linear' }
          )
          .finished.finally(() => ghost.remove());
      };
      flight.onfinish = land;
      flight.oncancel = land;
    };

    // A SLIDE'S TITLE IN ITS WORDS' BOX, on a phone (Juan, 2026-10-13):
    // the box scrolls under a title standing over it, and pressed up
    // against it; inside, the title is the box's first line and scrolls
    // away with the rest. A desk keeps it over the words.
    if (matchMedia('(max-width: 48rem)').matches)
      for (const card of root.querySelectorAll<HTMLElement>('.is-slide')) {
        const title = card.querySelector<HTMLElement>('.slide-title');
        const desc = card.querySelector<HTMLElement>('.desc');
        if (title && desc) desc.prepend(title);
      }

    for (const el of root.querySelectorAll<HTMLElement>('[data-apps-deck]')) {
      const cards = [...el.querySelectorAll<HTMLElement>('.deck-card')];
      const h = { el, cards } as Held;
      let previous = 0;
      let slideTurn = 0;
      h.deck = createDeck({
        cards,
        controls: el.querySelector('[data-deck-controls]'),
        keys: el,
        swipe: el.querySelector<HTMLElement>('.stage'),
        onChange: current => {
          // To or from the welcome — its first card, or the last one the
          // deck wraps round from (Juan, 2026-10-13) — the phone flies.
          if (h.deck && previous !== current && (previous === 0 || current === 0))
            handOff(cards[previous], cards[current]);
          // Slide to slide, the app's small lockup is the same on both
          // cards: it holds still instead of fading out and back (the CSS).
          if (h.deck && previous !== current && previous > 0 && current > 0) {
            el.classList.add('is-slide-turn');
            clearTimeout(slideTurn);
            slideTurn = window.setTimeout(
              () => el.classList.remove('is-slide-turn'),
              dur('quick') + 100
            );
          }
          previous = current;
          // The first call comes while the deck is still being made.
          requestAnimationFrame(() => {
            if (held.indexOf(h) === active) select(cards[current]);
          });
        },
      });
      held.push(h);
    }

    // The lozenge stands under the picked tab — measured, since every
    // app's name is its own width.
    const placeLozenge = (animate = true) => {
      const tab = tabs[active];
      if (!tab || !lozenge) return;
      lozenge.classList.toggle('is-still', !animate);
      lozenge.style.setProperty('--x', `${tab.offsetLeft}px`);
      lozenge.style.setProperty('--w', `${tab.offsetWidth}px`);
    };

    // CHANGING APP IS ONE MOVE (Juan, 2026-10-11). The old deck drifts out
    // the way the switch went while the new one drifts in from the other
    // side, together, on one curve — and the new deck is ALREADY standing on
    // its welcome (or, when the voice carried the page here, on the card
    // being told). Replaying the card's entrance on top of the deck's own
    // move read as a gallop, two beats where there
    // should be one, and flicking between tabs replayed it every time.
    const show = (a: number, card?: number) => {
      if (a === active) return;
      const dir = a > active ? 1 : -1;
      const from = held[active];
      const to = held[a];
      active = a;

      tabs.forEach((t, i) => t.setAttribute('aria-selected', String(i === a)));
      placeLozenge();

      // Turned while still hidden, so the turn draws nothing.
      const target = card ?? 0;
      if (to.deck.current !== target) to.deck.go(target);

      from.el.style.setProperty('--dir', String(dir));
      from.el.classList.add('is-leaving');
      setTimeout(() => {
        from.el.classList.remove('is-leaving');
        if (held[active] !== from) from.el.hidden = true;
      }, leaveMs());

      to.el.style.setProperty('--dir', String(dir));
      to.el.classList.remove('is-leaving');
      to.el.hidden = false;
      to.el.classList.add('is-arriving');
      void to.el.offsetWidth;
      to.el.classList.remove('is-arriving');
      select(to.cards[target]);
    };

    tabs.forEach((t, a) => t.addEventListener('click', () => show(a)));

    // The switcher shows while the panel holds the screen — the middle of
    // the viewport inside it — and goes with it.
    const watch = () => {
      if (!switcher) return;
      const r = root.getBoundingClientRect();
      const mid = innerHeight / 2;
      switcher.classList.toggle('is-shown', r.top < mid && r.bottom > mid);
    };
    addEventListener('scroll', watch, { passive: true });
    addEventListener('resize', () => {
      watch();
      placeLozenge(false);
      standAnchor();
    });
    watch();
    // Fonts settle the tabs' widths after the first paint.
    placeLozenge(false);
    document.fonts?.ready.then(() => placeLozenge(false));

    // The voice moved on by itself: whatever shows its paragraph follows —
    // the deck turns, and past an app's last card the tab switches.
    document.addEventListener('narr:para', e => {
      const p = (e as CustomEvent<HTMLElement>).detail;
      if (!root.contains(p)) return;
      const a = Number(p.dataset.app);
      const c = Number(p.dataset.card);
      if (a !== active) {
        show(a, c);
        return;
      }
      const h = held[a];
      if (c !== h.deck.current) h.deck.go(c);
    });

    // The picture in front leans toward the pointer: a slide's phone (a
    // welcome's is peeking, and stands still).
    followPointer(root, () => {
      if (flying) return null;
      const h = held[active];
      return h.cards[h.deck.current]?.querySelector<HTMLElement>('.is-slide .shot');
    });

    // WARM THE HIDDEN APPS. A deck that is not in front is `hidden`, so its
    // lazy screenshots are neither fetched nor decoded until its tab is
    // picked — and then all of them land at once, mid-transition, and the
    // first switch to each app stuttered while every later one was smooth
    // (Juan, 2026-10-11). Once the page has loaded and the browser is idle,
    // each hidden picture is fetched and decoded, one at a time, so the
    // first switch draws from memory like the rest.
    const idle = (fn: () => void) =>
      'requestIdleCallback' in window
        ? requestIdleCallback(fn, { timeout: 2000 })
        : setTimeout(fn, 200);
    const warm = () => {
      // The deck in front first (its later cards are lazy too), then the
      // others in tab order.
      const queue = [held[active], ...held.filter((_, i) => i !== active)].flatMap(h => [
        ...h.el.querySelectorAll<HTMLImageElement>('img'),
      ]);
      const next = () => {
        const img = queue.shift();
        if (!img) return;
        img.loading = 'eager';
        img
          .decode()
          .catch(() => {})
          .finally(() => idle(next));
      };
      idle(next);
    };
    // Not on a connection the person asked to spare: ~5 MB of screenshots
    // is theirs to spend by picking a tab.
    const spare = (
      navigator as Navigator & { connection?: { saveData?: boolean } }
    ).connection?.saveData;
    if (!spare) {
      if (document.readyState === 'complete') warm();
      else addEventListener('load', warm, { once: true });
    }

    select(held[0].cards[0]);
    // Placed now as well as on the next frame, and again once fonts and
    // images have settled the words' height.
    standAnchor();
    document.fonts?.ready.then(standAnchor);
    addEventListener('load', standAnchor);
    watchSlots(
      held.flatMap(h => h.cards),
      standAnchor
    );
  }
</script>
