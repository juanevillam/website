---
import { type UIKey } from '../i18n/ui';
import T from './T.astro';

// Crol and ContoPay merged into ONE panel — two mini landings side by
// side, each with its own logo, accent, tagline (from the live landing),
// visit pill and scroll video. No names in text: the logo is the name.
type Brand = {
  id: 'crol' | 'contopay';
  name: string;
  role: UIKey;
  heading: UIKey;
  body: UIKey;
  href: string;
  domain: string;
};

const BRANDS: Brand[] = [
  {
    id: 'crol',
    name: 'Crol',
    role: 'experience.crol.role',
    heading: 'experience.crol.heading',
    body: 'experience.crol.body',
    href: 'https://www.crol.mx',
    domain: 'crol.mx',
  },
  {
    id: 'contopay',
    name: 'ContoPay',
    role: 'experience.contopay.role',
    heading: 'experience.contopay.heading',
    body: 'experience.contopay.body',
    href: 'https://www.contopay.lat',
    domain: 'contopay.lat',
  },
];
---

<section class="panel" id="work-duo">
  <div class="inner">
    {
      BRANDS.map(brand => (
        <article class={`brand brand-${brand.id}`}>
          <span class="logo" data-reveal>
            <img
              class="on-dark"
              src={`/media/brand/${brand.id}-on-dark.png`}
              alt={brand.name}
            />
            <img
              class="on-light"
              src={`/media/brand/${brand.id}-on-light.png`}
              alt={brand.name}
            />
          </span>
          <p class="label brand-label" data-reveal>
            <T k={brand.role} />
          </p>
          <h2 class="brand-heading" data-reveal>
            <T k={brand.heading} />
          </h2>
          <p class="body lede" data-reveal>
            <T k={brand.body} />
          </p>
          <a class="label visit" href={brand.href} data-reveal>
            <T k="experience.visit" />
            {` ${brand.domain} ↗`}
          </a>
          <video
            class="shot"
            src={`/media/screens/${brand.id}.webm`}
            poster={`/media/screens/${brand.id}.jpg`}
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            width="1280"
            height="800"
            data-reveal
          />
        </article>
      ))
    }
  </div>
</section>

<style>
  .inner {
    width: 100%;
    max-width: var(--content-max);
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  /* Per-brand accents over the shared skeleton — each half of the panel
     borrows its company's own color and face. */
  .brand-crol {
    --brand-accent: #00e100;
    --font-brand: 'Mulish', var(--font-sans);
  }

  :global(html[data-theme='light']) .brand-crol {
    --brand-accent: #00a300;
  }

  .brand-contopay {
    --brand-accent: #20bced;
    --font-brand: var(--font-sans);
  }

  :global(html[data-theme='light']) .brand-contopay {
    --brand-accent: #154f91;
  }

  .logo {
    display: block;
    margin-bottom: 1.25rem;
  }

  .logo img {
    height: 1.875rem;
    width: auto;
  }

  .on-light {
    display: none;
  }

  :global(html[data-theme='light']) .on-dark {
    display: none;
  }

  :global(html[data-theme='light']) .on-light {
    display: block;
  }

  .brand-label {
    color: var(--brand-accent);
    font-family: var(--font-brand);
  }

  .brand-heading {
    margin-top: 0.625rem;
    font-family: var(--font-brand);
    font-size: clamp(1.375rem, 2.4vw, 1.875rem);
    font-weight: 700;
    letter-spacing: var(--track-heading);
    line-height: 1.2;
  }

  .lede {
    margin-top: 1rem;
    font-size: 1rem;
    font-family: var(--font-brand);
  }

  .visit {
    display: inline-block;
    margin-top: 1.5rem;
    padding: 0.625rem 1.375rem;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    text-decoration: none;
    color: var(--ink-2);
    font-family: var(--font-brand);
    transition:
      color var(--dur-micro) var(--ease),
      border-color var(--dur-micro) var(--ease);
  }

  .visit:hover {
    color: var(--brand-accent);
    border-color: var(--brand-accent);
  }

  .shot {
    width: 100%;
    height: auto;
    margin-top: 1.75rem;
    border: 1px solid var(--hairline);
    border-radius: 0.75rem;
    background: var(--surface);
  }

  @media (max-width: 1023px) {
    .inner {
      grid-template-columns: 1fr;
      gap: 4rem;
    }
  }
</style>
