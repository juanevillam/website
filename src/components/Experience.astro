---
import T from './T.astro';

// The Crol ERP section (ContoPay is a secondary Crol product and rides
// inside its story): a Monolith panel holding a window into the brand —
// their near-black ground, neon lime CTA, Mulish — with a snap slider of
// the landing's key parts.
---

<section class="panel" id="work-crol">
  <div class="inner">
    <h2 class="heading name" data-reveal>Crol ERP</h2>

    <div class="window" data-reveal>
      <p class="tagline"><T k="experience.crol.heading" /></p>
      <p class="sub"><T k="experience.crol.body" /></p>
      <a class="cta" href="https://www.crol.mx">
        <T k="experience.visit" />
        {' crol.mx ↗'}
      </a>

      <div class="slides" tabindex="-1">
        {
          [1, 2, 3].map(n => (
            <img
              src={`/media/screens/crol-${n}.jpg`}
              alt={`Crol landing, part ${n}`}
              loading="lazy"
              decoding="async"
              width="1280"
              height="800"
            />
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .inner {
    width: 100%;
    max-width: var(--content-max);
    margin: 0 auto;
  }

  .name {
    font-size: clamp(2.5rem, 6vw, 4rem);
  }

  /* A fragment of the Crol landing, embedded. */
  .window {
    margin-top: 1.75rem;
    padding: clamp(1.5rem, 3.5vw, 2.75rem);
    border-radius: 1.25rem;
    background: #0a1413;
    font-family: 'Mulish', var(--font-sans);
  }

  .tagline {
    color: #ffffff;
    font-size: clamp(1.375rem, 2.6vw, 1.875rem);
    font-weight: 800;
    line-height: 1.25;
    max-width: 26em;
  }

  .sub {
    margin-top: 0.75rem;
    color: #a9b5b4;
    font-size: 1.0625rem;
    max-width: 40em;
  }

  .cta {
    display: inline-block;
    margin-top: 1.5rem;
    padding: 0.75rem 1.5rem;
    border-radius: 999px;
    background: #00e100;
    color: #132624;
    font-size: 0.9375rem;
    font-weight: 800;
    text-decoration: none;
    transition: background var(--dur-micro) var(--ease);
  }

  .cta:hover {
    background: #00c400;
  }

  .slides {
    margin-top: 1.75rem;
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 0.5rem;
  }

  .slides img {
    flex: 0 0 min(85%, 34rem);
    width: min(85%, 34rem);
    height: auto;
    scroll-snap-align: center;
    border-radius: 0.625rem;
    border: 1px solid #233734;
  }
</style>
