---
import T from './T.astro';

// The work page is Crol's mini landing (ContoPay is a secondary Crol
// product and rides inside its story). The panel takes Crol's own skin —
// near-black ground, neon lime accent, Mulish — over the site's custom
// properties, same mechanism as the Sálvalo page.
---

<section id="work-crol" class="panel">
  <div class="inner">
    <div class="copy">
      <span class="logo" data-reveal>
        <img class="on-dark" src="/media/brand/crol-on-dark.png" alt="Crol" />
        <img
          class="on-light"
          src="/media/brand/crol-on-light.png"
          alt="Crol"
        />
      </span>
      <p class="label brand-label" data-reveal><T k="experience.crol.role" /></p>
      <h2 class="heading brand-heading" data-reveal>
        <T k="experience.crol.heading" />
      </h2>
      <p class="body lede" data-reveal><T k="experience.crol.body" /></p>
      <a class="label visit" href="https://www.crol.mx" data-reveal>
        <T k="experience.visit" />
        {' crol.mx ↗'}
      </a>
    </div>

    <video
      class="shot"
      src="/media/screens/crol.webm"
      poster="/media/screens/crol.jpg"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      width="1280"
      height="800"
      data-reveal></video>
  </div>
</section>

<style>
  /* Crol skin — brand tokens over the site's own custom properties. */
  #work-crol {
    --ink: #ffffff;
    --ink-2: #a9b5b4;
    --ink-3: #6e807e;
    --surface: #132624;
    --hairline: #233734;
    --brand-accent: #00e100;
    --font-brand: 'Mulish', var(--font-sans);
    background: #0a1413;
  }

  :global(html[data-theme='light']) #work-crol {
    --ink: #132624;
    --ink-2: #3a4f4d;
    --ink-3: #6e807e;
    --surface: #ffffff;
    --hairline: #e2e8e7;
    --brand-accent: #00a300;
    background: #f7f9f9;
  }

  .inner {
    width: 100%;
    max-width: var(--content-max);
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .logo {
    display: block;
    margin-bottom: 1.5rem;
  }

  .logo img {
    height: 2rem;
    width: auto;
  }

  .on-light {
    display: none;
  }

  :global(html[data-theme='light']) .on-dark {
    display: none;
  }

  :global(html[data-theme='light']) .on-light {
    display: block;
  }

  .brand-label {
    color: var(--brand-accent);
    font-family: var(--font-brand);
  }

  .brand-heading {
    margin-top: 0.75rem;
    font-family: var(--font-brand);
    font-weight: 800;
  }

  .lede {
    margin-top: 1.5rem;
    font-size: 1.125rem;
    max-width: 44rem;
    font-family: var(--font-brand);
  }

  .visit {
    display: inline-block;
    margin-top: 2rem;
    padding: 0.625rem 1.375rem;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    text-decoration: none;
    color: var(--ink-2);
    font-family: var(--font-brand);
    transition:
      color var(--dur-micro) var(--ease),
      border-color var(--dur-micro) var(--ease);
  }

  .visit:hover {
    color: var(--brand-accent);
    border-color: var(--brand-accent);
  }

  .shot {
    width: 100%;
    height: auto;
    border: 1px solid var(--hairline);
    border-radius: 0.75rem;
    background: var(--surface);
  }

  @media (max-width: 1023px) {
    .inner {
      grid-template-columns: 1fr;
    }

    .shot {
      max-height: 40svh;
      width: auto;
      max-width: 100%;
    }
  }
</style>
