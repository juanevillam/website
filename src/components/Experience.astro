---
import { type UIKey } from '../i18n/ui';
import T from './T.astro';

// Each company is its own full-height panel in the Salvalo shape — the
// mini-landing sequence: Crol, then ContoPay, then Maktub (freelance).
type Job = {
  name: string;
  role: UIKey;
  when: UIKey;
  body: UIKey;
  href: string;
  domain: string;
};

const JOBS: Job[] = [
  {
    name: 'Crol',
    role: 'experience.crol.role',
    when: 'experience.crol.when',
    body: 'experience.crol.body',
    href: 'https://www.crol.mx',
    domain: 'crol.mx',
  },
  {
    name: 'ContoPay',
    role: 'experience.contopay.role',
    when: 'experience.contopay.when',
    body: 'experience.contopay.body',
    href: 'https://www.contopay.lat',
    domain: 'contopay.lat',
  },
  {
    name: 'Maktub',
    role: 'experience.maktub.role',
    when: 'experience.maktub.when',
    body: 'experience.maktub.body',
    href: 'https://maktubartfund.com',
    domain: 'maktubartfund.com',
  },
];
---

{
  JOBS.map(job => (
    <section class="panel" id={`work-${job.name.toLowerCase()}`}>
      <div class="inner">
        <p class="label role" data-reveal>
          <T k={job.role} />
        </p>
        <h2 class="heading name" data-reveal>
          {job.name}
        </h2>
        <p class="label when" data-reveal>
          <T k={job.when} />
        </p>
        <p class="body lede" data-reveal>
          <T k={job.body} />
        </p>
        <a class="label visit" href={job.href} data-reveal>
          <T k="experience.visit" />
          {` ${job.domain} ↗`}
        </a>
      </div>
    </section>
  ))
}

<style>
  .inner {
    width: 100%;
    max-width: var(--content-max);
    margin: 0 auto;
  }

  .role {
    color: var(--ink-3);
  }

  .name {
    margin-top: 0.75rem;
    font-size: clamp(2.5rem, 6vw, 4rem);
  }

  .when {
    margin-top: 0.875rem;
  }

  .lede {
    margin-top: 1.5rem;
    font-size: 1.125rem;
    max-width: 44rem;
  }

  .visit {
    display: inline-block;
    align-self: flex-start;
    margin-top: 2rem;
    padding: 0.625rem 1.375rem;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    text-decoration: none;
    color: var(--ink-2);
    transition:
      color var(--dur-micro) var(--ease),
      border-color var(--dur-micro) var(--ease);
  }

  .visit:hover {
    color: var(--ink);
    border-color: var(--ink-3);
  }
</style>
