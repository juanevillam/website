---
import { useTranslations, type Locale, type UIKey } from '../i18n/ui';

type Props = {
  locale: Locale;
};

const { locale } = Astro.props;
const t = useTranslations(locale);

// Real, live products — these links are the actual destinations (not the
// google.com sentinel the unreleased apps carry).
type Job = {
  name: string;
  role: UIKey;
  when: UIKey;
  body: UIKey;
  href: string;
  domain: string;
};
const JOBS: Job[] = [
  {
    name: 'ContoPay',
    role: 'experience.contopay.role',
    when: 'experience.contopay.when',
    body: 'experience.contopay.body',
    href: 'https://www.contopay.lat',
    domain: 'contopay.lat',
  },
  {
    name: 'Crol',
    role: 'experience.crol.role',
    when: 'experience.crol.when',
    body: 'experience.crol.body',
    href: 'https://www.crol.mx',
    domain: 'crol.mx',
  },
];
---

<section id="experience" class="experience">
  <div class="inner">
    <p class="label" data-reveal>{t('experience.label')}</p>
    <h2 class="heading" data-reveal>{t('experience.heading')}</h2>
    <p class="body lede" data-reveal>{t('experience.lede')}</p>

    {
      JOBS.map(job => (
        <article class="job" data-reveal>
          <p class="label role">{t(job.role)}</p>
          <h3 class="name">{job.name}</h3>
          <p class="label when">{t(job.when)}</p>
          <p class="body job-body">{t(job.body)}</p>
          <a class="label visit" href={job.href}>
            {t('experience.visit')} {job.domain} ↗
          </a>
        </article>
      ))
    }
  </div>
</section>

<style>
  .experience {
    padding: var(--space-section) clamp(1.25rem, 4vw, 2.5rem);
  }

  .inner {
    max-width: var(--content-max);
    margin: 0 auto;
  }

  .heading {
    margin-top: 0.75rem;
  }

  .lede {
    margin-top: 1.5rem;
    font-size: 1.125rem;
    max-width: 44rem;
  }

  .job {
    margin-top: var(--space-4);
    padding-top: 3rem;
    border-top: 1px solid var(--hairline);
    /* Name and meta on the left, the story on the right, split on the
       Monolith seam (4 : 9) — the ratio holds even without drawn lines. */
    display: grid;
    grid-template-columns: var(--seam) minmax(0, 1fr);
    gap: 0.5rem clamp(2rem, 6vw, 5rem);
    align-items: start;
  }

  .role {
    grid-column: 1;
    color: var(--ink-3);
  }

  .name {
    grid-column: 1;
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    font-weight: 800;
    letter-spacing: var(--track-display);
    line-height: 1;
    margin-top: 0.5rem;
  }

  .when {
    grid-column: 1;
    margin-top: 0.875rem;
  }

  .job-body {
    grid-column: 2;
    grid-row: 1 / span 3;
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  .visit {
    grid-column: 2;
    justify-self: start;
    margin-top: 1.5rem;
    display: inline-block;
    padding: 0.625rem 1.375rem;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    text-decoration: none;
    color: var(--ink-2);
    transition:
      color var(--dur-micro) var(--ease),
      border-color var(--dur-micro) var(--ease);
  }

  .visit:hover {
    color: var(--ink);
    border-color: var(--ink-3);
  }

  @media (max-width: 820px) {
    .job {
      grid-template-columns: 1fr;
    }

    .role,
    .name,
    .when,
    .job-body,
    .visit {
      grid-column: 1;
    }

    .job-body {
      grid-row: auto;
      margin-top: 1.25rem;
    }
  }
</style>
