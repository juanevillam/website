---
import T from './T.astro';

// The Sálvalo section: a Monolith panel holding a WINDOW into the brand —
// a card that looks like a piece of the Sálvalo landing living inside
// this site (their navy band, Poppins, their green CTA), with a snap
// slider of the landing's key parts. The page around it stays Monolith.
---

<section class="panel" id="salvalo">
  <div class="inner">
    <h2 class="heading name" data-reveal>Sálvalo</h2>

    <div class="window" data-reveal>
      <p class="tagline"><T k="salvalo.heading" /></p>
      <p class="sub"><T k="salvalo.body" /></p>
      <a class="cta" href="https://salvalo.app">
        <T k="experience.visit" />
        {' salvalo.app ↗'}
      </a>

      <div class="slides" tabindex="-1">
        {
          [1, 2, 3].map(n => (
            <img
              src={`/media/screens/salvalo-${n}.jpg`}
              alt={`Sálvalo landing, part ${n}`}
              loading="lazy"
              decoding="async"
              width="1280"
              height="800"
            />
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .inner {
    width: 100%;
    max-width: var(--content-max);
    margin: 0 auto;
  }

  .name {
    font-size: clamp(2.5rem, 6vw, 4rem);
  }

  /* A fragment of the Sálvalo landing, embedded: their band gradient,
     their face, their button — whatever the site's theme is. */
  .window {
    margin-top: 1.75rem;
    padding: clamp(1.5rem, 3.5vw, 2.75rem);
    border-radius: 1.25rem;
    background: linear-gradient(180deg, #2c4a64 0%, #1e374c 48%, #162a3a 100%);
    font-family: 'Poppins', var(--font-sans);
  }

  .tagline {
    color: #f5f6f7;
    font-size: clamp(1.375rem, 2.6vw, 1.875rem);
    font-weight: 700;
    line-height: 1.25;
    max-width: 26em;
  }

  .sub {
    margin-top: 0.75rem;
    color: #d6d9db;
    font-size: 1.0625rem;
    max-width: 40em;
  }

  .cta {
    display: inline-block;
    margin-top: 1.5rem;
    padding: 0.75rem 1.5rem;
    border-radius: 999px;
    background: #53da8f;
    color: #162a3a;
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    transition: background var(--dur-micro) var(--ease);
  }

  .cta:hover {
    background: #84e2b2;
  }

  .slides {
    margin-top: 1.75rem;
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 0.5rem;
  }

  .slides img {
    flex: 0 0 min(85%, 34rem);
    width: min(85%, 34rem);
    height: auto;
    scroll-snap-align: center;
    border-radius: 0.625rem;
    border: 1px solid rgba(245, 246, 247, 0.16);
  }
</style>
