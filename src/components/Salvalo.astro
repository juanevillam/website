---
import T from './T.astro';

// Skeleton of the Sálvalo mini landing — the brand skin (palette, Poppins,
// logo) arrives with the theming engine; the structure and copy live here.
---

<section id="salvalo" class="panel">
  <div class="inner">
    <p class="label" data-reveal><T k="salvalo.label" /></p>
    <h2 class="heading" data-reveal><T k="salvalo.heading" /></h2>
    <p class="body lede" data-reveal><T k="salvalo.body" /></p>
    <a class="label visit" href="https://salvalo.app" data-reveal>
      <T k="experience.visit" />
      {' salvalo.app ↗'}
    </a>
  </div>
</section>

<style>
  .inner {
    width: 100%;
    max-width: var(--content-max);
    margin: 0 auto;
  }

  .heading {
    margin-top: 0.75rem;
  }

  .lede {
    margin-top: 1.5rem;
    font-size: 1.125rem;
    max-width: 44rem;
  }

  .visit {
    display: inline-block;
    margin-top: 2rem;
    padding: 0.625rem 1.375rem;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    text-decoration: none;
    color: var(--ink-2);
    transition:
      color var(--dur-micro) var(--ease),
      border-color var(--dur-micro) var(--ease);
  }

  .visit:hover {
    color: var(--ink);
    border-color: var(--ink-3);
  }
</style>
