---
import T from './T.astro';

/**
 * The one narration control — a pill that plays Juan's voice. Two homes:
 * the hero (a solo clip) and a story's intro panel (arms narration mode
 * for that story's slides). The controller in StoryShowcase drives both;
 * this component only renders the button.
 *
 * It renders NOTHING when no clip exists yet — the captions already are
 * the transcript, so the page works as pure text until Juan records.
 */
type Props = {
  /** The clip this pill starts with. Absent → the pill doesn't render. */
  audio?: string;
  /** The story (section id) this pill arms; absent for a solo clip. */
  story?: string;
};

const { audio, story } = Astro.props;
---

{
  audio && (
    <button
      class="listen"
      data-audio={audio}
      data-narrate-story={story}
      data-reveal
    >
      <svg class="glyph play" viewBox="0 0 12 12" aria-hidden="true">
        <path fill="currentColor" d="M2.5 1.5l8 4.5-8 4.5z" />
      </svg>
      <svg class="glyph pause" viewBox="0 0 12 12" aria-hidden="true">
        <path fill="currentColor" d="M2.5 1.5h2.6v9H2.5zM6.9 1.5h2.6v9H6.9z" />
      </svg>
      <span class="word idle">
        <T k="listen" />
      </span>
      <span class="word playing">
        <T k="pause" />
      </span>
    </button>
  )
}

<style>
  /* The visit pill's shape — a control, so it keeps the 999px invite. */
  .listen {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    margin-top: 1.5rem;
    padding: 0.625rem 1.375rem;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    background: transparent;
    font: inherit;
    font-size: 0.9375rem;
    color: var(--ink-2);
    cursor: pointer;
    transition:
      color var(--dur-micro) var(--ease),
      border-color var(--dur-micro) var(--ease);
  }

  .listen:hover {
    color: var(--ink);
    border-color: var(--ink-3);
  }

  .glyph {
    width: 0.75rem;
    height: 0.75rem;
  }

  .listen .pause,
  .listen .playing,
  .listen.is-playing .play,
  .listen.is-playing .idle {
    display: none;
  }

  .listen.is-playing .pause {
    display: block;
  }

  .listen.is-playing .playing {
    display: inline;
  }
</style>
