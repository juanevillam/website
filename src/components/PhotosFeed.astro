---
import T from './T.astro';
import { PHOTO_POSTS, posterOf } from '../lib/photos';
import { versionedMedia } from '../lib/mediaVersion';
import { sceneAttr, sceneOf } from '../lib/scene';

/**
 * THE PHOTOS CARD'S SCREEN (MoreOfMe) — Juan's personal photo feed inside
 * juanevillam.com (/more-of-me/photos).
 *
 * Shares the same two-column PanelDeck layout as Cosmos and Songs (title,
 * subtitle, scrollable text, and narrator on the left; this interactive 3:2
 * screen on the right).
 *
 * Every image in every post computes its own ambient scene palette (`scenes`)
 * at build time so stepping through a post's carousel updates the room light
 * ("el blob") to match the exact photo on screen.
 */
const GOOGLE_CLIENT_ID =
  '524645244113-p2agelg1r5javeg9mje2c6cmle86mqbg.apps.googleusercontent.com';
const posts = await Promise.all(
  PHOTO_POSTS.map(async post => {
    const media = post.media.map(versionedMedia);
    const cover = versionedMedia(posterOf(post.media[0]));
    const scenes = await Promise.all(
      post.media.map(async m => sceneAttr(await sceneOf(posterOf(m)))),
    );
    return {
      ...post,
      media,
      cover,
      scene: scenes[0],
      scenes,
    };
  }),
);
---

<div
  class="photos is-locked"
  data-photos
  data-view="grid"
  data-google-client-id={GOOGLE_CLIENT_ID}
  data-posts={JSON.stringify(posts)}
>
  <!-- Profile header -->
  <header class="ig-head">
    <div class="ig-ident">
      <div class="ig-avatar" aria-hidden="true">
        <img
          src="/media/likes/photos/profile.webp"
          alt=""
          width="80"
          height="80"
          decoding="async"
          draggable="false"
        />
      </div>
      <div class="ig-handle-row">
        <span class="ig-handle">juanevillam</span>
      </div>
    </div>

    <div class="ig-actions">
      <div class="view-switch" role="group" aria-labelledby="photos-view-label">
        <span id="photos-view-label" class="sr"><T k="photos.grid" /> / <T k="photos.feed" /></span>
        <button
          type="button"
          class="circle-btn is-active"
          data-view-btn="grid"
          aria-pressed="true"
        >
          <svg viewBox="0 0 18 18" width="14" height="14" aria-hidden="true">
            <rect
              x="2"
              y="2"
              width="5.5"
              height="5.5"
              rx="1"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"></rect>
            <rect
              x="10.5"
              y="2"
              width="5.5"
              height="5.5"
              rx="1"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"></rect>
            <rect
              x="2"
              y="10.5"
              width="5.5"
              height="5.5"
              rx="1"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"></rect>
            <rect
              x="10.5"
              y="10.5"
              width="5.5"
              height="5.5"
              rx="1"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"></rect>
          </svg>
          <span class="sr"><T k="photos.grid" /></span>
        </button>
        <button
          type="button"
          class="circle-btn"
          data-view-btn="detail"
          aria-pressed="false"
        >
          <svg viewBox="0 0 18 18" width="14" height="14" aria-hidden="true">
            <rect
              x="2.5"
              y="2.5"
              width="13"
              height="8.5"
              rx="1.5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"></rect>
            <path
              d="M2.5 14.5h13"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"></path>
          </svg>
          <span class="sr"><T k="photos.feed" /></span>
        </button>
      </div>
      <button
        type="button"
        class="circle-btn sign-out-btn"
        data-sign-out
      >
        <svg viewBox="0 0 18 18" width="14" height="14" aria-hidden="true">
          <path
            d="M7 3.5H4.25A1.25 1.25 0 0 0 3 4.75v8.5A1.25 1.25 0 0 0 4.25 14.5H7"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
          <path
            d="M11.5 6.25 14.5 9l-3 2.75M14.25 9H7.5"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        <span class="sr"><T k="photos.lock" /></span>
      </button>
    </div>
  </header>

  <div class="ig-body">
    <!-- 3-column Instagram grid -->
    <div class="ig-grid-wrap" data-panel-view="grid" inert>
      <div class="ig-grid">
        {
          posts.map((post, idx) => {
            const hasVideo = post.media.some(m => /\.mp4(\?|$)/.test(m));
            const isMulti = post.media.length > 1;
            return (
              <button
                type="button"
                class="ig-tile"
                data-open-post={idx}
                aria-label={post.caption.en}
              >
                <img
                  src={post.cover}
                  alt={post.caption.en}
                  loading="lazy"
                  decoding="async"
                  draggable="false"
                />
                {(isMulti || hasVideo) && (
                  <span class="tile-badge" aria-hidden="true">
                    {!isMulti && hasVideo ? (
                      <svg viewBox="0 0 20 20" width="18" height="18">
                        <path
                          d="M5.5 3.8v12.4a1 1 0 0 0 1.53.85l9.7-6.2a1 1 0 0 0 0-1.7l-9.7-6.2A1 1 0 0 0 5.5 3.8Z"
                          fill="currentColor"
                        />
                      </svg>
                    ) : (
                      /* Instagram-style filled stacked squares icon */
                      <svg viewBox="0 0 22 22" width="18" height="18">
                        <rect
                          x="2"
                          y="5.5"
                          width="13.5"
                          height="13.5"
                          rx="2.6"
                          fill="currentColor"
                        />
                        <path
                          d="M7.5 2h9.4A3.1 3.1 0 0 1 20 5.1v9.4a1 1 0 0 1-2 0V5.3a1.3 1.3 0 0 0-1.3-1.3H7.5a1 1 0 0 1 0-2Z"
                          fill="currentColor"
                        />
                      </svg>
                    )}
                  </span>
                )}
              </button>
            );
          })
        }
      </div>
    </div>

    <!-- Single-column post detail view -->
    <div class="ig-detail is-hidden" data-panel-view="detail">
      <div class="post-stage">
        <div class="post-media" data-post-media>
          {
            [0, 1].map(() => (
              <div class="media-layer" data-media-layer>
                <img
                  class="media-fill"
                  data-media-fill
                  alt=""
                  decoding="async"
                  draggable="false"
                />
                <img
                  class="media-main"
                  data-media-img
                  alt=""
                  decoding="async"
                  draggable="false"
                />
                <video
                  class="media-main is-hidden"
                  data-media-video
                  playsinline
                  loop
                  preload="metadata"
                />
              </div>
            ))
          }

          <span class="slide-count" data-slide-count>1/1</span>

          <button
            type="button"
            class="media-step prev"
            data-media-step="-1"
          >
            <span class="sr"><T k="deck.prev" /></span>
            <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true">
              <path
                d="M10 3 L5 8 L10 13"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </button>
          <button
            type="button"
            class="media-step next"
            data-media-step="1"
          >
            <span class="sr"><T k="deck.next" /></span>
            <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true">
              <path
                d="M6 3 L11 8 L6 13"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </button>

          <!-- Overlay inside media: caption left, mute + post switcher right -->
          <div class="post-overlay">
            <span class="post-caption" data-post-caption></span>

            <div class="post-overlay-trail">
              <button
                type="button"
                class="circle-btn media-mute is-unmuted is-hidden"
                data-media-mute
              >
                <svg
                  class="icon-muted"
                  viewBox="0 0 16 16"
                  width="13"
                  height="13"
                  aria-hidden="true"
                >
                  <path
                    d="M2.5 6.2h2.6l3.4-2.8v9.2l-3.4-2.8H2.5V6.2Zm8.2 0 3.6 3.6m0-3.6-3.6 3.6"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
                </svg>
                <svg
                  class="icon-unmuted"
                  viewBox="0 0 16 16"
                  width="13"
                  height="13"
                  aria-hidden="true"
                >
                  <path
                    d="M2.5 6.2h2.6l3.4-2.8v9.2l-3.4-2.8H2.5V6.2Zm8.3-.7a3.6 3.6 0 0 1 0 5m1.8-6.8a6 6 0 0 1 0 8.6"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
                </svg>
                <span class="sr"><T k="photos.mute" /></span>
              </button>

              <div class="post-nav-pills">
                <button
                  type="button"
                  class="circle-btn"
                  data-post-step="-1"
                >
                  <span class="sr"><T k="deck.prev" /></span>
                  <svg
                    viewBox="0 0 16 16"
                    width="11"
                    height="11"
                    aria-hidden="true"
                  >
                    <path
                      d="M10 3.2 5.2 8l4.8 4.8"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.7"
                      stroke-linecap="round"
                      stroke-linejoin="round"></path>
                  </svg>
                </button>
                <button
                  type="button"
                  class="circle-btn"
                  data-post-step="1"
                >
                  <span class="sr"><T k="deck.next" /></span>
                  <svg
                    viewBox="0 0 16 16"
                    width="11"
                    height="11"
                    aria-hidden="true"
                  >
                    <path
                      d="M6 3.2 10.8 8 6 12.8"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.7"
                      stroke-linecap="round"
                      stroke-linejoin="round"></path>
                  </svg>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Tonal Liquid Glass Gate (Google Sign-In, verified server-side) -->
    <div class="ig-gate" data-gate>
      <div class="gate-card">
        <div class="gate-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="20" height="20">
            <rect
              x="4.5"
              y="10.5"
              width="15"
              height="10"
              rx="2.5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"></rect>
            <path
              d="M8 10.5V7.5a4 4 0 0 1 8 0v3"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"></path>
          </svg>
        </div>
        <h4 class="gate-title"><T k="photos.gateTitle" /></h4>
        <p class="gate-desc"><T k="photos.gateBody" /></p>

        <div class="gate-google" data-google-btn></div>

        <p class="gate-error is-hidden" data-gate-error>
          <T k="photos.gateError" />
        </p>
      </div>
    </div>
  </div>
</div>

<style>
  .photos {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    background: var(--ground);
    color: var(--ink);
    overflow: hidden;
    user-select: none;
  }

  /* ---------- header ---------- */
  .ig-head {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.625rem 0.875rem;
    border-bottom: 1px solid var(--hairline);
    background: color-mix(in srgb, var(--surface) 86%, transparent);
    backdrop-filter: blur(16px) saturate(1.8);
    -webkit-backdrop-filter: blur(16px) saturate(1.8);
    z-index: 3;
  }

  .ig-ident {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-width: 0;
  }

  .ig-avatar {
    flex: none;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    border: 1px solid var(--hairline);
    background: var(--surface);
    box-shadow: inset 0 0.75px 0 rgb(255 255 255 / 0.16);
    overflow: hidden;
    display: grid;
    place-items: center;
  }

  .ig-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ig-handle-row {
    display: flex;
    align-items: baseline;
    gap: 0.625rem;
    flex-wrap: wrap;
  }

  .ig-handle {
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .ig-actions {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .view-switch {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  /* Lone glyph controls: circle (50%) + scale(0.90) active squash */
  .circle-btn {
    position: relative;
    width: 1.875rem;
    height: 1.875rem;
    padding: 0;
    border-radius: 50%;
    border: 1px solid var(--hairline);
    background: color-mix(in srgb, var(--surface) 82%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: var(--ink-2);
    display: grid;
    place-items: center;
    cursor: pointer;
    transition:
      color var(--hover),
      border-color var(--hover),
      background-color var(--hover),
      transform var(--dur-micro) var(--ease),
      opacity var(--dur-quick) var(--ease);
  }

  .circle-btn::before {
    content: '';
    position: absolute;
    inset: -0.4375rem;
  }

  .circle-btn:hover,
  .circle-btn.is-active {
    color: var(--ink);
    border-color: var(--ink-3);
  }

  .circle-btn.is-active {
    background: color-mix(in srgb, var(--ink) 14%, var(--surface));
  }

  .circle-btn:active {
    transform: scale(0.9);
  }

  /* ---------- body & 3-column grid ---------- */
  .ig-body {
    position: relative;
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr);
  }

  .ig-grid-wrap,
  .ig-detail {
    grid-area: 1 / 1;
    min-height: 0;
    transition: opacity var(--dur-quick) var(--ease);
  }

  .ig-grid-wrap.is-hidden,
  .ig-detail.is-hidden {
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
  }

  .ig-grid-wrap {
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: rgb(255 255 255 / 0.18) transparent;
    padding: 2px;
  }

  .ig-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2px;
  }

  .ig-tile {
    position: relative;
    aspect-ratio: 1 / 1;
    padding: 0;
    border: 0;
    background: var(--surface);
    overflow: hidden;
    cursor: pointer;
    transition: transform var(--dur-micro) var(--ease);
  }

  .ig-tile:active {
    transform: scale(0.98);
  }

  .ig-tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition:
      transform var(--dur-turn) var(--ease),
      filter var(--dur-turn) var(--ease);
  }

  .photos.is-locked .ig-tile img {
    filter: blur(28px) saturate(0.7) brightness(0.45);
    transform: scale(1.22);
  }

  .photos.is-locked .ig-actions {
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
  }

  .ig-tile:hover img {
    transform: scale(1.03);
  }

  .tile-badge {
    position: absolute;
    top: 0.55rem;
    right: 0.55rem;
    color: var(--ink);
    filter: drop-shadow(0 1px 4px rgb(0 0 0 / 0.72));
    pointer-events: none;
  }

  /* ---------- single-column post detail view ---------- */
  .ig-detail {
    display: flex;
    min-height: 0;
  }

  .post-stage {
    flex: 1;
    min-width: 0;
    min-height: 0;
    display: flex;
    flex-direction: column;
    background: var(--ground);
  }

  .post-media {
    position: relative;
    flex: 1;
    min-width: 0;
    min-height: 0;
    background: var(--ground);
    overflow: hidden;
    display: grid;
    place-items: center;
    cursor: pointer;
    touch-action: pan-y;
  }

  .media-layer {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity var(--dur-quick) linear,
      visibility 0s linear var(--dur-quick);
  }

  .ig-detail:not(.is-hidden) .media-layer.is-on {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition:
      opacity var(--dur-quick) linear,
      visibility 0s linear 0s;
  }

  .media-fill,
  .media-main {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .media-fill {
    object-fit: cover;
    transform: scale(1.18);
    filter: blur(28px) saturate(1.22) brightness(0.55);
  }

  .media-main {
    object-fit: contain;
  }

  .media-main.is-hidden {
    opacity: 0;
    pointer-events: none;
  }

  .slide-count {
    position: absolute;
    top: 0.625rem;
    right: 0.625rem;
    z-index: 2;
    padding: 0.1875rem 0.5rem;
    border-radius: 999px;
    border: 1px solid var(--hairline);
    background: color-mix(in srgb, var(--surface) 82%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
    min-width: 4.5ch;
    text-align: center;
    white-space: nowrap;
    color: var(--ink);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur-quick) var(--ease);
  }

  .slide-count.is-shown {
    opacity: 1;
  }

  /* Same muted arrow recipe as Events / PanelDeck `.photo-step`:
     0.3 at rest, 0.7 when hovering the photo frame, 1 on the arrow itself. */
  .media-step {
    position: absolute;
    top: 50%;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface) 82%, transparent);
    color: var(--ink);
    cursor: pointer;
    opacity: 0.3;
    transform: translateY(-50%);
    transition:
      opacity var(--hover),
      border-color var(--hover),
      transform var(--dur-micro) var(--ease);
  }

  .media-step::before {
    content: '';
    position: absolute;
    inset: -0.375rem;
  }

  .post-media:hover .media-step {
    opacity: 0.7;
  }

  .post-media .media-step:hover,
  .media-step:focus-visible {
    opacity: 1;
    border-color: var(--ink-3);
  }

  .media-step:active {
    transform: translateY(-50%) scale(0.9);
  }

  .media-step.prev {
    left: 0.625rem;
  }

  .media-step.next {
    right: 0.625rem;
  }

  .media-step.is-hidden,
  .slide-count.is-hidden,
  .media-mute.is-hidden {
    opacity: 0 !important;
    pointer-events: none !important;
  }

  .media-mute {
    position: relative;
  }

  .media-mute.is-hidden {
    display: none;
  }

  .media-mute:not(.is-unmuted) .icon-unmuted,
  .media-mute.is-unmuted .icon-muted {
    display: none;
  }

  /* ---------- post overlay inside media (caption + post controls) ---------- */
  .post-overlay {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 2.75rem 0.875rem 0.625rem;
    background: linear-gradient(
      to bottom,
      rgb(13 13 13 / 0) 0%,
      rgb(13 13 13 / 0.14) 24%,
      rgb(13 13 13 / 0.48) 54%,
      rgb(13 13 13 / 0.82) 82%,
      rgb(13 13 13 / 0.94) 100%
    );
    pointer-events: none;
  }

  .post-caption {
    min-width: 0;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .post-overlay-trail {
    flex: none;
    display: flex;
    align-items: center;
    gap: 0.375rem;
    pointer-events: auto;
  }

  .post-nav-pills {
    display: flex;
    gap: 0.25rem;
  }

  /* ---------- Tonal Liquid Glass Gate ---------- */
  .ig-gate {
    grid-area: 1 / 1;
    z-index: 4;
    display: grid;
    place-items: center;
    padding: 1.25rem;
    background: color-mix(in srgb, var(--ground) 72%, transparent);
    backdrop-filter: blur(24px) saturate(1.4);
    -webkit-backdrop-filter: blur(24px) saturate(1.4);
    transition:
      opacity var(--dur-turn) var(--ease),
      visibility 0s linear 0s;
  }

  .photos:not(.is-locked) .ig-gate {
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
    transition:
      opacity var(--dur-turn) var(--ease),
      visibility 0s linear var(--dur-turn);
  }

  .gate-card {
    width: min(21.5rem, 100%);
    padding: 1.25rem;
    border-radius: 1.25rem;
    border: 1px solid var(--hairline);
    background: color-mix(in srgb, var(--surface) 86%, transparent);
    backdrop-filter: blur(18px) saturate(1.8);
    -webkit-backdrop-filter: blur(18px) saturate(1.8);
    box-shadow:
      inset 0 0.75px 0 rgb(255 255 255 / 0.18),
      0 1.5rem 3rem rgb(0 0 0 / 0.5);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.625rem;
    transform: scale(1);
    transition: transform var(--dur-turn) var(--ease);
  }

  .photos:not(.is-locked) .gate-card {
    transform: scale(0.96);
  }

  .gate-icon {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    border: 1px solid var(--hairline);
    background: var(--ground);
    display: grid;
    place-items: center;
    color: var(--ink);
  }

  .gate-title {
    margin: 0;
    font-size: 1.0625rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .gate-desc {
    margin: 0;
    font-size: 0.78125rem;
    line-height: 1.45;
    color: var(--ink-body);
    max-width: 34ch;
  }

  .gate-google {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    min-height: 2.5rem;
    margin-top: 0.4rem;
    border-radius: 999px;
    overflow: hidden;
    /* Match GIS iframe's light color-scheme so Chromium/WebKit never paints an
       opaque white fallback box behind the rounded dark pill button. */
    color-scheme: light;
    line-height: 0;
  }

  .gate-error {
    margin: 0;
    font-size: 0.75rem;
    color: #ff453a;
  }

  .gate-error.is-hidden {
    display: none;
  }

  .photos.is-locked .sign-out-btn {
    display: none;
  }

  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  @media (max-width: 48rem) {
    :global(.screen.is-own:has(> [data-photos]) > .screen-caption) {
      z-index: 3;
      padding-top: 3.25rem;
      background: linear-gradient(
        to bottom,
        rgb(13 13 13 / 0) 0%,
        rgb(13 13 13 / 0.08) 16%,
        rgb(13 13 13 / 0.28) 34%,
        rgb(13 13 13 / 0.58) 54%,
        rgb(13 13 13 / 0.84) 74%,
        rgb(13 13 13 / 0.96) 90%,
        rgb(13 13 13 / 1) 100%
      );
      transition: opacity var(--dur-quick) var(--ease);
    }

    :global(
        .screen.is-own:has(> [data-photos][data-view='detail']) > .screen-caption
      ) {
      opacity: 0;
      pointer-events: none;
    }

    .ig-head {
      padding: 0.45rem 0.75rem;
      gap: 0.5rem;
    }

    .ig-ident {
      gap: 0.55rem;
    }

    .ig-avatar {
      width: 2.125rem;
      height: 2.125rem;
    }

    .ig-handle-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.2rem;
      line-height: 1.15;
    }

    .ig-handle {
      font-size: 0.9375rem;
      line-height: 1.1;
    }

    .ig-grid-wrap {
      padding-bottom: 2.75rem;
    }

    .post-overlay {
      padding: 2.25rem 0.75rem 0.55rem;
    }
  }
</style>

<script>
  import type { Locale } from '../i18n/ui';
  import type { PhotoPost } from '../lib/photos';

  type EnrichedPost = PhotoPost & {
    cover: string;
    scene?: string;
    scenes?: string[];
  };
  type GoogleAccounts = {
    accounts?: {
      id?: {
        initialize: (cfg: {
          client_id: string;
          callback: (res: { credential?: string }) => void;
          auto_select?: boolean;
          cancel_on_tap_outside?: boolean;
        }) => void;
        renderButton: (
          parent: HTMLElement,
          opts: {
            type?: string;
            theme?: string;
            size?: string;
            shape?: string;
            text?: string;
            locale?: string;
          },
        ) => void;
        disableAutoSelect?: () => void;
      };
    };
  };

  let gsiPromise: Promise<GoogleAccounts['accounts']> | null = null;
  const loadGsi = () => {
    if (gsiPromise) return gsiPromise;
    gsiPromise = new Promise((resolve, reject) => {
      const existing = (window as unknown as { google?: GoogleAccounts }).google;
      if (existing?.accounts?.id) return resolve(existing.accounts);
      const s = document.createElement('script');
      s.src = 'https://accounts.google.com/gsi/client';
      s.async = true;
      s.defer = true;
      s.onload = () => {
        const g = (window as unknown as { google?: GoogleAccounts }).google;
        if (g?.accounts?.id) resolve(g.accounts);
        else reject(new Error('gsi_unavailable'));
      };
      s.onerror = () => reject(new Error('gsi_load_failed'));
      document.head.appendChild(s);
    });
    return gsiPromise;
  };

  const currentLang = (): Locale => {
    const l = document.documentElement.dataset.lang;
    return l === 'es' || l === 'zh' ? l : 'en';
  };

  for (const root of document.querySelectorAll<HTMLElement>('[data-photos]')) {
    const posts: EnrichedPost[] = JSON.parse(root.dataset.posts ?? '[]');
    if (!posts.length) continue;

    const googleClientId = root.dataset.googleClientId ?? '';
    const cardEl = root.closest<HTMLElement>('.deck-card');
    const gridWrap = root.querySelector<HTMLElement>(
      '[data-panel-view="grid"]',
    )!;
    const detailWrap = root.querySelector<HTMLElement>(
      '[data-panel-view="detail"]',
    )!;
    const viewBtns = [
      ...root.querySelectorAll<HTMLButtonElement>('[data-view-btn]'),
    ];
    const signOutBtn =
      root.querySelector<HTMLButtonElement>('[data-sign-out]')!;

    const gateEl = root.querySelector<HTMLElement>('[data-gate]')!;
    const googleBtnHost = root.querySelector<HTMLElement>('[data-google-btn]')!;
    const gateError = root.querySelector<HTMLElement>('[data-gate-error]')!;

    const mediaStage = root.querySelector<HTMLElement>('[data-post-media]')!;
    const mediaLayers = [
      ...root.querySelectorAll<HTMLElement>('[data-media-layer]'),
    ].map(el => ({
      el,
      fill: el.querySelector<HTMLImageElement>('[data-media-fill]')!,
      img: el.querySelector<HTMLImageElement>('[data-media-img]')!,
      video: el.querySelector<HTMLVideoElement>('[data-media-video]')!,
    }));
    const mediaMuteBtn =
      root.querySelector<HTMLButtonElement>('[data-media-mute]')!;
    const slideCountEl = root.querySelector<HTMLElement>('[data-slide-count]')!;
    const stepBtns = [
      ...root.querySelectorAll<HTMLButtonElement>('[data-media-step]'),
    ];
    const postStepBtns = [
      ...root.querySelectorAll<HTMLButtonElement>('[data-post-step]'),
    ];
    const captionEl = root.querySelector<HTMLElement>('[data-post-caption]')!;

    let authenticated = false;

    let activePostIdx = 0;
    let activeMediaIdx = 0;
    let frontLayer = 0;
    let mediaTurn = 0;
    let slideCountTimer = 0;
    let videoMuted = false;

    const pauseAllVideos = () => {
      for (const l of mediaLayers) l.video.pause();
    };

    const flashSlideCount = () => {
      const post = posts[activePostIdx];
      if (!post || post.media.length <= 1) {
        clearTimeout(slideCountTimer);
        slideCountEl.classList.remove('is-shown');
        return;
      }
      slideCountEl.classList.add('is-shown');
      clearTimeout(slideCountTimer);
      slideCountTimer = window.setTimeout(() => {
        slideCountEl.classList.remove('is-shown');
      }, 1600);
    };

    const syncVisitorUI = () => {
      root.classList.toggle('is-locked', !authenticated);
      gridWrap.toggleAttribute('inert', !authenticated);
      detailWrap.toggleAttribute('inert', !authenticated);
      gateEl.toggleAttribute('inert', authenticated);
      if (!authenticated) {
        pauseAllVideos();
      }
    };

    const posterFor = (src: string) =>
      /\.mp4(\?|$)/.test(src) ? src.replace(/\.mp4(?=\?|$)/, '.jpg') : src;

    const captionOf = (post: EnrichedPost) =>
      post.caption[currentLang()] || post.caption.en;

    // Update the card's ambient scene light ("el blob") for the active image
    const syncSceneLight = () => {
      if (!cardEl) return;
      const post = posts[activePostIdx];
      const scene = post.scenes?.[activeMediaIdx] ?? post.scene;
      if (scene) cardEl.setAttribute('data-scene', scene);
    };

    const renderMedia = (showCounter = false) => {
      const post = posts[activePostIdx];
      const src = post.media[activeMediaIdx];
      const isVid = /\.mp4(\?|$)/.test(src);
      const poster = posterFor(src);

      syncSceneLight();

      const mine = ++mediaTurn;
      const back = mediaLayers[1 - frontLayer];
      const was = mediaLayers[frontLayer];

      back.fill.src = poster;
      if (isVid) {
        back.img.classList.add('is-hidden');
        back.video.classList.remove('is-hidden');
        if (back.video.getAttribute('src') !== src) {
          back.video.src = src;
        }
        back.video.muted = videoMuted;
        mediaMuteBtn.classList.remove('is-hidden');
        mediaMuteBtn.classList.toggle('is-unmuted', !videoMuted);
        if (!videoMuted) {
          document.dispatchEvent(new CustomEvent('media:solo'));
        }
        back.video.play().catch(() => {
          back.video.muted = true;
          mediaMuteBtn.classList.remove('is-unmuted');
          back.video.play().catch(() => {});
        });
      } else {
        back.video.pause();
        back.video.classList.add('is-hidden');
        mediaMuteBtn.classList.add('is-hidden');
        back.img.onload = null;
        back.img.src = src;
        back.img.alt = `${captionOf(post)} (${activeMediaIdx + 1}/${post.media.length})`;
        back.img.classList.remove('is-hidden');
      }

      let revealed = false;
      const reveal = () => {
        if (mine !== mediaTurn || revealed) return;
        revealed = true;
        was.el.classList.remove('is-on');
        back.el.classList.add('is-on');
        frontLayer = 1 - frontLayer;
        setTimeout(() => {
          if (mine === mediaTurn) was.video.pause();
        }, 250);
      };

      if (
        !was.el.classList.contains('is-on') ||
        isVid ||
        (back.img.complete && back.img.naturalWidth)
      ) {
        reveal();
      } else {
        back.img.onload = () => reveal();
        setTimeout(reveal, 1200);
      }

      const many = post.media.length > 1;
      slideCountEl.textContent = `${activeMediaIdx + 1}/${post.media.length}`;
      slideCountEl.classList.toggle('is-hidden', !many);
      if (showCounter) {
        flashSlideCount();
      } else {
        clearTimeout(slideCountTimer);
        slideCountEl.classList.remove('is-shown');
      }
      for (const btn of stepBtns) btn.classList.toggle('is-hidden', !many);
    };

    const renderPost = (idx: number) => {
      activePostIdx = ((idx % posts.length) + posts.length) % posts.length;
      activeMediaIdx = 0;
      const post = posts[activePostIdx];
      captionEl.textContent = captionOf(post);
      renderMedia();
    };

    const setView = (view: 'grid' | 'detail') => {
      const isGrid = view === 'grid';
      root.dataset.view = view;
      gridWrap.classList.toggle('is-hidden', !isGrid);
      detailWrap.classList.toggle('is-hidden', isGrid);
      for (const btn of viewBtns) {
        const on = btn.dataset.viewBtn === view;
        btn.classList.toggle('is-active', on);
        btn.setAttribute('aria-pressed', String(on));
      }
      if (isGrid) {
        pauseAllVideos();
        if (cardEl && posts[0]?.scene) {
          cardEl.setAttribute('data-scene', posts[0].scene);
        }
      } else {
        renderPost(activePostIdx);
      }
    };

    const syncLangStrings = () => {
      const post = posts[activePostIdx];
      if (post) captionEl.textContent = captionOf(post);
      for (const tile of root.querySelectorAll<HTMLButtonElement>('[data-open-post]')) {
        const p = posts[Number(tile.dataset.openPost ?? 0)];
        if (!p) continue;
        const cap = captionOf(p);
        tile.setAttribute('aria-label', cap);
        const img = tile.querySelector('img');
        if (img) img.alt = cap;
      }
      if (!authenticated) renderGoogleButton();
    };

    const mountGoogleAuth = async () => {
      if (!googleClientId) return;
      try {
        const accounts = await loadGsi();
        if (!accounts?.id) return;
        accounts.id.initialize({
          client_id: googleClientId,
          auto_select: false,
          cancel_on_tap_outside: true,
          callback: async res => {
            if (!res.credential) {
              gateError.classList.remove('is-hidden');
              return;
            }
            gateError.classList.add('is-hidden');
            try {
              const r = await fetch('/api/photos', {
                method: 'POST',
                credentials: 'same-origin',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  action: 'google',
                  credential: res.credential,
                }),
              });
              const data = (await r.json()) as {
                ok?: boolean;
                authenticated?: boolean;
              };
              if (r.ok && data.authenticated) {
                authenticated = true;
                syncVisitorUI();
                if (new URLSearchParams(location.search).get('view') === 'detail') {
                  setView('detail');
                }
              } else {
                gateError.classList.remove('is-hidden');
              }
            } catch {
              gateError.classList.remove('is-hidden');
            }
          },
        });
        renderGoogleButton();
      } catch {
        gateError.classList.remove('is-hidden');
      }
    };

    const renderGoogleButton = () => {
      const g = (window as unknown as { google?: GoogleAccounts }).google;
      if (!g?.accounts?.id) return;
      googleBtnHost.innerHTML = '';
      const lang = currentLang();
      g.accounts.id.renderButton(googleBtnHost, {
        type: 'standard',
        theme: 'filled_black',
        size: 'large',
        shape: 'pill',
        text: 'continue_with',
        locale: lang === 'zh' ? 'zh_CN' : lang,
      });
    };

    syncLangStrings();

    // Keep caption & Google button locale synced if language switches in-place
    new MutationObserver(syncLangStrings).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-lang'],
    });

    // Pause detail videos when the Photos card leaves the stage, the tab
    // hides, or narration starts.
    if (cardEl) {
      new MutationObserver(() => {
        if (!cardEl.classList.contains('is-current')) pauseAllVideos();
      }).observe(cardEl, { attributes: true, attributeFilter: ['class'] });
    }
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) pauseAllVideos();
    });
    document.addEventListener('narr:voice', pauseAllVideos);

    signOutBtn.addEventListener('click', async () => {
      authenticated = false;
      setView('grid');
      syncVisitorUI();
      try {
        (
          window as unknown as { google?: GoogleAccounts }
        ).google?.accounts?.id?.disableAutoSelect?.();
        await fetch('/api/photos', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'logout' }),
        });
      } catch {}
      mountGoogleAuth();
    });

    for (const btn of viewBtns) {
      btn.addEventListener('click', () => {
        if (!authenticated) return;
        setView(btn.dataset.viewBtn as 'grid' | 'detail');
      });
    }

    for (const tile of root.querySelectorAll<HTMLButtonElement>(
      '[data-open-post]',
    )) {
      tile.addEventListener('click', () => {
        if (!authenticated) return;
        activePostIdx = Number(tile.dataset.openPost ?? 0);
        setView('detail');
      });
    }

    for (const btn of stepBtns) {
      btn.addEventListener('click', () => {
        const post = posts[activePostIdx];
        const delta = Number(btn.dataset.mediaStep ?? 1);
        activeMediaIdx =
          ((activeMediaIdx + delta) % post.media.length + post.media.length) %
          post.media.length;
        renderMedia(true);
      });
    }

    // Touch swipe inside post media steps the post's carousel without turning
    // the outer PanelDeck.
    let touchStartX: number | null = null;
    let touchStartY: number | null = null;
    mediaStage.addEventListener(
      'touchstart',
      e => {
        if (e.touches.length === 1) {
          touchStartX = e.touches[0].clientX;
          touchStartY = e.touches[0].clientY;
          e.stopPropagation();
        }
      },
      { passive: true },
    );
    mediaStage.addEventListener(
      'touchend',
      e => {
        e.stopPropagation();
        if (touchStartX === null || touchStartY === null) return;
        const touch = e.changedTouches[0];
        const dx = touch.clientX - touchStartX;
        const dy = touch.clientY - touchStartY;
        touchStartX = null;
        touchStartY = null;
        const post = posts[activePostIdx];
        if (
          Math.abs(dx) > 36 &&
          Math.abs(dx) > Math.abs(dy) * 1.3 &&
          post.media.length > 1
        ) {
          const delta = dx < 0 ? 1 : -1;
          activeMediaIdx =
            ((activeMediaIdx + delta) % post.media.length + post.media.length) %
            post.media.length;
          renderMedia(true);
        }
      },
      { passive: true },
    );

    for (const btn of postStepBtns) {
      btn.addEventListener('click', () => {
        const delta = Number(btn.dataset.postStep ?? 1);
        renderPost(activePostIdx + delta);
      });
    }

    // Open full-screen PhotoViewer on click/tap of the media (desktop + mobile)
    mediaStage.addEventListener('click', e => {
      if ((e.target as HTMLElement).closest('button')) return;
      const post = posts[activePostIdx];
      if (!post?.media.length) return;
      pauseAllVideos();
      document.dispatchEvent(
        new CustomEvent('viewer:open', {
          detail: {
            items: post.media.map(src => ({
              src,
              name: captionOf(post),
              video: /\.mp4(\?|$)/.test(src) || undefined,
            })),
            at: activeMediaIdx,
          },
        }),
      );
    });

    mediaMuteBtn.addEventListener('click', () => {
      videoMuted = !videoMuted;
      for (const l of mediaLayers) l.video.muted = videoMuted;
      mediaMuteBtn.classList.toggle('is-unmuted', !videoMuted);
      if (!videoMuted) {
        document.dispatchEvent(new CustomEvent('media:solo'));
      }
    });

    syncVisitorUI();
    fetch('/api/photos', { credentials: 'same-origin' })
      .then(r => r.json())
      .then((data: { authenticated?: boolean }) => {
        authenticated = Boolean(data.authenticated);
        syncVisitorUI();
        if (
          authenticated &&
          new URLSearchParams(location.search).get('view') === 'detail'
        ) {
          setView('detail');
        } else if (!authenticated) {
          mountGoogleAuth();
        }
      })
      .catch(() => {
        mountGoogleAuth();
      });
  }
</script>
