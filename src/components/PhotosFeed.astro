---
import T from './T.astro';
import { PHOTO_POSTS, posterOf } from '../lib/photos';
import { sceneAttr, sceneOf } from '../lib/scene';

/**
 * THE PHOTOS CARD'S SCREEN (MoreOfMe) — Juan's personal Instagram feed inside
 * juanevillam.com (/more-of-me/photos).
 *
 * Shares the same two-column PanelDeck layout as Cosmos and Songs (title,
 * subtitle, scrollable text, and narrator on the left; this interactive 3:2
 * screen on the right).
 *
 * Every image in every post computes its own ambient scene palette (`scenes`)
 * at build time so stepping through a post's carousel updates the room light
 * ("el blob") to match the exact photo on screen.
 */
const isDev = import.meta.env.DEV;
const posts = await Promise.all(
  PHOTO_POSTS.map(async post => {
    const cover = posterOf(post.media[0]);
    const scenes = await Promise.all(
      post.media.map(async m => sceneAttr(await sceneOf(posterOf(m)))),
    );
    return {
      ...post,
      cover,
      scene: scenes[0],
      scenes,
    };
  }),
);

const totalInitialLikes = posts.reduce((sum, p) => sum + p.initialLikes, 0);
---

<div
  class:list={['photos', !isDev && 'is-locked']}
  data-photos
  data-dev={isDev ? 'true' : undefined}
  data-posts={JSON.stringify(posts)}
>
  <!-- Profile header -->
  <header class="ig-head">
    <div class="ig-ident">
      <div class="ig-avatar" aria-hidden="true">
        <span>jv</span>
      </div>
      <div class="ig-handle-row">
        <span class="ig-handle">juanevillam</span>
        <span class="ig-stats">
          <strong data-total-posts>{posts.length}</strong>
          <T k="photos.posts" />
          <span class="ig-dot">·</span>
          <strong data-total-likes>{totalInitialLikes}</strong>
          <T k="photos.likes" />
        </span>
      </div>
    </div>

    <div class="ig-actions">
      <div class="view-switch" role="group" aria-label="View mode">
        <button
          type="button"
          class="circle-btn is-active"
          data-view-btn="grid"
          aria-pressed="true"
        >
          <svg viewBox="0 0 18 18" width="14" height="14" aria-hidden="true">
            <rect x="2" y="2" width="5.5" height="5.5" rx="1" fill="none" stroke="currentColor" stroke-width="1.5" />
            <rect x="10.5" y="2" width="5.5" height="5.5" rx="1" fill="none" stroke="currentColor" stroke-width="1.5" />
            <rect x="2" y="10.5" width="5.5" height="5.5" rx="1" fill="none" stroke="currentColor" stroke-width="1.5" />
            <rect x="10.5" y="10.5" width="5.5" height="5.5" rx="1" fill="none" stroke="currentColor" stroke-width="1.5" />
          </svg>
          <span class="sr"><T k="photos.grid" /></span>
        </button>
        <button
          type="button"
          class="circle-btn"
          data-view-btn="detail"
          aria-pressed="false"
        >
          <svg viewBox="0 0 18 18" width="14" height="14" aria-hidden="true">
            <rect x="2.5" y="2.5" width="13" height="8.5" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.5" />
            <path d="M2.5 14.5h13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          </svg>
          <span class="sr"><T k="photos.feed" /></span>
        </button>
      </div>
    </div>
  </header>

  <div class="ig-body">
    <!-- 3-column Instagram grid -->
    <div class="ig-grid-wrap" data-panel-view="grid">
      <div class="ig-grid">
        {
          posts.map((post, idx) => {
            const hasVideo = post.media.some(m => m.endsWith('.mp4'));
            const isMulti = post.media.length > 1;
            return (
              <button
                type="button"
                class="ig-tile"
                data-open-post={idx}
                aria-label={post.location}
              >
                <img
                  src={post.cover}
                  alt={post.location}
                  loading="lazy"
                  decoding="async"
                  draggable="false"
                />
                {(isMulti || hasVideo) && (
                  <span class="tile-badge" aria-hidden="true">
                    {hasVideo ? (
                      <svg viewBox="0 0 20 20" width="18" height="18">
                        <path
                          d="M5.5 3.8v12.4a1 1 0 0 0 1.53.85l9.7-6.2a1 1 0 0 0 0-1.7l-9.7-6.2A1 1 0 0 0 5.5 3.8Z"
                          fill="currentColor"
                        />
                      </svg>
                    ) : (
                      /* Instagram-style filled stacked squares icon */
                      <svg viewBox="0 0 22 22" width="18" height="18">
                        <rect
                          x="2"
                          y="5.5"
                          width="13.5"
                          height="13.5"
                          rx="2.6"
                          fill="currentColor"
                        />
                        <path
                          d="M7.5 2h9.4A3.1 3.1 0 0 1 20 5.1v9.4a1 1 0 0 1-2 0V5.3a1.3 1.3 0 0 0-1.3-1.3H7.5a1 1 0 0 1 0-2Z"
                          fill="currentColor"
                        />
                      </svg>
                    )}
                  </span>
                )}
                <span class="tile-hover" aria-hidden="true">
                  <span class="tile-stat">
                    <svg viewBox="0 0 20 20" width="18" height="18">
                      <path
                        d="M10 17.2s-6.8-4.2-6.8-8.9A4 4 0 0 1 10 5.5a4 4 0 0 1 6.8 2.8c0 4.7-6.8 8.9-6.8 8.9Z"
                        fill="currentColor"
                      />
                    </svg>
                    <span data-tile-likes={post.id}>{post.initialLikes}</span>
                  </span>
                  <span class="tile-stat">
                    <svg viewBox="0 0 20 20" width="18" height="18">
                      <path
                        d="M10 2.5a7.3 7.3 0 0 0-6.2 11.1L2.8 17.5l3.9-1A7.3 7.3 0 1 0 10 2.5Z"
                        fill="currentColor"
                      />
                    </svg>
                    <span data-tile-comments={post.id}>
                      {post.initialComments.length}
                    </span>
                  </span>
                </span>
              </button>
            );
          })
        }
      </div>
    </div>

    <!-- Single post detail view -->
    <div class="ig-detail is-hidden" data-panel-view="detail">
      <div class="post-stage">
        <div class="post-media" data-post-media>
          <img
            class="media-fill"
            data-media-fill
            alt=""
            decoding="async"
            draggable="false"
          />
          <img
            class="media-main"
            data-media-img
            alt=""
            decoding="async"
            draggable="false"
          />
          <video
            class="media-main is-hidden"
            data-media-video
            playsinline
            loop
            preload="metadata"
          ></video>

          <!-- Floating hearts container (spawns where user clicks/taps) -->
          <div class="hearts-layer" data-hearts-layer aria-hidden="true"></div>

          <span class="slide-count" data-slide-count>1 / 1</span>

          <button
            type="button"
            class="media-step prev"
            data-media-step="-1"
            aria-label="Previous photo"
          >
            <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true">
              <path
                d="M10 3 L5 8 L10 13"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </button>
          <button
            type="button"
            class="media-step next"
            data-media-step="1"
            aria-label="Next photo"
          >
            <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true">
              <path
                d="M6 3 L11 8 L6 13"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </button>

          <button
            type="button"
            class="circle-btn media-mute is-unmuted is-hidden"
            data-media-mute
          >
            <svg
              class="icon-muted"
              viewBox="0 0 16 16"
              width="13"
              height="13"
              aria-hidden="true"
            >
              <path
                d="M2.5 6.2h2.6l3.4-2.8v9.2l-3.4-2.8H2.5V6.2Zm8.2 0 3.6 3.6m0-3.6-3.6 3.6"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
            <svg
              class="icon-unmuted"
              viewBox="0 0 16 16"
              width="13"
              height="13"
              aria-hidden="true"
            >
              <path
                d="M2.5 6.2h2.6l3.4-2.8v9.2l-3.4-2.8H2.5V6.2Zm8.3-.7a3.6 3.6 0 0 1 0 5m1.8-6.8a6 6 0 0 1 0 8.6"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
            <span class="sr"><T k="photos.mute" /></span>
          </button>
        </div>

        <!-- Post right column: location + post switcher, comments, single bottom bar -->
        <div class="post-side">
          <div class="post-head">
            <span class="post-loc" data-post-location></span>
            <div class="post-nav-pills">
              <button
                type="button"
                class="circle-btn"
                data-post-step="-1"
                aria-label="Previous post"
              >
                <svg viewBox="0 0 16 16" width="11" height="11" aria-hidden="true">
                  <path
                    d="M10 3.2 5.2 8l4.8 4.8"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </button>
              <button
                type="button"
                class="circle-btn"
                data-post-step="1"
                aria-label="Next post"
              >
                <svg viewBox="0 0 16 16" width="11" height="11" aria-hidden="true">
                  <path
                    d="M6 3.2 10.8 8 6 12.8"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </button>
            </div>
          </div>

          <div class="post-scroll" data-post-scroll>
            <ul class="comments-list" data-comments-list></ul>
            <p class="no-comments" data-no-comments>
              <T k="photos.noComments" />
            </p>
          </div>

          <!-- Single compact row: [♥ count] [💬 count] [Add a comment… (↑)] -->
          <div class="post-foot">
            <button
              type="button"
              class="action-stat like-btn"
              data-like-btn
              aria-pressed="false"
            >
              <span class="circle-glyph">
                <svg viewBox="0 0 20 20" width="15" height="15" aria-hidden="true">
                  <path
                    d="M10 17.2s-6.8-4.2-6.8-8.9A4 4 0 0 1 10 5.5a4 4 0 0 1 6.8 2.8c0 4.7-6.8 8.9-6.8 8.9Z"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.65"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
              <span class="stat-num" data-post-likes>0</span>
              <span class="sr"><T k="photos.like" /></span>
            </button>

            <button
              type="button"
              class="action-stat comment-focus-btn"
              data-comment-focus
            >
              <span class="circle-glyph">
                <svg viewBox="0 0 20 20" width="15" height="15" aria-hidden="true">
                  <path
                    d="M10 2.8a7.2 7.2 0 0 0-6.1 11L2.9 17.4l3.7-1A7.2 7.2 0 1 0 10 2.8Z"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.65"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
              <span class="stat-num" data-post-comments-count>0</span>
              <span class="sr"><T k="photos.comment" /></span>
            </button>

            <form class="comment-form" data-comment-form novalidate>
              <input
                type="text"
                class="comment-input"
                data-comment-input
                maxlength="300"
                placeholder="Add a comment…"
                required
              />
              <button
                type="submit"
                class="comment-send"
                data-comment-send
                aria-label="Post comment"
              >
                <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true">
                  <path
                    d="M8 12.5V3.5M4.2 7.2 8 3.4l3.8 3.8"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>

    <!-- Tonal Liquid Glass Gate (Name + Email, production only) -->
    <div class="ig-gate" data-gate>
      <form class="gate-card" data-gate-form novalidate>
        <div class="gate-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="20" height="20">
            <rect
              x="4.5"
              y="10.5"
              width="15"
              height="10"
              rx="2.5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
            />
            <path
              d="M8 10.5V7.5a4 4 0 0 1 8 0v3"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
            />
          </svg>
        </div>
        <h4 class="gate-title"><T k="photos.gateTitle" /></h4>
        <p class="gate-desc"><T k="photos.gateBody" /></p>

        <!-- Honeypot anti-bot field -->
        <input
          type="text"
          name="website"
          class="sr"
          tabindex="-1"
          autocomplete="off"
        />

        <div class="gate-fields">
          <input
            type="text"
            name="name"
            class="gate-input"
            data-gate-name
            placeholder="Name"
            autocomplete="name"
            maxlength="80"
            required
          />
          <input
            type="email"
            name="email"
            class="gate-input"
            data-gate-email
            placeholder="you@email.com"
            autocomplete="email"
            maxlength="160"
            required
          />
        </div>

        <p class="gate-error is-hidden" data-gate-error>
          <T k="photos.gateError" />
        </p>

        <button type="submit" class="pill-btn gate-submit">
          <T k="photos.gateContinue" />
        </button>
      </form>
    </div>
  </div>
</div>

<style>
  .photos {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    background: var(--ground);
    color: var(--ink);
    overflow: hidden;
    user-select: none;
  }

  /* ---------- header ---------- */
  .ig-head {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.625rem 0.875rem;
    border-bottom: 1px solid var(--hairline);
    background: color-mix(in srgb, var(--surface) 86%, transparent);
    backdrop-filter: blur(16px) saturate(1.8);
    -webkit-backdrop-filter: blur(16px) saturate(1.8);
    z-index: 3;
  }

  .ig-ident {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-width: 0;
  }

  .ig-avatar {
    flex: none;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    border: 1px solid var(--hairline);
    background: var(--surface);
    box-shadow: inset 0 0.75px 0 rgb(255 255 255 / 0.16);
    display: grid;
    place-items: center;
    font-weight: 800;
    font-size: 0.8125rem;
    letter-spacing: -0.04em;
    color: var(--ink);
  }

  .ig-handle-row {
    display: flex;
    align-items: baseline;
    gap: 0.625rem;
    flex-wrap: wrap;
  }

  .ig-handle {
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .ig-stats {
    font-size: 0.75rem;
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .ig-stats strong {
    color: var(--ink);
    font-weight: 600;
  }

  .ig-dot {
    margin: 0 0.25rem;
    color: var(--ink-3);
  }

  .ig-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .view-switch {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  /* Lone glyph controls: circle (50%) + scale(0.90) active squash */
  .circle-btn {
    width: 1.875rem;
    height: 1.875rem;
    padding: 0;
    border-radius: 50%;
    border: 1px solid var(--hairline);
    background: color-mix(in srgb, var(--surface) 82%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: var(--ink-2);
    display: grid;
    place-items: center;
    cursor: pointer;
    transition:
      color var(--hover),
      border-color var(--hover),
      background-color var(--hover),
      transform var(--dur-micro) var(--ease),
      opacity var(--dur-quick) var(--ease);
  }

  .circle-btn:hover,
  .circle-btn.is-active {
    color: var(--ink);
    border-color: var(--ink-3);
  }

  .circle-btn.is-active {
    background: color-mix(in srgb, var(--ink) 14%, var(--surface));
  }

  .circle-btn:active {
    transform: scale(0.9);
  }

  .pill-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    height: 2rem;
    padding: 0 0.875rem;
    border-radius: 999px;
    border: 1px solid var(--hairline);
    background: color-mix(in srgb, var(--surface) 84%, transparent);
    backdrop-filter: blur(14px) saturate(1.8);
    -webkit-backdrop-filter: blur(14px) saturate(1.8);
    box-shadow: inset 0 0.75px 0 rgb(255 255 255 / 0.16);
    color: var(--ink);
    font: inherit;
    font-size: 0.75rem;
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;
    transition:
      border-color var(--hover),
      background-color var(--hover),
      transform var(--dur-micro) var(--ease),
      opacity var(--dur-quick) var(--ease);
  }

  .pill-btn:hover {
    border-color: var(--ink-3);
  }

  .pill-btn:active {
    transform: scale(0.96);
  }

  /* ---------- body & 3-column grid ---------- */
  .ig-body {
    position: relative;
    flex: 1;
    min-height: 0;
    display: grid;
  }

  .ig-grid-wrap,
  .ig-detail {
    grid-area: 1 / 1;
    min-height: 0;
    transition: opacity var(--dur-quick) var(--ease);
  }

  .ig-grid-wrap.is-hidden,
  .ig-detail.is-hidden {
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
  }

  .ig-grid-wrap {
    overflow-y: auto;
    scrollbar-width: thin;
    padding: 2px;
  }

  .ig-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2px;
  }

  .ig-tile {
    position: relative;
    aspect-ratio: 1 / 1;
    padding: 0;
    border: 0;
    background: var(--surface);
    overflow: hidden;
    cursor: pointer;
    transition: transform var(--dur-micro) var(--ease);
  }

  .ig-tile:active {
    transform: scale(0.98);
  }

  .ig-tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition:
      transform var(--dur-turn) var(--ease),
      filter var(--dur-turn) var(--ease);
  }

  .photos.is-locked .ig-tile img {
    filter: blur(10px) brightness(0.65);
    transform: scale(1.08);
  }

  .ig-tile:hover img {
    transform: scale(1.03);
  }

  .tile-badge {
    position: absolute;
    top: 0.55rem;
    right: 0.55rem;
    color: #fff;
    filter: drop-shadow(0 1px 4px rgb(0 0 0 / 0.72));
    pointer-events: none;
  }

  .tile-hover {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    background: rgb(0 0 0 / 0.52);
    color: var(--ink);
    font-size: 1rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    opacity: 0;
    transition: opacity var(--hover);
  }

  .ig-tile:hover .tile-hover,
  .ig-tile:focus-visible .tile-hover {
    opacity: 1;
  }

  .tile-stat {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    white-space: nowrap;
  }

  /* ---------- post detail view ---------- */
  .ig-detail {
    display: flex;
    min-height: 0;
  }

  .post-stage {
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-columns: 1.22fr 1fr;
    background: var(--ground);
  }

  .post-media {
    position: relative;
    background: var(--ground);
    overflow: hidden;
    display: grid;
    place-items: center;
    border-right: 1px solid var(--hairline);
  }

  .media-fill,
  .media-main {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .media-fill {
    object-fit: cover;
    transform: scale(1.18);
    filter: blur(26px) brightness(0.48);
  }

  .media-main {
    object-fit: contain;
    transition: opacity var(--dur-settle) linear;
  }

  .media-main.is-hidden {
    opacity: 0;
    pointer-events: none;
  }

  .slide-count {
    position: absolute;
    top: 0.625rem;
    right: 0.625rem;
    z-index: 2;
    padding: 0.25rem 0.625rem;
    border-radius: 999px;
    border: 1px solid var(--hairline);
    background: color-mix(in srgb, var(--surface) 82%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    color: var(--ink);
  }

  /* Same muted arrow recipe as Events / PanelDeck `.photo-step`:
     0.3 at rest, 0.7 when hovering the photo frame, 1 on the arrow itself. */
  .media-step {
    position: absolute;
    top: 50%;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface) 82%, transparent);
    color: var(--ink);
    cursor: pointer;
    opacity: 0.3;
    transform: translateY(-50%);
    transition:
      opacity var(--hover),
      border-color var(--hover),
      transform var(--dur-micro) var(--ease);
  }

  .post-media:hover .media-step {
    opacity: 0.7;
  }

  .post-media .media-step:hover,
  .media-step:focus-visible {
    opacity: 1;
    border-color: var(--ink-3);
  }

  .media-step:active {
