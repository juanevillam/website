    color: var(--ground);
    border-color: var(--ink);
    font-weight: 700;
  }

  .gate-submit:hover {
    opacity: 0.92;
  }

  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  @media (max-width: 48rem) {
    :global(.screen.is-own:has(> [data-photos]) > .screen-caption) {
      display: none;
    }

    .ig-head {
      padding: 0.5rem 0.75rem;
    }

    .post-stage {
      grid-template-columns: 1fr;
      grid-template-rows: 1.2fr 1fr;
    }

    .post-media {
      border-right: 0;
      border-bottom: 1px solid var(--hairline);
    }

    .post-head {
      padding: 0.4rem 0.75rem;
    }

    .post-scroll {
      padding: 0.45rem 0.75rem;
    }

    .post-foot {
      padding: 0.45rem 0.625rem;
    }
  }
</style>

<script>
  import type { PhotoComment, PhotoPost } from '../lib/photos';

  type EnrichedComment = PhotoComment & { canDelete?: boolean };
  type EnrichedPost = PhotoPost & {
    cover: string;
    scene?: string;
    scenes?: string[];
  };
  type Visitor = { name: string; email: string; token: string };

  const VISITOR_KEY = 'jv:photos:visitor';
  const LOCAL_STATE_KEY = 'jv:photos:state';

  const makeToken = () =>
    typeof crypto !== 'undefined' && 'randomUUID' in crypto
      ? crypto.randomUUID()
      : `${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 10)}`;

  // Compact Instagram-style relative timestamp (`now`, `2m`, `3h`, `4d`, `17 Nov`)
  const formatRelativeTime = (iso: string) => {
    const time = Date.parse(iso);
    if (Number.isNaN(time)) return '';
    const diffSec = Math.max(0, Math.floor((Date.now() - time) / 1000));
    if (diffSec < 45) return 'now';
    const min = Math.floor(diffSec / 60);
    if (min < 60) return `${min}m`;
    const hr = Math.floor(min / 60);
    if (hr < 24) return `${hr}h`;
    const days = Math.floor(hr / 24);
    if (days < 14) return `${days}d`;
    const lang = document.documentElement.dataset.lang || 'en';
    return new Intl.DateTimeFormat(lang, {
      month: 'short',
      day: 'numeric',
    }).format(new Date(time));
  };

  for (const root of document.querySelectorAll<HTMLElement>('[data-photos]')) {
    const posts: EnrichedPost[] = JSON.parse(root.dataset.posts ?? '[]');
    if (!posts.length) continue;

    const isDev = root.dataset.dev === 'true';
    const cardEl = root.closest<HTMLElement>('.deck-card');
    const gridWrap = root.querySelector<HTMLElement>('[data-panel-view="grid"]')!;
    const detailWrap = root.querySelector<HTMLElement>('[data-panel-view="detail"]')!;
    const viewBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-view-btn]')];
    const totalLikesEl = root.querySelector<HTMLElement>('[data-total-likes]')!;

    const gateForm = root.querySelector<HTMLFormElement>('[data-gate-form]')!;
    const gateName = root.querySelector<HTMLInputElement>('[data-gate-name]')!;
    const gateEmail = root.querySelector<HTMLInputElement>('[data-gate-email]')!;
    const gateError = root.querySelector<HTMLElement>('[data-gate-error]')!;

    const mediaStage = root.querySelector<HTMLElement>('[data-post-media]')!;
    const mediaFill = root.querySelector<HTMLImageElement>('[data-media-fill]')!;
    const mediaImg = root.querySelector<HTMLImageElement>('[data-media-img]')!;
    const mediaVideo = root.querySelector<HTMLVideoElement>('[data-media-video]')!;
    const mediaMuteBtn = root.querySelector<HTMLButtonElement>('[data-media-mute]')!;
    const slideCountEl = root.querySelector<HTMLElement>('[data-slide-count]')!;
    const stepBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-media-step]')];
    const postStepBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-post-step]')];
    const heartsLayer = root.querySelector<HTMLElement>('[data-hearts-layer]')!;

    const locEl = root.querySelector<HTMLElement>('[data-post-location]')!;
    const commentsListEl = root.querySelector<HTMLUListElement>('[data-comments-list]')!;
    const noCommentsEl = root.querySelector<HTMLElement>('[data-no-comments]')!;
    const likeBtn = root.querySelector<HTMLButtonElement>('[data-like-btn]')!;
    const postLikesEl = root.querySelector<HTMLElement>('[data-post-likes]')!;
    const postCommentsCountEl = root.querySelector<HTMLElement>('[data-post-comments-count]')!;
    const commentFocusBtn = root.querySelector<HTMLButtonElement>('[data-comment-focus]')!;
    const commentForm = root.querySelector<HTMLFormElement>('[data-comment-form]')!;
    const commentInput = root.querySelector<HTMLInputElement>('[data-comment-input]')!;

    let visitor: Visitor | null = isDev
      ? {
          name: 'Juan Villa',
          email: 'juanesvillamendoza@gmail.com',
          token: 'dev-owner-token',
        }
      : null;
    try {
      const saved = localStorage.getItem(VISITOR_KEY);
      if (saved) {
        const parsed = JSON.parse(saved);
        if (parsed?.name && parsed?.email) {
          visitor = {
            name: parsed.name,
            email: parsed.email,
            token: parsed.token || makeToken(),
          };
          localStorage.setItem(VISITOR_KEY, JSON.stringify(visitor));
        }
      }
    } catch {}

    const likeCounts: Record<string, number> = {};
    const likedByMe: Record<string, boolean> = {};
    const commentsByPost: Record<string, EnrichedComment[]> = {};
    for (const p of posts) {
      likeCounts[p.id] = p.initialLikes;
      likedByMe[p.id] = false;
      commentsByPost[p.id] = [...p.initialComments];
    }

    try {
      const cached = JSON.parse(localStorage.getItem(LOCAL_STATE_KEY) ?? '{}');
      for (const [id, count] of Object.entries(cached.likeCounts ?? {})) {
        if (typeof count === 'number') likeCounts[id] = count;
      }
      for (const [id, liked] of Object.entries(cached.likedByMe ?? {})) {
        likedByMe[id] = Boolean(liked);
      }
      for (const [id, list] of Object.entries(cached.comments ?? {})) {
        if (Array.isArray(list) && posts.some(p => p.id === id)) {
          commentsByPost[id] = list as EnrichedComment[];
        }
      }
    } catch {}

    const saveLocalState = () => {
      try {
        localStorage.setItem(
          LOCAL_STATE_KEY,
          JSON.stringify({
            likeCounts,
            likedByMe,
            comments: commentsByPost,
          }),
        );
      } catch {}
    };

    let activePostIdx = 0;
    let activeMediaIdx = 0;
    let videoMuted = false;

    const syncTotalsAndTiles = () => {
      let total = 0;
      for (const p of posts) {
        const c = likeCounts[p.id] ?? p.initialLikes;
        total += c;
        const tileLikes = root.querySelector<HTMLElement>(
          `[data-tile-likes="${p.id}"]`,
        );
        if (tileLikes) tileLikes.textContent = String(c);
        const tileComments = root.querySelector<HTMLElement>(
          `[data-tile-comments="${p.id}"]`,
        );
        if (tileComments)
          tileComments.textContent = String(commentsByPost[p.id]?.length ?? 0);
      }
      totalLikesEl.textContent = String(total);
    };

    const syncVisitorUI = () => {
      const unlocked = Boolean(visitor?.name && visitor?.email);
      root.classList.toggle('is-locked', !unlocked);
      if (!unlocked) {
        mediaVideo.pause();
      }
    };

    const posterFor = (src: string) =>
      src.endsWith('.mp4') ? src.replace(/\.mp4$/, '.jpg') : src;

    // Update the card's ambient scene light ("el blob") for the active image
    const syncSceneLight = () => {
      if (!cardEl) return;
      const post = posts[activePostIdx];
      const scene = post.scenes?.[activeMediaIdx] ?? post.scene;
      if (scene) cardEl.setAttribute('data-scene', scene);
    };

    const renderMedia = () => {
      const post = posts[activePostIdx];
      const src = post.media[activeMediaIdx];
      const isVid = src.endsWith('.mp4');
      const poster = posterFor(src);

      syncSceneLight();
      mediaFill.src = poster;
      if (isVid) {
        mediaImg.classList.add('is-hidden');
        mediaVideo.classList.remove('is-hidden');
        if (mediaVideo.getAttribute('src') !== src) {
          mediaVideo.src = src;
        }
        mediaVideo.muted = videoMuted;
        mediaMuteBtn.classList.remove('is-hidden');
        mediaMuteBtn.classList.toggle('is-unmuted', !videoMuted);
        mediaVideo.play().catch(() => {
          mediaVideo.muted = true;
          mediaMuteBtn.classList.remove('is-unmuted');
          mediaVideo.play().catch(() => {});
        });
      } else {
        mediaVideo.pause();
        mediaVideo.classList.add('is-hidden');
        mediaMuteBtn.classList.add('is-hidden');
        mediaImg.src = src;
        mediaImg.alt = `${post.location} (${activeMediaIdx + 1}/${post.media.length})`;
        mediaImg.classList.remove('is-hidden');
      }

      const many = post.media.length > 1;
      slideCountEl.textContent = `${activeMediaIdx + 1} / ${post.media.length}`;
      slideCountEl.classList.toggle('is-hidden', !many);
      for (const btn of stepBtns) btn.classList.toggle('is-hidden', !many);
    };

    const deleteComment = (post: EnrichedPost, commentId: string) => {
      commentsByPost[post.id] = (commentsByPost[post.id] ?? []).filter(
        c => c.id !== commentId,
      );
      saveLocalState();
      renderComments(post);
      syncTotalsAndTiles();

      fetch('/api/photos', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          action: 'deleteComment',
          postId: post.id,
          commentId,
          email: visitor?.email ?? '',
          token: visitor?.token ?? '',
        }),
      }).catch(() => {});
    };

    const renderComments = (post: EnrichedPost) => {
      const list = commentsByPost[post.id] ?? [];
      commentsListEl.innerHTML = '';
      for (const c of list) {
        const li = document.createElement('li');
        const body = document.createElement('span');
        body.className = 'c-body';
        const author = document.createElement('strong');
        author.textContent = c.author;
        const text = document.createElement('span');
        text.textContent = c.text;
        body.append(author, text);

        const meta = document.createElement('span');
        meta.className = 'c-meta';
        const date = document.createElement('span');
        date.className = 'c-date';
        date.textContent = formatRelativeTime(c.createdAt);
        meta.append(date);

        if (isDev || c.canDelete) {
          const del = document.createElement('button');
          del.type = 'button';
          del.className = 'c-del';
          del.setAttribute('aria-label', 'Delete comment');
          del.innerHTML = `<svg viewBox="0 0 12 12" width="9" height="9" aria-hidden="true"><path d="M2.5 2.5l7 7M9.5 2.5l-7 7" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>`;
          del.addEventListener('click', () => deleteComment(post, c.id));
          meta.append(del);
        }

        li.append(body, meta);
        commentsListEl.append(li);
      }
      noCommentsEl.classList.toggle('is-hidden', list.length > 0);
      postCommentsCountEl.textContent = String(list.length);
    };

    const renderPost = (idx: number) => {
      activePostIdx = ((idx % posts.length) + posts.length) % posts.length;
      activeMediaIdx = 0;
      const post = posts[activePostIdx];

      locEl.textContent = post.location;

      const liked = Boolean(likedByMe[post.id]);
      likeBtn.classList.toggle('is-liked', liked);
      likeBtn.setAttribute('aria-pressed', String(liked));
      postLikesEl.textContent = String(likeCounts[post.id] ?? post.initialLikes);

      renderComments(post);
      renderMedia();
    };

    const setView = (view: 'grid' | 'detail') => {
      const isGrid = view === 'grid';
      gridWrap.classList.toggle('is-hidden', !isGrid);
      detailWrap.classList.toggle('is-hidden', isGrid);
      for (const btn of viewBtns) {
        const on = btn.dataset.viewBtn === view;
        btn.classList.toggle('is-active', on);
        btn.setAttribute('aria-pressed', String(on));
      }
      if (isGrid) {
        mediaVideo.pause();
        if (cardEl && posts[0]?.scene) {
          cardEl.setAttribute('data-scene', posts[0].scene);
        }
      } else {
        renderPost(activePostIdx);
      }
    };

    const hydrateFromServer = () => {
      const params = new URLSearchParams();
      if (visitor?.email) params.set('email', visitor.email);
      if (visitor?.token) params.set('token', visitor.token);
      fetch(`/api/photos?${params.toString()}`)
        .then(r => r.json())
        .then(data => {
          if (!data?.ok) return;
          for (const p of posts) {
            const serverLikes = Number(data.likeCounts?.[p.id] ?? 0);
            likeCounts[p.id] = p.initialLikes + serverLikes;
            likedByMe[p.id] = Boolean(data.likedByMe?.[p.id]);
            if (Array.isArray(data.comments?.[p.id])) {
              commentsByPost[p.id] = data.comments[p.id];
            }
          }
          saveLocalState();
          syncTotalsAndTiles();
          if (!detailWrap.classList.contains('is-hidden')) {
            renderPost(activePostIdx);
          }
        })
        .catch(() => {});
    };

    hydrateFromServer();

    // Spawn a floating monochrome heart at (clientX, clientY) inside mediaStage
    const spawnHeartAt = (clientX?: number, clientY?: number) => {
      const rect = mediaStage.getBoundingClientRect();
      const x =
        clientX !== undefined ? clientX - rect.left : rect.width / 2;
      const y =
        clientY !== undefined ? clientY - rect.top : rect.height - 36;
      const rot = (Math.random() * 32 - 16).toFixed(1);
      const dx = (Math.random() * 28 - 14).toFixed(1);

      const el = document.createElement('div');
      el.className = 'pop-heart';
      el.style.left = `${x}px`;
      el.style.top = `${y}px`;
      el.style.setProperty('--rot', `${rot}deg`);
      el.style.setProperty('--dx', `${dx}px`);
      el.innerHTML = `<svg viewBox="0 0 24 24" width="52" height="52"><path d="M12 20.5s-8.2-5.1-8.2-10.8A4.8 4.8 0 0 1 12 6.4a4.8 4.8 0 0 1 8.2 3.3c0 5.7-8.2 10.8-8.2 10.8Z" fill="currentColor"/></svg>`;
      heartsLayer.append(el);
      el.addEventListener('animationend', () => el.remove(), { once: true });
    };

    // Gate unlock submit
    gateForm.addEventListener('submit', e => {
      e.preventDefault();
      const fd = new FormData(gateForm);
      const website = String(fd.get('website') ?? '').trim();
      const name = gateName.value.trim();
      const email = gateEmail.value.trim().toLowerCase();
      const valid =
        name.length >= 2 && /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email);

      if (!valid) {
        gateError.classList.remove('is-hidden');
        return;
      }
      gateError.classList.add('is-hidden');
      visitor = { name, email, token: visitor?.token || makeToken() };
      try {
        localStorage.setItem(VISITOR_KEY, JSON.stringify(visitor));
      } catch {}
      syncVisitorUI();

      fetch('/api/photos', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          action: 'unlock',
          name,
          email,
          token: visitor.token,
          website,
        }),
      })
        .then(() => hydrateFromServer())
        .catch(() => {});
    });

    for (const btn of viewBtns) {
      btn.addEventListener('click', () => {
        if (!visitor) return;
        setView(btn.dataset.viewBtn as 'grid' | 'detail');
      });
    }

    for (const tile of root.querySelectorAll<HTMLButtonElement>('[data-open-post]')) {
      tile.addEventListener('click', () => {
        if (!visitor) {
          gateName.focus();
          return;
        }
        activePostIdx = Number(tile.dataset.openPost ?? 0);
        setView('detail');
      });
    }

    for (const btn of stepBtns) {
      btn.addEventListener('click', () => {
        const post = posts[activePostIdx];
        const delta = Number(btn.dataset.mediaStep ?? 1);
        activeMediaIdx =
          ((activeMediaIdx + delta) % post.media.length + post.media.length) %
          post.media.length;
        renderMedia();
      });
    }

    // Touch swipe inside post media steps the post's carousel without turning
    // the outer PanelDeck.
    let touchStartX: number | null = null;
    mediaStage.addEventListener(
      'touchstart',
      e => {
        if (e.touches.length === 1) {
          touchStartX = e.touches[0].clientX;
          e.stopPropagation();
        }
      },
      { passive: true },
    );
    mediaStage.addEventListener(
      'touchend',
      e => {
        e.stopPropagation();
        if (touchStartX === null) return;
        const dx = e.changedTouches[0].clientX - touchStartX;
        touchStartX = null;
        const post = posts[activePostIdx];
        if (Math.abs(dx) > 36 && post.media.length > 1) {
          const delta = dx < 0 ? 1 : -1;
          activeMediaIdx =
            ((activeMediaIdx + delta) % post.media.length + post.media.length) %
            post.media.length;
          renderMedia();
        }
      },
      { passive: true },
    );

    for (const btn of postStepBtns) {
      btn.addEventListener('click', () => {
        const delta = Number(btn.dataset.postStep ?? 1);
        renderPost(activePostIdx + delta);
      });
    }

    mediaMuteBtn.addEventListener('click', () => {
      videoMuted = !videoMuted;
      mediaVideo.muted = videoMuted;
      mediaMuteBtn.classList.toggle('is-unmuted', !videoMuted);
    });

    const triggerLike = (
      forceLike?: boolean,
      clientX?: number,
      clientY?: number,
    ) => {
      if (!visitor) {
        gateName.focus();
        return;
      }
      const post = posts[activePostIdx];
      const currentlyLiked = Boolean(likedByMe[post.id]);
      const nextLiked = forceLike !== undefined ? forceLike : !currentlyLiked;

      if (nextLiked && !currentlyLiked) {
        likeCounts[post.id] = (likeCounts[post.id] ?? post.initialLikes) + 1;
      } else if (!nextLiked && currentlyLiked) {
        likeCounts[post.id] = Math.max(
          0,
          (likeCounts[post.id] ?? post.initialLikes) - 1,
        );
      }
      likedByMe[post.id] = nextLiked;

      likeBtn.classList.toggle('is-liked', nextLiked);
      likeBtn.setAttribute('aria-pressed', String(nextLiked));
      postLikesEl.textContent = String(likeCounts[post.id]);
      saveLocalState();
      syncTotalsAndTiles();

      if (nextLiked) {
        spawnHeartAt(clientX, clientY);
      }

      fetch('/api/photos', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          action: 'like',
          postId: post.id,
          liked: nextLiked,
          name: visitor.name,
          email: visitor.email,
          token: visitor.token,
        }),
      }).catch(() => {});
    };

    likeBtn.addEventListener('click', () => {
      const r = mediaStage.getBoundingClientRect();
      triggerLike(
        undefined,
        r.left + r.width * (0.35 + Math.random() * 0.3),
        r.top + r.height * (0.45 + Math.random() * 0.25),
      );
    });

    mediaStage.addEventListener('dblclick', e => {
      if ((e.target as HTMLElement).closest('button')) return;
      triggerLike(true, e.clientX, e.clientY);
    });

    commentFocusBtn.addEventListener('click', () => commentInput.focus());

    commentInput.addEventListener('input', () => {
      commentForm.classList.toggle(
        'has-text',
        commentInput.value.trim().length > 0,
      );
    });

    commentForm.addEventListener('submit', e => {
      e.preventDefault();
      if (!visitor) {
        gateName.focus();
        return;
      }
      const text = commentInput.value.trim();
      if (!text) return;
      const post = posts[activePostIdx];
      const tempComment: EnrichedComment = {
        id: `c-${Date.now().toString(36)}`,
        author: visitor.name,
        text,
        createdAt: new Date().toISOString(),
        canDelete: true,
      };
      (commentsByPost[post.id] ??= []).push(tempComment);
      commentInput.value = '';
      commentForm.classList.remove('has-text');
      saveLocalState();
      renderComments(post);
      syncTotalsAndTiles();

      fetch('/api/photos', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          action: 'comment',
          postId: post.id,
          text,
          name: visitor.name,
          email: visitor.email,
          token: visitor.token,
        }),
      })
        .then(r => r.json())
        .then(data => {
          if (data?.ok && data.comment) {
            const list = commentsByPost[post.id] ?? [];
            const idx = list.findIndex(c => c.id === tempComment.id);
            if (idx !== -1) list[idx] = data.comment;
            saveLocalState();
            renderComments(post);
          }
        })
        .catch(() => {});
    });

    syncTotalsAndTiles();
    syncVisitorUI();
  }
</script>
