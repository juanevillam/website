---
import T from './T.astro';
import { PHOTO_POSTS, posterOf } from '../lib/photos';
import { versionedMedia } from '../lib/mediaVersion';
import { sceneAttr, sceneOf } from '../lib/scene';

/**
 * THE PHOTOS CARD'S SCREEN (MoreOfMe) — Juan's personal photo feed inside
 * juanevillam.com (/more-of-me/photos).
 *
 * Shares the same two-column PanelDeck layout as Cosmos and Songs (title,
 * subtitle, scrollable text, and narrator on the left; this interactive 3:2
 * screen on the right).
 *
 * Every image in every post computes its own ambient scene palette (`scenes`)
 * at build time so stepping through a post's carousel updates the room light
 * ("el blob") to match the exact photo on screen.
 */
const isDev = import.meta.env.DEV;
const posts = await Promise.all(
  PHOTO_POSTS.map(async post => {
    const media = post.media.map(versionedMedia);
    const cover = versionedMedia(posterOf(post.media[0]));
    const scenes = await Promise.all(
      post.media.map(async m => sceneAttr(await sceneOf(posterOf(m)))),
    );
    return {
      ...post,
      media,
      cover,
      scene: scenes[0],
      scenes,
    };
  }),
);

const totalInitialLikes = posts.reduce((sum, p) => sum + p.initialLikes, 0);
---

<div
  class:list={['photos', !isDev && 'is-locked']}
  data-photos
  data-view="grid"
  data-dev={isDev ? 'true' : undefined}
  data-posts={JSON.stringify(posts)}
>
  <!-- Profile header -->
  <header class="ig-head">
    <div class="ig-ident">
      <div class="ig-avatar" aria-hidden="true">
        <img
          src="/media/likes/photos/profile.webp"
          alt=""
          width="80"
          height="80"
          decoding="async"
          draggable="false"
        />
      </div>
      <div class="ig-handle-row">
        <span class="ig-handle">juanevillam</span>
        <span class="ig-stats">
          <strong data-total-posts>{posts.length}</strong>
          <T k="photos.posts" />
          <span class="ig-dot">·</span>
          <strong data-total-likes>{totalInitialLikes}</strong>
          <T k="photos.likes" />
        </span>
      </div>
    </div>

    <div class="ig-actions">
      <div class="view-switch" role="group" aria-labelledby="photos-view-label">
        <span id="photos-view-label" class="sr"><T k="photos.grid" /> / <T k="photos.feed" /></span>
        <button
          type="button"
          class="circle-btn is-active"
          data-view-btn="grid"
          aria-pressed="true"
        >
          <svg viewBox="0 0 18 18" width="14" height="14" aria-hidden="true">
            <rect
              x="2"
              y="2"
              width="5.5"
              height="5.5"
              rx="1"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"></rect>
            <rect
              x="10.5"
              y="2"
              width="5.5"
              height="5.5"
              rx="1"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"></rect>
            <rect
              x="2"
              y="10.5"
              width="5.5"
              height="5.5"
              rx="1"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"></rect>
            <rect
              x="10.5"
              y="10.5"
              width="5.5"
              height="5.5"
              rx="1"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"></rect>
          </svg>
          <span class="sr"><T k="photos.grid" /></span>
        </button>
        <button
          type="button"
          class="circle-btn"
          data-view-btn="detail"
          aria-pressed="false"
        >
          <svg viewBox="0 0 18 18" width="14" height="14" aria-hidden="true">
            <rect
              x="2.5"
              y="2.5"
              width="13"
              height="8.5"
              rx="1.5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"></rect>
            <path
              d="M2.5 14.5h13"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"></path>
          </svg>
          <span class="sr"><T k="photos.feed" /></span>
        </button>
      </div>
    </div>
  </header>

  <div class="ig-body">
    <!-- 3-column Instagram grid -->
    <div class="ig-grid-wrap" data-panel-view="grid">
      <div class="ig-grid">
        {
          posts.map((post, idx) => {
            const hasVideo = post.media.some(m => m.endsWith('.mp4'));
            const isMulti = post.media.length > 1;
            return (
              <button
                type="button"
                class="ig-tile"
                data-open-post={idx}
                aria-label={post.caption.en}
              >
                <img
                  src={post.cover}
                  alt={post.caption.en}
                  loading="lazy"
                  decoding="async"
                  draggable="false"
                />
                {(isMulti || hasVideo) && (
                  <span class="tile-badge" aria-hidden="true">
                    {hasVideo ? (
                      <svg viewBox="0 0 20 20" width="18" height="18">
                        <path
                          d="M5.5 3.8v12.4a1 1 0 0 0 1.53.85l9.7-6.2a1 1 0 0 0 0-1.7l-9.7-6.2A1 1 0 0 0 5.5 3.8Z"
                          fill="currentColor"
                        />
                      </svg>
                    ) : (
                      /* Instagram-style filled stacked squares icon */
                      <svg viewBox="0 0 22 22" width="18" height="18">
                        <rect
                          x="2"
                          y="5.5"
                          width="13.5"
                          height="13.5"
                          rx="2.6"
                          fill="currentColor"
                        />
                        <path
                          d="M7.5 2h9.4A3.1 3.1 0 0 1 20 5.1v9.4a1 1 0 0 1-2 0V5.3a1.3 1.3 0 0 0-1.3-1.3H7.5a1 1 0 0 1 0-2Z"
                          fill="currentColor"
                        />
                      </svg>
                    )}
                  </span>
                )}
                <span class="tile-hover" aria-hidden="true">
                  <span class="tile-stat">
                    <svg viewBox="0 0 20 20" width="18" height="18">
                      <path
                        d="M10 17.2s-6.8-4.2-6.8-8.9A4 4 0 0 1 10 5.5a4 4 0 0 1 6.8 2.8c0 4.7-6.8 8.9-6.8 8.9Z"
                        fill="currentColor"
                      />
                    </svg>
                    <span data-tile-likes={post.id}>{post.initialLikes}</span>
                  </span>
                </span>
              </button>
            );
          })
        }
      </div>
    </div>

    <!-- Single-column post detail view -->
    <div class="ig-detail is-hidden" data-panel-view="detail">
      <div class="post-stage">
        <div class="post-media" data-post-media>
          {
            [0, 1].map(() => (
              <div class="media-layer" data-media-layer>
                <img
                  class="media-fill"
                  data-media-fill
                  alt=""
                  decoding="async"
                  draggable="false"
                />
                <img
                  class="media-main"
                  data-media-img
                  alt=""
                  decoding="async"
                  draggable="false"
                />
                <video
                  class="media-main is-hidden"
                  data-media-video
                  playsinline
                  loop
                  preload="metadata"
                />
              </div>
            ))
          }

          <!-- Floating hearts container (spawns where user double-clicks/taps) -->
          <div class="hearts-layer" data-hearts-layer aria-hidden="true"></div>

          <span class="slide-count" data-slide-count>1/1</span>

          <!-- Subtle toast shown briefly when opening detail view -->
          <div class="like-hint" data-like-hint aria-hidden="true">
            <T k="photos.doubleTap" />
          </div>

          <button
            type="button"
            class="media-step prev"
            data-media-step="-1"
          >
            <span class="sr"><T k="deck.prev" /></span>
            <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true">
              <path
                d="M10 3 L5 8 L10 13"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </button>
          <button
            type="button"
            class="media-step next"
            data-media-step="1"
          >
            <span class="sr"><T k="deck.next" /></span>
            <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true">
              <path
                d="M6 3 L11 8 L6 13"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </button>

          <button
            type="button"
            class="circle-btn media-mute is-unmuted is-hidden"
            data-media-mute
          >
            <svg
              class="icon-muted"
              viewBox="0 0 16 16"
              width="13"
              height="13"
              aria-hidden="true"
            >
              <path
                d="M2.5 6.2h2.6l3.4-2.8v9.2l-3.4-2.8H2.5V6.2Zm8.2 0 3.6 3.6m0-3.6-3.6 3.6"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
            <svg
              class="icon-unmuted"
              viewBox="0 0 16 16"
              width="13"
              height="13"
              aria-hidden="true"
            >
              <path
                d="M2.5 6.2h2.6l3.4-2.8v9.2l-3.4-2.8H2.5V6.2Zm8.3-.7a3.6 3.6 0 0 1 0 5m1.8-6.8a6 6 0 0 1 0 8.6"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
            <span class="sr"><T k="photos.mute" /></span>
          </button>
        </div>

        <!-- Single bottom bar: caption on the left, like + post switcher on the right -->
        <div class="post-bar">
          <span class="post-caption" data-post-caption></span>

          <div class="post-bar-trail">
            <button
              type="button"
              class="action-stat like-btn"
              data-like-btn
              aria-pressed="false"
            >
              <span class="circle-glyph">
                <svg
                  viewBox="0 0 20 20"
                  width="15"
                  height="15"
                  aria-hidden="true"
                >
                  <path
                    d="M10 17.2s-6.8-4.2-6.8-8.9A4 4 0 0 1 10 5.5a4 4 0 0 1 6.8 2.8c0 4.7-6.8 8.9-6.8 8.9Z"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.65"
                    stroke-linejoin="round"></path>
                </svg>
              </span>
              <span class="stat-num" data-post-likes>0</span>
              <span class="sr"><T k="photos.like" /></span>
            </button>

            <span class="bar-sep" aria-hidden="true"></span>

            <div class="post-nav-pills">
              <button
                type="button"
                class="circle-btn"
                data-post-step="-1"
              >
                <span class="sr"><T k="deck.prev" /></span>
                <svg
                  viewBox="0 0 16 16"
                  width="11"
                  height="11"
                  aria-hidden="true"
                >
                  <path
                    d="M10 3.2 5.2 8l4.8 4.8"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
                </svg>
              </button>
              <button
                type="button"
                class="circle-btn"
                data-post-step="1"
              >
                <span class="sr"><T k="deck.next" /></span>
                <svg
                  viewBox="0 0 16 16"
                  width="11"
                  height="11"
                  aria-hidden="true"
                >
                  <path
                    d="M6 3.2 10.8 8 6 12.8"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
                </svg>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Tonal Liquid Glass Gate (Name + Email, production only) -->
    <div class="ig-gate" data-gate>
      <form class="gate-card" data-gate-form novalidate>
        <div class="gate-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="20" height="20">
            <rect
              x="4.5"
              y="10.5"
              width="15"
              height="10"
              rx="2.5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"></rect>
            <path
              d="M8 10.5V7.5a4 4 0 0 1 8 0v3"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"></path>
          </svg>
        </div>
        <h4 class="gate-title"><T k="photos.gateTitle" /></h4>
        <p class="gate-desc"><T k="photos.gateBody" /></p>

        <!-- Honeypot anti-bot field -->
        <input
          type="text"
          name="website"
          class="sr"
          tabindex="-1"
          autocomplete="off"
        />

        <div class="gate-fields">
          <label class="sr" for="photos-gate-name"><T k="photos.gateName" /></label>
          <input
            id="photos-gate-name"
            type="text"
            name="name"
            class="gate-input"
            data-gate-name
            placeholder="Your name"
            autocomplete="name"
            maxlength="80"
            required
          />
          <label class="sr" for="photos-gate-email"><T k="photos.gateEmail" /></label>
          <input
            id="photos-gate-email"
            type="email"
            name="email"
            class="gate-input"
            data-gate-email
            placeholder="you@email.com"
            autocomplete="email"
            maxlength="160"
            required
          />
        </div>

        <p class="gate-error is-hidden" data-gate-error>
          <T k="photos.gateError" />
        </p>

        <button type="submit" class="pill-btn gate-submit">
          <T k="photos.gateContinue" />
        </button>
      </form>
    </div>
  </div>
</div>

<style>
  .photos {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    background: var(--ground);
    color: var(--ink);
    overflow: hidden;
    user-select: none;
  }

  /* ---------- header ---------- */
  .ig-head {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.625rem 0.875rem;
    border-bottom: 1px solid var(--hairline);
    background: color-mix(in srgb, var(--surface) 86%, transparent);
    backdrop-filter: blur(16px) saturate(1.8);
    -webkit-backdrop-filter: blur(16px) saturate(1.8);
    z-index: 3;
  }

  .ig-ident {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-width: 0;
  }

  .ig-avatar {
    flex: none;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    border: 1px solid var(--hairline);
    background: var(--surface);
    box-shadow: inset 0 0.75px 0 rgb(255 255 255 / 0.16);
    overflow: hidden;
    display: grid;
    place-items: center;
  }

  .ig-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ig-handle-row {
    display: flex;
    align-items: baseline;
    gap: 0.625rem;
    flex-wrap: wrap;
  }

  .ig-handle {
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .ig-stats {
    font-size: 0.75rem;
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .ig-stats strong {
    color: var(--ink);
    font-weight: 600;
  }

  .ig-dot {
    margin: 0 0.25rem;
    color: var(--ink-3);
  }

  .ig-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .view-switch {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  /* Lone glyph controls: circle (50%) + scale(0.90) active squash */
  .circle-btn {
    position: relative;
    width: 1.875rem;
    height: 1.875rem;
    padding: 0;
    border-radius: 50%;
    border: 1px solid var(--hairline);
    background: color-mix(in srgb, var(--surface) 82%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: var(--ink-2);
    display: grid;
    place-items: center;
    cursor: pointer;
    transition:
      color var(--hover),
      border-color var(--hover),
      background-color var(--hover),
      transform var(--dur-micro) var(--ease),
      opacity var(--dur-quick) var(--ease);
  }

  .circle-btn::before {
    content: '';
    position: absolute;
    inset: -0.4375rem;
  }

  .circle-btn:hover,
  .circle-btn.is-active {
    color: var(--ink);
    border-color: var(--ink-3);
  }

  .circle-btn.is-active {
    background: color-mix(in srgb, var(--ink) 14%, var(--surface));
  }

  .circle-btn:active {
    transform: scale(0.9);
  }

  .pill-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    height: 2rem;
    padding: 0 0.875rem;
    border-radius: 999px;
    border: 1px solid var(--hairline);
    background: color-mix(in srgb, var(--surface) 84%, transparent);
    backdrop-filter: blur(14px) saturate(1.8);
    -webkit-backdrop-filter: blur(14px) saturate(1.8);
    box-shadow: inset 0 0.75px 0 rgb(255 255 255 / 0.16);
    color: var(--ink);
    font: inherit;
    font-size: 0.75rem;
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;
    transition:
      border-color var(--hover),
      background-color var(--hover),
      transform var(--dur-micro) var(--ease),
      opacity var(--dur-quick) var(--ease);
  }

  .pill-btn:hover {
    border-color: var(--ink-3);
  }

  .pill-btn:active {
    transform: scale(0.96);
  }

  /* ---------- body & 3-column grid ---------- */
  .ig-body {
    position: relative;
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr);
  }

  .ig-grid-wrap,
  .ig-detail {
    grid-area: 1 / 1;
    min-height: 0;
    transition: opacity var(--dur-quick) var(--ease);
  }

  .ig-grid-wrap.is-hidden,
  .ig-detail.is-hidden {
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
  }

  .ig-grid-wrap {
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: rgb(255 255 255 / 0.18) transparent;
    padding: 2px;
  }

  .ig-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2px;
  }

  .ig-tile {
    position: relative;
    aspect-ratio: 1 / 1;
    padding: 0;
    border: 0;
    background: var(--surface);
    overflow: hidden;
    cursor: pointer;
    transition: transform var(--dur-micro) var(--ease);
  }

  .ig-tile:active {
    transform: scale(0.98);
  }

  .ig-tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition:
      transform var(--dur-turn) var(--ease),
      filter var(--dur-turn) var(--ease);
  }

  .photos.is-locked .ig-tile img {
    filter: blur(10px) brightness(0.65);
    transform: scale(1.08);
  }

  .ig-tile:hover img {
    transform: scale(1.03);
  }

  .ig-tile:hover .tile-hover,
  .ig-tile:focus-visible .tile-hover {
    opacity: 1;
  }

  .tile-badge {
    position: absolute;
    top: 0.55rem;
    right: 0.55rem;
    color: #fff;
    filter: drop-shadow(0 1px 4px rgb(0 0 0 / 0.72));
    pointer-events: none;
  }

  .tile-hover {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    background: rgb(0 0 0 / 0.52);
    color: var(--ink);
    font-size: 1rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--hover);
  }

  .tile-stat {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    white-space: nowrap;
  }

  /* ---------- single-column post detail view ---------- */
  .ig-detail {
    display: flex;
    min-height: 0;
  }

  .post-stage {
    flex: 1;
    min-width: 0;
    min-height: 0;
    display: flex;
    flex-direction: column;
    background: var(--ground);
  }

  .post-media {
    position: relative;
    flex: 1;
    min-width: 0;
    min-height: 0;
    background: var(--ground);
    overflow: hidden;
    display: grid;
    place-items: center;
    cursor: pointer;
    touch-action: pan-y;
  }

  .media-layer {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity var(--dur-quick) linear,
      visibility 0s linear var(--dur-quick);
  }

  .ig-detail:not(.is-hidden) .media-layer.is-on {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition:
      opacity var(--dur-quick) linear,
      visibility 0s linear 0s;
  }

  .media-fill,
  .media-main {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .media-fill {
    object-fit: cover;
    transform: scale(1.18);
    filter: blur(28px) saturate(1.22) brightness(0.55);
  }

  .media-main {
    object-fit: contain;
  }

  .media-main.is-hidden {
    opacity: 0;
    pointer-events: none;
  }

  .slide-count {
    position: absolute;
    top: 0.625rem;
    right: 0.625rem;
    z-index: 2;
    padding: 0.1875rem 0.5rem;
    border-radius: 999px;
    border: 1px solid var(--hairline);
    background: color-mix(in srgb, var(--surface) 82%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
    white-space: nowrap;
    color: var(--ink);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur-quick) var(--ease);
  }

  .slide-count.is-shown {
    opacity: 1;
  }

  /* Subtle "Double-tap to like" glass toast at the bottom of the photo stage */
  .like-hint {
    position: absolute;
    bottom: 0.75rem;
    left: 50%;
    z-index: 2;
    transform: translateX(-50%) translateY(4px);
    padding: 0.25rem 0.6875rem;
    border-radius: 999px;
    border: 1px solid var(--hairline);
    background: color-mix(in srgb, var(--surface) 84%, transparent);
    backdrop-filter: blur(14px) saturate(1.8);
    -webkit-backdrop-filter: blur(14px) saturate(1.8);
    box-shadow: inset 0 0.75px 0 rgb(255 255 255 / 0.16);
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.71875rem;
    font-weight: 600;
    color: var(--ink);
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity var(--dur-quick) var(--ease),
      transform var(--dur-quick) var(--ease);
  }

  .like-hint.is-shown {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  /* Same muted arrow recipe as Events / PanelDeck `.photo-step`:
     0.3 at rest, 0.7 when hovering the photo frame, 1 on the arrow itself. */
  .media-step {
    position: absolute;
    top: 50%;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface) 82%, transparent);
    color: var(--ink);
    cursor: pointer;
    opacity: 0.3;
    transform: translateY(-50%);
    transition:
      opacity var(--hover),
      border-color var(--hover),
      transform var(--dur-micro) var(--ease);
  }

  .media-step::before {
    content: '';
    position: absolute;
    inset: -0.375rem;
  }

  .post-media:hover .media-step {
    opacity: 0.7;
  }

  .post-media .media-step:hover,
  .media-step:focus-visible {
    opacity: 1;
    border-color: var(--ink-3);
  }

  .media-step:active {
    transform: translateY(-50%) scale(0.9);
  }

  .media-step.prev {
    left: 0.625rem;
  }

  .media-step.next {
    right: 0.625rem;
  }

  .media-step.is-hidden,
  .slide-count.is-hidden,
  .media-mute.is-hidden {
    opacity: 0 !important;
    pointer-events: none !important;
  }

  .media-mute {
    position: absolute;
    bottom: 0.625rem;
    right: 0.625rem;
    z-index: 2;
  }

  .media-mute:not(.is-unmuted) .icon-unmuted,
  .media-mute.is-unmuted .icon-muted {
    display: none;
  }

  /* Floating monochrome hearts spawned where the user taps/clicks */
  .hearts-layer {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    overflow: hidden;
  }

  .hearts-layer :global(.pop-heart) {
    position: absolute;
    width: 3.25rem;
    height: 3.25rem;
    margin-left: -1.625rem;
    margin-top: -1.625rem;
    color: var(--ink);
    rotate: var(--rot, 0deg);
    will-change: translate, scale, opacity;
    filter: drop-shadow(0 6px 18px rgb(0 0 0 / 0.65));
    animation:
      heart-rise 820ms cubic-bezier(0.22, 1, 0.36, 1) forwards,
      heart-scale 820ms forwards,
      heart-fade 820ms forwards;
  }

  @keyframes heart-rise {
    0% {
      translate: 0 6px;
    }
    100% {
      translate: var(--dx, 0px) -58px;
    }
  }

  @keyframes heart-scale {
    0% {
      scale: 0.28;
      animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
    }
    24% {
      scale: 1.1;
      animation-timing-function: cubic-bezier(0.33, 0, 0.67, 1);
    }
    100% {
      scale: 0.86;
    }
  }

  @keyframes heart-fade {
    0% {
      opacity: 0;
      animation-timing-function: ease-out;
    }
    14% {
      opacity: 1;
    }
    58% {
      opacity: 1;
      animation-timing-function: cubic-bezier(0.32, 0, 0.67, 0);
    }
    100% {
      opacity: 0;
    }
  }

  /* ---------- single compact post bottom bar ---------- */
  .post-bar {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.5rem 0.875rem;
    border-top: 1px solid var(--hairline);
    background: color-mix(in srgb, var(--surface) 92%, transparent);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    z-index: 2;
  }

  .post-caption {
    min-width: 0;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .post-bar-trail {
    flex: none;
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  .bar-sep {
    width: 1px;
    height: 1.125rem;
    background: var(--hairline);
  }

  .post-nav-pills {
    display: flex;
    gap: 0.25rem;
  }

  .action-stat {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink);
    font: inherit;
    cursor: pointer;
  }

  .circle-glyph {
    width: 1.875rem;
    height: 1.875rem;
    border-radius: 50%;
    border: 1px solid var(--hairline);
    background: var(--ground);
    color: var(--ink-2);
    display: grid;
    place-items: center;
    transition:
      transform var(--dur-micro) var(--ease),
      border-color var(--hover),
      color var(--hover),
      background-color var(--hover);
  }

  .action-stat:hover .circle-glyph {
    color: var(--ink);
    border-color: var(--ink-3);
  }

  .action-stat:active .circle-glyph {
    transform: scale(0.9);
  }

  /* Monochrome white active like state */
  .like-btn.is-liked .circle-glyph {
    color: var(--ink);
    border-color: var(--ink-2);
    background: color-mix(in srgb, var(--ink) 14%, var(--ground));
  }

  .like-btn.is-liked svg path {
    fill: currentColor;
  }

  .stat-num {
    font-size: 0.75rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    min-width: 0.875rem;
    text-align: left;
    color: var(--ink-2);
  }

  .like-btn.is-liked .stat-num {
    color: var(--ink);
  }

  /* ---------- Tonal Liquid Glass Gate ---------- */
  .ig-gate {
    grid-area: 1 / 1;
    z-index: 4;
    display: grid;
    place-items: center;
    padding: 1.25rem;
    background: color-mix(in srgb, var(--ground) 52%, transparent);
    backdrop-filter: blur(16px) saturate(1.8);
    -webkit-backdrop-filter: blur(16px) saturate(1.8);
    transition:
      opacity var(--dur-turn) var(--ease),
      visibility 0s linear 0s;
  }

  .photos:not(.is-locked) .ig-gate {
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
    transition:
      opacity var(--dur-turn) var(--ease),
      visibility 0s linear var(--dur-turn);
  }

  .gate-card {
    width: min(21.5rem, 100%);
    padding: 1.25rem;
    border-radius: 1.25rem;
    border: 1px solid var(--hairline);
    background: color-mix(in srgb, var(--surface) 86%, transparent);
    backdrop-filter: blur(18px) saturate(1.8);
    -webkit-backdrop-filter: blur(18px) saturate(1.8);
    box-shadow:
      inset 0 0.75px 0 rgb(255 255 255 / 0.18),
      0 1.5rem 3rem rgb(0 0 0 / 0.5);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.625rem;
    transform: scale(1);
    transition: transform var(--dur-turn) var(--ease);
  }

  .photos:not(.is-locked) .gate-card {
    transform: scale(0.96);
  }

  .gate-icon {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    border: 1px solid var(--hairline);
    background: var(--ground);
    display: grid;
    place-items: center;
    color: var(--ink);
  }

  .gate-title {
    margin: 0;
    font-size: 1.0625rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .gate-desc {
    margin: 0;
    font-size: 0.78125rem;
    line-height: 1.45;
    color: var(--ink-body);
    max-width: 34ch;
  }

  .gate-fields {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }

  .gate-input {
    width: 100%;
    height: 2.25rem;
    padding: 0 0.75rem;
    border-radius: 0.625rem;
    border: 1px solid var(--hairline);
    background: var(--ground);
    color: var(--ink);
    font: inherit;
    font-size: 0.8125rem;
    outline: none;
    transition: border-color var(--hover);
  }

  .gate-input:focus {
    border-color: var(--ink-3);
  }

  .gate-error {
    margin: 0;
    font-size: 0.75rem;
    color: #ff453a;
  }

  .gate-error.is-hidden {
    display: none;
  }

  .gate-submit {
    width: 100%;
    height: 2.25rem;
    margin-top: 0.25rem;
    background: var(--ink);
    color: var(--ground);
    border-color: var(--ink);
    font-weight: 700;
  }

  .gate-submit:hover {
    opacity: 0.92;
  }

  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  @media (max-width: 48rem) {
    :global(.screen.is-own:has(> [data-photos]) > .screen-caption) {
      z-index: 3;
      padding-top: 3.25rem;
      background: linear-gradient(
        to bottom,
        rgb(13 13 13 / 0) 0%,
        rgb(13 13 13 / 0.08) 16%,
        rgb(13 13 13 / 0.28) 34%,
        rgb(13 13 13 / 0.58) 54%,
        rgb(13 13 13 / 0.84) 74%,
        rgb(13 13 13 / 0.96) 90%,
        rgb(13 13 13 / 1) 100%
      );
      transition: opacity var(--dur-quick) var(--ease);
    }

    :global(
        .screen.is-own:has(> [data-photos][data-view='detail']) > .screen-caption
      ) {
      opacity: 0;
      pointer-events: none;
    }

    .ig-head {
      padding: 0.5rem 0.75rem;
    }

    .ig-grid-wrap {
      padding-bottom: 4.5rem;
    }

    .post-bar {
      padding: 0.45rem 0.75rem;
    }
  }
</style>

<script>
  import type { Locale } from '../i18n/ui';
  import type { PhotoPost } from '../lib/photos';

  type EnrichedPost = PhotoPost & {
    cover: string;
    scene?: string;
    scenes?: string[];
  };
  type Visitor = { name: string; email: string; token: string };

  const VISITOR_KEY = 'jv:photos:visitor';
  const LOCAL_STATE_KEY = 'jv:photos:state';

  const makeToken = () =>
    typeof crypto !== 'undefined' && 'randomUUID' in crypto
      ? crypto.randomUUID()
      : `${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 10)}`;

  const currentLang = (): Locale => {
    const l = document.documentElement.dataset.lang;
    return l === 'es' || l === 'zh' ? l : 'en';
  };

  for (const root of document.querySelectorAll<HTMLElement>('[data-photos]')) {
    const posts: EnrichedPost[] = JSON.parse(root.dataset.posts ?? '[]');
    if (!posts.length) continue;

    const isDev = root.dataset.dev === 'true';
    const cardEl = root.closest<HTMLElement>('.deck-card');
    const gridWrap = root.querySelector<HTMLElement>(
      '[data-panel-view="grid"]',
    )!;
    const detailWrap = root.querySelector<HTMLElement>(
      '[data-panel-view="detail"]',
    )!;
    const viewBtns = [
      ...root.querySelectorAll<HTMLButtonElement>('[data-view-btn]'),
    ];
    const totalLikesEl = root.querySelector<HTMLElement>('[data-total-likes]')!;

    const gateForm = root.querySelector<HTMLFormElement>('[data-gate-form]')!;
    const gateName = root.querySelector<HTMLInputElement>('[data-gate-name]')!;
    const gateEmail =
      root.querySelector<HTMLInputElement>('[data-gate-email]')!;
    const gateError = root.querySelector<HTMLElement>('[data-gate-error]')!;

    const mediaStage = root.querySelector<HTMLElement>('[data-post-media]')!;
    const mediaLayers = [
      ...root.querySelectorAll<HTMLElement>('[data-media-layer]'),
    ].map(el => ({
      el,
      fill: el.querySelector<HTMLImageElement>('[data-media-fill]')!,
      img: el.querySelector<HTMLImageElement>('[data-media-img]')!,
      video: el.querySelector<HTMLVideoElement>('[data-media-video]')!,
    }));
    const mediaMuteBtn =
      root.querySelector<HTMLButtonElement>('[data-media-mute]')!;
    const slideCountEl = root.querySelector<HTMLElement>('[data-slide-count]')!;
    const likeHintEl = root.querySelector<HTMLElement>('[data-like-hint]')!;
    const stepBtns = [
      ...root.querySelectorAll<HTMLButtonElement>('[data-media-step]'),
    ];
    const postStepBtns = [
      ...root.querySelectorAll<HTMLButtonElement>('[data-post-step]'),
    ];
    const heartsLayer = root.querySelector<HTMLElement>('[data-hearts-layer]')!;

    const captionEl = root.querySelector<HTMLElement>('[data-post-caption]')!;
    const likeBtn = root.querySelector<HTMLButtonElement>('[data-like-btn]')!;
    const postLikesEl = root.querySelector<HTMLElement>('[data-post-likes]')!;

    let visitor: Visitor | null = isDev
      ? {
          name: 'Juan Villa',
          email: 'juanesvillamendoza@gmail.com',
          token: 'dev-owner-token',
        }
      : null;
    try {
      const saved = localStorage.getItem(VISITOR_KEY);
      if (saved) {
        const parsed = JSON.parse(saved);
        if (parsed?.name && parsed?.email) {
          visitor = {
            name: parsed.name,
            email: parsed.email,
            token: parsed.token || makeToken(),
          };
          localStorage.setItem(VISITOR_KEY, JSON.stringify(visitor));
        }
      }
    } catch {}

    const likeCounts: Record<string, number> = {};
    const likedByMe: Record<string, boolean> = {};
    for (const p of posts) {
      likeCounts[p.id] = p.initialLikes;
      likedByMe[p.id] = false;
    }

    try {
      const cached = JSON.parse(localStorage.getItem(LOCAL_STATE_KEY) ?? '{}');
      for (const [id, count] of Object.entries(cached.likeCounts ?? {})) {
        if (typeof count === 'number') likeCounts[id] = count;
      }
      for (const [id, liked] of Object.entries(cached.likedByMe ?? {})) {
        likedByMe[id] = Boolean(liked);
      }
    } catch {}

    const saveLocalState = () => {
      try {
        localStorage.setItem(
          LOCAL_STATE_KEY,
          JSON.stringify({
            likeCounts,
            likedByMe,
          }),
        );
      } catch {}
    };

    let activePostIdx = 0;
    let activeMediaIdx = 0;
    let frontLayer = 0;
    let mediaTurn = 0;
    let slideCountTimer = 0;
    let likeHintTimer = 0;
    let videoMuted = false;

    const pauseAllVideos = () => {
      for (const l of mediaLayers) l.video.pause();
    };

    const flashSlideCount = () => {
      const post = posts[activePostIdx];
      if (!post || post.media.length <= 1) {
        clearTimeout(slideCountTimer);
        slideCountEl.classList.remove('is-shown');
        return;
      }
      slideCountEl.classList.add('is-shown');
      clearTimeout(slideCountTimer);
      slideCountTimer = window.setTimeout(() => {
        slideCountEl.classList.remove('is-shown');
      }, 1600);
    };

    const flashLikeHint = () => {
      likeHintEl.classList.add('is-shown');
      clearTimeout(likeHintTimer);
      likeHintTimer = window.setTimeout(() => {
        likeHintEl.classList.remove('is-shown');
      }, 2400);
    };

    const hideLikeHint = () => {
      clearTimeout(likeHintTimer);
      likeHintEl.classList.remove('is-shown');
    };

    const syncTotalsAndTiles = () => {
      let total = 0;
      for (const p of posts) {
        const c = likeCounts[p.id] ?? p.initialLikes;
        total += c;
        const tileLikes = root.querySelector<HTMLElement>(
          `[data-tile-likes="${p.id}"]`,
        );
        if (tileLikes) tileLikes.textContent = String(c);
      }
      totalLikesEl.textContent = String(total);
    };

    const syncVisitorUI = () => {
      const unlocked = Boolean(visitor?.name && visitor?.email);
      root.classList.toggle('is-locked', !unlocked);
      if (!unlocked) {
        pauseAllVideos();
      }
    };

    const posterFor = (src: string) =>
      /\.mp4(\?|$)/.test(src) ? src.replace(/\.mp4(?=\?|$)/, '.jpg') : src;

    const captionOf = (post: EnrichedPost) =>
      post.caption[currentLang()] || post.caption.en;

    // Update the card's ambient scene light ("el blob") for the active image
    const syncSceneLight = () => {
      if (!cardEl) return;
      const post = posts[activePostIdx];
      const scene = post.scenes?.[activeMediaIdx] ?? post.scene;
      if (scene) cardEl.setAttribute('data-scene', scene);
    };

    const renderMedia = (showCounter = false) => {
      const post = posts[activePostIdx];
      const src = post.media[activeMediaIdx];
      const isVid = /\.mp4(\?|$)/.test(src);
      const poster = posterFor(src);

      syncSceneLight();

      const mine = ++mediaTurn;
      const back = mediaLayers[1 - frontLayer];
      const was = mediaLayers[frontLayer];

      back.fill.src = poster;
      if (isVid) {
        back.img.classList.add('is-hidden');
        back.video.classList.remove('is-hidden');
        if (back.video.getAttribute('src') !== src) {
          back.video.src = src;
        }
        back.video.muted = videoMuted;
        mediaMuteBtn.classList.remove('is-hidden');
        mediaMuteBtn.classList.toggle('is-unmuted', !videoMuted);
        if (!videoMuted) {
          document.dispatchEvent(new CustomEvent('media:solo'));
        }
        back.video.play().catch(() => {
          back.video.muted = true;
          mediaMuteBtn.classList.remove('is-unmuted');
          back.video.play().catch(() => {});
        });
      } else {
        back.video.pause();
        back.video.classList.add('is-hidden');
        mediaMuteBtn.classList.add('is-hidden');
        back.img.onload = null;
        back.img.src = src;
        back.img.alt = `${captionOf(post)} (${activeMediaIdx + 1}/${post.media.length})`;
        back.img.classList.remove('is-hidden');
      }

      let revealed = false;
      const reveal = () => {
        if (mine !== mediaTurn || revealed) return;
        revealed = true;
        was.el.classList.remove('is-on');
        back.el.classList.add('is-on');
        frontLayer = 1 - frontLayer;
        setTimeout(() => {
          if (mine === mediaTurn) was.video.pause();
        }, 250);
      };

      if (
        !was.el.classList.contains('is-on') ||
        isVid ||
        (back.img.complete && back.img.naturalWidth)
      ) {
        reveal();
      } else {
        back.img.onload = () => reveal();
        setTimeout(reveal, 1200);
      }

      const many = post.media.length > 1;
      slideCountEl.textContent = `${activeMediaIdx + 1}/${post.media.length}`;
      slideCountEl.classList.toggle('is-hidden', !many);
      if (showCounter) {
        flashSlideCount();
      } else {
        clearTimeout(slideCountTimer);
        slideCountEl.classList.remove('is-shown');
      }
      for (const btn of stepBtns) btn.classList.toggle('is-hidden', !many);
    };

    const renderPost = (idx: number) => {
      activePostIdx = ((idx % posts.length) + posts.length) % posts.length;
      activeMediaIdx = 0;
      const post = posts[activePostIdx];

      captionEl.textContent = captionOf(post);

      const liked = Boolean(likedByMe[post.id]);
      likeBtn.classList.toggle('is-liked', liked);
      likeBtn.setAttribute('aria-pressed', String(liked));
      postLikesEl.textContent = String(
        likeCounts[post.id] ?? post.initialLikes,
      );

      renderMedia();
    };

    const setView = (view: 'grid' | 'detail') => {
      const isGrid = view === 'grid';
      root.dataset.view = view;
      gridWrap.classList.toggle('is-hidden', !isGrid);
      detailWrap.classList.toggle('is-hidden', isGrid);
      for (const btn of viewBtns) {
        const on = btn.dataset.viewBtn === view;
        btn.classList.toggle('is-active', on);
        btn.setAttribute('aria-pressed', String(on));
      }
      if (isGrid) {
        pauseAllVideos();
        hideLikeHint();
        if (cardEl && posts[0]?.scene) {
          cardEl.setAttribute('data-scene', posts[0].scene);
        }
      } else {
        renderPost(activePostIdx);
        flashLikeHint();
      }
    };

    const GATE_PLACEHOLDERS: Record<Locale, [string, string]> = {
      en: ['Your name', 'you@email.com'],
      es: ['Tu nombre', 'tu@correo.com'],
      zh: ['你的姓名', 'your@email.com'],
    };
    const syncLangStrings = () => {
      const lang = currentLang();
      const post = posts[activePostIdx];
      if (post) captionEl.textContent = captionOf(post);
      const [namePh, emailPh] = GATE_PLACEHOLDERS[lang];
      gateName.placeholder = namePh;
      gateEmail.placeholder = emailPh;
    };
    syncLangStrings();

    // Keep caption & gate placeholders synced if language switches in-place
    new MutationObserver(syncLangStrings).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-lang'],
    });

    // Pause detail videos when the Photos card leaves the stage, the tab
    // hides, or narration starts.
    if (cardEl) {
      new MutationObserver(() => {
        if (!cardEl.classList.contains('is-current')) pauseAllVideos();
      }).observe(cardEl, { attributes: true, attributeFilter: ['class'] });
    }
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) pauseAllVideos();
    });
    document.addEventListener('narr:voice', pauseAllVideos);

    const hydrateFromServer = () => {
      const params = new URLSearchParams();
      if (visitor?.email) params.set('email', visitor.email);
      fetch(`/api/photos?${params.toString()}`)
        .then(r => r.json())
        .then(data => {
          if (!data?.ok) return;
          for (const p of posts) {
            const serverLikes = Number(data.likeCounts?.[p.id] ?? 0);
            likeCounts[p.id] = p.initialLikes + serverLikes;
            likedByMe[p.id] = Boolean(data.likedByMe?.[p.id]);
          }
          saveLocalState();
          syncTotalsAndTiles();
          if (!detailWrap.classList.contains('is-hidden')) {
            renderPost(activePostIdx);
          }
        })
        .catch(() => {});
    };

    hydrateFromServer();

    // Spawn a floating monochrome heart at (clientX, clientY) inside mediaStage
    const spawnHeartAt = (clientX?: number, clientY?: number) => {
      const rect = mediaStage.getBoundingClientRect();
      const x =
        clientX !== undefined ? clientX - rect.left : rect.width / 2;
      const y =
        clientY !== undefined ? clientY - rect.top : rect.height - 36;
      const rot = (Math.random() * 32 - 16).toFixed(1);
      const dx = (Math.random() * 28 - 14).toFixed(1);

      const el = document.createElement('div');
      el.className = 'pop-heart';
      el.style.left = `${x}px`;
      el.style.top = `${y}px`;
      el.style.setProperty('--rot', `${rot}deg`);
      el.style.setProperty('--dx', `${dx}px`);
      el.innerHTML = `<svg viewBox="0 0 24 24" width="52" height="52"><path d="M12 20.5s-8.2-5.1-8.2-10.8A4.8 4.8 0 0 1 12 6.4a4.8 4.8 0 0 1 8.2 3.3c0 5.7-8.2 10.8-8.2 10.8Z" fill="currentColor"/></svg>`;
      heartsLayer.append(el);
      el.addEventListener('animationend', () => el.remove(), { once: true });
    };

    // Gate unlock submit
    gateForm.addEventListener('submit', e => {
      e.preventDefault();
      const fd = new FormData(gateForm);
      const website = String(fd.get('website') ?? '').trim();
      const name = gateName.value.trim();
      const email = gateEmail.value.trim().toLowerCase();
      const valid =
        name.length >= 2 && /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email);

      if (!valid) {
        gateError.classList.remove('is-hidden');
        return;
      }
      gateError.classList.add('is-hidden');
      visitor = { name, email, token: visitor?.token || makeToken() };
      try {
        localStorage.setItem(VISITOR_KEY, JSON.stringify(visitor));
      } catch {}
      syncVisitorUI();

      fetch('/api/photos', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          action: 'unlock',
          name,
          email,
          token: visitor.token,
          website,
        }),
      })
        .then(() => hydrateFromServer())
        .catch(() => {});
    });

    for (const btn of viewBtns) {
      btn.addEventListener('click', () => {
        if (!visitor) return;
        setView(btn.dataset.viewBtn as 'grid' | 'detail');
      });
    }

    for (const tile of root.querySelectorAll<HTMLButtonElement>(
      '[data-open-post]',
    )) {
      tile.addEventListener('click', () => {
        if (!visitor) {
          gateName.focus();
          return;
        }
        activePostIdx = Number(tile.dataset.openPost ?? 0);
        setView('detail');
      });
    }

    for (const btn of stepBtns) {
      btn.addEventListener('click', () => {
        const post = posts[activePostIdx];
        const delta = Number(btn.dataset.mediaStep ?? 1);
        activeMediaIdx =
          ((activeMediaIdx + delta) % post.media.length + post.media.length) %
          post.media.length;
        renderMedia(true);
      });
    }

    const triggerLike = (
      forceLike?: boolean,
      clientX?: number,
      clientY?: number,
    ) => {
      if (!visitor) {
        gateName.focus();
        return;
      }
      hideLikeHint();
      const post = posts[activePostIdx];
      const currentlyLiked = Boolean(likedByMe[post.id]);
      const nextLiked = forceLike !== undefined ? forceLike : !currentlyLiked;

      if (nextLiked && !currentlyLiked) {
        likeCounts[post.id] = (likeCounts[post.id] ?? post.initialLikes) + 1;
      } else if (!nextLiked && currentlyLiked) {
        likeCounts[post.id] = Math.max(
          0,
          (likeCounts[post.id] ?? post.initialLikes) - 1,
        );
      }
      likedByMe[post.id] = nextLiked;

      likeBtn.classList.toggle('is-liked', nextLiked);
      likeBtn.setAttribute('aria-pressed', String(nextLiked));
      postLikesEl.textContent = String(likeCounts[post.id]);
      saveLocalState();
      syncTotalsAndTiles();

      if (nextLiked) {
        spawnHeartAt(clientX, clientY);
      }

      fetch('/api/photos', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          action: 'like',
          postId: post.id,
          liked: nextLiked,
          name: visitor.name,
          email: visitor.email,
        }),
      }).catch(() => {});
    };

    // Touch swipe inside post media steps the post's carousel without turning
    // the outer PanelDeck, and double-tap on touch triggers a like.
    let touchStartX: number | null = null;
    let touchStartY: number | null = null;
    let lastTapTime = 0;
    mediaStage.addEventListener(
      'touchstart',
      e => {
        if (e.touches.length === 1) {
          touchStartX = e.touches[0].clientX;
          touchStartY = e.touches[0].clientY;
          e.stopPropagation();
        }
      },
      { passive: true },
    );
    mediaStage.addEventListener(
      'touchend',
      e => {
        e.stopPropagation();
        if (touchStartX === null || touchStartY === null) return;
        const touch = e.changedTouches[0];
        const dx = touch.clientX - touchStartX;
        const dy = touch.clientY - touchStartY;
        touchStartX = null;
        touchStartY = null;
        const post = posts[activePostIdx];
        if (
          Math.abs(dx) > 36 &&
          Math.abs(dx) > Math.abs(dy) * 1.3 &&
          post.media.length > 1
        ) {
          const delta = dx < 0 ? 1 : -1;
          activeMediaIdx =
            ((activeMediaIdx + delta) % post.media.length + post.media.length) %
            post.media.length;
          renderMedia(true);
          return;
        }
        if (
          Math.abs(dx) < 14 &&
          Math.abs(dy) < 14 &&
          !(e.target as HTMLElement).closest('button')
        ) {
          const now = Date.now();
          if (now - lastTapTime < 300) {
            lastTapTime = 0;
            triggerLike(true, touch.clientX, touch.clientY);
          } else {
            lastTapTime = now;
          }
        }
      },
      { passive: true },
    );

    for (const btn of postStepBtns) {
      btn.addEventListener('click', () => {
        const delta = Number(btn.dataset.postStep ?? 1);
        renderPost(activePostIdx + delta);
      });
    }

    mediaMuteBtn.addEventListener('click', () => {
      videoMuted = !videoMuted;
      for (const l of mediaLayers) l.video.muted = videoMuted;
      mediaMuteBtn.classList.toggle('is-unmuted', !videoMuted);
      if (!videoMuted) {
        document.dispatchEvent(new CustomEvent('media:solo'));
      }
    });

    likeBtn.addEventListener('click', () => {
      const r = mediaStage.getBoundingClientRect();
      triggerLike(
        undefined,
        r.left + r.width * (0.35 + Math.random() * 0.3),
        r.top + r.height * (0.45 + Math.random() * 0.25),
      );
    });

    mediaStage.addEventListener('dblclick', e => {
      if ((e.target as HTMLElement).closest('button')) return;
      triggerLike(true, e.clientX, e.clientY);
    });

    syncTotalsAndTiles();
    syncVisitorUI();
    if (
      visitor &&
      new URLSearchParams(location.search).get('view') === 'detail'
    ) {
      setView('detail');
    }
  }
</script>
