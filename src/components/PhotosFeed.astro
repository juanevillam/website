    backdrop-filter: blur(18px) saturate(1.8);
    -webkit-backdrop-filter: blur(18px) saturate(1.8);
    box-shadow:
      inset 0 0.75px 0 rgb(255 255 255 / 0.18),
      0 1.5rem 3rem rgb(0 0 0 / 0.5);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.625rem;
    transform: scale(1);
    transition: transform var(--dur-turn) var(--ease);
  }

  .photos:not(.is-locked) .gate-card {
    transform: scale(0.96);
  }

  .gate-icon {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    border: 1px solid var(--hairline);
    background: var(--ground);
    display: grid;
    place-items: center;
    color: var(--ink);
  }

  .gate-title {
    margin: 0;
    font-size: 1.0625rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .gate-desc {
    margin: 0;
    font-size: 0.78125rem;
    line-height: 1.45;
    color: var(--ink-body);
    max-width: 34ch;
  }

  .gate-fields {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }

  .gate-input {
    width: 100%;
    height: 2.25rem;
    padding: 0 0.75rem;
    border-radius: 0.625rem;
    border: 1px solid var(--hairline);
    background: var(--ground);
    color: var(--ink);
    font: inherit;
    font-size: 0.8125rem;
    outline: none;
    transition: border-color var(--hover);
  }

  .gate-input:focus {
