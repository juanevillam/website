  }

  @keyframes heart-float {
    0% {
      opacity: 0;
      transform: translate(0, 6px) scale(0.25) rotate(var(--rot, 0deg));
    }
    28% {
      opacity: 1;
      transform: translate(0, -4px) scale(1.18) rotate(var(--rot, 0deg));
    }
    55% {
      opacity: 1;
      transform: translate(var(--dx, 0px), -18px) scale(0.98) rotate(var(--rot, 0deg));
    }
    100% {
      opacity: 0;
      transform: translate(var(--dx, 0px), -42px) scale(0.82) rotate(var(--rot, 0deg));
