    height: 1.5rem;
    padding: 0;
    border-radius: 50%;
    border: 0;
    background: var(--ink);
    color: var(--ground);
    display: grid;
    place-items: center;
    cursor: pointer;
    opacity: 0;
    transform: scale(0.65);
    pointer-events: none;
    transition:
      opacity var(--dur-micro) var(--ease),
      transform var(--dur-micro) var(--ease);
  }

  .comment-form.has-text .comment-send {
    opacity: 1;
    transform: scale(1);
    pointer-events: auto;
  }

  .comment-form.has-text .comment-send:active {
