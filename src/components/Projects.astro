---
import { type UIKey } from '../i18n/ui';
import T from './T.astro';

// The two lead apps, one full-height panel each. Sound Shaper opens the
// page. No logos or tag labels for now — Juan is picking the marks.
type Project = {
  id: string;
  name: string;
  desc: UIKey;
};

const PROJECTS: Project[] = [
  { id: 'portfolio', name: 'Sound Shaper', desc: 'projects.shaper.desc' },
  { id: 'project-topper', name: 'Topper', desc: 'projects.topper.desc' },
];
---

{
  PROJECTS.map(project => (
    <section class="panel" id={project.id}>
      <div class="inner">
        <h2 class="heading name" data-reveal>
          {project.name}
        </h2>
        <p class="body lede" data-reveal>
          <T k={project.desc} />
        </p>
      </div>
    </section>
  ))
}

<style>
  .inner {
    width: 100%;
    max-width: var(--content-max);
    margin: 0 auto;
  }

  .name {
    font-size: clamp(2.5rem, 6vw, 4rem);
  }

  .lede {
    margin-top: 1.5rem;
    font-size: 1.125rem;
    max-width: 44rem;
  }
</style>
