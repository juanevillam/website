---
import T from './T.astro';
import { EVENTS } from '../lib/events';
import { eventPath } from '../lib/links';

/**
 * Tridi's robot (lib/eggs, lib/robot), in two places:
 *
 * - `card`: walking on top of Platanus Hack 26 Caracas's photo frame,
 *   where the card tells Tridi, while that card is in front — a link to
 *   Tridi itself (the card is already where you are). The script stands
 *   it over the frame; it is out of the flow there.
 * - `foot`: across the foot's empty middle row (SiteFooter) — a link to
 *   that card. Out of the flow, in the grid's empty row.
 *
 * Only while that card is on the site; nothing moves when it comes or goes.
 */
type Props = { place: 'card' | 'foot' };
const { place } = Astro.props;
const hack = EVENTS.find(e => e.id === 'platanus');
// The card's own link to Tridi, the one its copy carries.
const body = hack?.body;
const tridi = body && typeof body === 'object' && 'links' in body ? body.links.tridi : undefined;
---

{
  hack && (
    <div class:list={['egg-robot', `is-${place}`]} data-robot={place}>
      <canvas class="egg-band" data-robot-band hidden aria-hidden="true" />
      {place === 'card' && tridi ? (
        <a class="egg-hit" href={tridi} target="_blank" rel="noopener noreferrer" data-robot-link hidden>
          <span class="sr-only">
            <T k="egg.robot.tridi" />
          </span>
        </a>
      ) : (
        <a class="egg-hit" href={eventPath(hack)} data-robot-link hidden>
          <span class="sr-only">
            <T k="egg.robot" />
          </span>
        </a>
      )}
    </div>
  )
}

<style>
  .egg-robot {
    position: absolute;
    pointer-events: none;
  }

  /* The grid's empty middle row, edge to edge of the screen, standing on
     its foot. */
  .is-foot {
    grid-row: 2 / 3;
    grid-column: 1 / -1;
    bottom: 0;
    left: calc(50% - 50vw);
    width: 100vw;
    height: 7.5rem;
  }

  /* Over the photo frame, standing on its top edge (the script sets
     where and how wide). */
  .is-card {
    height: 7rem;
  }

  .egg-band {
    display: block;
    width: 100%;
    height: 100%;
    transition: opacity var(--dur-quick) var(--ease);
  }

  .egg-band[hidden] {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .egg-band {
      opacity: 0;
      transition: opacity var(--dur-settle) var(--ease);
    }

    .egg-band.is-still {
      opacity: 1;
    }
  }

  .egg-hit {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 48px;
    height: 100px;
    border-radius: 12px;
    pointer-events: auto;
    cursor: pointer;
    will-change: transform;
  }

  .egg-hit:focus-visible {
    outline: 1px solid var(--ink-3);
    outline-offset: 2px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>

<script>
  import { nowAndThen, reduceMotion, toCard } from '../lib/eggs';

  const show = async (band: HTMLCanvasElement, link: HTMLAnchorElement, opts?: import('../lib/robot').WalkOptions) => {
    const robot = await import('../lib/robot');
    if (reduceMotion.matches) await robot.stand(band, link);
    else await robot.walk(band, link, opts);
  };

  for (const egg of document.querySelectorAll<HTMLElement>('[data-robot]')) {
    const band = egg.querySelector<HTMLCanvasElement>('[data-robot-band]')!;
    const link = egg.querySelector<HTMLAnchorElement>('[data-robot-link]')!;

    if (egg.dataset.robot === 'foot') {
      const foot = egg.closest<HTMLElement>('footer');
      if (!foot) continue;
      toCard(link, 'events', 'platanus');
      // The foot is passed through, not read: it comes almost at once.
      nowAndThen(foot, [1500, 2500], [20000, 30000], () => show(band, link));
      continue;
    }

    // The card: it stands on the photo frame's top edge, in the frame's
    // own positioned ancestor, measured each time it walks (a turn, a
    // resize, the phone's layout).
    const section = document.getElementById('events');
    const card = section?.querySelector<HTMLElement>('.card[data-card="platanus"]');
    const frame = card?.querySelector<HTMLElement>('.screen');
    if (!section || !card || !frame) continue;
    const front = () => card.classList.contains('is-current');
    const stand = () => {
      const holder = frame.offsetParent as HTMLElement | null;
      if (!holder) return false;
      if (egg.parentElement !== holder) holder.append(egg);
      const f = frame.getBoundingClientRect();
      const h = holder.getBoundingClientRect();
      egg.style.left = `${(f.left - h.left - holder.clientLeft).toFixed(1)}px`;
      egg.style.width = `${f.width.toFixed(1)}px`;
      egg.style.top = `${(f.top - h.top - holder.clientTop - egg.offsetHeight).toFixed(1)}px`;
      return true;
    };
    const phone = matchMedia('(max-width: 48rem)');
    nowAndThen(
      section,
      [1500, 2500],
      [20000, 30000],
      async () => {
        if (!stand()) return;
        // On a phone it keeps clear of the eyebrow at the left and the
        // header's pill at the right.
        await show(band, link, phone.matches ? { from: 0.16, to: 0.86, handover: 0.26, alive: front } : { from: 0.04, to: 0.86, alive: front });
      },
      front,
    );
  }
</script>
