---
import T from './T.astro';
import { EVENTS } from '../lib/events';

/**
 * Tridi's robot (lib/eggs, lib/robot), walking on top of Platanus Hack 26
 * Caracas's photo frame, where the card tells Tridi, while that card is in
 * front — a link to Tridi itself (the card is already where you are).
 * Only there (Juan, 2026-10-28). The walk, and a few seconds after it
 * the mirror (lib/robot), on every visit (Juan, 2026-11-03). The script stands it over the frame; it
 * is out of the flow, so nothing moves when it comes or goes.
 */
const hack = EVENTS.find(e => e.id === 'platanus');
// The card's own link to Tridi, the one its copy carries.
const body = hack?.body;
const tridi = body && typeof body === 'object' && 'links' in body ? body.links.tridi : undefined;
---

{
  tridi && (
    <div class="egg-robot" data-robot>
      <canvas class="egg-band" data-robot-band hidden aria-hidden="true" />
      <a class="egg-hit" href={tridi} target="_blank" rel="noopener noreferrer" data-robot-link hidden>
        <span class="sr-only">
          <T k="egg.robot.tridi" />
        </span>
      </a>
    </div>
  )
}

<style>
  /* Over the photo frame, standing on its top edge (the script sets
     where and how wide). */
  .egg-robot {
    position: absolute;
    height: 7rem;
    pointer-events: none;
  }

  .egg-band {
    display: block;
    width: 100%;
    height: 100%;
    transition: opacity var(--dur-quick) var(--ease);
  }

  .egg-band[hidden] {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .egg-band {
      opacity: 0;
      transition: opacity var(--dur-settle) var(--ease);
    }

    .egg-band.is-still {
      opacity: 1;
    }
  }

  .egg-hit {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 48px;
    height: 100px;
    border-radius: 12px;
    pointer-events: auto;
    cursor: pointer;
    will-change: transform;
  }

  .egg-hit:focus-visible {
    outline: 1px solid var(--ink-3);
    outline-offset: 2px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>

<script>
  import { busy, nowAndThen, reduceMotion } from '../lib/eggs';

  const egg = document.querySelector<HTMLElement>('[data-robot]');
  const section = document.getElementById('events');
  const card = section?.querySelector<HTMLElement>('.card[data-card="platanus"]');
  const frame = card?.querySelector<HTMLElement>('.screen');
  if (egg && section && card && frame) {
    const band = egg.querySelector<HTMLCanvasElement>('[data-robot-band]')!;
    const link = egg.querySelector<HTMLAnchorElement>('[data-robot-link]')!;
    const front = () => card.classList.contains('is-current');
    // It stands on the frame's top edge, in the frame's own positioned
    // ancestor, measured each time it plays (a turn, a resize, the
    // phone's layout) — and never taller than the room between the
    // section's top and the frame, so a raised hand is never cut off by
    // the screen's edge (Juan, 2026-11-03: on a phone it was).
    const stand = () => {
      const holder = frame.offsetParent as HTMLElement | null;
      if (!holder) return false;
      if (egg.parentElement !== holder) holder.append(egg);
      const f = frame.getBoundingClientRect();
      const h = holder.getBoundingClientRect();
      const room = f.top - section.getBoundingClientRect().top - 8;
      egg.style.height = `${Math.min(7 * 16, room).toFixed(1)}px`;
      egg.style.left = `${(f.left - h.left - holder.clientLeft).toFixed(1)}px`;
      egg.style.width = `${f.width.toFixed(1)}px`;
      egg.style.top = `${(f.top - h.top - holder.clientTop - egg.offsetHeight).toFixed(1)}px`;
      return true;
    };
    const phone = matchMedia('(max-width: 48rem)');
    const pause = (ms: number) => new Promise(r => setTimeout(r, ms));
    // THE WALK, THEN THE MIRROR, on the same visit (Juan, 2026-11-03): a
    // few seconds after the walk has gone, the jumping jacks — while the
    // card is still in front and the page is free.
    nowAndThen(
      section,
      [1500, 2500],
      [20000, 30000],
      async () => {
        if (!stand()) return;
        const robot = await import('../lib/robot');
        if (reduceMotion.matches) return robot.stand(band, link, 'walk');
        // On a phone it keeps clear of the eyebrow at the left and the
        // header's pill at the right.
        await robot.walk(
          band,
          link,
          phone.matches
            ? { from: 0.16, to: 0.86, handover: 0.26, alive: front }
            : { from: 0.04, to: 0.86, alive: front },
        );
        await pause(2500);
        for (let i = 0; i < 20 && busy(); i++) await pause(500);
        if (!front() || busy() || !stand()) return;
        await robot.mirror(band, link, { alive: front });
      },
      front,
    );
  }
</script>
