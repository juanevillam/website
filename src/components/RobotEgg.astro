---
import T from './T.astro';
import { EVENTS } from '../lib/events';
import { eventPath } from '../lib/links';

/**
 * Tridi's robot, now and then, across the foot's empty middle (lib/eggs,
 * lib/robot): a link to Platanus Hack 26 Caracas, where Juan's team built
 * it. Out of the flow, in the grid's empty row (SiteFooter), so nothing
 * moves when it comes or goes. Only while that card is on the site.
 */
const hack = EVENTS.find(e => e.id === 'platanus');
---

{
  hack && (
    <div class="egg-robot">
      <canvas class="egg-band" data-robot-band hidden aria-hidden="true" />
      <a class="egg-hit" href={eventPath(hack)} data-robot-link hidden>
        <span class="sr-only">
          <T k="egg.robot" />
        </span>
      </a>
    </div>
  )
}

<style>
  /* The grid's empty middle row, edge to edge of the screen, standing on
     its foot. */
  .egg-robot {
    position: absolute;
    grid-row: 2 / 3;
    grid-column: 1 / -1;
    bottom: 0;
    left: calc(50% - 50vw);
    width: 100vw;
    height: 7.5rem;
    pointer-events: none;
  }

  .egg-band {
    display: block;
    width: 100%;
    height: 100%;
    transition: opacity var(--dur-quick) var(--ease);
  }

  .egg-band[hidden] {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .egg-band {
      opacity: 0;
      transition: opacity var(--dur-settle) var(--ease);
    }

    .egg-band.is-still {
      opacity: 1;
    }
  }

  .egg-hit {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 48px;
    height: 100px;
    border-radius: 12px;
    pointer-events: auto;
    cursor: pointer;
    will-change: transform;
  }

  .egg-hit:focus-visible {
    outline: 1px solid var(--ink-3);
    outline-offset: 2px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>

<script>
  import { nowAndThen, reduceMotion, toCard } from '../lib/eggs';

  const band = document.querySelector<HTMLCanvasElement>('[data-robot-band]');
  const link = document.querySelector<HTMLAnchorElement>('[data-robot-link]');
  const foot = band?.closest<HTMLElement>('footer');
  if (band && link && foot) {
    toCard(link, 'events', 'platanus');
    // The foot is passed through, not read: it comes sooner than the
    // ship, and as rarely after.
    nowAndThen(foot, [3000, 6000], [45000, 75000], async () => {
      const robot = await import('../lib/robot');
      if (reduceMotion.matches) await robot.stand(band, link);
      else await robot.walk(band, link);
    });
  }
</script>
