---
import T from './T.astro';

/**
 * THE narrator — one control for the whole page, drawn once. It never
 * lives in a scene: it floats, and the page's render loop glides it
 * between the anchors each narrated block reserves (under the hero's
 * wordmark, under the opener's pitch, under each slide's caption), the
 * way the lockup travels. One voice, so one control.
 *
 * Nothing on it but Juan's voice, drawn: an oscilloscope of the actual
 * audio (a live analyser's waveform, locked to each cycle so it holds
 * still instead of flickering). Silence is a flat line — at rest, in a
 * pause, between words. Louder, the wave grows; higher, it tightens.
 *
 * The shape and material are the floating pills', one size up: it is
 * Juan speaking, so it outranks the chrome it shares a family with.
 */
---

<button
  class="narrator"
  type="button"
  data-narrator
  hidden
>
  <span class="sr-only nar-idle"><T k="listen" /></span>
  <span class="sr-only nar-live"><T k="pause" /></span>
  <canvas class="nar-wave" aria-hidden="true"></canvas>
</button>

<style>
  .narrator {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 40;
    display: block;
    overflow: hidden;
    width: var(--narrator-w);
    height: var(--narrator-h);
    padding: 0 0.875rem;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface) 82%, transparent);
    backdrop-filter: blur(12px);
    color: var(--ink-2);
    cursor: pointer;
    will-change: transform, opacity;
    transition:
      color var(--dur-micro) var(--ease),
      border-color var(--dur-micro) var(--ease);
  }

  .narrator[hidden] {
    display: none;
  }

  .narrator:hover,
  .narrator.is-playing {
    color: var(--ink);
    border-color: var(--ink-3);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .nar-live,
  .narrator.is-playing .nar-idle {
    display: none;
  }

  .narrator.is-playing .nar-live {
    display: inline;
  }

  /* The wave: drawn by the controller in the pill's ink, faded at both
     ends so it rises out of the rim rather than being cut by it. */
  .nar-wave {
    position: absolute;
    inset: 0 1rem;
    width: calc(100% - 2rem);
    height: 100%;
    mask-image: linear-gradient(
      to right,
      transparent,
      #000 18%,
      #000 82%,
      transparent
    );
  }
</style>
