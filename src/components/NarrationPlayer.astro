---
import T from './T.astro';

/**
 * THE narrator — one control for the whole page, drawn once. It never
 * lives in a scene: it floats, and the page's render loop glides it
 * between the anchors each narrated block reserves (under the hero's
 * wordmark, under the opener's pitch, under each slide's caption), the
 * way the lockup travels. One voice, so one control.
 *
 * No word on it. It is Sound Shaper's own mark — five bars — and the
 * bars ARE the state: at rest they hold the mark's frozen shape; while
 * Juan speaks they follow his actual voice, band by band, off a live
 * analyser on the audio; paused, they settle back into the mark.
 *
 * The material is the floating pills' (the header's two controls), so
 * the page's three floating things read as one family.
 */
---

<button
  class="narrator"
  type="button"
  data-narrator
  hidden
>
  <span class="sr-only nar-idle"><T k="listen" /></span>
  <span class="sr-only nar-live"><T k="pause" /></span>
  <span class="nar-bars" aria-hidden="true">
    <i></i><i></i><i></i><i></i><i></i>
  </span>
</button>

<style>
  .narrator {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 40;
    display: grid;
    place-items: center;
    width: var(--float-h);
    height: var(--float-h);
    padding: 0;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface) 82%, transparent);
    backdrop-filter: blur(12px);
    color: var(--ink-2);
    cursor: pointer;
    will-change: transform, opacity;
    transition:
      color var(--dur-micro) var(--ease),
      border-color var(--dur-micro) var(--ease);
  }

  .narrator[hidden] {
    display: none;
  }

  .narrator:hover,
  .narrator.is-playing {
    color: var(--ink);
    border-color: var(--ink-3);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .nar-live,
  .narrator.is-playing .nar-idle {
    display: none;
  }

  .narrator.is-playing .nar-live {
    display: inline;
  }

  /* The mark on the app's own grid: 2px bars on a 7-unit pitch, heights
     driven per frame by the controller (--h, 0–1 of the tallest). */
  .nar-bars {
    display: flex;
    align-items: center;
    gap: 3px;
    height: 1rem;
  }

  .nar-bars i {
    width: 2px;
    height: 100%;
    border-radius: 1px;
    background: currentColor;
    transform: scaleY(var(--h, 0.5));
  }
</style>
