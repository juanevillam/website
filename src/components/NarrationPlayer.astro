---
import T from './T.astro';

/**
 * The narration control that sits under a block of narrated paragraphs.
 * It only RENDERS — StoryShowcase's controller drives it, because one
 * narration runs across the whole story (paragraph to paragraph, slide
 * to slide), not per player.
 *
 * Idle it reads as an invitation: play glyph + "Listen". Playing, the
 * word gives way to five live bars — Sound Shaper's own mark, moving —
 * and the track fills one segment per paragraph, so it is always clear
 * how much of this slide is left.
 */
type Props = {
  /** One segment per narrated paragraph. */
  segments: number;
};

const { segments } = Astro.props;
---

<div class="narration" data-narration>
  <!-- Both states share ONE grid cell, so the button is always as wide
       as the wider of the two and the track beside it never jumps. -->
  <button class="nar-toggle" type="button" data-nar-toggle>
    <span class="nar-state nar-idle">
      <svg class="nar-glyph" viewBox="0 0 12 12" aria-hidden="true">
        <path fill="currentColor" d="M2.5 1.5l8 4.5-8 4.5z"></path>
      </svg>
      <span class="nar-word"><T k="listen" /></span>
    </span>
    <span class="nar-state nar-live">
      <svg class="nar-glyph" viewBox="0 0 12 12" aria-hidden="true">
        <path fill="currentColor" d="M2.5 1.5h2.6v9H2.5zM6.9 1.5h2.6v9H6.9z"
        ></path>
      </svg>
      <span class="nar-bars" aria-hidden="true">
        <i></i><i></i><i></i><i></i><i></i>
      </span>
    </span>
  </button>

  <div class="nar-track" aria-hidden="true">
    {
      Array.from({ length: segments }, (_, i) => (
        <button
          class="nar-seg"
          type="button"
          tabindex="-1"
          data-nar-seg={i}
        >
          <i />
        </button>
      ))
    }
  </div>
</div>

<style>
  .narration {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  /* The listen pill's shape — a control keeps the 999px invite. */
  .nar-toggle {
    display: inline-grid;
    align-items: center;
    height: 2.25rem;
    padding: 0 1rem 0 0.875rem;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    background: transparent;
    font: inherit;
    font-size: 0.875rem;
    color: var(--ink-2);
    cursor: pointer;
    transition:
      color var(--dur-micro) var(--ease),
      border-color var(--dur-micro) var(--ease);
  }

  .nar-toggle:hover,
  .narration.is-playing .nar-toggle {
    color: var(--ink);
    border-color: var(--ink-3);
  }

  .nar-glyph {
    width: 0.6875rem;
    height: 0.6875rem;
  }

  .nar-state {
    grid-area: 1 / 1;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .nar-live,
  .narration.is-playing .nar-idle {
    visibility: hidden;
  }

  .narration.is-playing .nar-live {
    visibility: visible;
  }

  /* Five bars, the app's own mark, dancing on the site's beat. */
  .nar-bars {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    height: 0.875rem;
  }

  .nar-bars i {
    width: 2px;
    height: 100%;
    border-radius: 1px;
    background: currentColor;
    transform-origin: center;
    animation: nar-bar var(--beat) var(--ease) infinite alternate;
  }

  .nar-bars i:nth-child(1) { animation-delay: calc(var(--beat) * -0.5); }
  .nar-bars i:nth-child(2) { animation-delay: calc(var(--beat) * -0.2); }
  .nar-bars i:nth-child(3) { animation-delay: calc(var(--beat) * -0.8); }
  .nar-bars i:nth-child(4) { animation-delay: calc(var(--beat) * -0.35); }
  .nar-bars i:nth-child(5) { animation-delay: calc(var(--beat) * -0.65); }

  @keyframes nar-bar {
    from { transform: scaleY(0.25); }
    to { transform: scaleY(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .nar-bars i {
      animation: none;
      transform: scaleY(0.6);
    }
  }

  /* One segment per paragraph. Tapping one jumps the voice there. */
  .nar-track {
    display: flex;
    gap: 0.375rem;
    flex: 0 1 9rem;
  }

  .nar-seg {
    flex: 1;
    height: 1.25rem;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    display: flex;
    align-items: center;
  }

  .nar-seg i {
    display: block;
    width: 100%;
    height: 2px;
    border-radius: 1px;
    background: linear-gradient(
        var(--ink),
        var(--ink)
      )
      0 0 / calc(var(--fill, 0) * 100%) 100% no-repeat,
      var(--hairline);
  }
</style>
