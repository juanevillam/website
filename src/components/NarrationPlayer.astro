---
import T from './T.astro';

/**
 * THE narrator — one control for the whole page, drawn once. It never
 * lives in a scene: it floats, and the page's render loop glides it
 * between the anchors each narrated block reserves (under the hero's
 * wordmark, under the opener's store row, under each slide's caption),
 * the way the lockup travels. One voice, so one control.
 *
 * It is only play and pause — a floating pill built by the header's own
 * recipe at three times its area, so it outranks the chrome it shares a
 * family with. The voice itself is
 * drawn once, in the field along the foot of the screen: three hairline
 * sound waves, each stretch answering its own band of Juan's actual
 * voice, flat in silence. Drawing it in the control as well only made
 * the two compete.
 *
 * SUBTITLES unfold from it. While a clip with a transcript plays, the
 * pill opens wider like the Dynamic Island: the glyph slides to the
 * leading end and what Juan is saying — looser than the words on
 * screen — runs beside it, phrase by phrase.
 */
---

<!-- The field the voice moves — behind every section, above only
     the page's own ground (z -1, painted over the body's background). -->
<canvas class="nar-field" aria-hidden="true"></canvas>

<button
  class="narrator"
  type="button"
  data-narrator
  hidden
>
  <span class="sr-only nar-idle"><T k="listen" /></span>
  <span class="sr-only nar-live"><T k="pause" /></span>
  <span class="nar-glyph" aria-hidden="true">
    <svg class="nar-play" viewBox="0 0 16 16">
      <path fill="currentColor" d="M3.9 2.6v10.8c0 .6.7 1 1.2.7l8.4-5.4a.8.8 0 0 0 0-1.4L5.1 1.9c-.5-.3-1.2.1-1.2.7z"></path>
    </svg>
    <svg class="nar-pause" viewBox="0 0 16 16">
      <rect fill="currentColor" x="3.5" y="2.5" width="3" height="11" rx="1"></rect>
      <rect fill="currentColor" x="9.5" y="2.5" width="3" height="11" rx="1"></rect>
    </svg>
  </span>
  <span class="nar-sub" data-nar-sub aria-hidden="true"></span>
</button>

<style>
  .nar-field {
    position: fixed;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .narrator {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 40;
    display: block;
    overflow: hidden;
    width: var(--narrator-w);
    height: var(--narrator-h);
    padding: 0;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface) 82%, transparent);
    backdrop-filter: blur(12px);
    color: var(--ink-2);
    cursor: pointer;
    will-change: transform, opacity;
    transition:
      width var(--beat) var(--ease),
      color var(--dur-micro) var(--ease),
      border-color var(--dur-micro) var(--ease);
  }

  .narrator.is-captioned {
    width: var(--narrator-w-open);
  }

  .narrator[hidden] {
    display: none;
  }

  .narrator:hover,
  .narrator.is-playing {
    color: var(--ink);
    border-color: var(--ink-3);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .nar-live,
  .narrator.is-playing .nar-idle {
    display: none;
  }

  .narrator.is-playing .nar-live {
    display: inline;
  }

  /* Centred in the closed pill; when it opens for subtitles the glyph's
     box narrows to a square at the leading end, carrying it there. */
  .nar-glyph {
    position: absolute;
    top: 0;
    left: 0;
    display: grid;
    place-items: center;
    width: var(--narrator-w);
    height: 100%;
    transition: width var(--beat) var(--ease);
  }

  .narrator.is-captioned .nar-glyph {
    width: var(--narrator-h);
  }

  /* The play triangle is drawn centred on its own balance point, not
     its box — no nudge on top (a nudge on a pre-shifted path is what
     pushed it right). */
  .nar-glyph svg {
    grid-area: 1 / 1;
    width: var(--narrator-glyph);
    height: var(--narrator-glyph);
  }

  .nar-pause,
  .narrator.is-playing .nar-play {
    visibility: hidden;
  }

  .narrator.is-playing .nar-pause {
    visibility: visible;
  }

  /* The subtitle: the line being said, beside the bars. Two lines at
     most; it fades in only once the pill has opened around it. */
  .nar-sub {
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(var(--narrator-h) - 0.5rem);
    right: 1.75rem;
    display: flex;
    align-items: center;
    font-size: 0.9375rem;
    line-height: 1.35;
    text-align: left;
    color: var(--ink);
    opacity: 0;
    transition: opacity var(--dur-micro) var(--ease);
  }

  .narrator.is-captioned .nar-sub {
    opacity: 1;
    transition-delay: calc(var(--beat) / 2);
  }

  .nar-sub :global(.nar-sub-line) {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    animation: nar-sub-in calc(var(--beat) / 2) var(--ease);
  }

  @keyframes nar-sub-in {
    from {
      opacity: 0;
    }
  }
</style>
