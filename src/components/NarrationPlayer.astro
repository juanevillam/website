---
import T from './T.astro';

/**
 * THE narrator — one control for the whole page, drawn once. It never
 * lives in a scene: it floats, and the page's render loop glides it
 * between the anchors each narrated block reserves (under the hero's
 * wordmark, under the opener's pitch, under each slide's caption), the
 * way the lockup travels. One voice, so one control.
 *
 * Nothing on it but Juan's voice: Sound Shaper's thin waveform bars,
 * made live like a synth's visualiser and mirrored out from the centre.
 * Each pair is one band of his actual voice (body at the centre, air at
 * the edges), so pitch and loudness both show; between words they drop
 * to still dots. At rest a soft bell breathes — it reads as sound.
 *
 * SUBTITLES unfold from it. While a clip with a transcript plays, the
 * pill widens like the Dynamic Island: the bars keep their place at the
 * leading end and what Juan is saying — which is looser than the words
 * on screen — runs beside them, phrase by phrase.
 *
 * THE PAGE LISTENS TOO. Behind everything, a field the voice drops
 * into: each syllable's onset sends a ring out from the pill across the
 * whole page, sized by how hard it lands, and a soft glow round the pill
 * breathes with the loudness. Silence lets it settle. Monochrome.
 *
 * The shape and material are the floating pills', one size up: it is
 * Juan speaking, so it outranks the chrome it shares a family with.
 */
---

<!-- The field the voice drops into — behind every section, above only
     the page's own ground (z -1, painted over the body's background). -->
<canvas class="nar-field" aria-hidden="true"></canvas>

<button
  class="narrator"
  type="button"
  data-narrator
  hidden
>
  <span class="sr-only nar-idle"><T k="listen" /></span>
  <span class="sr-only nar-live"><T k="pause" /></span>
  <canvas class="nar-wave" aria-hidden="true"></canvas>
  <span class="nar-sub" data-nar-sub aria-hidden="true"></span>
</button>

<style>
  .nar-field {
    position: fixed;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .narrator {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 40;
    display: block;
    overflow: hidden;
    width: var(--narrator-w);
    height: var(--narrator-h);
    padding: 0 0.875rem;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface) 82%, transparent);
    backdrop-filter: blur(12px);
    color: var(--ink-2);
    cursor: pointer;
    will-change: transform, opacity;
    transition:
      width var(--beat) var(--ease),
      color var(--dur-micro) var(--ease),
      border-color var(--dur-micro) var(--ease);
  }

  .narrator.is-captioned {
    width: var(--narrator-w-open);
  }

  .narrator[hidden] {
    display: none;
  }

  .narrator:hover,
  .narrator.is-playing {
    color: var(--ink);
    border-color: var(--ink-3);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .nar-live,
  .narrator.is-playing .nar-idle {
    display: none;
  }

  .narrator.is-playing .nar-live {
    display: inline;
  }

  /* The wave: bars drawn by the controller in the pill's ink. It keeps
     the closed pill's box and its leading edge when the pill opens, so
     the bars never resize or jump — the pill grows away from them. */
  .nar-wave {
    position: absolute;
    top: 0;
    left: 1.125rem;
    width: calc(var(--narrator-w) - 2.25rem);
    height: 100%;
  }

  /* The subtitle: the line being said, beside the bars. Two lines at
     most; it fades in only once the pill has opened around it. */
  .nar-sub {
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(var(--narrator-w) - 0.5rem);
    right: 1.375rem;
    display: flex;
    align-items: center;
    font-size: 0.8125rem;
    line-height: 1.3;
    text-align: left;
    color: var(--ink);
    opacity: 0;
    transition: opacity var(--dur-micro) var(--ease);
  }

  .narrator.is-captioned .nar-sub {
    opacity: 1;
    transition-delay: calc(var(--beat) / 2);
  }

  .nar-sub :global(.nar-sub-line) {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    animation: nar-sub-in calc(var(--beat) / 2) var(--ease);
  }

  @keyframes nar-sub-in {
    from {
      opacity: 0;
    }
  }
</style>
