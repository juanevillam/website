---
import T from './T.astro';

/**
 * THE narrator — one control for the whole page, drawn once. It never
 * lives in a scene: it floats, and the page's render loop glides it
 * between the anchors each narrated block reserves (under the hero's
 * wordmark, under the opener's store row, under each slide's caption),
 * the way the lockup travels. One voice, so one control.
 *
 * It is only play and pause — a floating pill built by the header's own
 * recipe at twice its area, so it outranks the chrome it shares a
 * family with. The voice itself is
 * drawn once, in the field along the foot of the screen: three hairline
 * sound waves, each stretch answering its own band of Juan's actual
 * voice, flat in silence. Drawing it in the control as well only made
 * the two compete.
 *
 * IT NEVER CHANGES SIZE, and carries no subtitles (Juan, 2026-10-17). It
 * used to open wider and run what Juan was saying beside the glyph, which
 * repeated the paragraph on screen; now the paragraph reads itself (the
 * read-along in scripts/director.ts), and a clip with no paragraph — the
 * hero's intro, the footer's — is simply heard.
 */
---

<!-- The field the voice moves — behind every section, above only
     the page's own ground (z -1, painted over the body's background). -->
<canvas class="nar-field" aria-hidden="true"></canvas>

<button
  class="narrator"
  type="button"
  data-narrator
  hidden
>
  <span class="sr-only nar-idle"><T k="listen" /></span>
  <span class="sr-only nar-live"><T k="pause" /></span>
  <span class="nar-glyph" aria-hidden="true">
    <svg class="nar-play" viewBox="0 0 16 16">
      <path fill="currentColor" d="M3.5 2.6v10.8c0 .6.7 1 1.2.7l8.4-5.4a.8.8 0 0 0 0-1.4L4.7 1.9c-.5-.3-1.2.1-1.2.7z"></path>
    </svg>
    <svg class="nar-pause" viewBox="0 0 16 16">
      <rect fill="currentColor" x="3.5" y="2.5" width="3" height="11" rx="1"></rect>
      <rect fill="currentColor" x="9.5" y="2.5" width="3" height="11" rx="1"></rect>
    </svg>
  </span>
</button>

<div
  class="nar-video is-dismissed"
  data-narr-video
  hidden
>
  <video
    class="nar-video-media is-active"
    data-narr-video-layer="0"
    muted
    playsinline
    preload="none"
  ></video>
  <video
    class="nar-video-media"
    data-narr-video-layer="1"
    muted
    playsinline
    preload="none"
  ></video>
  <span class="nar-morph-glyph" aria-hidden="true">
    <svg viewBox="0 0 16 16">
      <path fill="currentColor" d="M3.5 2.6v10.8c0 .6.7 1 1.2.7l8.4-5.4a.8.8 0 0 0 0-1.4L4.7 1.9c-.5-.3-1.2.1-1.2.7z"></path>
    </svg>
  </span>
  <button
    class="nar-video-close"
    type="button"
    data-narr-video-close
    aria-label="Close video"
  >
    <svg viewBox="0 0 16 16" aria-hidden="true">
      <path
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        d="M4.5 4.5l7 7M11.5 4.5l-7 7"
      ></path>
    </svg>
  </button>
  <div class="nar-video-rates" role="group" aria-label="Playback speed">
    <button
      type="button"
      class="nar-rate is-active"
      data-narr-rate="1"
      aria-pressed="true"
    >
      1×
    </button>
    <button
      type="button"
      class="nar-rate"
      data-narr-rate="1.5"
      aria-pressed="false"
    >
      1.5×
    </button>
    <button
      type="button"
      class="nar-rate"
      data-narr-rate="2"
      aria-pressed="false"
    >
      2×
    </button>
  </div>
</div>

<style>
  .nar-field {
    position: fixed;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .narrator {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 40;
    display: block;
    overflow: hidden;
    width: var(--narrator-w);
    height: var(--narrator-h);
    padding: 0;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface) 82%, transparent);
    backdrop-filter: blur(12px);
    color: var(--ink-2);
    cursor: pointer;
    will-change: transform, opacity;
    transition:
      opacity 60ms linear 170ms,
      color var(--hover),
      border-color var(--hover);
  }

  :global(html.has-narr-video) .narrator {
    opacity: 0 !important;
    pointer-events: none !important;
    transition: opacity 40ms linear 0ms;
  }

  .narrator[hidden] {
    display: none;
  }

  .narrator:hover,
  .narrator.is-playing {
    color: var(--ink);
    border-color: var(--ink-3);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .nar-live,
  .narrator.is-playing .nar-idle {
    display: none;
  }

  .narrator.is-playing .nar-live {
    display: inline;
  }

  /* Centred in the circle. The box is the button's INSIDE — its width
     less the 1px border on each side; the full width stood every glyph
     1px right of centre (Juan, 2026-10-13). */
  .nar-glyph {
    position: absolute;
    top: 0;
    left: 0;
    display: grid;
    place-items: center;
    width: calc(var(--narrator-w) - 2px);
    height: 100%;
  }

  /* The play triangle sits between its box's centre and its balance
     point: box-centred it reads left, balance-centred it read right
     (2026-10-13), so the path is drawn 0.4 of 16 left of the latter. */
  .nar-glyph svg {
    grid-area: 1 / 1;
    /* A play glyph's ink fills its box far more than the header mark's
       strokes fill theirs, so at the same box it read heavy — it takes
       60% of the narrator's glyph box. */
    width: calc(var(--narrator-glyph) * 0.6);
    height: calc(var(--narrator-glyph) * 0.6);
  }

  .nar-pause,
  .narrator.is-playing .nar-play {
    visibility: hidden;
  }

  .narrator.is-playing .nar-pause {
    visibility: visible;
  }

  /* Vertical 9:16 video companion that travels alongside the narrator button.
     Uses a compact rem corner token (`--nar-video-r`) proportional to its
     small frame (matching the Songs player's tighter web borders rather than
     an iOS screen bezel, and invariant under browser zoom) plus the site's
     two-layer shadow. */
  .nar-video {
    --morph-ease: cubic-bezier(0.22, 1, 0.36, 1);
    --morph-dur: 240ms;
    --nar-video-r: 0.75rem;
    position: fixed;
    top: 0;
    left: 0;
    z-index: 40;
    width: var(--nar-video-w, 7.25rem);
    height: var(--nar-video-h, 12.89rem);
    border: 1px solid var(--hairline);
    border-radius: var(--nar-video-r);
    background: color-mix(in srgb, var(--surface) 82%, transparent);
    backdrop-filter: blur(12px);
    box-shadow:
      0 2rem 4rem rgba(0, 0, 0, 0.55),
      0 0.5rem 1.25rem rgba(0, 0, 0, 0.4);
    overflow: hidden;
    cursor: pointer;
    translate: 0px 0px;
    opacity: var(--narr-own, 1);
    will-change: transform, opacity;
    transition:
      translate var(--morph-dur) var(--morph-ease),
      width var(--morph-dur) var(--morph-ease),
      height var(--morph-dur) var(--morph-ease),
      border-radius var(--morph-dur) var(--morph-ease),
      box-shadow var(--morph-dur) var(--morph-ease),
      opacity 35ms linear 0ms,
      border-color var(--hover);
  }

  :global(html.is-desk-safari) .nar-video {
    -webkit-backdrop-filter: none !important;
    backdrop-filter: none !important;
    background: color-mix(in srgb, var(--surface) 95%, transparent) !important;
  }

  .nar-video[hidden] {
    display: none;
  }

  .nar-video.is-dismissed {
    width: var(--narrator-w);
    height: var(--narrator-h);
    border-radius: calc(var(--narrator-h) / 2);
    box-shadow: none;
    translate: var(--morph-dx, 0px) var(--morph-dy, 0px);
    opacity: 0;
    pointer-events: none !important;
    transition:
      translate var(--morph-dur) var(--morph-ease),
      width var(--morph-dur) var(--morph-ease),
      height var(--morph-dur) var(--morph-ease),
      border-radius var(--morph-dur) var(--morph-ease),
      box-shadow var(--morph-dur) var(--morph-ease),
      opacity 55ms linear 185ms;
  }

  .nar-video:hover,
  .nar-video.is-playing {
    border-color: var(--ink-3);
  }

  @media (max-width: 48rem) {
    .nar-video {
      --nar-video-w: 6rem;
      --nar-video-h: 10.67rem;
      --nar-video-r: 0.625rem;
    }
  }

  .nar-video-media {
    position: absolute;
    top: 50%;
    left: 50%;
    width: var(--nar-video-w, 7.25rem);
    height: var(--nar-video-h, 12.89rem);
    translate: -50% -50%;
    object-fit: cover;
    display: block;
    pointer-events: none;
    opacity: 0;
    transition: opacity 160ms linear;
  }

  .nar-video-media.is-active {
    opacity: 1;
  }

  .nar-video.is-dismissed .nar-video-media.is-active {
    opacity: 0;
    transition: opacity 150ms linear;
  }

  .nar-morph-glyph {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: grid;
    place-items: center;
    color: var(--ink-2);
    pointer-events: none;
    opacity: 0;
    scale: 0.75;
    transition:
      opacity 90ms linear,
      scale 180ms var(--morph-ease);
  }

  .nar-morph-glyph svg {
    width: calc(var(--narrator-glyph) * 0.6);
    height: calc(var(--narrator-glyph) * 0.6);
  }

  .nar-video.is-dismissed .nar-morph-glyph {
    opacity: 1;
    scale: 1;
    transition:
      opacity 130ms linear 45ms,
      scale 220ms var(--morph-ease);
  }

  /* Hidden by default; fades and floats in smoothly on hover (or on touch
     where there is no hover). Uses `--hover` (gentle cubic-bezier(0.25, 0.1,
     0.25, 1)) for opacity so the fade is visibly smooth rather than snapping
     in the first frames of `--ease`. Pointer-events remain active while the
     video is open so Safari never drops a click on × or 2×. */
  .nar-video-close {
    position: absolute;
    top: 0.375rem;
    right: 0.375rem;
    z-index: 3;
    width: 1.4rem;
    height: 1.4rem;
    padding: 0;
    border: 1px solid color-mix(in srgb, var(--hairline) 85%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--ground) 72%, transparent);
    backdrop-filter: blur(8px);
    color: var(--ink-2);
    display: grid;
    place-items: center;
    cursor: pointer;
    opacity: 0;
    translate: 0 -0.2rem;
    scale: 0.92;
    pointer-events: auto;
    transition:
      opacity var(--hover),
      translate var(--dur-quick) var(--ease),
      scale var(--dur-quick) var(--ease),
      color var(--hover),
      background-color var(--hover),
      border-color var(--hover);
  }

  .nar-video-close::before {
    content: '';
    position: absolute;
    inset: -0.35rem;
    border-radius: 999px;
  }

  .nar-video:hover .nar-video-close,
  .nar-video:focus-within .nar-video-close {
    opacity: 0.88;
    translate: 0 0;
    scale: 1;
  }

  .nar-video:hover .nar-video-close:hover,
  .nar-video-close:focus-visible {
    opacity: 1;
    scale: 1.06;
    color: var(--ink);
    border-color: var(--ink-3);
    background: color-mix(in srgb, var(--ground) 88%, transparent);
  }

  .nar-video:hover .nar-video-close:active {
    scale: 0.94;
  }

  .nar-video-close svg {
    width: 0.65rem;
    height: 0.65rem;
    pointer-events: none;
  }

  /* Speed switcher (1x / 1.5x / 2x with preservePitch), shown on hover. */
  .nar-video-rates {
    position: absolute;
    left: 50%;
    bottom: 0.4rem;
    z-index: 3;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    align-items: center;
    gap: 0.1rem;
    padding: 0.125rem;
    border: 1px solid color-mix(in srgb, var(--hairline) 85%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--ground) 74%, transparent);
    backdrop-filter: blur(8px);
    opacity: 0;
    translate: -50% 0.25rem;
    scale: 0.94;
    pointer-events: auto;
    transition:
      opacity var(--hover),
      translate var(--dur-quick) var(--ease),
      scale var(--dur-quick) var(--ease),
      border-color var(--hover),
      background-color var(--hover);
  }

  .nar-video:hover .nar-video-rates,
  .nar-video:focus-within .nar-video-rates {
    opacity: 1;
    translate: -50% 0;
    scale: 1;
  }

  .nar-video-rates:hover {
    border-color: var(--ink-3);
  }

  @media (hover: none) {
    .nar-video-close {
      opacity: 0.9;
      translate: 0 0;
      scale: 1;
    }

    .nar-video-rates {
      opacity: 1;
      translate: -50% 0;
      scale: 1;
    }
  }

  .nar-video.is-dismissed .nar-video-close {
    opacity: 0;
    translate: 0 -0.2rem;
    scale: 0.9;
    pointer-events: none !important;
    transition:
      opacity 90ms linear,
      translate 140ms var(--ease),
      scale 140ms var(--ease);
  }

  .nar-video.is-dismissed .nar-video-rates {
    opacity: 0;
    translate: -50% 0.25rem;
    scale: 0.92;
    pointer-events: none !important;
    transition:
      opacity 90ms linear,
      translate 140ms var(--ease),
      scale 140ms var(--ease);
  }

  :global(html.is-desk-safari) .nar-video-close,
  :global(html.is-desk-safari) .nar-video-rates {
    -webkit-backdrop-filter: none !important;
    backdrop-filter: none !important;
    background: color-mix(in srgb, var(--ground) 88%, transparent) !important;
  }

  .nar-rate {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.85rem;
    height: 1.2rem;
    padding: 0;
    border: none;
    border-radius: 999px;
    background: transparent;
    color: var(--ink-3);
    font: inherit;
    font-size: 0.64rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.015em;
    line-height: 1;
    white-space: nowrap;
    cursor: pointer;
    scale: 1;
    transition:
      color var(--hover),
      background-color var(--hover),
      box-shadow var(--hover),
      scale var(--dur-micro) var(--ease);
  }

  @media (max-width: 48rem) {
    .nar-video-rates {
      gap: 0.08rem;
      padding: 0.1rem;
    }

    .nar-rate {
      width: 1.6rem;
      height: 1.12rem;
      font-size: 0.58rem;
    }
  }

  .nar-rate:hover {
    color: var(--ink);
    background: color-mix(in srgb, var(--ink) 9%, transparent);
  }

  .nar-rate:active {
    scale: 0.93;
  }

  .nar-rate.is-active {
    background: color-mix(in srgb, var(--ink) 22%, transparent);
    color: var(--ink);
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.35);
  }
</style>

<script>
  // The session and the page's motion (see the file's header).
  import '../scripts/director';
</script>
