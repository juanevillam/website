---
import T from './T.astro';
import { LEGAL_APPS } from '../lib/legal';
import { LIKES } from '../lib/likes';
import type { UIKey } from '../i18n/ui';
import { captionAttrs, clipFor, voiceAttrs } from '../lib/narration';
import { NAME_SCENE } from '../lib/scene';

/**
 * The page's foot: each app's legal and help pages, and where to find
 * Juan elsewhere. The stores ask for these URLs in their own consoles, and
 * the apps link to them from Settings — this is where a PERSON finds them
 * on the site. They used to sit in each story's opener; they moved here so
 * the openers keep their room for the narrator. The game has none: it is
 * not an app with accounts.
 */
const PAGES: { key: UIKey; page: string }[] = [
  { key: 'legal.terms', page: 'terms-and-conditions' },
  { key: 'legal.privacy', page: 'privacy-policy' },
  { key: 'legal.support', page: 'support' },
  { key: 'legal.delete', page: 'delete-account' },
];

type Props = {
  /** The landing's last panel: snapped like every section above it, and
   *  narrated. Everywhere else the foot is the SAME composition — the
   *  name, the profiles, the apps' pages, the name's light — so a
   *  document page closes the way the landing does (Juan, 2026-10-16:
   *  its old short strip stacked two columns flush against each other
   *  under a measure-wide article and read as a different site). */
  panel?: boolean;
};

const { panel = false } = Astro.props;

// The landing's goodbye: like the hero's hello, the wordmark carries a
// clip with no paragraph on screen (`footer.m4a`, see lib/narration), and
// the narrator parks under it — the page opens and closes on the same
// name, the same voice, the same place.
const clip = panel ? clipFor('footer') : null;

// Public profiles only. The apps' code is private, but the GitHub profile
// is public and is where the game and the profile README live.
const SOCIAL = [
  { name: 'GitHub', href: 'https://github.com/juanevillam' },
  { name: 'LinkedIn', href: 'https://www.linkedin.com/in/juanevillam' },
  { name: 'Instagram', href: 'https://www.instagram.com/juanevillam' },
];
---

<footer
  class:list={['site-footer', { 'is-snap': panel }]}
  data-scene={NAME_SCENE}
  data-scene-kind="name"
  data-narr-panel={clip ? '' : null}
>
  <div class="inner">
    {/* The foot takes a section's composition: the name and where to find
        Juan in the words' column, the apps' pages where a section puts its
        screen. */}
    <div class="lead" data-scene-at="0.2">
      <h2 class="title">juanevillam</h2>
      <ul class="social">
        {SOCIAL.map(({ name, href }) => (
          <li>
            <a href={href} target="_blank" rel="noopener noreferrer">
              {name}
            </a>
          </li>
        ))}
      </ul>
      {clip && (
        <>
          <span
            hidden
            data-narr-para
            {...voiceAttrs('footer')}
          />
          <div class="narr-anchor" data-narr-anchor aria-hidden="true" />
          <p class="narr-caption" data-narr-caption {...captionAttrs('footer', 'footer.caption')}>
            <T k="footer.caption" />
          </p>
        </>
      )}
    </div>
    <nav class="columns" aria-label="Footer">
      {
        // ONE app (Sound Shaper alone, 2026-10-16): its pages stand open as
        // a plain column, the way the profiles' links do — there is nothing
        // to choose between, so a row to open was a tap for nothing.
        LEGAL_APPS.length === 1 &&
          LEGAL_APPS.map(app => (
            <div class="column app-links">
              <span class="label">{app.name}</span>
              <ul>
                {PAGES.map(({ key, page }) => (
                  <li>
                    <a href={`/${app.slug}/${page}`}>
                      <T k={key} />
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
      }
      {
        LEGAL_APPS.length > 1 &&
        LEGAL_APPS.map(app => (
          // A native disclosure: each app is one row that opens to its
          // pages, one at a time (the script).
          <details class="column app-pages">
            <summary class="label">
              {app.name}
              <svg
                class="chevron"
                viewBox="0 0 12 12"
                width="10"
                height="10"
                aria-hidden="true"
              >
                <path
                  d="M2.5 4.5 L6 8 L9.5 4.5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </summary>
            <ul>
              {PAGES.map(({ key, page }) => (
                <li>
                  <a href={`/${app.slug}/${page}`}>
                    <T k={key} />
                  </a>
                </li>
              ))}
            </ul>
          </details>
        ))
      }
      {/* Juan outside of work: one page per set (pages/things-i-like),
          a column like an app's pages, so the landing never loads their
          pictures. */}
      <div class="column app-links">
        <span class="label"><T k="likes.title" /></span>
        <ul>
          {LIKES.map(card => (
            <li>
              <a href={`/things-i-like/${card.slug}`}>
                {typeof card.name === 'string' ? card.name : <T k={card.name.k} />}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </nav>

    <p class="label legal-name">© 2026 Juan Esteban Villa Mendoza</p>
  </div>
</footer>

<script>
  // ONE app open at a time, on every screen (Juan, 2026-10-13): three
  // open rows stacked read as a mess on a phone, and a desk's column per
  // app would not hold five. Opening one closes the rest. A script rather
  // than the native `name` grouping, which some browsers still lack.
  const rows = [...document.querySelectorAll<HTMLDetailsElement>('.app-pages')];
  const closeOthers = (row: HTMLDetailsElement) =>
    rows.forEach(other => {
      if (other !== row) other.open = false;
    });
  // On the CLICK, in the same task as the opening — the `toggle` event
  // comes a task later, so for one frame two apps stood open, the block
  // outgrew its reserve and jumped back: a flicker in Chrome (2026-10-13).
  rows.forEach(row => {
    row.querySelector('summary')?.addEventListener('click', () => {
      if (!row.open) closeOthers(row);
    });
    row.addEventListener('toggle', () => {
      if (row.open) closeOthers(row);
    });
  });

  // NOTHING MOVES WHEN ONE OPENS (Juan, 2026-10-13): the rows' block is
  // as tall as it will ever be — every row closed, plus the tallest app's
  // pages — so opening or closing one reflows nothing around it. Measured,
  // not guessed: a font or a breakpoint changes it.
  const reserve = () => {
    for (const block of document.querySelectorAll<HTMLElement>('.site-footer .columns')) {
      const own = [...block.querySelectorAll<HTMLDetailsElement>('.app-pages')];
      const was = own.map(r => r.open);
      block.style.minHeight = '';
      own.forEach(r => (r.open = false));
      const closed = block.offsetHeight;
      let tallest = 0;
      for (const r of own) {
        r.open = true;
        tallest = Math.max(tallest, r.querySelector('ul')?.offsetHeight ?? 0);
        r.open = false;
      }
      own.forEach((r, i) => (r.open = was[i]));
      block.style.minHeight = `${closed + tallest}px`;
    }
  };
  reserve();
  document.fonts?.ready.then(reserve);
  addEventListener('resize', reserve);
</script>

<style>
  /* A panel like every section: the stories' own inset at the top, the
     copyright at the foot of the screen, no rule — a panel is set off by
     being a panel. Only the landing's snaps (`is-snap`). */
  .site-footer {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    padding: var(--stage-top) clamp(1.25rem, 4vw, 2.5rem) var(--stage-bottom);
  }

  .site-footer.is-snap {
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  .inner {
    max-width: var(--content-max);
    margin: 0 auto;
  }

  /* The section grid: words column | the rest, the copyright across the
     foot. The first row starts a 2rem eyebrow box plus a 1.5rem step
     down — exactly where every section's title line is. */
  .site-footer .inner {
    flex: 1;
    width: 100%;
    display: grid;
    grid-template-columns: var(--screen-cols);
    grid-template-rows: auto 1fr auto;
    grid-template-areas:
      'lead columns'
      '. .'
      'name name';
    column-gap: var(--space-4);
    padding-top: 3.5rem;
  }

  /* The name and its links, beside the apps' rows. The links follow the
     name rather than sitting at the column's foot: the rows beside them
     open and close, and the profiles must not move with them. */
  /* Its own height, not the row's: stretched to the rows beside it, the
     narrator hung from its foot moved as an app opened (2026-10-13). */
  .lead {
    grid-area: lead;
    align-self: start;
    display: flex;
    flex-direction: column;
  }

  .site-footer .columns {
    grid-area: columns;
    align-content: start;
    /* The first row's hairline sits on the title's cap height. */
    padding-top: 0.5rem;
  }

  .site-footer .legal-name {
    grid-area: name;
    margin-top: 0;
    padding-top: var(--space-4);
  }

  /* Same size and pitch as the legal links, so the rows line up — set
     apart by ink alone: full ink where the legal links are muted. The
     underline is the hover, as on every link here. */
  .social {
    padding-top: 1.25rem;
  }

  .social a {
    color: var(--ink);
  }

  /* The narrator closes the name's block, one step under Instagram,
     without taking a row of the column: the profiles stay level with the
     apps' last three links. (Under the name itself, as the hero
     has it, it stood on LinkedIn.) */
  .lead {
    position: relative;
  }

  .lead .narr-anchor {
    position: absolute;
    top: 100%;
  }

  /* The goodbye's words stand under the narrator, out of the flow. */
  .lead .narr-caption {
    left: 0;
    top: calc(100% + var(--narrator-h) + 2.5rem);
  }

  /* A phone's narrator stays in its corner; the anchor takes no room. */
  @media (max-width: 48rem) {
    .lead .narr-anchor {
      display: none;
    }

    .lead .narr-caption {
      top: calc(100% + 1.5rem);
    }
  }

  @media (max-width: 48rem) {
    .site-footer .inner {
      grid-template-columns: 1fr;
      /* Hierarchy on a phone: who (name, links) at the top; the apps'
         pages down at the foot with the copyright — reference, not the
         first thing read. */
      grid-template-rows: auto 1fr auto auto;
      grid-template-areas:
        'lead'
        '.'
        'columns'
        'name';
      padding-top: 2.75rem;
    }

    /* The rows sit at the FOOT of their reserved block, on the copyright
       — not under the links, floating mid-panel — so an app opening grows
       the rows UP into the room kept for it (Juan, 2026-10-13). */
    .site-footer .columns {
      align-content: end;
      margin-top: var(--gap-block);
      padding-top: 0;
    }

    .site-footer .legal-name {
      padding-top: 1.5rem;
    }

    /* Stacked, the name needs its own air above the links. */
    .social {
      padding-top: 2rem;
    }
  }

  /* Sound Shaper's pages, then More of Me, side by side. */
  .columns {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: max-content;
    column-gap: var(--space-4);
  }

  ul {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 0.875rem;
    padding: 0;
    list-style: none;
  }

  a {
    font-size: 0.875rem;
    color: var(--ink-2);
    text-decoration-color: transparent;
    transition:
      color var(--dur-micro) var(--ease),
      text-decoration-color var(--dur-micro) var(--ease);
  }

  a:hover {
    color: var(--ink);
    text-decoration-color: var(--ink-3);
  }

  .legal-name {
    margin-top: var(--space-4);
    text-transform: none;
    letter-spacing: 0;
  }

  /* ---------- the apps' pages: an accordion, on every screen ----------
     Each app is a row under a hairline that opens to its four pages, one
     app at a time (the script). It was a column per app on a desk until
     2026-10-13 — fine for three, not for the five there may be. */
  .app-pages {
    border-bottom: 1px solid var(--hairline);
  }

  .app-pages:first-child {
    border-top: 1px solid var(--hairline);
  }

  summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 3rem;
    cursor: pointer;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .chevron {
    flex: none;
    transition: transform var(--dur-micro) var(--ease);
  }

  .app-pages[open] .chevron {
    transform: rotate(180deg);
  }

  /* An app's four pages one under another, on every screen. */
  .app-pages ul {
    margin-top: 0;
    padding-bottom: 1rem;
  }
</style>
