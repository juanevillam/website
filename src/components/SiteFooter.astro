---
import T from './T.astro';
import { FOOTER_APPS } from '../lib/legal';
import { LIKES } from '../lib/likes';
import { likesShown } from '../lib/release';
import type { UIKey } from '../i18n/ui';
import { captionAttrs, clipFor, voiceAttrs } from '../lib/narration';
import { NAME_SCENE } from '../lib/scene';
import ShipEgg from './ShipEgg.astro';

/**
 * The page's foot: Sound Shaper's legal and help pages, More of Me, and
 * where to find Juan elsewhere. The stores ask for these URLs in their own
 * consoles, and the apps link to them from Settings — this is where a PERSON
 * finds them on the site.
 */
const PAGES: { key: UIKey; page: string }[] = [
  { key: 'legal.terms', page: 'terms-and-conditions' },
  { key: 'legal.privacy', page: 'privacy-policy' },
  { key: 'legal.support', page: 'support' },
  { key: 'legal.delete', page: 'delete-account' },
];

type Props = {
  /** The landing's last panel: snapped like every section above it, and
   *  narrated. Everywhere else the foot is the SAME composition — the
   *  name, the profiles, the apps' pages, the name's light — so a
   *  document page closes the way the landing does (Juan, 2026-10-16:
   *  its old short strip stacked two columns flush against each other
   *  under a measure-wide article and read as a different site). */
  panel?: boolean;
};

const { panel = false } = Astro.props;

// The landing's goodbye: like the hero's hello, the wordmark carries a
// clip with no paragraph on screen (`footer.m4a`, see lib/narration), and
// the narrator parks under it — the page opens and closes on the same
// name, the same voice, the same place.
const clip = panel ? clipFor('footer') : null;

// Public profiles only. The apps' code is private, but the GitHub profile
// is public and is where the game and the profile README live.
const SOCIAL = [
  { name: 'GitHub', href: 'https://github.com/juanevillam' },
  { name: 'LinkedIn', href: 'https://www.linkedin.com/in/juanevillam' },
  { name: 'Instagram', href: 'https://www.instagram.com/juanevillam' },
];
---

<footer
  class:list={['site-footer', { 'is-snap': panel }]}
  data-scene={NAME_SCENE}
  data-scene-kind="name"
  data-narr-panel={clip ? '' : null}
>
  <div class="inner">
    {/* The foot takes a section's composition: the name and where to find
        Juan in the words' column, More of Me where a section puts its
        screen. */}
    <div class="lead" data-scene-at="0.2">
      <h2 class="title"><a href="/" class="footer-home-link">juanevillam</a></h2>
      <ul class="social">
        <li>
          <a href="/privacy-policy"><T k="legal.privacy" /></a>
        </li>
        <li>
          <a href="/terms-and-conditions"><T k="legal.terms" /></a>
        </li>
      </ul>
      {clip && (
        <>
          <span
            hidden
            data-narr-para
            {...voiceAttrs('footer')}
          />
          <div class="narr-anchor" data-narr-anchor aria-hidden="true" />
          <p class="narr-caption" data-narr-caption {...captionAttrs('footer', 'footer.caption')}>
            <T k="footer.caption" />
          </p>
        </>
      )}
    </div>
    <nav class="columns" aria-label="Footer">
      {/* Standardized vertical accordion stack (desktop + mobile): More of Me
          first, followed by Sound Shaper's legal/support pages. Reserves exact
          height for all closed rows + tallest open drawer so nothing shifts. */}
      <div class="column apps-group">
        <div class="app-pages" data-app-accordion>
          <button
            type="button"
            class="label app-toggle"
            aria-expanded="false"
            data-app-toggle
          >
            <span><T k="footer.social" /></span>
            <svg
              class="chevron"
              viewBox="0 0 12 12"
              width="10"
              height="10"
              aria-hidden="true"
            >
              <path
                d="M2.5 4.5 L6 8 L9.5 4.5"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </button>
          <div class="app-drawer" aria-hidden="true" inert>
            <div class="app-drawer-inner">
              <ul>
                {SOCIAL.map(({ name, href }) => (
                  <li>
                    <a href={href} target="_blank" rel="noopener noreferrer">
                      {name}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
        {
          likesShown && (
            <div class="app-pages" data-app-accordion>
              <button
                type="button"
                class="label app-toggle"
                aria-expanded="false"
                data-app-toggle
              >
                <span>
                  <T k="likes.title" />
                </span>
                <svg
                  class="chevron"
                  viewBox="0 0 12 12"
                  width="10"
                  height="10"
                  aria-hidden="true"
                >
                  <path
                    d="M2.5 4.5 L6 8 L9.5 4.5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </button>
              <div class="app-drawer" aria-hidden="true" inert>
                <div class="app-drawer-inner">
                  <ul>
                    {LIKES.map(card => (
                      <li>
                        <a href={`/more-of-me/${card.slug}`}>
                          {typeof card.name === 'string' ? (
                            card.name
                          ) : (
                            <T k={card.name.k} />
                          )}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          )
        }
        {
          FOOTER_APPS.map(app => (
            <div class="app-pages" data-app-accordion>
              <button
                type="button"
                class="label app-toggle"
                aria-expanded="false"
                data-app-toggle
              >
                <span>{app.name}</span>
                <svg
                  class="chevron"
                  viewBox="0 0 12 12"
                  width="10"
                  height="10"
                  aria-hidden="true"
                >
                  <path
                    d="M2.5 4.5 L6 8 L9.5 4.5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </button>
              <div class="app-drawer" aria-hidden="true" inert>
                <div class="app-drawer-inner">
                  <ul>
                    {PAGES.map(({ key, page }) => (
                      <li>
                        <a href={`/${app.slug}/${page}`}>
                          <T k={key} />
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </nav>

    <p class="label legal-name">© 2026 Juan Villa</p>
  </div>
  {/* Space Explorer's ship takes on the destroyer, now and then, behind
      the foot's words. */}
  {panel && <ShipEgg place="foot" />}
</footer>

<script>
  const groups = document.querySelectorAll<HTMLElement>('.site-footer .apps-group');
  for (const group of groups) {
    const items = [...group.querySelectorAll<HTMLElement>('[data-app-accordion]')];
    const setOpen = (target: HTMLElement, open: boolean) => {
      target.classList.toggle('is-open', open);
      const btn = target.querySelector<HTMLButtonElement>('[data-app-toggle]');
      const drawer = target.querySelector<HTMLElement>('.app-drawer');
      if (btn) btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      if (drawer) {
        drawer.setAttribute('aria-hidden', open ? 'false' : 'true');
        drawer.toggleAttribute('inert', !open);
      }
    };

    items.forEach(item => {
      const btn = item.querySelector<HTMLButtonElement>('[data-app-toggle]');
      btn?.addEventListener('click', () => {
        const nextOpen = !item.classList.contains('is-open');
        items.forEach(other => {
          if (other !== item) setOpen(other, false);
        });
        setOpen(item, nextOpen);
      });
    });
  }

  const reserve = () => {
    for (const group of document.querySelectorAll<HTMLElement>('.site-footer .apps-group')) {
      const items = [...group.querySelectorAll<HTMLElement>('[data-app-accordion]')];
      if (items.length === 0) continue;
      let closedH = 0;
      let tallestDrawerH = 0;
      for (const item of items) {
        const btn = item.querySelector<HTMLElement>('[data-app-toggle]');
        const list = item.querySelector<HTMLElement>('.app-drawer ul');
        closedH += (btn?.offsetHeight ?? 42) + 1;
        tallestDrawerH = Math.max(tallestDrawerH, list?.offsetHeight ?? 0);
      }
      group.style.minHeight = `${closedH + tallestDrawerH + 2}px`;
    }
  };
  reserve();
  document.fonts?.ready.then(reserve);
  addEventListener('resize', reserve);
</script>

<style>
  /* A panel like every section: the stories' own inset at the top, the
     copyright at the foot of the screen, no rule — a panel is set off by
     being a panel. Only the landing's snaps (`is-snap`). */
  .site-footer {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    padding: var(--stage-top) clamp(1.25rem, 4vw, 2.5rem) var(--stage-bottom);
  }

  .site-footer.is-snap {
    scroll-snap-align: start;
    scroll-snap-stop: always;
    /* The ship's scene is placed in the foot (ShipEgg). */
    position: relative;
  }

  .inner {
    max-width: var(--content-max);
    margin: 0 auto;
  }

  /* The section grid: words column | the rest, the copyright across the
     foot. The first row starts a 2rem eyebrow box plus a 1.5rem step
     down — exactly where every section's title line is. */
  .site-footer .inner {
    flex: 1;
    width: 100%;
    display: grid;
    grid-template-columns: var(--screen-cols);
    grid-template-rows: auto 1fr auto;
    grid-template-areas:
      'lead columns'
      '. .'
      'name name';
    column-gap: var(--space-4);
    padding-top: 0;
  }

  /* The name and its links, beside the apps' rows. The links follow the
     name rather than sitting at the column's foot: the rows beside them
     open and close, and the profiles must not move with them. */
  /* Its own height, not the row's: stretched to the rows beside it, the
     narrator hung from its foot moved as an app opened (2026-10-13). */
  .lead {
    grid-area: lead;
    align-self: start;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .site-footer .columns {
    grid-area: columns;
    align-content: start;
    /* Align the first accordion vertically with the social links column. */
    padding-top: 3.55rem;
  }

  .site-footer .legal-name {
    grid-area: name;
    margin-top: 0;
    padding-top: var(--space-4);
  }

  /* Same size and pitch as the legal links, so the rows line up — set
     apart by ink alone: full ink where the legal links are muted. The
     underline is the hover, as on every link here. */
  .social {
    margin-top: 1.25rem;
    padding-top: 0;
  }

  .social a {
    color: var(--ink);
  }

  .title .footer-home-link {
    font: inherit;
    color: var(--ink);
    text-decoration: none;
    transition: opacity var(--hover);
  }

  .title .footer-home-link:hover {
    color: var(--ink);
    opacity: 0.72;
  }

  /* The narrator closes the name's block, one step under Instagram,
     without taking a row of the column: the profiles stay level with the
     apps' last three links. (Under the name itself, as the hero
     has it, it stood on LinkedIn.) */
  .lead {
    position: relative;
  }

  .lead .narr-anchor {
    position: absolute;
    top: calc(100% + 1.5rem);
    margin-top: 1.5rem;
  }

  /* The goodbye's words stand beside the video/narrator on the right, out
     of the flow, so the video never covers them (Juan, 2026-11-10). */
  .lead .narr-caption {
    left: calc(8.75rem + 1.75rem);
    top: calc(100% + 3rem);
    width: min(32rem, calc(100vw - 14.5rem));
    transition:
      left var(--dur-quick) var(--ease),
      opacity var(--dur-quick) var(--ease);
  }

  :global(html:not(.has-narr-video)) .lead .narr-caption {
    left: calc(var(--narrator-w) + 1.25rem);
  }

  /* A phone's narrator stays in its corner; the anchor takes no room, and
     the read-along caption sits at the foot beside the video/narrator. */
  @media (max-width: 48rem) {
    .site-footer {
      padding-top: clamp(9.25rem, 22svh, 12.5rem);
    }

    .lead .narr-anchor {
      display: none;
    }

    .lead .narr-caption {
      position: fixed;
      top: auto;
      left: clamp(1.25rem, 4vw, 2.5rem);
      bottom: calc(1.25rem + env(safe-area-inset-bottom) + 3.25rem);
      width: calc(100vw - clamp(1.25rem, 4vw, 2.5rem) * 2 - 7rem - 1rem);
      z-index: 5;
    }

    :global(html:not(.has-narr-video)) .lead .narr-caption {
      left: clamp(1.25rem, 4vw, 2.5rem);
      width: calc(
        100vw - clamp(1.25rem, 4vw, 2.5rem) * 2 - var(--narrator-w) - 1rem
      );
    }
  }

  @media (max-width: 48rem) {
    .site-footer .inner {
      grid-template-columns: 1fr;
      grid-template-rows: auto auto 1fr auto;
      grid-template-areas:
        'lead'
        'columns'
        '.'
        'name';
      padding-top: 0;
    }

    /* Accordions sit in the middle below the social links, leaving the lower
       viewport open for the docked video and read-along caption above the
       copyright line. */
    .site-footer .columns {
      align-content: start;
      margin-top: 3.5rem;
      padding-top: 0;
    }

    .site-footer .legal-name {
      padding-top: 1.5rem;
    }

    .social {
      margin-top: 1rem;
      padding-top: 0;
    }
  }

  /* Desktop: More of Me on the left, the apps' accordion column on the right. */
  .columns {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: max-content;
    column-gap: var(--space-9);
    align-items: start;
    translate: 0 0;
    transition:
      opacity var(--dur-settle) var(--ease),
      translate var(--dur-turn) var(--ease);
  }

  /* While the destroyer plays over the foot (ShipEgg) its words step
     back, so the scene is what you look at (Juan, 2026-11-03). */
  .site-footer.is-show .columns {
    opacity: 0.2;
  }

  ul {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    margin-top: 0.875rem;
    padding: 0;
    list-style: none;
  }

  a {
    font-size: 0.875rem;
    color: var(--ink-2);
    text-decoration-color: transparent;
    transition:
      color var(--hover),
      text-decoration-color var(--hover);
  }

  a:hover {
    color: var(--ink);
    text-decoration-color: var(--ink-3);
  }

  .legal-name {
    margin-top: var(--space-4);
    text-transform: none;
    letter-spacing: 0;
  }

  /* Single column of app legal disclosures (to the right of More of Me on
     desktop, below More of Me on mobile). Reserves the exact height of all
     rows closed + 1 open drawer (15rem) so opening/closing an app never
     causes CLS in the footer or copyright line. */
  .apps-group {
    display: flex;
    flex-direction: column;
    width: 14rem;
    min-height: 15rem;
  }

  .app-pages {
    border-bottom: 1px solid var(--hairline);
  }

  .app-pages:first-child {
    border-top: 1px solid var(--hairline);
  }

  .app-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    min-height: 2.625rem;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    user-select: none;
    text-align: start;
    transition: color var(--hover);
  }

  .app-toggle:hover,
  .app-pages.is-open .app-toggle {
    color: var(--ink);
  }

  .chevron {
    flex: none;
    transition: transform var(--dur-quick) var(--ease);
  }

  .app-pages.is-open .chevron {
    transform: rotate(180deg);
  }

  .app-drawer {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows var(--dur-quick) var(--ease),
      opacity var(--dur-micro) var(--ease);
  }

  .app-pages.is-open .app-drawer {
    grid-template-rows: 1fr;
    opacity: 1;
    transition:
      grid-template-rows var(--dur-turn) var(--ease),
      opacity var(--dur-quick) var(--ease);
  }

  .app-drawer-inner {
    overflow: hidden;
  }

  .app-drawer ul {
    margin-top: 0;
    padding-top: 0.25rem;
    padding-bottom: 0.875rem;
  }

  @media (max-width: 48rem) {
    .columns {
      grid-auto-flow: row;
      grid-auto-columns: 1fr;
      row-gap: var(--space-4);
      width: 100%;
    }

    .apps-group {
      width: 100%;
      justify-content: flex-start;
    }
  }

</style>
