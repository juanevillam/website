---
import Base from '../layouts/Base.astro';
import PanelDeck from './PanelDeck.astro';
import PhotoViewer from './PhotoViewer.astro';
import SongsPlayer from './SongsPlayer.astro';
import PhotosFeed from './PhotosFeed.astro';
import NarrationPlayer from './NarrationPlayer.astro';
import SiteFooter from './SiteFooter.astro';
import { LIKES } from '../lib/likes';
import { pictureOf, summary } from '../lib/links';
import { ui } from '../i18n/ui';
import type { DeckItem } from '../lib/deck-items';

/**
 * MORE OF ME — what Juan loves outside of work, on a page of its own
 * (pages/more-of-me), reached from the footer: the landing loads none
 * of its pictures. It is built the way the landing's sections are (Juan,
 * 2026-10-27) — the section's eyebrow, then one panel deck, a card per
 * set (Cosmos, and Songs, whose screen is a player of its
 * own: SongsPlayer), each its words beside its frame —
 * and closes on the same footer.
 */
type Props = {
  /** The card the deck opens on: each card has its own address. */
  card?: DeckItem;
};
const { card } = Astro.props;
const shownCard = card ?? LIKES[0];
const name = (c: DeckItem) => (typeof c.name === 'string' ? c.name : ui.en[c.name.k]);
---

<Base
  title={`${card ? `${name(card)} — ` : ''}${ui.en['likes.title']} — juanevillam`}
  description={summary(shownCard)}
  image={pictureOf(shownCard)}
  path={card ? `/more-of-me/${card.slug}` : '/more-of-me'}
>
  <PanelDeck id="likes" title="likes.title" items={LIKES} share="likes" start={card?.id}>
    {LIKES.some(c => c.id === 'songs') && <SongsPlayer slot="songs" />}
    {LIKES.some(c => c.id === 'photos') && <PhotosFeed slot="photos" />}
  </PanelDeck>
  <SiteFooter panel />
  <NarrationPlayer />
  <PhotoViewer />
</Base>
