---
import T from './T.astro';
import { RELEASES } from '../lib/releases';

/**
 * LAUNCH BANNER — Sound Shaper went live on the App Store (2026-10-30),
 * and Juan wants the site to celebrate it: a bar across the very top of
 * the screen, over the hero, not a floating notice like NarrationSoon.
 *
 * The page is snapped full-height panels, so a bar IN the flow would be
 * snapped out of sight; it is fixed instead, and while it shows it lends
 * its height to `--banner-offset` (html.has-banner, global.css), which
 * pushes the header's pills and the narration notice down under it.
 *
 * Only over the hero: leaving it slides the bar away (and the pills back
 * up); coming back brings it again. Dismissed for good with its ×,
 * remembered (localStorage); without storage, for the visit.
 *
 * Renders nothing until the listing exists (lib/releases). Remove it from
 * Landing once the launch is old news.
 */
const href = RELEASES.shaper['app-store'];
---

{
  href && (
    <aside class="launch" data-launch hidden aria-label="Sound Shaper">
      <a class="launch-link" href={href} target="_blank" rel="noopener">
        <span class="launch-new">
          <T k="launch.new" />
        </span>
        <span class="launch-text">
          <T k="launch.shaper" />
        </span>
        <span class="launch-get">
          <T k="launch.get" />
          <svg viewBox="0 0 12 12" aria-hidden="true">
            <path d="M4.5 2.5 L8 6 L4.5 9.5" />
          </svg>
        </span>
      </a>
      <button type="button" class="launch-close" data-launch-close>
        <span class="sr-only">
          <T k="soon.close" />
        </span>
        <svg viewBox="0 0 16 16" aria-hidden="true">
          <path d="M4 4l8 8M12 4l-8 8" />
        </svg>
      </button>
    </aside>
  )
}

<script>
  const bar = document.querySelector<HTMLElement>('[data-launch]');
  const hero = document.getElementById('top');
  const root = document.documentElement;
  const KEY = 'launch-banner:shaper-ios';
  if (bar && hero) {
    let gone = false;
    try {
      gone = localStorage.getItem(KEY) === '1';
    } catch {}
    // Set at once from where the page opens (a reload mid-page restores
    // its scroll), then kept by the observer below.
    const r = hero.getBoundingClientRect();
    let onHero = r.top > -r.height * 0.4 && r.top < innerHeight * 0.4;
    const update = () => {
      const show = onHero && !gone;
      if (show) {
        bar.hidden = false;
        // One layout with it in place but up, so the slide plays — a
        // reflow rather than a frame, which a background tab never gives.
        void bar.offsetWidth;
        bar.classList.add('is-in');
        root.classList.add('has-banner');
      } else {
        bar.classList.remove('is-in');
        root.classList.remove('has-banner');
        setTimeout(() => {
          if (!bar.classList.contains('is-in')) bar.hidden = true;
        }, 600);
      }
    };
    // The bar belongs to the top of the page: it holds while most of the
    // hero is on screen.
    new IntersectionObserver(
      ([e]) => {
        onHero = e.isIntersecting;
        update();
      },
      { threshold: 0.6 },
    ).observe(hero);
    update();
    bar.querySelector('[data-launch-close]')!.addEventListener('click', () => {
      gone = true;
      try {
        localStorage.setItem(KEY, '1');
      } catch {}
      update();
    });
  }
</script>

<style>
  .launch {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 31;
    display: flex;
    align-items: center;
    justify-content: center;
    height: var(--banner-h);
    padding: 0 3rem;
    border-bottom: 1px solid var(--hairline);
    background: color-mix(in srgb, var(--surface) 92%, transparent);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    translate: 0 -100%;
    transition: translate var(--dur-settle) var(--ease);
  }
  .launch[hidden] {
    display: none;
  }
  .launch.is-in {
    translate: 0 0;
  }
  .launch-link {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-width: 0;
    color: var(--ink-2);
    font-size: 0.8125rem;
    line-height: 1.3;
    text-decoration: none;
  }
  .launch-new {
    flex: none;
    padding: 0.125rem 0.5rem;
    border-radius: 999px;
    background: var(--ink);
    color: var(--ground);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .launch-text {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .launch-get {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--ink);
    font-weight: 600;
  }
  .launch-get svg {
    width: 0.625rem;
    height: 0.625rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: translate var(--dur-quick) var(--ease);
  }
  .launch-link:hover .launch-get svg,
  .launch-link:focus-visible .launch-get svg {
    translate: 0.125rem 0;
  }
  .launch-close {
    position: absolute;
    right: clamp(0.5rem, 2vw, 1.5rem);
    top: 50%;
    translate: 0 -50%;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: none;
    color: var(--ink-3);
    cursor: pointer;
    transition: color var(--dur-quick) var(--ease);
  }
  .launch-close:hover,
  .launch-close:focus-visible {
    color: var(--ink);
  }
  .launch-close svg {
    width: 0.875rem;
    height: 0.875rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  @media (max-width: 30rem) {
    .launch {
      padding: 0 2.5rem 0 1rem;
      justify-content: flex-start;
    }
    .launch-new {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .launch {
      transition: none;
    }
  }
</style>
