---
import T from './T.astro';

/**
 * THE VIEWER — a picture whole, over the page, at its full size: an
 * event's photo or video, a space photo, a painting (Juan, 2026-10-27).
 * One per page, drawn once; whatever shows pictures opens it with
 *
 *   document.dispatchEvent(new CustomEvent('viewer:open', {
 *     detail: { items: [{ src, name, video? }], at },
 *   }))
 *
 * and the arrows, the keys or a swipe go through the rest of `items`.
 * The full picture is fetched only here, and its two neighbours with it,
 * so the arrows never wait. The picture keeps clear of the close button
 * above it and the caption below it, and stands in ONE FIXED FRAME for
 * every picture (Juan, 2026-10-27: frames hugging each picture grew and
 * shrank as the arrows turned) — framed like every screen on the site
 * (the hairline, the flat picture's corner, the screens' shadow), the
 * picture whole inside it over a blur of itself, as a deck's frames
 * stand theirs (PanelDeck `.layer`).
 *
 * THE SCREENS' OWN SHAPE (Juan, 2026-10-27): the frame is 3:2, the size
 * every screen on the site is (More Work, Events, More of Me) — on a
 * phone the whole room, which is taller — as large as the room allows. And a
 * turn is a frame's own turn: the next picture CROSS-FADES over the one
 * showing, at the frames' pace, once it has loaded — two layers, the way
 * a deck's frame hands one photo to the next.
 */
---

<dialog class="viewer" data-viewer aria-label="Viewer">
  <div class="room">
    <div class="stage">
      {
        [0, 1].map(() => (
          <div class="layer" data-layer>
            <img class="fill" alt="" aria-hidden="true" data-fill />
            <img class="full" alt="" data-full />
            <video class="full" muted loop playsinline disablepictureinpicture data-full-video />
          </div>
        ))
      }
    </div>
  </div>
  <p class="v-cap"><span data-v-name></span> <span class="v-count" data-v-count></span></p>
  <button type="button" class="v-btn v-close" data-v-close>
    <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
      <path d="M3.5 3.5 L12.5 12.5 M12.5 3.5 L3.5 12.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
    </svg>
    <span class="sr"><T k="focus.close" /></span>
  </button>
  <button type="button" class="v-btn v-prev" data-v-step="-1">
    <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
      <path d="M10 3 L5 8 L10 13" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
    <span class="sr"><T k="deck.prev" /></span>
  </button>
  <button type="button" class="v-btn v-next" data-v-step="1">
    <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
      <path d="M6 3 L11 8 L6 13" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
    <span class="sr"><T k="deck.next" /></span>
  </button>
</dialog>

<script>
  import { meantToClose } from '../lib/dismiss';

  type Item = { src: string; name?: string; video?: boolean };
  const dialog = document.querySelector<HTMLDialogElement>('[data-viewer]')!;
  const layers = [...dialog.querySelectorAll<HTMLElement>('[data-layer]')].map(el => ({
    el,
    fill: el.querySelector<HTMLImageElement>('[data-fill]')!,
    img: el.querySelector<HTMLImageElement>('[data-full]')!,
    video: el.querySelector<HTMLVideoElement>('[data-full-video]')!,
  }));
  type Layer = (typeof layers)[number];
  const name = dialog.querySelector<HTMLElement>('[data-v-name]')!;
  const count = dialog.querySelector<HTMLElement>('[data-v-count]')!;
  let items: Item[] = [];
  let at = 0;
  let front = 0;
  let turn = 0;

  const poster = (item: Item) => item.src.replace(/\.mp4$/, '.jpg');
  const warm = (i: number) => {
    const p = items[(i + items.length) % items.length];
    if (p) new Image().src = p.video ? poster(p) : p.src;
  };
  const clear = (layer: Layer) => {
    layer.video.pause();
    layer.video.removeAttribute('src');
    layer.video.load();
  };

  // The next picture goes on the layer behind; once it can be seen, it
  // fades in over the one in front, which then lets go of its video.
  const show = (i: number) => {
    at = (i + items.length) % items.length;
    const item = items[at];
    const mine = ++turn;
    const back = layers[1 - front];
    back.fill.src = item.video ? poster(item) : item.src;
    if (item.video) {
      back.img.removeAttribute('src');
      back.video.poster = poster(item);
      back.video.src = item.src;
      back.video.play().catch(() => {});
    } else {
      clear(back);
      back.img.alt = item.name ?? '';
      back.img.classList.remove('is-loaded');
      back.img.onload = null;
      back.img.src = item.src;
    }
    // ONCE A TURN (Juan, 2026-10-29: now and then a picture changed with
    // no fade). A slow picture turned on the timer and then AGAIN when it
    // loaded, and that second turn swapped which layer was in front, so
    // the next picture was written straight onto the one being looked at.
    let revealed = false;
    const reveal = () => {
      if (mine !== turn || revealed) return;
      revealed = true;
      const was = layers[front];
      was.el.classList.remove('is-on');
      back.el.classList.add('is-on');
      front = 1 - front;
      setTimeout(() => {
        if (mine === turn) clear(was);
      }, 700);
    };
    if (item.video || (back.img.complete && back.img.naturalWidth)) {
      back.img.classList.add('is-loaded');
      reveal();
    } else {
      // A slow picture still turns: its blur stands in while it loads,
      // and the picture fades in over it when it arrives.
      back.img.onload = () => {
        if (mine !== turn) return;
        back.img.classList.add('is-loaded');
        reveal();
      };
      setTimeout(reveal, 1200);
    }
    name.textContent = item.name ?? '';
    count.textContent = items.length > 1 ? `${at + 1} / ${items.length}` : '';
    warm(at + 1);
    warm(at - 1);
  };

  document.addEventListener('viewer:open', e => {
    const { detail } = e as CustomEvent<{
      items: Item[];
      at: number;
      phone?: boolean;
    }>;
    items = detail.items;
    dialog.classList.toggle('is-single', items.length < 2);
    dialog.classList.toggle('is-phone', Boolean(detail.phone));
    show(detail.at);
    clearTimeout(shutting);
    dialog.showModal();
    // It FADES IN AND OUT, the dark behind it too (Juan, 2026-11-03: it
    // vanished at once when the dark was clicked). Done here rather than
    // with CSS's discrete transitions, which Safari does not run on a
    // dialog's way out of the top layer.
    // Its first frame is read hidden, so the fade has somewhere to start.
    void dialog.offsetWidth;
    dialog.classList.add('is-shown');
  });
  let shutting = 0;
  const shut = () => {
    if (!dialog.open || !dialog.classList.contains('is-shown')) return;
    dialog.classList.remove('is-shown');
    shutting = window.setTimeout(() => dialog.close(), FADE);
  };
  const FADE = matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 450;
  // Esc fades it too.
  dialog.addEventListener('cancel', e => {
    e.preventDefault();
    shut();
  });
  dialog.addEventListener('close', () => {
    dialog.classList.remove('is-shown');
    turn++;
    for (const layer of layers) {
      clear(layer);
      layer.el.classList.remove('is-on');
    }
    document.dispatchEvent(new CustomEvent('viewer:closed', { detail: at }));
  });

  for (const b of dialog.querySelectorAll<HTMLElement>('[data-v-step]'))
    b.addEventListener('click', () => show(at + Number(b.dataset.vStep)));
  dialog.querySelector('[data-v-close]')!.addEventListener('click', shut);
  // A click on the dark around the picture closes it — a mouse's, clear
  // of the controls (lib/dismiss).
  dialog.addEventListener('click', e => {
    const dark = e.target === dialog || (e.target as HTMLElement).classList.contains('room');
    if (dark && meantToClose(e, dialog)) shut();
  });
  dialog.addEventListener('keydown', e => {
    if (e.key === 'ArrowRight') show(at + 1);
    else if (e.key === 'ArrowLeft') show(at - 1);
  });

  // A finger's swipe sideways turns it.
  let x0: number | null = null;
  dialog.addEventListener('pointerdown', e => (x0 = e.clientX));
  dialog.addEventListener('pointerup', e => {
    if (x0 === null) return;
    const dx = e.clientX - x0;
    x0 = null;
    if (Math.abs(dx) > 50) show(at + (dx < 0 ? 1 : -1));
  });
</script>

<style>
  /* ROWS, so nothing can stand on anything else (Juan, 2026-10-27: a long
     painting's caption, pinned to the foot, grew up into the picture on a
     phone): the close button's row, the room the frame stands in, the
     caption under it at whatever height it takes, and — on a phone — the
     arrows' row. The frame is sized by the room it is given. */
  .viewer {
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgba(8, 8, 8, 0.94);
    color: var(--ink);
    touch-action: pan-y;
  }

  .viewer[open] {
    display: grid;
    grid-template-rows: 5.5rem minmax(0, 1fr) auto 1.75rem;
  }

  .viewer::backdrop {
    background: rgba(0, 0, 0, 0.6);
  }

  /* In and out on one fade, the dark behind it with it; the picture
     settles in from a touch smaller (the script's 450 ms). */
  .viewer,
  .viewer::backdrop {
    opacity: 0;
    transition: opacity 450ms var(--ease);
  }

  .viewer.is-shown,
  .viewer.is-shown::backdrop {
    opacity: 1;
  }

  .viewer .room {
    scale: 0.96;
    transition: scale 450ms var(--ease);
  }

  .viewer.is-shown .room {
    scale: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .viewer,
    .viewer::backdrop,
    .viewer .room {
      transition: none;
    }
  }

  /* THE ROOM: 2.5rem clear of the arrows at its sides (1rem in, 2.5rem
     wide); the frame is as large as it allows. */
  .room {
    grid-row: 2;
    min-height: 0;
    padding: 0 6rem;
    container-type: size;
    display: grid;
    place-items: center;
  }

  .viewer.is-single .room {
    padding: 0 1.5rem;
  }

  /* THE FRAME: 3:2 like every screen on the site, as large as the room
     allows, framed the same way — the hairline, the flat picture's corner,
     the screens' shadow. */
  .stage {
    position: relative;
    width: min(100cqw, calc(100cqh * 3 / 2));
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border: 1px solid var(--hairline);
    border-radius: var(--media-radius-flat);
    background: var(--ground);
    box-shadow:
      0 2rem 4rem rgba(0, 0, 0, 0.55),
      0 0.5rem 1.25rem rgba(0, 0, 0, 0.4);
  }

  /* Two layers, one in front: a turn cross-fades them at a frame's own
     pace (PanelDeck `.layer`). */
  .layer {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity var(--dur-settle) linear;
  }

  .layer.is-on {
    opacity: 1;
  }

  .layer img,
  .layer video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    user-select: none;
  }

  /* The picture's own blur fills what its shape leaves of the frame. */
  .fill {
    object-fit: cover;
    transform: scale(1.2);
    filter: blur(28px) brightness(0.55);
  }

  .full {
    object-fit: contain;
  }

  /* A picture that arrives after its turn fades in rather than popping. */
  img.full {
    transition: opacity var(--dur-settle) linear;
  }

  img.full:not(.is-loaded) {
    opacity: 0;
  }

  .layer img:not([src]),
  .layer video:not([src]) {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .layer {
      transition: none;
    }
  }

  /* The caption: a step under the frame, inside the page's gutter. Its
     row is ALWAYS two lines tall, whatever the title (Juan, 2026-10-27: a
     row that grew with a long title shrank the frame as the arrows turned
     — a layout shift); a title longer than two lines ends in an ellipsis,
     and the viewer's count is still there. */
  .v-cap {
    grid-row: 3;
    box-sizing: content-box;
    height: 2.8em;
    margin: 0;
    padding: 1.25rem 1.5rem 0;
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    text-align: center;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.4;
    text-wrap: balance;
  }

  .v-count {
    margin-left: 0.5rem;
    white-space: nowrap;
    color: var(--ink-3);
    font-weight: 400;
  }

  /* The deck's own arrows (DeckControls): the header's pill recipe as a
     circle. */
  .v-btn {
    position: absolute;
    display: grid;
    place-items: center;
    width: var(--float-h);
    height: var(--float-h);
    padding: 0;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface) 82%, transparent);
    color: var(--ink);
    cursor: pointer;
    transition: border-color var(--hover);
  }

  .v-btn:hover {
    border-color: var(--ink-3);
  }

  /* A finger's target, past the circle: 56px round a 40px button. */
  .v-btn::before {
    content: '';
    position: absolute;
    inset: -0.5rem;
    border-radius: 999px;
  }

  .v-close {
    top: 1rem;
    left: 50%;
    transform: translateX(-50%);
  }

  .v-prev,
  .v-next {
    top: 50%;
    transform: translateY(-50%);
  }

  .v-prev {
    left: 1rem;
  }

  .v-next {
    right: 1rem;
  }

  .viewer.is-single .v-prev,
  .viewer.is-single .v-next {
    display: none;
  }

  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .viewer.is-phone {
    background: color-mix(in srgb, var(--ground) 84%, transparent);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
  }

  .viewer.is-phone::backdrop {
    background: transparent;
  }

  .viewer.is-phone .room {
    grid-row: 1 / -1;
    padding: 0 6rem;
  }

  .viewer.is-phone .v-cap {
    display: none;
  }

  .viewer.is-phone .fill {
    display: none;
  }

  .viewer.is-phone .stage {
    --demo-ratio: calc(2556 / 1179);
    --demo-h: calc(100svh - (var(--stage-top) - 1.5rem) - var(--stage-bottom) - 5rem);
    --demo-r: calc(var(--demo-h) / var(--demo-ratio) * 0.14);
    height: var(--demo-h);
    width: calc(var(--demo-h) / var(--demo-ratio));
    aspect-ratio: 1179 / 2556;
    border-radius: var(--demo-r) var(--demo-r) calc(var(--demo-r) * 1.136)
      calc(var(--demo-r) * 1.136);
    background: var(--surface);
  }

  .viewer.is-phone .full {
    object-fit: cover;
  }

  /* A phone: the arrows move to a row of their own at the foot, and the
     frame takes the WHOLE ROOM, as a desk's takes nearly all of its
     (Juan, 2026-11-03): a fixed 4:5 left a fifth of a tall phone empty
     under it. The room is the same for every picture (the caption's row
     is fixed), so it is still one frame. */
  @media (max-width: 48rem) {
    .viewer[open] {
      grid-template-rows: 5rem minmax(0, 1fr) auto 5rem;
    }

    .room,
    .viewer.is-single .room {
      padding: 0 1rem;
    }

    .stage {
      width: 100cqw;
      height: 100cqh;
      aspect-ratio: auto;
    }

    .viewer.is-phone .room {
      padding: calc(var(--float-gap) * 2 + var(--float-h)) 1rem 5rem;
    }

    .viewer.is-phone .stage {
      --demo-h: min(
        calc((100vw - 2rem) * var(--demo-ratio)),
        calc(100svh - var(--float-gap) * 2 - var(--float-h) - 6rem)
      );
      height: var(--demo-h);
      width: calc(var(--demo-h) / var(--demo-ratio));
      aspect-ratio: 1179 / 2556;
    }

    .v-cap {
      padding: 1rem 1rem 0;
    }

    .v-prev,
    .v-next {
      top: auto;
      bottom: 1rem;
      width: 3rem;
      height: 3rem;
      transform: none;
    }
  }
</style>
