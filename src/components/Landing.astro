---
import Base from '../layouts/Base.astro';
import Hero from './Hero.astro';
import AppsShowcase from './AppsShowcase.astro';
import NarrationPlayer from './NarrationPlayer.astro';
import SiteFooter from './SiteFooter.astro';
import WorkCarousel from './WorkCarousel.astro';
import EventsDeck from './EventsDeck.astro';
import { APPS } from '../lib/apps';

/**
 * THE ONE-PAGER, with the apps section in one of its layouts. The landing
 * (`/`) is the chain; `/tabs` and `/cards` are the other two, standing
 * beside it so Juan can choose by looking (2026-10-11). Once he has, the
 * two losers go — routes, layouts and all.
 */
type Props = {
  layout: 'chain' | 'tabs' | 'cards';
};

const { layout } = Astro.props;
---

<Base noindex={layout !== 'chain'}>
  <Hero />

  <!-- Juan's apps, the page's main subject: every one in one panel. -->
  <AppsShowcase apps={APPS} layout={layout} />

  <!-- Everything else, secondary: one card per project. -->
  <WorkCarousel />

  <!-- Where Juan has been: hackathons, talks, the startup's events. -->
  <EventsDeck />

  <!-- Each app's legal and help pages, and Juan elsewhere. -->
  <SiteFooter panel />

  <!-- The page's ONE narrator; it glides between the blocks' anchors. -->
  <NarrationPlayer />
</Base>
