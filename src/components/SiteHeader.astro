---
import BrandMark from './BrandMark.astro';
import { locales, localeNames } from '../i18n/ui';
---

<header class="site-header">
  <a href="/" class="mark-link" aria-label="juanevillam">
    <BrandMark size={26} />
  </a>

  <!-- One control: the language. A real <select>, so the OS renders the
       menu; switching re-renders in place (html[data-lang]). -->
  <select id="lang-picker" class="label" aria-label="Language">
    {
      locales.map(l => (
        <option value={l} selected={l === 'en'}>
          {localeNames[l]}
        </option>
      ))
    }
  </select>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem clamp(1.25rem, 4vw, 2.5rem) 1.75rem;
    /* Scrim so the fixed controls never collide with scrolled content. */
    background: linear-gradient(to bottom, var(--ground) 55%, transparent);
  }

  .mark-link {
    color: var(--ink);
    text-decoration: none;
    transition: opacity var(--dur-micro) var(--ease);
  }

  .mark-link:hover {
    opacity: 0.7;
  }

  /* The picker wears the same mono label as every section title and
     link-group heading — it IS one. Type comes from `.label`; only the
     control's own chrome is set here. */
  #lang-picker {
    background: transparent;
    border: none;
    padding: 0.375rem 0;
    cursor: pointer;
    transition: color var(--dur-micro) var(--ease);
  }

  #lang-picker:hover {
    color: var(--ink);
  }
</style>

<script>
  const picker = document.getElementById('lang-picker') as HTMLSelectElement;
  picker.value = localStorage.getItem('lang') || 'en';
  picker.addEventListener('change', () => {
    const next = picker.value;
    localStorage.setItem('lang', next);
    document.documentElement.lang = next;
    document.documentElement.dataset.lang = next;
  });
</script>
