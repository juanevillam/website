---
import BrandMark from './BrandMark.astro';
import { locales, localeCodes, localeNames } from '../i18n/ui';
---

<header class="site-header">
  <a href="/" class="mark-link" aria-label="juanevillam">
    <BrandMark size={26} />
  </a>

  <!-- One control: the language. A real <select>, so the OS renders the
       menu and it stays keyboard-operable; switching re-renders in
       place (html[data-lang]).

       The select itself is invisible and the code beside it is what is
       drawn. That is the only way to have BOTH: a label-cased "EN" at
       rest and a menu that lists the languages by their own names in
       their own case. Styling an <option> cannot do it — a native
       popup renders outside CSS's reach, which is why the menu kept
       shouting ESPAÑOL. -->
  <div class="lang">
    <span class="label lang-code" id="lang-code" aria-hidden="true">
      {localeCodes.en}
    </span>
    <!-- The chevron the native control drew for itself, redrawn now
         that the control is invisible: without it the code reads as a
         label rather than as something you can open. -->
    <svg
      class="lang-chevron"
      viewBox="0 0 12 12"
      width="9"
      height="9"
      aria-hidden="true"
    >
      <path
        d="M2.5 4.5 L6 8 L9.5 4.5"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      ></path>
    </svg>
    <select id="lang-picker" aria-label="Language">
      {
        locales.map(l => (
          <option value={l} selected={l === 'en'}>
            {localeNames[l]}
          </option>
        ))
      }
    </select>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem clamp(1.25rem, 4vw, 2.5rem) 1.75rem;
    /* Scrim so the fixed controls never collide with scrolled content. */
    background: linear-gradient(to bottom, var(--ground) 55%, transparent);
  }

  .mark-link {
    color: var(--ink);
    text-decoration: none;
    transition: opacity var(--dur-micro) var(--ease);
  }

  .mark-link:hover {
    opacity: 0.7;
  }

  .lang {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.4375rem;
    padding: 0.375rem 0;
    color: var(--ink-3);
    transition: color var(--dur-micro) var(--ease);
  }

  .lang:hover {
    color: var(--ink);
  }

  /* The code is what the header draws — same mono label as every
     section title and link-group heading, because it IS one. */
  .lang-code {
    color: inherit;
  }

  .lang-chevron {
    flex: 0 0 auto;
  }

  /* The real control, invisible but present: it keeps the native menu,
     the keyboard and the accessible name. */
  #lang-picker {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    border: none;
    background: transparent;
    font: inherit;
    cursor: pointer;
  }
</style>

<script>
  import { localeCodes, type Locale } from '../i18n/ui';

  const picker = document.getElementById('lang-picker') as HTMLSelectElement;
  const code = document.getElementById('lang-code') as HTMLElement;

  const show = (lang: string) => {
    code.textContent = localeCodes[lang as Locale] ?? lang.toUpperCase();
  };

  picker.value = localStorage.getItem('lang') || 'en';
  show(picker.value);

  picker.addEventListener('change', () => {
    const next = picker.value;
    localStorage.setItem('lang', next);
    document.documentElement.lang = next;
    document.documentElement.dataset.lang = next;
    show(next);
  });
</script>
