---
import BrandMark from './BrandMark.astro';
import { locales, localeCodes, localeNames } from '../i18n/ui';
---

<header class="site-header">
  <a href="/" class="mark-link" aria-label="juanevillam">
    <!-- 26 = --float-glyph (1.625rem); the narrator scales the same. -->
    <BrandMark size={26} />
  </a>

  <!-- One control: the language. A real <select>, so the OS renders the
       menu and it stays keyboard-operable; switching re-renders in
       place (html[data-lang]).

       The select itself is invisible and the code beside it is what is
       drawn. That is the only way to have BOTH: a label-cased "EN" at
       rest and a menu that lists the languages by their own names in
       their own case. Styling an <option> cannot do it — a native
       popup renders outside CSS's reach, which is why the menu kept
       shouting ESPAÑOL. -->
  <div class="lang">
    <span class="label lang-code" id="lang-code" aria-hidden="true">
      {localeCodes.en}
    </span>
    <!-- The chevron the native control drew for itself, redrawn now
         that the control is invisible: without it the code reads as a
         label rather than as something you can open. -->
    <svg
      class="lang-chevron"
      viewBox="0 0 12 12"
      width="9"
      height="9"
      aria-hidden="true"
    >
      <path
        d="M2.5 4.5 L6 8 L9.5 4.5"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      ></path>
    </svg>
    <select id="lang-picker" aria-label="Language">
      {
        locales.map(l => (
          <option value={l} selected={l === 'en'}>
            {localeNames[l]}
          </option>
        ))
      }
    </select>
  </div>
</header>

<style>
  /* NOT a bar: two floating controls at the top corners, and nothing
     between them. The row itself is deaf so the gap it spans never
     eats a click meant for the page under it. */
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--float-gap) clamp(1.25rem, 4vw, 2.5rem) 0;
    pointer-events: none;
    transition:
      transform var(--dur-quick) var(--ease),
      opacity var(--dur-quick) var(--ease);
  }

  /* The pills step out of the way while you read down the page and come
     back the moment you scroll up. Phones only at first (the screen was
     too small to keep chrome over the screenshots); every screen since
     Juan asked for it on the desk too (2026-10-11). */
  .site-header.is-tucked {
    transform: translateY(calc(-100% - var(--float-gap)));
  }

  /* Gone BY ITSELF (a phone's timeout, the script) it eases away slowly,
     fading as it rises: the page's quick curve does most of its travel in
     the first frames, which reads right when a scroll sends it off and
     sudden when nothing did (Juan, 2026-10-13). */
  .site-header.is-tucked.is-idle {
    opacity: 0;
    transition:
      transform var(--dur-settle) cubic-bezier(0.4, 0, 0.2, 1),
      opacity var(--dur-settle) cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* With no scrim behind them they carry their own ground, or they
     would sit unreadable on whatever scrolls past. */
  .site-header > * {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    height: var(--float-h);
    padding: 0 var(--float-pad);
    border: 1px solid var(--hairline);
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface) 82%, transparent);
    backdrop-filter: blur(12px);
    transition: border-color var(--dur-micro) var(--ease);
  }

  .site-header > *:hover {
    border-color: var(--ink-3);
  }

  .mark-link {
    color: var(--ink);
    text-decoration: none;
    transition:
      opacity var(--dur-quick) var(--ease),
      visibility 0s;
  }

  /* NOT ON THE HERO (Juan, 2026-10-13): the hero IS the wordmark, so the
     mark beside it only said the name twice. It comes back once the page
     leaves it; the language pill stays throughout. */
  .site-header.is-on-hero .mark-link {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity var(--dur-quick) var(--ease),
      visibility 0s linear var(--dur-quick);
  }

  .mark-link:hover {
    opacity: 0.7;
  }

  .lang {
    position: relative;
    gap: 0.4375rem;
    color: var(--ink-3);
    transition: color var(--dur-micro) var(--ease);
  }

  .lang:hover {
    color: var(--ink);
  }

  /* The code is what the header draws — same mono label as every
     section title and link-group heading, because it IS one. */
  .lang-code {
    color: inherit;
  }

  .lang-chevron {
    flex: 0 0 auto;
  }

  /* The real control, invisible but present: it keeps the native menu,
     the keyboard and the accessible name. */
  #lang-picker {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    border: none;
    background: transparent;
    font: inherit;
    cursor: pointer;
  }
</style>

<script>
  import { localeCodes, type Locale } from '../i18n/ui';
  import { dur } from '../lib/motion';

  const picker = document.getElementById('lang-picker') as HTMLSelectElement;
  const code = document.getElementById('lang-code') as HTMLElement;

  const show = (lang: string) => {
    code.textContent = localeCodes[lang as Locale] ?? lang.toUpperCase();
  };

  // What the head's pre-paint script settled on (a link's `?lang`, the
  // saved choice, the browser's language).
  picker.value = document.documentElement.dataset.lang || 'en';
  show(picker.value);

  // Tuck the header while scrolling down; scrolling back up (or the top
  // of the page) brings it back. A class flip, never per-frame styling —
  // the transform runs on the GPU.
  //
  // ON A PHONE IT TAKES TWO SECTIONS UP (Juan, 2026-10-13). The page snaps
  // a section per swipe, so one swipe up is nearly always re-reading the
  // last one, not reaching for the header — and the header leapt in on
  // it. Upward travel adds up and any move down starts it over; on a desk
  // any scroll up still brings it back.
  //
  // AND IT GOES AGAIN BY ITSELF, on every screen (Juan, 2026-10-13):
  // brought back mid-page, it tucks away after a few seconds left alone —
  // it is noise once it is not wanted. Never while it is being used (a
  // finger or the pointer on it, the language menu open), and never at
  // the top of the page, where it simply belongs.
  const header = document.querySelector<HTMLElement>('.site-header');
  const phoneQuery = matchMedia('(max-width: 48rem)');
  const LINGER_MS = 3000;
  let lastY = window.scrollY;
  let upward = 0;
  let linger = 0;
  const leaveLater = () => {
    clearTimeout(linger);
    if (window.scrollY <= 80) return;
    linger = window.setTimeout(() => {
      if (
        header?.matches(':focus-within') ||
        header?.querySelector(':hover') ||
        window.scrollY <= 80
      )
        return;
      header?.classList.add('is-tucked', 'is-idle');
    }, LINGER_MS);
  };
  header?.addEventListener('pointerdown', () => clearTimeout(linger));
  header?.addEventListener('pointerup', leaveLater);
  // A pointer resting on it (a desk) holds it; leaving starts the wait.
  header?.addEventListener('pointerleave', () => {
    if (!header.classList.contains('is-tucked')) leaveLater();
  });
  header?.addEventListener('focusin', () => clearTimeout(linger));
  header?.addEventListener('focusout', leaveLater);
  window.addEventListener(
    'scroll',
    () => {
      const y = window.scrollY;
      if (Math.abs(y - lastY) < 8) return;
      upward = y < lastY ? upward + (lastY - y) : 0;
      // Two sections, less a little: a snapped panel is the screen tall.
      const needed = phoneQuery.matches ? innerHeight * 1.8 : 0;
      if (y <= 80) {
        clearTimeout(linger);
        header?.classList.remove('is-tucked', 'is-idle');
      } else if (y > lastY) {
        clearTimeout(linger);
        // Already gone by itself: it stays as it is, rather than jumping
        // back to visible for the quick curve.
        header?.classList.add('is-tucked');
      } else if (upward >= needed) {
        header?.classList.remove('is-tucked', 'is-idle');
        leaveLater();
      }
      lastY = y;
    },
    { passive: true }
  );

  // While the hero holds the screen, the mark stands down (see the CSS).
  const heroEl = document.getElementById('top');
  const headerEl = document.querySelector<HTMLElement>('.site-header');
  if (heroEl && headerEl) {
    // Set at once from where the page opens, so the mark never flashes in
    // on a load at the top.
    const r = heroEl.getBoundingClientRect();
    headerEl.classList.toggle('is-on-hero', r.top < innerHeight / 2 && r.bottom > innerHeight / 2);
    new IntersectionObserver(([e]) => headerEl.classList.toggle('is-on-hero', e.isIntersecting), {
      rootMargin: '-45% 0px -45% 0px',
    }).observe(heroEl);
  }

  // The mark goes home. On the landing it already IS home, so instead of
  // reloading the page (a visible refresh) it TELEPORTS: the page dips to
  // the ground, the scroll jumps to the top unseen, and the hero comes
  // up. A smooth scroll was tried first and replayed every section on
  // the way — decks resetting, the narrator gliding past, the stories
  // walking backwards. Drops any #section the URL picked up. Anywhere
  // else it is a plain link; a modified click (new tab) is left alone.
  document.querySelector('.mark-link')?.addEventListener('click', event => {
    const e = event as MouseEvent;
    if (location.pathname !== '/' || e.metaKey || e.ctrlKey || e.shiftKey || e.button)
      return;
    e.preventDefault();
    if (location.hash) history.replaceState(null, '', '/');
    const root = document.documentElement;
    const jump = () => window.scrollTo({ top: 0, behavior: 'instant' });
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return jump();
    root.classList.add('is-jumping');
    const dip = dur('micro');
    // The hero's own entrance, wound back while the page is dark, so the
    // wordmark ARRIVES the way it did on the first load rather than
    // simply being there.
    const hero = [...document.querySelectorAll<HTMLElement>('#top [data-reveal]')];
    setTimeout(() => {
      hero.forEach(el => {
        el.style.transition = 'none';
        el.classList.remove('is-in');
      });
      jump();
      void document.body.offsetWidth;
      hero.forEach(el => (el.style.transition = ''));
      // A timer, not a frame: a page that stops drawing (a hidden tab)
      // must never be left dipped.
      setTimeout(() => {
        root.classList.remove('is-jumping');
        hero.forEach(el => el.classList.add('is-in'));
      }, 16);
    }, dip);
  });

  // The Konami code — ↑ ↑ ↓ ↓ ← → ← → B A — from any page, the old way
  // into a game: on the landing it opens the game over the page.
  // The game's own frame never sees these keys while it has focus.
  const KONAMI = [
    'ArrowUp', 'ArrowUp', 'ArrowDown', 'ArrowDown',
    'ArrowLeft', 'ArrowRight', 'ArrowLeft', 'ArrowRight', 'b', 'a',
  ];
  let typed = 0;
  window.addEventListener('keydown', event => {
    const key = event.key.length === 1 ? event.key.toLowerCase() : event.key;
    typed = key === KONAMI[typed] ? typed + 1 : key === KONAMI[0] ? 1 : 0;
    if (typed < KONAMI.length) return;
    typed = 0;
    // The landing's game cabinet opens over the page wherever it is; any
    // other page sends you to the landing's More Work, where it lives.
    if (!document.getElementById('arcade-touch'))
      return void (location.href = '/#more-work');
    document.dispatchEvent(new Event('arcade:open'));
  });

  picker.addEventListener('change', () => {
    const next = picker.value;
    localStorage.setItem('lang', next);
    document.documentElement.lang = next;
    document.documentElement.dataset.lang = next;
    show(next);
  });
</script>
