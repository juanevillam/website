---
import BrandMark from './BrandMark.astro';
import { locales, localeCodes, localeNames } from '../i18n/ui';
---

<header class="site-header">
  <a href="/" class="mark-link" aria-label="juanevillam">
    <!-- 26 = --float-glyph (1.625rem); the narrator scales the same. -->
    <BrandMark size={26} />
  </a>

  <!-- One control: the language. A real <select>, so the OS renders the
       menu and it stays keyboard-operable; switching re-renders in
       place (html[data-lang]).

       The select itself is invisible and the code beside it is what is
       drawn. That is the only way to have BOTH: a label-cased "EN" at
       rest and a menu that lists the languages by their own names in
       their own case. Styling an <option> cannot do it — a native
       popup renders outside CSS's reach, which is why the menu kept
       shouting ESPAÑOL. -->
  <div class="lang">
    <span class="label lang-code" id="lang-code" aria-hidden="true">
      {localeCodes.en}
    </span>
    <!-- The chevron the native control drew for itself, redrawn now
         that the control is invisible: without it the code reads as a
         label rather than as something you can open. -->
    <svg
      class="lang-chevron"
      viewBox="0 0 12 12"
      width="9"
      height="9"
      aria-hidden="true"
    >
      <path
        d="M2.5 4.5 L6 8 L9.5 4.5"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      ></path>
    </svg>
    <select id="lang-picker" aria-label="Language">
      {
        locales.map(l => (
          <option value={l} selected={l === 'en'}>
            {localeNames[l]}
          </option>
        ))
      }
    </select>
  </div>
</header>

<style>
  /* NOT a bar: two floating controls at the top corners, and nothing
     between them. The row itself is deaf so the gap it spans never
     eats a click meant for the page under it. */
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--float-gap) clamp(1.25rem, 4vw, 2.5rem) 0;
    pointer-events: none;
    transition: transform calc(var(--beat) / 2) var(--ease);
  }

  /* On a phone the pills step out of the way while you read down the
     page and come back the moment you scroll up — the screen is too
     small to keep chrome over the screenshots. */
  @media (max-width: 48rem) {
    .site-header.is-tucked {
      transform: translateY(calc(-100% - var(--float-gap)));
    }
  }

  /* With no scrim behind them they carry their own ground, or they
     would sit unreadable on whatever scrolls past. */
  .site-header > * {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    height: var(--float-h);
    padding: 0 var(--float-pad);
    border: 1px solid var(--hairline);
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface) 82%, transparent);
    backdrop-filter: blur(12px);
    transition: border-color var(--dur-micro) var(--ease);
  }

  .site-header > *:hover {
    border-color: var(--ink-3);
  }

  .mark-link {
    color: var(--ink);
    text-decoration: none;
    transition: opacity var(--dur-micro) var(--ease);
  }

  .mark-link:hover {
    opacity: 0.7;
  }

  .lang {
    position: relative;
    gap: 0.4375rem;
    color: var(--ink-3);
    transition: color var(--dur-micro) var(--ease);
  }

  .lang:hover {
    color: var(--ink);
  }

  /* The code is what the header draws — same mono label as every
     section title and link-group heading, because it IS one. */
  .lang-code {
    color: inherit;
  }

  .lang-chevron {
    flex: 0 0 auto;
  }

  /* The real control, invisible but present: it keeps the native menu,
     the keyboard and the accessible name. */
  #lang-picker {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    border: none;
    background: transparent;
    font: inherit;
    cursor: pointer;
  }
</style>

<script>
  import { localeCodes, type Locale } from '../i18n/ui';

  const picker = document.getElementById('lang-picker') as HTMLSelectElement;
  const code = document.getElementById('lang-code') as HTMLElement;

  const show = (lang: string) => {
    code.textContent = localeCodes[lang as Locale] ?? lang.toUpperCase();
  };

  picker.value = localStorage.getItem('lang') || 'en';
  show(picker.value);

  // Tuck the header on a phone while scrolling down; any scroll up (or
  // the top of the page) brings it back. A class flip, never per-frame
  // styling — the transform runs on the GPU.
  const header = document.querySelector<HTMLElement>('.site-header');
  let lastY = window.scrollY;
  window.addEventListener(
    'scroll',
    () => {
      const y = window.scrollY;
      if (Math.abs(y - lastY) < 8) return;
      header?.classList.toggle('is-tucked', y > lastY && y > 80);
      lastY = y;
    },
    { passive: true }
  );

  // The Konami code — ↑ ↑ ↓ ↓ ← → ← → B A — from any page, the old way
  // into a game: on the landing it scrolls to the game and presses Play.
  // The game's own frame never sees these keys while it has focus.
  const KONAMI = [
    'ArrowUp', 'ArrowUp', 'ArrowDown', 'ArrowDown',
    'ArrowLeft', 'ArrowRight', 'ArrowLeft', 'ArrowRight', 'b', 'a',
  ];
  let typed = 0;
  window.addEventListener('keydown', event => {
    const key = event.key.length === 1 ? event.key.toLowerCase() : event.key;
    typed = key === KONAMI[typed] ? typed + 1 : key === KONAMI[0] ? 1 : 0;
    if (typed < KONAMI.length) return;
    typed = 0;
    const game = document.getElementById('space-explorer');
    if (!game) return void (location.href = '/#space-explorer');
    game.scrollIntoView({ behavior: 'smooth' });
    document.getElementById('arcade-play')?.click();
  });

  picker.addEventListener('change', () => {
    const next = picker.value;
    localStorage.setItem('lang', next);
    document.documentElement.lang = next;
    document.documentElement.dataset.lang = next;
    show(next);
  });
</script>
