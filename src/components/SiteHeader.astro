---
import BrandMark from './BrandMark.astro';
import {
  locales,
  localeLabels,
  useTranslations,
  type Locale,
} from '../i18n/ui';

type Props = {
  locale: Locale;
  /** Locale-less page path ('' for home) — the lang cycle stays on it. */
  path?: string;
};

const { locale, path = '' } = Astro.props;
const t = useTranslations(locale);
const hrefFor = (l: Locale, p: string = path) =>
  l === 'en' ? `/${p}` : `/${l}/${p}`;

// Language control mirrors the theme toggle: one button showing the current
// locale; pressing it cycles to the next one (en → es → zh → en).
const nextLocale = locales[(locales.indexOf(locale) + 1) % locales.length];

// The site's sections are PAGES, not anchors — one link per section.
const NAV = [
  { path: '', label: 'nav.home' },
  { path: 'salvalo/', label: 'nav.salvalo' },
  { path: 'work/', label: 'nav.work' },
] as const;
---

<header class="site-header">
  <a href={hrefFor(locale, '')} class="mark-link" aria-label="juanevillam">
    <BrandMark size={26} />
  </a>

  <nav class="nav label" aria-label="sections">
    {
      NAV.map(item => (
        <a
          href={hrefFor(locale, item.path)}
          class="nav-link"
          aria-current={path === item.path ? 'page' : undefined}
        >
          {t(item.label)}
        </a>
      ))
    }
  </nav>

  <nav class="controls label" aria-label="language and theme">
    <a
      href={hrefFor(nextLocale)}
      class="lang"
      aria-label={`${localeLabels[locale]} → ${localeLabels[nextLocale]}`}
    >
      {localeLabels[locale]}
    </a>
    <button
      id="theme-toggle"
      class="label"
      type="button"
      data-label-light={t('theme.light')}
      data-label-dark={t('theme.dark')}
      data-label-system={t('theme.system')}
    >
      {t('theme.system')}
    </button>
  </nav>
</header>

<script is:inline>
  // Parser-blocking on purpose: the SSR label is always "system", so a saved
  // light/dark pref must be painted onto the button before first render or
  // it visibly swaps (flicker on every navigation).
  (() => {
    const button = document.getElementById('theme-toggle');
    const pref = localStorage.getItem('theme') || 'system';
    const label =
      button.dataset['label' + pref.charAt(0).toUpperCase() + pref.slice(1)];
    if (label) button.textContent = label;
  })();
</script>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem clamp(1.25rem, 4vw, 2.5rem) 1.75rem;
    /* Scrim so the fixed controls never collide with scrolled content. */
    background: linear-gradient(to bottom, var(--ground) 55%, transparent);
  }

  .mark-link {
    color: var(--ink);
    text-decoration: none;
    transition: opacity var(--dur-micro) var(--ease);
  }

  .mark-link:hover {
    opacity: 0.7;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 1.75rem);
  }

  .nav-link {
    text-decoration: none;
    color: var(--ink-3);
    transition: color var(--dur-micro) var(--ease);
  }

  .nav-link:hover {
    color: var(--ink);
  }

  .nav-link[aria-current='page'] {
    color: var(--ink);
  }

  .controls {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  /* Both controls share one fixed box: labels differ per locale and per
     state, and a hit target that grows and shrinks under the pointer is
     the bug, not a detail. */
  .lang,
  #theme-toggle {
    width: 4.5rem;
    padding: 0.375rem 0;
    text-align: right;
    text-decoration: none;
    color: var(--ink-3);
    transition: color var(--dur-micro) var(--ease);
  }

  #theme-toggle {
    background: none;
    border: none;
    cursor: pointer;
  }

  .lang:hover,
  #theme-toggle:hover {
    color: var(--ink);
  }
</style>

<script>
  const button = document.getElementById('theme-toggle');
  if (button) {
    const order = ['system', 'light', 'dark'] as const;
    const render = () => {
      const pref = localStorage.getItem('theme') || 'system';
      button.textContent = button.dataset[
        `label${pref.charAt(0).toUpperCase()}${pref.slice(1)}` as
          | 'labelLight'
          | 'labelDark'
          | 'labelSystem'
      ] as string;
    };
    button.addEventListener('click', () => {
      const pref = (localStorage.getItem('theme') ||
        'system') as (typeof order)[number];
      const next = order[(order.indexOf(pref) + 1) % order.length];
      localStorage.setItem('theme', next);
      (
        window as Window & { __applyTheme?: () => void }
      ).__applyTheme?.();
      render();
    });
    render();
  }
</script>
