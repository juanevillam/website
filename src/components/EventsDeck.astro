---
import PanelDeck from './PanelDeck.astro';
import ArcadeCabinet from './ArcadeCabinet.astro';
import ShipEgg from './ShipEgg.astro';
import RobotEgg from './RobotEgg.astro';

/**
 * Highlights — Space Explorer first, followed by Juan's hackathon & startup
 * moments (lib/events holds the list).
 */
import { EVENTS } from '../lib/events';

type Props = {
  /** The card a shared address opens over the page (pages/events). */
  focus?: string;
};
const { focus } = Astro.props;
---

<PanelDeck id="events" title="events.title" items={EVENTS} focus={focus} share="events">
  <ArcadeCabinet slot="arcade" />
</PanelDeck>

{/* Space Explorer's chase over its card, and Tridi's robot on Platanus. */}
<ShipEgg place="card" />
<RobotEgg />
