---
import PanelDeck from './PanelDeck.astro';
import RobotEgg from './RobotEgg.astro';

/**
 * Events — where Juan has been (lib/events holds the list and says how
 * a card is made), newest first.
 */
import { EVENTS } from '../lib/events';

type Props = {
  /** The card a shared address opens over the page (pages/events). */
  focus?: string;
};
const { focus } = Astro.props;
---

<PanelDeck id="events" title="events.title" items={EVENTS} focus={focus} share="events" />

{/* Tridi's robot walks on the Platanus card's photos now and then; its
    script stands it there. */}
<RobotEgg place="card" />
