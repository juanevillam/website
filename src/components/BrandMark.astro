---
// jv monogram — the locked personal mark (brand system v1.0). 48-unit grid,
// stroke 3.25, round caps/joins, no fill, FLAT (no glow). Geometry is the
// exact locked path set; color defaults to currentColor so it themes.
type Props = {
  size?: number;
  class?: string;
};

const { size = 24, class: className } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  stroke="currentColor"
  stroke-width="3.25"
  stroke-linecap="round"
  stroke-linejoin="round"
  role="img"
  aria-label="jv"
  class={className}
>
  <g transform="translate(-1.5 0)">
    <circle cx="19" cy="9" r="2.1" fill="currentColor" stroke="none"></circle>
    <path d="M19 17v13a8 8 0 0 1-8 8"></path>
    <path d="M28 15l6 19 6-19"></path>
  </g>
</svg>
