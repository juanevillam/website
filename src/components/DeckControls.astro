---
import T from './T.astro';

/**
 * The deck's controls — previous, one dot per card, next — shared by every
 * sideways slider on the page (lib/deck.ts wires them). One recipe, so More
 * Work and the stories' slides cannot drift apart.
 */
type Props = {
  /** One accessible name per card, in order. */
  names: string[];
};

const { names } = Astro.props;
---

<div class="deck-controls" data-deck-controls>
  <button class="arrow" type="button" data-deck-prev>
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
      <path
        d="M14.5 6 8.5 12l6 6"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
    <span class="sr"><T k="deck.prev" /></span>
  </button>
  <div class="dots">
    {
      names.map(name => (
        <button class="dot" type="button" data-deck-dot aria-label={name} />
      ))
    }
  </div>
  <button class="arrow" type="button" data-deck-next>
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
      <path
        d="M9.5 6l6 6-6 6"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
    <span class="sr"><T k="deck.next" /></span>
  </button>
</div>

<style>
  .deck-controls {
    display: flex;
    align-items: center;
    gap: 1rem;
    pointer-events: auto;
  }

  /* The header's pill recipe, as a circle. */
  .arrow {
    display: inline-grid;
    place-items: center;
    width: var(--float-h);
    height: var(--float-h);
    border: 1px solid var(--hairline);
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface) 82%, transparent);
    color: var(--ink);
    cursor: pointer;
    transition: border-color var(--dur-micro) var(--ease);
  }

  .arrow:hover {
    border-color: var(--ink-3);
  }

  .dots {
    display: flex;
    gap: 0.25rem;
  }

  /* A 7px dot in a 20px target. */
  .dot {
    width: 1.25rem;
    height: 1.25rem;
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
  }

  .dot::after {
    content: '';
    display: block;
    width: 0.4375rem;
    height: 0.4375rem;
    margin: auto;
    border-radius: 999px;
    background: var(--ink-3);
    opacity: 0.5;
    transition:
      opacity var(--dur-micro) var(--ease),
      background var(--dur-micro) var(--ease);
  }

  .dot.is-current::after {
    background: var(--ink);
    opacity: 1;
  }

  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
