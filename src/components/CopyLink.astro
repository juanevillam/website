---
import T from './T.astro';

/**
 * COPY LINK — a link glyph beside a thing's name (an app, a project, an
 * event) that puts its own address (lib/links) on the clipboard, so it
 * can be pasted into a post. A glyph, not words (Juan, 2026-10-17): the
 * chain links are what iOS and the web draw for "copy link"; a paperclip
 * would say "attachment". Copied, it turns into a check for a moment.
 *
 * The address carries the page's language as `?lang=`: whoever copies it
 * while reading in Spanish is sharing it with Spanish readers.
 */
type Props = {
  path: string;
  /** A second, visible copy of a control readers already have (a phone's
   *  caption on a picture): out of the tab order and the reading order. */
  decorative?: boolean;
};
const { path, decorative = false } = Astro.props;
---

<button
  class="copy-link"
  type="button"
  data-copy-link={path}
  tabindex={decorative ? -1 : undefined}
  aria-hidden={decorative ? 'true' : undefined}
>
  <svg class="glyph link" viewBox="0 0 16 16" aria-hidden="true">
    <path
      d="M6.75 9.25 L9.25 6.75 M7.4 4.6 L8.6 3.4 a2.4 2.4 0 0 1 3.4 3.4 L10.8 8 M5.2 8 L4 9.2 a2.4 2.4 0 0 0 3.4 3.4 L8.6 11.4"
    ></path>
  </svg>
  <svg class="glyph check" viewBox="0 0 16 16" aria-hidden="true">
    <path d="M3.5 8.5 L6.5 11.5 L12.5 4.5"></path>
  </svg>
  <span class="sr-only when-idle"><T k="share.copy" /></span>
  <span class="sr-only when-done" aria-live="polite"><T k="share.copied" /></span>
</button>

<style>
  /* Quiet beside the name: the third ink, the name's ink on hover. A
     hit box bigger than the glyph, pulled back by its own margin so the
     name keeps its place. */
  .copy-link {
    flex: none;
    display: inline-grid;
    vertical-align: middle;
    place-items: center;
    width: 2rem;
    height: 2rem;
    margin: -0.25rem;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: none;
    color: var(--ink-3);
    cursor: pointer;
    transition: color var(--dur-micro) var(--ease);
  }

  .copy-link:hover,
  .copy-link:focus-visible,
  .copy-link.is-copied {
    color: var(--ink);
  }

  .glyph {
    grid-area: 1 / 1;
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: opacity var(--dur-micro) var(--ease);
  }

  .check,
  .copy-link.is-copied .link {
    opacity: 0;
  }

  .copy-link.is-copied .check {
    opacity: 1;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Its name for readers is "Copy Link"; once copied, "Copied" is said. */
  .when-done {
    display: none;
  }

  .copy-link.is-copied .when-done {
    display: inline;
  }
</style>

<script>
  // One listener for every Copy Link on the page.
  const copy = async (text: string) => {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      // An older browser, or no clipboard permission: the old way.
      const area = document.createElement('textarea');
      area.value = text;
      area.style.position = 'fixed';
      area.style.opacity = '0';
      document.body.append(area);
      area.select();
      const ok = document.execCommand('copy');
      area.remove();
      return ok;
    }
  };

  const timers = new WeakMap<HTMLElement, number>();
  document.addEventListener('click', async e => {
    const button = (e.target as Element | null)?.closest<HTMLElement>('[data-copy-link]');
    if (!button) return;
    const lang = document.documentElement.dataset.lang;
    const url = new URL(button.dataset.copyLink!, location.origin);
    if (lang) url.searchParams.set('lang', lang);
    if (!(await copy(url.href))) return;
    button.classList.add('is-copied');
    clearTimeout(timers.get(button));
    timers.set(
      button,
      window.setTimeout(() => button.classList.remove('is-copied'), 2000),
    );
  });
</script>
