---
import { type UIKey } from '../i18n/ui';
import T from './T.astro';

/**
 * One project section: the logo (passed in the `logo` slot), a short
 * description, an optional visit pill, and a horizontal snap slider that
 * takes any mix of media — portrait app screenshots, wide web stills,
 * muted videos — all normalized to one height.
 */
export type MediaItem = {
  type: 'image' | 'video';
  src: string;
  width: number;
  height: number;
  /** Poster for videos. */
  poster?: string;
};

type Props = {
  id: string;
  name: string;
  /** One merged description — the deep story belongs to the vids. */
  desc: UIKey;
  /** Show the name beside the logo (for icon tiles, which don't carry it). */
  titled?: boolean;
  /** Brand accent for the visit pill's hover. */
  accent?: string;
  href?: string;
  domain?: string;
  media?: MediaItem[];
};

const {
  id,
  name,
  desc,
  titled = false,
  accent,
  href,
  domain,
  media = [],
} = Astro.props;
---

<section
  class="panel"
  id={id}
  style={accent ? `--brand-accent: ${accent}` : undefined}
>
  <div class="inner">
    <div class="logo" data-reveal>
      <slot name="logo" />
      {titled && <span class="app-name">{name}</span>}
    </div>

    <p class="body lede" data-reveal><T k={desc} /></p>

    {
      href && (
        <a class="label visit" href={href} data-reveal>
          <T k="visit" />
          {` ${domain} ↗`}
        </a>
      )
    }

    {
      media.length > 0 && (
        <div class="slides" tabindex="-1" data-reveal>
          {media.map(item =>
            item.type === 'video' ? (
              <video
                src={item.src}
                poster={item.poster}
                width={item.width}
                height={item.height}
                autoplay
                muted
                loop
                playsinline
                preload="metadata"
              />
            ) : (
              <img
                src={item.src}
                alt={`${name} screenshot`}
                width={item.width}
                height={item.height}
                loading="lazy"
                decoding="async"
              />
            )
          )}
        </div>
      )
    }
  </div>
</section>

<style>
  .inner {
    width: 100%;
    max-width: var(--content-max);
    margin: 0 auto;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .logo :global(img) {
    height: 2.25rem;
    width: auto;
    display: block;
  }

  /* The app's name beside its icon, the way the welcome screens title it —
     SF Pro Display at Large Title weight. */
  .app-name {
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: var(--track-heading);
    line-height: 1;
  }

  .lede {
    margin-top: 1.5rem;
    font-size: 1.125rem;
    max-width: 44rem;
  }

  .visit {
    display: inline-block;
    margin-top: 1.5rem;
    padding: 0.625rem 1.375rem;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    text-decoration: none;
    color: var(--ink-2);
    transition:
      color var(--dur-micro) var(--ease),
      border-color var(--dur-micro) var(--ease);
  }

  .visit:hover {
    color: var(--brand-accent, var(--ink));
    border-color: var(--brand-accent, var(--ink-3));
  }

  /* One height for every slide; each keeps its own aspect, so phone
     shots stand tall next to wide web stills. */
  .slides {
    margin-top: 2rem;
    display: flex;
    align-items: stretch;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 0.5rem;
  }

  .slides :is(img, video) {
    height: clamp(15rem, 40svh, 23rem);
    width: auto;
    flex: 0 0 auto;
    scroll-snap-align: center;
    border-radius: 0.75rem;
    border: 1px solid var(--hairline);
    background: var(--surface);
  }
</style>
