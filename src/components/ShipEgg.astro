---
import T from './T.astro';
import { PROJECTS } from '../lib/work';
import { workPath } from '../lib/links';

/**
 * Space Explorer's ship (lib/eggs, lib/ship), in two places:
 *
 * - `hero`: the hunt, over the whole hero, behind the name.
 * - `foot`: the jump, across the foot's empty middle row (SiteFooter).
 * - `card`: a chase in the dark strip over the game's own card in More
 *   Work, while that card is in front. No link: it plays by the card it
 *   would lead to, and must never take a tap meant for Play Game. The
 *   script stands it there.
 *
 * In the hero and the foot, a link to the game's card rides on the ship.
 * Out of the flow everywhere, so nothing moves when it comes or goes.
 */
type Props = { place: 'hero' | 'card' | 'foot' };
const { place } = Astro.props;
const game = PROJECTS.find(p => p.id === 'space-explorer');
---

{
  game && (
    <div class:list={['egg-ship', `is-${place}`]} data-ship={place}>
      <canvas class="egg-band" data-ship-band hidden aria-hidden="true" />
      {place !== 'card' && (
        <a class="egg-hit" href={workPath(game)} data-ship-link hidden>
          <span class="sr-only">
            <T k="egg.ship" />
          </span>
        </a>
      )}
    </div>
  )
}

<style>
  .egg-ship {
    position: absolute;
    pointer-events: none;
  }

  /* The whole hero, behind the name (first in the section, so the name
     paints over it): shots fly on until they leave the screen. */
  .is-hero {
    inset: 0;
  }

  /* The foot grid's empty middle row, edge to edge of the screen. */
  .is-foot {
    grid-row: 2 / 3;
    grid-column: 1 / -1;
    top: 0;
    bottom: 0;
    left: calc(50% - 50vw);
    width: 100vw;
  }

  .egg-band {
    display: block;
    width: 100%;
    height: 100%;
    transition: opacity var(--dur-quick) var(--ease);
  }

  .egg-band[hidden] {
    display: none;
  }

  /* With reduced motion it does not fly: it fades in, stands, fades. */
  @media (prefers-reduced-motion: reduce) {
    .egg-band {
      opacity: 0;
      transition: opacity var(--dur-settle) var(--ease);
    }

    .egg-band.is-still {
      opacity: 1;
    }
  }

  .egg-hit {
    position: absolute;
    top: 0;
    left: 0;
    width: 80px;
    height: 56px;
    border-radius: 999px;
    pointer-events: auto;
    cursor: pointer;
    will-change: transform;
  }

  .egg-hit:focus-visible {
    outline: 1px solid var(--ink-3);
    outline-offset: 2px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>

<script>
  import { nowAndThen, reduceMotion, toCard } from '../lib/eggs';

  for (const egg of document.querySelectorAll<HTMLElement>('[data-ship]')) {
    const band = egg.querySelector<HTMLCanvasElement>('[data-ship-band]')!;

    if (egg.dataset.ship !== 'card') {
      const link = egg.querySelector<HTMLAnchorElement>('[data-ship-link]')!;
      const hero = egg.dataset.ship === 'hero';
      const panel = egg.closest<HTMLElement>(hero ? 'section' : 'footer');
      if (!panel) continue;
      toCard(link, 'more-work', 'space-explorer');
      // Soon after the panel settles, so a visit finds it; then now and
      // then while it stays on screen.
      nowAndThen(panel, hero ? [2500, 4000] : [1500, 2500], [30000, 45000], async () => {
        const ship = await import('../lib/ship');
        const scene = hero ? ship.heroFight : ship.farewell;
        if (reduceMotion.matches) await ship.stand(band, link, scene, hero ? 5 : 2.2);
        else await ship.play(band, link, scene);
      });
      continue;
    }

    // The card: the strip over the cabinet — the panel's empty dark,
    // from the cabinet's left (the screen's edge on a phone) out to the
    // screen's right edge — in the cabinet's own positioned ancestor,
    // measured each time it plays.
    const section = document.getElementById('more-work');
    const card = section?.querySelector<HTMLElement>('.card[data-card="space-explorer"]');
    const cabinet = card?.querySelector<HTMLElement>('.screen');
    if (!section || !card || !cabinet) continue;
    const front = () => card.classList.contains('is-current');
    const phone = matchMedia('(max-width: 48rem)');
    const stand = () => {
      const holder = cabinet.offsetParent as HTMLElement | null;
      if (!holder) return false;
      if (egg.parentElement !== holder) holder.append(egg);
      const c = cabinet.getBoundingClientRect();
      const h = holder.getBoundingClientRect();
      const s = section.getBoundingClientRect();
      const from = phone.matches ? 0 : c.left - 96;
      const to = document.documentElement.clientWidth;
      // From just under the panel's top to a little into the cabinet.
      const top = Math.max(s.top + 8, c.top - (phone.matches ? 110 : 190));
      egg.style.left = `${(from - h.left - holder.clientLeft).toFixed(1)}px`;
      egg.style.width = `${(to - from).toFixed(1)}px`;
      egg.style.top = `${(top - h.top - holder.clientTop).toFixed(1)}px`;
      egg.style.height = `${(c.top + 16 - top).toFixed(1)}px`;
      return true;
    };
    nowAndThen(
      section,
      [1200, 2000],
      [25000, 40000],
      async () => {
        if (!stand()) return;
        const ship = await import('../lib/ship');
        if (reduceMotion.matches) await ship.stand(band, null, ship.chase, 1.4);
        else await ship.play(band, null, ship.chase, front);
      },
      front,
    );
  }
</script>
