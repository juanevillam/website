---
import { locales, ui, type UIKey } from '../i18n/ui';

/**
 * T with LINKS: one translated string whose copy marks its links inline,
 * `[Cashea](cashea)`, each id resolved from `links`. Every locale keeps its
 * own wording and word order around the same links — a sentence cut into
 * before/link/after pieces could only ever hold one.
 */
type Props = {
  k: UIKey;
  links: Record<string, string>;
};

const { k, links } = Astro.props;

const MARK = /(\[[^\]]+\]\([a-z0-9-]+\))/;
const parts = (text: string) =>
  text.split(MARK).map(seg => {
    const m = seg.match(/^\[([^\]]+)\]\(([a-z0-9-]+)\)$/);
    return m ? { text: m[1], href: links[m[2]] } : { text: seg };
  });
---

{
  // Each locale's span on ONE line, its words flush against its tags: Astro
  // keeps the whitespace around a child on its own line, and it stood a
  // space inside each link ("Pastor ,") and one before the paragraph's
  // first word — which shifted every word off its timing, so the whole
  // paragraph lit at once while it was read aloud (Juan, 2026-10-27).
  locales.map(l => (
    <span class="t" lang={l}>{parts(ui[l][k]).map(p => (p.href ? <a href={p.href} target="_blank" rel="noopener noreferrer">{p.text}</a> : p.text))}</span>
  ))
}
