---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import StoryShowcase, {
  type StorySlide,
} from '../components/StoryShowcase.astro';
import AppTile from '../components/AppTile.astro';
import NarrationPlayer from '../components/NarrationPlayer.astro';
import ArcadeSection from '../components/ArcadeSection.astro';
import SiteFooter from '../components/SiteFooter.astro';
import WorkCarousel from '../components/WorkCarousel.astro';
import type { UIKey } from '../i18n/ui';

// Media manifests — iPhone screenshots, all shot by Juan.
//
// NARRATION: every paragraph is the transcript of a voice clip Juan
// records, found by convention — see src/lib/narration.ts. Nothing to set
// here: drop the clip in and the page's one narrator picks it up.
const shots = (
  app: string,
  size: [number, number],
  entries: [name: string | [string, string], title?: string, paras?: UIKey[]][]
) =>
  entries.map(
    ([name, title, paras]): StorySlide => ({
      src: Array.isArray(name)
        ? [`/media/${app}/${name[0]}.png`, `/media/${app}/${name[1]}.png`]
        : `/media/${app}/${name}.png`,
      width: size[0],
      height: size[1],
      title,
      paras,
    })
  );

// Three slides per app, in the order the story is told — the middle one
// tells two neighbouring screens side by side (it was two slides until
// 2026-10-01: two fewer scrolls per story). Each manifest states
// its own pixel size, and it must match the files on disk: it reserves the
// slot before the image lands. Both apps are shot on the same iPhone
// (393x852pt at 3x) today, but a retake on another phone changes that.
const SHAPER_SLIDES = shots(
  'shaper',
  [1179, 2556],
  [
    ['ios-dark-home', 'Library', ['shaper.s1.p1', 'shaper.s1.p2']],
    [
      ['ios-dark-player', 'ios-dark-shape'],
      'Player and Shape',
      ['shaper.s23.p1', 'shaper.s23.p2'],
    ],
    ['ios-dark-clip', 'Clips', ['shaper.s4.p1', 'shaper.s4.p2']],
  ]
);

const TOPPER_SLIDES = shots(
  'topper',
  [1179, 2556],
  [
    ['ios-dark-home', 'Home', ['topper.s1.p1', 'topper.s1.p2']],
    [
      ['ios-dark-explore', 'ios-dark-top-detail'],
      'Explore and Top',
      ['topper.s23.p1', 'topper.s23.p2'],
    ],
    ['ios-dark-profile', 'Profile', ['topper.s4.p1', 'topper.s4.p2']],
  ]
);
---

<Base>
  <Hero />

  <!-- No story loops: a looping story rewinds the scroll to its own opener
       at its end, so the game after the stories could never be reached. -->

  <StoryShowcase
    id="shaper"
    name="Sound Shaper"
    pitch={['shaper.problem', 'shaper.solution']}
    slides={SHAPER_SLIDES}
    stores
  >
    <AppTile app="shaper" size={76} slot="logo" />
  </StoryShowcase>

  <StoryShowcase
    id="topper"
    name="Topper"
    pitch={['topper.problem', 'topper.solution']}
    enter="rise"
    slides={TOPPER_SLIDES}
    stores
  >
    <AppTile app="topper" size={76} slot="logo" />
  </StoryShowcase>

  <!-- The page's foot: the game, playable here. -->
  <ArcadeSection />

  <!-- Everything else, secondary: one card per project. -->
  <WorkCarousel />

  <!-- Each app's legal and help pages, and Juan elsewhere. -->
  <SiteFooter panel />

  <!-- The page's ONE narrator; it glides between the blocks' anchors. -->
  <NarrationPlayer />
</Base>
