---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import StoryShowcase, {
  type StorySlide,
} from '../components/StoryShowcase.astro';
import AppTile from '../components/AppTile.astro';
import type { UIKey } from '../i18n/ui';

// Media manifests — iPhone screenshots, all shot by Juan.
//
// NARRATION: each slide's body text is the transcript of a voice clip Juan
// records. When a clip lands, set its `audio` path here (and `introAudio` /
// the hero's `narration`) and the listen pill appears on its own:
//   public/media/narration/intro.m4a                 — the hero, Juan himself
//   public/media/shaper/narration/00-intro.m4a       — why Sound Shaper exists
//   public/media/shaper/narration/01-home.m4a … 04-clip.m4a — one per slide
const shots = (
  app: string,
  size: [number, number],
  entries: [name: string, title?: string, paras?: UIKey[]][]
) =>
  entries.map(
    ([name, title, paras]): StorySlide => ({
      src: `/media/${app}/${name}.png`,
      width: size[0],
      height: size[1],
      title,
      paras,
    })
  );

// Four slides, in the order the story is told. The two apps were shot on
// different phones — 393x852pt for Sound Shaper, 402x874pt for Topper — so
// each manifest states its own pixel size, and it must match the files on
// disk: it reserves the slot before the image lands.
const SHAPER_SLIDES = shots(
  'shaper',
  [1179, 2556],
  [
    ['ios-dark-home', 'Library', ['shaper.s1.p1', 'shaper.s1.p2']],
    ['ios-dark-player', 'Player', ['shaper.s2.p1', 'shaper.s2.p2']],
    ['ios-dark-shape', 'Shape', ['shaper.s3.p1', 'shaper.s3.p2']],
    ['ios-dark-clip', 'Clips', ['shaper.s4.p1', 'shaper.s4.p2']],
  ]
);

// Topper is OUT for now (Juan's call, 2026-09-20) — it returns as its own
// story once its screenshots are retaken on the current build.
---

<Base>
  <Hero />

  <StoryShowcase
    id="shaper"
    name="Sound Shaper"
    pitch={{
      problem: 'shaper.problem',
      solution: 'shaper.solution',
    }}
    slides={SHAPER_SLIDES}
    stores
    linkGroups={[
      {
        key: 'links.legal',
        links: [
          { key: 'legal.terms', href: '/sound-shaper/terms-and-conditions' },
          { key: 'legal.privacy', href: '/sound-shaper/privacy-policy' },
        ],
      },
      {
        key: 'links.help',
        links: [
          { key: 'legal.support', href: '/sound-shaper/support' },
          { key: 'legal.delete', href: '/sound-shaper/delete-account' },
        ],
      },
    ]}
  >
    <AppTile app="shaper" size={76} slot="logo" />
  </StoryShowcase>
</Base>
