---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Showcase, { type MediaItem } from '../components/Showcase.astro';
import AppTile from '../components/AppTile.astro';

// Media manifests — iPhone screenshots only (Juan shoots them all); the
// landing webs need no previews, the visit pills already go there.
// Sliders show iPhone-shaped placeholders until the real shots land.
const TOPPER_MEDIA: MediaItem[] = [
  'ios-dark-home',
  'ios-dark-top-detail',
  'ios-dark-profile',
  'ios-dark-trophies',
].map(name => ({
  type: 'image',
  src: `/media/topper/${name}.png`,
  width: 1290,
  height: 2796,
}));
---

<Base>
  <Hero />

  <Showcase
    id="salvalo"
    name="Sálvalo"
    desc="salvalo.desc"
    accent="#53DA8F"
    href="https://salvalo.app"
    domain="salvalo.app"
    placeholders={3}
  >
    <img
      slot="logo"
      src="/media/brand/salvalo.png"
      alt="Sálvalo"
      height="60"
      style="height: 3.75rem"
    />
  </Showcase>

  <Showcase
    id="shaper"
    name="Sound Shaper"
    desc="shaper.desc"
    titled
    placeholders={3}
  >
    <AppTile app="shaper" slot="logo" />
  </Showcase>

  <Showcase
    id="topper"
    name="Topper"
    desc="topper.desc"
    titled
    media={TOPPER_MEDIA}
  >
    <AppTile app="topper" slot="logo" />
  </Showcase>

  <Showcase
    id="crol"
    name="Crol ERP"
    desc="crol.desc"
    accent="#00E100"
    href="https://www.crol.mx"
    domain="crol.mx"
    placeholders={3}
  >
    <img slot="logo" src="/media/brand/crol.png" alt="Crol ERP" height="40" />
  </Showcase>
</Base>
