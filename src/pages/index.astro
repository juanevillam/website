---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import StoryShowcase, {
  type StorySlide,
} from '../components/StoryShowcase.astro';
import AppTile from '../components/AppTile.astro';
import NarrationPlayer from '../components/NarrationPlayer.astro';
import type { UIKey } from '../i18n/ui';

// Media manifests — iPhone screenshots, all shot by Juan.
//
// NARRATION: every paragraph is the transcript of a voice clip Juan
// records, found by convention — see src/lib/narration.ts. Nothing to set
// here: drop the clip in and the page's one narrator picks it up.
const shots = (
  app: string,
  size: [number, number],
  entries: [name: string, title?: string, paras?: UIKey[]][]
) =>
  entries.map(
    ([name, title, paras]): StorySlide => ({
      src: `/media/${app}/${name}.png`,
      width: size[0],
      height: size[1],
      title,
      paras,
    })
  );

// Four slides, in the order the story is told. The two apps were shot on
// different phones — 393x852pt for Sound Shaper, 402x874pt for Topper — so
// each manifest states its own pixel size, and it must match the files on
// disk: it reserves the slot before the image lands.
const SHAPER_SLIDES = shots(
  'shaper',
  [1179, 2556],
  [
    ['ios-dark-home', 'Library', ['shaper.s1.p1', 'shaper.s1.p2', 'shaper.s1.p3']],
    ['ios-dark-player', 'Player', ['shaper.s2.p1', 'shaper.s2.p2', 'shaper.s2.p3']],
    ['ios-dark-shape', 'Shape', ['shaper.s3.p1', 'shaper.s3.p2', 'shaper.s3.p3']],
    ['ios-dark-clip', 'Clips', ['shaper.s4.p1', 'shaper.s4.p2', 'shaper.s4.p3']],
  ]
);

// Topper is OUT for now (Juan's call, 2026-09-20) — it returns as its own
// story once its screenshots are retaken on the current build.
---

<Base>
  <Hero />

  <StoryShowcase
    id="shaper"
    name="Sound Shaper"
    pitch={['shaper.problem', 'shaper.solution', 'shaper.promise']}
    loop
    slides={SHAPER_SLIDES}
    stores
  >
    <AppTile app="shaper" size={76} slot="logo" />
  </StoryShowcase>

  <!-- The page's ONE narrator; it glides between the blocks' anchors. -->
  <NarrationPlayer />
</Base>
