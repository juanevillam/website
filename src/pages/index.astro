---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import StoryShowcase, {
  type StorySlide,
} from '../components/StoryShowcase.astro';
import AppTile from '../components/AppTile.astro';
import NarrationPlayer from '../components/NarrationPlayer.astro';
import type { UIKey } from '../i18n/ui';

// Media manifests — iPhone screenshots, all shot by Juan.
//
// NARRATION: every paragraph is the transcript of a voice clip Juan
// records, found by convention — see src/lib/narration.ts. Nothing to set
// here: drop the clip in and the page's one narrator picks it up.
const shots = (
  app: string,
  size: [number, number],
  entries: [name: string, title?: string, paras?: UIKey[]][]
) =>
  entries.map(
    ([name, title, paras]): StorySlide => ({
      src: `/media/${app}/${name}.png`,
      width: size[0],
      height: size[1],
      title,
      paras,
    })
  );

// Four slides per app, in the order the story is told. Each manifest states
// its own pixel size, and it must match the files on disk: it reserves the
// slot before the image lands. Both apps are shot on the same iPhone
// (393x852pt at 3x) today, but a retake on another phone changes that.
const SHAPER_SLIDES = shots(
  'shaper',
  [1179, 2556],
  [
    ['ios-dark-home', 'Library', ['shaper.s1.p1', 'shaper.s1.p2']],
    ['ios-dark-player', 'Player', ['shaper.s2.p1', 'shaper.s2.p2']],
    ['ios-dark-shape', 'Shape', ['shaper.s3.p1', 'shaper.s3.p2']],
    ['ios-dark-clip', 'Clips', ['shaper.s4.p1', 'shaper.s4.p2']],
  ]
);

const TOPPER_SLIDES = shots(
  'topper',
  [1179, 2556],
  [
    ['ios-dark-home', 'Home', ['topper.s1.p1', 'topper.s1.p2']],
    ['ios-dark-explore', 'Explore', ['topper.s2.p1', 'topper.s2.p2']],
    ['ios-dark-top-detail', 'Top', ['topper.s3.p1', 'topper.s3.p2']],
    ['ios-dark-profile', 'Profile', ['topper.s4.p1', 'topper.s4.p2']],
  ]
);
---

<Base>
  <Hero />

  <!-- Only the LAST story loops: a looping story rewinds the scroll to its
       own opener at its end, so any story after it could never be reached. -->

  <StoryShowcase
    id="shaper"
    name="Sound Shaper"
    pitch={['shaper.problem', 'shaper.solution']}
    slides={SHAPER_SLIDES}
    stores
  >
    <AppTile app="shaper" size={76} slot="logo" />
  </StoryShowcase>

  <StoryShowcase
    id="topper"
    name="Topper"
    pitch={['topper.problem', 'topper.solution']}
    loop
    slides={TOPPER_SLIDES}
    stores
  >
    <AppTile app="topper" size={76} slot="logo" />
  </StoryShowcase>

  <!-- The page's ONE narrator; it glides between the blocks' anchors. -->
  <NarrationPlayer />
</Base>
