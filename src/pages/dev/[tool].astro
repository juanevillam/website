        margin: 0.85rem 0 0;
        padding-top: 0.75rem;
        border-top: 1px solid var(--hairline);
        font-size: 0.6875rem;
      }
      .legend > span {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
      }

      /* ---------- Right Studio Layout ---------- */
      main {
        display: grid;
        grid-template-rows: auto minmax(0, 1fr) auto;
        height: 100vh;
        max-height: 100vh;
        min-height: 0;
        overflow: hidden;
        background: var(--ground);
      }
      .top {
        display: flex;
