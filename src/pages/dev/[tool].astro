---
import fs from 'node:fs';
import path from 'node:path';
import { SCRIPTS_ES } from '../../lib/scripts';
import '../../styles/global.css';

/**
 * DEV ONLY — /dev/teleprompter.
 *
 * Full-take Spanish recording studio for adding new sections (apps, events,
 * projects). Records camera (9:16 vertical crop) + microphone into
 * `public/media/narration/es/{key}.mp4` + `{key}.m4a` and transcribes word
 * timings into `src/data/narration/{key}.words.json` via
 * `scripts/narration-recorder.mjs`.
 *
 * Spanish is the sole recorded voice & video on the site; English and Chinese
 * are translated text in `src/i18n/ui.ts` aligned to the Spanish clock.
 *
 * In a production build this route has no paths, so it does not exist.
 */
export const getStaticPaths = () =>
  import.meta.env.PROD ? [] : [{ params: { tool: 'teleprompter' } }];

const ROOT = process.cwd();
const hasFile = (rel: string) => fs.existsSync(path.join(ROOT, rel));

const list = SCRIPTS_ES.map(c => {
  const hasAudio = hasFile(`public/media/narration/es/${c.key}.m4a`);
  const hasVideo = hasFile(`public/media/narration/es/${c.key}.mp4`);
  const hasWords = hasFile(`src/data/narration/${c.key}.words.json`);
  const status = hasAudio && hasWords ? 'new' : hasAudio ? 'old' : 'none';
  return {
    ...c,
    status,
    hasVideo,
    audio: hasAudio ? `/media/narration/es/${c.key}.m4a` : null,
    video: hasVideo ? `/media/narration/es/${c.key}.mp4` : null,
  };
});
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Teleprompter</title>
  </head>
  <body>
    <aside class="list">
      <div class="list-head">
        <p class="label">Guiones (Español)</p>
        <p class="total" data-total></p>
      </div>

      <ol>
        {list.map(c => (
          <li>
            <button type="button" data-pick={c.key}>
              <span class="dot" data-dot data-status={c.status} />
              <span class="row-main">
                <span class="where">{c.where}</span>
                <span class="key">{c.key}</span>
              </span>
            </button>
          </li>
        ))}
      </ol>

      <p class="legend">
        <span><span class="dot" data-status="new" /> grabado</span>
        <span><span class="dot" data-status="none" /> pendiente</span>
      </p>
    </aside>

    <main>
      <header class="top">
        <div class="top-left">
          <p class="label" data-where></p>
          <p class="key" data-key></p>
          <p class="draft" data-draft hidden></p>
        </div>

        <div class="mic">
          <button type="button" class="pick-mic" data-cam-on>Activar cámara (9:16)</button>
          <select data-cam aria-label="Cámara" hidden></select>
          <button type="button" class="pick-mic" data-mic-on>Activar micrófono</button>
          <select data-mic aria-label="Micrófono" hidden></select>
          <span class="meter" data-meter-wrap hidden><span data-meter></span></span>
        </div>
      </header>

      <div class="stage" data-stage>
        <div class="col">
          <div class="lines" data-lines></div>
          <div class="said" data-said hidden>
            <p class="label">Transcripción guardada</p>
            <p class="said-text" data-said-text></p>
          </div>
        </div>

        <div class="stage-side">
          <div class="preview-wrap" data-preview-wrap hidden>
            <video class="cam-mirror" data-cam-view autoplay muted playsinline hidden></video>
            <video class="saved-vid" data-saved-video muted playsinline hidden></video>
          </div>
          <img class="shot" data-shot alt="" hidden />
        </div>
      </div>

      <footer class="controls">
        <div class="controls-row">
          <div class="buttons">
            <button type="button" data-act="record">Grabar <kbd>R</kbd></button>
            <button type="button" data-act="next" hidden>
              Terminar y guardar <kbd>espacio</kbd>
            </button>
            <button type="button" data-act="stop" hidden>Cancelar <kbd>esc</kbd></button>
            <button type="button" data-act="take" hidden>Escuchar toma <kbd>P</kbd></button>
            <button type="button" data-act="save" hidden>Guardar <kbd>S</kbd></button>
            <button type="button" data-act="current" hidden>
              Escuchar guardado <kbd>L</kbd>
            </button>
          </div>
          <p class="state" data-state></p>
        </div>
        <p class="hint">
          <kbd>↑</kbd><kbd>↓</kbd> cambiar de guion · narra la toma completa en español ·
          <kbd>espacio</kbd> termina y guarda · después traduce el texto limpio en <code>src/i18n/ui.ts</code> (EN / ZH)
        </p>
      </footer>
    </main>

    <script is:inline type="application/json" id="clips" set:html={JSON.stringify(list)} />

    <script>
      type Clip = {
        key: string;
        where: string;
        shot?: string;
        ideas: string[];
        draft?: string;
        status: 'new' | 'old' | 'none';
        hasVideo: boolean;
        audio: string | null;
        video: string | null;
      };

      const clips: Clip[] = JSON.parse(
        document.getElementById('clips')!.textContent!,
      );
      const read = (k: string) => {
        try {
          return localStorage.getItem(k);
        } catch {
          return null;
        }
      };
      const keep = (k: string, v: string) => {
        try {
          localStorage.setItem(k, v);
        } catch {}
      };

      const $ = <T extends HTMLElement>(s: string) =>
        document.querySelector<T>(s)!;
      const stageEl = $('[data-stage]');
      const linesEl = $('[data-lines]');
      const saidEl = $('[data-said]');
      const saidText = $('[data-said-text]');
      const stateEl = $('[data-state]');
      const previewWrap = $('[data-preview-wrap]');
      const camView = $<HTMLVideoElement>('[data-cam-view]');
      const savedVideo = $<HTMLVideoElement>('[data-saved-video]');
      const shot = $<HTMLImageElement>('[data-shot]');
      const meterWrap = $('[data-meter-wrap]');
      const meter = $('[data-meter]');
      const btn = (a: string) => $<HTMLButtonElement>(`[data-act="${a}"]`);

      const syncVideoFit = () => {
        const avail = Math.max(180, stageEl.clientHeight - 36);
        stageEl.style.setProperty('--stage-avail-h', `${avail}px`);
      };
      new ResizeObserver(syncVideoFit).observe(stageEl);
      syncVideoFit();

      const secs = (s: string) => (s.length * 1.2) / 14 + 0.5;
      const clipSecs = (c: Clip) => c.ideas.reduce((t, l) => t + secs(l), 0);
      const fmt = (s: number) =>
        `${Math.floor(s / 60)}:${String(Math.round(s % 60)).padStart(2, '0')}`;

      const total = () => {
        const done = clips.filter(c => c.status === 'new').length;
        const est = fmt(clips.reduce((t, c) => t + clipSecs(c), 0));
        $('[data-total]').textContent = `${done} de ${clips.length} grabados · ~${est}`;
      };

      let index = Math.max(
        0,
        clips.findIndex(c => c.key === read('tp.key')),
      );
      let mode: 'idle' | 'count' | 'rec' | 'done' | 'play' | 'saving' = 'idle';
      let line = 0;
      let take: Blob | null = null;
      let takeUrl: string | null = null;
      let takeHasVideo = false;
      let recorder: MediaRecorder | null = null;
      let camStream: MediaStream | null = null;
      let stream: MediaStream | null = null;
      const player = new Audio();

      const clip = () => clips[index];

      const showSaid = (lines: string[]) => {
        saidEl.hidden = !lines.length;
        saidText.textContent = lines.join(' ');
      };

      const readVtt = async (c: Clip): Promise<string[]> => {
        const res = await fetch(`/media/narration/es/${c.key}.vtt?t=${Date.now()}`).catch(
          () => null,
        );
        if (!res?.ok) return [];
        const lines: string[] = [];
        for (const block of (await res.text()).split(/\n\n+/)) {
          const m = block.match(/(\d+):(\d+):([\d.]+)\s*-->.*\n([\s\S]+)/);
          if (m) lines.push(m[4].trim());
        }
        return lines;
      };

      const renderLines = () => {
        const ideas = clip().ideas;
        if (!ideas.length) {
          const p = document.createElement('p');
          p.textContent =
            'Sin texto base aún en src/i18n/ui.ts — puedes grabar libremente y usar la transcripción guardada.';
          linesEl.replaceChildren(p);
          return;
        }
        linesEl.replaceChildren(
          ...ideas.map((text, i) => {
            const p = document.createElement('p');
            p.textContent = text;
            p.dataset.i = String(i);
            return p;
          }),
        );
      };

      const mark = (i: number) => {
        line = i;
        linesEl.querySelectorAll('p').forEach((p, j) => {
          p.classList.toggle('is-past', j < i);
          p.classList.toggle('is-now', j === i);
        });
      };

      const updatePreviewPane = () => {
        const c = clip();
        if (camStream) {
          previewWrap.hidden = false;
          camView.hidden = false;
          savedVideo.hidden = true;
          shot.hidden = true;
          return;
        }
        camView.hidden = true;
        if (mode === 'play' && ((take && takeHasVideo) || (!take && c.video))) {
          previewWrap.hidden = false;
          savedVideo.hidden = false;
          shot.hidden = true;
          return;
        }
        savedVideo.hidden = true;
        previewWrap.hidden = true;
        if (c.shot) {
          shot.src = c.shot;
          shot.hidden = false;
        } else {
          shot.hidden = true;
        }
      };

      const select = async (i: number) => {
        if (mode === 'rec' || mode === 'count' || mode === 'saving') return;
        stopPlayback();
        index = (i + clips.length) % clips.length;
        const c = clip();
        keep('tp.key', c.key);
        if (takeUrl) {
          URL.revokeObjectURL(takeUrl);
          takeUrl = null;
        }
        take = null;
        takeHasVideo = false;
        mode = 'idle';

        $('[data-where]').textContent = c.where;
        $('[data-key]').textContent =
          `${c.key} · ~${fmt(clipSecs(c))} · ${c.status === 'new' ? 'grabado ✓' : 'pendiente'}`;
        const draft = $('[data-draft]');
        draft.textContent = c.draft ?? '';
        draft.hidden = !c.draft;

        document
          .querySelectorAll<HTMLElement>('[data-pick]')
          .forEach(b => b.classList.toggle('is-on', b.dataset.pick === c.key));
        document.querySelector('.is-on')?.scrollIntoView({ block: 'nearest' });

        renderLines();
        mark(0);
        showSaid([]);
        updatePreviewPane();
        sync();

        if (c.status === 'new') {
          const lines = await readVtt(c);
          if (clip() === c) showSaid(lines);
        }
      };

      const sync = () => {
        const c = clip();
        btn('record').hidden =
          mode === 'rec' || mode === 'count' || mode === 'saving';
        btn('record').firstChild!.textContent = take ? 'Repetir ' : 'Grabar ';
        btn('next').hidden = mode !== 'rec';
        btn('next').firstChild!.textContent =
          line + 1 >= Math.max(1, c.ideas.length)
            ? 'Terminar y guardar '
            : 'Siguiente idea ';
        btn('stop').hidden = mode !== 'rec' && mode !== 'count';
        btn('take').hidden = !take || mode === 'rec' || mode === 'saving';
        btn('save').hidden = !take || mode === 'rec' || mode === 'saving';
        btn('current').hidden =
          !c.audio || mode === 'rec' || mode === 'count' || mode === 'saving';
        linesEl.classList.toggle('is-rec', mode === 'rec');

        if (mode === 'idle') {
          stateEl.textContent =
            c.status === 'new'
              ? 'Grabado ✓ · L para escuchar o R si algún día quieres regrabar la toma completa'
              : 'Pendiente · activa cámara y micrófono y pulsa R';
        } else if (mode === 'rec') {
          stateEl.textContent = camStream
            ? '● Grabando video 9:16 + audio…'
            : '● Grabando solo audio (cámara apagada)…';
        } else if (mode === 'done') {
          stateEl.textContent = 'Toma lista · P para revisar o S para guardar';
        } else if (mode === 'play') {
          stateEl.textContent = 'Reproduciendo… (Espacio para parar)';
        }
      };

      // ---------- Camera (9:16 live mirror) ----------
      const cam = $<HTMLSelectElement>('[data-cam]');
      const listCams = async () => {
        const devices = (await navigator.mediaDevices.enumerateDevices()).filter(
          d => d.kind === 'videoinput',
        );
        const current = camStream?.getVideoTracks()[0]?.getSettings().deviceId;
        cam.replaceChildren(
          ...devices.map(d => {
            const o = new Option(d.label || 'Cámara', d.deviceId);
            o.selected = d.deviceId === current;
            return o;
          }),
        );
      };
      const openCam = async (id?: string) => {
        camStream?.getTracks().forEach(t => t.stop());
        const req = (devId?: string) =>
          navigator.mediaDevices.getUserMedia({
            video: {
              ...(devId ? { deviceId: { exact: devId } } : {}),
              width: { ideal: 1920 },
              height: { ideal: 1080 },
            },
          });
        let fellBack = false;
        try {
          camStream = await req(id);
        } catch {
          camStream = await req(undefined);
          fellBack = true;
        }
        const savedLabel = read('tp.cam.label');
        if ((!id || fellBack) && savedLabel) {
          const match = (await navigator.mediaDevices.enumerateDevices()).find(
            d => d.kind === 'videoinput' && d.label === savedLabel,
          );
          const currentId = camStream.getVideoTracks()[0]?.getSettings().deviceId;
          if (match && match.deviceId !== currentId) {
            try {
              const nextStream = await req(match.deviceId);
              camStream.getTracks().forEach(t => t.stop());
              camStream = nextStream;
            } catch {}
          }
        }
        camView.srcObject = camStream;
        await listCams();
        cam.hidden = false;
        $('[data-cam-on]').hidden = true;
        updatePreviewPane();
      };
      navigator.mediaDevices?.addEventListener('devicechange', () => {
        if (camStream) listCams();
      });
      $('[data-cam-on]').addEventListener('click', () =>
        openCam(read('tp.cam') ?? undefined).catch(err => {
          stateEl.textContent = `Sin acceso a cámara (${err?.name || 'error'})`;
        }),
      );
      cam.addEventListener('change', () => {
        keep('tp.cam', cam.value);
        const label = cam.selectedOptions[0]?.text;
        if (label) keep('tp.cam.label', label);
        openCam(cam.value);
      });

      // ---------- Microphone (unprocessed mono) ----------
      const mic = $<HTMLSelectElement>('[data-mic]');
      let analyser: AnalyserNode | null = null;
      let micCtx: AudioContext | null = null;
      const openMic = async (id?: string) => {
        stream?.getTracks().forEach(t => t.stop());
        const req = (devId?: string) =>
          navigator.mediaDevices.getUserMedia({
            audio: {
              ...(devId ? { deviceId: { exact: devId } } : {}),
              echoCancellation: false,
              noiseSuppression: false,
              autoGainControl: false,
              channelCount: 1,
            },
          });
        let fellBack = false;
        try {
          stream = await req(id);
        } catch {
          stream = await req(undefined);
          fellBack = true;
        }
        const savedLabel = read('tp.mic.label');
        if ((!id || fellBack) && savedLabel) {
          const match = (await navigator.mediaDevices.enumerateDevices()).find(
            d => d.kind === 'audioinput' && d.label === savedLabel,
          );
          const currentId = stream.getAudioTracks()[0]?.getSettings().deviceId;
          if (match && match.deviceId !== currentId) {
            try {
              const nextStream = await req(match.deviceId);
              stream.getTracks().forEach(t => t.stop());
              stream = nextStream;
            } catch {}
          }
        }
        const devices = (await navigator.mediaDevices.enumerateDevices()).filter(
          d => d.kind === 'audioinput',
        );
        const current = stream.getAudioTracks()[0].getSettings().deviceId;
        mic.replaceChildren(
          ...devices.map(d => {
            const o = new Option(d.label || 'Micrófono', d.deviceId);
            o.selected = d.deviceId === current;
            return o;
          }),
        );
        mic.hidden = false;
        meterWrap.hidden = false;
        $('[data-mic-on]').hidden = true;
        micCtx?.close().catch(() => {});
        micCtx = new AudioContext();
        analyser = micCtx.createAnalyser();
        analyser.fftSize = 1024;
        micCtx.createMediaStreamSource(stream).connect(analyser);
      };
      $('[data-mic-on]').addEventListener('click', () =>
        openMic(read('tp.mic') ?? undefined).catch(err => {
          stateEl.textContent = `Sin acceso a micrófono (${err?.name || 'error'})`;
        }),
      );
      mic.addEventListener('change', () => {
        keep('tp.mic', mic.value);
        const label = mic.selectedOptions[0]?.text;
        if (label) keep('tp.mic.label', label);
        openMic(mic.value);
      });

      const level = new Float32Array(1024);
      const tick = () => {
        if (analyser) {
          analyser.getFloatTimeDomainData(level);
          let peak = 0;
          for (const v of level) peak = Math.max(peak, Math.abs(v));
          meter.style.width = `${Math.min(100, peak * 100)}%`;
          meter.classList.toggle('is-hot', peak > 0.95);
        }
        requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);

      // ---------- Full-Take Recording ----------
      let saveWhenDone = false;

      const record = async () => {
        if (mode === 'rec' || mode === 'count' || mode === 'saving') return;
        stopPlayback();
        if (!stream) {
          try {
            await openMic(read('tp.mic') ?? undefined);
          } catch (err: any) {
            stateEl.textContent = `Activa el micrófono primero (${err?.name || 'error'})`;
            return;
          }
        }
        mode = 'count';
        if (takeUrl) {
          URL.revokeObjectURL(takeUrl);
          takeUrl = null;
        }
        take = null;
        saveWhenDone = false;
        mark(0);
        sync();
        for (const n of [3, 2, 1]) {
          stateEl.textContent = `Empieza en ${n}…`;
          await new Promise(r => setTimeout(r, 600));
          if (mode !== 'count') return;
        }
        const chunks: Blob[] = [];
        const tracks = [
          ...stream!.getAudioTracks(),
          ...(camStream ? camStream.getVideoTracks() : []),
        ];
        const hasVideo = tracks.some(t => t.kind === 'video');
        const candidates = hasVideo
          ? [
              'video/webm;codecs=vp9,opus',
              'video/webm;codecs=vp8,opus',
              'video/webm',
              'video/mp4',
            ]
          : ['audio/webm;codecs=opus', 'audio/webm', 'audio/mp4'];
        const mimeType =
          candidates.find(m => MediaRecorder.isTypeSupported(m)) ?? '';
        recorder = new MediaRecorder(new MediaStream(tracks), {
          ...(mimeType ? { mimeType } : {}),
          audioBitsPerSecond: 256000,
          ...(hasVideo ? { videoBitsPerSecond: 8_000_000 } : {}),
        });
        recorder.ondataavailable = e => {
          if (e.data.size > 0) chunks.push(e.data);
        };
        recorder.onstop = () => {
          if (mode === 'idle') return;
          take = new Blob(chunks, {
            type: recorder?.mimeType || (hasVideo ? 'video/mp4' : 'audio/mp4'),
          });
          takeUrl = URL.createObjectURL(take);
          takeHasVideo = hasVideo;
          mode = 'done';
          mark(0);
          sync();
          if (saveWhenDone) {
            saveWhenDone = false;
            save();
          }
        };
        recorder.start();
        mode = 'rec';
        mark(0);
        sync();
      };

      const next = () => {
        if (mode !== 'rec') return;
        if (line + 1 >= Math.max(1, clip().ideas.length)) {
          saveWhenDone = true;
          recorder?.stop();
          return;
        }
        mark(line + 1);
        sync();
      };

      const stop = () => {
        if (mode === 'count') {
          mode = 'idle';
          sync();
          return;
        }
        if (mode !== 'rec') return;
        saveWhenDone = false;
        recorder?.stop();
      };

      const stopPlayback = () => {
        player.pause();
        savedVideo.pause();
        if (mode === 'play') {
          mode = take ? 'done' : 'idle';
          updatePreviewPane();
        }
      };

      player.addEventListener('ended', () => {
        stopPlayback();
        mark(0);
        sync();
      });

      const playTake = async () => {
        if (!take || !takeUrl || mode === 'rec' || mode === 'saving') return;
        stopPlayback();
        player.src = takeUrl;
        mode = 'play';
        if (!camStream && takeHasVideo) {
          savedVideo.src = takeUrl;
          savedVideo.currentTime = 0;
        }
        updatePreviewPane();
        sync();
        await Promise.all([
          player.play().catch(() => {}),
          !camStream && takeHasVideo ? savedVideo.play().catch(() => {}) : Promise.resolve(),
        ]);
      };

      const playCurrent = async () => {
        const c = clip();
        if (!c.audio || mode === 'rec' || mode === 'count' || mode === 'saving')
          return;
        stopPlayback();
        const bust = `?t=${Date.now()}`;
        player.src = `${c.audio}${bust}`;
        mode = 'play';
        if (!camStream && c.video) {
          savedVideo.src = `${c.video}${bust}`;
          savedVideo.currentTime = 0;
        }
        updatePreviewPane();
        sync();
        await Promise.all([
          player.play().catch(() => {}),
          !camStream && c.video ? savedVideo.play().catch(() => {}) : Promise.resolve(),
        ]);
      };

      const save = async () => {
        if (!take || mode === 'rec' || mode === 'saving') return;
        stopPlayback();
        mode = 'saving';
        btn('save').disabled = true;
        stateEl.textContent = 'Guardando video/audio y transcribiendo con Whisper…';
        const c = clip();
        const res = await fetch(
          `/__narration/save?key=${encodeURIComponent(c.key)}`,
          {
            method: 'POST',
            headers: { 'x-ideas': encodeURIComponent(JSON.stringify(c.ideas)) },
            body: take,
          },
        ).catch(() => new Response(null, { status: 503 }));
        btn('save').disabled = false;

        let out: {
          error?: string;
          m4a: string;
          hasVideo?: boolean;
          length: number;
          lines: string[];
        };
        try {
          out = await res.json();
        } catch {
          out = {
            error: `respuesta ${res.status}`,
            m4a: '',
            length: 0,
            lines: [],
          };
        }
        if (!res.ok || out.error) {
          mode = 'done';
          sync();
          stateEl.textContent = `No se pudo guardar (${out.error}). La toma sigue aquí: pulsa S otra vez.`;
          return;
        }
        c.status = 'new';
        c.audio = out.m4a;
        if (out.hasVideo) {
          c.hasVideo = true;
          c.video = `/media/narration/es/${c.key}.mp4`;
        }
        document
          .querySelector(`[data-pick="${CSS.escape(c.key)}"] [data-dot]`)
          ?.setAttribute('data-status', 'new');
        total();
        if (takeUrl) {
          URL.revokeObjectURL(takeUrl);
          takeUrl = null;
        }
        take = null;
        mode = 'idle';
        if (clip() === c) showSaid(out.lines);
        updatePreviewPane();
        sync();
        stateEl.textContent = `Guardado ✓ · ${out.length.toFixed(1)} s · L para escuchar`;
      };

      const acts: Record<string, () => unknown> = {
        record,
        next,
        stop,
        take: playTake,
        save,
        current: playCurrent,
      };
      document.querySelectorAll<HTMLButtonElement>('[data-act]').forEach(b =>
        b.addEventListener('click', () => {
          b.blur();
          acts[b.dataset.act!]?.();
        }),
      );
      document
        .querySelectorAll<HTMLButtonElement>('[data-pick]')
        .forEach((b, i) => b.addEventListener('click', () => select(i)));

      document.addEventListener('keydown', e => {
        if (e.target instanceof HTMLSelectElement || e.metaKey || e.ctrlKey)
          return;
        const k = e.key.toLowerCase();
        const map: Record<string, () => unknown> = {
          ' ': () =>
            mode === 'rec'
              ? next()
              : mode === 'play'
                ? (stopPlayback(), sync())
                : undefined,
          arrowright: next,
          enter: next,
          escape: () => (mode === 'play' ? (stopPlayback(), sync()) : stop()),
          r: () =>
            mode !== 'rec' && mode !== 'count' && mode !== 'saving' && record(),
          p: playTake,
          s: save,
          l: playCurrent,
          arrowdown: () => select(index + 1),
          arrowup: () => select(index - 1),
        };
        if (map[k]) {
          e.preventDefault();
          map[k]();
        }
      });

      total();
      select(index);
    </script>

    <style is:global>
