---
import fs from 'node:fs';
import path from 'node:path';
import { SCRIPTS_EN, SCRIPTS_ES } from '../../lib/scripts';
import '../../styles/global.css';

/**
 * DEV ONLY — /dev/teleprompter.
 *
 * Bilingual (ES + EN) full-take recording studio. Records camera (9:16
 * vertical crop) + microphone into `public/media/narration/{lang}/{key}.mp4`
 * + `{key}.m4a` and transcribes word timings into
 * `src/data/narration/{key}.words.json` (ES) / `{key}.en.words.json` (EN) via
 * `scripts/narration-recorder.mjs`.
 *
 * Saving an ES take immediately translates the Spanish transcript into English
 * (`narration-takes/en/{key}.draft.txt`) so Juan can flip to EN (`E`) and
 * record the matching English take right away, section by section.
 *
 * In a production build this route has no paths, so it does not exist.
 */
export const getStaticPaths = () =>
  import.meta.env.PROD ? [] : [{ params: { tool: 'teleprompter' } }];

const ROOT = process.cwd();
const hasFile = (rel: string) => fs.existsSync(path.join(ROOT, rel));
const mtimeOf = (rel: string) => {
  const full = path.join(ROOT, rel);
  return fs.existsSync(full) ? fs.statSync(full).mtimeMs : 0;
};
const readText = (rel: string) => {
  const full = path.join(ROOT, rel);
  return fs.existsSync(full) ? fs.readFileSync(full, 'utf8').trim() : '';
};

const enByKey = new Map(SCRIPTS_EN.map(c => [c.key, c]));

const langInfo = (key: string, lang: 'es' | 'en', ideas: string[]) => {
  const hasAudio = hasFile(`public/media/narration/${lang}/${key}.m4a`);
  const hasVideo = hasFile(`public/media/narration/${lang}/${key}.mp4`);
  const wordsFile =
    lang === 'es'
      ? `src/data/narration/${key}.words.json`
      : `src/data/narration/${key}.${lang}.words.json`;
  const hasWords = hasFile(wordsFile);
  const status: 'new' | 'old' | 'none' =
    hasAudio && hasWords ? 'new' : hasAudio ? 'old' : 'none';
  const esVttMtime = mtimeOf(`public/media/narration/es/${key}.vtt`);
  const enDraftRel = `narration-takes/en/${key}.draft.txt`;
  const enDraftMtime = mtimeOf(enDraftRel);
  return {
    status,
    hasVideo,
    audio: hasAudio ? `/media/narration/${lang}/${key}.m4a` : null,
    video: hasVideo ? `/media/narration/${lang}/${key}.mp4` : null,
    ideas,
    ...(lang === 'en'
      ? {
          draftText: readText(enDraftRel),
          staleDraft: esVttMtime > 0 && esVttMtime > enDraftMtime,
        }
      : {}),
  };
};

const list = SCRIPTS_ES.map(c => ({
  key: c.key,
  where: c.where,
  shot: c.shot,
  draft: c.draft,
  es: langInfo(c.key, 'es', c.ideas),
  en: langInfo(c.key, 'en', enByKey.get(c.key)?.ideas ?? []),
}));
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Teleprompter · ES / EN</title>
  </head>
  <body>
    <aside class="list">
      <div class="list-head">
        <p class="label">Guiones (ES · EN)</p>
        <p class="total" data-total></p>
      </div>

      <ol>
        {list.map(c => (
          <li>
            <button type="button" data-pick={c.key}>
              <span class="dots" aria-hidden="true">
                <span class="dot" data-dot="es" data-status={c.es.status} title="Español" />
                <span class="dot" data-dot="en" data-status={c.en.status} title="English" />
              </span>
              <span class="row-main">
                <span class="where">{c.where}</span>
                <span class="key">{c.key}</span>
              </span>
            </button>
          </li>
        ))}
      </ol>

      <p class="legend">
        <span><span class="dot" data-status="new" /> grabado (izq ES · der EN)</span>
        <span><span class="dot" data-status="none" /> pendiente</span>
      </p>
    </aside>

    <main>
      <header class="top">
        <div class="top-left">
          <div class="top-title-row">
            <p class="label" data-where></p>
            <div class="lang-switch" role="group" aria-label="Idioma de grabación">
              <button type="button" data-lang-btn="es">ES</button>
              <button type="button" data-lang-btn="en">EN</button>
            </div>
          </div>
          <p class="key" data-key></p>
          <p class="draft" data-draft hidden></p>
        </div>

        <div class="mic">
          <button type="button" class="pick-mic" data-cam-on>Activar cámara (9:16)</button>
          <select data-cam aria-label="Cámara" hidden></select>
          <button type="button" class="pick-mic" data-mic-on>Activar micrófono</button>
          <select data-mic aria-label="Micrófono" hidden></select>
          <span class="meter" data-meter-wrap hidden><span data-meter></span></span>
        </div>
      </header>

      <div class="stage" data-stage>
        <div class="col">
          <div class="en-bar" data-en-bar hidden>
            <span class="label" data-en-source>Guion en inglés</span>
            <div class="en-bar-actions">
              <button type="button" class="mini-btn" data-retranslate>
                Re-traducir desde ES
              </button>
            </div>
          </div>

          <div class="lines" data-lines></div>

          <textarea
            class="en-editor"
            data-en-editor
            hidden
            rows="6"
            placeholder="Graba primero en español o escribe/edita aquí lo que vas a decir en inglés…"
          ></textarea>

          <div class="en-preview" data-en-preview hidden>
            <div class="en-preview-head">
              <p class="label">Traducción lista para inglés</p>
              <button type="button" class="mini-btn is-accent" data-go-en>
                Grabar en inglés → <kbd>E</kbd>
              </button>
            </div>
            <p class="en-preview-text" data-en-preview-text></p>
          </div>

          <div class="said" data-said hidden>
            <p class="label" data-said-label>Transcripción guardada</p>
            <p class="said-text" data-said-text></p>
          </div>

          <div class="ref-es" data-ref-es hidden>
            <p class="label">Referencia · última toma en español</p>
            <p class="said-text" data-ref-es-text></p>
          </div>
        </div>

        <div class="stage-side">
          <div class="preview-wrap" data-preview-wrap hidden>
            <video class="cam-mirror" data-cam-view autoplay muted playsinline hidden></video>
            <video class="saved-vid" data-saved-video muted playsinline hidden></video>
          </div>
          <img class="shot" data-shot alt="" hidden />
        </div>
      </div>

      <footer class="controls">
        <div class="controls-row">
          <div class="buttons">
            <button type="button" data-act="record">Grabar <kbd>R</kbd></button>
            <button type="button" data-act="next" hidden>
              Terminar y guardar <kbd>espacio</kbd>
            </button>
            <button type="button" data-act="stop" hidden>Cancelar <kbd>esc</kbd></button>
            <button type="button" data-act="take" hidden>Escuchar toma <kbd>P</kbd></button>
            <button type="button" data-act="save" hidden>Guardar <kbd>S</kbd></button>
            <button type="button" data-act="current" hidden>
              Escuchar guardado <kbd>L</kbd>
            </button>
            <button type="button" data-act="flip" hidden>
              Cambiar a inglés <kbd>E</kbd>
            </button>
            <button type="button" data-act="nextClip" hidden>
              Siguiente sección (ES) <kbd>N</kbd>
            </button>
          </div>
          <p class="state" data-state></p>
        </div>
        <p class="hint">
          <kbd>↑</kbd><kbd>↓</kbd> sección · <kbd>E</kbd> alternar ES/EN ·
          <kbd>R</kbd> grabar · <kbd>espacio</kbd> terminar y guardar ·
          guardar en ES traduce al instante para grabar EN
        </p>
      </footer>
    </main>

    <script is:inline type="application/json" id="clips" set:html={JSON.stringify(list)} />

    <script>
      type Lang = 'es' | 'en';
      type LangTrack = {
        status: 'new' | 'old' | 'none';
        hasVideo: boolean;
        audio: string | null;
        video: string | null;
        ideas: string[];
        draftText?: string;
        staleDraft?: boolean;
      };
      type Clip = {
        key: string;
        where: string;
        shot?: string;
        draft?: string;
        es: LangTrack;
        en: LangTrack;
      };

      const clips: Clip[] = JSON.parse(
        document.getElementById('clips')!.textContent!,
      );
      const read = (k: string) => {
        try {
          return localStorage.getItem(k);
        } catch {
          return null;
        }
      };
      const keep = (k: string, v: string) => {
        try {
          localStorage.setItem(k, v);
        } catch {}
      };

      const $ = <T extends HTMLElement>(s: string) =>
        document.querySelector<T>(s)!;
      const stageEl = $('[data-stage]');
      const linesEl = $('[data-lines]');
      const enBar = $('[data-en-bar]');
      const enSource = $('[data-en-source]');
      const enEditor = $<HTMLTextAreaElement>('[data-en-editor]');
      const enPreview = $('[data-en-preview]');
      const enPreviewText = $('[data-en-preview-text]');
      const saidEl = $('[data-said]');
      const saidLabel = $('[data-said-label]');
      const saidText = $('[data-said-text]');
      const refEsEl = $('[data-ref-es]');
      const refEsText = $('[data-ref-es-text]');
      const stateEl = $('[data-state]');
      const previewWrap = $('[data-preview-wrap]');
      const camView = $<HTMLVideoElement>('[data-cam-view]');
      const savedVideo = $<HTMLVideoElement>('[data-saved-video]');
      const shot = $<HTMLImageElement>('[data-shot]');
      const meterWrap = $('[data-meter-wrap]');
      const meter = $('[data-meter]');
      const btn = (a: string) => $<HTMLButtonElement>(`[data-act="${a}"]`);

      const syncVideoFit = () => {
        const avail = Math.max(180, stageEl.clientHeight - 36);
        stageEl.style.setProperty('--stage-avail-h', `${avail}px`);
      };
      new ResizeObserver(syncVideoFit).observe(stageEl);
      syncVideoFit();

      const secs = (s: string) => (s.length * 1.2) / 14 + 0.5;
      const fmt = (s: number) =>
        `${Math.floor(s / 60)}:${String(Math.round(s % 60)).padStart(2, '0')}`;

      let index = Math.max(
        0,
        clips.findIndex(c => c.key === read('tp.key')),
      );
      let lang: Lang = read('tp.lang') === 'en' ? 'en' : 'es';
      let mode: 'idle' | 'count' | 'rec' | 'done' | 'play' | 'saving' = 'idle';
      let take: Blob | null = null;
      let takeUrl: string | null = null;
      let takeHasVideo = false;
      let recorder: MediaRecorder | null = null;
      let camStream: MediaStream | null = null;
      let stream: MediaStream | null = null;
      let recStartAt = 0;
      let recTimer = 0;
      const player = new Audio();

      const clip = () => clips[index];
      const track = (c: Clip = clip(), l: Lang = lang) => c[l];

      const enScriptText = (c: Clip) =>
        c.en.draftText?.trim() || c.en.ideas.join(' ').trim();

      const activeIdeas = (c: Clip = clip(), l: Lang = lang): string[] => {
        if (l === 'en') {
          const t = enScriptText(c);
          return t ? [t] : [];
        }
        return c.es.ideas;
      };

      const total = () => {
        const esDone = clips.filter(c => c.es.status === 'new').length;
        const enDone = clips.filter(c => c.en.status === 'new').length;
        $('[data-total]').textContent =
          `ES ${esDone}/${clips.length} · EN ${enDone}/${clips.length}`;
      };

      const showSaid = (lines: string[], l: Lang = lang) => {
        saidEl.hidden = !lines.length;
        saidLabel.textContent =
          l === 'en'
            ? 'Transcripción guardada (EN)'
            : 'Transcripción guardada (ES)';
        saidText.textContent = lines.join(' ');
      };

      const showRefEs = (lines: string[]) => {
        refEsEl.hidden = lang !== 'en' || !lines.length;
        refEsText.textContent = lines.join(' ');
      };

      const showEnPreview = (text: string) => {
        const clean = text.trim();
        enPreview.hidden = lang !== 'es' || !clean;
        enPreviewText.textContent = clean;
      };

      const readVtt = async (key: string, l: Lang): Promise<string[]> => {
        const res = await fetch(
          `/media/narration/${l}/${key}.vtt?t=${Date.now()}`,
        ).catch(() => null);
        if (!res?.ok) return [];
        const lines: string[] = [];
        for (const block of (await res.text()).split(/\n\n+/)) {
          const m = block.match(/(\d+):(\d+):([\d.]+)\s*-->.*\n([\s\S]+)/);
          if (m) lines.push(m[4].trim());
        }
        return lines;
      };

      const autoSizeEditor = () => {
        enEditor.style.height = 'auto';
        enEditor.style.height = `${Math.max(120, enEditor.scrollHeight + 4)}px`;
      };

      const renderScript = () => {
        const c = clip();
        const isEn = lang === 'en';
        enBar.hidden = !isEn;
        if (isEn) {
          enSource.textContent = c.en.draftText?.trim()
            ? 'Guion EN · traducido de tu última toma ES (editable)'
            : 'Guion EN · texto actual en ui.ts (editable)';
          if (mode === 'rec' || mode === 'count') {
            enEditor.hidden = true;
            linesEl.hidden = false;
            const ideas = activeIdeas(c, 'en');
            linesEl.replaceChildren(
              ...(ideas.length
                ? ideas
                : ['(Sin guion EN aún — habla libremente o graba ES primero)']
              ).map((text, i) => {
                const p = document.createElement('p');
                p.textContent = text;
                p.dataset.i = String(i);
                return p;
              }),
            );
          } else {
            linesEl.hidden = true;
            enEditor.hidden = false;
            enEditor.value = enScriptText(c);
            autoSizeEditor();
          }
          enPreview.hidden = true;
          return;
        }

        enEditor.hidden = true;
        linesEl.hidden = false;
        const ideas = c.es.ideas;
        if (!ideas.length) {
          const p = document.createElement('p');
          p.textContent =
            'Sin texto base aún en src/i18n/ui.ts — puedes grabar libremente y usar la transcripción guardada.';
          linesEl.replaceChildren(p);
        } else {
          linesEl.replaceChildren(
            ...ideas.map((text, i) => {
              const p = document.createElement('p');
              p.textContent = text;
              p.dataset.i = String(i);
              return p;
            }),
          );
        }
        showEnPreview(c.en.draftText ?? '');
      };

      const mark = (i: number) => {
        linesEl.querySelectorAll('p').forEach((p, j) => {
          p.classList.toggle('is-past', j < i);
          p.classList.toggle('is-now', j === i);
        });
      };

      const updatePreviewPane = () => {
        const c = clip();
        const tr = track(c);
        if (camStream) {
          previewWrap.hidden = false;
          camView.hidden = false;
          savedVideo.hidden = true;
          shot.hidden = true;
          return;
        }
        camView.hidden = true;
        if (mode === 'play' && ((take && takeHasVideo) || (!take && tr.video))) {
          previewWrap.hidden = false;
          savedVideo.hidden = false;
          shot.hidden = true;
          return;
        }
        savedVideo.hidden = true;
        previewWrap.hidden = true;
        if (c.shot) {
          shot.src = c.shot;
          shot.hidden = false;
        } else {
          shot.hidden = true;
        }
      };

      const updateLangButtons = () => {
        document
          .querySelectorAll<HTMLButtonElement>('[data-lang-btn]')
          .forEach(b =>
            b.classList.toggle('is-active', b.dataset.langBtn === lang),
          );
      };

      const updateHeaderMeta = () => {
        const c = clip();
        const tr = track(c);
        const ideas = activeIdeas(c);
        const est = fmt(ideas.reduce((t, l) => t + secs(l), 0));
        $('[data-where]').textContent = c.where;
        $('[data-key]').textContent =
          `${c.key} · ${lang.toUpperCase()} · ~${est} · ${tr.status === 'new' ? 'grabado ✓' : 'pendiente'}`;
        const draft = $('[data-draft]');
        draft.textContent = c.draft ?? '';
        draft.hidden = !c.draft;
      };

      const loadTranscripts = async (c: Clip, l: Lang) => {
        showSaid([], l);
        showRefEs([]);
        const tr = track(c, l);
        if (tr.status === 'new') {
          const lines = await readVtt(c.key, l);
          if (clip() === c && lang === l) showSaid(lines, l);
        }
        if (l === 'en' && c.es.status === 'new') {
          const esLines = await readVtt(c.key, 'es');
          if (clip() === c && lang === 'en') showRefEs(esLines);
        }
      };

      const select = async (i: number, nextLang: Lang = lang) => {
        if (mode === 'rec' || mode === 'count' || mode === 'saving') return;
        stopPlayback();
        index = (i + clips.length) % clips.length;
        lang = nextLang;
        const c = clip();
        keep('tp.key', c.key);
        keep('tp.lang', lang);
        if (takeUrl) {
          URL.revokeObjectURL(takeUrl);
          takeUrl = null;
        }
        take = null;
        takeHasVideo = false;
        mode = 'idle';

        updateLangButtons();
        updateHeaderMeta();

        document
          .querySelectorAll<HTMLElement>('[data-pick]')
          .forEach(b => b.classList.toggle('is-on', b.dataset.pick === c.key));
        document.querySelector('.is-on')?.scrollIntoView({ block: 'nearest' });

        renderScript();
        mark(0);
        updatePreviewPane();
        sync();
        if (lang === 'en' && c.es.status === 'new' && c.en.staleDraft) {
          translateFromEs(c);
        }
        await loadTranscripts(c, lang);
      };

      const setLang = (nextLang: Lang) => {
        if (nextLang === lang) return;
        select(index, nextLang);
      };

      const flipLang = () => setLang(lang === 'es' ? 'en' : 'es');

      const nextSectionEs = () => select(index + 1, 'es');

      const updateRecTimer = () => {
        if (mode !== 'rec') return;
        const elapsed = (performance.now() - recStartAt) / 1000;
        const prefix = camStream
          ? `● Grabando ${lang.toUpperCase()} (9:16 + audio)`
          : `● Grabando ${lang.toUpperCase()} (solo audio)`;
        stateEl.textContent = `${prefix} · ${fmt(elapsed)}`;
      };

      const sync = () => {
        const c = clip();
        const tr = track(c);
        const busy = mode === 'rec' || mode === 'count' || mode === 'saving';
        btn('record').hidden = busy;
        btn('record').firstChild!.textContent = take
          ? `Repetir ${lang.toUpperCase()} `
          : `Grabar ${lang.toUpperCase()} `;
        btn('next').hidden = mode !== 'rec';
        btn('next').firstChild!.textContent = 'Terminar y guardar ';
        btn('stop').hidden = mode !== 'rec' && mode !== 'count';
        btn('take').hidden = !take || mode === 'rec' || mode === 'saving';
        btn('save').hidden = !take || mode === 'rec' || mode === 'saving';
        btn('current').hidden = !tr.audio || busy;
        btn('flip').hidden = busy;
        btn('flip').firstChild!.textContent =
          lang === 'es' ? 'Pasar a inglés ' : 'Volver a español ';
        btn('nextClip').hidden = busy || lang !== 'en';
        linesEl.classList.toggle('is-rec', mode === 'rec');

        if (mode === 'idle') {
          stateEl.textContent =
            tr.status === 'new'
              ? `${lang.toUpperCase()} grabado ✓ · L para escuchar · R para regrabar`
              : `${lang.toUpperCase()} pendiente · activa cámara/micrófono y pulsa R`;
        } else if (mode === 'rec') {
          updateRecTimer();
        } else if (mode === 'done') {
          stateEl.textContent = 'Toma lista · P para revisar o S para guardar';
        } else if (mode === 'play') {
          stateEl.textContent = 'Reproduciendo… (Espacio para parar)';
        }
      };

      // ---------- EN draft auto-save + re-translate ----------
      let draftSaveTimer = 0;
      const persistDraft = async (key: string, text: string) => {
        await fetch(`/__narration/draft?key=${encodeURIComponent(key)}`, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ text }),
        }).catch(() => {});
      };
      enEditor.addEventListener('input', () => {
        autoSizeEditor();
        const c = clip();
        c.en.draftText = enEditor.value;
        enSource.textContent = 'Guion EN · editado (guardado automático)';
        clearTimeout(draftSaveTimer);
        draftSaveTimer = window.setTimeout(
          () => persistDraft(c.key, enEditor.value),
          450,
        );
      });

      const translateFromEs = async (c: Clip) => {
        stateEl.textContent = 'Traduciendo última toma en español…';
        const res = await fetch('/__narration/translate', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ key: c.key }),
        }).catch(() => null);
        const out = res?.ok ? await res.json().catch(() => null) : null;
        if (out?.translation) {
          c.en.draftText = out.translation;
          c.en.staleDraft = false;
          if (clip() === c && lang === 'en') {
            enEditor.value = out.translation;
            autoSizeEditor();
            enSource.textContent =
              'Guion EN · traducido de tu última toma ES (editable)';
            stateEl.textContent = 'Traducido ✓ · revisa el texto y pulsa R';
          }
        } else if (clip() === c && lang === 'en') {
          stateEl.textContent =
            'No se pudo traducir (verifica toma ES guardada o conexión).';
        }
      };

      $('[data-retranslate]').addEventListener('click', () =>
        translateFromEs(clip()),
      );

      $('[data-go-en]').addEventListener('click', () => setLang('en'));
      document
        .querySelectorAll<HTMLButtonElement>('[data-lang-btn]')
        .forEach(b =>
          b.addEventListener('click', () =>
            setLang(b.dataset.langBtn as Lang),
          ),
        );

      // ---------- Camera (9:16 live mirror) ----------
      const cam = $<HTMLSelectElement>('[data-cam]');
      const listCams = async () => {
        const devices = (await navigator.mediaDevices.enumerateDevices()).filter(
          d => d.kind === 'videoinput',
        );
        const current = camStream?.getVideoTracks()[0]?.getSettings().deviceId;
        cam.replaceChildren(
          ...devices.map(d => {
            const o = new Option(d.label || 'Cámara', d.deviceId);
            o.selected = d.deviceId === current;
            return o;
          }),
        );
      };
      const openCam = async (id?: string) => {
        camStream?.getTracks().forEach(t => t.stop());
        const req = (devId?: string) =>
          navigator.mediaDevices.getUserMedia({
            video: {
              ...(devId ? { deviceId: { exact: devId } } : {}),
              width: { ideal: 1920 },
              height: { ideal: 1080 },
            },
          });
        let fellBack = false;
        try {
          camStream = await req(id);
        } catch {
          camStream = await req(undefined);
          fellBack = true;
        }
        const savedLabel = read('tp.cam.label');
        if ((!id || fellBack) && savedLabel) {
          const match = (await navigator.mediaDevices.enumerateDevices()).find(
            d => d.kind === 'videoinput' && d.label === savedLabel,
          );
          const currentId = camStream.getVideoTracks()[0]?.getSettings().deviceId;
          if (match && match.deviceId !== currentId) {
            try {
              const nextStream = await req(match.deviceId);
              camStream.getTracks().forEach(t => t.stop());
              camStream = nextStream;
            } catch {}
          }
        }
        camView.srcObject = camStream;
        await listCams();
        cam.hidden = false;
        $('[data-cam-on]').hidden = true;
        updatePreviewPane();
      };
      navigator.mediaDevices?.addEventListener('devicechange', () => {
        if (camStream) listCams();
      });
      $('[data-cam-on]').addEventListener('click', () =>
        openCam(read('tp.cam') ?? undefined).catch(err => {
          stateEl.textContent = `Sin acceso a cámara (${err?.name || 'error'})`;
        }),
      );
      cam.addEventListener('change', () => {
        keep('tp.cam', cam.value);
        const label = cam.selectedOptions[0]?.text;
        if (label) keep('tp.cam.label', label);
        openCam(cam.value);
      });

      // ---------- Microphone (unprocessed mono) ----------
      const mic = $<HTMLSelectElement>('[data-mic]');
      let analyser: AnalyserNode | null = null;
      let micCtx: AudioContext | null = null;
      const openMic = async (id?: string) => {
        stream?.getTracks().forEach(t => t.stop());
        const req = (devId?: string) =>
          navigator.mediaDevices.getUserMedia({
            audio: {
              ...(devId ? { deviceId: { exact: devId } } : {}),
              echoCancellation: false,
              noiseSuppression: false,
              autoGainControl: false,
              channelCount: 1,
            },
          });
        let fellBack = false;
        try {
          stream = await req(id);
        } catch {
          stream = await req(undefined);
          fellBack = true;
        }
        const savedLabel = read('tp.mic.label');
        if ((!id || fellBack) && savedLabel) {
          const match = (await navigator.mediaDevices.enumerateDevices()).find(
            d => d.kind === 'audioinput' && d.label === savedLabel,
          );
          const currentId = stream.getAudioTracks()[0]?.getSettings().deviceId;
          if (match && match.deviceId !== currentId) {
            try {
              const nextStream = await req(match.deviceId);
              stream.getTracks().forEach(t => t.stop());
              stream = nextStream;
            } catch {}
          }
        }
        const devices = (await navigator.mediaDevices.enumerateDevices()).filter(
          d => d.kind === 'audioinput',
        );
        const current = stream.getAudioTracks()[0].getSettings().deviceId;
        mic.replaceChildren(
          ...devices.map(d => {
            const o = new Option(d.label || 'Micrófono', d.deviceId);
            o.selected = d.deviceId === current;
            return o;
          }),
        );
        mic.hidden = false;
        meterWrap.hidden = false;
        $('[data-mic-on]').hidden = true;
        micCtx?.close().catch(() => {});
        micCtx = new AudioContext();
        analyser = micCtx.createAnalyser();
        analyser.fftSize = 1024;
        micCtx.createMediaStreamSource(stream).connect(analyser);
      };
      $('[data-mic-on]').addEventListener('click', () =>
        openMic(read('tp.mic') ?? undefined).catch(err => {
          stateEl.textContent = `Sin acceso a micrófono (${err?.name || 'error'})`;
        }),
      );
      mic.addEventListener('change', () => {
        keep('tp.mic', mic.value);
        const label = mic.selectedOptions[0]?.text;
        if (label) keep('tp.mic.label', label);
        openMic(mic.value);
      });

      const level = new Float32Array(1024);
      const tick = () => {
        if (analyser) {
          analyser.getFloatTimeDomainData(level);
          let peak = 0;
          for (const v of level) peak = Math.max(peak, Math.abs(v));
          meter.style.width = `${Math.min(100, peak * 100)}%`;
          meter.classList.toggle('is-hot', peak > 0.95);
        }
        requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);

      // ---------- Full-Take Recording ----------
      let saveWhenDone = false;

      const record = async () => {
        if (mode === 'rec' || mode === 'count' || mode === 'saving') return;
        stopPlayback();
        if (!stream) {
          try {
            await openMic(read('tp.mic') ?? undefined);
          } catch (err: any) {
            stateEl.textContent = `Activa el micrófono primero (${err?.name || 'error'})`;
            return;
          }
        }
        mode = 'count';
        if (takeUrl) {
          URL.revokeObjectURL(takeUrl);
          takeUrl = null;
        }
        take = null;
        saveWhenDone = false;
        renderScript();
        mark(0);
        sync();
        for (const n of [3, 2, 1]) {
          stateEl.textContent = `Empieza ${lang.toUpperCase()} en ${n}…`;
          await new Promise(r => setTimeout(r, 600));
          if (mode !== 'count') return;
        }
        const chunks: Blob[] = [];
        const tracks = [
          ...stream!.getAudioTracks(),
          ...(camStream ? camStream.getVideoTracks() : []),
        ];
        const hasVideo = tracks.some(t => t.kind === 'video');
        const candidates = hasVideo
          ? [
              'video/webm;codecs=vp9,opus',
              'video/webm;codecs=vp8,opus',
              'video/webm',
              'video/mp4',
            ]
          : ['audio/webm;codecs=opus', 'audio/webm', 'audio/mp4'];
        const mimeType =
          candidates.find(m => MediaRecorder.isTypeSupported(m)) ?? '';
        recorder = new MediaRecorder(new MediaStream(tracks), {
          ...(mimeType ? { mimeType } : {}),
          audioBitsPerSecond: 256000,
          ...(hasVideo ? { videoBitsPerSecond: 8_000_000 } : {}),
        });
        recorder.ondataavailable = e => {
          if (e.data.size > 0) chunks.push(e.data);
        };
        recorder.onstop = () => {
          clearInterval(recTimer);
          if (mode === 'idle') return;
          take = new Blob(chunks, {
            type: recorder?.mimeType || (hasVideo ? 'video/mp4' : 'audio/mp4'),
          });
          takeUrl = URL.createObjectURL(take);
          takeHasVideo = hasVideo;
          mode = 'done';
          renderScript();
          mark(0);
          sync();
          if (saveWhenDone) {
            saveWhenDone = false;
            save();
          }
        };
        recorder.start();
        mode = 'rec';
        recStartAt = performance.now();
        clearInterval(recTimer);
        recTimer = window.setInterval(updateRecTimer, 250);
        renderScript();
        mark(0);
        sync();
      };

      const next = () => {
        if (mode !== 'rec') return;
        saveWhenDone = true;
        recorder?.stop();
      };

      const stop = () => {
        if (mode === 'count') {
          mode = 'idle';
          renderScript();
          sync();
          return;
        }
        if (mode !== 'rec') return;
        saveWhenDone = false;
        recorder?.stop();
      };

      const stopPlayback = () => {
        player.pause();
        savedVideo.pause();
        if (mode === 'play') {
          mode = take ? 'done' : 'idle';
          updatePreviewPane();
        }
      };

      player.addEventListener('ended', () => {
        stopPlayback();
        mark(0);
        sync();
      });

      const playTake = async () => {
        if (!take || !takeUrl || mode === 'rec' || mode === 'saving') return;
        stopPlayback();
        player.src = takeUrl;
        mode = 'play';
        if (!camStream && takeHasVideo) {
          savedVideo.src = takeUrl;
          savedVideo.currentTime = 0;
        }
        updatePreviewPane();
        sync();
        await Promise.all([
          player.play().catch(() => {}),
          !camStream && takeHasVideo
            ? savedVideo.play().catch(() => {})
            : Promise.resolve(),
        ]);
      };

      const playCurrent = async () => {
        const tr = track();
        if (!tr.audio || mode === 'rec' || mode === 'count' || mode === 'saving')
          return;
        stopPlayback();
        const bust = `?t=${Date.now()}`;
        player.src = `${tr.audio}${bust}`;
        mode = 'play';
        if (!camStream && tr.video) {
          savedVideo.src = `${tr.video}${bust}`;
          savedVideo.currentTime = 0;
        }
        updatePreviewPane();
        sync();
        await Promise.all([
          player.play().catch(() => {}),
          !camStream && tr.video
            ? savedVideo.play().catch(() => {})
            : Promise.resolve(),
        ]);
      };

      const save = async () => {
        if (!take || mode === 'rec' || mode === 'saving') return;
        stopPlayback();
        mode = 'saving';
        btn('save').disabled = true;
        const c = clip();
        const saveLang = lang;
        stateEl.textContent =
          saveLang === 'es'
            ? 'Guardando ES, transcribiendo con Whisper y traduciendo a inglés…'
            : 'Guardando EN y transcribiendo con Whisper…';
        const res = await fetch(
          `/__narration/save?key=${encodeURIComponent(c.key)}&lang=${saveLang}`,
          {
            method: 'POST',
            headers: {
              'x-ideas': encodeURIComponent(
                JSON.stringify(activeIdeas(c, saveLang)),
              ),
            },
            body: take,
          },
        ).catch(() => new Response(null, { status: 503 }));
        btn('save').disabled = false;

        let out: {
          error?: string;
          m4a: string;
          video?: string | null;
          hasVideo?: boolean;
          length: number;
          lines: string[];
          translation?: string;
        };
        try {
          out = await res.json();
        } catch {
          out = {
            error: `respuesta ${res.status}`,
            m4a: '',
            length: 0,
            lines: [],
          };
        }
        if (!res.ok || out.error) {
          mode = 'done';
          sync();
          stateEl.textContent = `No se pudo guardar (${out.error}). La toma sigue aquí: pulsa S otra vez.`;
          return;
        }
        const tr = track(c, saveLang);
        tr.status = 'new';
        tr.audio = out.m4a;
        if (out.hasVideo) {
          tr.hasVideo = true;
          tr.video = out.video ?? `/media/narration/${saveLang}/${c.key}.mp4`;
        }
        if (saveLang === 'es') {
          if (out.translation) {
            c.en.draftText = out.translation;
            c.en.staleDraft = false;
          } else {
            c.en.staleDraft = true;
          }
        }
        document
          .querySelector(
            `[data-pick="${CSS.escape(c.key)}"] [data-dot="${saveLang}"]`,
          )
          ?.setAttribute('data-status', 'new');
        total();
        if (takeUrl) {
          URL.revokeObjectURL(takeUrl);
          takeUrl = null;
        }
        take = null;
        mode = 'idle';
        if (clip() === c && lang === saveLang) {
          showSaid(out.lines, saveLang);
          if (saveLang === 'es' && out.translation) {
            showEnPreview(out.translation);
          }
          updateHeaderMeta();
        }
        updatePreviewPane();
        sync();
        stateEl.textContent =
          saveLang === 'es'
            ? `ES guardado ✓ · ${out.length.toFixed(1)} s · ${out.translation ? 'traducción lista → pulsa E para grabar inglés' : 'L para escuchar'}`
            : `EN guardado ✓ · ${out.length.toFixed(1)} s · pulsa N para siguiente sección en ES`;
      };

      const acts: Record<string, () => unknown> = {
        record,
        next,
        stop,
        take: playTake,
        save,
        current: playCurrent,
        flip: flipLang,
        nextClip: nextSectionEs,
      };
      document.querySelectorAll<HTMLButtonElement>('[data-act]').forEach(b =>
        b.addEventListener('click', () => {
          b.blur();
          acts[b.dataset.act!]?.();
        }),
      );
      document
        .querySelectorAll<HTMLButtonElement>('[data-pick]')
        .forEach((b, i) => b.addEventListener('click', () => select(i)));

      document.addEventListener('keydown', e => {
        if (e.metaKey || e.ctrlKey) return;
        if (
          e.target instanceof HTMLTextAreaElement ||
          e.target instanceof HTMLInputElement
        ) {
          if (e.key === 'Escape') (e.target as HTMLElement).blur();
          return;
        }
        if (e.target instanceof HTMLSelectElement) return;
        const k = e.key.toLowerCase();
        const map: Record<string, () => unknown> = {
          ' ': () =>
            mode === 'rec'
              ? next()
              : mode === 'play'
                ? (stopPlayback(), sync())
                : undefined,
          arrowright: next,
          enter: next,
          escape: () => (mode === 'play' ? (stopPlayback(), sync()) : stop()),
          r: () =>
            mode !== 'rec' && mode !== 'count' && mode !== 'saving' && record(),
          p: playTake,
          s: save,
          l: playCurrent,
          e: () =>
            mode !== 'rec' && mode !== 'count' && mode !== 'saving' && flipLang(),
          n: () =>
            mode !== 'rec' &&
            mode !== 'count' &&
            mode !== 'saving' &&
            nextSectionEs(),
          arrowdown: () => select(index + 1),
          arrowup: () => select(index - 1),
        };
        if (map[k]) {
          e.preventDefault();
          map[k]();
        }
      });

      total();
      select(index, lang);
    </script>

