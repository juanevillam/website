      }
      .lines.is-rec .kp.is-now {
        background: color-mix(in srgb, var(--surface) 92%, transparent);
        border-color: var(--ink-3);
        opacity: 1;
      }
      .lines.is-rec .kp.is-next {
        opacity: 0.88;
      }
      .kp-meta {
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
        font-family: var(--font-mono);
        font-size: 0.72rem;
        font-variant-numeric: tabular-nums;
        color: var(--ink-3);
        user-select: none;
      }
      .kp.is-entry .kp-time::before {
        content: '▶ ';
        color: #7cd4ff;
      }
      .kp-breath {
        position: relative;
        display: inline-flex;
        align-items: center;
        padding: 0.12rem 0.4rem;
        border-radius: 999px;
        border: 1px solid var(--hairline);
        background: var(--ground);
        overflow: hidden;
        width: fit-content;
      }
      .kp-breath-fill {
        position: absolute;
        inset: 0 auto 0 0;
        width: 0%;
        background: rgba(124, 212, 255, 0.28);
      }
      .kp-breath-lbl {
        position: relative;
        z-index: 1;
        font-size: 0.64rem;
        color: #9ddfff;
      }
      .kp-words {
        font-size: clamp(1.3rem, 1.9vw, 1.68rem);
        line-height: 1.42;
        letter-spacing: var(--track-heading);
        color: var(--ink-2);
      }
      .kp.is-now .kp-words {
        color: color-mix(in srgb, var(--ink) 78%, transparent);
      }
      .kw {
        display: inline;
        border-radius: 0.25rem;
        transition: color 70ms linear, background-color 70ms linear;
      }
      .kw.is-said {
        color: var(--ink);
      }
      .kp.is-past .kw.is-said {
        color: var(--ink-3);
      }
      .kw.is-saying {
        color: #fff;
        font-weight: 700;
        background: rgba(255, 255, 255, 0.14);
        box-shadow: 0 2px 0 0 #7cd4ff;
      }

      /* ---------- Right-side 9:16 Reference Video ---------- */
      .stage-side {
        display: flex;
        gap: 1rem;
        align-items: center;
        padding: 1rem 0;
      }
      .ref-video-wrap {
        position: relative;
        height: min(72vh, 44rem);
        aspect-ratio: 9 / 16;
        border-radius: 1.5rem;
        border: 1px solid var(--hairline);
        background: #000;
        overflow: hidden;
        box-shadow: 0 1.5rem 3.5rem rgba(0, 0, 0, 0.55);
      }
      .ref-video-wrap[hidden],
      .ref-badge[hidden],
      .ref-countdown[hidden],
      .cam-mirror[hidden],
      .shot[hidden] {
        display: none !important;
      }
      .ref-video {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      .ref-video.is-mirrored {
        transform: scaleX(-1);
      }
      .ref-badge {
        position: absolute;
        top: 0.85rem;
        left: 0.85rem;
        padding: 0.28rem 0.65rem;
        border-radius: 999px;
        font-family: var(--font-mono);
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        backdrop-filter: blur(10px);
      }
      .ref-badge.is-rec {
        background: rgba(229, 72, 77, 0.88);
        color: #fff;
      }
      .ref-badge.is-count {
        background: rgba(229, 160, 13, 0.88);
        color: #111;
      }
      .ref-badge.is-play {
        background: rgba(20, 20, 22, 0.82);
        border: 1px solid var(--hairline);
        color: var(--ink);
      }
      .ref-countdown {
        position: absolute;
        inset: 0;
        display: grid;
        place-items: center;
        background: rgba(0, 0, 0, 0.38);
        color: #fff;
        font-size: 5.5rem;
        font-weight: 800;
        font-variant-numeric: tabular-nums;
        text-shadow: 0 4px 24px rgba(0, 0, 0, 0.65);
        pointer-events: none;
      }
      .ref-foot {
        position: absolute;
        inset: auto 0 0 0;
        padding: 1.5rem 0.85rem 0.65rem;
        background: linear-gradient(to top, rgba(0, 0, 0, 0.82), transparent);
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        pointer-events: none;
      }
      .ref-clock {
        font-family: var(--font-mono);
        font-size: 0.72rem;
        font-variant-numeric: tabular-nums;
        color: rgba(255, 255, 255, 0.88);
      }
      .ref-bar {
        height: 0.22rem;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.2);
        overflow: hidden;
      }
      .ref-bar span {
        display: block;
        height: 100%;
        width: 0%;
        background: #fff;
      }

      .cam-mirror {
        height: min(68vh, 42rem);
        aspect-ratio: 9 / 16;
        object-fit: cover;
        border-radius: 1.5rem;
        border: 1px solid var(--hairline);
        background: var(--surface);
        transform: scaleX(-1);
      }
      .shot {
        align-self: center;
        height: min(62vh, 40rem);
        border-radius: 1.5rem;
        border: 1px solid var(--hairline);
      }

      .said {
        margin-top: 2rem;
        padding-top: 1rem;
        border-top: 1px solid var(--hairline);
      }
      .said[hidden] {
        display: none;
      }
      .said-text {
        margin-top: 0.5rem;
        font-size: 1rem;
        line-height: 1.55;
        color: var(--ink-2);
      }

      .pill {
        position: absolute;
        left: 50%;
        bottom: 9rem;
        transform: translateX(-50%);
        max-width: 80%;
        padding: 0.75rem 1.4rem;
        border: 1px solid var(--hairline);
        border-radius: 999px;
        background: color-mix(in srgb, var(--surface) 82%, transparent);
        backdrop-filter: blur(12px);
        color: var(--ink);
        font-size: 1rem;
      }
      .pill[hidden] {
        display: none;
      }

      .controls {
        display: grid;
        gap: 0.65rem;
        padding: 0.9rem 2rem 1.25rem;
        border-top: 1px solid var(--hairline);
      }
      .buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
      }
      .buttons button {
        display: inline-flex;
        gap: 0.45rem;
        align-items: center;
        padding: 0.5rem 0.95rem;
        border: 1px solid var(--hairline);
        border-radius: 999px;
        background: var(--surface);
        color: var(--ink);
        font: inherit;
        font-size: 0.9rem;
        cursor: pointer;
      }
      .buttons button:hover {
        border-color: var(--ink-3);
      }
      .buttons button[data-act='save'] {
        border-color: rgba(111, 207, 138, 0.55);
        background: rgba(111, 207, 138, 0.14);
      }
      .buttons button[hidden] {
        display: none;
      }
      .state {
        color: var(--ink-2);
        font-size: 0.8125rem;
      }
    </style>
  </body>
</html>
