---
import fs from 'node:fs';
import path from 'node:path';
import { type Locale, ui, type UIKey } from '../../i18n/ui';
import { readTimings } from '../../lib/narration';
import { plainText, readTokens } from '../../lib/readAlong';
import { SCRIPT_LANGS, scriptsFor } from '../../lib/scripts';
import '../../styles/global.css';

/**
 * DEV ONLY — /dev/teleprompter.
 *
 * Supports Juan's two-stage narration workflow (2026-11-10):
 *   1. Toma completa (Video + Audio): Continuity Camera 9:16 mirror + mic,
 *      producing `{key}.mp4`, `{key}.m4a`, `{key}.vtt`, `{key}.words.json`,
 *      plus frozen ground-truth `{key}.video-ref.json` & `{key}.video-guide.m4a`.
 *   2. Lip-Sync ADR (Solo audio sobre video): displays the recorded 9:16
 *      `{key}.mp4` on the right and a 60fps word-by-word karaoke teleprompter
 *      on the left (verbatim mouth-sync transcript for `es`, and sentence-paced
 *      overdub script over the Spanish `.mp4` for `en` and `zh`), recording
 *      close-mic studio audio without ever touching `{key}.mp4`.
 *
 * In a production build this route has no paths, so it does not exist.
 */
export const getStaticPaths = () =>
  import.meta.env.PROD ? [] : [{ params: { tool: 'teleprompter' } }];

const LANG_NAME = { es: 'Español', en: 'English', zh: '中文' } as const;
const ROOT = process.cwd();

const status = (lang: string, key: string) => {
  const has = (ext: string) =>
    fs.existsSync(path.join(ROOT, 'public/media/narration', lang, `${key}.${ext}`));
  return has('vtt') ? 'new' : has('m4a') ? 'old' : 'none';
};

const textKeyOf = (key: string): UIKey =>
  (key === 'hero' || key === 'footer' ? `${key}.caption` : key) as UIKey;

const refWordsFor = (lang: Locale, key: string, hasOwnVideo: boolean) => {
  const refFile = path.join(ROOT, 'narration-takes', lang, `${key}.video-ref.json`);
  const timedFile = path.join(
    ROOT,
    'src/data/narration',
    lang === 'es' ? `${key}.words.json` : `${key}.${lang}.words.json`,
  );
  if (fs.existsSync(refFile)) {
    try {
      return JSON.parse(fs.readFileSync(refFile, 'utf8'));
    } catch {
      return [];
    }
  }
  if ((lang === 'es' || hasOwnVideo) && fs.existsSync(timedFile)) {
    try {
      return JSON.parse(fs.readFileSync(timedFile, 'utf8'));
    } catch {
      return [];
    }
  }
  // Multilingual overdub (`en` / `zh`) over the Spanish `.mp4`: pace every word
  // of `ui[lang]` against the Spanish video's sentence clock (or the language's
  // own saved `.m4a` once recorded).
  const tk = textKeyOf(key);
  if (!(tk in ui[lang])) return [];
  const timings = readTimings(key, tk);
  if (!timings?.[lang]?.length) return [];
  const tokens = readTokens(plainText(ui[lang][tk]));
  return tokens.map((tok, i) => ({
    w: tok.text,
    t: timings[lang][i]?.[1] ?? 0,
  }));
};

const scripts = Object.fromEntries(
  SCRIPT_LANGS.map(lang => [
    lang,
    scriptsFor(lang).map(c => {
      const state = status(lang, c.key);
      const ownMp4Path = path.join(ROOT, 'public/media/narration', lang, `${c.key}.mp4`);
      const esMp4Path = path.join(ROOT, 'public/media/narration/es', `${c.key}.mp4`);
      const hasOwnVideo = fs.existsSync(ownMp4Path);
      const hasVideo = hasOwnVideo || fs.existsSync(esMp4Path);
      const videoLang = hasOwnVideo ? lang : 'es';
      const lipsynced = fs.existsSync(
        path.join(ROOT, 'narration-takes', lang, `${c.key}.lipsync.json`),
      );
      return {
        ...c,
        status: state,
        audio: state === 'none' ? null : `/media/narration/${lang}/${c.key}.m4a`,
        hasVideo,
        hasOwnVideo,
        video: hasVideo ? `/media/narration/${videoLang}/${c.key}.mp4` : null,
        guideAudio: `/__narration/guide?lang=${lang}&key=${encodeURIComponent(c.key)}`,
        lipsynced,
        refWords: hasVideo ? refWordsFor(lang, c.key, hasOwnVideo) : [],
      };
    }),
  ]),
);
const list = scripts.es;
---

<!doctype html>
<html lang="es" data-tp-lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Teleprompter · Lip-Sync Studio</title>
  </head>
  <body>
    <aside class="list">
      <p class="label">Guiones</p>
      <div class="langs" role="tablist">
        {SCRIPT_LANGS.map(lang => (
          <button type="button" role="tab" data-lang-pick={lang}>
            {LANG_NAME[lang]}
          </button>
        ))}
      </div>
      <p class="total" data-total></p>
      <ol>
        {list.map(c => (
          <li>
            <button type="button" data-pick={c.key}>
              <span class="dots">
                {SCRIPT_LANGS.map(lang => (
                  <span
                    class="dot"
                    data-dot={lang}
                    data-status={scripts[lang].find(s => s.key === c.key)!.status}
                    title={lang}
                  />
                ))}
              </span>
              <span class="row-main">
                <span class="where">{c.where}</span>
                <span class="row-sub">
                  <span class="key">{c.key}</span>
                  <span class="adr-tag" data-adr-tag={c.key} hidden>ADR ✓</span>
                </span>
              </span>
            </button>
          </li>
        ))}
      </ol>
      <p class="legend">
        <span>puntos: es · en · zh</span>
        <span><span class="dot" data-status="new" /> grabado con video/guión</span>
        <span><span class="adr-tag is-inline">ADR ✓</span> audio lip-sync listo</span>
        <span><span class="dot" data-status="none" /> sin grabar</span>
      </p>
    </aside>

    <main>
      <header class="top">
        <div class="top-left">
          <div class="title-row">
            <p class="label" data-where></p>
            <div class="studio-modes" role="group" aria-label="Modo de estudio">
              <button type="button" class="mode-btn" data-studio-mode="lipsync">
                Lip-Sync (solo audio)
              </button>
              <button type="button" class="mode-btn" data-studio-mode="full">
                Toma completa (video + audio)
              </button>
            </div>
          </div>
          <p class="key" data-key></p>
          <p class="draft" data-draft hidden></p>
        </div>

        <div class="mic">
          <div class="mic-row">
            <button type="button" class="pick-mic" data-cam-on hidden>
              Activar cámara (espejo 9:16)
            </button>
            <select data-cam aria-label="Cámara" hidden></select>
            <button type="button" class="pick-mic" data-mic-on>Activar micrófono</button>
            <select data-mic aria-label="Micrófono" hidden></select>
          </div>
          <div class="lipsync-tools" data-lipsync-tools hidden>
            <label class="tool-chk" title="Escucha tu audio guía bajito por audífonos cerrados mientras haces lip-sync (apágalo si usas cornetas)">
              <input type="checkbox" data-guide-chk />
              <span>Guía audífonos</span>
            </label>
            <label class="tool-chk" title="Voltear horizontalmente el video de referencia si te resulta más cómodo seguir tus gestos en espejo">
              <input type="checkbox" data-mirror-chk />
              <span>Espejo</span>
            </label>
            <div class="nudge-box" title="Ajuste fino de latencia del micrófono (se aplica en vivo al previsualizar con P y al guardar con S)">
              <span class="nudge-lbl">Sync:</span>
              <button type="button" class="nudge-btn" data-nudge="-20">−20</button>
              <span class="nudge-val" data-nudge-val>0 ms</span>
              <button type="button" class="nudge-btn" data-nudge="20">+20</button>
            </div>
          </div>
          <div class="meter-wrap" data-meter-wrap hidden>
            <span class="meter"><span data-meter></span></span>
            <span class="meter-db" data-meter-db>−∞ dB</span>
          </div>
        </div>
      </header>

      <div class="stage">
        <div class="col" data-scroll-col>
          <div class="lipsync-banner" data-lipsync-banner hidden>
            <span>
              <strong>Transcripción exacta del video</strong> (incluye muletillas y pausas).
              Clic en cualquier frase para ir a ese punto; doble clic o <kbd>G</kbd> para ensayar esa parte.
            </span>
            <button type="button" class="reset-sel" data-reset-phrase hidden>
              Volver a 0:00
            </button>
          </div>
          <div class="lines" data-lines></div>
          <div class="said" data-said hidden>
            <p class="label">Lo que dijiste (última transcripción guardada)</p>
            <p class="said-text" data-said-text></p>
          </div>
        </div>

        <div class="stage-side">
          <div class="ref-video-wrap" data-ref-wrap hidden>
            <video
              class="ref-video"
              data-ref-video
              muted
              playsinline
              preload="auto"
            ></video>
            <div class="ref-badge" data-ref-badge hidden></div>
            <div class="ref-countdown" data-ref-countdown hidden></div>
            <div class="ref-foot">
              <span class="ref-clock" data-ref-clock>0:00.0 / 0:00.0</span>
              <div class="ref-bar"><span data-ref-progress></span></div>
            </div>
          </div>
          <video class="cam-mirror" data-cam-view autoplay muted playsinline hidden></video>
          <img class="shot" data-shot alt="" hidden />
        </div>
      </div>

      <div class="pill" data-pill hidden></div>

      <footer class="controls">
        <p class="state" data-state></p>
        <div class="buttons">
          <button type="button" data-act="record">Grabar <kbd>R</kbd></button>
          <button type="button" data-act="punch" hidden>
            Punch-in desde frase <kbd>U</kbd>
          </button>
          <button type="button" data-act="finish" hidden>
            Terminar (revisar) <kbd>espacio</kbd>
          </button>
          <button type="button" data-act="next" hidden>
            Terminar y guardar <kbd>↵</kbd>
          </button>
          <button type="button" data-act="stop" hidden>Cancelar <kbd>esc</kbd></button>
          <button type="button" data-act="take" hidden>
            Ver Lip-Sync grabado <kbd>P</kbd>
          </button>
          <button type="button" data-act="save" hidden>Guardar <kbd>S</kbd></button>
          <button type="button" data-act="current" hidden>
            Ver guardado <kbd>L</kbd>
          </button>
          <button type="button" data-act="guide" hidden>
            Ensayar guía original <kbd>G</kbd>
          </button>
        </div>
        <p class="hint" data-hint-bar>
          <kbd>↑</kbd><kbd>↓</kbd> cambiar clip · <kbd>R</kbd> grabar desde 0:00 ·
          clic en una frase + <kbd>U</kbd> regrabar solo desde ahí (punch-in) ·
          <kbd>espacio</kbd> terminar para revisar con <kbd>P</kbd> · <kbd>S</kbd> guardar audio sin tocar el video
        </p>
      </footer>
    </main>

    <script is:inline type="application/json" id="clips" set:html={JSON.stringify(scripts)} />

    <script>
      type Lang = 'es' | 'en' | 'zh';
      type RefWord = { w: string; t: number };
      type Clip = {
        key: string;
        where: string;
        shot?: string;
        ideas: string[];
        draft?: string;
        status: 'new' | 'old' | 'none';
        audio: string | null;
        hasVideo: boolean;
        hasOwnVideo: boolean;
        video: string | null;
        guideAudio: string;
        lipsynced: boolean;
        refWords: RefWord[];
      };

      type KaraokeToken = {
        w: string;
        t: number;
        end: number;
        el?: HTMLSpanElement;
      };
      type KaraokePhrase = {
        idx: number;
        start: number;
        end: number;
        pauseBefore: number;
        pauseStart: number;
        tokens: KaraokeToken[];
        el?: HTMLDivElement;
        breathFillEl?: HTMLSpanElement;
      };

      const scripts: Record<Lang, Clip[]> = JSON.parse(
        document.getElementById('clips')!.textContent!,
      );
      const read = (k: string) => {
        try {
          return localStorage.getItem(k);
        } catch {
          return null;
        }
      };
      const keep = (k: string, v: string) => {
        try {
          localStorage.setItem(k, v);
        } catch {}
      };

      let lang: Lang =
        (read('tp.lang') as Lang) in scripts ? (read('tp.lang') as Lang) : 'es';
      let clips = scripts[lang];
      let studioMode: 'lipsync' | 'full' =
        read('tp.studioMode') === 'full' ? 'full' : 'lipsync';
      let nudgeMs = Number(read('tp.nudgeMs') ?? '0') || 0;

      const $ = <T extends HTMLElement>(s: string) =>
        document.querySelector<T>(s)!;
      const scrollCol = $('[data-scroll-col]');
      const linesEl = $('[data-lines]');
      const saidEl = $('[data-said]');
      const saidText = $('[data-said-text]');
      const stateEl = $('[data-state]');
      const pill = $('[data-pill]');
      const shot = $<HTMLImageElement>('[data-shot]');
      const refWrap = $('[data-ref-wrap]');
      const refVideo = $<HTMLVideoElement>('[data-ref-video]');
      const refBadge = $('[data-ref-badge]');
      const refCountdown = $('[data-ref-countdown]');
      const refClock = $('[data-ref-clock]');
      const refProgress = $('[data-ref-progress]');
      const lipsyncTools = $('[data-lipsync-tools]');
      const lipsyncBanner = $('[data-lipsync-banner]');
      const resetPhraseBtn = $<HTMLButtonElement>('[data-reset-phrase]');
      const guideChk = $<HTMLInputElement>('[data-guide-chk]');
      const mirrorChk = $<HTMLInputElement>('[data-mirror-chk]');
      const nudgeValEl = $('[data-nudge-val]');
      const meterWrap = $('[data-meter-wrap]');
      const meter = $('[data-meter]');
      const meterDb = $('[data-meter-db]');
      const btn = (a: string) => $<HTMLButtonElement>(`[data-act="${a}"]`);

      guideChk.checked = read('tp.guide') === '1';
      mirrorChk.checked = read('tp.mirror') === '1';
      refVideo.classList.toggle('is-mirrored', mirrorChk.checked);

      const updateNudgeUI = () => {
        const sign = nudgeMs > 0 ? '+' : '';
        nudgeValEl.textContent = `${sign}${nudgeMs} ms`;
      };
      updateNudgeUI();

      const CPS: Record<Lang, number> = { es: 14, en: 14, zh: 5 };
      const secs = (s: string) => (s.length * 1.2) / CPS[lang] + 0.5;
      const clipSecs = (c: Clip) => {
        if (c.refWords.length) {
          return (c.refWords.at(-1)?.t ?? 0) + 1.2;
        }
        return c.ideas.reduce((t, l) => t + secs(l), 0);
      };
      const fmt = (s: number) =>
        `${Math.floor(s / 60)}:${String(Math.round(s % 60)).padStart(2, '0')}`;
      const fmtPrecise = (s: number) => {
        const clamped = Math.max(0, s);
        const m = Math.floor(clamped / 60);
        const sec = (clamped % 60).toFixed(1).padStart(4, '0');
        return `${m}:${sec}`;
      };

      const isLipsyncActive = (c: Clip = clip()) =>
        studioMode === 'lipsync' && c.hasVideo && c.refWords.length > 0;

      const updateSidebarBadges = () => {
        for (const c of clips) {
          const tag = document.querySelector<HTMLElement>(
            `[data-adr-tag="${CSS.escape(c.key)}"]`,
          );
          if (tag) tag.hidden = !c.lipsynced;
        }
      };

      const total = () => {
        const totalDur = fmt(clips.reduce((t, c) => t + clipSecs(c), 0));
        if (studioMode === 'lipsync' && clips.some(c => c.hasVideo)) {
          const adrDone = clips.filter(c => c.lipsynced).length;
          const withVid = clips.filter(c => c.hasVideo).length;
          $('[data-total]').textContent =
            `${adrDone} de ${withVid} con lip-sync · ~${totalDur} total`;
        } else {
          const done = clips.filter(c => c.status === 'new').length;
          $('[data-total]').textContent =
            `${done} de ${clips.length} grabados · ~${totalDur} total`;
        }
        updateSidebarBadges();
      };

      let index = Math.max(
        0,
        clips.findIndex(c => c.key === read('tp.key')),
      );
      let mode: 'idle' | 'count' | 'rec' | 'done' | 'play' = 'idle';
      let playKind: 'take' | 'saved' | 'guide' = 'saved';
      let line = 0;
      let cues: number[] = [];
      let playingSubs: string[] = [];
      let take: Blob | null = null;
      let takeUrl: string | null = null;
      let takeIsLipsync = false;
      let takeSyncOffset = 0;
      let takePunchIn = 0;
      let takeManualStop = false;
      let recorder: MediaRecorder | null = null;
      let endStopTimer: number | undefined;
      const player = new Audio();
      const guidePlayer = new Audio();
      guidePlayer.preload = 'auto';

      let phrases: KaraokePhrase[] = [];
      let selectedPhraseIdx = 0;
      let activeScrolledPhrase = -1;

      const clip = () => clips[index];

      const showSaid = (lines: string[]) => {
        saidEl.hidden = !lines.length || isLipsyncActive();
        saidText.textContent = lines.join(' ');
      };

      /** Group verbatim `refWords` into natural breath/clause phrases with pause cues. */
      const buildKaraokePhrases = (words: RefWord[]): KaraokePhrase[] => {
        if (!words.length) return [];
        const tokens: KaraokeToken[] = words.map((w, i) => {
          const nextT = i + 1 < words.length ? words[i + 1].t : w.t + 0.55;
          const gap = Math.max(0.08, nextT - w.t);
          const estSpeak = Math.max(0.14, Math.min(0.65, w.w.length * 0.055));
          return {
            w: w.w,
            t: w.t,
            end: w.t + Math.min(gap, estSpeak),
          };
        });

        const out: KaraokePhrase[] = [];
        let cur: KaraokeToken[] = [];
        let pauseBeforeCur = 0;
        let pauseStartCur = 0;

        const flush = () => {
          if (!cur.length) return;
          out.push({
            idx: out.length,
            start: cur[0].t,
            end: cur.at(-1)!.end,
            pauseBefore: pauseBeforeCur,
            pauseStart: pauseStartCur,
            tokens: cur,
          });
          cur = [];
          pauseBeforeCur = 0;
          pauseStartCur = 0;
        };

        for (let i = 0; i < tokens.length; i++) {
          const tk = tokens[i];
          if (cur.length > 0) {
            const prev = cur.at(-1)!;
            const silenceGap = tk.t - prev.end;
            const rawGap = tk.t - prev.t;
            const prevEndsSentence = /[.?!…。？！]$/.test(prev.w);
            const prevEndsClause = /[,;:—，；：、]$/.test(prev.w);
            const maxTokens = lang === 'zh' ? 20 : 11;
            const clauseMin = lang === 'zh' ? 12 : 7;
            const sentMin = lang === 'zh' ? 6 : 4;
            if (
              silenceGap >= 0.48 ||
              rawGap >= 0.85 ||
              (prevEndsSentence && cur.length >= sentMin) ||
              (prevEndsClause && cur.length >= clauseMin) ||
              cur.length >= maxTokens
            ) {
              const pStart = prev.end;
              const pDur = Math.max(0, tk.t - pStart);
              flush();
              pauseBeforeCur = pDur >= 0.5 ? pDur : 0;
              pauseStartCur = pStart;
            }
          }
          cur.push(tk);
        }
        flush();
        return out;
      };

      const renderLines = () => {
        const c = clip();
        activeScrolledPhrase = -1;
        if (isLipsyncActive(c)) {
          phrases = buildKaraokePhrases(c.refWords);
          selectedPhraseIdx = Math.min(
            selectedPhraseIdx,
            Math.max(0, phrases.length - 1),
          );
          const nodes = phrases.map(ph => {
            const row = document.createElement('div');
            row.className = 'kp';
            row.dataset.pIdx = String(ph.idx);
            if (ph.idx === selectedPhraseIdx) row.classList.add('is-entry');

            const meta = document.createElement('div');
            meta.className = 'kp-meta';
            const stampBtn = document.createElement('span');
            stampBtn.className = 'kp-time';
            stampBtn.textContent = fmtPrecise(ph.start);
            meta.append(stampBtn);

            if (ph.pauseBefore >= 0.5) {
              const breath = document.createElement('span');
              breath.className = 'kp-breath';
              const fill = document.createElement('span');
              fill.className = 'kp-breath-fill';
              const lbl = document.createElement('span');
              lbl.className = 'kp-breath-lbl';
              lbl.textContent = `pausa ${ph.pauseBefore.toFixed(1)}s`;
              breath.append(fill, lbl);
              ph.breathFillEl = fill;
              meta.append(breath);
            }

            const textWrap = document.createElement('div');
            textWrap.className = 'kp-words';
            ph.tokens.forEach((tk, wi) => {
              if (wi > 0 && lang !== 'zh') textWrap.append(' ');
              const sp = document.createElement('span');
              sp.className = 'kw';
              sp.textContent = tk.w;
              tk.el = sp;
              textWrap.append(sp);
            });

            row.append(meta, textWrap);
            ph.el = row;

            row.addEventListener('click', () => {
              selectPhrase(ph.idx, true);
            });
            row.addEventListener('dblclick', () => {
              selectPhrase(ph.idx, false);
              playGuide();
            });
            return row;
          });
          linesEl.replaceChildren(...nodes);
          linesEl.classList.add('is-karaoke');
          resetPhraseBtn.hidden = selectedPhraseIdx === 0;
          return;
        }

        phrases = [];
        linesEl.classList.remove('is-karaoke');
        linesEl.replaceChildren(
          ...c.ideas.map((text, i) => {
            const p = document.createElement('p');
            p.textContent = text;
            p.dataset.i = String(i);
            return p;
          }),
        );
      };

      const clearKaraokePaint = () => {
        for (const ph of phrases) {
          ph.el?.classList.remove('is-past', 'is-now', 'is-next');
          if (ph.breathFillEl) ph.breathFillEl.style.width = '0%';
          for (const tk of ph.tokens) {
            tk.el?.classList.remove('is-said', 'is-saying');
          }
        }
        activeScrolledPhrase = -1;
      };

      /** Paint word-by-word karaoke at video timestamp `t` (seconds), with 85ms visual anticipation. */
      const paintKaraokeAt = (t: number) => {
        if (!phrases.length) return;
        const lead = t + 0.085;
        let curIdx = 0;
        for (let i = 0; i < phrases.length; i++) {
          if (lead >= phrases[i].start || (phrases[i].pauseBefore >= 0.5 && lead >= phrases[i].pauseStart)) {
            curIdx = i;
          } else {
            break;
          }
        }

        for (let i = 0; i < phrases.length; i++) {
          const ph = phrases[i];
          const el = ph.el;
          if (!el) continue;
          const isPast = i < curIdx;
          const isNow = i === curIdx;
          const isNext = i === curIdx + 1;
          el.classList.toggle('is-past', isPast);
          el.classList.toggle('is-now', isNow);
          el.classList.toggle('is-next', isNext);

          if (ph.breathFillEl) {
            if (isPast || t >= ph.start) {
              ph.breathFillEl.style.width = '100%';
            } else if (t > ph.pauseStart && ph.start > ph.pauseStart) {
              const pct = Math.min(
                100,
                Math.max(0, ((t - ph.pauseStart) / (ph.start - ph.pauseStart)) * 100),
              );
              ph.breathFillEl.style.width = `${pct.toFixed(1)}%`;
            } else {
              ph.breathFillEl.style.width = '0%';
            }
          }

          if (isPast) {
            for (const tk of ph.tokens) {
              tk.el?.classList.add('is-said');
              tk.el?.classList.remove('is-saying');
            }
          } else if (isNow) {
            for (const tk of ph.tokens) {
              const saying = lead >= tk.t && t <= tk.end + 0.08;
              const said = !saying && t > tk.end + 0.08;
              tk.el?.classList.toggle('is-saying', saying);
              tk.el?.classList.toggle('is-said', said);
            }
          } else {
            for (const tk of ph.tokens) {
              tk.el?.classList.remove('is-said', 'is-saying');
            }
          }
        }

        if (curIdx !== activeScrolledPhrase) {
          activeScrolledPhrase = curIdx;
          const targetEl = phrases[curIdx]?.el;
          if (targetEl) {
            const colRect = scrollCol.getBoundingClientRect();
            const rowRect = targetEl.getBoundingClientRect();
            const targetScroll =
              scrollCol.scrollTop +
              (rowRect.top - colRect.top) -
              colRect.height * 0.34;
            scrollCol.scrollTo({
              top: Math.max(0, targetScroll),
              behavior: 'smooth',
            });
          }
        }
      };

      const selectPhrase = (idx: number, seekMedia: boolean) => {
        if (mode === 'rec' || mode === 'count') return;
        selectedPhraseIdx = Math.max(0, Math.min(idx, Math.max(0, phrases.length - 1)));
        phrases.forEach((ph, i) =>
          ph.el?.classList.toggle('is-entry', i === selectedPhraseIdx),
        );
        resetPhraseBtn.hidden = selectedPhraseIdx === 0;
        const targetT = phrases[selectedPhraseIdx]?.start ?? 0;
        if (seekMedia && isLipsyncActive()) {
          if (mode === 'play') {
            seekSyncedPlayback(targetT);
          } else {
            try {
              refVideo.currentTime = targetT;
            } catch {}
            paintKaraokeAt(targetT);
          }
        }
        sync();
      };

      resetPhraseBtn.addEventListener('click', () => selectPhrase(0, true));

      const mark = (i: number) => {
        line = i;
        if (isLipsyncActive()) return;
        linesEl.querySelectorAll('p').forEach((p, j) => {
          p.classList.toggle('is-past', j < i);
          p.classList.toggle('is-now', j === i);
        });
        linesEl
          .querySelector('.is-now')
          ?.scrollIntoView({ block: 'center', behavior: 'smooth' });
      };

      const updateRefClock = () => {
        if (refWrap.hidden) return;
        const cur = refVideo.currentTime || 0;
        const dur = Number.isFinite(refVideo.duration) ? refVideo.duration : clipSecs(clip());
        refClock.textContent = `${fmtPrecise(cur)} / ${fmtPrecise(dur)}`;
        const pct = dur > 0 ? Math.min(100, Math.max(0, (cur / dur) * 100)) : 0;
        refProgress.style.width = `${pct.toFixed(2)}%`;
      };
      refVideo.addEventListener('timeupdate', updateRefClock);
      refVideo.addEventListener('loadedmetadata', updateRefClock);

      const syncStageMedia = () => {
        const c = clip();
        const ls = isLipsyncActive(c);
        lipsyncTools.hidden = !ls;
        lipsyncBanner.hidden = !ls;
        $('[data-cam-on]').hidden = ls || Boolean(camStream);
        cam.hidden = ls || !camStream;
        camView.hidden = ls || !camStream;

        if (ls && c.video) {
          refWrap.hidden = false;
          shot.hidden = true;
          if (refVideo.getAttribute('src') !== c.video) {
            refVideo.src = c.video;
            refVideo.load();
          }
          if (guidePlayer.dataset.key !== `${lang}:${c.key}`) {
            guidePlayer.dataset.key = `${lang}:${c.key}`;
            guidePlayer.src = `${c.guideAudio}&t=${Date.now()}`;
          }
        } else {
          refWrap.hidden = true;
          refVideo.pause();
          shot.hidden = !c.shot;
          if (c.shot) shot.src = c.shot;
        }

        document
          .querySelectorAll<HTMLButtonElement>('[data-studio-mode]')
          .forEach(b => {
            const m = b.dataset.studioMode as 'lipsync' | 'full';
            b.classList.toggle('is-on', m === (ls ? 'lipsync' : 'full'));
            if (m === 'lipsync') b.disabled = !c.hasVideo || !c.refWords.length;
          });
      };

      const select = (i: number) => {
        if (mode === 'rec' || mode === 'count') return;
        stopPlayback();
        index = (i + clips.length) % clips.length;
        const c = clip();
        keep('tp.key', c.key);
        if (takeUrl) {
          URL.revokeObjectURL(takeUrl);
          takeUrl = null;
        }
        take = null;
        cues = [];
        selectedPhraseIdx = 0;
        mode = 'idle';
        $('[data-where]').textContent = c.where;
        $('[data-key]').textContent =
          `${c.key} · ${lang} · ~${fmt(clipSecs(c))}` +
          (c.lipsynced ? ' · ADR ✓' : c.hasVideo ? ' · video listo' : '');
        const draft = $('[data-draft]');
        draft.hidden = !c.draft;
        draft.textContent = c.draft ?? '';
        document
          .querySelectorAll<HTMLElement>('[data-pick]')
          .forEach(b => b.classList.toggle('is-on', b.dataset.pick === c.key));
        document.querySelector('.is-on')?.scrollIntoView({ block: 'nearest' });

        syncStageMedia();
        renderLines();
        mark(0);
        if (isLipsyncActive(c)) {
          try {
            refVideo.currentTime = 0;
          } catch {}
          clearKaraokePaint();
          scrollCol.scrollTop = 0;
        }
        showSaid([]);
        if (c.status === 'new' && !isLipsyncActive(c)) loadSaid(c);
        sync();
      };

      /** The saved clip's subtitles: their text, and when each starts. */
      const readVtt = async (c: Clip) => {
        const vtt = await (
          await fetch(`${c.audio!.replace(/\.m4a$/, '.vtt')}?t=${Date.now()}`, {
            cache: 'no-store',
          })
        ).text();
        const matched = [
          ...vtt.matchAll(/(\d+):(\d+):([\d.]+) -->[^\n]*\n([^\n]+)/g),
        ];
        return {
          at: matched.map(m => +m[1] * 3600 + +m[2] * 60 + +m[3]),
          lines: matched.map(m => m[4]),
        };
      };
      const loadSaid = async (c: Clip) => {
        const { lines } = await readVtt(c);
        if (clip() === c) showSaid(lines);
      };

      const pickLang = (next: Lang) => {
        if (mode === 'rec' || mode === 'count') return;
        lang = next;
        keep('tp.lang', lang);
        clips = scripts[lang];
        document.documentElement.lang = lang;
        document.documentElement.dataset.tpLang = lang;
        document
          .querySelectorAll<HTMLElement>('[data-lang-pick]')
          .forEach(b =>
            b.setAttribute('aria-selected', String(b.dataset.langPick === lang)),
          );
        total();
        select(index);
      };
      document
        .querySelectorAll<HTMLButtonElement>('[data-lang-pick]')
        .forEach(b =>
          b.addEventListener('click', () => {
            b.blur();
            pickLang(b.dataset.langPick as Lang);
          }),
        );

      document
        .querySelectorAll<HTMLButtonElement>('[data-studio-mode]')
        .forEach(b =>
          b.addEventListener('click', () => {
            if (mode === 'rec' || mode === 'count') return;
            b.blur();
            const next = b.dataset.studioMode as 'lipsync' | 'full';
            if (next === 'lipsync' && (!clip().hasVideo || !clip().refWords.length))
              return;
            studioMode = next;
            keep('tp.studioMode', studioMode);
            total();
            select(index);
          }),
        );

      guideChk.addEventListener('change', () => {
        keep('tp.guide', guideChk.checked ? '1' : '0');
        if (mode === 'rec' && isLipsyncActive()) {
          if (guideChk.checked) {
            guidePlayer.volume = 0.3;
            guidePlayer.currentTime = refVideo.currentTime;
            guidePlayer.play().catch(() => {});
          } else {
            guidePlayer.pause();
          }
        }
      });

      mirrorChk.addEventListener('change', () => {
        keep('tp.mirror', mirrorChk.checked ? '1' : '0');
        refVideo.classList.toggle('is-mirrored', mirrorChk.checked);
      });

      document
        .querySelectorAll<HTMLButtonElement>('[data-nudge]')
        .forEach(b =>
          b.addEventListener('click', () => {
            b.blur();
            const delta = Number(b.dataset.nudge) || 0;
            nudgeMs = Math.max(-300, Math.min(300, nudgeMs + delta));
            keep('tp.nudgeMs', String(nudgeMs));
            updateNudgeUI();
            // Live re-sync while previewing a recorded lip-sync take!
            if (mode === 'play' && playKind === 'take' && takeIsLipsync) {
              const vidT = refVideo.currentTime;
              const targetAudioT = Math.max(
                0,
                effectiveSyncOffset() + (vidT - takePunchIn),
              );
              try {
                player.currentTime = targetAudioT;
              } catch {}
            }
          }),
        );

      const effectiveSyncOffset = () =>
        Math.max(0, takeSyncOffset + nudgeMs / 1000);

      const sync = () => {
        const c = clip();
        const ls = isLipsyncActive(c);
        const selTime = phrases[selectedPhraseIdx]?.start ?? 0;
        const canPunch =
          ls &&
          selectedPhraseIdx > 0 &&
          Boolean(c.audio) &&
          mode !== 'rec' &&
          mode !== 'count';

        btn('record').hidden =
          mode === 'rec' || mode === 'count' || (!ls && !c.ideas.length);
        btn('record').firstChild!.textContent = ls
          ? take
            ? 'Repetir desde 0:00 '
            : 'Grabar Lip-Sync '
          : take
            ? 'Repetir '
            : 'Grabar ';

        btn('punch').hidden = !canPunch;
        if (canPunch) {
          btn('punch').firstChild!.textContent =
            `Punch-in desde ${fmtPrecise(selTime)} `;
        }

        btn('finish').hidden = mode !== 'rec' || !ls;
        btn('next').hidden = mode !== 'rec';
        btn('next').firstChild!.textContent = ls
          ? 'Terminar y guardar '
          : line + 1 >= c.ideas.length
            ? 'Terminar y guardar '
            : 'Siguiente bloque ';

        btn('stop').hidden = mode !== 'rec' && mode !== 'count';
        btn('take').hidden = !take || mode === 'rec' || mode === 'count';
        btn('take').firstChild!.textContent = takeIsLipsync
          ? 'Ver Lip-Sync grabado '
          : 'Escuchar toma ';
        btn('save').hidden = !take || mode === 'rec' || mode === 'count';
        btn('current').hidden = !c.audio || mode === 'rec' || mode === 'count';
        btn('current').firstChild!.textContent = ls
          ? 'Ver guardado '
          : 'Escuchar guardado ';
        btn('guide').hidden = !ls || mode === 'rec' || mode === 'count';

        linesEl.classList.toggle('is-rec', mode === 'rec' || mode === 'play');

        if (mode === 'idle') {
          refBadge.hidden = true;
          refCountdown.hidden = true;
          if (ls) {
            stateEl.textContent = c.lipsynced
              ? `Lip-Sync ADR ya guardado para ${c.key}. Pulsa L para verlo, G para guía original, o R para grabar otra toma.`
              : `Modo Lip-Sync listo (${c.refWords.length} palabras exactas · video intacto). Conecta tu mic de cerca y pulsa R.`;
          } else {
            stateEl.textContent =
              c.status === 'new'
                ? 'Ya grabado. Puedes repetirlo.'
                : !c.ideas.length
                  ? 'Este guión aún no está escrito en este idioma.'
                  : 'Sin grabar.';
          }
        } else if (mode === 'done') {
          refBadge.hidden = true;
          refCountdown.hidden = true;
          stateEl.textContent = takeIsLipsync
            ? takePunchIn > 0
              ? `Punch-in listo (desde ${fmtPrecise(takePunchIn)}). Pulsa P para ver el lip-sync o S para empalmar y guardar.`
              : 'Toma Lip-Sync lista. Pulsa P para verificar tus labios con el nuevo audio, o S para guardar (el video .mp4 no se toca).'
            : 'Toma lista. Escúchala con P o guárdala con S.';
        } else if (mode === 'play') {
          refCountdown.hidden = true;
          if (ls) {
            refBadge.hidden = false;
            refBadge.className = 'ref-badge is-play';
            refBadge.textContent =
              playKind === 'take'
                ? '▶ PREVIEW TOMA NUEVA'
                : playKind === 'guide'
                  ? '▶ AUDIO GUÍA ORIGINAL'
                  : '▶ GUARDADO ACTUAL';
          }
          stateEl.textContent =
            playKind === 'take'
              ? `Viendo preview Lip-Sync (Sync ${nudgeMs >= 0 ? '+' : ''}${nudgeMs} ms). Usa −20/+20 ms si quieres afinar, o pulsa S para guardar.`
              : playKind === 'guide'
                ? 'Ensayando con el audio guía original del video… (espacio para pausar)'
                : 'Reproduciendo versión guardada en disco… (espacio para pausar)';
        }
      };

      // Camera (only used in Stage 1 `full` mode)
      let camStream: MediaStream | null = null;
      const cam = $<HTMLSelectElement>('[data-cam]');
      const camView = $<HTMLVideoElement>('[data-cam-view]');
      const listCams = async () => {
        const devices = (await navigator.mediaDevices.enumerateDevices()).filter(
          d => d.kind === 'videoinput',
        );
        const current = camStream?.getVideoTracks()[0]?.getSettings().deviceId;
        cam.replaceChildren(
          ...devices.map(d => {
            const o = new Option(d.label || 'Cámara', d.deviceId);
            o.selected = d.deviceId === current;
            return o;
          }),
        );
      };
      const openCam = async (id?: string) => {
        camStream?.getTracks().forEach(t => t.stop());
        const req = (devId?: string) =>
          navigator.mediaDevices.getUserMedia({
            video: {
              ...(devId ? { deviceId: { exact: devId } } : {}),
              width: { ideal: 1920 },
              height: { ideal: 1080 },
            },
          });
        let fellBack = false;
        try {
          camStream = await req(id);
        } catch {
          camStream = await req(undefined);
          fellBack = true;
        }
        const savedLabel = read('tp.cam.label');
        if ((!id || fellBack) && savedLabel) {
          const match = (await navigator.mediaDevices.enumerateDevices()).find(
            d => d.kind === 'videoinput' && d.label === savedLabel,
          );
          const currentId = camStream.getVideoTracks()[0]?.getSettings().deviceId;
          if (match && match.deviceId !== currentId) {
            try {
              const nextStream = await req(match.deviceId);
              camStream.getTracks().forEach(t => t.stop());
              camStream = nextStream;
            } catch {}
          }
        }
        camView.srcObject = camStream;
        await listCams();
        syncStageMedia();
      };
      navigator.mediaDevices.addEventListener('devicechange', () => {
        if (camStream) listCams();
      });
      $('[data-cam-on]').addEventListener('click', () =>
        openCam(read('tp.cam') ?? undefined).catch(err => {
          stateEl.textContent = `No hay acceso a la cámara (${err?.name || 'error'}).`;
        }),
      );
      cam.addEventListener('change', () => {
        keep('tp.cam', cam.value);
        const label = cam.selectedOptions[0]?.text;
        if (label) keep('tp.cam.label', label);
        openCam(cam.value);
      });

      // Microphones: pure unprocessed studio capture
      let stream: MediaStream | null = null;
      const mic = $<HTMLSelectElement>('[data-mic]');
      let analyser: AnalyserNode | null = null;
      let micAudioCtx: AudioContext | null = null;
      const openMic = async (id?: string) => {
        stream?.getTracks().forEach(t => t.stop());
        const req = (devId?: string) =>
          navigator.mediaDevices.getUserMedia({
            audio: {
              ...(devId ? { deviceId: { exact: devId } } : {}),
              echoCancellation: false,
              noiseSuppression: false,
              autoGainControl: false,
              channelCount: 1,
              sampleRate: 48000,
            },
          });
        let fellBack = false;
        try {
          stream = await req(id);
        } catch {
          stream = await req(undefined);
          fellBack = true;
        }
        const savedLabel = read('tp.mic.label');
        if ((!id || fellBack) && savedLabel) {
          const match = (await navigator.mediaDevices.enumerateDevices()).find(
            d => d.kind === 'audioinput' && d.label === savedLabel,
          );
          const currentId = stream.getAudioTracks()[0]?.getSettings().deviceId;
          if (match && match.deviceId !== currentId) {
            try {
              const nextStream = await req(match.deviceId);
              stream.getTracks().forEach(t => t.stop());
              stream = nextStream;
            } catch {}
          }
        }
        const devices = (await navigator.mediaDevices.enumerateDevices()).filter(
          d => d.kind === 'audioinput',
        );
        const current = stream.getAudioTracks()[0].getSettings().deviceId;
        mic.replaceChildren(
          ...devices.map(d => {
            const o = new Option(d.label || 'Micrófono', d.deviceId);
            o.selected = d.deviceId === current;
            return o;
          }),
        );
        mic.hidden = false;
        meterWrap.hidden = false;
        $('[data-mic-on]').hidden = true;
        micAudioCtx?.close().catch(() => {});
        micAudioCtx = new AudioContext();
        analyser = micAudioCtx.createAnalyser();
        analyser.fftSize = 1024;
        micAudioCtx.createMediaStreamSource(stream).connect(analyser);
      };
      $('[data-mic-on]').addEventListener('click', () =>
        openMic(read('tp.mic') ?? undefined).catch(err => {
          stateEl.textContent = `No hay acceso al micrófono (${err?.name || 'error'}).`;
        }),
      );
      mic.addEventListener('change', () => {
        keep('tp.mic', mic.value);
        const label = mic.selectedOptions[0]?.text;
        if (label) keep('tp.mic.label', label);
        openMic(mic.value);
      });

      const level = new Float32Array(1024);
      let heldDb = -60;
      const tick = () => {
        if (analyser) {
          analyser.getFloatTimeDomainData(level);
          let peak = 0;
          for (const v of level) peak = Math.max(peak, Math.abs(v));
          meter.style.width = `${Math.min(100, peak * 100)}%`;
          meter.classList.toggle('is-hot', peak > 0.94);
          meter.classList.toggle('is-good', peak >= 0.12 && peak <= 0.85);
          const db = peak > 0.0001 ? 20 * Math.log10(peak) : -60;
          heldDb = db > heldDb ? db : heldDb * 0.94 + db * 0.06;
          meterDb.textContent =
            heldDb <= -55 ? '−∞ dB' : `${heldDb.toFixed(0)} dB`;
        }
        if ((mode === 'rec' || mode === 'count' || mode === 'play') && isLipsyncActive()) {
          paintKaraokeAt(refVideo.currentTime || 0);
          updateRefClock();
        } else if (mode === 'play' && !isLipsyncActive()) {
          const t = player.currentTime;
          let i = 0;
          while (i + 1 < cues.length && cues[i + 1] <= t) i++;
          pill.textContent = playingSubs[i] ?? '';
          pill.hidden = !pill.textContent;
        }
        requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);

      const waitSeek = (v: HTMLVideoElement, target: number) =>
        new Promise<void>(resolve => {
          const done = () => {
            v.removeEventListener('seeked', done);
            resolve();
          };
          if (v.readyState >= 1 && Math.abs(v.currentTime - target) < 0.03) {
            resolve();
            return;
          }
          v.addEventListener('seeked', done, { once: true });
          const apply = () => {
            try {
              v.currentTime = target;
            } catch {
              resolve();
            }
          };
          if (v.readyState >= 1) apply();
          else v.addEventListener('loadedmetadata', apply, { once: true });
          setTimeout(done, 500);
        });

      let saveWhenDone = false;

      const startLipsyncRecord = async (punchFromPhrase = false) => {
        stopPlayback();
        clearTimeout(endStopTimer);
        if (!stream) await openMic(read('tp.mic') ?? undefined);

        const punchSec =
          punchFromPhrase && selectedPhraseIdx > 0
            ? (phrases[selectedPhraseIdx]?.start ?? 0)
            : 0;
        const preRollStart = punchSec > 0 ? Math.max(0, punchSec - 3.0) : 0;

        mode = 'count';
        if (takeUrl) {
          URL.revokeObjectURL(takeUrl);
          takeUrl = null;
        }
        take = null;
        takeIsLipsync = true;
        takePunchIn = punchSec;
        takeManualStop = false;
        saveWhenDone = false;

        await waitSeek(refVideo, preRollStart);
        paintKaraokeAt(preRollStart);
        sync();

        // Start MediaRecorder BEFORE countdown so Opus encoder spin-up happens
        // during the pre-roll, giving 0ms hitch and exact `performance.now()` sync!
        const chunks: Blob[] = [];
        const tracks = [...stream!.getAudioTracks()];
        const candidates = [
          'audio/webm;codecs=opus',
          'audio/webm',
          'audio/mp4',
        ];
        const mimeType =
          candidates.find(m => MediaRecorder.isTypeSupported(m)) ?? '';
        recorder = new MediaRecorder(new MediaStream(tracks), {
          ...(mimeType ? { mimeType } : {}),
          audioBitsPerSecond: 256000,
        });

        let recStartPerf = 0;
        const startedPromise = new Promise<void>(resolve => {
          recorder!.onstart = () => {
            recStartPerf = performance.now();
            resolve();
          };
        });
        recorder.ondataavailable = e => {
          if (e.data.size > 0) chunks.push(e.data);
        };
        recorder.onstop = () => {
          clearTimeout(endStopTimer);
          refVideo.pause();
          guidePlayer.pause();
          refBadge.hidden = true;
          refCountdown.hidden = true;
          if (mode === 'idle') return; // Cancelled via Esc
          take = new Blob(chunks, {
            type: recorder?.mimeType || 'audio/webm',
          });
          takeUrl = URL.createObjectURL(take);
          mode = 'done';
          sync();
          if (saveWhenDone) {
            saveWhenDone = false;
            save();
          }
        };

        recorder.start();
        await startedPromise;

        if (punchSec === 0) {
          // 3 · 2 · 1 visual countdown while recorder is already smoothly rolling.
          refCountdown.hidden = false;
          refBadge.hidden = false;
          refBadge.className = 'ref-badge is-count';
          refBadge.textContent = 'PREPARADO';
          for (const n of [3, 2, 1]) {
            refCountdown.textContent = String(n);
            stateEl.textContent = `Lip-Sync empieza en ${n}…`;
            await new Promise(r => setTimeout(r, 550));
            if (mode !== 'count') return;
          }
          refCountdown.hidden = true;
          if (guideChk.checked) {
            guidePlayer.volume = 0.3;
            guidePlayer.currentTime = 0;
            guidePlayer.play().catch(() => {});
          }
          await refVideo.play();
          takeSyncOffset = Math.max(0, (performance.now() - recStartPerf) / 1000);
          mode = 'rec';
          refBadge.className = 'ref-badge is-rec';
          refBadge.textContent = '● REC LIP-SYNC';
          stateEl.textContent =
            'Grabando Lip-Sync… sigue las palabras iluminadas (espacio = revisar, enter = guardar).';
          sync();
        } else {
          // Punch-in pre-roll: play video from `punchSec - 3s` so Juan locks into
          // his own rhythm, then punch in seamlessly at `punchSec`!
          refBadge.hidden = false;
          refBadge.className = 'ref-badge is-count';
          if (guideChk.checked) {
            guidePlayer.volume = 0.32;
            guidePlayer.currentTime = preRollStart;
            guidePlayer.play().catch(() => {});
          }
          await refVideo.play();
          await new Promise<void>(resolve => {
            const check = () => {
              if (mode !== 'count') {
                resolve();
                return;
              }
              const rem = punchSec - refVideo.currentTime;
              if (rem <= 0.015) {
                takeSyncOffset = Math.max(
                  0,
                  (performance.now() - recStartPerf) / 1000,
                );
                resolve();
                return;
              }
              refBadge.textContent = `PRE-ROLL · ENTRA EN ${rem.toFixed(1)}s`;
              stateEl.textContent = `Pre-roll… entras en ${rem.toFixed(1)}s`;
              requestAnimationFrame(check);
            };
            requestAnimationFrame(check);
          });
          if (mode !== 'count') return;
          if (!guideChk.checked) guidePlayer.pause();
          mode = 'rec';
          refBadge.className = 'ref-badge is-rec';
          refBadge.textContent = `● PUNCH-IN (${fmtPrecise(punchSec)})`;
          stateEl.textContent = `Grabando Punch-in desde ${fmtPrecise(punchSec)}… (espacio = cortar aquí y revisar, o sigue hasta el final).`;
          sync();
        }

        // Auto-stop 350ms after the clip's own video finishes so trailing consonants breathe cleanly.
        // When dubbing `en`/`zh` over the Spanish guide video (`!c.hasOwnVideo`), keep recording until
        // Juan presses Space/Enter so a slightly longer translated sentence is never cut off.
        const onVidEnd = () => {
          if (mode !== 'rec') return;
          if (clip().hasOwnVideo) {
            endStopTimer = window.setTimeout(() => {
              if (mode === 'rec') {
                takeManualStop = false;
                recorder?.stop();
              }
            }, 350);
          } else {
            refBadge.textContent = '● GRABANDO (VIDEO GUÍA TERMINÓ)';
            stateEl.textContent =
              'Video guía terminó — termina tu frase tranquilo y pulsa Espacio (revisar) o S (guardar).';
          }
        };
        refVideo.addEventListener('ended', onVidEnd, { once: true });
      };

      const record = async () => {
        if (isLipsyncActive()) {
          return startLipsyncRecord(false);
        }
        stopPlayback();
        if (!stream) await openMic(read('tp.mic') ?? undefined);
        mode = 'count';
        take = null;
        takeIsLipsync = false;
        takePunchIn = 0;
        mark(0);
        sync();
        for (const n of [3, 2, 1]) {
          stateEl.textContent = `Empieza en ${n}…`;
          await new Promise(r => setTimeout(r, 600));
          if (mode !== 'count') return;
        }
        const chunks: Blob[] = [];
        const tracks = [
          ...stream!.getAudioTracks(),
          ...(camStream ? camStream.getVideoTracks() : []),
        ];
        const hasVideo = tracks.some(t => t.kind === 'video');
        const candidates = hasVideo
          ? [
              'video/webm;codecs=vp9,opus',
              'video/webm;codecs=vp8,opus',
              'video/webm',
              'video/mp4',
            ]
          : ['audio/webm;codecs=opus', 'audio/webm', 'audio/mp4'];
        const mimeType =
          candidates.find(m => MediaRecorder.isTypeSupported(m)) ?? '';
        recorder = new MediaRecorder(new MediaStream(tracks), {
          ...(mimeType ? { mimeType } : {}),
          audioBitsPerSecond: 256000,
          ...(hasVideo ? { videoBitsPerSecond: 8_000_000 } : {}),
        });
        recorder.ondataavailable = e => chunks.push(e.data);
        recorder.onstop = () => {
          if (mode === 'idle') return;
          take = new Blob(chunks, {
            type: recorder?.mimeType || (hasVideo ? 'video/mp4' : 'audio/mp4'),
          });
          if (takeUrl) URL.revokeObjectURL(takeUrl);
          takeUrl = URL.createObjectURL(take);
          mode = 'done';
          mark(0);
          sync();
          if (saveWhenDone) save();
          saveWhenDone = false;
        };
        recorder.start();
        cues = [0];
        mode = 'rec';
        mark(0);
        sync();
      };

      const punch = () => {
        if (mode === 'rec' || mode === 'count' || !isLipsyncActive()) return;
        startLipsyncRecord(true);
      };

      const finishToReview = () => {
        if (mode !== 'rec') return;
        saveWhenDone = false;
        takeManualStop = true;
        recorder?.stop();
      };

      const next = () => {
        if (mode !== 'rec') return;
        if (isLipsyncActive() || line + 1 >= clip().ideas.length) {
          saveWhenDone = true;
          takeManualStop = true;
          recorder?.stop();
          return;
        }
        mark(line + 1);
        sync();
      };

      const cancelRec = () => {
        clearTimeout(endStopTimer);
        if (mode === 'count' || mode === 'rec') {
          mode = 'idle';
          refVideo.pause();
          guidePlayer.pause();
          if (recorder && recorder.state !== 'inactive') {
            recorder.stop();
          }
          sync();
        }
      };

      const stopPlayback = () => {
        player.pause();
        guidePlayer.pause();
        if (mode === 'play') {
          refVideo.pause();
          mode = take ? 'done' : 'idle';
        }
        pill.hidden = true;
      };

      const seekSyncedPlayback = (videoSec: number) => {
        if (mode !== 'play' || !isLipsyncActive()) return;
        if (playKind === 'take' && takeIsLipsync) {
          const clampedVid = Math.max(takePunchIn, videoSec);
          const audioSec = Math.max(
            0,
            effectiveSyncOffset() + (clampedVid - takePunchIn),
          );
          try {
            refVideo.currentTime = clampedVid;
            player.currentTime = audioSec;
          } catch {}
        } else {
          try {
            refVideo.currentTime = videoSec;
            player.currentTime = videoSec;
          } catch {}
        }
      };

      const playSyncedWithVideo = async (
        audioSrc: string,
        kind: 'take' | 'saved' | 'guide',
        startVidSec = 0,
        audioOffsetForStart = 0,
      ) => {
        stopPlayback();
        playKind = kind;
        player.src = audioSrc;
        await waitSeek(refVideo, startVidSec);
        await new Promise<void>(resolve => {
          if (player.readyState >= 1) resolve();
          else player.addEventListener('loadedmetadata', () => resolve(), { once: true });
          setTimeout(resolve, 400);
        });
        try {
          player.currentTime = Math.max(0, audioOffsetForStart);
        } catch {}
        mode = 'play';
        sync();
        await Promise.all([
          refVideo.play().catch(() => {}),
          player.play().catch(() => {}),
        ]);
      };

      player.addEventListener('ended', () => {
        stopPlayback();
        mark(0);
        sync();
      });

      const playTake = async () => {
        if (!take || !takeUrl) return;
        if (takeIsLipsync && isLipsyncActive()) {
          const startFrom =
            selectedPhraseIdx > 0
              ? Math.max(takePunchIn, phrases[selectedPhraseIdx]?.start ?? 0)
              : takePunchIn;
          const audioStart =
            effectiveSyncOffset() + (startFrom - takePunchIn);
          await playSyncedWithVideo(takeUrl, 'take', startFrom, audioStart);
          return;
        }
        stopPlayback();
        cues = [0];
        playingSubs = [];
        player.src = takeUrl;
        await player.play();
        mode = 'play';
        pill.hidden = false;
        sync();
      };

      const playCurrent = async () => {
        const c = clip();
        if (!c.audio) return;
        if (isLipsyncActive(c)) {
          const startFrom = phrases[selectedPhraseIdx]?.start ?? 0;
          await playSyncedWithVideo(
            `${c.audio}?t=${Date.now()}`,
            'saved',
            startFrom,
            startFrom,
          );
          return;
        }
        const { at, lines } =
          c.status === 'new' ? await readVtt(c) : { at: [0], lines: [] };
        stopPlayback();
        cues = at;
        playingSubs = lines;
        player.src = `${c.audio}?t=${Date.now()}`;
        await player.play();
        mode = 'play';
        pill.hidden = false;
        sync();
      };

      const playGuide = async () => {
        const c = clip();
        if (!isLipsyncActive(c)) return;
        const startFrom = phrases[selectedPhraseIdx]?.start ?? 0;
        await playSyncedWithVideo(
          `${c.guideAudio}&t=${Date.now()}`,
          'guide',
          startFrom,
          startFrom,
        );
      };

      const save = async () => {
        if (!take || mode === 'rec' || mode === 'count') return;
        stopPlayback();
        const c = clip();
        const isLs = takeIsLipsync;
        stateEl.textContent = isLs
          ? 'Guardando Lip-Sync (256 kbps AAC, sin tocar el .mp4) y actualizando tiempos…'
          : 'Guardando video + audio y transcribiendo…';

        const promptIdeas = isLs && c.refWords.length
          ? [c.refWords.map(w => w.w).join(lang === 'zh' ? '' : ' ')]
          : c.ideas;

        const saveMode = isLs ? 'lipsync' : 'full';
        const headers: Record<string, string> = {
          'x-ideas': encodeURIComponent(JSON.stringify(promptIdeas)),
        };
        if (isLs) {
          headers['x-sync-offset'] = effectiveSyncOffset().toFixed(4);
          headers['x-punch-in'] = takePunchIn.toFixed(4);
          headers['x-manual-stop'] = takeManualStop ? '1' : '0';
        }

        const res = await fetch(
          `/__narration/save?lang=${lang}&key=${encodeURIComponent(c.key)}&mode=${saveMode}`,
          {
            method: 'POST',
            headers,
            body: take,
          },
        ).catch(() => new Response(null, { status: 503 }));

        let out: {
          error?: string;
          m4a: string;
          length: number;
          lines: string[];
          esText?: string;
          enText?: string;
          lipsynced?: boolean;
        };
        try {
          out = await res.json();
        } catch {
          out = {
            error: `el servidor respondió ${res.status} sin datos`,
            m4a: '',
            length: 0,
            lines: [],
          };
        }
        if (!res.ok || out.error) {
          mode = 'done';
          sync();
          stateEl.textContent = `No se pudo guardar (${out.error}). La toma sigue en memoria: pulsa S otra vez.`;
          return;
        }

        c.status = 'new';
        c.audio = out.m4a;
        if (out.lipsynced) c.lipsynced = true;
        if (!isLs) {
          // Fresh Stage 1 video take: pull new refWords so Lip-Sync mode is immediately available.
          const refRes = await fetch(
            `/__narration/ref?lang=${lang}&key=${encodeURIComponent(c.key)}`,
          ).catch(() => null);
          if (refRes?.ok) {
            const info = await refRes.json();
            c.hasVideo = Boolean(info.hasVideo);
            c.video = info.videoUrl;
            c.lipsynced = Boolean(info.lipsynced);
            if (Array.isArray(info.words)) c.refWords = info.words;
          }
        }
        if (lang === 'es' && out.enText) {
          const enClip = scripts.en.find(x => x.key === c.key);
          if (enClip) enClip.ideas = [out.enText];
        }

        document
          .querySelector(`[data-pick="${CSS.escape(c.key)}"] [data-dot="${lang}"]`)
          ?.setAttribute('data-status', 'new');
        $('[data-key]').textContent =
          `${c.key} · ${lang} · ~${fmt(clipSecs(c))}` +
          (c.lipsynced ? ' · ADR ✓' : c.hasVideo ? ' · video listo' : '');
        total();

        if (takeUrl) {
          URL.revokeObjectURL(takeUrl);
          takeUrl = null;
        }
        take = null;
        mode = 'idle';
        if (clip() === c && !isLipsyncActive(c)) showSaid(out.lines);
        sync();
        stateEl.textContent = isLs
          ? `Lip-Sync guardado ✓ · ${out.length.toFixed(1)} s exactos · video .mp4 intacto. Pulsa L para verlo o ↓ para el siguiente.`
          : `Guardado · ${out.length.toFixed(1)} s · ${out.lines.length} subtítulos.`;
      };

      const acts: Record<string, () => unknown> = {
        record,
        punch,
        finish: finishToReview,
        next,
        stop: cancelRec,
        take: playTake,
        save,
        current: playCurrent,
        guide: playGuide,
      };
      document.querySelectorAll<HTMLButtonElement>('[data-act]').forEach(b =>
        b.addEventListener('click', () => {
          b.blur();
          acts[b.dataset.act!]?.();
        }),
      );
      document
        .querySelectorAll<HTMLButtonElement>('[data-pick]')
        .forEach((b, i) => b.addEventListener('click', () => select(i)));

      document.addEventListener('keydown', e => {
        if (
          e.target instanceof HTMLSelectElement ||
          e.target instanceof HTMLInputElement ||
          e.metaKey ||
          e.ctrlKey
        )
          return;
        const k = e.key.toLowerCase();
        const map: Record<string, () => unknown> = {
          ' ': () =>
            mode === 'rec'
              ? isLipsyncActive()
                ? finishToReview()
                : next()
              : mode === 'play'
                ? (stopPlayback(), sync())
                : undefined,
          enter: () => (mode === 'rec' ? next() : undefined),
          arrowright: () => (!isLipsyncActive() && mode === 'rec' ? next() : undefined),
          escape: () =>
            mode === 'play' ? (stopPlayback(), sync()) : cancelRec(),
          r: () => mode !== 'rec' && mode !== 'count' && record(),
          u: () => mode !== 'rec' && mode !== 'count' && punch(),
          p: () => mode !== 'rec' && mode !== 'count' && playTake(),
          s: () => mode !== 'rec' && mode !== 'count' && save(),
          l: () => mode !== 'rec' && mode !== 'count' && playCurrent(),
          g: () => mode !== 'rec' && mode !== 'count' && playGuide(),
          arrowdown: () => select(index + 1),
          arrowup: () => select(index - 1),
        };
        if (map[k]) {
          e.preventDefault();
          map[k]();
        }
      });

      pickLang(lang);
    </script>

