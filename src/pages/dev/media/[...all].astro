---
import DevLangPicker from '../../../components/dev/DevLangPicker.astro';
import { EVENTS } from '../../../lib/events';
import {
  savedEventRemoved,
  savedPhotoRemoved,
} from '../../../lib/mediaOrder';
import { PHOTO_POSTS, posterOf } from '../../../lib/photos';
import '../../../styles/global.css';

/**
 * DEV ONLY — /dev/media.
 * Drag-and-drop media orderer + remover for Highlights (Events) and Photos.
 * Cosmos is intentionally excluded because its photos shuffle randomly on every load.
 * Uses pointer-driven FLIP reordering and writes `src/data/media-order.json`
 * via `scripts/media-order.mjs` without triggering a full-page reload.
 *
 * Emits zero pages in production builds.
 */
export const getStaticPaths = () =>
  import.meta.env.PROD ? [] : [{ params: { all: undefined } }];

type MediaEntry = {
  id: string;
  src: string;
  isVideo: boolean;
  poster?: string;
};

type Collection = {
  key: string;
  group: 'events' | 'photos';
  groupKey: string;
  id: string;
  name: string;
  items: MediaEntry[];
  removed: MediaEntry[];
};

const toEntry = (src: string): MediaEntry => {
  const isVideo = /\.mp4(\?|$)/.test(src);
  return {
    id: src,
    src,
    isVideo,
    poster: isVideo ? posterOf(src) : undefined,
  };
};

const collections: Collection[] = [
  ...EVENTS.filter(e => Array.isArray(e.image)).map(e => ({
    key: `events:${e.id}`,
    group: 'events' as const,
    groupKey: 'media.group.events',
    id: e.id,
    name: typeof e.name === 'string' ? e.name : e.id,
    items: (e.image as string[]).map(toEntry),
    removed: savedEventRemoved(e.id).map(toEntry),
  })),
  ...PHOTO_POSTS.map(p => ({
    key: `photos:${p.id}`,
    group: 'photos' as const,
    groupKey: 'media.group.photos',
    id: p.id,
    name: p.caption.es.charAt(0).toUpperCase() + p.caption.es.slice(1),
    items: p.media.map(toEntry),
    removed: savedPhotoRemoved(p.id).map(toEntry),
  })),
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Media Orderer · Dev</title>
  </head>
  <body>
    <aside class="list">
      <div class="list-head">
        <a href="/dev" class="dev-back" data-i18n="back.dev">← Dev</a>
        <div class="list-head-meta">
          <p class="label" data-i18n="media.sidebar">Colecciones</p>
          <p class="total" data-total>{collections.length}</p>
        </div>
      </div>

      <ol data-sidebar data-scroll-fade>
        {
          collections.map((c, idx) => (
            <li>
              <button
                type="button"
                data-pick={c.key}
                aria-current={idx === 0 ? 'true' : undefined}
              >
                <span class="row-main">
                  <span class="where">{c.name}</span>
                  <span class="key" data-col-meta={c.key}>
                    {c.items.length}
                  </span>
                </span>
              </button>
            </li>
          ))
        }
      </ol>

      <p class="legend" data-i18n="media.legend">
        Arrastra para ordenar · × para quitar · #1 es portada
      </p>
    </aside>

    <main>
      <header class="top">
        <div class="top-left">
          <p class="label" data-active-group></p>
          <p class="where-title" data-active-title></p>
        </div>
        <div class="top-right">
          <span class="mini-pill" data-status></span>
          <DevLangPicker />
        </div>
      </header>

      <section class="stage" data-stage data-scroll-fade>
        <div class="grid" data-grid></div>
      </section>

      <footer class="controls">
        <p class="hint" data-i18n="media.hint">
          Arrastra cualquier foto o video para cambiar su orden. Se guarda al instante.
        </p>
        <div class="controls-right">
          <button type="button" class="pill-btn" data-restore hidden></button>
          <button type="button" class="pill-btn" data-reset data-i18n="media.reset">
            Restablecer orden
          </button>
        </div>
      </footer>
    </main>

    <script is:inline type="application/json" id="media-data" set:html={JSON.stringify(collections)} />

    <script>
      import { devT } from '../../../lib/devI18n';
      import type { Locale } from '../../../i18n/ui';

      type MediaEntry = {
        id: string;
        src: string;
        isVideo: boolean;
        poster?: string;
      };
      type Collection = {
        key: string;
        group: 'events' | 'photos' | 'cosmos';
        groupKey: string;
        id?: string;
        name: string;
        items: MediaEntry[];
        removed: MediaEntry[];
      };

      const collections: Collection[] = JSON.parse(
        document.getElementById('media-data')?.textContent || '[]',
      );
      const colByKey = new Map(collections.map(c => [c.key, c]));

      const lang = (): Locale =>
        ((document.documentElement.dataset.lang as Locale) || 'es');

      const hashKey = decodeURIComponent(location.hash.replace(/^#/, ''));
      let activeKey = colByKey.has(hashKey) ? hashKey : (collections[0]?.key ?? '');

      const sidebar = document.querySelector<HTMLElement>('[data-sidebar]')!;
      const grid = document.querySelector<HTMLElement>('[data-grid]')!;
      const groupEl = document.querySelector<HTMLElement>('[data-active-group]')!;
      const titleEl = document.querySelector<HTMLElement>('[data-active-title]')!;
      const statusEl = document.querySelector<HTMLElement>('[data-status]')!;
      const resetBtn = document.querySelector<HTMLButtonElement>('[data-reset]')!;
      const restoreBtn = document.querySelector<HTMLButtonElement>('[data-restore]')!;

      const getActive = () => colByKey.get(activeKey)!;

      let statusTimer = 0;
      const setStatus = (key: string, cls = '') => {
        clearTimeout(statusTimer);
        statusEl.textContent = key ? devT(lang(), key) : '';
        statusEl.className = `mini-pill ${cls}`.trim();
        if (cls === 'is-saved') {
          statusTimer = window.setTimeout(() => {
            statusEl.textContent = '';
            statusEl.className = 'mini-pill';
          }, 1800);
        }
      };

      const updateSidebarLabels = () => {
        const l = lang();
        collections.forEach(c => {
          const meta = sidebar.querySelector<HTMLElement>(`[data-col-meta="${CSS.escape(c.key)}"]`);
          if (meta) {
            meta.textContent = `${devT(l, c.groupKey)} · ${devT(l, 'media.items', { n: c.items.length })}`;
          }
        });
      };

      const updateHeaderAndFooter = () => {
        const col = getActive();
        const l = lang();
        groupEl.textContent = devT(l, col.groupKey);
        titleEl.textContent = `${col.name} · ${devT(l, 'media.items', { n: col.items.length })}`;
        if (col.removed.length > 0) {
          restoreBtn.hidden = false;
          restoreBtn.textContent = devT(l, 'media.restore', { n: col.removed.length });
        } else {
          restoreBtn.hidden = true;
        }
      };

      const save = async (col: Collection, order: string[], removed: string[]) => {
        setStatus('media.saving', 'is-saving');
        try {
          const res = await fetch('/__media/save', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({
              group: col.group,
              id: col.id,
              order,
              removed,
            }),
          });
          if (!res.ok) throw new Error(String(res.status));
          setStatus('media.saved', 'is-saved');
        } catch {
          setStatus('media.error', 'is-err');
        }
      };

      // Update index badges in place without rebuilding DOM nodes
      const syncBadges = () => {
        const l = lang();
        [...grid.children].forEach((el, idx) => {
          const badge = el.querySelector<HTMLElement>('.idx');
          if (!badge) return;
          badge.textContent = idx === 0 ? `#1 · ${devT(l, 'media.cover')}` : `#${idx + 1}`;
          badge.classList.toggle('is-cover', idx === 0);
        });
      };

      // FLIP animation helper: snapshot rects, run DOM mutation, animate delta
      const flipReorder = (mutate: () => void) => {
        const tiles = [...grid.querySelectorAll<HTMLElement>('.tile')];
        const first = new Map<HTMLElement, DOMRect>();
        tiles.forEach(t => first.set(t, t.getBoundingClientRect()));

        mutate();

        tiles.forEach(t => {
          if (t.classList.contains('is-placeholder')) return;
          const prev = first.get(t);
          if (!prev) return;
          const next = t.getBoundingClientRect();
          const dx = prev.left - next.left;
          const dy = prev.top - next.top;
          if (Math.abs(dx) < 0.5 && Math.abs(dy) < 0.5) return;
          t.style.transition = 'none';
          t.style.transform = `translate3d(${dx}px, ${dy}px, 0)`;
          void t.offsetWidth;
          t.style.transition = 'transform 240ms cubic-bezier(0.16, 1, 0.3, 1)';
          t.style.transform = '';
          const cleanup = () => {
            t.style.transition = '';
            t.removeEventListener('transitionend', cleanup);
          };
          t.addEventListener('transitionend', cleanup);
        });
      };

      const renderGrid = () => {
        const col = getActive();
        const l = lang();
        updateHeaderAndFooter();
        updateSidebarLabels();
        grid.innerHTML = '';

        if (!col.items.length) {
          const empty = document.createElement('p');
          empty.className = 'empty-msg';
          empty.textContent = devT(l, 'media.empty');
          grid.appendChild(empty);
          return;
        }

        col.items.forEach((item, idx) => {
          const tile = document.createElement('div');
          tile.className = 'tile';
          tile.dataset.id = item.id;

          const idxBadge = document.createElement('span');
          idxBadge.className = idx === 0 ? 'idx is-cover' : 'idx';
          idxBadge.textContent = idx === 0 ? `#1 · ${devT(l, 'media.cover')}` : `#${idx + 1}`;

          const delBtn = document.createElement('button');
          delBtn.type = 'button';
          delBtn.className = 'del-btn';
          delBtn.setAttribute('aria-label', devT(l, 'media.remove'));
          delBtn.innerHTML =
            '<svg viewBox="0 0 12 12" width="11" height="11" aria-hidden="true"><path d="M2.5 2.5 L9.5 9.5 M9.5 2.5 L2.5 9.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>';
          delBtn.addEventListener('pointerdown', e => e.stopPropagation());
          delBtn.addEventListener('click', e => {
            e.stopPropagation();
            const cur = getActive();
            const pos = cur.items.findIndex(x => x.id === item.id);
            if (pos === -1) return;
            const [removedItem] = cur.items.splice(pos, 1);
            cur.removed.push(removedItem);
            flipReorder(() => {
              tile.remove();
            });
            syncBadges();
            updateHeaderAndFooter();
            updateSidebarLabels();
            if (!cur.items.length) renderGrid();
            save(
              cur,
              cur.items.map(x => x.id),
              cur.removed.map(x => x.id),
            );
          });

          const frame = document.createElement('div');
          frame.className = 'frame';
          if (item.isVideo) {
            const vid = document.createElement('video');
            vid.src = item.src;
            if (item.poster) vid.poster = item.poster;
            vid.muted = true;
            vid.playsInline = true;
            vid.preload = 'metadata';
            vid.draggable = false;
            frame.appendChild(vid);

            const vbadge = document.createElement('span');
            vbadge.className = 'vbadge';
            vbadge.textContent = 'VIDEO';
            frame.appendChild(vbadge);
          } else {
            const img = document.createElement('img');
            img.src = item.src;
            img.alt = '';
            img.loading = 'lazy';
            img.decoding = 'async';
            img.draggable = false;
            frame.appendChild(img);
          }

          tile.appendChild(idxBadge);
          tile.appendChild(delBtn);
          tile.appendChild(frame);

          // Pointer-based smooth FLIP drag-and-drop
          tile.addEventListener('pointerdown', e => {
            if (e.button !== 0) return;
            if ((e.target as HTMLElement).closest('.del-btn')) return;

            const startX = e.clientX;
            const startY = e.clientY;
            const rect = tile.getBoundingClientRect();
            const offsetX = startX - rect.left;
            const offsetY = startY - rect.top;
            let dragging = false;
            let ghost: HTMLElement | null = null;
            let moved = false;

            const onMove = (ev: PointerEvent) => {
              const dist = Math.hypot(ev.clientX - startX, ev.clientY - startY);
              if (!dragging) {
                if (dist < 4) return;
                dragging = true;
                ghost = tile.cloneNode(true) as HTMLElement;
                ghost.className = 'tile is-ghost';
                ghost.style.width = `${rect.width}px`;
                ghost.style.height = `${rect.height}px`;
                ghost.style.left = '0px';
                ghost.style.top = '0px';
                ghost.style.transform = `translate3d(${rect.left}px, ${rect.top}px, 0) scale(1.04)`;
                document.body.appendChild(ghost);
                tile.classList.add('is-placeholder');
                document.body.classList.add('is-dragging');
              }

              if (ghost) {
                const gx = ev.clientX - offsetX;
                const gy = ev.clientY - offsetY;
                ghost.style.transform = `translate3d(${gx}px, ${gy}px, 0) scale(1.04)`;
              }

              // Hit-test siblings by bounding box
              const siblings = [...grid.querySelectorAll<HTMLElement>('.tile')];
              const target = siblings.find(el => {
                if (el === tile) return false;
                const r = el.getBoundingClientRect();
                return (
                  ev.clientX >= r.left &&
                  ev.clientX <= r.right &&
                  ev.clientY >= r.top &&
                  ev.clientY <= r.bottom
                );
              });

              if (target) {
                const cur = getActive();
                const fromIdx = cur.items.findIndex(x => x.id === tile.dataset.id);
                const toIdx = cur.items.findIndex(x => x.id === target.dataset.id);
                if (fromIdx !== -1 && toIdx !== -1 && fromIdx !== toIdx) {
                  moved = true;
                  const [entry] = cur.items.splice(fromIdx, 1);
                  cur.items.splice(toIdx, 0, entry);
                  flipReorder(() => {
                    if (fromIdx < toIdx) {
                      target.after(tile);
                    } else {
                      target.before(tile);
                    }
                  });
                  syncBadges();
                }
              }
            };

            const onUp = () => {
              window.removeEventListener('pointermove', onMove);
              window.removeEventListener('pointerup', onUp);
              window.removeEventListener('pointercancel', onUp);

              if (!dragging) return;
              document.body.classList.remove('is-dragging');

              const finalRect = tile.getBoundingClientRect();
              if (ghost) {
                ghost.style.transition =
                  'transform 180ms cubic-bezier(0.16, 1, 0.3, 1), opacity 180ms ease';
                ghost.style.transform = `translate3d(${finalRect.left}px, ${finalRect.top}px, 0) scale(1)`;
                const g = ghost;
                window.setTimeout(() => {
                  g.remove();
                  tile.classList.remove('is-placeholder');
                }, 180);
              } else {
                tile.classList.remove('is-placeholder');
              }

              if (moved) {
                const cur = getActive();
                save(
                  cur,
                  cur.items.map(x => x.id),
                  cur.removed.map(x => x.id),
                );
              }
            };

            window.addEventListener('pointermove', onMove);
            window.addEventListener('pointerup', onUp);
            window.addEventListener('pointercancel', onUp);
          });

          grid.appendChild(tile);
        });
      };

      const selectCollection = (key: string) => {
        if (!colByKey.has(key)) return;
        activeKey = key;
        history.replaceState(null, '', `#${encodeURIComponent(key)}`);
        sidebar.querySelectorAll<HTMLButtonElement>('[data-pick]').forEach(btn => {
          btn.toggleAttribute('aria-current', btn.dataset.pick === key);
        });
        renderGrid();
      };

      sidebar.querySelectorAll<HTMLButtonElement>('[data-pick]').forEach(btn => {
        btn.addEventListener('click', () => selectCollection(btn.dataset.pick!));
      });

      resetBtn.addEventListener('click', async () => {
        const col = getActive();
        await save(col, [], col.removed.map(x => x.id));
        location.reload();
      });

      restoreBtn.addEventListener('click', async () => {
        const col = getActive();
        if (!col.removed.length) return;
        col.items.push(...col.removed);
        col.removed = [];
        renderGrid();
        await save(
          col,
          col.items.map(x => x.id),
          [],
        );
      });

      window.addEventListener('dev:lang', () => {
        updateSidebarLabels();
        updateHeaderAndFooter();
        syncBadges();
      });

      selectCollection(activeKey);
    </script>

    <style is:global>
      html,
      body {
        height: 100%;
        overflow: hidden;
      }

      body {
        display: grid;
        grid-template-columns: 16.5rem 1fr;
        margin: 0;
        background: var(--ground);
        color: var(--ink);
        font-family: var(--font-sans);
      }

      body.is-dragging {
        user-select: none;
        cursor: grabbing;
      }

      .label,
      .key,
      .total,
      .legend,
      .hint,
      .mini-pill,
      .idx,
      .vbadge {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        letter-spacing: 0.02em;
        color: var(--ink-3);
      }

      .label {
        margin: 0;
        text-transform: uppercase;
        letter-spacing: var(--track-label);
        color: var(--ink-2);
      }

      p {
        margin: 0;
      }

      /* ── Sidebar ── */
      .list {
        display: flex;
        flex-direction: column;
        border-right: 1px solid var(--hairline);
        overflow: hidden;
        background: var(--ground);
      }

      .list-head {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.85rem;
        padding: 1rem 1.25rem 0.9rem;
        border-bottom: 1px solid var(--hairline);
      }

      .list-head-meta {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        width: 100%;
        gap: 0.5rem;
      }

      .total {
        color: var(--ink-2);
        font-variant-numeric: tabular-nums;
      }

      .list ol {
        flex: 1;
        margin: 0;
        padding: 0;
        list-style: none;
        overflow-y: auto;
      }

      .list li button {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        width: 100%;
        padding: 0.7rem 1.25rem;
        border: 0;
        border-bottom: 1px solid var(--hairline);
        background: none;
        color: inherit;
        text-align: left;
        cursor: pointer;
        transition: background var(--hover);
      }

      .list li button:hover {
        background: rgb(255 255 255 / 0.03);
      }

      .list li button[aria-current] {
        background: var(--surface);
      }

      .row-main {
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
        min-width: 0;
      }

      .where {
        font-size: 0.84rem;
        font-weight: 500;
        color: var(--ink);
        line-height: 1.25;
      }

      .key {
        color: var(--ink-3);
        font-size: 0.6875rem;
        font-variant-numeric: tabular-nums;
      }

      .legend {
        padding: 0.75rem 1.25rem;
        border-top: 1px solid var(--hairline);
        font-size: 0.6875rem;
        line-height: 1.45;
      }

      /* ── Main column ── */
      main {
        display: grid;
        grid-template-rows: auto 1fr auto;
        min-width: 0;
        height: 100%;
        overflow: hidden;
      }

      .top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.85rem 1.5rem;
        border-bottom: 1px solid var(--hairline);
        background: var(--ground);
      }

      .top-left {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
        min-width: 0;
      }

      .where-title {
        font-size: 0.9375rem;
        font-weight: 600;
        color: var(--ink);
        font-variant-numeric: tabular-nums;
      }

      .top-right {
        display: flex;
        align-items: center;
        gap: 0.65rem;
      }

      .mini-pill {
        display: inline-flex;
        align-items: center;
        padding: 0.28rem 0.7rem;
        border-radius: 999px;
        border: 1px solid transparent;
        font-size: 0.72rem;
        min-height: 1.65rem;
        transition:
          color var(--hover),
          border-color var(--hover),
          background var(--hover);
      }

      .mini-pill.is-saving {
        border-color: var(--hairline);
        background: var(--surface);
        color: var(--ink-2);
      }

      .mini-pill.is-saved {
        border-color: var(--ink-3);
        background: var(--surface);
        color: var(--ink);
      }

      .mini-pill.is-err {
        border-color: #f87171;
        color: #f87171;
      }

      /* ── Stage & clean image-only tiles ── */
      .stage {
        overflow-y: auto;
        padding: 1.5rem;
      }

      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(11.5rem, 1fr));
        gap: 0.9rem;
        align-items: start;
      }

      .empty-msg {
        grid-column: 1 / -1;
        padding: 3rem 0;
        text-align: center;
        font-family: var(--font-mono);
        font-size: 0.8125rem;
        color: var(--ink-3);
      }

      .tile {
        position: relative;
        border: 1px solid var(--hairline);
        border-radius: 0.85rem;
        background: var(--surface);
        overflow: hidden;
        cursor: grab;
        touch-action: none;
        user-select: none;
        transition:
          border-color var(--hover),
          opacity var(--dur-micro) var(--ease);
      }

      .tile:hover {
        border-color: var(--ink-3);
      }

      .tile.is-placeholder {
        opacity: 0.22;
        border-style: dashed;
        border-color: var(--ink-3);
      }

      .tile.is-ghost {
        position: fixed;
        z-index: 999;
        pointer-events: none;
        margin: 0;
        cursor: grabbing;
        border-color: var(--ink-2);
        box-shadow: 0 20px 44px rgb(0 0 0 / 0.55);
        will-change: transform;
      }

      .frame {
        position: relative;
        aspect-ratio: 3 / 4;
        background: var(--ground);
        overflow: hidden;
      }

      .frame img,
      .frame video {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        pointer-events: none;
      }

      .idx {
        position: absolute;
        top: 0.55rem;
        left: 0.55rem;
        z-index: 2;
        padding: 0.22rem 0.55rem;
        border-radius: 999px;
        border: 1px solid rgb(255 255 255 / 0.14);
        background: rgb(13 13 13 / 0.72);
        backdrop-filter: blur(10px);
        color: var(--ink);
        font-size: 0.6875rem;
        font-weight: 600;
        font-variant-numeric: tabular-nums;
        pointer-events: none;
      }

      .idx.is-cover {
        border-color: var(--ink);
        background: var(--ink);
        color: var(--ground);
      }

      .del-btn {
        position: absolute;
        top: 0.5rem;
        right: 0.5rem;
        z-index: 3;
        display: grid;
        place-items: center;
        width: 1.9rem;
        height: 1.9rem;
        padding: 0;
        border: 1px solid rgb(255 255 255 / 0.16);
        border-radius: 50%;
        background: rgb(13 13 13 / 0.72);
        backdrop-filter: blur(10px);
        color: var(--ink-2);
        cursor: pointer;
        opacity: 0;
        transition:
          opacity var(--dur-micro) var(--ease),
          color var(--hover),
          border-color var(--hover),
          background var(--hover),
          transform var(--dur-micro) var(--ease);
      }

      .tile:hover .del-btn,
      .tile:focus-within .del-btn {
        opacity: 1;
      }

      @media (hover: none) {
        .del-btn {
          opacity: 1;
        }
      }

      .del-btn:hover {
        color: var(--ink);
        border-color: rgb(248 113 113 / 0.75);
        background: rgb(127 29 29 / 0.82);
      }

      .del-btn:active {
        transform: scale(0.9);
      }

      .vbadge {
        position: absolute;
        bottom: 0.55rem;
        left: 0.55rem;
        z-index: 2;
        padding: 0.18rem 0.5rem;
        border-radius: 999px;
        border: 1px solid rgb(255 255 255 / 0.14);
        background: rgb(13 13 13 / 0.72);
        backdrop-filter: blur(10px);
        color: var(--ink-2);
        font-size: 0.625rem;
        letter-spacing: 0.06em;
        pointer-events: none;
      }

      /* ── Footer bar ── */
      .controls {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.85rem 1.5rem;
        border-top: 1px solid var(--hairline);
        background: var(--surface);
      }

      .controls-right {
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      .pill-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        min-height: 2.25rem;
        padding: 0 0.95rem;
        border: 1px solid var(--hairline);
        border-radius: 999px;
        background: transparent;
        color: var(--ink-2);
        font-family: var(--font-sans);
        font-size: 0.8125rem;
        cursor: pointer;
        white-space: nowrap;
        transition:
          color var(--hover),
          border-color var(--hover),
          background var(--hover),
          transform var(--dur-micro) var(--ease);
      }

      .pill-btn:hover {
        color: var(--ink);
        border-color: var(--ink-3);
        background: rgb(255 255 255 / 0.04);
      }

      .pill-btn:active {
        transform: scale(0.96);
      }

      @media (max-width: 52rem) {
        html,
        body {
          height: auto;
          overflow: auto;
        }
        body {
          grid-template-columns: 1fr;
        }
        .list {
          border-right: 0;
          border-bottom: 1px solid var(--hairline);
          max-height: 40svh;
        }
        main {
          height: auto;
          overflow: visible;
        }
        .controls {
          flex-direction: column;
          align-items: flex-start;
        }
      }
    </style>
  </body>
</html>
