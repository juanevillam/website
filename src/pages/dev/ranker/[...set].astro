---
import DevLangPicker from '../../../components/dev/DevLangPicker.astro';
import SAVED from '../../../data/likes-order.json';
import '../../../styles/global.css';

/**
 * DEV ONLY — /dev/ranker. Juan ranks his favorite SONGS, the ones of the
 * More of Me songs card. Merges full Sound Shaper metadata (cover artwork,
 * title, artist, duration) from `src/data/songs.json` via `scripts/likes-ranker.mjs`.
 *
 * In a production build this route has no paths, so it does not exist.
 */
export const getStaticPaths = () =>
  import.meta.env.PROD ? [] : [{ params: { set: undefined } }];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Songs Ranker · Dev</title>
  </head>
  <body>
    <header class="top">
      <div class="top-left">
        <a href="/dev" class="dev-back" data-i18n="back.dev">← Dev</a>
        <p class="label" data-i18n="ranker.title">Songs Ranker</p>
      </div>
      <nav class="steps">
        <button type="button" data-step="pick" data-i18n="ranker.step.pick">1 · Tu top</button>
        <button type="button" data-step="duel" data-i18n="ranker.step.duel">2 · Duelos</button>
      </nav>
      <div class="top-right">
        <p class="progress" data-progress></p>
        <DevLangPicker />
      </div>
    </header>

    <main>
      <!-- 1. PICK: the whole library, the top ones marked. -->
      <section class="pick-step" data-pick hidden>
        <div class="head">
          <div>
            <h1 data-i18n="ranker.pick.heading">¿Cuáles son tu top?</h1>
            <p class="hint" data-i18n="ranker.pick.hint">
              Dale play para escucharla y marca las de tu top personal.
            </p>
          </div>
          <button type="button" class="save" data-to-duel>
            <span data-i18n="ranker.pick.cta">Rankear</span>
            <span data-count>0</span>
          </button>
        </div>
        <ul class="songs" data-songs></ul>
      </section>

      <!-- 2. THE DUEL: two songs, the one liked more is clicked. -->
      <section class="duel" data-duel hidden>
        <p class="ask" data-i18n="ranker.duel.ask">¿Cuál te gusta más?</p>
        <div class="pair">
          {
            [0, 1].map(side => (
              <div class="side" data-side={side}>
                <div class="cover-wrap">
                  <img class="cover-img" data-cover alt="" />
                  <button
                    type="button"
                    class="play big"
                    data-play
                    data-i18n-aria="ranker.listen"
                    aria-label="Escuchar"
                  >
                    <span class="glyph" />
                  </button>
                </div>
                <p class="title" data-title />
                <p class="artist" data-artist />
                <p class="dur" data-dur />
                <button type="button" class="choose" data-choose>
                  <kbd>{side === 0 ? '←' : '→'}</kbd>
                  <span data-i18n="ranker.duel.choose">Esta</span>
                </button>
              </div>
            ))
          }
        </div>
        <div class="bar">
          <span class="meter"><span class="meter-fill" data-meter></span></span>
        </div>
        <div class="tools">
          <button type="button" class="tool" data-undo>
            <kbd>Z</kbd>
            <span data-i18n="ranker.duel.undo">Deshacer</span>
          </button>
          <button type="button" class="tool" data-restart data-i18n="ranker.duel.restart">
            Empezar de nuevo
          </button>
        </div>
      </section>

      <!-- THE RESULT: the top, first to last, ready to save. -->
      <section class="result" data-result hidden>
        <div class="head">
          <div>
            <p class="label" data-i18n="ranker.result.label">Tu orden</p>
            <h1 data-i18n="ranker.result.heading">Canciones</h1>
          </div>
          <div class="actions">
            <span class="save-state" data-save-state></span>
            <button type="button" class="tool" data-undo-last data-i18n="ranker.result.undoLast">
              Deshacer último
            </button>
            <button
              type="button"
              class="tool"
              data-restart-result
              data-i18n="ranker.duel.restart"
            >
              Empezar de nuevo
            </button>
            <button type="button" class="save" data-save data-i18n="ranker.result.save">
              Guardar en el sitio
            </button>
          </div>
        </div>
        <ol class="songs ranked" data-ranked></ol>
      </section>

      <p class="state" data-state data-i18n="ranker.loading">Cargando canciones…</p>
    </main>

    <audio data-audio preload="none"></audio>

    <script is:inline type="application/json" id="saved" set:html={JSON.stringify(SAVED)} />

    <script>
      import { devT } from '../../../lib/devI18n';
      import type { Locale } from '../../../i18n/ui';

      type Song = {
        id: string;
        file: string;
        title: string;
        artist: string;
        seconds: number;
        thumb: string | null;
        cover: string | null;
      };
      type Answer = [string, string, string];

      const lang = (): Locale =>
        ((document.documentElement.dataset.lang as Locale) || 'es');

      const fmtDur = (sec: number) => {
        if (!sec) return '';
        const m = Math.floor(sec / 60);
        const s = Math.floor(sec % 60);
        return `${m}:${String(s).padStart(2, '0')}`;
      };

      const saved = JSON.parse(document.getElementById('saved')!.textContent!) as Record<
        string,
        string[]
      >;
      const $ = <T extends HTMLElement>(sel: string) => document.querySelector<T>(sel)!;
      const pickStep = $('[data-pick]');
      const duel = $('[data-duel]');
      const result = $('[data-result]');
      const progress = $('[data-progress]');
      const audio = $<HTMLAudioElement>('[data-audio]');
      const sides = [...document.querySelectorAll<HTMLElement>('.side')];

      const store = {
        get: <T,>(key: string, empty: T): T => {
          try {
            return JSON.parse(localStorage.getItem(`ranker:songs:${key}`) ?? 'null') ?? empty;
          } catch {
            return empty;
          }
        },
        put: (key: string, value: unknown) => {
          try {
            localStorage.setItem(`ranker:songs:${key}`, JSON.stringify(value));
          } catch {}
        },
      };

      let library: Song[] = [];
      let top: string[] = store.get('top', saved.songs ?? []);
      let answers: Answer[] = store.get('answers', []);
      let order: Song[] = [];
      let run = 0;
      let pending: ((winner: string) => void) | null = null;
      let currentView: 'pick' | 'duel' | 'result' = 'pick';

      // ---------- playing ----------
      let playing: string | null = null;
      const src = (s: Song) => `/__songs/file/${encodeURIComponent(s.file)}`;
      const mark = () => {
        for (const b of document.querySelectorAll<HTMLElement>('[data-play]'))
          b.toggleAttribute('data-on', !!playing && b.dataset.id === playing && !audio.paused);
      };
      const toggle = (s: Song) => {
        if (playing === s.id && !audio.paused) audio.pause();
        else {
          if (playing !== s.id) {
            audio.src = src(s);
            playing = s.id;
            audio.addEventListener(
              'loadedmetadata',
              () => {
                if (audio.duration > 60) audio.currentTime = audio.duration * 0.35;
              },
              { once: true },
            );
          }
          audio.play();
        }
      };
      audio.addEventListener('play', mark);
      audio.addEventListener('pause', mark);
      audio.addEventListener('ended', mark);
      const stop = () => {
        audio.pause();
        playing = null;
        mark();
      };

      const thumbPlayButton = (s: Song) => {
        const wrap = document.createElement('button');
        wrap.type = 'button';
        wrap.className = 'thumb-play';
        wrap.dataset.play = '';
        wrap.dataset.id = s.id;
        wrap.setAttribute('aria-label', `${devT(lang(), 'ranker.listen')} ${s.title}`);
        if (s.thumb) {
          const img = document.createElement('img');
          img.src = s.thumb;
          img.alt = '';
          img.loading = 'lazy';
          img.decoding = 'async';
          wrap.appendChild(img);
        }
        const badge = document.createElement('span');
        badge.className = 'thumb-scrim';
        badge.innerHTML = '<span class="glyph"></span>';
        wrap.appendChild(badge);
        wrap.addEventListener('click', () => toggle(s));
        return wrap;
      };

      const updateProgressText = () => {
        const l = lang();
        if (currentView === 'pick') {
          progress.textContent = devT(l, 'ranker.progress.picked', { n: top.length });
        } else if (currentView === 'duel') {
          const total = most(items().length);
          const left = Math.max(1, total - answers.length);
          progress.textContent = devT(l, 'ranker.progress.duel', {
            done: answers.length + 1,
            left,
          });
        } else {
          progress.textContent = devT(l, 'ranker.progress.done', { n: order.length });
        }
      };

      // ---------- 1. pick ----------
      const showPick = () => {
        run++;
        pending = null;
        stop();
        currentView = 'pick';
        pickStep.hidden = false;
        duel.hidden = true;
        result.hidden = true;
        tabs('pick');
        renderPick();
      };

      const renderPick = () => {
        const l = lang();
        $('[data-count]').textContent = String(top.length);
        $<HTMLButtonElement>('[data-to-duel]').disabled = top.length < 2;
        updateProgressText();
        $('[data-songs]').replaceChildren(
          ...library.map(s => {
            const li = document.createElement('li');
            const on = top.includes(s.id);
            li.className = 'song' + (on ? ' is-top' : '');
            li.append(thumbPlayButton(s));

            const text = document.createElement('div');
            text.className = 'song-meta';
            text.innerHTML = '<p class="title"></p><p class="artist"></p>';
            text.querySelector('.title')!.textContent = s.title;
            text.querySelector('.artist')!.textContent = s.artist;
            li.append(text);

            const dur = document.createElement('span');
            dur.className = 'dur';
            dur.textContent = fmtDur(s.seconds);
            li.append(dur);

            const box = document.createElement('button');
            box.type = 'button';
            box.className = 'star';
            box.setAttribute('aria-pressed', String(on));
            box.textContent = on ? devT(l, 'ranker.pick.inTop') : devT(l, 'ranker.pick.mark');
            box.addEventListener('click', () => {
              top = on ? top.filter(id => id !== s.id) : [...top, s.id];
              store.put('top', top);
              answers = answers.filter(([a, b]) => top.includes(a) && top.includes(b));
              store.put('answers', answers);
              renderPick();
            });
            li.append(box);
            return li;
          }),
        );
        mark();
      };

      // ---------- 2. duels ----------
      const pairKey = (a: string, b: string) => (a < b ? `${a}|${b}` : `${b}|${a}`);
      const flip = (key: string) => {
        let h = 0;
        for (const c of key) h = (h * 31 + c.charCodeAt(0)) | 0;
        return (h & 1) === 1;
      };
      const most = (n: number) => {
        let total = 0;
        for (let k = 1; k < n; k++) total += Math.ceil(Math.log2(k + 1));
        return total;
      };
      const items = () =>
        top.map(id => library.find(s => s.id === id)).filter(Boolean) as Song[];

      const better = (a: Song, b: Song, gen: number): Promise<boolean> => {
        const key = pairKey(a.id, b.id);
        const known = answers.find(([x, y]) => pairKey(x, y) === key);
        if (known) return Promise.resolve(known[2] === a.id);
        return new Promise(resolve => {
          if (gen !== run) return;
          stop();
          currentView = 'duel';
          const pair = flip(key) ? [b, a] : [a, b];
          pair.forEach((s, i) => {
            const side = sides[i];
            side.dataset.id = s.id;
            side.querySelector('[data-title]')!.textContent = s.title;
            side.querySelector('[data-artist]')!.textContent = s.artist;
            side.querySelector('[data-dur]')!.textContent = fmtDur(s.seconds);
            const cover = side.querySelector<HTMLImageElement>('[data-cover]')!;
            if (s.cover) {
              cover.src = s.cover;
              cover.hidden = false;
            } else {
              cover.removeAttribute('src');
              cover.hidden = true;
            }
            const play = side.querySelector<HTMLElement>('[data-play]')!;
            play.dataset.id = s.id;
            play.onclick = () => toggle(s);
            side.classList.remove('is-chosen', 'is-lost');
          });
          pickStep.hidden = true;
          duel.hidden = false;
          result.hidden = true;
          const total = most(items().length);
          updateProgressText();
          $('[data-meter]').style.width = `${Math.min(100, (answers.length / total) * 100)}%`;
          pending = winner => {
            answers.push([a.id, b.id, winner]);
            store.put('answers', answers);
            resolve(winner === a.id);
          };
        });
      };

      const sort = async () => {
        const gen = ++run;
        pending = null;
        tabs('duel');
        const all = items();
        const sorted: Song[] = [all[0]];
        for (const x of all.slice(1)) {
          let lo = 0;
          let hi = sorted.length;
          while (lo < hi) {
            const mid = (lo + hi) >> 1;
            const wins = await better(x, sorted[mid], gen);
            if (gen !== run) return;
            if (wins) hi = mid;
            else lo = mid + 1;
          }
          sorted.splice(lo, 0, x);
        }
        if (gen !== run) return;
        order = sorted;
        finish();
      };

      const finish = () => {
        stop();
        currentView = 'result';
        pickStep.hidden = true;
        duel.hidden = true;
        result.hidden = false;
        updateProgressText();
        const same = (saved.songs ?? []).join() === order.map(s => s.id).join();
        $('[data-save-state]').textContent = same ? devT(lang(), 'ranker.result.saved') : '';
        $<HTMLButtonElement>('[data-save]').disabled = same;
        $('[data-ranked]').replaceChildren(
          ...order.map((s, i) => {
            const li = document.createElement('li');
            li.className = 'song';
            const n = document.createElement('b');
            n.className = 'rank';
            n.textContent = `#${i + 1}`;
            li.append(n, thumbPlayButton(s));
            const text = document.createElement('div');
            text.className = 'song-meta';
            text.innerHTML = '<p class="title"></p><p class="artist"></p>';
            text.querySelector('.title')!.textContent = s.title;
            text.querySelector('.artist')!.textContent = s.artist;
            li.append(text);
            const dur = document.createElement('span');
            dur.className = 'dur';
            dur.textContent = fmtDur(s.seconds);
            li.append(dur);
            return li;
          }),
        );
      };

      const answer = (side: number) => {
        if (!pending || duel.hidden) return;
        sides[side].classList.add('is-chosen');
        sides[1 - side].classList.add('is-lost');
        const resolve = pending;
        pending = null;
        setTimeout(() => resolve(sides[side].dataset.id!), 160);
      };
      const undo = () => {
        if (!answers.length) return;
        answers.pop();
        store.put('answers', answers);
        sort();
      };
      const restart = () => {
        answers = [];
        store.put('answers', answers);
        sort();
      };
      const save = async () => {
        const button = $<HTMLButtonElement>('[data-save]');
        button.disabled = true;
        $('[data-save-state]').textContent = devT(lang(), 'ranker.result.saving');
        try {
          const res = await fetch('/__likes/save', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ set: 'songs', order: order.map(s => s.id) }),
          });
          const out = await res.json();
          if (!res.ok) throw new Error(out.error);
          saved.songs = order.map(s => s.id);
          $('[data-save-state]').textContent = devT(lang(), 'ranker.result.saved');
        } catch (e) {
          button.disabled = false;
          $('[data-save-state]').textContent = String((e as Error).message);
        }
      };

      const tabs = (step: string) => {
        for (const t of document.querySelectorAll<HTMLElement>('[data-step]'))
          t.setAttribute('aria-selected', String(t.dataset.step === step));
      };

      $('[data-to-duel]').addEventListener('click', sort);
      $<HTMLElement>('[data-step="pick"]').addEventListener('click', showPick);
      $<HTMLElement>('[data-step="duel"]').addEventListener(
        'click',
        () => top.length > 1 && sort(),
      );
      sides.forEach((s, i) =>
        s.querySelector('[data-choose]')!.addEventListener('click', () => answer(i)),
      );
      $('[data-undo]').addEventListener('click', undo);
      $('[data-undo-last]').addEventListener('click', undo);
      $('[data-restart]').addEventListener('click', restart);
      $('[data-restart-result]').addEventListener('click', restart);
      $('[data-save]').addEventListener('click', save);
      addEventListener('keydown', e => {
        if (duel.hidden) return;
        if (e.key === 'ArrowLeft') answer(0);
        else if (e.key === 'ArrowRight') answer(1);
        else if (e.key === 'z' || e.key === 'Backspace') undo();
      });

      window.addEventListener('dev:lang', () => {
        if (library.length) {
          if (currentView === 'pick') renderPick();
          else updateProgressText();
        }
      });

      fetch('/__songs/list')
        .then(r => r.json())
        .then((list: Song[]) => {
          library = list;
          top = top.filter(id => list.some(s => s.id === id));
          $('[data-state]').remove();
          showPick();
        })
        .catch(e => ($('[data-state]').textContent = String(e.message)));
    </script>

    <style is:global>
      body {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        margin: 0;
        background: var(--ground);
        color: var(--ink);
        font-family: var(--font-sans);
      }
      .label,
      kbd,
      .progress,
      .save-state,
      .hint,
      .state,
      .artist,
      .rank,
      .dur {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        letter-spacing: 0.02em;
        color: var(--ink-3);
      }
      .label {
        margin: 0;
        text-transform: uppercase;
        letter-spacing: var(--track-label);
        color: var(--ink-2);
      }
      kbd {
        padding: 0.05rem 0.4rem;
        border: 1px solid var(--hairline);
        border-radius: 0.3rem;
      }
      button {
        font: inherit;
        color: inherit;
      }
      p {
        margin: 0;
      }
      [hidden] {
        display: none !important;
      }

      .top {
        position: sticky;
        top: 0;
        z-index: 20;
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 1.25rem;
        padding: 0.85rem 1.5rem;
        border-bottom: 1px solid var(--hairline);
        background: color-mix(in srgb, var(--ground) 88%, transparent);
        backdrop-filter: blur(12px);
      }
      .top-left {
        display: flex;
        align-items: center;
        gap: 1rem;
      }
      .top-right {
        margin-left: auto;
        display: flex;
        align-items: center;
        gap: 1rem;
      }
      .steps {
        display: flex;
        gap: 0.5rem;
      }
      .steps button {
        min-height: 2.25rem;
        padding: 0 0.95rem;
        border: 1px solid var(--hairline);
        border-radius: 999px;
        background: transparent;
        color: var(--ink-2);
        font-family: var(--font-mono);
        font-size: 0.75rem;
        cursor: pointer;
        white-space: nowrap;
        transition:
          color var(--hover),
          border-color var(--hover),
          background var(--hover),
          transform var(--dur-micro) var(--ease);
      }
      .steps button:hover {
        color: var(--ink);
        border-color: var(--ink-3);
      }
      .steps button:active {
        transform: scale(0.96);
      }
      .steps button[aria-selected='true'] {
        border-color: var(--ink-3);
        background: var(--surface);
        color: var(--ink);
      }
      .progress {
        font-variant-numeric: tabular-nums;
      }

      main {
        flex: 1;
        width: 100%;
        max-width: 56rem;
        margin: 0 auto;
        padding: 2rem 1.5rem 4rem;
        box-sizing: border-box;
      }
      .head {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1.5rem;
      }
      h1 {
        margin: 0.25rem 0 0.5rem;
        font-size: 1.75rem;
        font-weight: 800;
        letter-spacing: var(--track-heading);
      }
      .actions {
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      /* ── Song rows with Sound Shaper square artwork ── */
      .songs {
        margin: 0;
        padding: 0;
        list-style: none;
        border-top: 1px solid var(--hairline);
      }
      .song {
        display: grid;
        grid-template-columns: auto 1fr auto auto;
        align-items: center;
        gap: 0.9rem;
        padding: 0.65rem 0.5rem;
        border-bottom: 1px solid var(--hairline);
        transition: background var(--hover);
      }
      .song:hover {
        background: rgb(255 255 255 / 0.025);
      }
      .ranked .song {
        grid-template-columns: 2.25rem auto 1fr auto;
      }
      .song.is-top .title {
        font-weight: 700;
      }
      .song-meta {
        min-width: 0;
      }
      .title {
        font-size: 0.9375rem;
        line-height: 1.3;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .artist {
        margin-top: 0.15rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .dur {
        font-variant-numeric: tabular-nums;
        color: var(--ink-3);
      }
      .rank {
        color: var(--ink-2);
        font-size: 0.875rem;
        font-variant-numeric: tabular-nums;
      }

      .thumb-play {
        position: relative;
        width: 3rem;
        height: 3rem;
        padding: 0;
        border: 1px solid var(--hairline);
        border-radius: 0.55rem;
        background: var(--surface);
        overflow: hidden;
        cursor: pointer;
        flex-shrink: 0;
        transition:
          border-color var(--hover),
          transform var(--dur-micro) var(--ease);
      }
      .thumb-play:hover {
        border-color: var(--ink-3);
      }
      .thumb-play:active {
        transform: scale(0.93);
      }
      .thumb-play img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      .thumb-scrim {
        position: absolute;
        inset: 0;
        display: grid;
        place-items: center;
        background: rgb(13 13 13 / 0.45);
        opacity: 0;
        transition: opacity var(--dur-micro) var(--ease);
      }
      .thumb-play:hover .thumb-scrim,
      .thumb-play[data-on] .thumb-scrim {
        opacity: 1;
      }
      .thumb-play[data-on] {
        border-color: var(--ink);
      }

      .glyph {
        width: 0;
        height: 0;
        margin-left: 0.14rem;
        border-left: 0.58rem solid var(--ink);
        border-top: 0.36rem solid transparent;
        border-bottom: 0.36rem solid transparent;
      }
      [data-on] .glyph {
        width: 0.58rem;
        height: 0.68rem;
        margin: 0;
        border: 0;
        border-left: 0.2rem solid var(--ink);
        border-right: 0.2rem solid var(--ink);
        box-sizing: border-box;
      }

      .star {
        min-height: 2.1rem;
        padding: 0 0.85rem;
        border: 1px solid var(--hairline);
        border-radius: 999px;
        background: transparent;
        color: var(--ink-2);
        font-family: var(--font-mono);
        font-size: 0.75rem;
        cursor: pointer;
        white-space: nowrap;
        transition:
          color var(--hover),
          border-color var(--hover),
          background var(--hover),
          transform var(--dur-micro) var(--ease);
      }
      .star:hover {
        color: var(--ink);
        border-color: var(--ink-3);
      }
      .star:active {
        transform: scale(0.96);
      }
      .star[aria-pressed='true'] {
        border-color: var(--ink-3);
        background: var(--surface);
        color: var(--ink);
      }

      /* ── Duel cards with large Sound Shaper cover art ── */
      .ask {
        margin-bottom: 1.5rem;
        text-align: center;
        font-size: 1.25rem;
        font-weight: 800;
        letter-spacing: var(--track-heading);
      }
      .pair {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.1rem;
      }
      .side {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.4rem;
        padding: 1.75rem 1.25rem 1.5rem;
        border: 1px solid var(--hairline);
        border-radius: 1rem;
        background: var(--surface);
        text-align: center;
        transition:
          border-color var(--hover),
          opacity var(--dur-quick) linear;
      }
      .cover-wrap {
        position: relative;
        width: 11.5rem;
        height: 11.5rem;
        border-radius: 0.85rem;
        border: 1px solid var(--hairline);
        background: var(--ground);
        overflow: hidden;
        margin-bottom: 0.5rem;
      }
      .cover-img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      .play.big {
        position: absolute;
        inset: 0;
        margin: auto;
        display: grid;
        place-items: center;
        width: 3.5rem;
        height: 3.5rem;
        border: 1px solid rgb(255 255 255 / 0.22);
        border-radius: 50%;
        background: rgb(13 13 13 / 0.68);
        backdrop-filter: blur(12px);
        cursor: pointer;
        transition:
          border-color var(--hover),
          background var(--hover),
          transform var(--dur-micro) var(--ease);
      }
      .play.big:hover {
        border-color: var(--ink);
        background: rgb(13 13 13 / 0.82);
      }
      .play.big:active {
        transform: scale(0.9);
      }
      .side .title {
        max-width: 100%;
        font-size: 1.0625rem;
        font-weight: 700;
      }
      .side.is-chosen {
        border-color: var(--ink-2);
      }
      .side.is-lost {
        opacity: 0.4;
      }
      .choose {
        margin-top: 0.85rem;
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        min-height: 2.35rem;
        padding: 0 1.25rem;
        border: 0;
        border-radius: 999px;
        background: var(--ink);
        color: var(--ground);
        font-size: 0.875rem;
        font-weight: 700;
        cursor: pointer;
        white-space: nowrap;
        transition:
          opacity var(--hover),
          transform var(--dur-micro) var(--ease);
      }
      .choose:hover {
        opacity: 0.88;
      }
      .choose:active {
        transform: scale(0.96);
      }
      .choose kbd {
        border-color: currentColor;
        color: inherit;
      }
      .bar {
        margin-top: 1.5rem;
      }
      .meter {
        display: block;
        height: 0.25rem;
        border-radius: 999px;
        background: var(--hairline);
        overflow: hidden;
      }
      .meter-fill {
        display: block;
        height: 100%;
        background: var(--ink-2);
        transition: width var(--dur-quick) var(--ease);
      }
      .tools {
        display: flex;
        justify-content: center;
        gap: 0.5rem;
        margin-top: 1rem;
      }
      .tool {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        min-height: 2.25rem;
        padding: 0 0.95rem;
        border: 1px solid var(--hairline);
        border-radius: 999px;
        background: transparent;
        color: var(--ink-2);
        font-size: 0.8125rem;
        cursor: pointer;
        white-space: nowrap;
        transition:
          color var(--hover),
          border-color var(--hover),
          background var(--hover),
          transform var(--dur-micro) var(--ease);
      }
      .tool:hover {
        color: var(--ink);
        border-color: var(--ink-3);
        background: var(--surface);
      }
      .tool:active {
        transform: scale(0.96);
      }
      .save {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        min-height: 2.35rem;
        padding: 0 1.2rem;
        border: 0;
        border-radius: 999px;
        background: var(--ink);
        color: var(--ground);
        font-size: 0.875rem;
        font-weight: 700;
        font-variant-numeric: tabular-nums;
        cursor: pointer;
        white-space: nowrap;
        transition:
          opacity var(--hover),
          transform var(--dur-micro) var(--ease);
      }
      .save:hover:not(:disabled) {
        opacity: 0.88;
      }
      .save:active:not(:disabled) {
        transform: scale(0.96);
      }
      .save:disabled {
        opacity: 0.35;
        cursor: default;
      }
      @media (max-width: 640px) {
        .pair {
          grid-template-columns: 1fr;
        }
        .head {
          flex-direction: column;
          align-items: stretch;
        }
        .actions {
          flex-wrap: wrap;
        }
        .top-right {
          margin-left: 0;
          width: 100%;
          justify-content: space-between;
        }
      }
    </style>
  </body>
</html>
